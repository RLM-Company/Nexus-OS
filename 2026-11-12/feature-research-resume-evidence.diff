+      .prepare("SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'projects'")
+      .get() as { name: string } | undefined;
+    if (!tableRow) return;
+
+    const projRow = this.sqlite
+      .prepare("SELECT owner_id FROM projects WHERE id = ?")
