+  /**
+   * Aborts and drains all active research runs belonging to `ownerId` (used by `ResearchIntegratedPrivacyAdapter.quiesce`).
+   */
+  public async quiesceOwner(ownerId: string): Promise<number> {
+    let abortedCount = 0;
+    const toWait: Array<Promise<ResearchRunView>> = [];
+
+    for (const [runId, activeOwner] of this.activeRunOwner.entries()) {
+      if (activeOwner === ownerId) {
+        abortedCount += 1;
+        this.activeControllers.get(runId)?.abort();
+        const p = this.activePromises.get(runId);
+        if (p) toWait.push(p);
+      }
+    }
+
+    await Promise.allSettled(toWait);
+    return abortedCount;
+  }
+
+  public async waitForActiveRun(runId: string): Promise<void> {
+    const p = this.activePromises.get(runId);
+    if (p) {
+      await p;
+    }
+  }
+
+  public async stop(): Promise<void> {
+    for (const controller of this.activeControllers.values()) {
+      controller.abort();
+    }
+    await Promise.allSettled(Array.from(this.activePromises.values()));
+    this.activeControllers.clear();
+    this.activePromises.clear();
+    this.activeRunOwner.clear();
+  }
+
+  private assertNotEmergencyStopped(): void {
+    if (this.emergency?.getProcessStop?.()) {
+      throw new Error("EMERGENCY_STOP_ACTIVE");
+    }
+  }
+
+  private launchSingleFlightExecution(
+    runId: string,
+    ownerId: string
+  ): Promise<ResearchRunView> {
+    const existingPromise = this.activePromises.get(runId);
+    if (existingPromise) {
+      return existingPromise;
+    }
+    this.activeRunOwner.set(runId, ownerId);
+    const promise = this.executeFromLastCheckpoint(runId, ownerId).finally(() => {
+      this.activePromises.delete(runId);
+      this.activeControllers.delete(runId);
+      this.activeRunOwner.delete(runId);
+    });
+    this.activePromises.set(runId, promise);
+    return promise;
+  }
+
+  private async executeFromLastCheckpoint(
+    runId: string,
+    ownerId: string
+  ): Promise<ResearchRunView> {
+    const controller = new AbortController();
+    this.activeControllers.set(runId, controller);
+    const startWallMs = this.clock();
+
+    const initialRun = this.store.getRunForOwner(runId, ownerId);
+    const priorElapsedMs = initialRun.budgets.elapsedMs;
+    const maxRuntimeMs = initialRun.budgets.maxRuntimeMs;
+
+    this.store.updateRunStatus(runId, ownerId, {
+      status: "running",
+      errorCode: null,
+      errorMessage: null
+    });
+
+    while (true) {
+      if (controller.signal.aborted) {
+        this.store.updateRunStatus(runId, ownerId, {
+          status: "cancelled",
+          elapsedMs: priorElapsedMs + Math.max(0, this.clock() - startWallMs),
+          errorCode: "RESEARCH_CANCELLED_BY_OWNER",
+          errorMessage: "Исследование остановлено пользователем; контрольная точка сохранена."
+        });
+        return this.store.getRunForOwner(runId, ownerId);
+      }
+
+      const currentElapsed = priorElapsedMs + Math.max(0, this.clock() - startWallMs);
+      if (currentElapsed > maxRuntimeMs) {
+        this.store.updateRunStatus(runId, ownerId, {
+          status: "failed",
+          elapsedMs: currentElapsed,
+          errorCode: "RESEARCH_RUNTIME_BUDGET_EXCEEDED",
+          errorMessage: `Превышен лимит времени исследования (${maxRuntimeMs} мс).`
+        });
+        return this.store.getRunForOwner(runId, ownerId);
+      }
+
+      const steps = this.store.listSteps(runId);
+      const nextStep = steps.find(
+        (s) =>
+          s.status === "pending" ||
+          s.status === "failed" ||
+          s.status === "cancelled"
+      );
+
+      if (!nextStep) {
+        break;
+      }
+
+      this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+        status: "running",
+        incrementAttempts: true
+      });
+
+      try {
+        if (nextStep.stepKind === "search") {
+          const currentRun = this.store.getRunForOwner(runId, ownerId);
+
+          if (
+            !currentRun.checkpoint.plan_model_completed &&
+            this.gateway &&
+            typeof this.gateway.planResearchQueries === "function"
+          ) {
+            const planRes = await this.gateway.planResearchQueries({
+              query: currentRun.query,
+              ownerId,
+              projectId: currentRun.projectId
+            });
+            this.store.updateRunCheckpointEnvelope(runId, ownerId, {
+              plan_model_completed: true,
+              planned_queries: planRes.queries,
+              model_calls_count: currentRun.checkpoint.model_calls_count + 1
+            });
+          } else if (!currentRun.checkpoint.plan_model_completed) {
+            this.store.updateRunCheckpointEnvelope(runId, ownerId, {
+              plan_model_completed: true,
+              planned_queries: [currentRun.query]
+            });
+          }
+
+          const candidates = await this.browserAdapter.searchSources(
+            currentRun.query,
+            {
+              maxResults: currentRun.budgets.maxSources,
+              signal: controller.signal
+            }
+          );
+
+          this.store.registerDiscoveredSourceSteps(
+            runId,
+            ownerId,
+            candidates.map((c) => ({
+              url: c.originalUrl,
+              depth: c.depth,
+              initialExpectedVersion: c.initialExpectedVersion
+            }))
+          );
+
+          this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+            status: "completed",
+            checkpoint: {
+              discoveredCount: candidates.length,
+              completedAt: new Date().toISOString()
+            }
+          });
+        } else if (nextStep.stepKind === "read_project_docs") {
+          const currentRun = this.store.getRunForOwner(runId, ownerId);
+          const expectedTargets = this.store.getExpectedTargets(runId, ownerId);
+          const docs = this.store.listProjectLibraryDocuments(
+            ownerId,
+            currentRun.projectId
+          );
+
+          for (const doc of docs) {
+            const docUrl = `kosmora-doc://${doc.projectId}/${doc.id}`;
+            const extractedClaims = extractClaimsFromProjectDocumentText(
+              doc.extractedText,
+              expectedTargets
+            );
+            this.store.upsertSourceSnapshot(runId, ownerId, {
+              originalUrl: docUrl,
+              title: `Документ проекта: ${doc.name}`,
+              fetchedAt: doc.createdAt,
+              publishedAt: doc.createdAt,
+              pageVersion: `pv-doc-${doc.sha256.slice(0, 12)}`,
+              contentText: doc.extractedText,
+              depth: 1,
+              httpStatus: 200,
+              extractedClaims
+            });
+          }
+
+          this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+            status: "completed",
+            checkpoint: {
+              ingestedProjectDocsCount: docs.length,
+              completedAt: new Date().toISOString()
+            }
+          });
+        } else if (nextStep.stepKind === "read_source") {
+          const targetUrl = nextStep.targetUrl!;
+          const initialExpectedVersion =
+            typeof nextStep.checkpoint.initialExpectedVersion === "string"
+              ? nextStep.checkpoint.initialExpectedVersion
+              : null;
+
+          const snap = await this.browserAdapter.readSourcePage(targetUrl, {
+            depth: nextStep.depth,
+            signal: controller.signal
+          });
+
+          if (controller.signal.aborted) {
+            this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+              status: "cancelled",
+              errorCode: "RESEARCH_CANCELLED_BY_OWNER"
+            });
+            this.store.updateRunStatus(runId, ownerId, {
+              status: "cancelled",
+              elapsedMs: priorElapsedMs + Math.max(0, this.clock() - startWallMs),
+              errorCode: "RESEARCH_CANCELLED_BY_OWNER",
+              errorMessage: "Исследование остановлено во время чтения источника."
+            });
+            return this.store.getRunForOwner(runId, ownerId);
+          }
+
+          const savedSource = this.store.upsertSourceSnapshot(runId, ownerId, {
+            originalUrl: snap.originalUrl,
+            title: snap.title,
+            fetchedAt: snap.fetchedAt,
+            publishedAt: snap.publishedAt,
+            pageVersion: snap.pageVersion,
+            initialExpectedVersion,
+            contentText: snap.contentText,
+            depth: snap.depth,
+            httpStatus: snap.httpStatus,
+            extractedClaims: snap.extractedClaims
+          });
+
+          this.store.updateRunStatus(runId, ownerId, {
+            depthReached: snap.depth,
+            elapsedMs: priorElapsedMs + Math.max(0, this.clock() - startWallMs)
+          });
+
+          if (snap.outlinks && snap.outlinks.length > 0) {
+            this.store.registerDiscoveredSourceSteps(runId, ownerId, snap.outlinks);
+          }
+
+          this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+            status: "completed",
+            checkpoint: {
+              sourceId: savedSource.sourceId,
+              canonicalUrl: savedSource.canonicalUrl,
+              pageVersion: savedSource.pageVersion,
+              previousPageVersion: savedSource.previousPageVersion,
+              pageChanged: savedSource.pageChanged,
+              fetchedAt: savedSource.fetchedAt
+            }
+          });
+        } else if (nextStep.stepKind === "synthesize") {
+          const sources = this.store.listSources(runId);
+          const expectedTargets = this.store.getExpectedTargets(runId, ownerId);
+          const synthesized = synthesizeResearchClaims({
+            runId,
+            expectedTargets,
+            sources
+          });
+
+          this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+            status: "completed",
+            checkpoint: {
+              confirmedCount: synthesized.confirmedClaims.length,
+              conflictingCount: synthesized.conflictingClaims.length,
+              unconfirmedCount: synthesized.unconfirmedClaims.length,
+              synthesizedAt: new Date().toISOString()
+            }
+          });
+
+          this.store.updateRunStatus(runId, ownerId, {
+            elapsedMs: priorElapsedMs + Math.max(0, this.clock() - startWallMs)
+          });
+
+          this.store.saveSynthesizedClaimsAndReport(
+            runId,
+            ownerId,
+            synthesized.allClaims,
+            "completed"
+          );
+        }
+      } catch (stepErr) {
+        const message = stepErr instanceof Error ? stepErr.message : String(stepErr);
+        if (controller.signal.aborted || message === "RESEARCH_CANCELLED") {
+          this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+            status: "cancelled",
+            errorCode: "RESEARCH_CANCELLED_BY_OWNER"
+          });
+          this.store.updateRunStatus(runId, ownerId, {
+            status: "cancelled",
+            elapsedMs: priorElapsedMs + Math.max(0, this.clock() - startWallMs),
+            errorCode: "RESEARCH_CANCELLED_BY_OWNER",
+            errorMessage: "Исследование остановлено пользователем во время выполнения шага."
+          });
+          return this.store.getRunForOwner(runId, ownerId);
+        }
+
+        this.store.checkpointStep(runId, ownerId, nextStep.stepKey, {
+          status: "failed",
+          errorCode: message
+        });
+        this.store.updateRunStatus(runId, ownerId, {
+          status: "failed",
+          elapsedMs: priorElapsedMs + Math.max(0, this.clock() - startWallMs),
+          errorCode: message,
+          errorMessage: `Сбой на шаге ${nextStep.stepKey}: ${message}`
+        });
+        return this.store.getRunForOwner(runId, ownerId);
+      }
+    }
+
+    return this.store.getRunForOwner(runId, ownerId);
+  }
+}
diff --git a/apps/api/src/research/research-privacy-adapter.ts b/apps/api/src/research/research-privacy-adapter.ts
new file mode 100644
index 0000000..cacdffe
--- /dev/null
+++ b/apps/api/src/research/research-privacy-adapter.ts
@@ -0,0 +1,238 @@
+import type { DatabaseSync } from "node:sqlite";
+import type { ResearchCoordinator } from "./research-coordinator.js";
+import type { ResearchStore } from "./research-store.js";
+
+export interface ResearchPrivacyExportSection {
+  records: {
+    runs: Record<string, unknown>[];
+    steps: Record<string, unknown>[];
+    sources: Record<string, unknown>[];
+    claims: Record<string, unknown>[];
+    research_runs: Record<string, unknown>[];
+    research_run_steps: Record<string, unknown>[];
+    research_sources: Record<string, unknown>[];
+    research_claims: Record<string, unknown>[];
+  };
+  originals: Array<{
+    id: string;
+    filename: string;
+    content_type: string;
+    size_bytes: number;
+    sha256: string;
+  }>;
+  complete: boolean;
+}
+
+/**
+ * Canonical `ResearchIntegratedPrivacyAdapter` referenced by `apps/api/src/server.ts` (line 203):
+ * `new ResearchIntegratedPrivacyAdapter(database.sqlite, researchStore, () => researchCoordinator)`
+ *
+ * Implements owner lifecycle quiesce (aborting in-flight research runs for the owner and fencing writes),
+ * full GDPR/owner data export (`research_runs`, `research_run_steps`, `research_sources`, `research_claims`),
+ * transactional owner deletion without affecting other owners, and lifecycle resume.
+ */
+export class ResearchIntegratedPrivacyAdapter {
+  public readonly id = "research";
+
+  constructor(
+    private readonly sqlite: DatabaseSync,
+    private readonly store: ResearchStore,
+    private readonly getCoordinator: () => ResearchCoordinator | null
+  ) {}
+
+  public async quiesce(
+    ownerId: string,
+    epoch: number
+  ): Promise<{ drained: true; fence_epoch: number; cancelled_runs: number }> {
+    const coordinator = this.getCoordinator();
+    const cancelledRuns = coordinator ? await coordinator.quiesceOwner(ownerId) : 0;
+    const now = new Date().toISOString();
+
+    this.sqlite.exec("BEGIN IMMEDIATE");
+    try {
+      this.sqlite
+        .prepare(
+          `INSERT INTO kosmora_owner_data_lifecycle (owner_id, state, epoch, updated_at)
+           VALUES (?, 'quiescing', ?, ?)
+           ON CONFLICT(owner_id) DO UPDATE SET
+             state = 'quiescing',
+             epoch = excluded.epoch,
+             updated_at = excluded.updated_at`
+        )
+        .run(ownerId, epoch, now);
+
+      this.sqlite
+        .prepare(
+          `UPDATE research_runs
+           SET status = 'cancelled',
+               error_code = 'OWNER_DATA_QUIESCED',
+               error_message = 'Остановлено на время операции приватности владельца.',
+               updated_at = ?
+           WHERE owner_id = ? AND status IN ('queued', 'running')`
+        )
+        .run(now, ownerId);
+
+      this.sqlite.exec("COMMIT");
+    } catch (err) {
+      try {
+        this.sqlite.exec("ROLLBACK");
+      } catch {
+        /* ignore */
+      }
+      throw err;
+    }
+
+    return {
+      drained: true,
+      fence_epoch: epoch,
+      cancelled_runs: cancelledRuns
+    };
+  }
+
+  public async export(ownerId: string): Promise<ResearchPrivacyExportSection> {
+    const runs = this.sqlite
+      .prepare("SELECT * FROM research_runs WHERE owner_id = ? ORDER BY created_at ASC, id ASC")
+      .all(ownerId) as Array<{ id: string }>;
+
+    const steps: unknown[] = [];
+    for (const run of runs) {
+      const runSteps = this.sqlite
+        .prepare(
+          "SELECT * FROM research_run_steps WHERE run_id = ? ORDER BY step_index ASC"
+        )
+        .all(run.id);
+      steps.push(...runSteps);
+    }
+
+    const sources = this.sqlite
+      .prepare(
+        "SELECT * FROM research_sources WHERE owner_id = ? ORDER BY fetched_at ASC, source_id ASC"
+      )
+      .all(ownerId);
+
+    const claims = this.sqlite
+      .prepare(
+        "SELECT * FROM research_claims WHERE owner_id = ? ORDER BY created_at ASC, claim_id ASC"
+      )
+      .all(ownerId);
+
+    return {
+      records: {
+        runs: runs as Record<string, unknown>[],
+        steps: steps as Record<string, unknown>[],
+        sources: sources as Record<string, unknown>[],
+        claims: claims as Record<string, unknown>[],
+        research_runs: runs as Record<string, unknown>[],
+        research_run_steps: steps as Record<string, unknown>[],
+        research_sources: sources as Record<string, unknown>[],
+        research_claims: claims as Record<string, unknown>[]
+      },
+      originals: [],
+      complete: true
+    };
+  }
+
+  public async delete(
+    ownerId: string,
+    epoch: number
+  ): Promise<{ deleted_records: number }> {
+    const coordinator = this.getCoordinator();
+    if (coordinator) {
+      await coordinator.quiesceOwner(ownerId);
+    }
+
+    let deleted = 0;
+    const now = new Date().toISOString();
+
+    this.sqlite.exec("BEGIN IMMEDIATE");
+    try {
+      this.sqlite
+        .prepare(
+          `INSERT INTO kosmora_owner_data_lifecycle (owner_id, state, epoch, updated_at)
+           VALUES (?, 'deleting', ?, ?)
+           ON CONFLICT(owner_id) DO UPDATE SET
+             state = 'deleting',
+             epoch = excluded.epoch,
+             updated_at = excluded.updated_at`
+        )
+        .run(ownerId, epoch, now);
+
+      const ownerRuns = this.sqlite
+        .prepare("SELECT id FROM research_runs WHERE owner_id = ?")
+        .all(ownerId) as Array<{ id: string }>;
+
+      for (const r of ownerRuns) {
+        deleted += Number(
+          this.sqlite
+            .prepare("DELETE FROM research_run_steps WHERE run_id = ?")
+            .run(r.id).changes || 0
+        );
+      }
+
+      deleted += Number(
+        this.sqlite
+          .prepare("DELETE FROM research_claims WHERE owner_id = ?")
+          .run(ownerId).changes || 0
+      );
+      deleted += Number(
+        this.sqlite
+          .prepare("DELETE FROM research_sources WHERE owner_id = ?")
+          .run(ownerId).changes || 0
+      );
+      deleted += Number(
+        this.sqlite
+          .prepare("DELETE FROM research_runs WHERE owner_id = ?")
+          .run(ownerId).changes || 0
+      );
+      deleted += Number(
+        this.sqlite
+          .prepare(
+            "DELETE FROM kosmora_roaring_inverted_snapshots WHERE owner_id = ? AND namespace = 'research_evidence'"
+          )
+          .run(ownerId).changes || 0
+      );
+      deleted += Number(
+        this.sqlite
+          .prepare(
+            "DELETE FROM kosmora_probabilistic_filter_snapshots WHERE owner_id = ? AND namespace = 'research_evidence'"
+          )
+          .run(ownerId).changes || 0
+      );
+      deleted += Number(
+        this.sqlite
+          .prepare(
+            "DELETE FROM kosmora_session_audit_blackbox WHERE owner_id = ? AND session_id LIKE 'research:%'"
+          )
+          .run(ownerId).changes || 0
+      );
+
+      this.sqlite
+        .prepare(
+          "UPDATE kosmora_owner_data_lifecycle SET state = 'deleted', epoch = ?, updated_at = ? WHERE owner_id = ?"
+        )
+        .run(epoch, now, ownerId);
+
+      this.sqlite.exec("COMMIT");
+    } catch (err) {
+      try {
+        this.sqlite.exec("ROLLBACK");
+      } catch {
+        /* ignore */
+      }
+      throw err;
+    }
+
+    return { deleted_records: deleted };
+  }
+
+  public async resume(ownerId: string): Promise<void> {
+    const now = new Date().toISOString();
+    this.sqlite
+      .prepare(
+        `UPDATE kosmora_owner_data_lifecycle
+         SET state = 'active', updated_at = ?
+         WHERE owner_id = ?`
+      )
+      .run(now, ownerId);
+  }
+}
diff --git a/apps/api/src/research/research-routes.ts b/apps/api/src/research/research-routes.ts
new file mode 100644
index 0000000..589502f
--- /dev/null
+++ b/apps/api/src/research/research-routes.ts
@@ -0,0 +1,605 @@
+import type { FastifyInstance, FastifyRequest } from "fastify";
+import type { IdentityContext } from "@cosmora/contracts";
+import type { ResearchBrowserAdapter } from "./browser-research-adapter.js";
+import {
+  ResearchCoordinator,
+  type ResearchModelPlannerGateway
+} from "./research-coordinator.js";
+import type { ResearchStore, VerifiableResearchBundle } from "./research-store.js";
+import {
+  ProjectResearchOwnerBudget,
+  type ResearchBudgetLimits,
+  type ResearchOwnerBudget
+} from "./research-synthesis.js";
+
+export interface RegisterResearchRoutesDependencies {
+  app: FastifyInstance;
+  store: ResearchStore;
+  gateway?: ResearchModelPlannerGateway | unknown;
+  manager?: unknown;
+  ownerBudget?: ResearchOwnerBudget;
+  search?: unknown;
+  browserAdapter?: ResearchBrowserAdapter;
+  projects?: { getProject?(id: string, ownerId?: string): unknown } | null;
+  policy?: unknown;
+  identityFor: (request: FastifyRequest) => IdentityContext;
+  emergency?: { getProcessStop?(): unknown } | null;
+}
+
+const noCache = (reply: { header(name: string, value: string): unknown }) => {
+  reply.header("Cache-Control", "private, no-store");
+  reply.header("X-Content-Type-Options", "nosniff");
+  reply.header("Referrer-Policy", "no-referrer");
+};
+
+function requireOwnerIdentity(
+  request: FastifyRequest,
+  identityFor: (req: FastifyRequest) => IdentityContext
+): { ownerId: string; sessionId: string } {
+  const identity = identityFor(request);
+  if (!identity || identity.actor?.kind !== "owner" || !identity.owner_id) {
+    throw new Error("OWNER_AUTH_REQUIRED");
+  }
+  const rec = identity as unknown as Record<string, unknown>;
+  const sessionId =
+    typeof rec.session_id === "string" && rec.session_id.length > 0
+      ? rec.session_id
+      : `owner_session:${identity.owner_id}`;
+  return {
+    ownerId: identity.owner_id,
+    sessionId
+  };
+}
+
+function httpStatusForResearchError(code: string): number {
+  if (
+    code === "OWNER_AUTH_REQUIRED" ||
+    code === "RESEARCH_RUN_FORBIDDEN" ||
+    code === "RESEARCH_PROJECT_FORBIDDEN"
+  ) {
+    return 403;
+  }
+  if (code === "RESEARCH_RUN_NOT_FOUND" || code === "RESEARCH_PROJECT_NOT_FOUND" || code === "RESEARCH_CLAIM_NOT_FOUND") {
+    return 404;
+  }
+  if (
+    code === "OWNER_DATA_FENCED" ||
+    code === "EMERGENCY_STOP_ACTIVE" ||
+    code === "RESEARCH_REPORT_NOT_READY"
+  ) {
+    return 409;
+  }
+  if (code === "RESEARCH_QUOTA_EXCEEDED" || code === "RESEARCH_RUNTIME_BUDGET_EXCEEDED" || code === "WORKFLOW_STEP_MAX_ATTEMPTS_EXCEEDED") {
+    return 429;
+  }
+  return 400;
+}
+
+export function registerResearchRoutes(
+  deps: RegisterResearchRoutesDependencies
+): ResearchCoordinator {
+  deps.store.recoverInterruptedRuns();
+
+  const budget =
+    deps.ownerBudget ??
+    new ProjectResearchOwnerBudget(deps.store.sqlite, deps.projects ?? null, null);
+
+  const coordinator = new ResearchCoordinator({
+    store: deps.store,
+    browserAdapter: deps.browserAdapter,
+    gateway: (deps.gateway as ResearchModelPlannerGateway) ?? null,
+    ownerBudget: budget,
+    emergency: deps.emergency ?? null
+  });
+
+  const { app, identityFor } = deps;
+
+  app.post("/api/v1/research/runs", async (request, reply) => {
+    noCache(reply);
+    try {
+      const { ownerId } = requireOwnerIdentity(request, identityFor);
+      const body = (request.body ?? {}) as {
+        project_id?: string | null;
+        query?: string;
+        client_request_id?: string | null;
+        expected_targets?: Array<{ subject: string; criterion: string }>;
+        budgets?: Partial<ResearchBudgetLimits>;
+        include_project_documents?: boolean;
+        run_in_background?: boolean;
+      };
+
+      const query = String(body.query ?? "").trim();
+      if (!query) {
+        return reply.status(400).send({
+          error: { code: "RESEARCH_QUERY_REQUIRED", message: "Поисковый запрос обязателен." }
+        });
+      }
+
+      const run = await coordinator.startRun({
+        ownerId,
+        projectId: body.project_id ?? null,
+        query,
+        clientRequestId: body.client_request_id ?? null,
+        expectedTargets: body.expected_targets,
+        budgets: body.budgets,
+        includeProjectDocuments: body.include_project_documents,
+        runInBackground: Boolean(body.run_in_background)
+      });
+
+      return reply.status(200).send(run);
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "RESEARCH_START_FAILED";
+      return reply.status(httpStatusForResearchError(code)).send({
+        error: { code, message: "Не удалось запустить исследовательскую задачу." }
+      });
+    }
+  });
+
+  app.get("/api/v1/research/runs", async (request, reply) => {
+    noCache(reply);
+    try {
+      const { ownerId } = requireOwnerIdentity(request, identityFor);
+      const q = (request.query ?? {}) as { project_id?: string };
+      const items = coordinator.listRuns(ownerId, q.project_id ?? null);
+      return reply.status(200).send({ items });
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "RESEARCH_LIST_FAILED";
+      return reply.status(httpStatusForResearchError(code)).send({
+        error: { code, message: "Не удалось получить список исследовательских задач." }
+      });
+    }
+  });
+
+  app.get("/api/v1/research/runs/:runId", async (request, reply) => {
+    noCache(reply);
+    try {
+      const { ownerId } = requireOwnerIdentity(request, identityFor);
+      const params = (request.params ?? {}) as { runId: string };
+      const run = coordinator.getRun(params.runId, ownerId);
+      return reply.status(200).send(run);
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "RESEARCH_GET_FAILED";
+      return reply.status(httpStatusForResearchError(code)).send({
+        error: { code, message: "Доступ к исследовательской задаче запрещён или она не найдена." }
+      });
+    }
+  });
+
+  app.post("/api/v1/research/runs/:runId/cancel", async (request, reply) => {
+    noCache(reply);
+    try {
+      const { ownerId } = requireOwnerIdentity(request, identityFor);
+      const params = (request.params ?? {}) as { runId: string };
+      const run = coordinator.cancelRun(params.runId, ownerId);
+      return reply.status(200).send(run);
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "RESEARCH_CANCEL_FAILED";
+      return reply.status(httpStatusForResearchError(code)).send({
+        error: { code, message: "Не удалось остановить исследовательскую задачу." }
+      });
+    }
+  });
+
+  app.post("/api/v1/research/runs/:runId/resume", async (request, reply) => {
+    noCache(reply);
+    try {
