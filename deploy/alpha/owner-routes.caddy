encode zstd gzip
header Cache-Control "private, no-store"
@owner_login path /login /__owner/login /__owner/logout
handle @owner_login {
	reverse_proxy owner-access:3080 {
		header_up X-Cosmora-Client-IP {remote_host}
		header_up -Authorization
	}
}
handle {
	forward_auth owner-access:3080 {
		uri /__owner/verify
	}
	@api path /api/*
	handle @api {
		reverse_proxy api:3100 {
			header_up Authorization "Bearer {$COSMORA_OWNER_SESSION_TOKEN}"
		}
	}
	handle {
		reverse_proxy web:3000 {
			header_up -Authorization
		}
	}
}
