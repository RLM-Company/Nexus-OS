{$COSMORA_DEMO_DOMAIN} {
	encode zstd gzip

	basic_auth {
		owner {$COSMORA_BASIC_AUTH_HASH}
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:3100 {
			header_up Authorization "Bearer {$COSMORA_OWNER_SESSION_TOKEN}"
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up -Authorization
		}
	}
}
