# Copy to deploy/alpha/private/drive.env. API only; never expose as NEXT_PUBLIC_*.
# Keep disabled until a public HTTPS domain and the separate Google OAuth client exist.
KOSMORA_DRIVE_ENABLED=0
KOSMORA_DRIVE_CLIENT_ID=
KOSMORA_DRIVE_CLIENT_SECRET=
# A persistent random 32-byte key encoded as canonical base64; keep outside DB backups.
KOSMORA_DRIVE_ENCRYPTION_KEY=
