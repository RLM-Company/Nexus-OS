# Google Drive Integration Environment Variables for Kosmora Alpha VPS
# Copy to ./private/drive.env and populate with authorized credentials.
# Do NOT commit actual secrets to git!

# OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret

# OAuth Redirect URI (must match Google Cloud Console authorized redirect URIs)
GOOGLE_DRIVE_REDIRECT_URI=https://${COSMORA_DEMO_DOMAIN}/api/cloud-storage/google-drive/callback

# Persistent 32-byte (256-bit) Hex Encryption Key for AES-256-GCM token cipher
# Generate with: openssl rand -hex 32
GOOGLE_DRIVE_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-do-not-share

# Local spooling directory inside the container for atomic ZIP uploads
GOOGLE_DRIVE_SPOOL_DIR=/var/lib/cosmora/drive-spool
GOOGLE_DRIVE_MAX_SPOOL_BYTES=134217728
GOOGLE_DRIVE_MAX_RETAINED_BACKUPS=10
