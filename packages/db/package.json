{
  "name": "@cosmora/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node dist/migrate.js",
    "lint": "eslint src test drizzle.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cosmora/config": "workspace:*",
    "@cosmora/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "typebox": "1.3.16"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
