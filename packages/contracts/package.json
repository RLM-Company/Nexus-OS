{
  "name": "@cosmora/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./chat-attachments": {
      "development": "./src/chat-attachments.ts",
      "types": "./src/chat-attachments.ts",
      "default": "./dist/chat-attachments.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
