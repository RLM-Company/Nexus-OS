{
  "name": "@cosmora/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./apex": {
      "development": "./src/apex/index.ts",
      "types": "./src/apex/index.ts",
      "default": "./dist/apex/index.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cosmora/contracts": "workspace:*"
  }
}
