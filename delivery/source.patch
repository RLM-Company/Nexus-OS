+class KosworkChromiumCdpDriver {
+  constructor(options = {}) {
+    this.chromiumPath = options.chromiumPath || "/usr/bin/chromium";
+    this.debuggingPort = Number(options.debuggingPort || 0);
+    this.proc = null;
+    this.userDataDir = null;
