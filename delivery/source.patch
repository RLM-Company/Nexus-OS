+                eventListeners.set(eventName, []);
+              }
+              eventListeners.get(eventName).push(handler);
+            },
+            close() {
+              for (const [, p] of pending.entries()) {
+                p.reject(new Error("CDP_SOCKET_CLOSED"));
+              }
+              pending.clear();
+              socket.destroy();
+            }
+          });
+          parseFrames();
+        }
+      } else {
+        parseFrames();
+      }
+    });
+
+    socket.on("error", (err) => {
+      if (!handshakeDone) reject(err);
+    });
+  });
+}
