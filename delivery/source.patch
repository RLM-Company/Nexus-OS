+    },
+    {
+      optionName: 'Option Alpha',
+      criterion: 'Цена',
+      searchPhrase: 'базовая цена составляет $79/мес',
+      value: '$79/мес',
+    },
+    {
+      optionName: 'Option Alpha',
+      criterion: 'SLA',
+      searchPhrase: 'SLA 99.95%',
+      value: '99.95%',
+    },
+    {
+      optionName: 'Option Alpha',
+      criterion: 'Задержка p95',
+      searchPhrase: 'задержка p95 < 12 мс',
