+
+  if (report.rejectedClaims.length > 0) {
+    lines.push(``, `## 5. Отклонённые неподтверждённые тезисы (защита от ложных цитат)`);
+    for (const rej of report.rejectedClaims) {
+      lines.push(
+        `- **${rej.optionName} / ${rej.criterion}** (\`${rej.claimedValue}\`): отклонено (\`${rej.code}\` — ${rej.reason})`
+      );
+    }
+  }
+
+  return lines.join("\n") + "\n";
+}
+
+function renderResearchReportHtml(report) {
+  const md = renderResearchReportMarkdown(report);
+  const escaped = md
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;");
+  return `<!doctype html><html lang="ru"><head><meta charset="utf-8"/><title>${report.question}</title></head><body><pre>${escaped}</pre></body></html>\n`;
+}
+
+async function saveResearchReportArtifactsViaCodexAdapters({
+  workspaceRoot,
+  slug = "deep-research-report",
+  report,
+  exportDocx = true,
+  exportXlsx = true,
+  signal = null
+} = {}) {
+  const mdContent = renderResearchReportMarkdown(report);
+  const htmlContent = renderResearchReportHtml(report);
+  const jsonContent = JSON.stringify(report, null, 2) + "\n";
+
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const mdFile = await svc.createFile({
+    relativePath: `reports/${slug}.md`,
+    content: mdContent,
+    createParents: true,
+    signal
+  });
+  const htmlFile = await svc.createFile({
+    relativePath: `reports/${slug}.html`,
+    content: htmlContent,
+    createParents: true,
+    signal
+  });
+  const jsonFile = await svc.createFile({
+    relativePath: `reports/${slug}.json`,
+    content: jsonContent,
+    createParents: true,
+    signal
+  });
+
+  let docxArtifact = null;
+  if (exportDocx) {
+    const sources = [];
+    for (const row of report.comparisonRows) {
+      for (const cell of Object.values(row.cells)) {
+        if (cell.sourceUrl && !sources.some((s) => s.url === cell.sourceUrl)) {
+          sources.push({
+            title: cell.sourceTitle || cell.sourceUrl,
+            url: cell.sourceUrl,
+            retrievedAt: cell.fetchedAt
+          });
+        }
+      }
+    }
+    docxArtifact = saveWordReportToWorkspace({
+      workspaceRoot,
+      relativePath: `reports/${slug}.docx`,
+      reportSpec: {
+        title: report.question,
+        sections: [
+          {
+            heading: "Сводка исследования и проверяемые выдержки",
+            paragraphs: mdContent.split("\n").filter(Boolean)
+          }
+        ],
+        sources
+      }
+    });
+  }
+
+  let xlsxArtifact = null;
+  if (exportXlsx && typeof saveWorkbookToWorkspace === "function") {
+    const rows = [
+      ["Вариант", "Критерий", "Значение", "Статус", "Цитата", "UTF-16", "URL", "pageDate", "eventDate", "fetchedAt"]
+    ];
+    for (const row of report.comparisonRows) {
+      for (const crit of report.criteria) {
+        const c = row.cells[crit];
+        rows.push([
+          row.optionName,
+          crit,
+          c?.displayValue || "не удалось установить",
+          c?.status || "unverified",
+          c?.quote || "",
+          c?.startUtf16 >= 0 ? `${c.startUtf16}..${c.endUtf16}` : "",
+          c?.sourceUrl || "",
+          c?.pageDate || "",
+          c?.eventDate || "",
+          c?.fetchedAt || ""
+        ]);
+      }
+    }
+    xlsxArtifact = saveWorkbookToWorkspace({
+      workspaceRoot,
+      relativePath: `reports/${slug}.xlsx`,
+      workbookSpec: {
+        sheets: [{ name: "Comparison", rows }]
+      }
+    });
+  }
+
+  return {
+    markdownFile: mdFile,
+    htmlFile: htmlFile,
+    jsonFile: jsonFile,
+    docxArtifact,
+    xlsxArtifact
+  };
+}
+
+module.exports = {
+  buildStructuredResearchReport,
+  renderResearchReportHtml,
+  renderResearchReportMarkdown,
+  saveResearchReportArtifactsViaCodexAdapters
+};
diff --git a/desktop/windows/browser/research-workflow.cjs b/desktop/windows/browser/research-workflow.cjs
new file mode 100644
index 0000000..f308560
--- /dev/null
+++ b/desktop/windows/browser/research-workflow.cjs
@@ -0,0 +1,295 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const {
+  buildStructuredResearchReport,
+  saveResearchReportArtifactsViaCodexAdapters
+} = require("./research-report-builder.cjs");
+
+/**
+ * Koswork End-to-End Multi-Site Deep Research Workflow (`desktop/windows/browser/research-workflow.cjs`).
+ *
+ * Implements Queue Items #5 & #6:
+ * - Decomposes the research goal into targeted sub-questions (`decomposeResearchGoalIntoQuestions`).
+ * - Limits repeated search queries (`maxQueriesPerQuestion`, `maxTotalQueries`) — no infinite loops.
+ * - Executes multi-page SERP search, deduplicates URLs/content, opens diverse sources in real Chromium,
+ *   reads long pages (`>18,000` UTF-16 chars) across scrolled windows, and runs bounded follow-up
+ *   searches for missing confirmations.
+ * - Evaluates contradictions across sources, marks unconfirmed cells honestly as `"не удалось установить"`,
+ *   saves a real report artifact via the existing Codex workspace/Office adapters, and supports
+ *   cancellation / checkpoint continuation + project handoff hook (`onProjectArtifactReady`).
+ */
+
+function decomposeResearchGoalIntoQuestions({
+  question,
+  options = ["Option Alpha", "Option Beta"],
+  criteria = ["Цена", "SLA", "Задержка p95"]
+} = {}) {
+  const base = String(question || "Исследование вариантов").trim();
+  const subQuestions = [];
+  for (const opt of options) {
+    subQuestions.push(
+      `Каковы подтверждённые первоисточниками значения критериев (${criteria.join(", ")}) для ${opt}?`
+    );
+  }
+  subQuestions.push(
+    `Имеются ли противоречия или устаревшие данные между источниками по теме: «${base}»?`
+  );
+  return subQuestions;
+}
+
+async function executeMultiSiteResearchWorkflow({
+  engine,
+  workspaceRoot,
+  question,
+  options = ["Option Alpha", "Option Beta"],
+  criteria = ["Цена", "SLA", "Задержка p95"],
+  extractionRules = [],
+  maxQueriesPerQuestion = 2,
+  maxTotalQueries = 6,
+  maxSerpPages = 2,
+  reportSlug = "browser-deep-research-report",
+  checkpointFilePath = null,
+  resumeFromCheckpoint = false,
+  onProjectArtifactReady = null,
+  signal = null
+} = {}) {
+  if (!engine) {
+    throw new Error("RESEARCH_WORKFLOW_REQUIRES_BROWSER_ENGINE");
+  }
+  if (!workspaceRoot) {
+    throw new Error("RESEARCH_WORKFLOW_REQUIRES_WORKSPACE_ROOT");
+  }
+
+  const resolvedCheckpointPath =
+    checkpointFilePath ||
+    path.join(workspaceRoot, ".koswork-research-checkpoint.json");
+
+  let state = {
+    question,
+    subQuestions: decomposeResearchGoalIntoQuestions({ question, options, criteria }),
+    executedQueries: [],
+    openedUrls: [],
+    extractedFacts: [],
+    unavailableSources: [],
+    completedSerpPages: 0
+  };
+
+  if (resumeFromCheckpoint && fs.existsSync(resolvedCheckpointPath)) {
+    try {
+      const saved = JSON.parse(fs.readFileSync(resolvedCheckpointPath, "utf8"));
+      if (saved && saved.question === question) {
+        state = { ...state, ...saved };
+      }
+    } catch {
+      // start fresh if checkpoint unreadable
+    }
+  }
+
+  const snapshotsByUrl = new Map();
+  let queriesUsed = state.executedQueries.length;
+
+  function persistCheckpoint(status = "in_progress") {
+    try {
+      fs.mkdirSync(path.dirname(resolvedCheckpointPath), { recursive: true });
+      fs.writeFileSync(
+        resolvedCheckpointPath,
+        JSON.stringify({ ...state, status, updatedAt: new Date().toISOString() }, null, 2),
+        "utf8"
+      );
+    } catch {
+      // ignore checkpoint write error
+    }
+  }
+
+  const normalizedQuerySeen = new Set(
+    state.executedQueries.map((q) => String(q).toLowerCase().trim())
+  );
+
+  async function runBoundedSearchAndCollect(queryStr, page = 1) {
+    if (signal?.aborted) {
+      persistCheckpoint("cancelled");
+      const err = new Error("RESEARCH_WORKFLOW_CANCELLED");
+      err.code = "RESEARCH_WORKFLOW_CANCELLED";
+      throw err;
+    }
+
+    const qKey = `${String(queryStr).toLowerCase().trim()}::p${page}`;
+    if (normalizedQuerySeen.has(qKey) || queriesUsed >= maxTotalQueries) {
+      return { skippedByBudget: true, items: [] };
+    }
+
+    normalizedQuerySeen.add(qKey);
+    queriesUsed += 1;
+    state.executedQueries.push(qKey);
+
+    const serp = await engine.searchService.search({
+      query: queryStr,
+      page,
+      pageSize: 5,
+      signal
+    });
+    state.completedSerpPages += 1;
+
+    for (const item of serp.items || []) {
+      if (signal?.aborted) {
+        persistCheckpoint("cancelled");
+        const err = new Error("RESEARCH_WORKFLOW_CANCELLED");
+        err.code = "RESEARCH_WORKFLOW_CANCELLED";
+        throw err;
+      }
+
+      if (state.openedUrls.includes(item.url)) {
+        continue;
+      }
+      state.openedUrls.push(item.url);
+
+      const visit = await engine.searchService.openSearchResult({
+        searchId: serp.searchId,
+        rank: item.rank,
+        url: item.url,
+        signal
+      });
+
+      if (!visit.available) {
+        state.unavailableSources.push({
+          url: visit.url,
+          httpStatus: visit.httpStatus,
+          reason: `Источник вернул HTTP ${visit.httpStatus}`
+        });
+        persistCheckpoint("in_progress");
+        continue;
+      }
+
+      if (visit.duplicateContentOfUrl) {
+        continue;
+      }
+
+      const tab = engine.tabs.get(visit.tabId);
+      if (!tab || !tab.snapshot) continue;
+
+      // If the page is a long article (> 12,000 UTF-16 chars), read through its scrolled windows
+      if (tab.snapshot.totalLengthUtf16 > 12000) {
+        let cursor = 0;
+        while (cursor < tab.snapshot.totalLengthUtf16) {
+          const win = await engine.readLongPage({
+            tabId: visit.tabId,
+            cursorUtf16: cursor,
+            windowChars: 5000,
+            overlapChars: 200,
+            scrollInChromium: true,
+            signal
+          });
+          if (!win.hasMore) break;
+          cursor = win.nextCursorUtf16;
+        }
+      }
+
+      snapshotsByUrl.set(visit.url, tab.snapshot);
+
+      for (const rule of extractionRules) {
+        try {
+          const exc = engine.extractExcerpt(visit.tabId, {
+            searchTerm: rule.searchPhrase
+          });
+          state.extractedFacts.push({
+            optionName: rule.optionName,
+            criterion: rule.criterion,
+            value: rule.value,
+            displayValue: rule.displayValue || rule.value,
+            excerpt: exc,
+            source: {
+              url: visit.url,
+              title: visit.title,
+              pageDate: visit.pageDate,
+              eventDate: visit.eventDate,
+              fetchedAt: visit.fetchedAt
+            }
+          });
+        } catch {
+          // phrase not present in this source
+        }
+      }
+
+      persistCheckpoint("in_progress");
+    }
+
+    return serp;
+  }
+
+  // Step 1: Primary search across SERP pages (up to maxSerpPages and maxQueriesPerQuestion)
+  for (let p = 1; p <= maxSerpPages; p += 1) {
+    if (queriesUsed >= maxTotalQueries) break;
+    await runBoundedSearchAndCollect(question, p);
+  }
+
+  // Step 2: Check for missing confirmations and run at most 1 targeted follow-up per option within budget
+  let followUpQueriesRun = 0;
+  for (const opt of options) {
+    for (const crit of criteria) {
+      const hasFact = state.extractedFacts.some(
+        (f) => f.optionName === opt && f.criterion === crit
+      );
+      if (
+        !hasFact &&
+        followUpQueriesRun < maxQueriesPerQuestion &&
+        queriesUsed < maxTotalQueries
+      ) {
+        followUpQueriesRun += 1;
+        await runBoundedSearchAndCollect(`${opt} ${crit}`, 1);
+      }
+    }
+  }
+
+  const report = buildStructuredResearchReport({
+    question,
+    subQuestions: state.subQuestions,
+    options,
+    criteria,
+    extractedFacts: state.extractedFacts,
+    snapshotsByUrl,
+    unavailableSources: state.unavailableSources,
+    queryBudgetStats: {
+      queriesUsed,
+      maxTotalQueries,
+      maxQueriesPerQuestion,
+      followUpQueriesRun
+    }
+  });
+
+  const savedArtifacts = await saveResearchReportArtifactsViaCodexAdapters({
+    workspaceRoot,
+    slug: reportSlug,
+    report,
+    exportDocx: true,
+    exportXlsx: true,
+    signal
+  });
+
+  persistCheckpoint("completed");
+
+  let projectHandoffReceipt = null;
+  if (typeof onProjectArtifactReady === "function") {
+    projectHandoffReceipt = await onProjectArtifactReady({
+      question,
+      report,
+      savedArtifacts
+    });
+  }
+
+  return {
+    status: "completed",
+    question,
+    report,
+    savedArtifacts,
+    projectHandoffReceipt,
+    checkpointFilePath: resolvedCheckpointPath,
+    telemetry: engine.resourceGovernor.getTelemetry()
+  };
+}
+
+module.exports = {
+  decomposeResearchGoalIntoQuestions,
+  executeMultiSiteResearchWorkflow
+};
diff --git a/desktop/windows/browser/resource-governor.cjs b/desktop/windows/browser/resource-governor.cjs
new file mode 100644
index 0000000..14d1ec0
--- /dev/null
+++ b/desktop/windows/browser/resource-governor.cjs
@@ -0,0 +1,191 @@
+"use strict";
+
+/**
+ * Koswork Browser Resource Governor (`desktop/windows/browser/resource-governor.cjs`).
+ *
+ * Enforces:
+ * - Live tab cap (`maxLiveTabs = 3`) with automatic LRU background tab hibernation
+ * - Task-level `AbortController` cancellation (`beginTask`, `cancelTask`, `cancelAllTasks`)
+ * - Valid snapshot cache reuse within `snapshotTtlMs`
+ * - Process memory (`rssBytes`, `heapUsedBytes`) and task latency telemetry
+ */
+class KosworkBrowserResourceGovernor {
+  constructor(options = {}) {
+    this.maxLiveTabs = Math.max(1, Number(options.maxLiveTabs ?? 3));
+    this.snapshotTtlMs = Math.max(100, Number(options.snapshotTtlMs ?? 30000));
+    this.liveTabs = new Map(); // tabId -> { tabId, lastActiveMs, url }
+    this.hibernatedTabs = new Map(); // tabId -> { tabId, hibernatedAtMs, url }
+    this.snapshotCache = new Map(); // url -> { snapshot, cachedAtMs }
+    this.activeTasks = new Map(); // taskId -> { taskId, kind, startedAtMs, controller }
+    this.completedLatenciesMs = [];
+    this.memorySamples = [];
+    this.peakLiveTabs = 0;
+    this.snapshotReuseHits = 0;
+  }
+
+  beginTask(taskId, kind = "browser_op", parentSignal = null) {
+    const id = String(taskId || `task-${Date.now()}`);
+    const controller = new AbortController();
+
+    if (parentSignal) {
+      if (parentSignal.aborted) {
+        controller.abort(parentSignal.reason || "parent_signal_aborted");
+      } else {
+        parentSignal.addEventListener(
+          "abort",
+          () => controller.abort(parentSignal.reason || "parent_signal_aborted"),
+          { once: true }
+        );
+      }
+    }
+
+    const startedAtMs = Date.now();
+    const entry = { taskId: id, kind, startedAtMs, controller };
+    this.activeTasks.set(id, entry);
+
+    return {
+      taskId: id,
+      controller,
+      finish: () => {
+        this.activeTasks.delete(id);
+        const latencyMs = Math.max(1, Date.now() - startedAtMs);
+        this.completedLatenciesMs.push(latencyMs);
+        return latencyMs;
+      }
+    };
+  }
+
+  cancelTask(taskId, reason = "cancelled_by_governor") {
+    const entry = this.activeTasks.get(String(taskId));
+    if (!entry) return { cancelled: false, taskId };
+    entry.controller.abort(reason);
+    this.activeTasks.delete(String(taskId));
+    return { cancelled: true, taskId, reason };
+  }
+
+  cancelAllTasks(reason = "cancelled_all_tasks") {
+    const cancelledIds = [];
+    for (const [id, entry] of this.activeTasks.entries()) {
+      entry.controller.abort(reason);
+      cancelledIds.push(id);
+    }
+    this.activeTasks.clear();
+    return { cancelledCount: cancelledIds.length, cancelledIds, reason };
+  }
+
+  touchLiveTab(tabId, tabState = {}, onHibernateCallback = null) {
+    const id = String(tabId);
+    const now = Date.now();
+    this.hibernatedTabs.delete(id);
+    this.liveTabs.set(id, {
+      tabId: id,
+      lastActiveMs: now,
+      url: tabState.url || null
+    });
+
+    const hibernatedNow = [];
+    while (this.liveTabs.size > this.maxLiveTabs) {
+      let oldestId = null;
+      let oldestTime = Infinity;
+      for (const [tid, info] of this.liveTabs.entries()) {
+        if (tid === id) continue;
+        if (info.lastActiveMs < oldestTime || oldestId === null) {
+          oldestTime = info.lastActiveMs;
+          oldestId = tid;
+        }
+      }
+      if (!oldestId) break;
+      const evicted = this.liveTabs.get(oldestId);
+      this.liveTabs.delete(oldestId);
+      this.hibernatedTabs.set(oldestId, {
+        tabId: oldestId,
+        hibernatedAtMs: now,
+        url: evicted?.url || null
+      });
+      hibernatedNow.push(oldestId);
+      if (typeof onHibernateCallback === "function") {
+        onHibernateCallback(oldestId);
+      }
+    }
+
+    if (this.liveTabs.size > this.peakLiveTabs) {
+      this.peakLiveTabs = this.liveTabs.size;
+    }
+
+    return {
+      liveTabCount: this.liveTabs.size,
+      maxLiveTabs: this.maxLiveTabs,
+      hibernatedTabIds: hibernatedNow,
+      totalHibernatedCount: this.hibernatedTabs.size
+    };
+  }
+
+  removeTab(tabId) {
+    const id = String(tabId);
+    this.liveTabs.delete(id);
+    this.hibernatedTabs.delete(id);
+  }
+
+  cacheSnapshot(snapshot) {
+    if (!snapshot || !snapshot.url) return;
+    this.snapshotCache.set(snapshot.url, {
+      snapshot,
+      cachedAtMs: Date.now()
+    });
+  }
+
+  getValidCachedSnapshot(url) {
+    const entry = this.snapshotCache.get(String(url));
+    if (!entry) return null;
+    if (Date.now() - entry.cachedAtMs > this.snapshotTtlMs) {
+      this.snapshotCache.delete(String(url));
+      return null;
+    }
+    this.snapshotReuseHits += 1;
+    return entry.snapshot;
+  }
+
+  sampleProcessMemory(label = "sample") {
+    const mem = process.memoryUsage();
+    const sample = {
+      label,
+      sampledAt: new Date().toISOString(),
+      rssBytes: mem.rss,
+      heapUsedBytes: mem.heapUsed,
+      heapTotalBytes: mem.heapTotal
+    };
+    this.memorySamples.push(sample);
+    return sample;
+  }
+
+  getTelemetry() {
+    const sorted = [...this.completedLatenciesMs].sort((a, b) => a - b);
+    const avgLatencyMs =
+      sorted.length > 0
+        ? Number((sorted.reduce((a, b) => a + b, 0) / sorted.length).toFixed(2))
+        : 0;
+    const p95LatencyMs =
+      sorted.length > 0
+        ? sorted[Math.min(sorted.length - 1, Math.floor(sorted.length * 0.95))]
+        : 0;
+    const latestMem =
+      this.memorySamples[this.memorySamples.length - 1] || this.sampleProcessMemory("telemetry");
+
+    return {
+      liveTabsCount: this.liveTabs.size,
+      peakLiveTabs: this.peakLiveTabs,
+      maxLiveTabs: this.maxLiveTabs,
+      hibernatedTabsCount: this.hibernatedTabs.size,
+      hibernatedTabIds: Array.from(this.hibernatedTabs.keys()),
+      snapshotReuseHits: this.snapshotReuseHits,
+      completedTasksCount: sorted.length,
+      avgLatencyMs,
+      p95LatencyMs,
+      memory: latestMem
+    };
+  }
+}
+
+module.exports = {
+  KosworkBrowserResourceGovernor
+};
diff --git a/desktop/windows/browser/search.cjs b/desktop/windows/browser/search.cjs
new file mode 100644
index 0000000..f95f105
--- /dev/null
+++ b/desktop/windows/browser/search.cjs
@@ -0,0 +1,205 @@
+"use strict";
+
+const { KosworkSearchAndBrowserStore } = require("./search-pagination-and-bookmarks.cjs");
+const {
+  createSearchProviderAdapter,
+  deduplicateSearchResults,
+  computeContentFingerprint
+} = require("./research-adapter.cjs");
+
+/**
+ * Koswork Browser Search & Source Collection Controller (`desktop/windows/browser/search.cjs`).
+ *
+ * Implements Queue Item #3:
+ * - Multi-source search via configured search adapter (`research-adapter.cjs`)
+ * - Deterministic SERP pagination (`page`, `pageSize`, `hasNextPage`)
+ * - URL & content deduplication across SERP pages and opened page snapshots
+ * - Explicit source unavailability tracking (`HTTP 503`, `HTTP 404`, network failure)
+ * - Strict no-silent-redirect and no-fabricated-results when provider errors (`SEARCH_PROVIDER_UNAVAILABLE`)
+ */
+class KosworkBrowserSearchService {
+  constructor(options = {}) {
+    this.store = options.store || new KosworkSearchAndBrowserStore();
+    this.adapter = options.adapter || createSearchProviderAdapter(options.adapterOptions || {});
+    this.engine = options.engine || null;
+    this.openedSources = new Map(); // visitId -> source visit record
+    this.unavailableSources = []; // [{ url, httpStatus, reason, recordedAt }]
+    this.openedContentFingerprints = new Map(); // contentFp -> firstUrl
+  }
+
+  attachEngine(engine) {
+    this.engine = engine;
+  }
+
+  async search({
+    query,
+    actor = "agent",
+    page = 1,
+    pageSize = 5,
+    signal = null
+  } = {}) {
+    if (signal?.aborted) {
+      const err = new Error("SEARCH_OPERATION_CANCELLED");
+      err.code = "SEARCH_OPERATION_CANCELLED";
+      throw err;
+    }
+
+    const normalizedActor = actor === "user" ? "user" : "agent";
+    // Execute directly against the configured provider — never mask errors or fabricate results
+    const providerResponse = await this.adapter.executeQuery(query, {
+      page,
+      signal
+    });
+
+    const dedup = deduplicateSearchResults(providerResponse.results || []);
+    const paginated = this.store.recordAndPaginateSearch({
+      query: providerResponse.query,
+      results: dedup.uniqueResults,
+      page,
+      pageSize,
+      recordedAt: providerResponse.searchedAt
+    });
+
+    const journalEntry = this.store.searchJournal.find((s) => s.searchId === paginated.searchId);
+    if (journalEntry) {
+      journalEntry.providerId = providerResponse.providerId;
+      journalEntry.providerEndpoint = providerResponse.providerEndpoint;
+      journalEntry.actor = normalizedActor;
+      journalEntry.duplicatesRemovedCount =
+        (providerResponse.duplicatesRemovedCount || 0) + dedup.duplicatesRemovedCount;
+    }
+
+    return {
+      ...paginated,
+      actor: normalizedActor,
+      providerId: providerResponse.providerId,
+      providerEndpoint: providerResponse.providerEndpoint,
+      searchedAt: providerResponse.searchedAt,
+      duplicatesRemovedCount:
+        (providerResponse.duplicatesRemovedCount || 0) + dedup.duplicatesRemovedCount
+    };
+  }
+
+  getSearchPage(searchId, { page = 1, pageSize = 5 } = {}) {
+    const journalEntry = this.store.searchJournal.find((s) => s.searchId === String(searchId));
+    const pageData = this.store.getSearchPage(searchId, { page, pageSize });
+    return {
+      ...pageData,
+      providerId: journalEntry?.providerId || this.adapter.providerId,
+      providerEndpoint: journalEntry?.providerEndpoint || this.adapter.searchEndpoint,
+      actor: journalEntry?.actor || "agent"
+    };
+  }
+
+  async openSearchResult({
+    searchId,
+    rank = 1,
+    url = null,
+    tabId = null,
+    actor = "agent",
+    extractQuery = null,
+    signal = null
+  } = {}) {
+    if (!this.engine) {
+      throw new Error("BROWSER_ENGINE_NOT_ATTACHED_TO_SEARCH");
+    }
+
+    let targetUrl = url;
+    let serpEntry = null;
+    if (searchId) {
+      const journal = this.store.searchJournal.find((s) => s.searchId === String(searchId));
+      if (!journal) {
+        const err = new Error(`SEARCH_JOURNAL_ENTRY_NOT_FOUND: ${searchId}`);
+        err.code = "SEARCH_JOURNAL_ENTRY_NOT_FOUND";
+        throw err;
+      }
+      serpEntry = journal.results.find((r) => r.rank === Number(rank)) || journal.results[0];
+      if (!serpEntry && !targetUrl) {
+        const err = new Error(`SERP_RANK_NOT_FOUND: rank=${rank}`);
+        err.code = "SERP_RANK_NOT_FOUND";
+        throw err;
+      }
+      if (!targetUrl && serpEntry) {
+        targetUrl = serpEntry.url;
+      }
+    }
+
+    const navResult = await this.engine.navigate({
+      tabId,
+      url: targetUrl,
+      actor,
+      signal,
+      initiatedBySearchId: searchId || null,
+      initiatedByRank: rank || null
+    });
+
+    if (!navResult.available) {
+      const unavRecord = {
+        url: navResult.url,
+        title: serpEntry?.title || navResult.title || navResult.url,
+        httpStatus: navResult.httpStatus,
+        networkError: navResult.networkError || null,
+        fetchedAt: navResult.fetchedAt,
+        searchId: searchId || null,
+        rank: rank || null,
+        reason: navResult.networkError
+          ? `Ошибка соединения: ${navResult.networkError}`
+          : `Страница вернула HTTP ${navResult.httpStatus}`
+      };
+      this.unavailableSources.push(unavRecord);
+    }
+
+    const bodyFp = computeContentFingerprint(navResult.snapshot?.fullTextUtf16 || "");
+    let duplicateContentOfUrl = null;
+    if (bodyFp && navResult.available) {
+      if (this.openedContentFingerprints.has(bodyFp)) {
+        const firstUrl = this.openedContentFingerprints.get(bodyFp);
+        if (firstUrl !== navResult.url) {
+          duplicateContentOfUrl = firstUrl;
+        }
+      } else {
+        this.openedContentFingerprints.set(bodyFp, navResult.url);
+      }
+    }
+
+    let initialExcerpt = null;
+    if (extractQuery && navResult.available) {
+      try {
+        initialExcerpt = this.engine.extractExcerpt(navResult.tabId, {
+          searchTerm: extractQuery
+        });
+      } catch {
+        initialExcerpt = null;
+      }
+    }
+
+    const visitId = `visit-${Date.now()}-${this.openedSources.size + 1}`;
+    const visitRecord = {
+      visitId,
+      searchId: searchId || null,
+      serpRank: rank || null,
+      tabId: navResult.tabId,
+      url: navResult.url,
+      canonicalUrl: navResult.snapshot?.canonicalUrl || navResult.url,
+      title: navResult.snapshot?.title || serpEntry?.title || navResult.url,
+      httpStatus: navResult.httpStatus,
+      available: navResult.available,
+      duplicateContentOfUrl,
+      pageVersion: navResult.pageVersion,
+      snapshotId: navResult.snapshot?.snapshotId || null,
+      pageDate: navResult.pageDate || null,
+      eventDate: navResult.eventDate || null,
+      fetchedAt: navResult.fetchedAt,
+      readingLimitations: navResult.snapshot?.readingLimitations || null,
+      excerptIds: initialExcerpt ? [initialExcerpt.excerptId] : [],
+      initialExcerpt
+    };
+
+    this.openedSources.set(visitId, visitRecord);
+    return visitRecord;
+  }
+}
+
+module.exports = {
+  KosworkBrowserSearchService
+};
