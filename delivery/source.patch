+++ b/desktop/windows/browser/policy.cjs
@@ -0,0 +1,438 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const crypto = require("node:crypto");
+
+const FORBIDDEN_ATTACHMENT_EXTENSIONS = new Set([
+  ".exe", ".dll", ".so", ".dylib", ".ps1", ".psm1", ".bat", ".cmd", ".com",
+  ".msi", ".msp", ".lnk", ".scr", ".hta", ".vbs", ".vbe", ".js", ".jse",
+  ".cjs", ".mjs", ".wsf", ".wsh", ".reg", ".inf", ".jar", ".pem", ".key",
+  ".pfx", ".p12", ".kdbx", ".sqlite", ".sqlite3", ".db", ".db-wal"
+]);
+
+const SENSITIVE_FILENAME_PATTERNS = [
+  /^\.env(\..+)?$/i,
+  /^id_(rsa|dsa|ecdsa|ed25519)(\.pub)?$/i,
+  /^(credentials|secrets|tokens|passwords|auth)(\..+)?$/i,
+  /^\.npmrc$/i,
+  /^\.netrc$/i,
+  /^\.git-credentials$/i,
+  /^koswork-workspace-state\.json$/i
+];
+
+const FORBIDDEN_DOWNLOAD_EXTENSIONS = new Set([
+  ".exe", ".dll", ".ps1", ".bat", ".cmd", ".com", ".msi", ".lnk", ".scr", ".hta", ".vbs", ".reg"
+]);
+
+const CAPTCHA_PATTERNS = [
+  /\bcaptcha\b/i,
+  /\bg-recaptcha\b/i,
+  /\bhcaptcha\b/i,
+  /\bcf-turnstile\b/i,
+  /verify you are human/i,
+  /подтвердите,\s*что вы не робот/i,
+  /проверка безопасности:\s*капча/i
+];
+
+const LOGIN_AND_OAUTH_PATTERNS = [
+  /войдите в аккаунт/i,
+  /требуется вход/i,
+  /sign in to continue/i,
+  /log in to continue/i,
+  /authentication required/i,
+  /двухфакторная аутентификация/i,
+  /oauth2?\/authorize/i,
+  /saml2?\/sso/i
+];
+
+const PAYMENT_AND_EXTERNAL_SEND_PATTERNS = [
+  /оплатить заказ/i,
+  /введите номер карты/i,
+  /card\s*number/i,
+  /cvv|cvc/i,
+  /confirm\s+payment/i,
+  /подтвердить платёж/i,
+  /отправить внешнее сообщение/i
+];
+
+class KosworkBrowserPolicyError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.name = "KosworkBrowserPolicyError";
+    this.code = code;
+    this.details = details;
+  }
+}
+
+/**
+ * Evaluates navigation URL policy, domain allowlist/blocklist, and SSRF protection.
+ */
+function evaluateNavigationPolicy(rawUrl, options = {}) {
+  const allowLocalLoopback = options.allowLocalLoopback !== false;
+  const allowedDomains = Array.isArray(options.allowedDomains)
+    ? options.allowedDomains.map((d) => String(d).toLowerCase())
+    : null;
+  const urlText = String(rawUrl || "").trim();
+  if (!urlText) {
+    throw new KosworkBrowserPolicyError("BROWSER_INVALID_URL", "URL перехода не может быть пустым.", { rawUrl });
+  }
+
+  if (/^koswork:\/\/search\/srch-[a-f0-9]{16}$/i.test(urlText)) {
+    return {
+      allowed: true,
+      normalizedUrl: urlText,
+      protocol: "koswork:",
+      hostname: "search",
+      isInternalReceipt: true
+    };
+  }
+
+  let parsed;
+  try {
+    parsed = new URL(urlText);
+  } catch {
+    throw new KosworkBrowserPolicyError("BROWSER_INVALID_URL", `Некорректный формат URL: "${urlText}".`, { rawUrl: urlText });
+  }
+
+  const protocol = parsed.protocol.toLowerCase();
+  if (protocol !== "http:" && protocol !== "https:") {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_NAVIGATION_PROTOCOL_FORBIDDEN",
+      `Протокол "${protocol}" запрещён. Разрешены только http: и https:.`,
+      { url: urlText, protocol }
+    );
+  }
+
+  const hostname = parsed.hostname.toLowerCase();
+  if (
+    hostname === "169.254.169.254" ||
+    hostname === "metadata.google.internal" ||
+    hostname === "100.100.100.200"
+  ) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_SSRF_METADATA_BLOCKED",
+      `Доступ к облачному сервису метаданных (${hostname}) заблокирован.`,
+      { url: urlText, hostname }
+    );
+  }
+
+  const isLoopback =
+    hostname === "localhost" ||
+    hostname === "127.0.0.1" ||
+    hostname === "[::1]" ||
+    hostname === "corpus.local" ||
+    hostname.endsWith(".corpus.local") ||
+    hostname.endsWith(".research.local") ||
+    hostname.endsWith(".localhost");
+
+  if (isLoopback && !allowLocalLoopback) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_LOOPBACK_DISABLED",
+      `Доступ к локальному адресу (${hostname}) отключён в текущем режиме.`,
+      { url: urlText, hostname }
+    );
+  }
+
+  if (allowedDomains && allowedDomains.length > 0 && !isLoopback) {
+    const domainPermitted = allowedDomains.some(
+      (d) => hostname === d || hostname.endsWith(`.${d}`)
+    );
+    if (!domainPermitted) {
+      throw new KosworkBrowserPolicyError(
+        "BROWSER_DOMAIN_NOT_PERMITTED",
+        `Домен "${hostname}" не входит в список разрешённых для текущей исследовательской задачи.`,
+        { url: urlText, hostname, allowedDomains }
+      );
+    }
+  }
+
+  return {
+    allowed: true,
+    normalizedUrl: parsed.toString(),
+    protocol,
+    hostname,
+    isLoopback,
+    isInternalReceipt: false
+  };
+}
+
+/**
+ * Verifies that authenticated site tools only use an explicitly authorized session ID.
+ */
+function verifyAuthorizedSiteSession({
+  requiresAuthenticatedSession = false,
+  requestedSessionId = null,
+  allowedSessionIds = []
+} = {}) {
+  if (!requiresAuthenticatedSession) {
+    return { allowed: true, sessionId: requestedSessionId || null };
+  }
+  const allowedSet = new Set((allowedSessionIds || []).map((s) => String(s)));
+  if (!requestedSessionId || !allowedSet.has(String(requestedSessionId))) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_UNAUTHORIZED_SITE_SESSION",
+      "Инструменты сайтов с логином могут использовать только явно разрешённую сессию владельца.",
+      { requestedSessionId, allowedSessionIds }
+    );
+  }
+  return { allowed: true, sessionId: String(requestedSessionId) };
+}
+
+/**
+ * Inspects a snapshot for CAPTCHA, login/OAuth walls, payment checkout, or external send gates.
+ * Never bypasses these gates — always pauses for the user (`status: "paused_for_user"`).
+ */
+function detectAuthOrCaptchaGate(pageSnapshot = {}) {
+  const status = Number(pageSnapshot.httpStatus ?? pageSnapshot.status ?? 200);
+  const title = String(pageSnapshot.title || "");
+  const bodyText = String(pageSnapshot.fullTextUtf16 || pageSnapshot.text || "");
+  const html = String(pageSnapshot.html || "");
+  const url = String(pageSnapshot.url || "");
+  const controls = Array.isArray(pageSnapshot.controls) ? pageSnapshot.controls : [];
+  const combinedText = `${title}\n${bodyText}\n${url}`;
+
+  for (const pattern of CAPTCHA_PATTERNS) {
+    if (pattern.test(combinedText) || pattern.test(html)) {
+      return {
+        gated: true,
+        gateType: "captcha",
+        status: "paused_for_user",
+        code: "BROWSER_PAUSED_FOR_CAPTCHA",
+        reason: "Обнаружена CAPTCHA. Автоматический обход запрещён; ожидание ручного прохождения пользователем.",
+        url: pageSnapshot.url || null
+      };
+    }
+  }
+
+  const hasCaptchaControl = controls.some(
+    (c) =>
+      String(c.id || "").toLowerCase().includes("captcha") ||
+      String(c.name || "").toLowerCase().includes("captcha") ||
+      String(c.role || "").toLowerCase() === "captcha"
+  );
+  if (hasCaptchaControl) {
+    return {
+      gated: true,
+      gateType: "captcha",
+      status: "paused_for_user",
+      code: "BROWSER_PAUSED_FOR_CAPTCHA",
+      reason: "Обнаружен интерактивный элемент CAPTCHA. Требуется действие пользователя.",
+      url: pageSnapshot.url || null
+    };
+  }
+
+  for (const pattern of PAYMENT_AND_EXTERNAL_SEND_PATTERNS) {
+    if (pattern.test(combinedText)) {
+      return {
+        gated: true,
+        gateType: "payment_or_send_confirmation",
+        status: "paused_for_user",
+        code: "BROWSER_PAUSED_FOR_SENSITIVE_GATE",
+        reason: "Обнаружена форма платежа или внешней отправки. Автоматическое выполнение запрещено без подтверждения пользователя.",
+        url: pageSnapshot.url || null
+      };
+    }
+  }
+
+  const hasPasswordControl = controls.some(
+    (c) =>
+      String(c.type || "").toLowerCase() === "password" ||
+      String(c.name || "").toLowerCase().includes("password") ||
+      String(c.id || "").toLowerCase().includes("password")
+  );
+  const matchesLoginPrompt = LOGIN_AND_OAUTH_PATTERNS.some((p) => p.test(combinedText));
+
+  if (
+    hasPasswordControl ||
+    (status === 401 && matchesLoginPrompt) ||
+    (matchesLoginPrompt && pageSnapshot.requiresLogin === true)
+  ) {
+    return {
+      gated: true,
+      gateType: "login_or_oauth_required",
+      status: "paused_for_user",
+      code: "BROWSER_PAUSED_FOR_LOGIN",
+      reason: "Страница требует входа (логин/пароль/OAuth/2FA). Агент поставлен на паузу для пользователя.",
+      url: pageSnapshot.url || null
+    };
+  }
+
+  if (status === 401 || status === 403) {
+    return {
+      gated: true,
+      gateType: "access_restricted",
+      status: "paused_for_user",
+      code: "BROWSER_ACCESS_RESTRICTED",
+      reason: `Доступ к ресурсу ограничен сервером (HTTP ${status}). Обход ограничений доступа запрещён.`,
+      httpStatus: status,
+      url: pageSnapshot.url || null
+    };
+  }
+
+  return {
+    gated: false,
+    gateType: null,
+    status: "ok",
+    code: null,
+    reason: null
+  };
+}
+
+function verifyFileSelectionPolicy(candidateFilePath, options = {}) {
+  const allowedWorkspaceRoot = options.allowedWorkspaceRoot
+    ? path.resolve(String(options.allowedWorkspaceRoot))
+    : null;
+  const maxUploadBytes = Number(options.maxUploadBytes ?? 10 * 1024 * 1024);
+
+  if (!allowedWorkspaceRoot) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_WORKSPACE_NOT_CONNECTED",
+      "Выбор файлов невозможен: не подключена разрешённая рабочая папка."
+    );
+  }
+
+  const rawPath = String(candidateFilePath || "").trim();
+  if (!rawPath || rawPath.includes("\0") || rawPath.startsWith("\\\\")) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      "Некорректный или запрещённый путь к прикрепляемому файлу."
+    );
+  }
+
+  const resolvedCandidate = path.isAbsolute(rawPath)
+    ? path.resolve(rawPath)
+    : path.resolve(allowedWorkspaceRoot, rawPath);
+
+  const canonicalRoot = fs.realpathSync(allowedWorkspaceRoot);
+  const relativeCheck = path.relative(canonicalRoot, resolvedCandidate);
+  if (relativeCheck === "" || relativeCheck.startsWith("..") || path.isAbsolute(relativeCheck)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Запрещено прикреплять файлы вне разрешённой рабочей папки: "${rawPath}".`,
+      { candidateFilePath: rawPath }
+    );
+  }
+
+  const baseName = path.basename(resolvedCandidate);
+  for (const pattern of SENSITIVE_FILENAME_PATTERNS) {
+    if (pattern.test(baseName)) {
+      throw new KosworkBrowserPolicyError(
+        "BROWSER_FORBIDDEN_ATTACHMENT",
+        `Файл "${baseName}" относится к защищённым данным (.env/ключи/токены) и заблокирован.`,
+        { filename: baseName }
+      );
+    }
+  }
+
+  const ext = path.extname(baseName).toLowerCase();
+  if (FORBIDDEN_ATTACHMENT_EXTENSIONS.has(ext)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Расширение "${ext}" файла "${baseName}" запрещено для прикрепления.`,
+      { filename: baseName, extension: ext }
+    );
+  }
+
+  let lstat;
+  try {
+    lstat = fs.lstatSync(resolvedCandidate);
+  } catch {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_ATTACHMENT_NOT_FOUND",
+      `Файл вложения не найден: "${baseName}".`
+    );
+  }
+
+  if (lstat.isSymbolicLink() || !lstat.isFile()) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Символические ссылки и директории ("${baseName}") запрещены.`
+    );
+  }
+
+  const canonicalFile = fs.realpathSync(resolvedCandidate);
+  const canonicalRel = path.relative(canonicalRoot, canonicalFile);
+  if (canonicalRel.startsWith("..") || path.isAbsolute(canonicalRel)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Канонический путь файла "${baseName}" выходит за пределы рабочей папки.`
+    );
+  }
+
+  if (lstat.size > maxUploadBytes) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_ATTACHMENT_TOO_LARGE",
+      `Размер файла "${baseName}" превышает лимит (${maxUploadBytes} байт).`
+    );
+  }
+
+  const buffer = fs.readFileSync(canonicalFile);
+  const sha256 = crypto.createHash("sha256").update(buffer).digest("hex");
+
+  return {
+    allowed: true,
+    filename: baseName,
+    canonicalPath: canonicalFile,
+    relativePath: canonicalRel.replace(/\\/g, "/"),
+    sizeBytes: buffer.length,
+    sha256
+  };
+}
+
+function resolveAllowedDownloadTarget(rawFilename, options = {}) {
+  const allowedDownloadDir = options.allowedDownloadDir
+    ? path.resolve(String(options.allowedDownloadDir))
+    : null;
+  const allowedWorkspaceRoot = options.allowedWorkspaceRoot
+    ? path.resolve(String(options.allowedWorkspaceRoot))
+    : null;
+
+  if (!allowedDownloadDir) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_DOWNLOAD_DIR_NOT_CONFIGURED",
+      "Не задана разрешённая папка для скачивания файлов."
+    );
+  }
+
+  if (allowedWorkspaceRoot) {
+    const relDir = path.relative(allowedWorkspaceRoot, allowedDownloadDir);
+    if (relDir.startsWith("..") || path.isAbsolute(relDir)) {
+      throw new KosworkBrowserPolicyError(
+        "BROWSER_DOWNLOAD_DIR_OUTSIDE_WORKSPACE",
+        "Папка загрузок должна находиться внутри разрешённой рабочей папки."
+      );
+    }
+  }
+
+  const base = path.basename(String(rawFilename || "download.txt").trim());
+  const sanitized = base.replace(/[<>:"/\\|?*\x00-\x1F]/g, "_").replace(/^\.+/, "") || "download.txt";
+  const ext = path.extname(sanitized).toLowerCase();
+
+  if (FORBIDDEN_DOWNLOAD_EXTENSIONS.has(ext)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_DOWNLOAD_TYPE",
+      `Скачивание исполняемого файла "${sanitized}" (${ext}) заблокировано.`
+    );
+  }
+
+  fs.mkdirSync(allowedDownloadDir, { recursive: true });
+  const targetPath = path.join(allowedDownloadDir, sanitized);
+  return {
+    allowed: true,
+    filename: sanitized,
+    downloadDir: allowedDownloadDir,
+    targetPath
+  };
+}
+
+module.exports = {
+  FORBIDDEN_ATTACHMENT_EXTENSIONS,
+  FORBIDDEN_DOWNLOAD_EXTENSIONS,
+  KosworkBrowserPolicyError,
+  detectAuthOrCaptchaGate,
+  evaluateNavigationPolicy,
+  resolveAllowedDownloadTarget,
+  verifyAuthorizedSiteSession,
+  verifyFileSelectionPolicy
+};
diff --git a/desktop/windows/browser/recovery.cjs b/desktop/windows/browser/recovery.cjs
new file mode 100644
index 0000000..2460646
--- /dev/null
+++ b/desktop/windows/browser/recovery.cjs
@@ -0,0 +1,186 @@
+"use strict";
+
+/**
+ * Koswork Browser Observation Integrity, Stale Element Ref & User Takeover Recovery
+ * (`desktop/windows/browser/recovery.cjs`).
+ *
+ * Ensures:
+ * - Stale element references (`elementRef`) or stale snapshots (`pageVersion`, `domEpoch`)
+ *   are rejected before mutating actions (`STALE_ELEMENT_REFERENCE`, `OBSERVATION_STALE_REOBSERVE_REQUIRED`).
+ * - Manual user takeover actions increment `userEpoch` and invalidate prior agent observations
+ *   (`OBSERVATION_INVALIDATED_BY_USER`) until a fresh observation is performed.
+ * - Post-observation text substitution on a page is detected (`OBSERVATION_TEXT_SUBSTITUTED_SINCE_READ`).
+ */
+
+class KosworkBrowserRecoveryError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.name = "KosworkBrowserRecoveryError";
+    this.code = code;
+    this.details = details;
+  }
+}
+
+class UserTakeoverTracker {
+  constructor() {
+    this.tabState = new Map();
+  }
+
+  getCurrentEpoch(tabId) {
+    return this.tabState.get(String(tabId))?.epoch ?? 0;
+  }
+
+  recordUserAction(tabId, action = {}) {
+    const id = String(tabId);
+    const prev = this.tabState.get(id) || { epoch: 0, activeTakeover: false, history: [] };
+    const nextEpoch = prev.epoch + 1;
+    const entry = {
+      epoch: nextEpoch,
+      type: action.type || "manual_user_interaction",
+      detail: action.detail || null,
+      recordedAt: new Date().toISOString()
+    };
+    const next = {
+      epoch: nextEpoch,
+      activeTakeover: action.holdTakeover === true,
+      lastAction: entry,
+      history: [...prev.history.slice(-19), entry]
+    };
+    this.tabState.set(id, next);
+    return next;
+  }
+
+  releaseTakeover(tabId) {
+    const id = String(tabId);
+    const prev = this.tabState.get(id);
+    if (prev) {
+      prev.activeTakeover = false;
+    }
+    return prev || { epoch: 0, activeTakeover: false };
+  }
+}
+
+function verifyTabReceipt(tabReceipt, currentTabState) {
+  if (!currentTabState || currentTabState.closed) {
+    throw new KosworkBrowserRecoveryError(
+      "TAB_LOST_OR_CLOSED",
+      `Вкладка "${tabReceipt?.tabId || "unknown"}" была закрыта или потеряна.`,
+      { tabReceipt }
+    );
+  }
+  if (tabReceipt && tabReceipt.tabId && String(tabReceipt.tabId) !== String(currentTabState.tabId)) {
+    throw new KosworkBrowserRecoveryError(
+      "TAB_RECEIPT_MISMATCH",
+      `Квитанция вкладки (${tabReceipt.tabId}) не совпадает с текущей вкладкой (${currentTabState.tabId}).`,
+      { tabReceipt, currentTabId: currentTabState.tabId }
+    );
+  }
+}
+
+function findRecoveryCandidates(currentSnapshot, targetSpec = {}) {
+  const controls = Array.isArray(currentSnapshot?.controls) ? currentSnapshot.controls : [];
+  const wantedId = String(targetSpec.controlId || "").toLowerCase();
+  const wantedRef = String(targetSpec.elementRef || "").toLowerCase();
+  const wantedLabel = String(targetSpec.label || "").toLowerCase();
+
+  return controls
+    .filter((c) => {
+      if (wantedRef && String(c.elementRef || "").toLowerCase() === wantedRef) return true;
+      if (wantedId && (String(c.id || "").toLowerCase() === wantedId || String(c.name || "").toLowerCase() === wantedId)) {
+        return true;
+      }
+      if (wantedLabel && String(c.label || "").toLowerCase().includes(wantedLabel)) return true;
+      return false;
+    })
+    .map((c) => ({
+      elementRef: c.elementRef,
+      id: c.id,
+      tag: c.tag,
+      label: c.label,
+      bounds: c.bounds
+    }));
+}
+
+function verifyObservationIntegrity({
+  observedSnapshot,
+  currentSnapshot,
+  targetSpec = null,
+  userTakeoverTracker = null
+} = {}) {
+  if (!observedSnapshot || !currentSnapshot) {
+    throw new KosworkBrowserRecoveryError(
+      "OBSERVATION_REQUIRED",
+      "Перед выполнением действия необходимо выполнить свежее наблюдение страницы (observePage)."
+    );
+  }
+
+  const tabId = currentSnapshot.tabReceipt?.tabId || currentSnapshot.tabId;
+  if (userTakeoverTracker && tabId) {
+    const currentEpoch = userTakeoverTracker.getCurrentEpoch(tabId);
+    const observedEpoch = observedSnapshot.userEpoch ?? 0;
+    if (currentEpoch !== observedEpoch) {
+      throw new KosworkBrowserRecoveryError(
+        "OBSERVATION_INVALIDATED_BY_USER",
+        "Пользователь выполнил ручное действие во вкладке; наблюдение агента устарело и требует повторного чтения страницы.",
+        {
+          tabId,
+          observedUserEpoch: observedEpoch,
+          currentUserEpoch: currentEpoch,
+          recoveryCandidates: targetSpec ? findRecoveryCandidates(currentSnapshot, targetSpec) : []
+        }
+      );
+    }
+  }
+
+  if (
+    observedSnapshot.snapshotId !== currentSnapshot.snapshotId ||
+    observedSnapshot.pageVersion !== currentSnapshot.pageVersion ||
+    (observedSnapshot.domEpoch &&
+      currentSnapshot.domEpoch &&
+      observedSnapshot.domEpoch !== currentSnapshot.domEpoch)
+  ) {
+    const textChanged = observedSnapshot.textSha256 !== currentSnapshot.textSha256;
+    const code = textChanged
+      ? "OBSERVATION_TEXT_SUBSTITUTED_SINCE_READ"
+      : "OBSERVATION_STALE_REOBSERVE_REQUIRED";
+    throw new KosworkBrowserRecoveryError(
+      code,
+      textChanged
+        ? "Текст страницы или DOM изменился после наблюдения (пост-наблюдательная подмена текста). Действие отклонено до повторного наблюдения."
+        : "Версия страницы изменилась после наблюдения. Выполните свежее наблюдение (observePage).",
+      {
+        observedVersion: observedSnapshot.pageVersion,
+        currentVersion: currentSnapshot.pageVersion,
+        observedDomEpoch: observedSnapshot.domEpoch,
+        currentDomEpoch: currentSnapshot.domEpoch,
+        recoveryCandidates: targetSpec ? findRecoveryCandidates(currentSnapshot, targetSpec) : []
+      }
+    );
+  }
+
+  if (targetSpec && targetSpec.elementRef) {
+    const match = (currentSnapshot.controls || []).find(
+      (c) => c.elementRef === targetSpec.elementRef
+    );
+    if (!match) {
+      throw new KosworkBrowserRecoveryError(
+        "STALE_ELEMENT_REFERENCE",
+        `Ссылка на элемент "${targetSpec.elementRef}" устарела или отсутствует в текущем DOM.`,
+        {
+          elementRef: targetSpec.elementRef,
+          recoveryCandidates: findRecoveryCandidates(currentSnapshot, targetSpec)
+        }
+      );
+    }
+  }
+
+  return { valid: true };
+}
+
+module.exports = {
+  KosworkBrowserRecoveryError,
+  UserTakeoverTracker,
+  findRecoveryCandidates,
+  verifyObservationIntegrity,
+  verifyTabReceipt
+};
diff --git a/desktop/windows/browser/research-adapter.cjs b/desktop/windows/browser/research-adapter.cjs
new file mode 100644
index 0000000..89a7f77
--- /dev/null
+++ b/desktop/windows/browser/research-adapter.cjs
@@ -0,0 +1,351 @@
+"use strict";
+
+const http = require("node:http");
+const https = require("node:https");
+const crypto = require("node:crypto");
+const { stripHtmlTagsPreservingBlocks } = require("./document.cjs");
+
+/**
+ * Isolated Search & HTTP Provider Adapter (`desktop/windows/browser/research-adapter.cjs`).
+ *
+ * Strict invariants (Queue Item #3):
+ * - Never hides the search provider behind a fake "proprietary internet index".
+ * - Never silently redirects to another search provider when the configured provider fails.
+ * - Never fabricates search results on provider error (`SEARCH_PROVIDER_UNAVAILABLE`).
+ * - Deduplicates search results by canonical URL and normalized content fingerprint.
+ */
+
+const TRACKING_QUERY_PARAMS = new Set([
+  "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content",
+  "gclid", "fbclid", "yclid", "mc_cid", "mc_eid", "ref"
+]);
+
+function normalizeCanonicalSearchUrl(rawUrl = "") {
+  try {
+    const u = new URL(String(rawUrl).trim());
+    u.hash = "";
+    for (const key of Array.from(u.searchParams.keys())) {
+      if (TRACKING_QUERY_PARAMS.has(key.toLowerCase())) {
+        u.searchParams.delete(key);
+      }
+    }
+    if (u.pathname.length > 1 && u.pathname.endsWith("/")) {
+      u.pathname = u.pathname.slice(0, -1);
+    }
+    return u.toString();
+  } catch {
+    return String(rawUrl || "").trim();
+  }
+}
+
+function computeContentFingerprint(text = "") {
+  const tokens = String(text || "")
+    .toLowerCase()
+    .replace(/[^\p{L}\p{N}\s]+/gu, " ")
+    .split(/\s+/)
+    .filter((t) => t.length >= 3);
+  if (tokens.length === 0) return "";
+  return crypto.createHash("sha256").update(tokens.join(" "), "utf8").digest("hex").slice(0, 16);
+}
+
+function deduplicateSearchResults(rawResults = []) {
+  const seenCanonicalUrls = new Set();
+  const seenContentFingerprints = new Set();
+  const uniqueResults = [];
+  const duplicatesRemoved = [];
+
+  for (const item of rawResults || []) {
+    const rawUrl = String(item?.url || "").trim();
+    if (!rawUrl) continue;
+    const canonicalUrl = normalizeCanonicalSearchUrl(rawUrl);
+    const snippetFp = computeContentFingerprint(`${item.title || ""} ${item.snippet || ""}`);
+
+    if (seenCanonicalUrls.has(canonicalUrl)) {
+      duplicatesRemoved.push({
+        url: rawUrl,
+        canonicalUrl,
+        reason: "duplicate_canonical_url"
+      });
+      continue;
+    }
+
+    if (snippetFp && seenContentFingerprints.has(snippetFp)) {
+      duplicatesRemoved.push({
+        url: rawUrl,
+        canonicalUrl,
+        reason: "duplicate_content_fingerprint"
+      });
+      continue;
+    }
+
+    seenCanonicalUrls.add(canonicalUrl);
+    if (snippetFp) seenContentFingerprints.add(snippetFp);
+
+    uniqueResults.push({
+      ...item,
+      url: rawUrl,
+      canonicalUrl,
+      contentFingerprint: snippetFp
+    });
+  }
+
+  return {
+    uniqueResults,
+    duplicatesRemovedCount: duplicatesRemoved.length,
+    duplicatesRemoved
+  };
+}
+
+function parseSerpHtml(html, baseOrigin = "http://corpus.local") {
+  const raw = String(html || "");
+  const results = [];
+
+  // 1. `<article data-serp-item="true">`
+  const articleRegex = /<article[^>]+data-serp-item=["']true["'][^>]*>([\s\S]*?)<\/article>/gi;
+  let match;
+  while ((match = articleRegex.exec(raw)) !== null) {
+    const itemHtml = match[1];
+    const aMatch = itemHtml.match(/<a[^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/i);
+    const pMatch = itemHtml.match(/<p[^>]*>([\s\S]*?)<\/p>/i);
+    if (aMatch) {
+      let resolvedUrl = aMatch[1];
+      try {
+        resolvedUrl = new URL(aMatch[1], baseOrigin).toString();
+      } catch {
+        // keep as is
+      }
+      results.push({
+        url: resolvedUrl,
+        title: stripHtmlTagsPreservingBlocks(aMatch[2]),
+        snippet: pMatch ? stripHtmlTagsPreservingBlocks(pMatch[1]) : ""
+      });
+    }
+  }
+
+  // 2. DuckDuckGo-style `.result__a`
+  if (results.length === 0) {
+    const blockRegex = /<div[^>]+class=["'][^"']*result\b[^"']*["'][^>]*>([\s\S]*?)<\/div>\s*<\/div>/gi;
+    const linkRegex = /<a[^>]+class=["'][^"']*result__a[^"']*["'][^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/i;
+    const snippetRegex = /<(?:a|div)[^>]+class=["'][^"']*result__snippet[^"']*["'][^>]*>([\s\S]*?)<\/(?:a|div)>/i;
+    while ((match = blockRegex.exec(raw)) !== null) {
+      const chunk = match[1];
+      const linkMatch = chunk.match(linkRegex);
+      if (!linkMatch) continue;
+      const title = stripHtmlTagsPreservingBlocks(linkMatch[2]);
+      const snippetMatch = chunk.match(snippetRegex);
+      const snippet = snippetMatch ? stripHtmlTagsPreservingBlocks(snippetMatch[1]) : "";
+      results.push({
+        url: linkMatch[1],
+        title,
+        snippet
+      });
+    }
+  }
+
+  return results;
+}
+
+function fetchHttpRaw(targetUrl, options = {}) {
+  const timeoutMs = Number(options.timeoutMs ?? 6000);
+  const signal = options.signal || null;
+
+  return new Promise((resolve, reject) => {
+    if (signal?.aborted) {
+      const err = new Error("SEARCH_REQUEST_CANCELLED");
+      err.code = "SEARCH_REQUEST_CANCELLED";
+      return reject(err);
+    }
+
+    let parsed;
+    try {
+      parsed = new URL(targetUrl);
+    } catch (e) {
+      return reject(e);
+    }
+
+    const requestHost =
+      parsed.hostname === "corpus.local" ||
+      parsed.hostname.endsWith(".corpus.local") ||
+      parsed.hostname === "research.local" ||
+      parsed.hostname.endsWith(".research.local")
+        ? "127.0.0.1"
+        : parsed.hostname;
+
+    const client = parsed.protocol === "https:" ? https : http;
+    const req = client.request(
+      {
+        hostname: requestHost,
+        port: parsed.port || (parsed.protocol === "https:" ? 443 : 80),
+        path: `${parsed.pathname}${parsed.search}`,
+        method: options.method || "GET",
+        headers: {
+          Host: parsed.host,
+          "User-Agent": "KosworkBrowserResearch/1.0",
+          Accept: "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
+          ...(options.headers || {})
+        },
+        timeout: timeoutMs
+      },
+      (res) => {
+        const chunks = [];
+        res.on("data", (c) => chunks.push(c));
+        res.on("end", () => {
+          const body = Buffer.concat(chunks).toString("utf8");
+          resolve({
+            status: res.statusCode || 200,
+            headers: res.headers || {},
+            body,
+            url: targetUrl
+          });
+        });
+      }
+    );
+
+    if (signal) {
+      signal.addEventListener(
+        "abort",
+        () => {
+          const err = new Error("SEARCH_REQUEST_CANCELLED");
+          err.code = "SEARCH_REQUEST_CANCELLED";
+          req.destroy(err);
+          reject(err);
+        },
+        { once: true }
+      );
+    }
+
+    req.on("timeout", () => {
+      const err = new Error(`HTTP_TIMEOUT: ${targetUrl}`);
+      err.code = "HTTP_TIMEOUT";
+      req.destroy(err);
+    });
+    req.on("error", reject);
+    req.end();
+  });
+}
+
+function createSearchProviderAdapter(options = {}) {
+  const providerId = String(options.providerId || "local-http-search");
+  let searchEndpoint = String(options.searchEndpoint || "http://corpus.local/search");
+  const customSearchFn = typeof options.searchFn === "function" ? options.searchFn : null;
+
+  function setSearchEndpoint(nextEndpoint) {
+    searchEndpoint = String(nextEndpoint);
+  }
+
+  async function executeQuery(query, execOptions = {}) {
+    const signal = execOptions.signal || null;
+    if (signal?.aborted) {
+      const err = new Error("SEARCH_REQUEST_CANCELLED");
+      err.code = "SEARCH_REQUEST_CANCELLED";
+      throw err;
+    }
+
+    const trimmedQuery = String(query || "").trim();
+    if (!trimmedQuery) {
+      const err = new Error("INVALID_SEARCH_QUERY_LENGTH");
+      err.code = "INVALID_SEARCH_QUERY_LENGTH";
+      throw err;
+    }
+
+    const searchedAt = execOptions.nowIso || new Date().toISOString();
+
+    if (customSearchFn) {
+      try {
+        const rawResults = await customSearchFn(trimmedQuery, { signal, searchedAt });
+        const dedup = deduplicateSearchResults(Array.isArray(rawResults) ? rawResults : []);
+        return {
+          providerId,
+          providerEndpoint: searchEndpoint,
+          searchedAt,
+          query: trimmedQuery,
+          results: dedup.uniqueResults,
+          duplicatesRemovedCount: dedup.duplicatesRemovedCount,
+          duplicatesRemoved: dedup.duplicatesRemoved
+        };
+      } catch (err) {
+        const wrapped = new Error(
+          `SEARCH_PROVIDER_UNAVAILABLE: Провайдер "${providerId}" вернул ошибку (${err.message}). Скрытое перенаправление и выдумывание результатов запрещены.`
+        );
+        wrapped.code = "SEARCH_PROVIDER_UNAVAILABLE";
+        wrapped.providerId = providerId;
+        wrapped.providerEndpoint = searchEndpoint;
+        throw wrapped;
+      }
+    }
+
+    let httpRes;
+    try {
+      const urlObj = new URL(searchEndpoint);
+      urlObj.searchParams.set("q", trimmedQuery);
+      if (execOptions.page) {
+        urlObj.searchParams.set("page", String(execOptions.page));
+      }
+      httpRes = await fetchHttpRaw(urlObj.toString(), {
+        timeoutMs: execOptions.timeoutMs ?? 6000,
+        signal
+      });
+    } catch (err) {
+      if (err.code === "SEARCH_REQUEST_CANCELLED") throw err;
+      const wrapped = new Error(
+        `SEARCH_PROVIDER_UNAVAILABLE: Сетевая ошибка поискового провайдера "${providerId}" (${searchEndpoint}): ${err.message}.`
+      );
+      wrapped.code = "SEARCH_PROVIDER_UNAVAILABLE";
+      wrapped.providerId = providerId;
+      wrapped.providerEndpoint = searchEndpoint;
+      throw wrapped;
+    }
+
+    if (httpRes.status >= 400) {
+      const err = new Error(
+        `SEARCH_PROVIDER_UNAVAILABLE: Поисковый провайдер "${providerId}" вернул HTTP ${httpRes.status}. Скрытый fallback запрещён.`
+      );
+      err.code = "SEARCH_PROVIDER_UNAVAILABLE";
+      err.httpStatus = httpRes.status;
+      err.providerId = providerId;
+      err.providerEndpoint = searchEndpoint;
+      throw err;
+    }
+
+    let parsedResults = [];
+    const contentType = String(httpRes.headers["content-type"] || "").toLowerCase();
+    if (contentType.includes("application/json")) {
+      const json = JSON.parse(httpRes.body);
+      parsedResults = Array.isArray(json.results) ? json.results : [];
+    } else {
+      const baseOrigin = new URL(searchEndpoint).origin;
+      parsedResults = parseSerpHtml(httpRes.body, baseOrigin);
+    }
+
+    const dedup = deduplicateSearchResults(parsedResults);
+
+    return {
+      providerId,
+      providerEndpoint: searchEndpoint,
+      searchedAt,
+      query: trimmedQuery,
+      results: dedup.uniqueResults,
+      duplicatesRemovedCount: dedup.duplicatesRemovedCount,
+      duplicatesRemoved: dedup.duplicatesRemoved
+    };
+  }
+
+  return {
+    providerId,
+    get searchEndpoint() {
+      return searchEndpoint;
+    },
+    setSearchEndpoint,
+    executeQuery,
+    fetchHttpRaw
+  };
+}
+
+module.exports = {
+  computeContentFingerprint,
+  createSearchProviderAdapter,
+  deduplicateSearchResults,
+  fetchHttpRaw,
+  normalizeCanonicalSearchUrl,
+  parseSerpHtml
+};
