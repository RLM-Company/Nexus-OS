+
+function buildStructuredResearchReport({
+  question,
+  subQuestions = [],
+  options = [],
+  criteria = [],
+  extractedFacts = [],
+  snapshotsByUrl = new Map(),
+  unavailableSources = [],
+  queryBudgetStats = null
