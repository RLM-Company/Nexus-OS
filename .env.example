NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=file:./data/nexus.db
NEXUS_API_ORIGIN=http://127.0.0.1:3100
MODEL_PROVIDER=mock
# Use openai-compatible for /chat/completions or anthropic-compatible for /messages.
# MODEL_BASE_URL=https://provider.example/v1
# MODEL_API_KEY=replace-locally-never-commit
# MODEL_NAME=provider-model-id
MODEL_FALLBACK_TO_MOCK=true
MANAGER_TIMEOUT_MS=60000
MANAGER_MAX_OUTPUT_TOKENS=1200
LOG_LEVEL=info
MOCK_PROVIDER_MODE=success
