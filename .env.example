NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=file:./data/cosmora.db
COSMORA_API_ORIGIN=http://127.0.0.1:3100
MODEL_PROVIDER=mock
# Stable provider identity used by Model Registry and Usage Ledger.
MODEL_PROVIDER_ID=mock
# Absolute paths are supported; repository-relative paths resolve from the repository root.
# MODEL_REGISTRY_PATH=config/model-registry.vibecode.v1.json
# Use openai-compatible for /chat/completions or anthropic-compatible for /messages.
# MODEL_BASE_URL=https://provider.example/v1
# MODEL_API_KEY=replace-locally-never-commit
# MODEL_NAME=provider-model-id
MODEL_FALLBACK_TO_MOCK=true
MODEL_MAX_ATTEMPTS_PER_ROUTE=2
MODEL_RETRY_BASE_DELAY_MS=250
MODEL_RETRY_MAX_DELAY_MS=2000
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_OPEN_MS=30000
# Fail-closed operational switch. A persisted stop must be cleared through an audited recovery flow.
RUNTIME_EMERGENCY_STOP=false
MANAGER_TIMEOUT_MS=60000
MANAGER_MAX_OUTPUT_TOKENS=1200
LOG_LEVEL=info
MOCK_PROVIDER_MODE=success

# Current CheapVibeCode profile (keep MODEL_API_KEY only in a private environment file):
# MODEL_PROVIDER=openai-compatible
# MODEL_PROVIDER_ID=cheapvibecode
# MODEL_REGISTRY_PATH=config/model-registry.cheapvibecode.manager-work-preview.v1.json
# MODEL_BASE_URL=https://ru.cheapvibecode.ru/v1
# MODEL_API_KEY=replace-locally-never-commit
# MODEL_NAME=gpt-5.5
# MODEL_FALLBACK_TO_MOCK=false
# MODEL_MAX_ATTEMPTS_PER_ROUTE=1
# MANAGER_MAX_OUTPUT_TOKENS=1200
# RUNTIME_EMERGENCY_STOP=true
