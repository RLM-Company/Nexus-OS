{
  "name": "@cosmora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "node --env-file-if-exists=../../.env --require ../../scripts/windows-node-user.cjs --import tsx --conditions=development src/server.ts",
    "dev": "node --env-file-if-exists=../../.env --require ../../scripts/windows-node-user.cjs --import tsx --conditions=development --watch src/server.ts",
    "demo:lan": "node --env-file-if-exists=../../.env --require ../../scripts/windows-node-user.cjs --import tsx --conditions=development src/server.ts",
    "lint": "eslint src test",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.1.0",
    "@cosmora/config": "workspace:*",
    "@cosmora/contracts": "workspace:*",
    "@cosmora/core": "workspace:*",
    "@cosmora/db": "workspace:*",
    "@cosmora/model-gateway": "workspace:*",
    "@cosmora/policy-engine": "workspace:*",
    "fastify": "5.12.1",
    "typebox": "1.3.16"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  }
}
