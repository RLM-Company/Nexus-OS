+  padding: 12px 14px;
+  border: 1px solid #dfdfdf;
+  border-radius: 6px;
+  background: #fafafa;
+}
+
+.meta {
+  min-width: 0;
+  flex: 1;
+}
+
+.filename {
+  margin: 0;
+  font-size: 14px;
