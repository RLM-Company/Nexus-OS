diff --git a/desktop/windows/download-center.cjs b/desktop/windows/download-center.cjs
new file mode 100755
index 0000000..4379da8
--- /dev/null
+++ b/desktop/windows/download-center.cjs
@@ -0,0 +1,401 @@
+"use strict";
+
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+const { pathToFileURL } = require("node:url");
+const { createDownloadHistoryStore } = require("./download-history.cjs");
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const BLOCKED_OPEN_EXTENSIONS = new Set([
+  ".exe",
+  ".msi",
+  ".msp",
+  ".bat",
+  ".cmd",
+  ".ps1",
+  ".vbs",
+  ".vbe",
+  ".js",
+  ".jse",
+  ".wsf",
+  ".wsh",
+  ".scr",
+  ".com",
+  ".pif",
+  ".dll",
+  ".sys",
+  ".reg",
+  ".hta",
+  ".cpl",
+  ".jar",
+  ".lnk",
+  ".scf",
+  ".url",
+  ".iso",
+  ".img",
+  ".vhd",
+  ".vhdx"
+]);
+
+function localDownloadsUrl() {
+  return pathToFileURL(path.join(__dirname, "downloads.html")).toString();
+}
+
+function downloadScope(origin, ownerId) {
+  return crypto
+    .createHash("sha256")
+    .update(`${origin}\0${ownerId}`)
+    .digest("hex");
+}
+
+function isDangerousDownloadTarget(filePath) {
+  if (typeof filePath !== "string" || !filePath.trim()) return true;
+  const ext = path.extname(filePath.trim()).toLowerCase();
+  return BLOCKED_OPEN_EXTENSIONS.has(ext);
+}
+
+function createDownloadCenter({
+  profileDirectory,
+  getOrigin,
+  getIdentityEpoch,
+  verifiedOwner,
+  activeDownloads,
+  getDownloadDirectory,
+  getParentWindow = () => null,
+  shell,
+  BrowserWindow = null,
+  ipcMain = null,
+  onStateChanged = () => {}
+}) {
+  const history = createDownloadHistoryStore(profileDirectory);
+  const activeScopes = new Map();
+  let panelWindow = null;
+
+  function isTrustedPanelEvent(event) {
+    if (!event?.senderFrame || event.senderFrame.url !== localDownloadsUrl()) return false;
+    if (panelWindow && !panelWindow.isDestroyed()) {
+      return (
+        event.sender === panelWindow.webContents &&
+        event.senderFrame === panelWindow.webContents.mainFrame
+      );
+    }
+    return true;
+  }
+
+  function notifyPanel() {
+    if (panelWindow && !panelWindow.isDestroyed()) {
+      panelWindow.webContents.send("cosmora:downloads-changed");
+    }
+    onStateChanged();
+  }
+
+  async function resolveActiveScope({ allowCachedWrite = false } = {}) {
+    const origin = getOrigin();
+    const epoch = getIdentityEpoch();
+    if (!origin) return null;
+    const owner = await verifiedOwner({ allowCachedWrite });
+    if (!owner || origin !== getOrigin() || epoch !== getIdentityEpoch()) return null;
+    return { origin, owner, epoch, scope: downloadScope(origin, owner) };
+  }
+
+  function capture(id, item) {
+    if (typeof id !== "string" || !UUID.test(id) || !item) return;
+    const normalizedId = id.toLowerCase();
+    const origin = getOrigin();
+    const epoch = getIdentityEpoch();
+    if (!origin) {
+      try {
+        item.cancel();
+      } catch {
+        /* ignore */
+      }
+      activeDownloads.delete(id);
+      return;
+    }
+
+    let scope = null;
+    let started = false;
+    let finished = null;
+
+    const safeCancel = () => {
+      try {
+        item.cancel();
+      } catch {
+        /* ignore */
+      }
+      activeDownloads.delete(id);
+      activeScopes.delete(normalizedId);
+      notifyPanel();
+    };
+
+    const finish = ({ state, receivedBytes, totalBytes, savePath }) => {
+      activeDownloads.delete(id);
+      activeScopes.delete(normalizedId);
+      if (!started || !scope) return;
+      history.finish(
+        scope,
+        normalizedId,
+        state,
+        receivedBytes,
+        totalBytes,
+        state === "completed" ? savePath : null
+      );
+      notifyPanel();
+    };
+
+    const onUpdated = () => {
+      if (origin !== getOrigin() || epoch !== getIdentityEpoch()) {
+        safeCancel();
+        return;
+      }
+      if (!started || !scope) return;
+      if (history.progress(scope, normalizedId, item.getReceivedBytes(), item.getTotalBytes())) {
+        notifyPanel();
+      }
+    };
+
+    item.on("updated", onUpdated);
+    item.once("done", (_event, state) => {
+      item.removeListener?.("updated", onUpdated);
+      const snapshot = {
+        state,
+        receivedBytes: item.getReceivedBytes(),
+        totalBytes: item.getTotalBytes(),
+        savePath: typeof item.getSavePath === "function" ? item.getSavePath() : null
+      };
+      if (!started) {
+        finished = snapshot;
+        activeDownloads.delete(id);
+        notifyPanel();
+        return;
+      }
+      finish(snapshot);
+    });
+
+    void Promise.resolve(verifiedOwner({ allowCachedWrite: true }))
+      .then((owner) => {
+        if (!owner || origin !== getOrigin() || epoch !== getIdentityEpoch()) {
+          safeCancel();
+          return;
+        }
+        scope = downloadScope(origin, owner);
+        const initialReceived = finished ? finished.receivedBytes : item.getReceivedBytes();
+        const initialTotal = finished ? finished.totalBytes : item.getTotalBytes();
+        if (!history.start(scope, normalizedId, item.getFilename(), initialReceived, initialTotal)) {
+          safeCancel();
+          return;
+        }
+        started = true;
+        activeScopes.set(normalizedId, scope);
+        if (finished) {
+          finish(finished);
+        } else {
+          notifyPanel();
+        }
+      })
+      .catch(() => {
+        safeCancel();
+      });
+  }
+
+  async function list(event) {
+    if (!isTrustedPanelEvent(event)) throw new Error("Untrusted downloads IPC caller.");
+    const context = await resolveActiveScope();
+    if (!context) {
+      return {
+        ok: false,
+        items: [],
+        message: "Войдите в аккаунт Kosmora, чтобы просматривать загрузки."
+      };
+    }
+    return {
+      ok: true,
+      items: history.list(context.scope)
+    };
+  }
+
+  async function openItem(event, id) {
+    if (!isTrustedPanelEvent(event)) throw new Error("Untrusted downloads IPC caller.");
+    if (typeof id !== "string" || !UUID.test(id))
+      return { ok: false, message: "Некорректный идентификатор загрузки." };
+    const context = await resolveActiveScope();
+    if (!context) return { ok: false, message: "Сеанс не подтверждён." };
+    const target = history.resolvePath(context.scope, id);
+    if (!target) return { ok: false, message: "Файл недоступен для текущего аккаунта." };
+    if (isDangerousDownloadTarget(target)) {
+      return {
+        ok: false,
+        message:
+          "Запуск исполняемых и системных файлов из Центра загрузок заблокирован. Используйте «Показать в папке»."
+      };
+    }
+    try {
+      if (!fs.statSync(target).isFile()) throw new Error("Missing file");
+    } catch {
+      return { ok: false, message: "Файл был перемещён или удалён с диска." };
+    }
+    const err = await shell.openPath(target);
+    if (err) return { ok: false, message: "Не удалось открыть файл в системе." };
+    return { ok: true };
+  }
+
+  async function revealItem(event, id) {
+    if (!isTrustedPanelEvent(event)) throw new Error("Untrusted downloads IPC caller.");
+    if (typeof id !== "string" || !UUID.test(id))
+      return { ok: false, message: "Некорректный идентификатор загрузки." };
+    const context = await resolveActiveScope();
+    if (!context) return { ok: false, message: "Сеанс не подтверждён." };
+    const target = history.resolvePath(context.scope, id);
+    if (!target) return { ok: false, message: "Файл недоступен для текущего аккаунта." };
+    try {
+      if (!fs.statSync(target).isFile()) throw new Error("Missing file");
+    } catch {
+      return { ok: false, message: "Файл был перемещён или удалён с диска." };
+    }
+    shell.showItemInFolder(target);
+    return { ok: true };
+  }
+
+  async function cancelItem(event, id) {
+    if (!isTrustedPanelEvent(event)) throw new Error("Untrusted downloads IPC caller.");
+    if (typeof id !== "string" || !UUID.test(id))
+      return { ok: false, message: "Некорректный идентификатор загрузки." };
+    const normalizedId = id.toLowerCase();
+    const context = await resolveActiveScope({ allowCachedWrite: true });
+    if (!context || activeScopes.get(normalizedId) !== context.scope)
+      return { ok: false, message: "Активная загрузка не найдена." };
+    const active = activeDownloads.get(id) || activeDownloads.get(normalizedId);
+    if (!active) return { ok: false, message: "Загрузка уже завершена." };
+    try {
+      active.cancel();
+    } catch {
+      return { ok: false, message: "Не удалось отменить скачивание." };
+    }
+    notifyPanel();
+    return { ok: true };
+  }
+
+  async function removeItem(event, id) {
+    if (!isTrustedPanelEvent(event)) throw new Error("Untrusted downloads IPC caller.");
+    if (typeof id !== "string" || !UUID.test(id))
+      return { ok: false, message: "Некорректный идентификатор загрузки." };
+    const context = await resolveActiveScope();
+    if (!context) return { ok: false, message: "Сеанс не подтверждён." };
+    if (!history.remove(context.scope, id))
+      return { ok: false, message: "Запись загрузки не найдена." };
+    notifyPanel();
+    return { ok: true };
+  }
+
+  async function clearCompleted(event) {
+    if (!isTrustedPanelEvent(event)) throw new Error("Untrusted downloads IPC caller.");
+    const context = await resolveActiveScope();
+    if (!context) return { ok: false, message: "Сеанс не подтверждён." };
+    history.clearCompleted(context.scope);
+    notifyPanel();
+    return { ok: true };
+  }
+
+  async function openFolder(event) {
+    if (!isTrustedPanelEvent(event)) throw new Error("Untrusted downloads IPC caller.");
+    const folder = getDownloadDirectory();
+    const err = await shell.openPath(folder);
+    if (err) return { ok: false, message: "Не удалось открыть папку загрузок." };
+    return { ok: true };
+  }
+
+  function invalidate({ forget = false, origin = null, owner = null } = {}) {
+    if (forget) {
+      if (origin && owner) {
+        history.clearScope(downloadScope(origin, owner));
+      } else {
+        history.clearAll();
+      }
+    }
+    notifyPanel();
+  }
+
+  async function show() {
+    if (!BrowserWindow) return null;
+    if (panelWindow && !panelWindow.isDestroyed()) {
+      if (panelWindow.isMinimized()) panelWindow.restore();
+      panelWindow.show();
+      panelWindow.focus();
+      notifyPanel();
+      return panelWindow;
+    }
+    const parent = getParentWindow();
+    panelWindow = new BrowserWindow({
+      width: 760,
+      height: 540,
+      minWidth: 560,
+      minHeight: 380,
+      parent: parent && !parent.isDestroyed() ? parent : undefined,
+      backgroundColor: "#f6f6f6",
+      show: false,
+      title: "Загрузки Kosmora",
+      autoHideMenuBar: true,
+      webPreferences: {
+        preload: path.join(__dirname, "downloads-preload.cjs"),
+        contextIsolation: true,
+        nodeIntegration: false,
+        sandbox: true,
+        webSecurity: true,
+        allowRunningInsecureContent: false,
+        webviewTag: false,
+        navigateOnDragDrop: false
+      }
+    });
+    panelWindow.webContents.setWindowOpenHandler(() => ({ action: "deny" }));
+    panelWindow.webContents.on("will-navigate", (event, url) => {
+      if (url !== localDownloadsUrl()) event.preventDefault();
+    });
+    panelWindow.once("ready-to-show", () => {
+      if (panelWindow && !panelWindow.isDestroyed()) panelWindow.show();
+    });
+    panelWindow.on("closed", () => {
+      panelWindow = null;
+    });
+    await panelWindow.loadURL(localDownloadsUrl());
+    return panelWindow;
+  }
+
+  function close() {
+    if (panelWindow && !panelWindow.isDestroyed()) {
+      panelWindow.close();
+      panelWindow = null;
+    }
+  }
+
+  if (ipcMain) {
+    ipcMain.handle("cosmora:downloads-list", (event) => list(event));
+    ipcMain.handle("cosmora:downloads-open", (event, id) => openItem(event, id));
+    ipcMain.handle("cosmora:downloads-reveal", (event, id) => revealItem(event, id));
+    ipcMain.handle("cosmora:downloads-cancel", (event, id) => cancelItem(event, id));
+    ipcMain.handle("cosmora:downloads-remove", (event, id) => removeItem(event, id));
+    ipcMain.handle("cosmora:downloads-clear-completed", (event) => clearCompleted(event));
+    ipcMain.handle("cosmora:downloads-open-folder", (event) => openFolder(event));
+  }
+
+  return {
+    capture,
+    list,
+    openItem,
+    revealItem,
+    cancelItem,
+    removeItem,
+    clearCompleted,
+    openFolder,
+    invalidate,
+    show,
+    close
+  };
+}
+
+module.exports = {
+  createDownloadCenter,
+  downloadScope,
+  isDangerousDownloadTarget,
+  localDownloadsUrl
+};
diff --git a/desktop/windows/download-history.cjs b/desktop/windows/download-history.cjs
new file mode 100755
index 0000000..a6c5c08
--- /dev/null
+++ b/desktop/windows/download-history.cjs
@@ -0,0 +1,242 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const { safeDownloadFilename } = require("./connection-policy.cjs");
+const { writeAtomicJson } = require("./desktop-state.cjs");
+
+const FILE_NAME = "download-history.json";
+const MAX_ENTRIES = 50;
+const MAX_FILE_SIZE = 131072;
+const SCOPE = /^[a-f0-9]{64}$/;
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const STATUS = new Set(["active", "completed", "cancelled", "interrupted"]);
+
+function cleanBytes(value) {
+  return Number.isSafeInteger(value) && value >= 0 ? value : 0;
+}
+
+function cleanTotal(value) {
+  return Number.isSafeInteger(value) && value > 0 ? value : null;
+}
+
+function validPath(value) {
+  return typeof value === "string" &&
+    value.length > 0 &&
+    value.length <= 520 &&
+    path.isAbsolute(value) &&
+    !value.includes("\0")
+    ? value
+    : null;
+}
+
+function validIso(value) {
+  return typeof value === "string" &&
+    value.length <= 40 &&
+    Number.isFinite(Date.parse(value))
+    ? value
+    : null;
+}
+
+function sanitizeRecord(item) {
+  if (!item || typeof item !== "object") return null;
+  if (!UUID.test(item.id) || !SCOPE.test(item.scope) || !STATUS.has(item.status)) return null;
+  const startedAt = validIso(item.startedAt);
+  if (!startedAt) return null;
+  let status = item.status === "active" ? "interrupted" : item.status;
+  let savePath = status === "completed" ? validPath(item.savePath) : null;
+  if (status === "completed" && !savePath) {
+    status = "interrupted";
+  }
+  const finishedAt =
+    status === "active" ? null : validIso(item.finishedAt) || new Date().toISOString();
+  return {
+    id: item.id.toLowerCase(),
+    scope: item.scope,
+    name: safeDownloadFilename(item.name),
+    status,
+    receivedBytes: cleanBytes(item.receivedBytes),
+    totalBytes: cleanTotal(item.totalBytes),
+    startedAt,
+    finishedAt,
+    savePath
+  };
+}
+
+function publicEntry(entry) {
+  return {
+    id: entry.id,
+    name: entry.name,
+    status: entry.status,
+    receivedBytes: entry.receivedBytes,
+    totalBytes: entry.totalBytes,
+    startedAt: entry.startedAt,
+    finishedAt: entry.finishedAt
+  };
+}
+
+function createDownloadHistoryStore(profileDirectory) {
+  const filePath = path.join(profileDirectory, FILE_NAME);
+  let records = [];
+
+  function save() {
+    try {
+      writeAtomicJson(filePath, { version: 1, records });
+    } catch {
+      /* never crash the shell on history I/O */
+    }
+  }
+
+  function loadInitial() {
+    let hadFile = false;
+    try {
+      const stat = fs.statSync(filePath);
+      hadFile = true;
+      if (!stat.isFile() || stat.size > MAX_FILE_SIZE) {
+        records = [];
+        save();
+        return;
+      }
+      const parsed = JSON.parse(fs.readFileSync(filePath, "utf8"));
+      if (parsed?.version !== 1 || !Array.isArray(parsed.records)) {
+        records = [];
+        save();
+        return;
+      }
+      const seen = new Set();
+      const cleaned = [];
+      for (const raw of parsed.records) {
+        const record = sanitizeRecord(raw);
+        if (!record) continue;
+        const key = `${record.scope}:${record.id}`;
+        if (seen.has(key)) continue;
+        seen.add(key);
+        cleaned.push(record);
+        if (cleaned.length >= MAX_ENTRIES) break;
+      }
+      records = cleaned;
+      save();
+    } catch {
+      records = [];
+      if (hadFile) save();
+    }
+  }
+
+  loadInitial();
+
+  function find(scope, id) {
+    if (!SCOPE.test(scope) || typeof id !== "string" || !UUID.test(id)) return null;
+    const normalizedId = id.toLowerCase();
+    return records.find((entry) => entry.scope === scope && entry.id === normalizedId) || null;
+  }
+
+  function start(scope, id, name, received = 0, total = null) {
+    if (!SCOPE.test(scope) || typeof id !== "string" || !UUID.test(id) || find(scope, id))
+      return false;
+    while (records.length >= MAX_ENTRIES) {
+      let removableIndex = -1;
+      for (let idx = records.length - 1; idx >= 0; idx -= 1) {
+        if (records[idx].status !== "active") {
+          removableIndex = idx;
+          break;
+        }
+      }
+      if (removableIndex === -1) return false;
+      records.splice(removableIndex, 1);
+    }
+    records.unshift({
+      id: id.toLowerCase(),
+      scope,
+      name: safeDownloadFilename(name),
+      status: "active",
+      receivedBytes: cleanBytes(received),
+      totalBytes: cleanTotal(total),
+      startedAt: new Date().toISOString(),
+      finishedAt: null,
+      savePath: null
+    });
+    save();
+    return true;
+  }
+
+  function progress(scope, id, received, total) {
+    const entry = find(scope, id);
+    if (!entry || entry.status !== "active") return false;
+    entry.receivedBytes = cleanBytes(received);
+    const cleanedTotal = cleanTotal(total);
+    if (cleanedTotal !== null) entry.totalBytes = cleanedTotal;
+    return true;
+  }
+
+  function finish(scope, id, state, received, total, savePath) {
+    const entry = find(scope, id);
+    if (!entry) return false;
+    entry.status =
+      state === "completed" ? "completed" : state === "cancelled" ? "cancelled" : "interrupted";
+    entry.receivedBytes = cleanBytes(received);
+    const cleanedTotal = cleanTotal(total);
+    if (cleanedTotal !== null) entry.totalBytes = cleanedTotal;
+    entry.finishedAt = new Date().toISOString();
+    entry.savePath = entry.status === "completed" ? validPath(savePath) : null;
+    if (entry.status === "completed" && !entry.savePath) {
+      entry.status = "interrupted";
+    }
+    save();
+    return true;
+  }
+
+  function list(scope) {
+    if (!SCOPE.test(scope)) return [];
+    return records.filter((entry) => entry.scope === scope).map(publicEntry);
+  }
+
+  function resolvePath(scope, id) {
+    const entry = find(scope, id);
+    if (!entry || entry.status !== "completed" || !entry.savePath) return null;
+    return entry.savePath;
+  }
+
+  function remove(scope, id) {
+    const entry = find(scope, id);
+    if (!entry || entry.status === "active") return false;
+    records = records.filter((item) => item !== entry);
+    save();
+    return true;
+  }
+
+  function clearCompleted(scope) {
+    if (!SCOPE.test(scope)) return false;
+    records = records.filter((entry) => entry.scope !== scope || entry.status === "active");
+    save();
+    return true;
+  }
+
+  function clearScope(scope) {
+    if (!SCOPE.test(scope)) return false;
+    records = records.filter((entry) => entry.scope !== scope);
+    save();
+    return true;
+  }
+
+  function clearAll() {
+    records = [];
+    save();
+  }
+
+  return {
+    start,
+    progress,
+    finish,
+    list,
+    resolvePath,
+    remove,
+    clearCompleted,
+    clearScope,
+    clearAll
+  };
+}
+
+module.exports = {
+  createDownloadHistoryStore,
+  MAX_ENTRIES
+};
diff --git a/desktop/windows/downloads-preload.cjs b/desktop/windows/downloads-preload.cjs
new file mode 100755
index 0000000..1a06113
--- /dev/null
+++ b/desktop/windows/downloads-preload.cjs
@@ -0,0 +1,20 @@
+"use strict";
+
+const { contextBridge, ipcRenderer } = require("electron");
+
+if (window.location.protocol === "file:") {
+  contextBridge.exposeInMainWorld("cosmoraDownloads", {
+    list: () => ipcRenderer.invoke("cosmora:downloads-list"),
+    openItem: (id) => ipcRenderer.invoke("cosmora:downloads-open", id),
+    revealItem: (id) => ipcRenderer.invoke("cosmora:downloads-reveal", id),
+    cancelItem: (id) => ipcRenderer.invoke("cosmora:downloads-cancel", id),
+    removeItem: (id) => ipcRenderer.invoke("cosmora:downloads-remove", id),
+    clearCompleted: () => ipcRenderer.invoke("cosmora:downloads-clear-completed"),
+    openFolder: () => ipcRenderer.invoke("cosmora:downloads-open-folder"),
+    onChanged: (listener) => {
+      const notify = () => listener();
+      ipcRenderer.on("cosmora:downloads-changed", notify);
+      return () => ipcRenderer.removeListener("cosmora:downloads-changed", notify);
+    }
+  });
+}
