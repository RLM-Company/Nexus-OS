{
  "name": "cosmora-windows-desktop",
  "version": "0.11.1",
  "private": true,
  "description": "Thin Windows desktop client for the hosted Kosmora workspace",
  "main": "main.cjs",
  "author": "RLM-Company",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check connection-policy.cjs && node --check smoke-mode.cjs && node --check connection.js && node --check desktop-state.cjs && node --check desktop-recovery.cjs && node --check draft-store.cjs && node --check update-policy.cjs && node --check update-service.cjs && node --check ci/create-signed-update.cjs && node --test test/*.test.cjs",
    "pack:win": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.cosmora.desktop",
    "productName": "Kosmora",
    "electronVersion": "44.5.1",
    "asar": true,
    "protocols": [{ "name": "Kosmora deep links", "schemes": ["kosmora"] }],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "connection-policy.cjs",
      "smoke-mode.cjs",
      "desktop-state.cjs",
      "desktop-recovery.cjs",
      "draft-store.cjs",
      "update-policy.cjs",
      "update-service.cjs",
      "update-trust.json",
      "connection.html",
      "connection.js",
      "connection.css",
      "build/icon.ico",
      "build/icon.svg"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kosmora-Setup-${version}-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kosmora",
      "uninstallDisplayName": "Kosmora",
      "deleteAppDataOnUninstall": false
    }
  }
}
