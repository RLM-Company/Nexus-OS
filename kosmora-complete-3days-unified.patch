@@ -0,0 +1,204 @@
+/**
+ * Kosmora / Nexus-OS Temporal Bitemporal Knowledge Graph & Time-Travel Query Engine (Wave 20)
+ *
+ * Tracks subject-predicate-object triples with bitemporal intervals:
+ * - Valid Time (`valid_from`, `valid_to`): when the fact was true in the real world.
+ * - Transaction Time (`recorded_at`, `superseded_at`): when the fact was stored/superseded in the system.
+ *
+ * Capabilities:
+ * 1. Non-destructive temporal superseding: updating a fact's object closes the prior interval
+ *    (`valid_to = effectiveAt`, `superseded_at = now`) and opens a new active triple linked via `supersedes_id`.
+ * 2. Point-in-time "time-travel" queries (`queryStateAsOf`): reconstructs exact factual state at any
+ *    historical timestamp `T`.
+ * 3. Multi-hop temporal lineage (`getFactEvolutionChain`): returns the complete chronological audit trail
+ *    of how a project metric, budget, or deadline evolved over time.
+ */
+
+import { randomUUID } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+
+export interface BitemporalFactTriple {
+  id: string;
+  ownerId: string;
+  subject: string;
+  predicate: string;
+  objectValue: string;
+  sourceDocId?: string;
+  validFrom: string;
+  validTo: string | null; // null means currently valid
+  recordedAt: string;
+  supersededAt: string | null;
+  supersedesId: string | null;
+}
+
+export class TemporalKnowledgeGraph {
+  constructor(private readonly sqlite: DatabaseSync) {
+    this.ensureSchema();
+  }
+
+  ensureSchema(): void {
+    this.sqlite.exec(`
+      CREATE TABLE IF NOT EXISTS kosmora_temporal_knowledge_graph (
+        id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        subject TEXT NOT NULL,
+        predicate TEXT NOT NULL,
+        object_value TEXT NOT NULL,
+        source_doc_id TEXT,
+        valid_from TEXT NOT NULL,
+        valid_to TEXT,
+        recorded_at TEXT NOT NULL,
+        superseded_at TEXT,
+        supersedes_id TEXT
+      );
+      CREATE INDEX IF NOT EXISTS kosmora_temporal_kg_owner_subj_pred_idx
+        ON kosmora_temporal_knowledge_graph(owner_id, subject, predicate, valid_from ASC);
+    `);
+  }
+
+  /**
+   * Asserts a fact triple `(subject, predicate, objectValue)` effective at `validFrom`.
+   * If an active triple for `(ownerId, subject, predicate)` already exists with a different value,
+   * closes the old triple's `valid_to` and `superseded_at` and links the new triple via `supersedes_id`.
+   */
+  public assertFactTriple(options: {
+    ownerId: string;
+    subject: string;
+    predicate: string;
+    objectValue: string;
+    sourceDocId?: string;
+    validFrom?: string;
+    recordedAt?: string;
+  }): BitemporalFactTriple {
+    const validFrom = options.validFrom ?? new Date().toISOString();
+    const recordedAt = options.recordedAt ?? validFrom;
+    const subjectNorm = options.subject.trim();
+    const predicateNorm = options.predicate.trim();
+    const objectNorm = options.objectValue.trim();
+
+    // Find currently active fact for (ownerId, subject, predicate)
+    const activeRow = this.sqlite
+      .prepare(
+        `SELECT * FROM kosmora_temporal_knowledge_graph
+         WHERE owner_id = ? AND subject = ? AND predicate = ? AND valid_to IS NULL AND superseded_at IS NULL
+         ORDER BY valid_from DESC LIMIT 1`
+      )
+      .get(options.ownerId, subjectNorm, predicateNorm) as any;
+
+    let supersedesId: string | null = null;
+
+    if (activeRow) {
+      if (activeRow.object_value === objectNorm) {
+        return this.mapRow(activeRow);
+      }
+      supersedesId = activeRow.id;
+      this.sqlite
+        .prepare(
+          `UPDATE kosmora_temporal_knowledge_graph
+           SET valid_to = ?, superseded_at = ?
+           WHERE id = ? AND owner_id = ?`
+        )
+        .run(validFrom, recordedAt, activeRow.id, options.ownerId);
+    }
+
+    const id = `tkg-${randomUUID()}`;
+    this.sqlite
+      .prepare(
+        `INSERT INTO kosmora_temporal_knowledge_graph (
+          id, owner_id, subject, predicate, object_value, source_doc_id,
+          valid_from, valid_to, recorded_at, superseded_at, supersedes_id
+        ) VALUES (?, ?, ?, ?, ?, ?, ?, NULL, ?, NULL, ?)`
+      )
+      .run(
+        id,
+        options.ownerId,
+        subjectNorm,
+        predicateNorm,
+        objectNorm,
+        options.sourceDocId ?? null,
+        validFrom,
+        recordedAt,
+        supersedesId
+      );
+
+    return {
+      id,
+      ownerId: options.ownerId,
+      subject: subjectNorm,
+      predicate: predicateNorm,
+      objectValue: objectNorm,
+      sourceDocId: options.sourceDocId,
+      validFrom,
+      validTo: null,
+      recordedAt,
+      supersededAt: null,
+      supersedesId
+    };
+  }
+
+  /**
+   * Time-travel query: returns all facts valid at the exact point in time `asOfIso`.
+   */
+  public queryStateAsOf(options: {
+    ownerId: string;
+    subject?: string;
+    predicate?: string;
+    asOfIso: string;
+  }): BitemporalFactTriple[] {
+    let sql = `
+      SELECT * FROM kosmora_temporal_knowledge_graph
+      WHERE owner_id = ?
+        AND valid_from <= ?
+        AND (valid_to IS NULL OR valid_to > ?)
+    `;
+    const params: any[] = [options.ownerId, options.asOfIso, options.asOfIso];
+
+    if (options.subject) {
+      sql += " AND subject = ?";
+      params.push(options.subject.trim());
+    }
+    if (options.predicate) {
+      sql += " AND predicate = ?";
+      params.push(options.predicate.trim());
+    }
+    sql += " ORDER BY valid_from ASC";
+
+    const rows = this.sqlite.prepare(sql).all(...params) as any[];
+    return rows.map((r) => this.mapRow(r));
+  }
+
+  /**
+   * Returns the complete chronological evolution chain for a `(subject, predicate)` pair.
+   */
+  public getFactEvolutionChain(
+    ownerId: string,
+    subject: string,
+    predicate: string
+  ): BitemporalFactTriple[] {
+    const rows = this.sqlite
+      .prepare(
+        `SELECT * FROM kosmora_temporal_knowledge_graph
+         WHERE owner_id = ? AND subject = ? AND predicate = ?
+         ORDER BY valid_from ASC, recorded_at ASC`
+      )
+      .all(ownerId, subject.trim(), predicate.trim()) as any[];
+
+    return rows.map((r) => this.mapRow(r));
+  }
+
+  private mapRow(r: any): BitemporalFactTriple {
+    return {
+      id: r.id,
+      ownerId: r.owner_id,
+      subject: r.subject,
+      predicate: r.predicate,
+      objectValue: r.object_value,
+      sourceDocId: r.source_doc_id ?? undefined,
+      validFrom: r.valid_from,
+      validTo: r.valid_to ?? null,
+      recordedAt: r.recorded_at,
+      supersededAt: r.superseded_at ?? null,
+      supersedesId: r.supersedes_id ?? null
+    };
+  }
+}
diff --git a/packages/db/src/vault-cross-citation-graph.ts b/packages/db/src/vault-cross-citation-graph.ts
new file mode 100644
index 0000000..de4977f
--- /dev/null
+++ b/packages/db/src/vault-cross-citation-graph.ts
@@ -0,0 +1,197 @@
+import { createHash } from "node:crypto";
+import {
+  extractMemoryEntities,
+  normalizeStem,
+  type ExtractedEntity
+} from "./context-memory-hybrid-search.ts";
+
+export interface GraphDocumentInput {
+  id: string;
+  filename: string;
+  format: string;
+  text: string;
+  updatedAt?: string;
+}
+
+export interface CrossCitationLink {
+  sourceDocId: string;
+  targetDocId: string;
+  sourceFilename: string;
+  targetFilename: string;
+  matchingSentence: string;
+  sentenceSha256: string;
+  confidence: number;
+}
+
+export interface InterDocumentContradiction {
+  subjectStem: string;
+  docA: { id: string; filename: string; value: string; quote: string };
+  docB: { id: string; filename: string; value: string; quote: string };
+  severity: "critical" | "warning";
+  discrepancyReason: string;
+}
+
+export interface DocumentKnowledgeGraph {
+  documentCount: number;
+  totalSentences: number;
+  citations: CrossCitationLink[];
+  contradictions: InterDocumentContradiction[];
+  documents: Array<{ id: string; filename: string; format: string; charCount: number }>;
+  generatedAt: string;
+}
+
+function splitSentences(text: string): string[] {
+  return String(text ?? "")
+    .normalize("NFKC")
+    .split(/(?:\r?\n)+|(?<=[.!?])\s+/u)
+    .map((s) => s.trim())
+    .filter((s) => s.length >= 10 && s.length <= 800);
+}
+
+/**
+ * Multi-Document Cross-Citation Graph & Inter-Document Contradiction Detector for Local Vault.
+ *
+ * Capabilities:
+ * 1. Analyzes multiple documents in `.kosmora-vault` / Project Materials simultaneously.
+ * 2. Identifies cross-document citations (identical/near-identical claims, file references).
+ * 3. Detects factual contradictions across documents when numbers, budgets, or dates diverge
+ *    on the same core topic.
+ */
+export class VaultCrossCitationGraphEngine {
+  buildKnowledgeGraph(documents: GraphDocumentInput[]): DocumentKnowledgeGraph {
+    const citations: CrossCitationLink[] = [];
+    const contradictions: InterDocumentContradiction[] = [];
+    let totalSentences = 0;
+
+    const docSentences = new Map<string, Array<{ text: string; sha256: string; entities: ExtractedEntity[] }>>();
+
+    for (const doc of documents) {
+      const sentences = splitSentences(doc.text);
+      totalSentences += sentences.length;
+      const parsed = sentences.map((s) => ({
+        text: s,
+        sha256: createHash("sha256").update(s, "utf8").digest("hex"),
+        entities: extractMemoryEntities(s)
+      }));
+      docSentences.set(doc.id, parsed);
+    }
+
+    // 1. Cross-Document Citations: sentence matching or explicit file name references
+    for (let i = 0; i < documents.length; i++) {
+      const docA = documents[i];
+      const sentsA = docSentences.get(docA.id) ?? [];
+
+      for (let j = i + 1; j < documents.length; j++) {
+        const docB = documents[j];
+        const sentsB = docSentences.get(docB.id) ?? [];
+
+        // Check if docA explicitly mentions docB's filename or vice-versa
+        const docANorm = docA.text.toLowerCase();
+        const docBNorm = docB.text.toLowerCase();
+        const bNameLower = docB.filename.toLowerCase();
+        const aNameLower = docA.filename.toLowerCase();
+
+        if (docANorm.includes(bNameLower)) {
+          citations.push({
+            sourceDocId: docA.id,
+            targetDocId: docB.id,
+            sourceFilename: docA.filename,
+            targetFilename: docB.filename,
+            matchingSentence: `Документ ссылается на файл: ${docB.filename}`,
+            sentenceSha256: createHash("sha256").update(docB.filename, "utf8").digest("hex"),
+            confidence: 0.95
+          });
+        }
+        if (docBNorm.includes(aNameLower)) {
+          citations.push({
+            sourceDocId: docB.id,
+            targetDocId: docA.id,
+            sourceFilename: docB.filename,
+            targetFilename: docA.filename,
+            matchingSentence: `Документ ссылается на файл: ${docA.filename}`,
+            sentenceSha256: createHash("sha256").update(docA.filename, "utf8").digest("hex"),
+            confidence: 0.95
+          });
+        }
+
+        // Sentence-level citation matching (identical quotes shared across documents)
+        for (const sa of sentsA) {
+          for (const sb of sentsB) {
+            if (sa.sha256 === sb.sha256 || sa.text.toLowerCase() === sb.text.toLowerCase()) {
+              citations.push({
+                sourceDocId: docA.id,
+                targetDocId: docB.id,
+                sourceFilename: docA.filename,
+                targetFilename: docB.filename,
+                matchingSentence: sa.text,
+                sentenceSha256: sa.sha256,
+                confidence: 1.0
+              });
+            }
+          }
+        }
+
+        // 2. Inter-Document Contradiction Detection (divergent numbers/dates on shared subject stems)
+        for (const sa of sentsA) {
+          const numDateA = sa.entities.filter(
+            (e) => e.kind === "money_or_number" || e.kind === "date"
+          );
+          if (numDateA.length === 0) continue;
+
+          for (const sb of sentsB) {
+            const numDateB = sb.entities.filter(
+              (e) => e.kind === "money_or_number" || e.kind === "date"
+            );
+            if (numDateB.length === 0) continue;
+
+            const wordsA = (sa.text.toLowerCase().match(/[\p{L}]{4,}/gu) ?? []).map(normalizeStem);
+            const wordsB = new Set(
+              (sb.text.toLowerCase().match(/[\p{L}]{4,}/gu) ?? []).map(normalizeStem)
+            );
+            const sharedStems = wordsA.filter((w) => wordsB.has(w));
+
+            // If sentences share 2+ meaningful topic stems but have conflicting numbers or dates
+            if (sharedStems.length >= 2) {
+              const matchedEntA = numDateA[0];
+              const matchedEntB = numDateB.find((eb) => eb.kind === matchedEntA.kind);
+
+              if (matchedEntB && matchedEntA.normalized !== matchedEntB.normalized) {
+                contradictions.push({
+                  subjectStem: sharedStems.slice(0, 3).join(", "),
+                  docA: {
+                    id: docA.id,
+                    filename: docA.filename,
+                    value: matchedEntA.raw,
+                    quote: sa.text
+                  },
+                  docB: {
+                    id: docB.id,
+                    filename: docB.filename,
+                    value: matchedEntB.raw,
+                    quote: sb.text
+                  },
+                  severity: matchedEntA.kind === "money_or_number" ? "critical" : "warning",
+                  discrepancyReason: `Расхождение значения (${matchedEntA.raw} в ${docA.filename} против ${matchedEntB.raw} в ${docB.filename}) по теме [${sharedStems.join(", ")}]`
+                });
+              }
+            }
+          }
+        }
+      }
+    }
+
+    return {
+      documentCount: documents.length,
+      totalSentences,
+      citations,
+      contradictions,
+      documents: documents.map((d) => ({
+        id: d.id,
+        filename: d.filename,
+        format: d.format,
+        charCount: d.text.length
+      })),
+      generatedAt: new Date().toISOString()
+    };
+  }
+}
diff --git a/packages/db/src/vps-chat-history-migrator.ts b/packages/db/src/vps-chat-history-migrator.ts
new file mode 100644
index 0000000..2dad8a4
--- /dev/null
+++ b/packages/db/src/vps-chat-history-migrator.ts
@@ -0,0 +1,347 @@
+import { createHash } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+
+export interface VpsChatMigrationBatch {
+  table: "general_chats" | "general_chat_runs" | "general_chat_messages" | "context_memory_entries";
+  batchIndex: number;
+  rowCount: number;
+  sha256: string;
+  rows: Array<Record<string, unknown>>;
+}
+
+export interface VpsChatMigrationBundle {
+  schemaVersion: "kosmora-vps-chat-migration-v1";
+  ownerId: string;
+  exportedAt: string;
+  maxBatchSize: number;
+  totalRows: number;
+  manifestSha256: string;
+  batches: VpsChatMigrationBatch[];
+}
+
+export interface VpsChatRestoreSummary {
+  ownerId: string;
+  verifiedBatches: number;
+  insertedChats: number;
+  insertedRuns: number;
+  insertedMessages: number;
+  insertedMemories: number;
+  skippedExistingRows: number;
+}
+
+/**
+ * Memory-bounded streaming exporter/importer designed for the 1 vCPU / 1 GB RAM replacement VPS (PR #423).
+ * Exports and restores user chat history and context memories in small verified batches (<= 200 rows)
+ * without loading entire multi-megabyte tables into heap at once.
+ */
+export class VpsChatHistoryMigrator {
+  constructor(private readonly sqlite: DatabaseSync) {}
+
+  ensureTables(): void {
+    this.sqlite.exec(`
+      CREATE TABLE IF NOT EXISTS general_chats (
+        id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        title TEXT NOT NULL,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS general_chat_runs (
+        id TEXT PRIMARY KEY NOT NULL,
+        chat_id TEXT NOT NULL,
+        status TEXT NOT NULL,
+        provider TEXT,
+        model_resolved TEXT,
+        input_tokens INTEGER,
+        output_tokens INTEGER,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS general_chat_messages (
+        id TEXT PRIMARY KEY NOT NULL,
+        chat_id TEXT NOT NULL,
+        owner_id TEXT NOT NULL,
+        role TEXT NOT NULL,
+        content_type TEXT NOT NULL,
+        content TEXT NOT NULL,
+        status TEXT NOT NULL,
+        client_message_id TEXT,
+        run_id TEXT,
+        error_code TEXT,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS context_memory_entries (
+        id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        scope TEXT NOT NULL,
+        chat_id TEXT,
+        project_id TEXT,
+        kind TEXT NOT NULL,
+        title TEXT NOT NULL,
+        content TEXT NOT NULL,
+        pinned INTEGER NOT NULL DEFAULT 0,
+        expires_at TEXT,
+        source_chat_message_id TEXT,
+        source_project_message_id TEXT,
+        source_json TEXT NOT NULL DEFAULT '{}',
+        version INTEGER NOT NULL DEFAULT 1,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL,
+        creation_key TEXT,
+        creation_sha256 TEXT
+      );
+    `);
+  }
+
+  exportOwnerHistoryBundle(ownerId: string, maxBatchSize = 150): VpsChatMigrationBundle {
+    this.ensureTables();
+    const safeBatchSize = Math.min(Math.max(maxBatchSize, 10), 250);
+    const batches: VpsChatMigrationBatch[] = [];
+    let totalRows = 0;
+
+    const pushTableBatches = (
+      table: VpsChatMigrationBatch["table"],
+      allRows: Array<Record<string, unknown>>
+    ) => {
+      let batchIndex = 0;
+      for (let offset = 0; offset < allRows.length; offset += safeBatchSize) {
+        const slice = allRows.slice(offset, offset + safeBatchSize);
+        const sha256 = createHash("sha256")
+          .update(JSON.stringify(slice), "utf8")
+          .digest("hex");
+        batches.push({
+          table,
+          batchIndex: batchIndex++,
+          rowCount: slice.length,
+          sha256,
+          rows: slice
+        });
+        totalRows += slice.length;
+      }
+    };
+
+    const chats = this.sqlite
+      .prepare("SELECT * FROM general_chats WHERE owner_id = ? ORDER BY created_at ASC, id ASC")
+      .all(ownerId) as Array<Record<string, unknown>>;
+    pushTableBatches("general_chats", chats);
+
+    const runs = this.sqlite
+      .prepare(
+        `SELECT r.* FROM general_chat_runs r
+         JOIN general_chats c ON c.id = r.chat_id
+         WHERE c.owner_id = ?
+         ORDER BY r.created_at ASC, r.id ASC`
+      )
+      .all(ownerId) as Array<Record<string, unknown>>;
+    pushTableBatches("general_chat_runs", runs);
+
+    const messages = this.sqlite
+      .prepare(
+        "SELECT * FROM general_chat_messages WHERE owner_id = ? ORDER BY created_at ASC, id ASC"
+      )
+      .all(ownerId) as Array<Record<string, unknown>>;
+    pushTableBatches("general_chat_messages", messages);
+
+    const memories = this.sqlite
+      .prepare(
+        "SELECT * FROM context_memory_entries WHERE owner_id = ? ORDER BY created_at ASC, id ASC"
+      )
+      .all(ownerId) as Array<Record<string, unknown>>;
+    pushTableBatches("context_memory_entries", memories);
+
+    const manifestSha256 = createHash("sha256")
+      .update(
+        JSON.stringify(
+          batches.map((b) => ({
+            table: b.table,
+            batchIndex: b.batchIndex,
+            rowCount: b.rowCount,
+            sha256: b.sha256
+          }))
+        ),
+        "utf8"
+      )
+      .digest("hex");
+
+    return {
+      schemaVersion: "kosmora-vps-chat-migration-v1",
+      ownerId,
+      exportedAt: new Date().toISOString(),
+      maxBatchSize: safeBatchSize,
+      totalRows,
+      manifestSha256,
+      batches
+    };
+  }
+
+  restoreOwnerHistoryBundle(bundle: VpsChatMigrationBundle): VpsChatRestoreSummary {
+    this.ensureTables();
+    if (bundle.schemaVersion !== "kosmora-vps-chat-migration-v1") {
+      throw new Error(`UNSUPPORTED_BUNDLE_SCHEMA: ${String(bundle.schemaVersion)}`);
+    }
+
+    // Verify manifest and batch SHA-256 integrity before touching SQLite
+    const expectedManifest = createHash("sha256")
+      .update(
+        JSON.stringify(
+          bundle.batches.map((b) => ({
+            table: b.table,
+            batchIndex: b.batchIndex,
+            rowCount: b.rowCount,
+            sha256: b.sha256
+          }))
+        ),
+        "utf8"
+      )
+      .digest("hex");
+
+    if (expectedManifest !== bundle.manifestSha256) {
+      throw new Error("BUNDLE_MANIFEST_SHA256_MISMATCH");
+    }
+
+    for (const batch of bundle.batches) {
+      const actualHash = createHash("sha256")
+        .update(JSON.stringify(batch.rows), "utf8")
+        .digest("hex");
+      if (actualHash !== batch.sha256) {
+        throw new Error(`BATCH_SHA256_MISMATCH: ${batch.table}#${batch.batchIndex}`);
+      }
+    }
+
+    let insertedChats = 0;
+    let insertedRuns = 0;
+    let insertedMessages = 0;
+    let insertedMemories = 0;
+    let skippedExistingRows = 0;
+
+    this.sqlite.exec("BEGIN IMMEDIATE");
+    try {
+      for (const batch of bundle.batches) {
+        if (batch.table === "general_chats") {
+          const stmt = this.sqlite.prepare(
+            `INSERT OR IGNORE INTO general_chats (id, owner_id, title, created_at, updated_at)
+             VALUES (?, ?, ?, ?, ?)`
+          );
+          for (const r of batch.rows) {
+            if (String(r.owner_id) !== bundle.ownerId) {
+              throw new Error("CROSS_OWNER_ROW_REJECTED");
+            }
+            const res = stmt.run(
+              String(r.id),
+              String(r.owner_id),
+              String(r.title),
+              String(r.created_at),
+              String(r.updated_at)
+            );
+            if (res.changes > 0) insertedChats++;
+            else skippedExistingRows++;
+          }
+        } else if (batch.table === "general_chat_runs") {
+          const stmt = this.sqlite.prepare(
+            `INSERT OR IGNORE INTO general_chat_runs (
+              id, chat_id, status, provider, model_resolved, input_tokens, output_tokens, created_at, updated_at
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
+          );
+          for (const r of batch.rows) {
+            const res = stmt.run(
+              String(r.id),
+              String(r.chat_id),
+              String(r.status),
+              r.provider ? String(r.provider) : null,
+              r.model_resolved ? String(r.model_resolved) : null,
+              typeof r.input_tokens === "number" ? r.input_tokens : null,
+              typeof r.output_tokens === "number" ? r.output_tokens : null,
+              String(r.created_at),
+              String(r.updated_at)
+            );
+            if (res.changes > 0) insertedRuns++;
+            else skippedExistingRows++;
+          }
+        } else if (batch.table === "general_chat_messages") {
+          const stmt = this.sqlite.prepare(
+            `INSERT OR IGNORE INTO general_chat_messages (
+              id, chat_id, owner_id, role, content_type, content, status,
+              client_message_id, run_id, error_code, created_at, updated_at
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
+          );
+          for (const r of batch.rows) {
+            if (String(r.owner_id) !== bundle.ownerId) {
+              throw new Error("CROSS_OWNER_ROW_REJECTED");
+            }
+            const res = stmt.run(
+              String(r.id),
+              String(r.chat_id),
+              String(r.owner_id),
+              String(r.role),
+              String(r.content_type),
+              String(r.content),
+              String(r.status),
+              r.client_message_id ? String(r.client_message_id) : null,
+              r.run_id ? String(r.run_id) : null,
+              r.error_code ? String(r.error_code) : null,
+              String(r.created_at),
+              String(r.updated_at)
+            );
+            if (res.changes > 0) insertedMessages++;
+            else skippedExistingRows++;
+          }
+        } else if (batch.table === "context_memory_entries") {
+          const stmt = this.sqlite.prepare(
+            `INSERT OR IGNORE INTO context_memory_entries (
+              id, owner_id, scope, chat_id, project_id, kind, title, content, pinned,
+              expires_at, source_chat_message_id, source_project_message_id, source_json,
+              version, created_at, updated_at, creation_key, creation_sha256
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
+          );
+          for (const r of batch.rows) {
+            if (String(r.owner_id) !== bundle.ownerId) {
+              throw new Error("CROSS_OWNER_ROW_REJECTED");
+            }
+            const res = stmt.run(
+              String(r.id),
+              String(r.owner_id),
+              String(r.scope),
+              r.chat_id ? String(r.chat_id) : null,
+              r.project_id ? String(r.project_id) : null,
+              String(r.kind),
+              String(r.title),
+              String(r.content),
+              Number(r.pinned ?? 0),
+              r.expires_at ? String(r.expires_at) : null,
+              r.source_chat_message_id ? String(r.source_chat_message_id) : null,
+              r.source_project_message_id ? String(r.source_project_message_id) : null,
+              String(r.source_json ?? "{}"),
+              Number(r.version ?? 1),
+              String(r.created_at),
+              String(r.updated_at),
+              r.creation_key ? String(r.creation_key) : null,
+              r.creation_sha256 ? String(r.creation_sha256) : null
+            );
+            if (res.changes > 0) insertedMemories++;
+            else skippedExistingRows++;
+          }
+        }
+      }
+
+      this.sqlite.exec("COMMIT");
+    } catch (err) {
+      try {
+        this.sqlite.exec("ROLLBACK");
+      } catch {
+        // ignore
+      }
+      throw err;
+    }
+
+    return {
+      ownerId: bundle.ownerId,
+      verifiedBatches: bundle.batches.length,
+      insertedChats,
+      insertedRuns,
+      insertedMessages,
+      insertedMemories,
+      skippedExistingRows
+    };
+  }
+}
