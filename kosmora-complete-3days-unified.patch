index 0000000..a57a121
--- /dev/null
+++ b/apps/api/src/context-memory-hybrid-routes.ts
@@ -0,0 +1,104 @@
+import type { FastifyInstance, FastifyReply, FastifyRequest } from "fastify";
+import type { DatabaseSync } from "node:sqlite";
+import {
+  ContextMemoryHybridSearch,
+  buildResponseMemoryCitations,
+  type HybridRecallOptions
+} from "../../../packages/db/src/context-memory-hybrid-search.ts";
+import { ContextMemoryNotesMigrator } from "../../../packages/db/src/context-memory-notes-migrator.ts";
+
+export interface RegisterContextMemoryHybridRoutesOptions {
+  sqlite: DatabaseSync;
+  resolveOwnerId?: (req: FastifyRequest) => string | null;
+}
+
+export async function registerContextMemoryHybridRoutes(
+  app: FastifyInstance,
+  options: RegisterContextMemoryHybridRoutesOptions
+): Promise<void> {
+  const hybridSearch = new ContextMemoryHybridSearch(options.sqlite);
+  const migrator = new ContextMemoryNotesMigrator(options.sqlite);
+
+  const getOwner = (req: FastifyRequest, reply: FastifyReply): string | null => {
+    const ownerId =
+      options.resolveOwnerId?.(req) ??
+      (req.headers["x-kosmora-owner-id"] as string | undefined) ??
+      null;
+    if (!ownerId) {
+      reply.code(401).send({ error: "UNAUTHORIZED", message: "Owner session required" });
+      return null;
+    }
+    return ownerId;
+  };
+
+  app.post("/api/context-memory/hybrid-recall", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const body = (req.body ?? {}) as Partial<HybridRecallOptions> & { responsePreviewText?: string };
+    const bundle = hybridSearch.recall({
+      ownerId,
+      query: String(body.query ?? ""),
+      targetKind: body.targetKind,
+      targetId: body.targetId,
+      chatId: body.chatId ?? null,
+      projectId: body.projectId ?? null,
+      includePersonal: body.includePersonal ?? true,
+      permittedChatIds: Array.isArray(body.permittedChatIds) ? body.permittedChatIds : [],
+      permittedProjectIds: Array.isArray(body.permittedProjectIds) ? body.permittedProjectIds : [],
+      temporaryMode: Boolean(body.temporaryMode),
+      maxItems: body.maxItems,
+      maxBytes: body.maxBytes
+    });
+
+    const citations =
+      typeof body.responsePreviewText === "string" && body.responsePreviewText.trim()
+        ? buildResponseMemoryCitations(bundle.items, body.responsePreviewText)
+        : [];
+
+    return reply.code(200).send({
+      ...bundle,
+      citations
+    });
+  });
+
+  app.post("/api/context-memory/migrate-legacy", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const result = migrator.migrateOwnerLegacyMemory(ownerId);
+    return reply.code(200).send(result);
+  });
+
+  app.get("/api/context-memory/defaults", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    return reply.code(200).send(migrator.getOwnerDefaultRules(ownerId));
+  });
+
+  app.put("/api/context-memory/defaults", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const body = (req.body ?? {}) as Record<string, unknown>;
+    const updated = migrator.updateOwnerDefaultRules(ownerId, {
+      defaultEnabled:
+        typeof body.defaultEnabled === "boolean" ? body.defaultEnabled : undefined,
+      defaultUsePersonal:
+        typeof body.defaultUsePersonal === "boolean" ? body.defaultUsePersonal : undefined,
+      defaultAutoExtract:
+        typeof body.defaultAutoExtract === "boolean" ? body.defaultAutoExtract : undefined,
+      defaultTemporaryMode:
+        typeof body.defaultTemporaryMode === "boolean" ? body.defaultTemporaryMode : undefined
+    });
+    return reply.code(200).send(updated);
+  });
+
+  app.post("/api/context-memory/chats/:chatId/init-mode", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const { chatId } = req.params as { chatId: string };
+    const body = (req.body ?? {}) as { temporaryMode?: boolean };
+    const state = migrator.initializeNewChatMemorySettings(ownerId, chatId, {
+      temporaryMode: typeof body.temporaryMode === "boolean" ? body.temporaryMode : undefined
+    });
+    return reply.code(200).send(state);
+  });
+}
diff --git a/apps/api/src/fable-discovery-and-registry-validator.ts b/apps/api/src/fable-discovery-and-registry-validator.ts
new file mode 100644
index 0000000..a272f55
--- /dev/null
+++ b/apps/api/src/fable-discovery-and-registry-validator.ts
@@ -0,0 +1,113 @@
+import { createHash } from "node:crypto";
+
+export interface FableRegistryProfile {
+  registryVersion: string;
+  providerId: "tokenshop";
+  providerAdapter: "openai-compatible";
+  baseUrl: string;
+  modelName: "claude-fable-5";
+  contextWindowTokens: number;
+  maxOutputTokens: number;
+  fallbackToMock: false;
+  maxAttemptsPerRoute: 1;
+  managerTimeoutMs: number;
+  discoveredAt: string;
+  discoveryExpiresAt: string;
+  discoverySha256?: string;
+}
+
+export const DEFAULT_FABLE_5_PROFILE: FableRegistryProfile = {
+  registryVersion: "tokenshop.fable.v1",
+  providerId: "tokenshop",
+  providerAdapter: "openai-compatible",
+  baseUrl: "https://token-shop.online/v1",
+  modelName: "claude-fable-5",
+  contextWindowTokens: 1_000_000,
+  maxOutputTokens: 100_000,
+  fallbackToMock: false,
+  maxAttemptsPerRoute: 1,
+  managerTimeoutMs: 600_000,
+  discoveredAt: "2026-11-02T00:00:00.000Z",
+  discoveryExpiresAt: "2026-11-09T00:00:00.000Z"
+};
+
+/**
+ * Validates the `config/model-registry.tokenshop.fable.v1.json` profile from PR #426
+ * (`KOSMORA_FABLE_LIVE_CONNECTIVITY_2026-11-02_RU.md`), enforcing:
+ * 1. Zero embedded secrets (`apiKey`, `secret`, `token`, `Bearer `).
+ * 2. Discovery validity window check (`discoveryExpiresAt = 2026-11-09T00:00:00.000Z`),
+ *    blocking dispatch when the discovery window has expired (`MODEL_DISCOVERY_EXPIRED_REFRESH_REQUIRED`).
+ * 3. Safe discovery refresh (`refreshFableModelDiscovery`) that extends the 7-day discovery window
+ *    after a verified `/v1/models` response without persisting any API keys.
+ */
+export function validateFableRegistryProfile(
+  profile: FableRegistryProfile,
+  nowIso = new Date().toISOString()
+): { valid: true; remainingValidityMs: number } {
+  const serialized = JSON.stringify(profile);
+  if (/(?:sk-[A-Za-z0-9_-]{12,}|Bearer\s+[A-Za-z0-9._-]+|api_key|apiKey|secret)/i.test(serialized)) {
+    throw new Error("FABLE_REGISTRY_CONTAINS_SECRET_MATERIAL");
+  }
+
+  if (profile.fallbackToMock !== false) {
+    throw new Error("FABLE_MOCK_FALLBACK_MUST_BE_DISABLED");
+  }
+  if (profile.maxAttemptsPerRoute !== 1) {
+    throw new Error("FABLE_MAX_ATTEMPTS_PER_ROUTE_MUST_BE_1");
+  }
+  if (profile.contextWindowTokens > 1_000_000 || profile.maxOutputTokens > 100_000) {
+    throw new Error("FABLE_LIMITS_EXCEED_SPECIFICATION");
+  }
+
+  const nowMs = Date.parse(nowIso);
+  const expiresMs = Date.parse(profile.discoveryExpiresAt);
+  if (!Number.isFinite(expiresMs) || nowMs >= expiresMs) {
+    const err = new Error(
+      `MODEL_DISCOVERY_EXPIRED_REFRESH_REQUIRED: Discovery expired at ${profile.discoveryExpiresAt}`
+    ) as Error & { code?: string };
+    err.code = "MODEL_DISCOVERY_EXPIRED_REFRESH_REQUIRED";
+    throw err;
+  }
+
+  return {
+    valid: true,
+    remainingValidityMs: expiresMs - nowMs
+  };
+}
+
+export function refreshFableModelDiscovery(options: {
+  currentProfile: FableRegistryProfile;
+  upstreamModelsList: Array<{ id: string }>;
+  verifiedAtIso: string;
+  validityDays?: number;
+}): FableRegistryProfile {
+  const found = options.upstreamModelsList.some(
+    (m) => m.id === options.currentProfile.modelName
+  );
+  if (!found) {
+    throw new Error(`FABLE_MODEL_NOT_PRESENT_IN_UPSTREAM_DISCOVERY:${options.currentProfile.modelName}`);
+  }
+
+  const verifiedAtMs = Date.parse(options.verifiedAtIso);
+  const validityDays = Math.min(Math.max(options.validityDays ?? 7, 1), 14);
+  const nextExpiresIso = new Date(verifiedAtMs + validityDays * 86_400_000).toISOString();
+
+  const discoverySha256 = createHash("sha256")
+    .update(
+      JSON.stringify({
+        providerId: options.currentProfile.providerId,
+        baseUrl: options.currentProfile.baseUrl,
+        modelName: options.currentProfile.modelName,
+        verifiedAtIso: options.verifiedAtIso
+      }),
+      "utf8"
+    )
+    .digest("hex");
+
+  return {
+    ...options.currentProfile,
+    discoveredAt: options.verifiedAtIso,
+    discoveryExpiresAt: nextExpiresIso,
+    discoverySha256
+  };
+}
diff --git a/apps/api/src/fable-sse-resilient-stream.ts b/apps/api/src/fable-sse-resilient-stream.ts
new file mode 100644
index 0000000..1be1ca9
--- /dev/null
+++ b/apps/api/src/fable-sse-resilient-stream.ts
@@ -0,0 +1,294 @@
+import { createHash } from "node:crypto";
+
+export interface FableSseEvent {
+  event: string;
+  data: string;
+}
+
+export interface FableSseStreamResult<T = unknown> {
+  status: "completed" | "cancelled" | "truncated_error";
+  rawText: string;
+  unwrappedJsonText: string | null;
+  parsedJson: T | null;
+  inputTokens: number | null;
+  outputTokens: number | null;
+  stopReason: string | null;
+  usageDisposition: "committed" | "uncertain" | "cancelled_after_dispatch";
+  errorCode: string | null;
+  responseSha256: string;
+}
+
+/**
+ * Unwraps at most one outer `<escape>JSON</escape>` envelope (matching PR #426 `parseModelJson`),
+ * rejecting nested `<escape>` tags or malformed JSON.
+ */
+export function unwrapSingleEscapeJsonEnvelope(raw: string): string {
+  const trimmed = String(raw ?? "").trim();
+  if (trimmed.startsWith("<escape>") && trimmed.endsWith("</escape>")) {
+    const inner = trimmed.slice("<escape>".length, trimmed.length - "</escape>".length).trim();
+    if (inner.includes("<escape>") || inner.includes("</escape>")) {
+      throw new Error("NESTED_ESCAPE_ENVELOPE_REJECTED");
+    }
+    return inner;
+  }
+  return trimmed;
+}
+
+/**
+ * Resilient SSE Stream Assembler & Truncation Guard for `claude-fable-5`
+ * (closes the deferred SSE streaming block in PR #426 `KOSMORA_FABLE_LIVE_CONNECTIVITY_2026-11-02_RU.md`
+ * and PR #428 `KOSWORK_REUSABLE_WORKFLOWS_2026-11-02_RU.md`).
+ *
+ * Guarantees:
+ * 1. Handles arbitrary TCP/ReadableStream chunk splits across UTF-8 multi-byte characters and SSE lines.
+ * 2. Immediately halts on cancellation (`signal.aborted` or `isCancelled()`) without attempting to parse
+ *    partial JSON buffers or propagating corrupt state.
+ * 3. Detects premature upstream socket closes (`FABLE_SSE_TRUNCATED_BEFORE_STOP`) when the stream ends
+ *    without an explicit `message_stop` / `[DONE]` completion frame, keeping usage reservation as `uncertain`
+ *    (never silently refunding a dispatched request).
+ */
+export async function consumeFableSseStream<T = Record<string, unknown>>(options: {
+  chunks: AsyncIterable<Buffer | Uint8Array | string> | Iterable<Buffer | Uint8Array | string>;
+  expectJsonStage?: boolean;
+  validateSchema?: (val: unknown) => val is T;
+  isCancelled?: () => boolean;
+  maxBytes?: number;
+}): Promise<FableSseStreamResult<T>> {
+  const maxBytes = options.maxBytes ?? 4 * 1024 * 1024; // 4 MiB stream ceiling
+  const decoder = new TextDecoder("utf-8", { fatal: false });
+
+  let sseBuffer = "";
+  let assembledText = "";
+  let totalBytesReceived = 0;
+  let sawStopEvent = false;
+  let stopReason: string | null = null;
+  let inputTokens: number | null = null;
+  let outputTokens: number | null = null;
+  let currentEventName = "message";
+
+  const processFrame = (frameText: string) => {
+    const lines = frameText.split(/\r?\n/);
+    const dataLines: string[] = [];
+    for (const line of lines) {
+      if (!line || line.startsWith(":")) continue;
+      if (line.startsWith("event:")) {
+        currentEventName = line.slice("event:".length).trim();
+      } else if (line.startsWith("data:")) {
+        dataLines.push(line.slice("data:".length).trim());
+      }
+    }
+    if (dataLines.length === 0) return;
+    const dataPayload = dataLines.join("\n");
+
+    if (dataPayload === "[DONE]") {
+      sawStopEvent = true;
+      if (!stopReason) stopReason = "end_turn";
+      return;
+    }
+
+    let parsed: Record<string, unknown>;
+    try {
+      parsed = JSON.parse(dataPayload) as Record<string, unknown>;
+    } catch {
+      throw new Error("FABLE_SSE_MALFORMED_FRAME_JSON");
+    }
+
+    const type = String(parsed.type ?? currentEventName);
+    if (type === "message_start" && parsed.message && typeof parsed.message === "object") {
+      const usage = (parsed.message as { usage?: { input_tokens?: number; output_tokens?: number } }).usage;
+      if (typeof usage?.input_tokens === "number") inputTokens = usage.input_tokens;
+      if (typeof usage?.output_tokens === "number") outputTokens = usage.output_tokens;
+    } else if (type === "content_block_delta" && parsed.delta && typeof parsed.delta === "object") {
+      const delta = parsed.delta as { type?: string; text?: string };
+      if (typeof delta.text === "string") {
+        assembledText += delta.text;
+      }
+    } else if (type === "message_delta") {
+      const delta = parsed.delta as { stop_reason?: string } | undefined;
+      if (typeof delta?.stop_reason === "string") {
+        stopReason = delta.stop_reason;
+      }
+      const usage = parsed.usage as { output_tokens?: number } | undefined;
+      if (typeof usage?.output_tokens === "number") {
+        outputTokens = usage.output_tokens;
+      }
+    } else if (type === "message_stop") {
+      sawStopEvent = true;
+      if (!stopReason) stopReason = "end_turn";
+    } else if (type === "error") {
+      const errObj = parsed.error as { code?: string; message?: string } | undefined;
+      const err = new Error(errObj?.message || "Upstream Fable SSE error") as Error & { code?: string };
+      err.code = errObj?.code || "FABLE_SSE_UPSTREAM_ERROR";
+      throw err;
+    }
+  };
+
+  try {
+    for await (const chunk of options.chunks) {
+      if (options.isCancelled?.()) {
+        return {
+          status: "cancelled",
+          rawText: assembledText,
+          unwrappedJsonText: null,
+          parsedJson: null,
+          inputTokens,
+          outputTokens,
+          stopReason: null,
+          usageDisposition: "cancelled_after_dispatch",
+          errorCode: "WORK_CANCELLED_DURING_STREAM",
+          responseSha256: createHash("sha256").update(assembledText, "utf8").digest("hex")
+        };
+      }
+
+      const strChunk =
+        typeof chunk === "string"
+          ? chunk
+          : decoder.decode(chunk, { stream: true });
+      totalBytesReceived += Buffer.byteLength(strChunk, "utf8");
+      if (totalBytesReceived > maxBytes) {
+        return {
+          status: "truncated_error",
+          rawText: assembledText,
+          unwrappedJsonText: null,
+          parsedJson: null,
+          inputTokens,
+          outputTokens,
+          stopReason: null,
+          usageDisposition: "uncertain",
+          errorCode: "FABLE_SSE_STREAM_TOO_LARGE",
+          responseSha256: createHash("sha256").update(assembledText, "utf8").digest("hex")
+        };
+      }
+
+      sseBuffer += strChunk;
+      let boundaryIdx: number;
+      while ((boundaryIdx = sseBuffer.search(/\r?\n\r?\n/)) !== -1) {
+        const match = /\r?\n\r?\n/.exec(sseBuffer.slice(boundaryIdx));
+        const sepLen = match ? match[0].length : 2;
+        const frame = sseBuffer.slice(0, boundaryIdx);
+        sseBuffer = sseBuffer.slice(boundaryIdx + sepLen);
+        if (frame.trim()) {
+          processFrame(frame);
+        }
+      }
+    }
+
+    sseBuffer += decoder.decode();
+    if (sseBuffer.trim()) {
+      processFrame(sseBuffer.trim());
+    }
+  } catch (err) {
+    const code =
+      err && typeof err === "object" && "code" in err
+        ? String((err as { code?: unknown }).code)
+        : err instanceof Error
+          ? err.message
+          : "FABLE_SSE_TRANSPORT_ABORTED";
+    return {
+      status: "truncated_error",
+      rawText: assembledText,
+      unwrappedJsonText: null,
+      parsedJson: null,
+      inputTokens,
+      outputTokens,
+      stopReason,
+      usageDisposition: "uncertain",
+      errorCode: code,
+      responseSha256: createHash("sha256").update(assembledText, "utf8").digest("hex")
+    };
+  }
+
+  if (options.isCancelled?.()) {
+    return {
+      status: "cancelled",
+      rawText: assembledText,
+      unwrappedJsonText: null,
+      parsedJson: null,
+      inputTokens,
+      outputTokens,
+      stopReason,
+      usageDisposition: "cancelled_after_dispatch",
+      errorCode: "WORK_CANCELLED_DURING_STREAM",
+      responseSha256: createHash("sha256").update(assembledText, "utf8").digest("hex")
+    };
+  }
+
+  // If the provider dropped the connection before sending message_stop / [DONE], do NOT parse truncated JSON!
+  if (!sawStopEvent || stopReason === "max_tokens") {
+    return {
+      status: "truncated_error",
+      rawText: assembledText,
+      unwrappedJsonText: null,
+      parsedJson: null,
+      inputTokens,
+      outputTokens,
+      stopReason,
+      usageDisposition: "uncertain",
+      errorCode:
+        stopReason === "max_tokens"
+          ? "FABLE_SSE_TRUNCATED_MAX_TOKENS"
+          : "FABLE_SSE_TRUNCATED_BEFORE_STOP",
+      responseSha256: createHash("sha256").update(assembledText, "utf8").digest("hex")
+    };
+  }
+
+  const responseSha256 = createHash("sha256").update(assembledText, "utf8").digest("hex");
+  if (!options.expectJsonStage) {
+    return {
+      status: "completed",
+      rawText: assembledText,
+      unwrappedJsonText: null,
+      parsedJson: null,
+      inputTokens,
+      outputTokens,
+      stopReason,
+      usageDisposition: "committed",
+      errorCode: null,
+      responseSha256
+    };
+  }
+
+  try {
+    const unwrapped = unwrapSingleEscapeJsonEnvelope(assembledText);
+    const parsedJson = JSON.parse(unwrapped) as unknown;
+    if (options.validateSchema && !options.validateSchema(parsedJson)) {
+      return {
+        status: "truncated_error",
+        rawText: assembledText,
+        unwrappedJsonText: unwrapped,
+        parsedJson: null,
+        inputTokens,
+        outputTokens,
+        stopReason,
+        usageDisposition: "committed",
+        errorCode: "FABLE_STAGE_SCHEMA_INVALID",
+        responseSha256
+      };
+    }
+    return {
+      status: "completed",
+      rawText: assembledText,
+      unwrappedJsonText: unwrapped,
+      parsedJson: parsedJson as T,
+      inputTokens,
+      outputTokens,
+      stopReason,
+      usageDisposition: "committed",
+      errorCode: null,
+      responseSha256
+    };
+  } catch (err) {
+    return {
+      status: "truncated_error",
+      rawText: assembledText,
+      unwrappedJsonText: null,
+      parsedJson: null,
+      inputTokens,
+      outputTokens,
+      stopReason,
+      usageDisposition: "committed",
+      errorCode: err instanceof Error ? err.message : "FABLE_JSON_PARSE_FAILED",
+      responseSha256
+    };
+  }
+}
diff --git a/apps/api/src/memory-advanced-compaction-routes.ts b/apps/api/src/memory-advanced-compaction-routes.ts
new file mode 100644
index 0000000..cced6ad
--- /dev/null
+++ b/apps/api/src/memory-advanced-compaction-routes.ts
@@ -0,0 +1,142 @@
+import type { FastifyInstance, FastifyReply, FastifyRequest } from "fastify";
+import type { DatabaseSync } from "node:sqlite";
+import {
+  compactHistoryByTopicsAndChanges,
+  restoreCompactedTopicDetails,
+  type CompactionMessageInput,
+  type TopicCompactionCapsule
+} from "../../../packages/db/src/history-compaction-topic-analyzer.ts";
+import {
+  ProfileCandidateReconciler,
+  type ExtractedProfileCandidate
+} from "../../../packages/db/src/profile-candidate-reconciler.ts";
+import {
+  VpsChatHistoryMigrator,
+  type VpsChatMigrationBundle
+} from "../../../packages/db/src/vps-chat-history-migrator.ts";
+
+export interface RegisterMemoryAdvancedCompactionRoutesOptions {
+  sqlite: DatabaseSync;
+  resolveOwnerId?: (req: FastifyRequest) => string | null;
+}
+
+export async function registerMemoryAdvancedCompactionRoutes(
+  app: FastifyInstance,
+  options: RegisterMemoryAdvancedCompactionRoutesOptions
+): Promise<void> {
+  const reconciler = new ProfileCandidateReconciler(options.sqlite);
+  const vpsMigrator = new VpsChatHistoryMigrator(options.sqlite);
+
+  const getOwner = (req: FastifyRequest, reply: FastifyReply): string | null => {
+    const ownerId =
+      options.resolveOwnerId?.(req) ??
+      (req.headers["x-kosmora-owner-id"] as string | undefined) ??
+      null;
+    if (!ownerId) {
+      reply.code(401).send({ error: "UNAUTHORIZED", message: "Owner session required" });
+      return null;
+    }
+    return ownerId;
+  };
+
+  app.post("/api/context-memory/compaction/topics", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const body = (req.body ?? {}) as {
+      enabled?: boolean;
+      messages?: CompactionMessageInput[];
+      keepRecentCount?: number;
+      maxCapsuleBytes?: number;
+      manualSummaryPresent?: boolean;
+    };
+    const result = compactHistoryByTopicsAndChanges({
+      enabled: body.enabled ?? true,
+      messages: Array.isArray(body.messages) ? body.messages : [],
+      keepRecentCount: body.keepRecentCount,
+      maxCapsuleBytes: body.maxCapsuleBytes,
+      manualSummaryPresent: body.manualSummaryPresent
+    });
+    return reply.code(200).send(result);
+  });
+
+  app.post("/api/context-memory/compaction/restore-details", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const body = (req.body ?? {}) as {
+      chatId?: string;
+      capsule?: TopicCompactionCapsule;
+    };
+    if (!body.chatId || !body.capsule) {
+      return reply.code(400).send({ error: "INVALID_REQUEST", message: "chatId and capsule required" });
+    }
+    const restored = restoreCompactedTopicDetails(
+      options.sqlite,
+      ownerId,
+      body.chatId,
+      body.capsule
+    );
+    return reply.code(200).send({ items: restored });
+  });
+
+  app.post("/api/context-memory/profile-candidates/scan", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const body = (req.body ?? {}) as {
+      permittedChatIds?: string[];
+      permittedProjectIds?: string[];
+    };
+    const report = reconciler.scanAuthorizedChatCandidates(ownerId, {
+      permittedChatIds: body.permittedChatIds,
+      permittedProjectIds: body.permittedProjectIds
+    });
+    return reply.code(200).send(report);
+  });
+
+  app.post("/api/context-memory/profile-candidates/promote", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const body = (req.body ?? {}) as {
+      candidate?: ExtractedProfileCandidate;
+      resolution?: "replace_existing" | "keep_both";
+      pinned?: boolean;
+    };
+    if (!body.candidate) {
+      return reply.code(400).send({ error: "INVALID_REQUEST", message: "candidate required" });
+    }
+    const promoted = reconciler.promoteCandidateToProfile({
+      ownerId,
+      candidate: body.candidate,
+      resolution: body.resolution,
+      pinned: body.pinned
+    });
+    return reply.code(200).send(promoted);
+  });
+
+  app.delete("/api/context-memory/entries/:entryId/with-exception", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const { entryId } = req.params as { entryId: string };
+    const res = reconciler.deleteMemoryWithAutoExtractException(ownerId, entryId);
+    return reply.code(res.deleted ? 200 : 404).send(res);
+  });
+
+  app.get("/api/vps-recovery/chat-bundle", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const query = (req.query ?? {}) as { maxBatchSize?: string };
+    const maxBatchSize = query.maxBatchSize ? Number(query.maxBatchSize) : 150;
+    const bundle = vpsMigrator.exportOwnerHistoryBundle(ownerId, maxBatchSize);
+    return reply.code(200).send(bundle);
+  });
+
+  app.post("/api/vps-recovery/chat-bundle/restore", async (req, reply) => {
+    const ownerId = getOwner(req, reply);
+    if (!ownerId) return;
+    const bundle = req.body as VpsChatMigrationBundle;
+    if (!bundle || bundle.ownerId !== ownerId) {
+      return reply.code(403).send({ error: "OWNER_MISMATCH", message: "Bundle ownerId mismatch" });
+    }
+    const summary = vpsMigrator.restoreOwnerHistoryBundle(bundle);
+    return reply.code(200).send(summary);
+  });
+}
diff --git a/apps/api/src/memory-snapshot-reconciler.ts b/apps/api/src/memory-snapshot-reconciler.ts
new file mode 100644
index 0000000..2f33095
--- /dev/null
+++ b/apps/api/src/memory-snapshot-reconciler.ts
@@ -0,0 +1,711 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+
+export const MAX_SNAPSHOT_RECORDS = 1000;
+export const MAX_SNAPSHOT_SETTINGS = 1000;
+export const MAX_SNAPSHOT_JSON_BYTES = 4 * 1024 * 1024; // 4 MiB hard ceiling (no silent truncation)
+export const DEFAULT_SLICE_LIMIT = 50;
+export const MAX_SLICE_LIMIT = 200;
+
+const FORBIDDEN_SECRET_PATTERN =
+  /(?:password|passwd|session_?token|access_?token|refresh_?token|grant_ciphertext|private_?key|secret_?key|bearer\s+\S+)/i;
+
+export type MemoryScopeKind = "personal" | "chat" | "project";
+
+export interface VaultMemorySourceRef {
+  sourceId: string;
+  title: string;
+  status: "available" | "missing" | "revoked" | "updated";
+  sha256?: string;
+}
+
+export interface VaultMemorySnapshotRecord {
+  id: string;
+  ownerId: string;
+  scope: MemoryScopeKind;
+  scopeId: string | null;
+  recordType: string;
+  key: string;
+  title: string;
+  content: string;
+  version: number;
+  baseServerVersion?: number | null;
+  sha256: string;
+  mandatory?: boolean;
+  expiresAt: string | null;
+  sources: VaultMemorySourceRef[];
+  updatedAt: string;
+}
+
+export interface VaultMemorySettingEntry {
+  key: string;
+  scope: MemoryScopeKind;
+  scopeId: string | null;
+  value: boolean | number | string | null;
+  version: number;
+  updatedAt: string;
+}
+
+export interface VaultMemorySnapshotEnvelope {
+  schemaVersion: 1;
+  ownerId: string;
+  generatedAt: string;
+  records: VaultMemorySnapshotRecord[];
+  settings: VaultMemorySettingEntry[];
+}
+
+export interface AddressableSnapshotSliceQuery {
+  scope?: MemoryScopeKind;
+  scopeId?: string | null;
+  recordType?: string;
+  query?: string;
+  cursor?: number;
+  limit?: number;
+}
+
+export interface AddressableSnapshotSliceResult {
+  snapshotDigest: string;
+  ownerId: string;
+  generatedAt: string;
+  cursor: number;
+  limit: number;
+  nextCursor: number | null;
+  totalRecordsInSnapshot: number;
+  totalMatching: number;
+  truncatedSilently: false;
+  items: VaultMemorySnapshotRecord[];
+  settingsSlice: VaultMemorySettingEntry[];
+}
+
+export type ConflictResolutionAction =
+  | "keep_server"
+  | "replace_with_client"
+  | "fork_as_new_record";
+
+export interface ConflictResolutionDecision {
+  action: ConflictResolutionAction;
+  expectedServerVersion?: number;
+}
+
+export interface MemoryRecordDiffItem {
+  recordId: string;
+  key: string;
+  scope: MemoryScopeKind;
+  scopeId: string | null;
+  status: "unchanged" | "create" | "fast_forward" | "conflict";
+  clientVersion: number;
+  clientSha256: string;
+  serverRecordId: string | null;
+  serverVersion: number | null;
+  serverSha256: string | null;
+  reason?: string;
+}
+
+export interface MemorySnapshotRestorePlan {
+  snapshotDigest: string;
+  ownerId: string;
+  canApplyWithoutDecisions: boolean;
+  counts: {
+    unchanged: number;
+    create: number;
+    fastForward: number;
+    conflict: number;
+  };
+  items: MemoryRecordDiffItem[];
+  conflicts: MemoryRecordDiffItem[];
+}
+
+export interface MemorySnapshotRestoreResult {
+  restored: true;
+  snapshotDigest: string;
+  ownerId: string;
+  appliedCounts: {
+    unchanged: number;
+    created: number;
+    updated: number;
+    forked: number;
+    keptServer: number;
+    settingsUpdated: number;
+  };
+  idMapping: Record<string, string>;
+}
+
+export function computeRecordContentSha256(content: string): string {
+  return createHash("sha256").update(content, "utf8").digest("hex");
+}
+
+export function validateAndParseMemorySnapshot(
+  rawInput: string | VaultMemorySnapshotEnvelope,
+  expectedOwnerId: string
+): { envelope: VaultMemorySnapshotEnvelope; snapshotDigest: string; byteLength: number } {
+  const rawJson = typeof rawInput === "string" ? rawInput : JSON.stringify(rawInput);
+  const byteLength = Buffer.byteLength(rawJson, "utf8");
+  if (byteLength === 0) {
+    throw new Error("SNAPSHOT_EMPTY");
+  }
+  if (byteLength > MAX_SNAPSHOT_JSON_BYTES) {
+    throw new Error("SNAPSHOT_BYTE_LIMIT_EXCEEDED");
+  }
+
+  let parsed: VaultMemorySnapshotEnvelope;
+  try {
+    parsed = (typeof rawInput === "string" ? JSON.parse(rawJson) : rawInput) as VaultMemorySnapshotEnvelope;
+  } catch {
+    throw new Error("SNAPSHOT_INVALID_JSON");
+  }
+
+  if (
+    !parsed ||
+    parsed.schemaVersion !== 1 ||
+    typeof parsed.ownerId !== "string" ||
+    parsed.ownerId !== expectedOwnerId ||
+    !Array.isArray(parsed.records) ||
+    !Array.isArray(parsed.settings)
+  ) {
+    throw new Error("SNAPSHOT_SCHEMA_MISMATCH");
+  }
+
+  if (parsed.records.length > MAX_SNAPSHOT_RECORDS) {
+    throw new Error("SNAPSHOT_RECORD_LIMIT_EXCEEDED");
+  }
+  if (parsed.settings.length > MAX_SNAPSHOT_SETTINGS) {
+    throw new Error("SNAPSHOT_SETTINGS_LIMIT_EXCEEDED");
+  }
+
+  const seenIds = new Set<string>();
+  for (const rec of parsed.records) {
+    if (
+      !rec ||
+      typeof rec.id !== "string" ||
+      !rec.id.trim() ||
+      rec.ownerId !== expectedOwnerId ||
+      !["personal", "chat", "project"].includes(rec.scope) ||
+      typeof rec.key !== "string" ||
+      !rec.key.trim() ||
+      typeof rec.content !== "string" ||
+      !Number.isSafeInteger(rec.version) ||
+      rec.version < 1
+    ) {
+      throw new Error("SNAPSHOT_INVALID_RECORD");
+    }
+    if (FORBIDDEN_SECRET_PATTERN.test(rec.key) || FORBIDDEN_SECRET_PATTERN.test(rec.content)) {
+      throw new Error("SNAPSHOT_SECRET_REJECTED");
+    }
+    const actualSha = computeRecordContentSha256(rec.content);
+    if (typeof rec.sha256 === "string" && rec.sha256.toLowerCase() !== actualSha) {
+      throw new Error(`SNAPSHOT_RECORD_HASH_MISMATCH:${rec.id}`);
+    }
+    if (seenIds.has(rec.id)) {
+      throw new Error(`SNAPSHOT_DUPLICATE_RECORD_ID:${rec.id}`);
+    }
+    seenIds.add(rec.id);
+  }
+
+  for (const setting of parsed.settings) {
+    if (
+      !setting ||
+      typeof setting.key !== "string" ||
+      !setting.key.trim() ||
+      FORBIDDEN_SECRET_PATTERN.test(setting.key) ||
+      (typeof setting.value === "string" && FORBIDDEN_SECRET_PATTERN.test(setting.value))
+    ) {
+      throw new Error("SNAPSHOT_SECRET_REJECTED");
+    }
+  }
+
+  const snapshotDigest = createHash("sha256").update(rawJson, "utf8").digest("hex");
+  return {
+    envelope: parsed,
+    snapshotDigest,
+    byteLength
+  };
+}
+
+/**
+ * Reads an addressable, paginated slice of a validated memory snapshot (up to 1000 records
+ * and 4 MiB JSON) without silently truncating or loading the entire snapshot into context.
+ */
+export function readAddressableSnapshotSlice(
+  rawInput: string | VaultMemorySnapshotEnvelope,
+  expectedOwnerId: string,
+  query: AddressableSnapshotSliceQuery = {}
+): AddressableSnapshotSliceResult {
+  const { envelope, snapshotDigest } = validateAndParseMemorySnapshot(rawInput, expectedOwnerId);
+  const cursor = Number.isSafeInteger(query.cursor) && (query.cursor ?? 0) >= 0 ? query.cursor! : 0;
+  const limit = Math.max(
+    1,
+    Math.min(
+      Number.isSafeInteger(query.limit) && (query.limit ?? 0) > 0
+        ? query.limit!
+        : DEFAULT_SLICE_LIMIT,
+      MAX_SLICE_LIMIT
+    )
+  );
+  const needle = typeof query.query === "string" ? query.query.trim().toLowerCase() : "";
+
+  const filtered = envelope.records.filter((rec) => {
+    if (query.scope && rec.scope !== query.scope) return false;
+    if (query.scopeId !== undefined && rec.scopeId !== query.scopeId) return false;
+    if (query.recordType && rec.recordType !== query.recordType) return false;
+    if (needle) {
+      const hay = `${rec.key}\n${rec.title}\n${rec.content}`.toLowerCase();
+      if (!hay.includes(needle)) return false;
+    }
+    return true;
+  });
+
+  const items = filtered.slice(cursor, cursor + limit);
+  const nextCursor = cursor + items.length < filtered.length ? cursor + items.length : null;
+
+  const settingsSlice = envelope.settings.filter((s) => {
+    if (query.scope && s.scope !== query.scope) return false;
+    if (query.scopeId !== undefined && s.scopeId !== query.scopeId) return false;
+    return true;
+  });
+
+  return {
+    snapshotDigest,
+    ownerId: expectedOwnerId,
+    generatedAt: envelope.generatedAt,
+    cursor,
+    limit,
+    nextCursor,
+    totalRecordsInSnapshot: envelope.records.length,
+    totalMatching: filtered.length,
+    truncatedSilently: false,
+    items,
+    settingsSlice
+  };
+}
+
+interface ServerMemoryRow {
+  id: string;
+  owner_id: string;
+  scope: MemoryScopeKind;
+  scope_id: string | null;
+  record_type: string;
+  key: string;
+  title: string;
+  content: string;
+  version: number;
+  sha256: string;
+  mandatory: number;
+  expires_at: string | null;
+  sources_json: string;
+  updated_at: string;
+}
+
+function assertOwnerReadyForMemoryMutation(db: DatabaseSync, ownerId: string): void {
+  const lifecycle = db
+    .prepare("SELECT state FROM kosmora_owner_data_lifecycle WHERE owner_id=?")
+    .get(ownerId) as { state: string } | undefined;
+  if (lifecycle && lifecycle.state !== "active") {
+    throw new Error("OWNER_DATA_FENCED");
+  }
+
+  // Check if any active model/work/computer run is currently in flight for this owner
+  const hasActiveTable = db
+    .prepare(
+      "SELECT 1 FROM sqlite_master WHERE type='table' AND name='general_chat_runs'"
+    )
+    .get();
+  if (hasActiveTable) {
+    const activeRun = db
+      .prepare(
+        "SELECT 1 FROM general_chat_runs WHERE owner_id=? AND status IN ('queued','running') LIMIT 1"
+      )
+      .get(ownerId);
+    if (activeRun) {
+      throw new Error("MEMORY_RUN_ACTIVE");
+    }
+  }
+}
+
+export function ensureContextMemoryTables(db: DatabaseSync): void {
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS context_memory_records (
+      id TEXT PRIMARY KEY,
+      owner_id TEXT NOT NULL,
+      scope TEXT NOT NULL CHECK(scope IN ('personal','chat','project')),
+      scope_id TEXT,
+      record_type TEXT NOT NULL,
+      key TEXT NOT NULL,
+      title TEXT NOT NULL,
+      content TEXT NOT NULL,
+      version INTEGER NOT NULL DEFAULT 1 CHECK(version >= 1),
+      sha256 TEXT NOT NULL,
+      mandatory INTEGER NOT NULL DEFAULT 0,
+      expires_at TEXT,
+      sources_json TEXT NOT NULL DEFAULT '[]',
+      updated_at TEXT NOT NULL
+    );
+    CREATE INDEX IF NOT EXISTS context_memory_records_owner_scope
+      ON context_memory_records(owner_id, scope, scope_id, key);
+
+    CREATE TABLE IF NOT EXISTS context_memory_settings (
+      owner_id TEXT NOT NULL,
+      scope TEXT NOT NULL CHECK(scope IN ('personal','chat','project')),
+      scope_id TEXT NOT NULL DEFAULT '',
+      key TEXT NOT NULL,
+      value_json TEXT NOT NULL,
+      version INTEGER NOT NULL DEFAULT 1 CHECK(version >= 1),
+      updated_at TEXT NOT NULL,
+      PRIMARY KEY (owner_id, scope, scope_id, key)
+    );
+  `);
+}
+
+export function planMemorySnapshotRestore(
+  db: DatabaseSync,
+  ownerId: string,
+  rawInput: string | VaultMemorySnapshotEnvelope
+): MemorySnapshotRestorePlan {
+  ensureContextMemoryTables(db);
+  const { envelope, snapshotDigest } = validateAndParseMemorySnapshot(rawInput, ownerId);
+
+  const existingRows = db
+    .prepare("SELECT * FROM context_memory_records WHERE owner_id=?")
+    .all(ownerId) as unknown as ServerMemoryRow[];
+
+  const byId = new Map<string, ServerMemoryRow>();
+  const byScopeKey = new Map<string, ServerMemoryRow>();
+  for (const row of existingRows) {
+    byId.set(row.id, row);
+    byScopeKey.set(`${row.scope}:${row.scope_id ?? ""}:${row.key}`, row);
+  }
+
+  const items: MemoryRecordDiffItem[] = [];
+  const conflicts: MemoryRecordDiffItem[] = [];
+  const counts = {
+    unchanged: 0,
+    create: 0,
+    fastForward: 0,
+    conflict: 0
+  };
+
+  for (const rec of envelope.records) {
+    const scopeKey = `${rec.scope}:${rec.scopeId ?? ""}:${rec.key}`;
+    const serverById = byId.get(rec.id);
+    const serverByKey = byScopeKey.get(scopeKey);
+    const serverRow = serverById ?? serverByKey ?? null;
+
+    if (!serverRow) {
+      const diff: MemoryRecordDiffItem = {
+        recordId: rec.id,
+        key: rec.key,
+        scope: rec.scope,
+        scopeId: rec.scopeId,
+        status: "create",
+        clientVersion: rec.version,
+        clientSha256: rec.sha256.toLowerCase(),
+        serverRecordId: null,
+        serverVersion: null,
+        serverSha256: null
+      };
+      counts.create += 1;
+      items.push(diff);
+      continue;
+    }
+
+    const clientSha = rec.sha256.toLowerCase();
+    const serverSha = serverRow.sha256.toLowerCase();
+    const serverVer = Number(serverRow.version);
+
+    if (serverRow.id === rec.id && serverSha === clientSha) {
+      counts.unchanged += 1;
+      items.push({
+        recordId: rec.id,
+        key: rec.key,
+        scope: rec.scope,
+        scopeId: rec.scopeId,
+        status: "unchanged",
+        clientVersion: rec.version,
+        clientSha256: clientSha,
+        serverRecordId: serverRow.id,
+        serverVersion: serverVer,
+        serverSha256: serverSha
+      });
+      continue;
+    }
+
+    // Fast-forward is safe only if same record ID and client explicitly knows the current serverVersion as its baseServerVersion
+    if (
+      serverRow.id === rec.id &&
+      rec.baseServerVersion !== undefined &&
+      rec.baseServerVersion !== null &&
+      rec.baseServerVersion === serverVer &&
+      rec.version > serverVer
+    ) {
+      counts.fastForward += 1;
+      items.push({
+        recordId: rec.id,
+        key: rec.key,
+        scope: rec.scope,
+        scopeId: rec.scopeId,
+        status: "fast_forward",
+        clientVersion: rec.version,
+        clientSha256: clientSha,
+        serverRecordId: serverRow.id,
+        serverVersion: serverVer,
+        serverSha256: serverSha
+      });
+      continue;
+    }
+
+    const conflictItem: MemoryRecordDiffItem = {
+      recordId: rec.id,
+      key: rec.key,
+      scope: rec.scope,
+      scopeId: rec.scopeId,
+      status: "conflict",
+      clientVersion: rec.version,
+      clientSha256: clientSha,
+      serverRecordId: serverRow.id,
+      serverVersion: serverVer,
+      serverSha256: serverSha,
+      reason:
+        serverRow.id !== rec.id
+          ? "KEY_COLLISION_WITH_DIFFERENT_ID"
+          : "SERVER_RECORD_DIVERGED"
+    };
+    counts.conflict += 1;
+    items.push(conflictItem);
+    conflicts.push(conflictItem);
+  }
+
+  return {
+    snapshotDigest,
+    ownerId,
+    canApplyWithoutDecisions: conflicts.length === 0,
+    counts,
+    items,
+    conflicts
+  };
+}
+
+export function executeMemorySnapshotRestore(
+  db: DatabaseSync,
+  ownerId: string,
+  rawInput: string | VaultMemorySnapshotEnvelope,
+  options: {
+    resolutions?: Record<string, ConflictResolutionDecision>;
+    now?: () => string;
+  } = {}
+): MemorySnapshotRestoreResult {
+  ensureContextMemoryTables(db);
+  assertOwnerReadyForMemoryMutation(db, ownerId);
+
+  const { envelope, snapshotDigest } = validateAndParseMemorySnapshot(rawInput, ownerId);
+  const plan = planMemorySnapshotRestore(db, ownerId, envelope);
+  const resolutions = options.resolutions ?? {};
+  const nowIso = options.now ? options.now() : new Date().toISOString();
+
+  // Verify every conflict has an explicit owner decision before beginning transaction
+  for (const conflict of plan.conflicts) {
+    const decision = resolutions[conflict.recordId];
+    if (!decision || !["keep_server", "replace_with_client", "fork_as_new_record"].includes(decision.action)) {
+      throw new Error(`MEMORY_RESTORE_UNRESOLVED_CONFLICT:${conflict.recordId}`);
+    }
+    if (
+      decision.action === "replace_with_client" &&
+      decision.expectedServerVersion !== conflict.serverVersion
+    ) {
+      throw new Error(`MEMORY_VERSION_CONFLICT:${conflict.recordId}`);
+    }
+  }
+
+  const recordById = new Map<string, VaultMemorySnapshotRecord>();
+  for (const r of envelope.records) {
+    recordById.set(r.id, r);
+  }
+
+  const appliedCounts = {
+    unchanged: 0,
+    created: 0,
+    updated: 0,
+    forked: 0,
+    keptServer: 0,
+    settingsUpdated: 0
+  };
+  const idMapping: Record<string, string> = {};
+
+  db.exec("BEGIN IMMEDIATE");
+  try {
+    assertOwnerReadyForMemoryMutation(db, ownerId);
+
+    const insertStmt = db.prepare(`
+      INSERT INTO context_memory_records
+      (id, owner_id, scope, scope_id, record_type, key, title, content, version, sha256, mandatory, expires_at, sources_json, updated_at)
+      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+    `);
+
+    const updateStmt = db.prepare(`
+      UPDATE context_memory_records
+      SET record_type=?, key=?, title=?, content=?, version=version+1, sha256=?, mandatory=?, expires_at=?, sources_json=?, updated_at=?
+      WHERE id=? AND owner_id=? AND version=?
+    `);
+
+    for (const diff of plan.items) {
+      const rec = recordById.get(diff.recordId)!;
+      const sourcesJson = JSON.stringify(rec.sources ?? []);
+      const mandatoryInt = rec.mandatory ? 1 : 0;
+
+      if (diff.status === "unchanged") {
+        appliedCounts.unchanged += 1;
+        idMapping[rec.id] = diff.serverRecordId!;
+        continue;
+      }
+
+      if (diff.status === "create") {
+        insertStmt.run(
+          rec.id,
+          ownerId,
+          rec.scope,
+          rec.scopeId,
+          rec.recordType,
+          rec.key,
+          rec.title,
+          rec.content,
+          rec.version,
+          rec.sha256.toLowerCase(),
+          mandatoryInt,
+          rec.expiresAt,
+          sourcesJson,
+          nowIso
+        );
+        appliedCounts.created += 1;
+        idMapping[rec.id] = rec.id;
+        continue;
+      }
+
+      if (diff.status === "fast_forward") {
+        const res = updateStmt.run(
+          rec.recordType,
+          rec.key,
+          rec.title,
+          rec.content,
+          rec.sha256.toLowerCase(),
+          mandatoryInt,
+          rec.expiresAt,
+          sourcesJson,
+          nowIso,
+          diff.serverRecordId!,
+          ownerId,
+          diff.serverVersion!
+        );
+        if (Number(res.changes) !== 1) {
+          throw new Error(`MEMORY_VERSION_CONFLICT:${rec.id}`);
+        }
+        appliedCounts.updated += 1;
+        idMapping[rec.id] = diff.serverRecordId!;
+        continue;
+      }
+
+      // Conflict handling with explicit owner decision
+      const decision = resolutions[diff.recordId]!;
+      if (decision.action === "keep_server") {
+        appliedCounts.keptServer += 1;
+        idMapping[rec.id] = diff.serverRecordId!;
+      } else if (decision.action === "replace_with_client") {
+        const res = updateStmt.run(
+          rec.recordType,
+          rec.key,
+          rec.title,
+          rec.content,
+          rec.sha256.toLowerCase(),
+          mandatoryInt,
+          rec.expiresAt,
+          sourcesJson,
+          nowIso,
+          diff.serverRecordId!,
+          ownerId,
+          decision.expectedServerVersion!
+        );
+        if (Number(res.changes) !== 1) {
+          throw new Error(`MEMORY_VERSION_CONFLICT:${rec.id}`);
+        }
+        appliedCounts.updated += 1;
+        idMapping[rec.id] = diff.serverRecordId!;
+      } else if (decision.action === "fork_as_new_record") {
+        const forkedId = `mem_fork_${randomUUID()}`;
+        const forkedKey = `${rec.key}:fork:${forkedId.slice(-6)}`;
+        const forkedTitle = rec.title.endsWith(" (копия из снимка)")
+          ? rec.title
+          : `${rec.title} (копия из снимка)`;
+        insertStmt.run(
+          forkedId,
+          ownerId,
+          rec.scope,
+          rec.scopeId,
+          rec.recordType,
+          forkedKey,
+          forkedTitle,
+          rec.content,
+          1,
+          rec.sha256.toLowerCase(),
+          mandatoryInt,
+          rec.expiresAt,
+          sourcesJson,
+          nowIso
+        );
+        appliedCounts.forked += 1;
+        idMapping[rec.id] = forkedId;
+      }
+    }
+
+    // Restore non-conflicting or newer settings
+    for (const setting of envelope.settings) {
+      const scopeIdKey = setting.scopeId ?? "";
+      const existingSetting = db
+        .prepare(
+          "SELECT version FROM context_memory_settings WHERE owner_id=? AND scope=? AND scope_id=? AND key=?"
+        )
+        .get(ownerId, setting.scope, scopeIdKey, setting.key) as { version: number } | undefined;
+
+      if (!existingSetting) {
+        db.prepare(
+          `INSERT INTO context_memory_settings (owner_id, scope, scope_id, key, value_json, version, updated_at)
+           VALUES (?, ?, ?, ?, ?, ?, ?)`
+        ).run(
+          ownerId,
+          setting.scope,
+          scopeIdKey,
+          setting.key,
+          JSON.stringify(setting.value),
+          setting.version,
+          nowIso
+        );
+        appliedCounts.settingsUpdated += 1;
+      } else if (setting.version > Number(existingSetting.version)) {
+        db.prepare(
+          `UPDATE context_memory_settings
+           SET value_json=?, version=?, updated_at=?
+           WHERE owner_id=? AND scope=? AND scope_id=? AND key=? AND version=?`
+        ).run(
+          JSON.stringify(setting.value),
+          setting.version,
+          nowIso,
+          ownerId,
+          setting.scope,
+          scopeIdKey,
+          setting.key,
+          Number(existingSetting.version)
+        );
+        appliedCounts.settingsUpdated += 1;
+      }
+    }
+
+    db.exec("COMMIT");
+  } catch (error) {
+    db.exec("ROLLBACK");
+    throw error;
+  }
+
+  return {
+    restored: true,
+    snapshotDigest,
+    ownerId,
+    appliedCounts,
+    idMapping
+  };
+}
