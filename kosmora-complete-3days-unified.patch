diff --git a/desktop/windows/workspace/interactive-report-bundle-builder.cjs b/desktop/windows/workspace/interactive-report-bundle-builder.cjs
new file mode 100644
index 0000000..4080076
--- /dev/null
+++ b/desktop/windows/workspace/interactive-report-bundle-builder.cjs
@@ -0,0 +1,180 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const crypto = require("node:crypto");
+
+function escapeHtml(str) {
+  return String(str ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+function safeJsonLdSerialize(obj) {
+  return JSON.stringify(obj)
+    .replace(/</g, "\\u003c")
+    .replace(/>/g, "\\u003e")
+    .replace(/&/g, "\\u0026");
+}
+
+/**
+ * Generates an inline SVG bar chart from series data [{ label, value }] without external libraries.
+ */
+function renderInlineSvgChart(chartSpec = {}) {
+  const title = escapeHtml(chartSpec.title || "Telemetry Metric Breakdown");
+  const series = Array.isArray(chartSpec.series) ? chartSpec.series : [];
+  if (series.length === 0) return "";
+
+  const width = 560;
+  const barHeight = 28;
+  const gap = 12;
+  const topPad = 42;
+  const height = topPad + series.length * (barHeight + gap) + 16;
+  const maxVal = Math.max(1, ...series.map((s) => Math.abs(Number(s.value) || 0)));
+
+  const barsSvg = series
+    .map((item, idx) => {
+      const y = topPad + idx * (barHeight + gap);
+      const val = Number(item.value) || 0;
+      const barWidth = Math.max(4, Math.round((Math.abs(val) / maxVal) * 320));
+      const label = escapeHtml(item.label || `Item ${idx + 1}`);
+      const unit = escapeHtml(chartSpec.unit || "");
+      return `
+        <g transform="translate(0, ${y})">
+          <text x="12" y="19" font-family="Segoe UI, system-ui, sans-serif" font-size="13" fill="#1e293b">${label}</text>
+          <rect x="160" y="2" width="${barWidth}" height="24" rx="4" fill="#2563eb" />
+          <text x="${168 + barWidth}" y="19" font-family="Segoe UI, system-ui, sans-serif" font-size="13" font-weight="600" fill="#0f172a">${val}${unit ? " " + unit : ""}</text>
+        </g>`;
+    })
+    .join("\n");
+
+  return `
+    <figure class="koswork-svg-chart" style="margin: 18px 0; padding: 14px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc;">
+      <svg viewBox="0 0 ${width} ${height}" width="100%" height="${height}" role="img" aria-label="${title}">
+        <text x="12" y="24" font-family="Segoe UI, system-ui, sans-serif" font-size="15" font-weight="700" fill="#0f172a">${title}</text>
+        ${barsSvg}
+      </svg>
+    </figure>`;
+}
+
+/**
+ * Compiles a self-contained, CSP-hardened, print-ready interactive HTML5 report bundle
+ * with inline SVG vector charts, formatted LaTeX math blocks, and SHA-256 provenance manifest.
+ */
+function buildInteractiveReportHtml(spec = {}) {
+  const title = escapeHtml(spec.title || "Koswork Interactive Report");
+  const subtitle = escapeHtml(spec.subtitle || "");
+  const sections = Array.isArray(spec.sections) ? spec.sections : [];
+  const sources = Array.isArray(spec.sources) ? spec.sources : [];
+  const generatedAtIso = spec.generatedAtIso || new Date().toISOString();
+
+  const sectionsHtml = sections
+    .map((sec, idx) => {
+      const heading = escapeHtml(sec.heading || `Section ${idx + 1}`);
+      const paragraphs = (Array.isArray(sec.paragraphs) ? sec.paragraphs : [sec.body || ""])
+        .filter(Boolean)
+        .map((p) => `<p>${escapeHtml(p)}</p>`)
+        .join("\n");
+
+      const formulaHtml = sec.latexFormula
+        ? `<div class="koswork-math-block" data-latex="${escapeHtml(sec.latexFormula)}" style="font-family: 'Cambria Math', 'Latin Modern Math', serif; background: #f1f5f9; padding: 10px 14px; border-left: 4px solid #3b82f6; margin: 12px 0; font-style: italic;">${escapeHtml(sec.latexFormula)}</div>`
+        : "";
+
+      const chartHtml = sec.chart ? renderInlineSvgChart(sec.chart) : "";
+
+      return `
+        <section id="section-${idx + 1}" style="margin-bottom: 28px;">
+          <h2 style="font-size: 1.25rem; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px;">${heading}</h2>
+          ${paragraphs}
+          ${formulaHtml}
+          ${chartHtml}
+        </section>`;
+    })
+    .join("\n");
+
+  const sourcesHtml =
+    sources.length > 0
+      ? `<section id="verified-sources" style="margin-top: 32px; border-top: 2px solid #cbd5e1; padding-top: 16px;">
+          <h2 style="font-size: 1.15rem; color: #0f172a;">Verified Citations &amp; Provenance</h2>
+          <ul>
+            ${sources
+              .map(
+                (s) =>
+                  `<li><a href="${escapeHtml(s.url)}" rel="noopener noreferrer">${escapeHtml(s.title || s.url)}</a></li>`
+              )
+              .join("\n")}
+          </ul>
+        </section>`
+      : "";
+
+  const provenancePayload = JSON.stringify({
+    title: spec.title || "Koswork Interactive Report",
+    generatedAtIso,
+    sectionCount: sections.length,
+    sourceCount: sources.length
+  });
+  const provenanceSha256 = crypto.createHash("sha256").update(provenancePayload, "utf8").digest("hex");
+
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8" />
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:;" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>${title}</title>
+  <style>
+    body { font-family: "Segoe UI", system-ui, -apple-system, sans-serif; color: #1e293b; max-width: 860px; margin: 32px auto; padding: 0 24px; line-height: 1.6; }
+    header { margin-bottom: 28px; border-bottom: 2px solid #0f172a; padding-bottom: 12px; }
+    h1 { margin: 0 0 6px 0; font-size: 1.75rem; color: #0f172a; }
+    .subtitle { color: #475569; font-size: 1rem; margin: 0; }
+    @media print { body { margin: 0; max-width: 100%; } }
+  </style>
+  <script type="application/ld+json" id="koswork-provenance-manifest">
+${safeJsonLdSerialize({ "@context": "https://schema.org", "@type": "Report", name: spec.title || "Koswork Interactive Report", dateCreated: generatedAtIso, sha256: provenanceSha256 })}
+  </script>
+</head>
+<body>
+  <header>
+    <h1>${title}</h1>
+    ${subtitle ? `<p class="subtitle">${subtitle}</p>` : ""}
+  </header>
+  <main>
+    ${sectionsHtml}
+    ${sourcesHtml}
+  </main>
+</body>
+</html>`;
+}
+
+function saveInteractiveReportToWorkspace(workspaceDir, filename, spec) {
+  if (!workspaceDir || typeof workspaceDir !== "string") {
+    throw new Error("WORKSPACE_REQUIRED: workspaceDir must be a valid path");
+  }
+  const safeBase = path.basename(filename || "report.html").replace(/[^a-zA-Z0-9._-]/g, "_");
+  const finalName = safeBase.endsWith(".html") ? safeBase : `${safeBase}.html`;
+  const resolvedWorkspace = path.resolve(workspaceDir);
+  const targetPath = path.resolve(resolvedWorkspace, finalName);
+
+  if (!targetPath.startsWith(resolvedWorkspace + path.sep)) {
+    throw new Error("PATH_TRAVERSAL_BLOCKED: output file must reside inside workspaceDir");
+  }
+
+  fs.mkdirSync(resolvedWorkspace, { recursive: true });
+  const html = buildInteractiveReportHtml(spec);
+  fs.writeFileSync(targetPath, html, "utf8");
+
+  return {
+    filePath: targetPath,
+    byteLength: Buffer.byteLength(html, "utf8"),
+    sha256: crypto.createHash("sha256").update(html, "utf8").digest("hex")
+  };
+}
+
+module.exports = {
+  renderInlineSvgChart,
+  buildInteractiveReportHtml,
+  saveInteractiveReportToWorkspace
+};
diff --git a/desktop/windows/workspace/path-guard.cjs b/desktop/windows/workspace/path-guard.cjs
new file mode 100644
index 0000000..1fa8e21
--- /dev/null
+++ b/desktop/windows/workspace/path-guard.cjs
@@ -0,0 +1,464 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const { ERROR_CODES, KosworkWorkspaceError, throwIfAborted } = require("./errors.cjs");
+
+const RESERVED_WINDOWS_NAMES = /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\..*)?$/i;
+const PROTECTED_TOP_SEGMENTS = new Set([".koswork-backups", ".git"]);
+const DEFAULT_IGNORED_DIRS = new Set([".koswork-backups", ".git", "node_modules"]);
+const SENSITIVE_FILENAME_PATTERNS = [
+  /^\.env(?:\..+)?$/i,
+  /^id_(?:rsa|ed25519|ecdsa|dsa)(?:\.pub)?$/i,
+  /\.(?:pem|key|pfx|p12|kdbx)$/i
+];
+
+function isCaseInsensitivePlatform(platform = process.platform) {
+  return platform === "win32" || platform === "darwin";
+}
+
+function normalizeForComparison(targetPath, platform = process.platform) {
+  const resolved = path.resolve(targetPath).normalize("NFKC");
+  return isCaseInsensitivePlatform(platform) ? resolved.toLowerCase() : resolved;
+}
+
+function isPathInsideOrEqual(rootPath, candidatePath, platform = process.platform) {
+  const normRoot = normalizeForComparison(rootPath, platform);
+  const normCandidate = normalizeForComparison(candidatePath, platform);
+  if (normRoot === normCandidate) return true;
+  const rel = path.relative(normRoot, normCandidate);
+  return Boolean(rel) && !rel.startsWith("..") && !path.isAbsolute(rel);
+}
+
+function isPathStrictlyInside(rootPath, candidatePath, platform = process.platform) {
+  const normRoot = normalizeForComparison(rootPath, platform);
+  const normCandidate = normalizeForComparison(candidatePath, platform);
+  if (normRoot === normCandidate) return false;
+  const rel = path.relative(normRoot, normCandidate);
+  return Boolean(rel) && !rel.startsWith("..") && !path.isAbsolute(rel);
+}
+
+function isForbiddenSystemRoot(candidatePath, { userDataPath = null, platform = process.platform } = {}) {
+  const resolved = path.resolve(candidatePath);
+  const parsed = path.parse(resolved);
+  if (parsed.root === resolved) {
+    return "Корень диска не может быть подключён как рабочая папка.";
+  }
+
+  const normalized = resolved.replace(/\\/g, "/").toLowerCase();
+  const forbiddenPosixExact = new Set([
+    "/",
+    "/bin",
+    "/boot",
+    "/dev",
+    "/etc",
+    "/lib",
+    "/lib64",
+    "/proc",
+    "/root",
+    "/run",
+    "/sbin",
+    "/sys",
+    "/usr",
+    "/var",
+    "/private",
+    "/private/etc",
+    "/system",
+    "/users",
+    "/home"
+  ]);
+  if (forbiddenPosixExact.has(normalized)) {
+    return "Системный каталог ОС не может быть подключён как рабочая папка.";
+  }
+  for (const prefix of ["/proc/", "/sys/", "/dev/", "/etc/", "/boot/"]) {
+    if (normalized.startsWith(prefix)) {
+      return "Системный каталог ОС не может быть подключён как рабочая папка.";
+    }
+  }
+
+  if (/^[a-z]:\/(?:windows|program files|program files \(x86\)|programdata|recovery|\$recycle\.bin|system volume information)(?:\/|$)/i.test(normalized)) {
+    return "Системный каталог Windows не может быть подключён как рабочая папка.";
+  }
+  if (/^[a-z]:\/users$/i.test(normalized)) {
+    return "Общий каталог пользователей Windows не может быть подключён целиком.";
+  }
+
+  if (userDataPath) {
+    const resolvedUserData = path.resolve(userDataPath);
+    if (
+      isPathInsideOrEqual(resolvedUserData, resolved, platform) ||
+      isPathInsideOrEqual(resolved, resolvedUserData, platform)
+    ) {
+      return "Каталог профиля приложения Kosmora не может использоваться как рабочая папка или перекрывать её.";
+    }
+  }
+
+  return null;
+}
+
+function validateRelativePath(
+  rawRelativePath,
+  { allowEmpty = false, allowProtected = false } = {}
+) {
+  if (typeof rawRelativePath !== "string") {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+      "Относительный путь должен быть строкой."
+    );
+  }
+  if (rawRelativePath.length > 512) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+      "Относительный путь превышает максимальную длину 512 символов."
+    );
+  }
+  for (let i = 0; i < rawRelativePath.length; i += 1) {
+    const code = rawRelativePath.charCodeAt(i);
+    if (code <= 0x1f || code === 0x7f) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+        "Путь содержит управляющие или нулевые символы."
+      );
+    }
+  }
+  if (rawRelativePath.includes(":")) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+      "Использование букв дисков и потоков NTFS ADS (':') запрещено."
+    );
+  }
+
+  const normalizedInput = rawRelativePath.replace(/\\/g, "/");
+  if (normalizedInput.startsWith("/")) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+      "Абсолютные пути и UNC-пути внутри рабочей папки запрещены."
+    );
+  }
+
+  if (normalizedInput === "" || normalizedInput === ".") {
+    if (allowEmpty) return { relativePath: "", segments: [] };
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_INVALID_ARGUMENT,
+      "Укажите непустой относительный путь внутри рабочей папки."
+    );
+  }
+
+  const rawSegments = normalizedInput.split("/");
+  if (rawSegments.some((seg) => seg.length === 0)) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+      "Путь не должен содержать пустых сегментов или двойных слешей."
+    );
+  }
+
+  const cleanSegments = [];
+  for (let i = 0; i < rawSegments.length; i += 1) {
+    const seg = rawSegments[i].normalize("NFKC");
+    if (seg === "." || seg === "..") {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+        "Переход за пределы каталога ('..' или '.') запрещён."
+      );
+    }
+    if (seg.length > 180) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+        "Имя файла или папки превышает 180 символов."
+      );
+    }
+    if (/[<>:"|?*]/.test(seg) || /[ .]$/.test(seg)) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+        `Недопустимое имя сегмента пути: "${seg}".`
+      );
+    }
+    if (RESERVED_WINDOWS_NAMES.test(seg)) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+        `Зарезервированное системное имя устройства Windows запрещено: "${seg}".`
+      );
+    }
+    if (!allowProtected && PROTECTED_TOP_SEGMENTS.has(seg.toLowerCase())) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_PROTECTED_PATH,
+        `Доступ к служебному каталогу "${seg}" заблокирован политикой рабочей папки.`
+      );
+    }
+    cleanSegments.push(seg);
+  }
+
+  return {
+    relativePath: cleanSegments.join("/"),
+    segments: cleanSegments
+  };
+}
+
+function isSensitiveFilename(name) {
+  return SENSITIVE_FILENAME_PATTERNS.some((pattern) => pattern.test(name));
+}
+
+function assertNotReparseOrSymlink(targetPath, lstatResult) {
+  if (lstatResult.isSymbolicLink()) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+      "Символические ссылки и Windows junction запрещены в рабочей папке.",
+      { path: path.basename(targetPath) }
+    );
+  }
+  const parentDir = path.dirname(targetPath);
+  let realParent;
+  let realTarget;
+  try {
+    realParent = fs.realpathSync.native ? fs.realpathSync.native(parentDir) : fs.realpathSync(parentDir);
+    realTarget = fs.realpathSync.native ? fs.realpathSync.native(targetPath) : fs.realpathSync(targetPath);
+  } catch (error) {
+    if (error && error.code === "ENOENT") {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+        "Обнаружена битая ссылка или недопустимая точка перенаправления (junction).",
+        { path: path.basename(targetPath) }
+      );
+    }
+    throw error;
+  }
+  const expectedChild = path.join(realParent, path.basename(realTarget));
+  if (normalizeForComparison(realParent) !== normalizeForComparison(path.dirname(realTarget)) ||
+      normalizeForComparison(expectedChild) !== normalizeForComparison(realTarget)) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+      "Путь указывает на junction, точку монтирования или символическую ссылку.",
+      { path: path.basename(targetPath) }
+    );
+  }
+  return realTarget;
+}
+
+function inspectRootDirectory(rawRootPath, { userDataPath = null } = {}) {
+  if (typeof rawRootPath !== "string" || rawRootPath.trim() === "") {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_UNSAFE_ROOT,
+      "Укажите абсолютный путь к рабочей папке."
+    );
+  }
+  for (let i = 0; i < rawRootPath.length; i += 1) {
+    const code = rawRootPath.charCodeAt(i);
+    if (code <= 0x1f || code === 0x7f) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_UNSAFE_ROOT,
+        "Путь к рабочей папке содержит недопустимые управляющие символы."
+      );
+    }
+  }
+  if (!path.isAbsolute(rawRootPath)) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_UNSAFE_ROOT,
+      "Рабочая папка должна задаваться абсолютным путём."
+    );
+  }
+
+  const resolved = path.resolve(rawRootPath);
+  const initialForbidden = isForbiddenSystemRoot(resolved, { userDataPath });
+  if (initialForbidden) {
+    throw new KosworkWorkspaceError(ERROR_CODES.WORKSPACE_UNSAFE_ROOT, initialForbidden);
+  }
+
+  let lstat;
+  try {
+    lstat = fs.lstatSync(resolved);
+  } catch (error) {
+    if (error && error.code === "ENOENT") {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_NOT_FOUND,
+        "Выбранная рабочая папка не существует."
+      );
+    }
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_UNSAFE_ROOT,
+      "Не удалось проверить выбранную рабочая папку."
+    );
+  }
+
+  const realRoot = assertNotReparseOrSymlink(resolved, lstat);
+  if (!lstat.isDirectory()) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_NOT_A_DIRECTORY,
+      "Выбранный путь не является папкой."
+    );
+  }
+
+  // Also ensure no ancestor component of resolved is a symlink/junction unless OS root alias.
+  // Specifically, verify resolved itself was not reached through a workspace symlink.
+  if (normalizeForComparison(resolved) !== normalizeForComparison(realRoot)) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+      "Путь к рабочей папке проходит через символическую ссылку или junction."
+    );
+  }
+
+  const realForbidden = isForbiddenSystemRoot(realRoot, { userDataPath });
+  if (realForbidden) {
+    throw new KosworkWorkspaceError(ERROR_CODES.WORKSPACE_UNSAFE_ROOT, realForbidden);
+  }
+
+  return {
+    canonicalRoot: realRoot,
+    rootName: path.basename(realRoot)
+  };
+}
+
+function resolveSafeWorkspaceTarget(
+  canonicalRoot,
+  rawRelativePath,
+  {
+    allowEmpty = false,
+    mustExist = false,
+    allowMissingLeaf = false,
+    allowMissingParents = false,
+    allowProtected = false,
+    blockSensitiveFiles = true,
+    signal = null,
+    activeController = null
+  } = {}
+) {
+  throwIfAborted(signal, activeController);
+
+  // Re-verify root still exists, is a directory, and was not swapped for a symlink/junction.
+  let rootLstat;
+  try {
+    rootLstat = fs.lstatSync(canonicalRoot);
+  } catch {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_NOT_CONNECTED,
+      "Рабочая папка больше недоступна на диске."
+    );
+  }
+  const currentRealRoot = assertNotReparseOrSymlink(canonicalRoot, rootLstat);
+  if (!rootLstat.isDirectory() || normalizeForComparison(currentRealRoot) !== normalizeForComparison(canonicalRoot)) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+      "Корень рабочей папки был подменён или изменён."
+    );
+  }
+
+  const { relativePath, segments } = validateRelativePath(rawRelativePath, {
+    allowEmpty,
+    allowProtected
+  });
+
+  if (segments.length === 0) {
+    return {
+      absolutePath: canonicalRoot,
+      relativePath: "",
+      segments: [],
+      exists: true,
+      stat: rootLstat
+    };
+  }
+
+  if (blockSensitiveFiles && isSensitiveFilename(segments[segments.length - 1])) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_PROTECTED_PATH,
+      `Файл "${segments[segments.length - 1]}" относится к защищённым секретам/ключам и не доступен для операций Koswork.`
+    );
+  }
+
+  let currentAbs = canonicalRoot;
+  let finalStat = null;
+  let exists = true;
+
+  for (let i = 0; i < segments.length; i += 1) {
+    throwIfAborted(signal, activeController);
+    const segment = segments[i];
+    const isLast = i === segments.length - 1;
+    currentAbs = path.join(currentAbs, segment);
+
+    if (!isPathStrictlyInside(canonicalRoot, currentAbs)) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_PATH_TRAVERSAL,
+        "Путь выходит за пределы подключённой рабочей папки."
+      );
+    }
+
+    if (!exists) {
+      if (!allowMissingParents) {
+        throw new KosworkWorkspaceError(
+          ERROR_CODES.WORKSPACE_NOT_FOUND,
+          "Родительская папка не существует."
+        );
+      }
+      continue;
+    }
+
+    let segStat;
+    try {
+      segStat = fs.lstatSync(currentAbs);
+    } catch (error) {
+      if (error && error.code === "ENOENT") {
+        exists = false;
+        if (mustExist) {
+          throw new KosworkWorkspaceError(
+            ERROR_CODES.WORKSPACE_NOT_FOUND,
+            `Путь "${relativePath}" не найден в рабочей папке.`
+          );
+        }
+        if (!isLast && !allowMissingParents) {
+          throw new KosworkWorkspaceError(
+            ERROR_CODES.WORKSPACE_NOT_FOUND,
+            `Родительская папка "${segments.slice(0, i + 1).join("/")}" не найдена.`
+          );
+        }
+        if (isLast && !allowMissingLeaf && !allowMissingParents) {
+          throw new KosworkWorkspaceError(
+            ERROR_CODES.WORKSPACE_NOT_FOUND,
+            `Целевой путь "${relativePath}" не существует.`
+          );
+        }
+        continue;
+      }
+      throw error;
+    }
+
+    const realSegPath = assertNotReparseOrSymlink(currentAbs, segStat);
+    if (!isPathStrictlyInside(canonicalRoot, realSegPath)) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+        "Реальный путь сегмента выходит за границы рабочей папки."
+      );
+    }
+
+    if (!isLast && !segStat.isDirectory()) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_NOT_A_DIRECTORY,
+        `Сегмент "${segments.slice(0, i + 1).join("/")}" является файлом, а не папкой.`
+      );
+    }
+
+    if (isLast) {
+      finalStat = segStat;
+    }
+  }
+
+  return {
+    absolutePath: currentAbs,
+    relativePath,
+    segments,
+    exists,
+    stat: finalStat
+  };
+}
+
+module.exports = {
+  DEFAULT_IGNORED_DIRS,
+  PROTECTED_TOP_SEGMENTS,
+  RESERVED_WINDOWS_NAMES,
+  assertNotReparseOrSymlink,
+  inspectRootDirectory,
+  isForbiddenSystemRoot,
+  isPathInsideOrEqual,
+  isPathStrictlyInside,
+  isSensitiveFilename,
+  normalizeForComparison,
+  resolveSafeWorkspaceTarget,
+  validateRelativePath
+};
diff --git a/desktop/windows/workspace/pdf-report-builder.cjs b/desktop/windows/workspace/pdf-report-builder.cjs
new file mode 100644
index 0000000..bfc9f87
--- /dev/null
+++ b/desktop/windows/workspace/pdf-report-builder.cjs
@@ -0,0 +1,174 @@
+"use strict";
+/**
+ * Kosmora / Koswork Zero-Dependency Native PDF 1.4 Report Builder (Wave 21)
+ *
+ * Generates standard-compliant multi-page PDF 1.4 documents (`%PDF-1.4`) directly inside
+ * the user's connected Koswork workspace folder:
+ * - Builds `/Catalog`, `/Pages`, `/Page`, `/Font` (Helvetica / Helvetica-Bold), and `BT ... ET`
+ *   content streams with exact byte-offset `xref` tables and `trailer`.
+ * - Compatible with `vault-document-extractor.cjs` (`extractPdfText`) for round-trip extraction.
+ * - Enforces path-guard sandboxing inside the connected workspace directory.
+ */
+
+const fs = require("node:fs");
+const path = require("node:path");
+const crypto = require("node:crypto");
+const pathGuard = require("./path-guard.cjs");
+
+function escapePdfLiteral(str) {
+  return String(str ?? "")
+    .replace(/\\/g, "\\\\")
+    .replace(/\(/g, "\\(")
+    .replace(/\)/g, "\\)")
+    .replace(/\r?\n/g, " ");
+}
+
+/**
+ * Builds a valid multi-page PDF 1.4 Buffer from a specification:
+ * `{ title: "Report Title", pages: [{ heading: "Section 1", lines: ["Line A", "Line B"] }] }`
+ */
+function buildPdfReportBuffer(spec) {
+  const title = String(spec?.title || "Kosmora Executive Report");
+  const rawPages =
+    Array.isArray(spec?.pages) && spec.pages.length > 0
+      ? spec.pages
+      : [{ heading: title, lines: Array.isArray(spec?.lines) ? spec.lines : [] }];
+
+  // Object allocation:
+  // 1: Catalog
+  // 2: Pages
+  // 3: Font F1 (Helvetica)
+  // 4: Font F2 (Helvetica-Bold)
+  // For each page i (0..N-1):
+  //   pageObjId = 5 + i * 2
+  //   contentObjId = 6 + i * 2
+  const objects = new Map();
+
+  objects.set(1, "<< /Type /Catalog /Pages 2 0 R >>");
+  objects.set(3, "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>");
+  objects.set(4, "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>");
+
+  const pageKids = [];
+
+  for (let i = 0; i < rawPages.length; i++) {
+    const pageSpec = rawPages[i];
+    const pageObjId = 5 + i * 2;
+    const contentObjId = 6 + i * 2;
+    pageKids.push(`${pageObjId} 0 R`);
+
+    const streamLines = [];
+    streamLines.push("BT");
+    let y = 750;
+
+    if (i === 0 && title) {
+      streamLines.push(`/F2 18 Tf`);
+      streamLines.push(`50 ${y} Td`);
+      streamLines.push(`(${escapePdfLiteral(title)}) Tj`);
+      y -= 30;
+    } else {
+      streamLines.push(`50 ${y} Td`);
+    }
+
+    if (pageSpec.heading && pageSpec.heading !== title) {
+      streamLines.push(`/F2 14 Tf`);
+      streamLines.push(`0 -24 Td`);
+      streamLines.push(`(${escapePdfLiteral(pageSpec.heading)}) Tj`);
+    }
+
+    streamLines.push(`/F1 11 Tf`);
+    const lines = Array.isArray(pageSpec.lines) ? pageSpec.lines : [];
+    for (const line of lines) {
+      streamLines.push(`0 -18 Td`);
+      streamLines.push(`(${escapePdfLiteral(line)}) Tj`);
+    }
+
+    streamLines.push("ET");
+    const streamBody = streamLines.join("\n");
+    const streamByteLen = Buffer.byteLength(streamBody, "latin1");
+
+    objects.set(
+      pageObjId,
+      `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents ${contentObjId} 0 R >>`
+    );
+    objects.set(
+      contentObjId,
+      `<< /Length ${streamByteLen} >>\nstream\n${streamBody}\nendstream`
+    );
+  }
+
+  objects.set(
+    2,
+    `<< /Type /Pages /Kids [${pageKids.join(" ")}] /Count ${rawPages.length} >>`
+  );
+
+  const totalObjCount = 4 + rawPages.length * 2;
+  const parts = [];
+  const offsets = new Map();
+  let currentOffset = 0;
+
+  const pushStr = (s) => {
+    const buf = Buffer.from(s, "latin1");
+    parts.push(buf);
+    currentOffset += buf.length;
+  };
+
+  pushStr("%PDF-1.4\n");
+
+  for (let objId = 1; objId <= totalObjCount; objId++) {
+    offsets.set(objId, currentOffset);
+    const body = objects.get(objId);
+    pushStr(`${objId} 0 obj\n${body}\nendobj\n`);
+  }
+
+  const xrefOffset = currentOffset;
+  pushStr(`xref\n0 ${totalObjCount + 1}\n`);
+  pushStr(`0000000000 65535 f \n`);
+  for (let objId = 1; objId <= totalObjCount; objId++) {
+    const off = String(offsets.get(objId)).padStart(10, "0");
+    pushStr(`${off} 00000 n \n`);
+  }
+
+  pushStr(
+    `trailer\n<< /Size ${totalObjCount + 1} /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF\n`
+  );
+
+  return Buffer.concat(parts);
+}
+
+/**
+ * Writes a native PDF 1.4 report safely into the connected Koswork workspace folder.
+ */
+function savePdfReportToWorkspace(options) {
+  const workspaceRoot = options.workspaceRoot;
+  const relativePath = String(options.relativePath || "Koswork-Report.pdf");
+
+  if (!relativePath.toLowerCase().endsWith(".pdf")) {
+    throw new Error("INVALID_PDF_EXTENSION: Report filename must end with .pdf");
+  }
+
+  const { canonicalRoot } = pathGuard.inspectRootDirectory(workspaceRoot);
+  const resolvedTarget = pathGuard.resolveSafeWorkspaceTarget(canonicalRoot, relativePath, {
+    allowMissingLeaf: true,
+    allowMissingParents: true
+  }).absolutePath;
+
+  const pdfBuf = buildPdfReportBuffer(options.pdfSpec || {});
+  const sha256 = crypto.createHash("sha256").update(pdfBuf).digest("hex");
+
+  fs.mkdirSync(path.dirname(resolvedTarget), { recursive: true });
+  fs.writeFileSync(resolvedTarget, pdfBuf);
+
+  return {
+    saved: true,
+    format: "pdf",
+    relativePath,
+    absolutePath: resolvedTarget,
+    sizeBytes: pdfBuf.length,
+    sha256
+  };
+}
+
+module.exports = {
+  buildPdfReportBuffer,
+  savePdfReportToWorkspace
+};
diff --git a/desktop/windows/workspace/powerpoint-deck-builder.cjs b/desktop/windows/workspace/powerpoint-deck-builder.cjs
new file mode 100644
index 0000000..5edd7c9
--- /dev/null
+++ b/desktop/windows/workspace/powerpoint-deck-builder.cjs
@@ -0,0 +1,251 @@
+"use strict";
+/**
+ * Kosmora / Koswork Zero-Dependency OpenXML PowerPoint (.pptx) Deck Builder (Wave 20)
+ *
+ * Generates standard-compliant OpenXML `.pptx` presentations directly inside the
+ * user's connected Koswork workspace folder:
+ * - Multi-slide support (`ppt/presentation.xml`, `ppt/slides/slide1.xml`, ...)
+ * - Slide titles, subtitles, bullet points, and speaker notes
+ * - Compatible with `vault-document-extractor.cjs` for round-trip extraction verification
+ * - Enforces path-guard sandboxing inside the connected workspace directory
+ */
+
+const fs = require("node:fs");
+const path = require("node:path");
+const zlib = require("node:zlib");
+const crypto = require("node:crypto");
+const pathGuard = require("./path-guard.cjs");
+
+function escapeXml(str) {
+  return String(str ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&apos;");
+}
+
+function crc32(buf) {
+  let c = 0xffffffff;
+  for (let i = 0; i < buf.length; i++) {
+    c ^= buf[i];
+    for (let k = 0; k < 8; k++) {
+      c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
+    }
+  }
+  return (c ^ 0xffffffff) >>> 0;
+}
+
+function buildZipBuffer(entries) {
+  const localParts = [];
+  const centralParts = [];
+  let offset = 0;
+
+  for (const entry of entries) {
+    const nameBuf = Buffer.from(entry.name, "utf8");
+    const rawBuf = Buffer.isBuffer(entry.data) ? entry.data : Buffer.from(entry.data, "utf8");
+    const compressed = zlib.deflateRawSync(rawBuf);
+    const crc = crc32(rawBuf);
+
+    const localHeader = Buffer.alloc(30 + nameBuf.length);
+    localHeader.writeUInt32LE(0x04034b50, 0);
+    localHeader.writeUInt16LE(20, 4);
+    localHeader.writeUInt16LE(0, 6);
+    localHeader.writeUInt16LE(8, 8);
+    localHeader.writeUInt16LE(0, 10);
+    localHeader.writeUInt16LE(0, 12);
+    localHeader.writeUInt32LE(crc, 14);
+    localHeader.writeUInt32LE(compressed.length, 18);
+    localHeader.writeUInt32LE(rawBuf.length, 22);
+    localHeader.writeUInt16LE(nameBuf.length, 26);
+    localHeader.writeUInt16LE(0, 28);
+    nameBuf.copy(localHeader, 30);
+
+    localParts.push(localHeader, compressed);
+
+    const centralHeader = Buffer.alloc(46 + nameBuf.length);
+    centralHeader.writeUInt32LE(0x02014b50, 0);
+    centralHeader.writeUInt16LE(20, 4);
+    centralHeader.writeUInt16LE(20, 6);
+    centralHeader.writeUInt16LE(0, 8);
+    centralHeader.writeUInt16LE(8, 10);
+    centralHeader.writeUInt16LE(0, 12);
+    centralHeader.writeUInt16LE(0, 14);
+    centralHeader.writeUInt32LE(crc, 16);
+    centralHeader.writeUInt32LE(compressed.length, 20);
+    centralHeader.writeUInt32LE(rawBuf.length, 24);
+    centralHeader.writeUInt16LE(nameBuf.length, 28);
+    centralHeader.writeUInt16LE(0, 30);
+    centralHeader.writeUInt16LE(0, 32);
+    centralHeader.writeUInt16LE(0, 34);
+    centralHeader.writeUInt16LE(0, 36);
+    centralHeader.writeUInt32LE(0, 38);
+    centralHeader.writeUInt32LE(offset, 42);
+    nameBuf.copy(centralHeader, 46);
+
+    centralParts.push(centralHeader);
+    offset += localHeader.length + compressed.length;
+  }
+
+  const centralDirSize = centralParts.reduce((acc, b) => acc + b.length, 0);
+  const eocd = Buffer.alloc(22);
+  eocd.writeUInt32LE(0x06054b50, 0);
+  eocd.writeUInt16LE(0, 4);
+  eocd.writeUInt16LE(0, 6);
+  eocd.writeUInt16LE(entries.length, 8);
+  eocd.writeUInt16LE(entries.length, 10);
+  eocd.writeUInt32LE(centralDirSize, 12);
+  eocd.writeUInt32LE(offset, 16);
+  eocd.writeUInt16LE(0, 20);
+
+  return Buffer.concat([...localParts, ...centralParts, eocd]);
+}
+
+/**
+ * Builds an OpenXML `.pptx` buffer from a presentation spec:
+ * `{ title: "Deck", slides: [{ title: "Slide 1", subtitle: "...", bullets: ["Item A", "Item B"] }] }`
+ */
+function buildPowerPointPptxBuffer(spec) {
+  const rawSlides =
+    Array.isArray(spec?.slides) && spec.slides.length > 0
+      ? spec.slides
+      : [{ title: spec?.title || "Презентация Koswork", bullets: [] }];
+
+  const zipEntries = [];
+  const slideContentTypeOverrides = [];
+  const sldIdTags = [];
+  const presRelsTags = [];
+
+  for (let i = 0; i < rawSlides.length; i++) {
+    const slide = rawSlides[i];
+    const slideNum = i + 1;
+    const sldId = 256 + i;
+    const rId = `rId${slideNum}`;
+
+    sldIdTags.push(`<p:sldId id="${sldId}" r:id="${rId}"/>`);
+    presRelsTags.push(
+      `<Relationship Id="${rId}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide" Target="slides/slide${slideNum}.xml"/>`
+    );
+    slideContentTypeOverrides.push(
+      `<Override PartName="/ppt/slides/slide${slideNum}.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slide+xml"/>`
+    );
+
+    const paragraphs = [];
+    if (slide.title) {
+      paragraphs.push(
+        `<a:p><a:r><a:rPr lang="ru-RU" sz="2800" b="1"/><a:t>${escapeXml(slide.title)}</a:t></a:r></a:p>`
+      );
+    }
+    if (slide.subtitle) {
+      paragraphs.push(
+        `<a:p><a:r><a:rPr lang="ru-RU" sz="1800" i="1"/><a:t>${escapeXml(slide.subtitle)}</a:t></a:r></a:p>`
+      );
+    }
+    if (Array.isArray(slide.bullets)) {
+      for (const b of slide.bullets) {
+        if (!b) continue;
+        paragraphs.push(
+          `<a:p><a:r><a:rPr lang="ru-RU" sz="1600"/><a:t>• ${escapeXml(String(b))}</a:t></a:r></a:p>`
+        );
+      }
+    }
+
+    const slideXml =
+      `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>` +
+      `<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" ` +
+      `xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ` +
+      `xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main">` +
+      `<p:cSld><p:spTree>` +
+      `<p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr>` +
+      `<p:grpSpPr/>` +
+      `<p:sp>` +
+      `<p:nvSpPr><p:cNvPr id="2" name="TitleAndContent"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr>` +
+      `<p:spPr/>` +
+      `<p:txBody><a:bodyPr/><a:lstStyle/>${paragraphs.join("")}</p:txBody>` +
+      `</p:sp>` +
+      `</p:spTree></p:cSld>` +
+      `</p:sld>`;
+
+    zipEntries.push({
+      name: `ppt/slides/slide${slideNum}.xml`,
+      data: slideXml
+    });
+  }
+
+  const contentTypesXml =
+    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>` +
+    `<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">` +
+    `<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>` +
+    `<Default Extension="xml" ContentType="application/xml"/>` +
+    `<Override PartName="/ppt/presentation.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml"/>` +
+    slideContentTypeOverrides.join("") +
+    `</Types>`;
+
+  const rootRelsXml =
+    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>` +
+    `<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">` +
+    `<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="ppt/presentation.xml"/>` +
+    `</Relationships>`;
+
+  const presentationXml =
+    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>` +
+    `<p:presentation xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" ` +
+    `xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" ` +
+    `xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main">` +
+    `<p:sldIdLst>${sldIdTags.join("")}</p:sldIdLst>` +
+    `<p:sldSz cx="12192000" cy="6858000"/>` +
+    `<p:notesSz cx="6858000" cy="9144000"/>` +
+    `</p:presentation>`;
+
+  const presRelsXml =
+    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>` +
+    `<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">` +
+    presRelsTags.join("") +
+    `</Relationships>`;
+
+  return buildZipBuffer([
+    { name: "[Content_Types].xml", data: contentTypesXml },
+    { name: "_rels/.rels", data: rootRelsXml },
+    { name: "ppt/presentation.xml", data: presentationXml },
+    { name: "ppt/_rels/presentation.xml.rels", data: presRelsXml },
+    ...zipEntries
+  ]);
+}
+
+/**
+ * Writes an OpenXML `.pptx` presentation safely into the connected Koswork workspace folder.
+ */
+function savePresentationToWorkspace(options) {
+  const workspaceRoot = options.workspaceRoot;
+  const relativePath = String(options.relativePath || "Koswork-Presentation.pptx");
+
+  if (!relativePath.toLowerCase().endsWith(".pptx")) {
+    throw new Error("INVALID_PPTX_EXTENSION: Presentation filename must end with .pptx");
+  }
+
+  const { canonicalRoot } = pathGuard.inspectRootDirectory(workspaceRoot);
+  const resolvedTarget = pathGuard.resolveSafeWorkspaceTarget(canonicalRoot, relativePath, {
+    allowMissingLeaf: true,
+    allowMissingParents: true
+  }).absolutePath;
+
+  const pptxBuf = buildPowerPointPptxBuffer(options.presentationSpec || {});
+  const sha256 = crypto.createHash("sha256").update(pptxBuf).digest("hex");
+
+  fs.mkdirSync(path.dirname(resolvedTarget), { recursive: true });
+  fs.writeFileSync(resolvedTarget, pptxBuf);
+
+  return {
+    saved: true,
+    format: "pptx",
+    relativePath,
+    absolutePath: resolvedTarget,
+    sizeBytes: pptxBuf.length,
+    sha256
+  };
+}
+
+module.exports = {
+  buildPowerPointPptxBuffer,
+  savePresentationToWorkspace
+};
diff --git a/desktop/windows/workspace/version-backup.cjs b/desktop/windows/workspace/version-backup.cjs
new file mode 100644
index 0000000..2572ee0
--- /dev/null
+++ b/desktop/windows/workspace/version-backup.cjs
@@ -0,0 +1,371 @@
+"use strict";
+
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+const { TextDecoder } = require("node:util");
+const { writeAtomicJson } = require("../desktop-state.cjs");
+const { ERROR_CODES, KosworkWorkspaceError, throwIfAborted } = require("./errors.cjs");
+const { assertNotReparseOrSymlink } = require("./path-guard.cjs");
+
+const fatalUtf8Decoder = new TextDecoder("utf-8", { fatal: true });
+const CHUNK_BYTES = 64 * 1024;
+
+function computeBufferVersion(buffer) {
+  const buf = Buffer.isBuffer(buffer) ? buffer : Buffer.from(String(buffer), "utf8");
+  const sha256 = crypto.createHash("sha256").update(buf).digest("hex");
+  return {
+    sha256,
+    version: `sha256:${sha256}`,
+    size: buf.byteLength
+  };
+}
+
+function normalizeExpectedSha256(expected) {
+  if (typeof expected !== "string" || expected.trim() === "") return null;
+  const trimmed = expected.trim().toLowerCase();
+  const raw = trimmed.startsWith("sha256:") ? trimmed.slice(7) : trimmed;
+  if (!/^[0-9a-f]{64}$/.test(raw)) return null;
+  return raw;
+}
+
+function versionsMatch(actualSha256, expectedInput) {
+  const expectedHex = normalizeExpectedSha256(expectedInput);
+  if (!expectedHex || typeof actualSha256 !== "string" || actualSha256.length !== 64) {
+    return false;
+  }
+  const actualBuf = Buffer.from(actualSha256.toLowerCase(), "utf8");
+  const expectedBuf = Buffer.from(expectedHex, "utf8");
+  return actualBuf.length === expectedBuf.length && crypto.timingSafeEqual(actualBuf, expectedBuf);
+}
+
+function decodeStrictUtf8Text(buffer, relativePath = "") {
+  if (!Buffer.isBuffer(buffer)) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_BINARY_FILE,
+      "Ожидался бинарный буфер для декодирования UTF-8."
+    );
+  }
+  // Reject NUL bytes (binary files)
+  if (buffer.includes(0x00)) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_BINARY_FILE,
+      `Файл "${relativePath}" является бинарным (содержит нулевые байты) и не может быть прочитан как текст.`,
+      { path: relativePath }
+    );
+  }
+  try {
+    return fatalUtf8Decoder.decode(buffer);
+  } catch {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_BINARY_FILE,
+      `Файл "${relativePath}" содержит некорректную последовательность UTF-8 и не может быть открыт как текстовый.`,
+      { path: relativePath }
+    );
+  }
+}
+
+function readBoundedFileSnapshot(
+  absolutePath,
+  { relativePath = "", maxBytes, signal = null, activeController = null } = {}
+) {
+  throwIfAborted(signal, activeController);
+
+  let lstat;
+  try {
+    lstat = fs.lstatSync(absolutePath);
+  } catch (error) {
+    if (error && error.code === "ENOENT") {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_NOT_FOUND,
+        `Файл "${relativePath}" не найден.`
+      );
+    }
+    throw error;
+  }
+
+  assertNotReparseOrSymlink(absolutePath, lstat);
+  if (lstat.isDirectory()) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_NOT_A_FILE,
+      `Путь "${relativePath}" указывает на папку, а не на файл.`
+    );
+  }
+  if (!lstat.isFile()) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_NOT_A_FILE,
+      `Путь "${relativePath}" не является обычным файлом.`
+    );
+  }
+  if (Number.isFinite(maxBytes) && lstat.size > maxBytes) {
+    throw new KosworkWorkspaceError(
+      ERROR_CODES.WORKSPACE_FILE_TOO_LARGE,
+      `Размер файла "${relativePath}" (${lstat.size} байт) превышает допустимый лимит ${maxBytes} байт.`,
+      { path: relativePath, size: lstat.size, maxBytes }
+    );
+  }
+
+  const openFlags =
+    fs.constants.O_RDONLY | (typeof fs.constants.O_NOFOLLOW === "number" ? fs.constants.O_NOFOLLOW : 0);
+  let fd;
+  try {
+    fd = fs.openSync(absolutePath, openFlags);
+  } catch (error) {
+    if (error && (error.code === "ELOOP" || error.code === "EPERM")) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+        `Отказано в открытии ссылки "${relativePath}".`
+      );
+    }
+    throw error;
+  }
+
+  try {
+    const fstat = fs.fstatSync(fd);
+    if (!fstat.isFile() || (lstat.ino && fstat.ino && lstat.ino !== fstat.ino)) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_VERSION_CONFLICT,
+        `Файл "${relativePath}" был подменён во время открытия.`
+      );
+    }
+    if (Number.isFinite(maxBytes) && fstat.size > maxBytes) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_FILE_TOO_LARGE,
+        `Размер файла "${relativePath}" (${fstat.size} байт) превышает лимит ${maxBytes} байт.`,
+        { path: relativePath, size: fstat.size, maxBytes }
+      );
+    }
+
+    const chunks = [];
+    let totalRead = 0;
+    const tempBuf = Buffer.allocUnsafe(Math.min(CHUNK_BYTES, Math.max(1024, (maxBytes || CHUNK_BYTES) + 1)));
+
+    for (;;) {
+      throwIfAborted(signal, activeController);
+      const bytesRead = fs.readSync(fd, tempBuf, 0, tempBuf.length, totalRead);
+      if (bytesRead === 0) break;
+      totalRead += bytesRead;
+      if (Number.isFinite(maxBytes) && totalRead > maxBytes) {
+        throw new KosworkWorkspaceError(
+          ERROR_CODES.WORKSPACE_FILE_TOO_LARGE,
+          `Файл "${relativePath}" вырос сверх лимита ${maxBytes} байт во время чтения.`,
+          { path: relativePath, maxBytes }
+        );
+      }
+      chunks.push(Buffer.from(tempBuf.subarray(0, bytesRead)));
+    }
+
+    const afterStat = fs.fstatSync(fd);
+    if (afterStat.mtimeMs !== fstat.mtimeMs || afterStat.size !== totalRead) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_VERSION_CONFLICT,
+        `Файл "${relativePath}" был конкурентно изменён другим процессом во время чтения.`
+      );
+    }
+
+    const buffer = Buffer.concat(chunks, totalRead);
+    const { sha256, version } = computeBufferVersion(buffer);
+    return {
+      buffer,
+      size: totalRead,
+      mtimeMs: fstat.mtimeMs,
+      ino: fstat.ino,
+      dev: fstat.dev,
+      sha256,
+      version
+    };
+  } finally {
+    try {
+      fs.closeSync(fd);
+    } catch {
+      /* ignore close errors */
+    }
+  }
+}
+
+function createBackupStore(
+  backupDirectory,
+  {
+    maxBackups = 50,
+    maxTotalBackupBytes = 25 * 1024 * 1024,
+    now = () => Date.now()
+  } = {}
+) {
+  const indexFile = path.join(backupDirectory, "index.json");
+  const blobsDir = path.join(backupDirectory, "blobs");
+
+  function ensureStorage() {
+    fs.mkdirSync(blobsDir, { recursive: true, mode: 0o700 });
+    const lstat = fs.lstatSync(backupDirectory);
+    if (lstat.isSymbolicLink()) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_SYMLINK_REJECTED,
+        "Каталог резервных копий не может быть символической ссылкой."
+      );
+    }
+  }
+
+  function readIndex() {
+    try {
+      const raw = JSON.parse(fs.readFileSync(indexFile, "utf8"));
+      if (raw?.schemaVersion === 1 && Array.isArray(raw.items)) {
+        return raw.items;
+      }
+    } catch {
+      /* empty or absent index */
+    }
+    return [];
+  }
+
+  function writeIndex(items) {
+    ensureStorage();
+    writeAtomicJson(indexFile, {
+      schemaVersion: 1,
+      updatedAt: new Date(now()).toISOString(),
+      items
+    });
+  }
+
+  function saveBackup({ relativePath, buffer, sha256, version, originalMtimeMs }) {
+    if (buffer.byteLength > maxTotalBackupBytes) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_LIMIT_EXCEEDED,
+        "Файл слишком велик для сохранения в локальное хранилище резервных копий.",
+        { size: buffer.byteLength, maxTotalBackupBytes }
+      );
+    }
+    ensureStorage();
+    const backupId = `bkp_${now()}_${crypto.randomBytes(6).toString("hex")}`;
+    const blobFilename = `${backupId}.bak`;
+    const blobPath = path.join(blobsDir, blobFilename);
+    fs.writeFileSync(blobPath, buffer, { mode: 0o600, flag: "wx" });
+
+    // Verify stored backup integrity before proceeding with file replacement
+    const writtenBytes = fs.readFileSync(blobPath);
+    const writtenVersion = computeBufferVersion(writtenBytes);
+    if (writtenVersion.sha256 !== sha256) {
+      try {
+        fs.unlinkSync(blobPath);
+      } catch {
+        /* ignore */
+      }
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_VERSION_CONFLICT,
+        "Не удалось подтвердить целостность резервной копии перед обновлением файла."
+      );
+    }
+
+    const entry = {
+      backupId,
+      relativePath,
+      sha256,
+      version,
+      size: buffer.byteLength,
+      originalMtimeMs,
+      createdAt: new Date(now()).toISOString(),
+      blobFilename
+    };
+
+    const existing = readIndex();
+    const updated = [entry, ...existing];
+    const retained = [];
+    let totalBytes = 0;
+
+    for (const item of updated) {
+      if (retained.length < maxBackups && totalBytes + item.size <= maxTotalBackupBytes) {
+        retained.push(item);
+        totalBytes += item.size;
+      } else {
+        try {
+          fs.unlinkSync(path.join(blobsDir, item.blobFilename));
+        } catch {
+          /* already pruned */
+        }
+      }
+    }
+
+    writeIndex(retained);
+    return {
+      backupId: entry.backupId,
+      relativePath: entry.relativePath,
+      sha256: entry.sha256,
+      version: entry.version,
+      size: entry.size,
+      originalMtimeMs: entry.originalMtimeMs,
+      createdAt: entry.createdAt
+    };
+  }
+
+  function listBackups(relativePath = null) {
+    const items = readIndex();
+    const filtered =
+      typeof relativePath === "string" && relativePath.trim() !== ""
+        ? items.filter((item) => item.relativePath === relativePath)
+        : items;
+    return filtered.map(({ blobFilename: _blob, ...publicEntry }) => ({ ...publicEntry }));
+  }
+
+  function readBackup(backupId) {
+    if (typeof backupId !== "string" || !/^bkp_\d+_[0-9a-f]{12}$/.test(backupId)) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_INVALID_ARGUMENT,
+        "Некорректный идентификатор резервной копии."
+      );
+    }
+    const entry = readIndex().find((item) => item.backupId === backupId);
+    if (!entry) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_NOT_FOUND,
+        `Резервная копия "${backupId}" не найдена.`
+      );
+    }
+    const blobPath = path.join(blobsDir, entry.blobFilename);
+    let buffer;
+    try {
+      const lstat = fs.lstatSync(blobPath);
+      assertNotReparseOrSymlink(blobPath, lstat);
+      buffer = fs.readFileSync(blobPath);
+    } catch (error) {
+      if (error instanceof KosworkWorkspaceError) throw error;
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_NOT_FOUND,
+        `Файл резервной копии "${backupId}" отсутствует на диске.`
+      );
+    }
+    const check = computeBufferVersion(buffer);
+    if (check.sha256 !== entry.sha256) {
+      throw new KosworkWorkspaceError(
+        ERROR_CODES.WORKSPACE_VERSION_CONFLICT,
+        `Контрольная сумма резервной копии "${backupId}" повреждена.`
+      );
+    }
+    return {
+      ...entry,
+      buffer
+    };
+  }
+
+  function purgeAll() {
+    try {
+      fs.rmSync(backupDirectory, { recursive: true, force: true });
+    } catch {
+      /* ignore */
+    }
+  }
+
+  return {
+    saveBackup,
+    listBackups,
+    readBackup,
+    purgeAll
+  };
+}
+
+module.exports = {
+  computeBufferVersion,
+  createBackupStore,
+  decodeStrictUtf8Text,
+  normalizeExpectedSha256,
+  readBoundedFileSnapshot,
+  versionsMatch
+};
diff --git a/desktop/windows/workspace/word-report-builder.cjs b/desktop/windows/workspace/word-report-builder.cjs
new file mode 100644
index 0000000..0c61587
--- /dev/null
+++ b/desktop/windows/workspace/word-report-builder.cjs
@@ -0,0 +1,238 @@
+"use strict";
+
+const zlib = require("node:zlib");
+const crypto = require("node:crypto");
+const { KosworkWorkspaceService } = require("./workspace-service.cjs");
+
+function escapeXml(str) {
+  return String(str ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&apos;");
+}
+
+function crc32(buf) {
+  let c = 0xffffffff;
+  for (let i = 0; i < buf.length; i++) {
+    c ^= buf[i];
