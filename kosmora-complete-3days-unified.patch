+"use strict";
+
+const crypto = require("node:crypto");
+
+const MAX_QUERY_CHARS = 240;
+const MAX_PAGE_SIZE = 5;
+const MAX_STORED_SEARCHES = 100;
+const MAX_ACTIVE_WEB_VIEWS = 3;
+
+function sanitizeTextContent(raw) {
+  return String(raw ?? "")
+    .replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, "")
+    .trim();
+}
+
+/**
+ * First-Party Search Journal, Deterministic SERP Paginator, Persistent Bookmarks,
+ * and 3-View Resource/Token Telemetry for the Koswork Local Chromium Browser
+ * (closes the remaining items in PR #415 `KOSWORK_OWN_SEARCH_2026-10-29_RU.md`
+ * and `KOSWORK_BROWSER_FINISH_2026-10-29_RU.md`).
+ */
+class KosworkSearchAndBrowserStore {
+  constructor() {
+    this.searchJournal = [];
+    this.bookmarks = new Map();
+    this.visitHistory = [];
+    this.activeViews = new Map();
+  }
+
+  recordAndPaginateSearch(input) {
+    const rawQuery = sanitizeTextContent(input.query);
+    if (!rawQuery || rawQuery.length > MAX_QUERY_CHARS) {
+      const err = new Error("INVALID_SEARCH_QUERY_LENGTH");
+      err.code = "INVALID_SEARCH_QUERY_LENGTH";
+      throw err;
+    }
+
+    const allResults = Array.isArray(input.results) ? input.results : [];
+    const sanitizedResults = allResults.map((r, idx) => {
+      const url = String(r.url || "");
+      let domain = "";
+      try {
+        domain = new URL(url).hostname;
+      } catch {
+        domain = "invalid-domain";
+      }
+      return {
+        rank: idx + 1,
+        title: sanitizeTextContent(r.title).slice(0, 200),
+        domain,
+        url,
+        snippet: sanitizeTextContent(r.snippet).slice(0, 400)
+      };
+    });
+
+    const querySha256 = crypto.createHash("sha256").update(rawQuery.toLowerCase(), "utf8").digest("hex");
+    const searchId = `srch-${querySha256.slice(0, 16)}`;
+    const now = input.recordedAt || new Date().toISOString();
+
+    const existingIdx = this.searchJournal.findIndex((s) => s.searchId === searchId);
+    const entry = {
+      searchId,
+      querySha256,
+      queryPreview: rawQuery,
+      engine: "duckduckgo",
+      totalResults: sanitizedResults.length,
+      results: sanitizedResults,
+      navigationUrl: `koswork://search/${searchId}`, // Never leaks raw query text into Chromium history URL!
+      recordedAt: now
+    };
+
+    if (existingIdx >= 0) {
+      this.searchJournal.splice(existingIdx, 1);
+    }
+    this.searchJournal.unshift(entry);
+    if (this.searchJournal.length > MAX_STORED_SEARCHES) {
+      this.searchJournal.pop();
+    }
+
+    return this.getSearchPage(searchId, {
+      page: input.page ?? 1,
+      pageSize: input.pageSize ?? MAX_PAGE_SIZE
+    });
+  }
+
+  getSearchPage(searchId, options = {}) {
+    const entry = this.searchJournal.find((s) => s.searchId === String(searchId));
+    if (!entry) {
+      const err = new Error("SEARCH_JOURNAL_ENTRY_NOT_FOUND");
+      err.code = "SEARCH_JOURNAL_ENTRY_NOT_FOUND";
+      throw err;
+    }
+
+    const pageSize = Math.max(1, Math.min(Number(options.pageSize) || MAX_PAGE_SIZE, MAX_PAGE_SIZE));
+    const totalPages = Math.max(1, Math.ceil(entry.results.length / pageSize));
+    const page = Math.max(1, Math.min(Number(options.page) || 1, totalPages));
+    const start = (page - 1) * pageSize;
+    const items = entry.results.slice(start, start + pageSize);
+
+    return {
+      searchId: entry.searchId,
+      navigationUrl: entry.navigationUrl,
+      engine: entry.engine,
+      page,
+      pageSize,
+      totalPages,
+      totalResults: entry.totalResults,
+      hasNextPage: page < totalPages,
+      hasPreviousPage: page > 1,
+      items
+    };
+  }
+
+  addBookmark(input) {
+    const url = String(input.url || "").trim();
+    if (!/^https?:\/\//i.test(url)) {
+      throw new Error("BOOKMARK_REQUIRES_HTTP_HTTPS_URL");
+    }
+    const id = `bm-${crypto.createHash("sha256").update(url, "utf8").digest("hex").slice(0, 12)}`;
+    const bookmark = {
+      id,
+      url,
+      title: sanitizeTextContent(input.title || url).slice(0, 160),
+      folder: sanitizeTextContent(input.folder || "Общие").slice(0, 64),
+      createdAt: input.createdAt || new Date().toISOString()
+    };
+    this.bookmarks.set(id, bookmark);
+    return bookmark;
+  }
+
+  listBookmarks() {
+    return Array.from(this.bookmarks.values());
+  }
+
+  registerWebViewUsage(tabId, metrics) {
+    this.activeViews.set(String(tabId), {
+      tabId: String(tabId),
+      ramMb: Number(metrics.ramMb ?? 0),
+      cpuPercent: Number(metrics.cpuPercent ?? 0),
+      domTokensEstimated: Number(metrics.domTokensEstimated ?? 0),
+      lastActiveAt: Number(metrics.lastActiveAt ?? Date.now())
+    });
+
+    // Enforce the strict 3-loaded-WebContentsView cap from PR #415 by evicting oldest view
+    const evictedTabIds = [];
+    while (this.activeViews.size > MAX_ACTIVE_WEB_VIEWS) {
+      let oldestTab = null;
+      let oldestTime = Infinity;
+      for (const [tid, v] of this.activeViews.entries()) {
+        if (v.lastActiveAt < oldestTime) {
+          oldestTime = v.lastActiveAt;
+          oldestTab = tid;
+        }
+      }
+      if (oldestTab) {
+        this.activeViews.delete(oldestTab);
+        evictedTabIds.push(oldestTab);
+      } else {
+        break;
+      }
+    }
+
+    let totalRamMb = 0;
+    let totalCpuPercent = 0;
+    let totalDomTokens = 0;
+    for (const v of this.activeViews.values()) {
+      totalRamMb += v.ramMb;
+      totalCpuPercent += v.cpuPercent;
+      totalDomTokens += v.domTokensEstimated;
+    }
+
+    return {
+      activeLoadedViews: this.activeViews.size,
+      maxAllowedViews: MAX_ACTIVE_WEB_VIEWS,
+      evictedTabIds,
+      totalRamMb: Number(totalRamMb.toFixed(2)),
+      totalCpuPercent: Number(totalCpuPercent.toFixed(2)),
+      totalDomTokens
+    };
+  }
+}
+
+module.exports = {
+  KosworkSearchAndBrowserStore,
+  MAX_ACTIVE_WEB_VIEWS,
+  MAX_PAGE_SIZE,
+  MAX_QUERY_CHARS
+};
diff --git a/desktop/windows/browser/shadow-and-frame-piercer.cjs b/desktop/windows/browser/shadow-and-frame-piercer.cjs
new file mode 100644
index 0000000..4cce978
--- /dev/null
+++ b/desktop/windows/browser/shadow-and-frame-piercer.cjs
@@ -0,0 +1,193 @@
+"use strict";
+
+/**
+ * Recursive Shadow DOM & Same-Origin Iframe Piercer for the Koswork Local Chromium Agent Browser
+ * (addresses the complex frame and Shadow DOM limitations noted in PR #414 and PR #415).
+ *
+ * Works both on live DOM trees (inside preload / browser context) and on serialized/mock DOM trees
+ * in Node unit tests while strictly enforcing same-origin frame security boundaries.
+ */
+
+const INTERACTIVE_TAGS = new Set(["BUTTON", "A", "INPUT", "SELECT", "TEXTAREA", "SUMMARY"]);
+
+function isInteractiveNode(node) {
+  if (!node || typeof node !== "object") return false;
+  const tag = String(node.tagName || "").toUpperCase();
+  if (INTERACTIVE_TAGS.has(tag)) return true;
+  const role = String(node.getAttribute?.("role") || node.attributes?.role || "").toLowerCase();
+  return role === "button" || role === "link" || role === "textbox" || role === "checkbox" || role === "tab";
+}
+
+function describeNodeSegment(node, indexInParent) {
+  const tag = String(node.tagName || "node").toLowerCase();
+  const id = node.id || node.getAttribute?.("id") || node.attributes?.id;
+  if (id) return `${tag}#${id}`;
+  const testId =
+    node.getAttribute?.("data-testid") ||
+    node.attributes?.["data-testid"] ||
+    node.getAttribute?.("name") ||
+    node.attributes?.name;
+  if (testId) return `${tag}[name="${testId}"]`;
+  return `${tag}:nth-of-type(${indexInParent + 1})`;
+}
+
+/**
+ * Collects interactive elements across main document, nested open shadow roots,
+ * and same-origin iframes up to `maxDepth`, returning deterministic deep selectors
+ * (`iframe#checkout >> shadow#payment-card >> button#pay`).
+ */
+function collectPiercedInteractiveSnapshot(rootNode, options = {}) {
+  const maxDepth = Math.min(Math.max(Number(options.maxDepth ?? 6), 1), 12);
+  const maxElements = Math.min(Math.max(Number(options.maxElements ?? 200), 1), 500);
+  const baseOrigin = options.baseOrigin || rootNode?.location?.origin || "https://local.koswork";
+
+  const elements = [];
+  const skippedCrossOriginFrames = [];
+
+  function walk(node, pathSegments, depth) {
+    if (!node || depth > maxDepth || elements.length >= maxElements) return;
+
+    const children = Array.from(node.children || node.childNodes || []);
+    for (let i = 0; i < children.length; i++) {
+      if (elements.length >= maxElements) break;
+      const child = children[i];
+      if (!child || !child.tagName) continue;
+
+      const seg = describeNodeSegment(child, i);
+      const currentPath = [...pathSegments, seg];
+
+      if (isInteractiveNode(child) && !child.disabled && !child.hidden) {
+        const label = String(
+          child.innerText ||
+            child.textContent ||
+            child.value ||
+            child.getAttribute?.("aria-label") ||
+            child.attributes?.["aria-label"] ||
+            ""
+        )
+          .replace(/\s+/g, " ")
+          .trim()
+          .slice(0, 160);
+
+        elements.push({
+          deepSelector: currentPath.join(" >> "),
+          tagName: String(child.tagName).toLowerCase(),
+          id: child.id || child.attributes?.id || null,
+          label,
+          inShadowDom: currentPath.some((p) => p.startsWith("shadow[")),
+          inIframe: currentPath.some((p) => p.startsWith("frame["))
+        });
+      }
+
+      // 1. Pierce open Shadow DOM root if present
+      if (child.shadowRoot) {
+        walk(child.shadowRoot, [...currentPath, `shadow[${seg}]`], depth + 1);
+      }
+
+      // 2. Pierce same-origin iframe contentDocument while blocking cross-origin frames
+      if (String(child.tagName).toUpperCase() === "IFRAME") {
+        const frameSrc = String(child.src || child.getAttribute?.("src") || child.attributes?.src || "");
+        let isSameOrigin = true;
+        if (frameSrc && /^https?:\/\//i.test(frameSrc)) {
+          try {
+            const parsedOrigin = new URL(frameSrc).origin;
+            isSameOrigin = parsedOrigin === baseOrigin;
+          } catch {
+            isSameOrigin = false;
+          }
+        }
+
+        if (!isSameOrigin) {
+          skippedCrossOriginFrames.push({
+            frameSelector: currentPath.join(" >> "),
+            src: frameSrc,
+            reason: "cross_origin_isolated"
+          });
+        } else {
+          let frameDoc = null;
+          try {
+            frameDoc = child.contentDocument || child.contentWindow?.document || null;
+          } catch {
+            frameDoc = null;
+          }
+          if (frameDoc) {
+            const rootTarget = frameDoc.body || frameDoc.documentElement || frameDoc;
+            walk(rootTarget, [...currentPath, `frame[${seg}]`], depth + 1);
+          }
+        }
+      }
+
+      // 3. Normal light-DOM recursion
+      walk(child, currentPath, depth + 1);
+    }
+  }
+
+  const startRoot = rootNode?.body || rootNode?.documentElement || rootNode;
+  walk(startRoot, [], 0);
+
+  return {
+    baseOrigin,
+    totalInteractive: elements.length,
+    elements,
+    skippedCrossOriginFrames
+  };
+}
+
+/**
+ * Resolves a deep selector (`iframe#editor >> shadow[custom-card#host] >> button#save`)
+ * back to the target DOM node so the Koswork browser runner can click/fill it deterministically.
+ */
+function resolveDeepSelector(rootNode, deepSelector) {
+  const parts = String(deepSelector || "")
+    .split(">>")
+    .map((s) => s.trim())
+    .filter(Boolean);
+  if (parts.length === 0) return null;
+
+  let currentContext = rootNode?.body || rootNode?.documentElement || rootNode;
+
+  function findDirectOrDescendantMatch(container, token) {
+    if (!container) return null;
+    const queue = [container];
+    while (queue.length > 0) {
+      const node = queue.shift();
+      const children = Array.from(node.children || node.childNodes || []);
+      for (let i = 0; i < children.length; i++) {
+        const child = children[i];
+        if (!child || !child.tagName) continue;
+        const seg = describeNodeSegment(child, i);
+        if (seg === token) return child;
+        queue.push(child);
+      }
+    }
+    return null;
+  }
+
+  let lastMatchedElement = null;
+  for (const part of parts) {
+    if (part.startsWith("shadow[")) {
+      if (!lastMatchedElement || !lastMatchedElement.shadowRoot) return null;
+      currentContext = lastMatchedElement.shadowRoot;
+      continue;
+    }
+    if (part.startsWith("frame[")) {
+      if (!lastMatchedElement) return null;
+      const frameDoc =
+        lastMatchedElement.contentDocument || lastMatchedElement.contentWindow?.document || null;
+      if (!frameDoc) return null;
+      currentContext = frameDoc.body || frameDoc.documentElement || frameDoc;
+      continue;
+    }
+    const found = findDirectOrDescendantMatch(currentContext, part);
+    if (!found) return null;
+    lastMatchedElement = found;
+    currentContext = found;
+  }
+
+  return lastMatchedElement;
+}
+
+module.exports = {
+  collectPiercedInteractiveSnapshot,
+  resolveDeepSelector
+};
diff --git a/desktop/windows/browser/visual-dom-diff-verifier.cjs b/desktop/windows/browser/visual-dom-diff-verifier.cjs
new file mode 100644
index 0000000..9ca1e3a
--- /dev/null
+++ b/desktop/windows/browser/visual-dom-diff-verifier.cjs
@@ -0,0 +1,180 @@
+"use strict";
+/**
+ * Kosmora / Koswork Visual DOM Mutation & Action Verification Engine (Wave 18)
+ *
+ * Captures pre-action and post-action interactive accessibility / DOM snapshots
+ * in Electron WebContentsView and verifies whether a browser action (click, type,
+ * submit, select) produced a concrete state transition:
+ * - Detects newly revealed modal dialogs, dropdown menus, toast notifications, or validation alerts
+ * - Detects URL navigation or input value changes
+ * - Identifies "no-op / dead clicks" (zero DOM mutation and zero focus/value delta) and generates
+ *   deterministic self-healing fallback coordinates or keyboard actions
+ */
+
+const crypto = require("node:crypto");
+
+/**
+ * Normalizes a DOM / accessibility tree snapshot into a canonical map of interactive nodes.
+ * @param {object} rawSnapshot
+ */
+function normalizeDomSnapshot(rawSnapshot) {
+  const url = String(rawSnapshot?.url || "about:blank");
+  const title = String(rawSnapshot?.title || "");
+  const activeElementId = String(rawSnapshot?.activeElementId || "");
+  const nodes = Array.isArray(rawSnapshot?.nodes) ? rawSnapshot.nodes : [];
+
+  const nodeMap = new Map();
+  for (const n of nodes) {
+    if (!n || !n.id) continue;
+    const norm = {
+      id: String(n.id),
+      tag: String(n.tag || "div").toLowerCase(),
+      role: String(n.role || "").toLowerCase(),
+      text: String(n.text || "").trim(),
+      value: String(n.value ?? ""),
+      visible: Boolean(n.visible !== false),
+      disabled: Boolean(n.disabled === true),
+      ariaExpanded: n.ariaExpanded !== undefined ? Boolean(n.ariaExpanded) : undefined,
+      checked: n.checked !== undefined ? Boolean(n.checked) : undefined,
+      bbox: n.bbox || { x: 0, y: 0, width: 0, height: 0 }
+    };
+    nodeMap.set(norm.id, norm);
+  }
+
+  const canonicalJson = JSON.stringify({
+    url,
+    title,
+    activeElementId,
+    nodes: Array.from(nodeMap.values())
+  });
+  const snapshotHash = crypto.createHash("sha256").update(canonicalJson, "utf8").digest("hex");
+
+  return {
+    url,
+    title,
+    activeElementId,
+    nodeMap,
+    snapshotHash
+  };
+}
+
+/**
+ * Computes structural and state mutations between pre-action and post-action DOM snapshots.
+ */
+function verifyBrowserActionMutation(preRaw, postRaw, intendedAction = {}) {
+  const pre = normalizeDomSnapshot(preRaw);
+  const post = normalizeDomSnapshot(postRaw);
+
+  const addedNodes = [];
+  const removedNodes = [];
+  const mutatedNodes = [];
+  const modalOrAlertNodes = [];
+
+  for (const [id, postNode] of post.nodeMap.entries()) {
+    const preNode = pre.nodeMap.get(id);
+    if (!preNode) {
+      if (postNode.visible) {
+        addedNodes.push(postNode);
+        if (
+          postNode.role === "dialog" ||
+          postNode.role === "alert" ||
+          postNode.role === "menu" ||
+          postNode.tag === "dialog"
+        ) {
+          modalOrAlertNodes.push(postNode);
+        }
+      }
+      continue;
+    }
+
+    const changes = [];
+    if (preNode.visible !== postNode.visible) {
+      changes.push(`visibility:${preNode.visible}->${postNode.visible}`);
+      if (
+        postNode.visible &&
+        (postNode.role === "dialog" || postNode.role === "alert" || postNode.role === "menu")
+      ) {
+        modalOrAlertNodes.push(postNode);
+      }
+    }
+    if (preNode.value !== postNode.value) {
+      changes.push(`value:'${preNode.value}'->'${postNode.value}'`);
+    }
+    if (preNode.text !== postNode.text) {
+      changes.push(`text:'${preNode.text}'->'${postNode.text}'`);
+    }
+    if (preNode.ariaExpanded !== postNode.ariaExpanded) {
+      changes.push(`ariaExpanded:${preNode.ariaExpanded}->${postNode.ariaExpanded}`);
+    }
+    if (preNode.checked !== postNode.checked) {
+      changes.push(`checked:${preNode.checked}->${postNode.checked}`);
+    }
+    if (preNode.disabled !== postNode.disabled) {
+      changes.push(`disabled:${preNode.disabled}->${postNode.disabled}`);
+    }
+
+    if (changes.length > 0) {
+      mutatedNodes.push({
+        id,
+        tag: postNode.tag,
+        role: postNode.role,
+        changes
+      });
+    }
+  }
+
+  for (const [id, preNode] of pre.nodeMap.entries()) {
+    if (!post.nodeMap.has(id) && preNode.visible) {
+      removedNodes.push(preNode);
+    }
+  }
+
+  const urlChanged = pre.url !== post.url;
+  const focusChanged = pre.activeElementId !== post.activeElementId;
+  const totalDomDeltas =
+    addedNodes.length +
+    removedNodes.length +
+    mutatedNodes.length +
+    (urlChanged ? 1 : 0) +
+    (focusChanged ? 1 : 0);
+
+  const isDeadAction = totalDomDeltas === 0;
+
+  let remedialSuggestion = null;
+  if (isDeadAction) {
+    const targetId = intendedAction.targetId || "unknown";
+    const targetNode = post.nodeMap.get(targetId);
+    if (targetNode && targetNode.disabled) {
+      remedialSuggestion = `Target element '${targetId}' is disabled. Wait for prerequisite form fields to validate before clicking.`;
+    } else if (targetNode && targetNode.bbox && targetNode.bbox.width > 0) {
+      const centerX = Math.round(targetNode.bbox.x + targetNode.bbox.width / 2);
+      const centerY = Math.round(targetNode.bbox.y + targetNode.bbox.height / 2);
+      remedialSuggestion = `Dead action detected on '${targetId}'. Scroll element into view, focus explicitly, and dispatch synthetic click at center (${centerX}, ${centerY}) or trigger keyboard Enter.`;
+    } else {
+      remedialSuggestion = `No DOM mutation observed after ${intendedAction.type || "action"} on '${targetId}'. Re-query Shadow DOM / iframe tree and retry via keyboard navigation.`;
+    }
+  }
+
+  return {
+    actionVerified: !isDeadAction,
+    isDeadAction,
+    urlChanged,
+    focusChanged,
+    preSnapshotHash: pre.snapshotHash,
+    postSnapshotHash: post.snapshotHash,
+    totalDomDeltas,
+    addedCount: addedNodes.length,
+    removedCount: removedNodes.length,
+    mutatedCount: mutatedNodes.length,
+    addedNodes,
+    removedNodes,
+    mutatedNodes,
+    modalOrAlertNodes,
+    remedialSuggestion
+  };
+}
+
+module.exports = {
+  normalizeDomSnapshot,
+  verifyBrowserActionMutation
+};
diff --git a/desktop/windows/ci/archive-quarantine-verifier.cjs b/desktop/windows/ci/archive-quarantine-verifier.cjs
