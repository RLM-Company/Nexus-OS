+test("PetriNetWorkflowVerifier proves deadlock-freedom on valid lock ordering and catches Coffman circular wait deadlocks", () => {
+  // 1. Deadlock-prone Petri Net: Agent 1 locks Vault then Browser; Agent 2 locks Browser then Vault
+  const deadlockingNet = new PetriNetWorkflowVerifier({
+    places: [
+      { id: "p_a1_start", initialTokens: 1 },
+      { id: "p_a2_start", initialTokens: 1 },
+      { id: "mutex_vault", initialTokens: 1 },
+      { id: "mutex_browser", initialTokens: 1 },
+      { id: "p_a1_has_vault", initialTokens: 0 },
+      { id: "p_a2_has_browser", initialTokens: 0 },
+      { id: "p_goal", initialTokens: 0, isTerminalGoal: true }
+    ],
+    transitions: [
+      {
+        id: "t_a1_lock_vault",
+        name: "Agent 1 acquires Vault lock",
+        inputs: [{ placeId: "p_a1_start" }, { placeId: "mutex_vault" }],
+        outputs: [{ placeId: "p_a1_has_vault" }]
+      },
+      {
+        id: "t_a2_lock_browser",
+        name: "Agent 2 acquires Browser lock",
+        inputs: [{ placeId: "p_a2_start" }, { placeId: "mutex_browser" }],
+        outputs: [{ placeId: "p_a2_has_browser" }]
+      },
+      {
+        id: "t_a1_lock_browser_and_finish",
+        name: "Agent 1 acquires Browser lock and finishes",
+        inputs: [{ placeId: "p_a1_has_vault" }, { placeId: "mutex_browser" }],
+        outputs: [{ placeId: "mutex_vault" }, { placeId: "mutex_browser" }, { placeId: "p_goal" }]
+      },
+      {
+        id: "t_a2_lock_vault_and_finish",
+        name: "Agent 2 acquires Vault lock and finishes",
+        inputs: [{ placeId: "p_a2_has_browser" }, { placeId: "mutex_vault" }],
+        outputs: [{ placeId: "mutex_vault" }, { placeId: "mutex_browser" }, { placeId: "p_goal" }]
+      }
+    ]
+  });
+
+  const badReport = deadlockingNet.verifyReachability();
+  assert.equal(badReport.valid, false);
+  assert.equal(badReport.isDeadlockFree, false);
+  assert.ok(badReport.deadlocks.length >= 1);
+
+  // 2. Well-ordered concurrent fork-join workflow with shared mutex -> deadlock-free, 1-bounded, 0 dead transitions
+  const safeNet = new PetriNetWorkflowVerifier({
+    places: [
+      { id: "p_start", initialTokens: 1 },
+      { id: "p_worker_a", initialTokens: 0 },
+      { id: "p_worker_b", initialTokens: 0 },
+      { id: "mutex_db", initialTokens: 1, capacity: 1 },
+      { id: "p_done_a", initialTokens: 0 },
+      { id: "p_done_b", initialTokens: 0 },
+      { id: "p_goal", initialTokens: 0, isTerminalGoal: true }
+    ],
+    transitions: [
+      {
+        id: "t_fork",
+        name: "Fork parallel workers",
+        inputs: [{ placeId: "p_start" }],
+        outputs: [{ placeId: "p_worker_a" }, { placeId: "p_worker_b" }]
+      },
+      {
+        id: "t_run_a",
+        name: "Worker A atomic DB step",
+        inputs: [{ placeId: "p_worker_a" }, { placeId: "mutex_db" }],
+        outputs: [{ placeId: "p_done_a" }, { placeId: "mutex_db" }]
+      },
+      {
+        id: "t_run_b",
+        name: "Worker B atomic DB step",
+        inputs: [{ placeId: "p_worker_b" }, { placeId: "mutex_db" }],
+        outputs: [{ placeId: "p_done_b" }, { placeId: "mutex_db" }]
+      },
+      {
+        id: "t_join",
+        name: "Join workers to goal",
+        inputs: [{ placeId: "p_done_a" }, { placeId: "p_done_b" }],
+        outputs: [{ placeId: "p_goal" }]
+      }
+    ]
+  });
+
+  const safeReport = safeNet.verifyReachability();
+  assert.equal(safeReport.valid, true);
+  assert.equal(safeReport.isDeadlockFree, true);
+  assert.equal(safeReport.isKBounded, true);
+  assert.equal(safeReport.deadTransitions.length, 0);
+});
diff --git a/apps/api/test/self-healing-runtime-and-citation-graph.test.ts b/apps/api/test/self-healing-runtime-and-citation-graph.test.ts
new file mode 100644
index 0000000..d9c693b
--- /dev/null
+++ b/apps/api/test/self-healing-runtime-and-citation-graph.test.ts
@@ -0,0 +1,112 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import { SelfHealingWorkflowRuntime } from "../../../packages/db/src/self-healing-workflow-runtime.ts";
+import { VaultCrossCitationGraphEngine } from "../../../packages/db/src/vault-cross-citation-graph.ts";
+
+test("heals failed workflow DAG steps in-flight with remedial directives, enforces max 3 attempts, and resumes idempotently", async () => {
+  const sqlite = new DatabaseSync(":memory:");
+  const runtime = new SelfHealingWorkflowRuntime(sqlite);
+
+  const initial = runtime.initializeRunState({
+    runId: "run-heal-101",
+    workflowId: "wf-spec-report",
+    ownerId: "owner-1",
+    projectId: "proj-1",
+    nodeIds: ["step-extract", "step-summarize"]
+  });
+
+  assert.equal(initial.overallStatus, "running");
+  assert.equal(initial.stepStates["step-extract"].status, "pending");
+
+  // Step 1: fails on attempt 1, heals on attempt 2 using remedial directive
+  let extractCalls = 0;
+  const healRes = await runtime.executeStepWithSelfHealing({
+    runId: "run-heal-101",
+    stepId: "step-extract",
+    executeStepFn: async (attempt, directive) => {
+      extractCalls++;
+      if (attempt === 1) {
+        throw new Error("EMPTY_EXTRACTION_BUFFER");
+      }
+      assert.ok(directive && directive.includes("EMPTY_EXTRACTION_BUFFER"));
+      return { output: "Успешно извлечённые проверенные факты попытки 2." };
+    }
+  });
+
+  assert.equal(healRes.status, "completed");
+  assert.equal(healRes.attemptsUsed, 2);
+  assert.equal(healRes.wasHealed, true);
+  assert.match(healRes.output, /попытки 2/);
+
+  // Re-running step-extract resumes idempotently from SQLite checkpoint without re-executing
+  const resumedRes = await runtime.executeStepWithSelfHealing({
+    runId: "run-heal-101",
+    stepId: "step-extract",
+    executeStepFn: async () => {
+      throw new Error("SHOULD_NOT_BE_CALLED_WHEN_COMPLETED");
+    }
+  });
+  assert.equal(resumedRes.status, "completed");
+  assert.equal(resumedRes.attemptsUsed, 2);
+
+  // Step 2: fails all 3 attempts -> marked as 'failed'
+  let summarizeCalls = 0;
+  const failRes = await runtime.executeStepWithSelfHealing({
+    runId: "run-heal-101",
+    stepId: "step-summarize",
+    executeStepFn: async () => {
+      summarizeCalls++;
+      throw new Error("PERSISTENT_CRITIC_VETO");
+    }
+  });
+
+  assert.equal(failRes.status, "failed");
+  assert.equal(failRes.attemptsUsed, 3);
+  assert.equal(summarizeCalls, 3);
+});
+
+test("builds multi-document cross-citation graph and detects factual budget and date contradictions across documents", () => {
+  const engine = new VaultCrossCitationGraphEngine();
+
+  const documents = [
+    {
+      id: "doc-1",
+      filename: "Architecture-Overview.md",
+      format: "md",
+      text: "Основная архитектура Kosmora: бюджет проекта составляет $25 в месяц. Ссылка на документ: Release-Notes.md."
+    },
+    {
+      id: "doc-2",
+      filename: "Release-Notes.md",
+      format: "md",
+      text: "Примечания к выпуску: дедлайн релиза назначен на 2026-11-09. Архитектура описана в Architecture-Overview.md."
+    },
+    {
+      id: "doc-3",
+      filename: "Conflicting-Budget-Plan.md",
+      format: "md",
+      text: "Финансовый план Kosmora: согласованный бюджет проекта составляет $50 в месяц, а дедлайн релиза перенесён на 2026-11-20."
+    }
+  ];
+
+  const graph = engine.buildKnowledgeGraph(documents);
+
+  assert.equal(graph.documentCount, 3);
+  assert.ok(graph.totalSentences >= 4);
+
+  // Cross-citation links must include bidirectional references between doc-1 and doc-2
+  assert.ok(graph.citations.some((c) => c.sourceDocId === "doc-1" && c.targetDocId === "doc-2"));
+  assert.ok(graph.citations.some((c) => c.sourceDocId === "doc-2" && c.targetDocId === "doc-1"));
+
+  // Contradiction detection must identify the budget discrepancy ($25 vs $50) between doc-1 and doc-3
+  const budgetContradiction = graph.contradictions.find(
+    (c) =>
+      (c.docA.id === "doc-1" && c.docB.id === "doc-3") ||
+      (c.docA.id === "doc-3" && c.docB.id === "doc-1")
+  );
+  assert.ok(budgetContradiction, "Should detect budget contradiction between doc-1 and doc-3");
+  assert.equal(budgetContradiction.severity, "critical");
+  assert.match(budgetContradiction.discrepancyReason, /\$25/);
+  assert.match(budgetContradiction.discrepancyReason, /\$50/);
+});
diff --git a/apps/api/test/speculative-tool-router.test.ts b/apps/api/test/speculative-tool-router.test.ts
new file mode 100644
index 0000000..ecc90e1
--- /dev/null
+++ b/apps/api/test/speculative-tool-router.test.ts
@@ -0,0 +1,176 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  SpeculativeToolRouter,
+  parsePartialToolJson,
+  isReadOnlyTool,
+  DEFAULT_READ_ONLY_TOOLS
+} from "../../../packages/core/src/speculative-tool-router.js";
+
+test("parsePartialToolJson extracts tool names and partial or full arguments from streaming chunks", () => {
+  // 1. Incomplete XML format
+  const xmlChunk1 = "Thinking about the document... <tool_call><name>vault_read</name><args>{\"path\": \"/docs/rep";
+  const parsed1 = parsePartialToolJson(xmlChunk1);
+  assert.equal(parsed1.name, "vault_read");
+  assert.equal(parsed1.complete, false);
+
+  // 2. Complete XML format
+  const xmlChunk2 = "<tool_call><name>vault_read</name><args>{\"path\": \"/docs/report.docx\", \"maxChunks\": 5}</args></tool_call>";
+  const parsed2 = parsePartialToolJson(xmlChunk2);
+  assert.equal(parsed2.name, "vault_read");
+  assert.equal(parsed2.complete, true);
+  assert.deepEqual(parsed2.args, { path: "/docs/report.docx", maxChunks: 5 });
+
+  // 3. JSON format
+  const jsonChunk = "I will search context memory: {\"name\": \"context_memory_search\", \"arguments\": {\"query\": \"budget 2026\", \"limit\": 10}}";
+  const parsed3 = parsePartialToolJson(jsonChunk);
+  assert.equal(parsed3.name, "context_memory_search");
+  assert.equal(parsed3.complete, true);
+  assert.deepEqual(parsed3.args, { query: "budget 2026", limit: 10 });
+});
+
+test("isReadOnlyTool classifies safe vs mutating operations accurately", () => {
+  assert.equal(isReadOnlyTool("vault_read"), true);
+  assert.equal(isReadOnlyTool("context_memory_search"), true);
+  assert.equal(isReadOnlyTool("browser_page_inspect"), true);
+  assert.equal(isReadOnlyTool("dense_vector_search"), true);
+
+  assert.equal(isReadOnlyTool("desktop_click"), false);
+  assert.equal(isReadOnlyTool("drive_write"), false);
+  assert.equal(isReadOnlyTool("workflow_step_execute"), false);
+  assert.equal(isReadOnlyTool("account_payout"), false);
+});
+
+test("SpeculativeToolRouter executes safe read-only tools speculatively and yields instant resolution hits", async () => {
+  let executeCallCount = 0;
+  const router = new SpeculativeToolRouter({
+    executors: {
+      vault_read: async (args, ctx) => {
+        executeCallCount++;
+        // Simulate 40ms retrieval latency
+        await new Promise(r => setTimeout(r, 40));
+        return { content: `Extracted content for ${args.path}`, owner: ctx.ownerId };
+      }
+    }
+  });
+
+  const sessionId = "sess-spec-001";
+  const ownerId = "owner-alpha";
+
+  // Stream token chunks
+  const chunk1 = "Let me look up the vault file: <tool_call><name>vault_read</name><args>{\"path\": \"/vault/contract.docx\"";
+  const events1 = router.pushStreamChunk(sessionId, chunk1, { ownerId, callIndex: 0 });
+
+  assert.ok(events1.some(e => e.type === "intent_detected"));
+  assert.ok(events1.some(e => e.type === "speculation_started"));
+  assert.equal(executeCallCount, 1);
+
+  // Complete streaming
+  const chunk2 = "}</args></tool_call>";
+  router.pushStreamChunk(sessionId, chunk2, { ownerId, callIndex: 0 });
+
+  // Wait 50ms for background speculation to finish
+  await new Promise(r => setTimeout(r, 50));
+
+  // Now the LLM finalized the tool call with exact same args
+  const resolution = await router.resolveFinalToolCall(
+    sessionId,
+    0,
+    { name: "vault_read", args: { path: "/vault/contract.docx" } },
+    { ownerId }
+  );
+
+  assert.equal(resolution.speculativeHit, true);
+  assert.ok(resolution.timeSavedMs > 0, `Expected timeSavedMs > 0, got ${resolution.timeSavedMs}`);
+  assert.equal(resolution.result.owner, "owner-alpha");
+  assert.equal(resolution.result.content, "Extracted content for /vault/contract.docx");
+  assert.equal(executeCallCount, 1, "Executor should not have been called a second time");
+
+  const tel = router.getTelemetry(sessionId);
+  assert.equal(tel.speculativeHits, 1);
+  assert.equal(tel.speculativeMisses, 0);
+  assert.ok(tel.totalTimeSavedMs > 0);
+});
+
+test("SpeculativeToolRouter strictly defers mutating actions and does not execute them speculatively", async () => {
+  let mutatingExecuted = false;
+  const router = new SpeculativeToolRouter({
+    executors: {
+      desktop_click: async (args) => {
+        mutatingExecuted = true;
+        return { clicked: true, x: args.x, y: args.y };
+      }
+    }
+  });
+
+  const sessionId = "sess-mutating-002";
+  const ownerId = "owner-alpha";
+
+  // Streaming a mutating tool
+  const chunk = "<tool_call><name>desktop_click</name><args>{\"x\": 250, \"y\": 400}</args></tool_call>";
+  const events = router.pushStreamChunk(sessionId, chunk, { ownerId, callIndex: 0 });
+
+  assert.ok(events.some(e => e.type === "mutating_deferred"));
+  assert.equal(mutatingExecuted, false, "Mutating tool must NOT be executed speculatively");
+
+  // When final call is resolved, it executes safely through normal non-speculative path
+  const resolution = await router.resolveFinalToolCall(
+    sessionId,
+    0,
+    { name: "desktop_click", args: { x: 250, y: 400 } },
+    { ownerId }
+  );
+
+  assert.equal(resolution.speculativeHit, false);
+  assert.equal(mutatingExecuted, true);
+  assert.equal(resolution.result.clicked, true);
+
+  const tel = router.getTelemetry(sessionId);
+  assert.equal(tel.mutatingDeferred, 1);
+  assert.equal(tel.speculativeHits, 0);
+});
+
+test("SpeculativeToolRouter discards speculation on argument mismatch and aborts on session cancellation", async () => {
+  let aborted = false;
+  let runCount = 0;
+
+  const router = new SpeculativeToolRouter({
+    executors: {
+      vault_search: async (args, ctx) => {
+        runCount++;
+        if (ctx.signal) {
+          ctx.signal.addEventListener("abort", () => {
+            aborted = true;
+          });
+        }
+        await new Promise(r => setTimeout(r, 60));
+        return { matches: [args.query] };
+      }
+    }
+  });
+
+  const sessionId = "sess-mismatch-003";
+  const ownerId = "owner-beta";
+
+  // Initial speculation on "queryA"
+  router.pushStreamChunk(sessionId, "<tool_call><name>vault_search</name><args>{\"query\": \"queryA\"}", { ownerId, callIndex: 0 });
+  assert.equal(runCount, 1);
+
+  // LLM actually decided to finalize on "queryB"
+  const resolution = await router.resolveFinalToolCall(
+    sessionId,
+    0,
+    { name: "vault_search", args: { query: "queryB" } },
+    { ownerId }
+  );
+
+  assert.equal(resolution.speculativeHit, false);
+  assert.deepEqual(resolution.result, { matches: ["queryB"] });
+  assert.equal(runCount, 2);
+
+  // Abort test
+  const abortSessionId = "sess-abort-004";
+  router.pushStreamChunk(abortSessionId, "<tool_call><name>vault_search</name><args>{\"query\": \"cancelMe\"}", { ownerId, callIndex: 0 });
+  router.abortSession(abortSessionId);
+  assert.equal(aborted, true);
+});
