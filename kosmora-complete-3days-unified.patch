+import test from "node:test";
+import assert from "node:assert/strict";
+import { AdaptiveAiParameterController } from "../../../packages/core/src/adaptive-ai-parameter-controller.js";
+
+test("AdaptiveAiParameterController calibrates decoding parameters, scales thinking budgets, and adapts on retry loops", () => {
+  // 1. Deterministic Code & SQL profile on Fable 5 (1.0M context)
+  const codeParams = AdaptiveAiParameterController.computeHyperparameters({
+    taskKind: "deterministic_code_and_sql",
+    modelId: "claude-fable-5",
+    protocol: "openai-compatible",
+    estimatedPromptTokens: 12_000,
+    dagStepCount: 4,
+    toolDefinitionsCount: 6
+  });
+
+  assert.equal(codeParams.temperature, 0.05);
+  assert.equal(codeParams.contextWindowTokens, 1_000_000);
+  assert.ok(codeParams.thinkingBudgetTokens >= 8192);
+  assert.equal(codeParams.reasoningEffort, "high");
+
+  // 2. Sol 1.05M window resolution & Anthropic extended thinking temperature invariant
+  const solParams = AdaptiveAiParameterController.computeHyperparameters({
+    taskKind: "analytical_research_and_grounding",
+    modelId: "sol-1.05m-preview",
+    protocol: "anthropic-compatible",
+    estimatedPromptTokens: 50_000,
+    dagStepCount: 6,
+    toolDefinitionsCount: 8
+  });
+
+  assert.equal(solParams.contextWindowTokens, 1_050_000);
+  assert.equal(solParams.temperature, 1.0); // Enforced by anthropic-compatible when thinkingBudgetTokens >= 1024
+  assert.equal(solParams.reasoningEffort, "max");
+
+  // 3. Self-healing retry adaptation on repetition_loop and tool_schema_error
+  const retryLoopParams = AdaptiveAiParameterController.computeHyperparameters({
+    taskKind: "manager_dag_planning",
+    estimatedPromptTokens: 5_000,
+    retryAttempt: 2,
+    previousFailureReason: "repetition_loop"
+  });
+  assert.ok(retryLoopParams.repetitionPenalty > 1.2);
+  assert.ok(retryLoopParams.frequencyPenalty >= 0.4);
+
+  const retrySchemaParams = AdaptiveAiParameterController.computeHyperparameters({
+    taskKind: "creative_synthesis_and_brainstorm",
+    estimatedPromptTokens: 5_000,
+    retryAttempt: 2,
+    previousFailureReason: "tool_schema_error"
+  });
+  assert.ok(retrySchemaParams.temperature < 0.25);
+
+  // 4. Degenerate 4-gram repetition loop detector
+  const normalText =
+    "The Kosmora hybrid retrieval engine combines BM25 lexical scores with 64-dimensional dense semantic vectors and Roaring Bitmap phrase filters.";
+  const normalAudit = AdaptiveAiParameterController.detectRepetitionLoop(normalText);
+  assert.equal(normalAudit.loopDetected, false);
+
+  const loopingText =
+    "We must verify the vault snapshot now. " +
+    "verify the vault snapshot ".repeat(7);
+  const loopAudit = AdaptiveAiParameterController.detectRepetitionLoop(loopingText, 5);
+  assert.equal(loopAudit.loopDetected, true);
+  assert.ok(loopAudit.repeatCount >= 5);
+});
diff --git a/apps/api/test/cdc-ast-and-bandit-router.test.ts b/apps/api/test/cdc-ast-and-bandit-router.test.ts
