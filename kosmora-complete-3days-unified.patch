diff --git a/apps/api/src/cloud-storage/full-account-emergency-snapshot.ts b/apps/api/src/cloud-storage/full-account-emergency-snapshot.ts
new file mode 100644
index 0000000..a19aa70
--- /dev/null
+++ b/apps/api/src/cloud-storage/full-account-emergency-snapshot.ts
@@ -0,0 +1,307 @@
+import { createHash } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import {
+  buildCanonicalStoreZipSnapshot,
+  parseAndVerifyCanonicalStoreZip,
+  type CanonicalSnapshotManifest,
+  type SnapshotPayloadData
+} from "./google-drive-journal-recovery-and-zip-import.ts";
+
+export interface FullAccountEmergencySnapshotSummary {
+  snapshotId: string;
+  ownerId: string;
+  archiveSha256: string;
+  payloadSha256: string;
+  zipSizeBytes: number;
+  partCount: number;
+  counts: {
+    chats: number;
+    messages: number;
+    workFiles: number;
+    memories: number;
+  };
+}
+
+export interface FullAccountRestoreResult {
+  snapshotId: string;
+  ownerId: string;
+  restoredChats: number;
+  restoredMessages: number;
+  restoredWorkFiles: number;
+  restoredMemories: number;
+  interruptedMessagesQuiesced: number;
+}
+
+/**
+ * Full-Account Emergency Snapshot Builder & Atomic Restorer
+ * (closes the scope limitation in `KOSMORA_DRIVE_BACKUP_RESTORE_2026-11-02_RU.md` where snapshots
+ * only covered selected individual chats/results rather than a complete owner account disaster recovery dump).
+ */
+export class FullAccountEmergencySnapshotService {
+  constructor(private readonly sqlite: DatabaseSync) {
+    this.ensureSchema();
+  }
+
+  ensureSchema(): void {
+    this.sqlite.exec(`
+      CREATE TABLE IF NOT EXISTS general_chats (
+        id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        title TEXT NOT NULL,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS general_chat_messages (
+        id TEXT PRIMARY KEY NOT NULL,
+        chat_id TEXT NOT NULL,
+        owner_id TEXT NOT NULL,
+        role TEXT NOT NULL,
+        content_type TEXT NOT NULL,
+        content TEXT NOT NULL,
+        status TEXT NOT NULL,
+        client_message_id TEXT,
+        run_id TEXT,
+        error_code TEXT,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS work_artifact_versions (
+        id TEXT PRIMARY KEY NOT NULL,
+        project_id TEXT NOT NULL,
+        work_id TEXT NOT NULL,
+        name TEXT NOT NULL,
+        version INTEGER NOT NULL,
+        content TEXT NOT NULL,
+        sha256 TEXT NOT NULL,
+        bytes INTEGER NOT NULL,
+        published INTEGER NOT NULL DEFAULT 1,
+        created_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS context_memory_entries (
+        id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        scope TEXT NOT NULL,
+        chat_id TEXT,
+        project_id TEXT,
+        kind TEXT NOT NULL,
+        title TEXT NOT NULL,
+        content TEXT NOT NULL,
+        pinned INTEGER NOT NULL DEFAULT 0,
+        expires_at TEXT,
+        source_chat_message_id TEXT,
+        source_project_message_id TEXT,
+        source_json TEXT NOT NULL DEFAULT '{}',
+        version INTEGER NOT NULL DEFAULT 1,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL,
+        creation_key TEXT,
+        creation_sha256 TEXT
+      );
+    `);
+  }
+
+  exportFullAccountEmergencyZip(
+    ownerId: string,
+    snapshotId = `emergency-${Date.now()}`
+  ): {
+    zipBuffer: Buffer;
+    manifest: CanonicalSnapshotManifest;
+    summary: FullAccountEmergencySnapshotSummary;
+  } {
+    const chats = this.sqlite
+      .prepare(
+        "SELECT id, title, created_at, updated_at FROM general_chats WHERE owner_id = ? ORDER BY created_at ASC, id ASC"
+      )
+      .all(ownerId) as SnapshotPayloadData["chats"];
+
+    const messages = this.sqlite
+      .prepare(
+        "SELECT id, chat_id, role, content, content_type, status, created_at FROM general_chat_messages WHERE owner_id = ? ORDER BY created_at ASC, id ASC"
+      )
+      .all(ownerId) as SnapshotPayloadData["messages"];
+
+    const workFiles = this.sqlite
+      .prepare(
+        "SELECT id, project_id, work_id, name, content, sha256, bytes, created_at FROM work_artifact_versions WHERE published = 1 ORDER BY created_at ASC, id ASC"
+      )
+      .all() as NonNullable<SnapshotPayloadData["workFiles"]>;
+
+    const rawMemories = this.sqlite
+      .prepare(
+        "SELECT id, scope, kind, title, content, pinned, source_json FROM context_memory_entries WHERE owner_id = ? ORDER BY created_at ASC, id ASC"
+      )
+      .all(ownerId) as Array<{
+      id: string;
+      scope: "personal" | "chat" | "project";
+      kind: string;
+      title: string;
+      content: string;
+      pinned: number;
+      source_json: string;
+    }>;
+
+    const memories = rawMemories.map((m) => ({
+      ...m,
+      pinned: Boolean(m.pinned)
+    }));
+
+    const payload: SnapshotPayloadData = {
+      ownerId,
+      chats,
+      messages,
+      workFiles,
+      memories
+    };
+
+    const { zipBuffer, archiveSha256, manifest } = buildCanonicalStoreZipSnapshot(
+      snapshotId,
+      payload
+    );
+
+    return {
+      zipBuffer,
+      manifest,
+      summary: {
+        snapshotId,
+        ownerId,
+        archiveSha256,
+        payloadSha256: manifest.payloadSha256,
+        zipSizeBytes: zipBuffer.byteLength,
+        partCount: manifest.parts.length,
+        counts: {
+          chats: chats.length,
+          messages: messages.length,
+          workFiles: workFiles.length,
+          memories: memories.length
+        }
+      }
+    };
+  }
+
+  restoreFullAccountEmergencyZip(
+    ownerId: string,
+    zipBuffer: Buffer
+  ): FullAccountRestoreResult {
+    const { manifest, payload } = parseAndVerifyCanonicalStoreZip(zipBuffer);
+    if (manifest.ownerId !== ownerId || payload.ownerId !== ownerId) {
+      throw new Error("EMERGENCY_SNAPSHOT_OWNER_MISMATCH");
+    }
+
+    let restoredChats = 0;
+    let restoredMessages = 0;
+    let restoredWorkFiles = 0;
+    let restoredMemories = 0;
+    let interruptedMessagesQuiesced = 0;
+    const now = new Date().toISOString();
+
+    this.sqlite.exec("BEGIN IMMEDIATE");
+    try {
+      const insertChat = this.sqlite.prepare(
+        `INSERT OR IGNORE INTO general_chats (id, owner_id, title, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?)`
+      );
+      for (const c of payload.chats) {
+        const res = insertChat.run(c.id, ownerId, c.title, c.created_at, c.updated_at);
+        if (res.changes > 0) restoredChats++;
+      }
+
+      const insertMsg = this.sqlite.prepare(
+        `INSERT OR IGNORE INTO general_chat_messages (
+          id, chat_id, owner_id, role, content_type, content, status,
+          client_message_id, run_id, error_code, created_at, updated_at
+        ) VALUES (?, ?, ?, ?, ?, ?, ?, NULL, NULL, NULL, ?, ?)`
+      );
+      for (const m of payload.messages) {
+        let status = m.status ?? "completed";
+        if (status === "pending" || status === "streaming") {
+          status = "cancelled";
+          interruptedMessagesQuiesced++;
+        }
+        const res = insertMsg.run(
+          m.id,
+          m.chat_id,
+          ownerId,
+          m.role,
+          m.content_type ?? "text",
+          m.content,
+          status,
+          m.created_at,
+          now
+        );
+        if (res.changes > 0) restoredMessages++;
+      }
+
+      if (Array.isArray(payload.workFiles)) {
+        const insertWf = this.sqlite.prepare(
+          `INSERT OR IGNORE INTO work_artifact_versions (
+            id, project_id, work_id, name, version, content, sha256, bytes, published, created_at
+          ) VALUES (?, ?, ?, ?, 1, ?, ?, ?, 1, ?)`
+        );
+        for (const wf of payload.workFiles) {
+          const actualSha = createHash("sha256").update(wf.content, "utf8").digest("hex");
+          if (actualSha !== wf.sha256) {
+            throw new Error(`EMERGENCY_WORK_FILE_SHA256_MISMATCH:${wf.name}`);
+          }
+          const res = insertWf.run(
+            wf.id,
+            wf.project_id,
+            wf.work_id,
+            wf.name,
+            wf.content,
+            wf.sha256,
+            wf.bytes,
+            wf.created_at
+          );
+          if (res.changes > 0) restoredWorkFiles++;
+        }
+      }
+
+      if (Array.isArray(payload.memories)) {
+        const insertMem = this.sqlite.prepare(
+          `INSERT OR IGNORE INTO context_memory_entries (
+            id, owner_id, scope, chat_id, project_id, kind, title, content, pinned,
+            expires_at, source_chat_message_id, source_project_message_id, source_json,
+            version, created_at, updated_at, creation_key, creation_sha256
+          ) VALUES (?, ?, ?, NULL, NULL, ?, ?, ?, ?, NULL, NULL, NULL, ?, 1, ?, ?, ?, ?)`
+        );
+        for (const mem of payload.memories) {
+          const sha = createHash("sha256").update(mem.content, "utf8").digest("hex");
+          const res = insertMem.run(
+            mem.id,
+            ownerId,
+            mem.scope,
+            mem.kind,
+            mem.title,
+            mem.content,
+            Number(Boolean(mem.pinned)),
+            mem.source_json || "{}",
+            now,
+            now,
+            `emergency-restore:${mem.id}`,
+            sha
+          );
+          if (res.changes > 0) restoredMemories++;
+        }
+      }
+
+      this.sqlite.exec("COMMIT");
+    } catch (err) {
+      try {
+        this.sqlite.exec("ROLLBACK");
+      } catch {
+        // ignore
+      }
+      throw err;
+    }
+
+    return {
+      snapshotId: manifest.snapshotId,
+      ownerId,
+      restoredChats,
+      restoredMessages,
+      restoredWorkFiles,
+      restoredMemories,
+      interruptedMessagesQuiesced
+    };
+  }
+}
diff --git a/apps/api/src/cloud-storage/google-drive-archive-builder.ts b/apps/api/src/cloud-storage/google-drive-archive-builder.ts
new file mode 100644
index 0000000..92ba0e1
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-archive-builder.ts
@@ -0,0 +1,421 @@
+import { createHash, randomUUID } from "node:crypto";
+import { createArchive, verifiedOriginal } from "../account-settings/privacy/archive.js";
+import type {
+  OriginalBinary,
+  OwnerPrivacyCoordinator,
+  PrivacySection
+} from "../account-settings/privacy/coordinator.js";
+import { DRIVE_ARCHIVE_MAX_BYTES } from "./google-drive.js";
+
+export const DRIVE_BACKUP_SCHEMA_VERSION = 1;
+const MAX_PART_PAYLOAD_BYTES = 3 * 1024 * 1024; // 3 MiB payload budget so ZIP + manifest stays well below 4 MiB
+const ORIGINAL_CHUNK_BYTES = 2 * 1024 * 1024; // 2 MiB per binary chunk
+
+const FORBIDDEN_SECTIONS = new Set([
+  "cloud-storage",
+  "policy-projects",
+  "agent-studio",
+  "code",
+  "work",
+  "computer-control"
+]);
+
+const FORBIDDEN_COLLECTIONS = new Set([
+  "sessions",
+  "identity_sessions",
+  "step_up_proofs",
+  "credentials",
+  "owner_credentials",
+  "delete_challenges",
+  "connections",
+  "kosmora_drive_connections",
+  "kosmora_drive_archives",
+  "policies",
+  "point_overrides",
+  "autonomy_profiles",
+  "confirmations",
+  "work_runs",
+  "work_dag_runs",
+  "code_agent_runs",
+  "computer_tasks"
+]);
+
+const SENSITIVE_KEY_PATTERN =
+  /(?:grant_ciphertext|access_?token|refresh_?token|password|passwd|secret|api_?key|private_?key|session_?token|confirmation_?token|bearer|authorization|cookie)/i;
+
+const FORBIDDEN_FILENAME_PATTERN = /\.(?:sqlite|sqlite3|db|db-wal|db-shm|pem|key|pfx|p12|env)$/i;
+
+export interface DriveBackupOriginalChunkRef {
+  chunkIndex: number;
+  totalChunks: number;
+  partIndex: number;
+  entryPath: string;
+  sizeBytes: number;
+  sha256: string;
+}
+
+export interface DriveBackupOriginalManifest {
+  store: string;
+  id: string;
+  filename: string;
+  contentType: string;
+  sizeBytes: number;
+  sha256: string;
+  chunks: DriveBackupOriginalChunkRef[];
+}
+
+export interface DriveBackupPartSummary {
+  partIndex: number;
+  totalParts: number;
+  operationId: string;
+  sizeBytes: number;
+  sha256: string;
+}
+
+export interface DriveBackupManifest {
+  schemaVersion: typeof DRIVE_BACKUP_SCHEMA_VERSION;
+  backupSetId: string;
+  ownerId: string;
+  generatedAt: string;
+  partIndex: number;
+  totalParts: number;
+  operationId: string;
+  restorableCollections: Record<string, Record<string, number>>;
+  originals: DriveBackupOriginalManifest[];
+  excludedCategories: string[];
+  parts?: DriveBackupPartSummary[];
+}
+
+export interface AssembledDriveArchivePart {
+  backupSetId: string;
+  partIndex: number;
+  totalParts: number;
+  operationId: string;
+  bytes: Buffer;
+  sizeBytes: number;
+  sha256: string;
+  manifest: DriveBackupManifest;
+}
+
+export interface AssembledDriveBackupSet {
+  backupSetId: string;
+  ownerId: string;
+  generatedAt: string;
+  totalParts: number;
+  totalBytes: number;
+  parts: AssembledDriveArchivePart[];
+}
+
+function sanitizeRecordValue(value: unknown, keyName = ""): unknown {
+  if (keyName && SENSITIVE_KEY_PATTERN.test(keyName)) {
+    throw new Error(`DRIVE_ARCHIVE_SECRET_REJECTED:${keyName}`);
+  }
+  if (value === null || value === undefined) return value;
+  if (typeof value === "string") {
+    if (
+      /^(?:Bearer\s+\S+|v1:[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----)/.test(
+        value
+      )
+    ) {
+      throw new Error("DRIVE_ARCHIVE_SECRET_VALUE_REJECTED");
+    }
+    return value;
+  }
+  if (typeof value === "number" || typeof value === "boolean") return value;
+  if (Array.isArray(value)) {
+    return value.map((item) => sanitizeRecordValue(item));
+  }
+  if (typeof value === "object") {
+    const out: Record<string, unknown> = {};
+    for (const [k, v] of Object.entries(value as Record<string, unknown>)) {
+      if (SENSITIVE_KEY_PATTERN.test(k)) {
+        continue;
+      }
+      out[k] = sanitizeRecordValue(v, k);
+    }
+    return out;
+  }
+  return String(value);
+}
+
+export function sanitizeExportSectionsForDrive(
+  sections: Record<string, PrivacySection>
+): {
+  restorableSections: Record<string, Record<string, Record<string, unknown>[]>>;
+  originalsToPack: { store: string; descriptor: OriginalBinary }[];
+} {
+  const restorableSections: Record<string, Record<string, Record<string, unknown>[]>> = {};
+  const originalsToPack: { store: string; descriptor: OriginalBinary }[] = [];
+
+  for (const [sectionName, section] of Object.entries(sections)) {
+    if (!section.complete) {
+      throw new Error(`DRIVE_ARCHIVE_INCOMPLETE_SECTION:${sectionName}`);
+    }
+    if (FORBIDDEN_SECTIONS.has(sectionName)) {
+      continue;
+    }
+
+    const cleanedCollections: Record<string, Record<string, unknown>[]> = {};
+    for (const [collectionName, rows] of Object.entries(section.records)) {
+      if (FORBIDDEN_COLLECTIONS.has(collectionName)) {
+        continue;
+      }
+      cleanedCollections[collectionName] = rows.map(
+        (row) => sanitizeRecordValue(row) as Record<string, unknown>
+      );
+    }
+
+    if (Object.keys(cleanedCollections).length > 0) {
+      restorableSections[sectionName] = cleanedCollections;
+    }
+
+    for (const orig of section.originals) {
+      if (FORBIDDEN_FILENAME_PATTERN.test(orig.filename)) {
+        throw new Error(`DRIVE_ARCHIVE_FORBIDDEN_BINARY:${orig.filename}`);
+      }
+      originalsToPack.push({ store: sectionName, descriptor: orig });
+    }
+  }
+
+  return { restorableSections, originalsToPack };
+}
+
+export function formatBackupSetOperationId(
+  backupSetId: string,
+  partIndex: number,
+  totalParts: number
+): string {
+  return `set_${backupSetId}_part_${String(partIndex).padStart(3, "0")}_of_${String(totalParts).padStart(3, "0")}`;
+}
+
+export function parseBackupSetOperationId(operationId: string): {
+  backupSetId: string;
+  partIndex: number;
+  totalParts: number;
+} | null {
+  const match = /^set_([a-zA-Z0-9_-]{6,64})_part_(\d{3})_of_(\d{3})$/.exec(operationId);
+  if (!match) return null;
+  const partIndex = Number(match[2]);
+  const totalParts = Number(match[3]);
+  if (
+    !Number.isSafeInteger(partIndex) ||
+    !Number.isSafeInteger(totalParts) ||
+    partIndex < 1 ||
+    totalParts < 1 ||
+    partIndex > totalParts
+  ) {
+    return null;
+  }
+  return {
+    backupSetId: match[1]!,
+    partIndex,
+    totalParts
+  };
+}
+
+export async function buildDriveArchiveSetFromCoordinator(
+  coordinator: Pick<OwnerPrivacyCoordinator, "export" | "binary">,
+  ownerId: string,
+  options: {
+    backupSetId?: string;
+    maxOriginalBytes?: number;
+    now?: () => string;
+  } = {}
+): Promise<AssembledDriveBackupSet> {
+  const exported = await coordinator.export(ownerId);
+  if (!exported.complete) {
+    throw new Error("DRIVE_ARCHIVE_EXPORT_INCOMPLETE");
+  }
+
+  const backupSetId = options.backupSetId ?? randomUUID().replace(/-/g, "").slice(0, 16);
+  if (!/^[a-zA-Z0-9_-]{6,64}$/.test(backupSetId)) {
+    throw new Error("INVALID_BACKUP_SET_ID");
+  }
+  const generatedAt = options.now ? options.now() : exported.generated_at;
+  const maxOriginalBytes = options.maxOriginalBytes ?? 25 * 1024 * 1024;
+
+  const { restorableSections, originalsToPack } = sanitizeExportSectionsForDrive(exported.sections);
+
+  const restorableCollections: Record<string, Record<string, number>> = {};
+  for (const [sec, cols] of Object.entries(restorableSections)) {
+    restorableCollections[sec] = Object.fromEntries(
+      Object.entries(cols).map(([col, rows]) => [col, rows.length])
+    );
+  }
+
+  // Stage payload items: first records.json, then verified original chunks
+  const stagedPayloads: {
+    path: string;
+    bytes: Buffer;
+    originalMeta?: {
+      store: string;
+      descriptor: OriginalBinary;
+      chunkIndex: number;
+      totalChunks: number;
+      chunkSha256: string;
+    };
+  }[] = [];
+
+  const recordsBytes = Buffer.from(JSON.stringify(restorableSections, null, 2), "utf8");
+  if (recordsBytes.byteLength > MAX_PART_PAYLOAD_BYTES) {
+    // Split sections across separate JSON files if records alone are large
+    for (const [sectionName, cols] of Object.entries(restorableSections)) {
+      const secBytes = Buffer.from(JSON.stringify({ [sectionName]: cols }, null, 2), "utf8");
+      if (secBytes.byteLength > MAX_PART_PAYLOAD_BYTES) {
+        throw new Error("DRIVE_ARCHIVE_SECTION_TOO_LARGE");
+      }
+      stagedPayloads.push({
+        path: `records/${sectionName}.json`,
+        bytes: secBytes
+      });
+    }
+  } else {
+    stagedPayloads.push({
+      path: "records/all.json",
+      bytes: recordsBytes
+    });
+  }
+
+  const originalManifestMap = new Map<string, DriveBackupOriginalManifest>();
+
+  for (const { store, descriptor } of originalsToPack) {
+    const bin = await coordinator.binary(ownerId, store, descriptor.id);
+    if (!bin) {
+      throw new Error(`DRIVE_ARCHIVE_MISSING_ORIGINAL:${store}/${descriptor.id}`);
+    }
+    const verifiedBytes = await verifiedOriginal(bin.stream, descriptor, maxOriginalBytes);
+    const totalChunks = Math.max(1, Math.ceil(verifiedBytes.byteLength / ORIGINAL_CHUNK_BYTES));
+    const safeId = descriptor.id.replace(/[^a-zA-Z0-9._-]/g, "_").slice(0, 80);
+    const key = `${store}:${descriptor.id}`;
+
+    originalManifestMap.set(key, {
+      store,
+      id: descriptor.id,
+      filename: descriptor.filename,
+      contentType: descriptor.content_type,
+      sizeBytes: verifiedBytes.byteLength,
+      sha256: descriptor.sha256.toLowerCase(),
+      chunks: []
+    });
+
+    for (let idx = 0; idx < totalChunks; idx += 1) {
+      const start = idx * ORIGINAL_CHUNK_BYTES;
+      const end = Math.min(start + ORIGINAL_CHUNK_BYTES, verifiedBytes.byteLength);
+      const chunkBuf = verifiedBytes.subarray(start, end);
+      const chunkSha256 = createHash("sha256").update(chunkBuf).digest("hex");
+      const entryPath = `originals/${store}/${safeId}.part${String(idx + 1).padStart(3, "0")}`;
+      stagedPayloads.push({
+        path: entryPath,
+        bytes: chunkBuf,
+        originalMeta: {
+          store,
+          descriptor,
+          chunkIndex: idx + 1,
+          totalChunks,
+          chunkSha256
+        }
+      });
+    }
+  }
+
+  // Group staged payloads into bins of <= MAX_PART_PAYLOAD_BYTES
+  const bins: (typeof stagedPayloads)[] = [];
+  let currentBin: typeof stagedPayloads = [];
+  let currentBinBytes = 0;
+
+  for (const item of stagedPayloads) {
+    if (
+      currentBin.length > 0 &&
+      currentBinBytes + item.bytes.byteLength > MAX_PART_PAYLOAD_BYTES
+    ) {
+      bins.push(currentBin);
+      currentBin = [];
+      currentBinBytes = 0;
+    }
+    currentBin.push(item);
+    currentBinBytes += item.bytes.byteLength;
+  }
+  if (currentBin.length > 0 || bins.length === 0) {
+    bins.push(currentBin);
+  }
+
+  const totalParts = bins.length;
+
+  // Record which partIndex each original chunk landed in
+  bins.forEach((bin, binIdx) => {
+    const partIndex = binIdx + 1;
+    for (const item of bin) {
+      if (item.originalMeta) {
+        const key = `${item.originalMeta.store}:${item.originalMeta.descriptor.id}`;
+        const manifestEntry = originalManifestMap.get(key);
+        manifestEntry?.chunks.push({
+          chunkIndex: item.originalMeta.chunkIndex,
+          totalChunks: item.originalMeta.totalChunks,
+          partIndex,
+          entryPath: item.path,
+          sizeBytes: item.bytes.byteLength,
+          sha256: item.originalMeta.chunkSha256
+        });
+      }
+    }
+  });
+
+  const originalsManifestList = [...originalManifestMap.values()];
+  const excludedCategories = [
+    "sqlite_database_files",
+    "oauth_and_session_tokens",
+    "system_secrets",
+    "permissions_and_policy_grants",
+    "active_background_tasks",
+    "drive_connection_grants",
+    "computer_execution_commands"
+  ];
+
+  const assembledParts: AssembledDriveArchivePart[] = [];
+  let totalBytes = 0;
+
+  for (let i = 0; i < totalParts; i += 1) {
+    const partIndex = i + 1;
+    const operationId = formatBackupSetOperationId(backupSetId, partIndex, totalParts);
+    const manifest: DriveBackupManifest = {
+      schemaVersion: DRIVE_BACKUP_SCHEMA_VERSION,
+      backupSetId,
+      ownerId,
+      generatedAt,
+      partIndex,
+      totalParts,
+      operationId,
+      restorableCollections,
+      originals: originalsManifestList,
+      excludedCategories
+    };
+    const manifestBytes = Buffer.from(JSON.stringify(manifest, null, 2), "utf8");
+    const zipEntries = [
+      { path: "manifest.json", bytes: manifestBytes },
+      ...bins[i]!.map((item) => ({ path: item.path, bytes: item.bytes }))
+    ];
+    const zipBuffer = createArchive(zipEntries, DRIVE_ARCHIVE_MAX_BYTES);
+    const sha256 = createHash("sha256").update(zipBuffer).digest("hex");
+    totalBytes += zipBuffer.byteLength;
+
+    assembledParts.push({
+      backupSetId,
+      partIndex,
+      totalParts,
+      operationId,
+      bytes: zipBuffer,
+      sizeBytes: zipBuffer.byteLength,
+      sha256,
+      manifest
+    });
+  }
+
+  return {
+    backupSetId,
+    ownerId,
+    generatedAt,
+    totalParts,
+    totalBytes,
+    parts: assembledParts
+  };
+}
diff --git a/apps/api/src/cloud-storage/google-drive-authorization.ts b/apps/api/src/cloud-storage/google-drive-authorization.ts
new file mode 100644
index 0000000..c0e9b41
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-authorization.ts
@@ -0,0 +1,218 @@
+import { createHash, randomBytes } from "node:crypto";
+import { DRIVE_FILE_SCOPE, readBoundedDriveBody } from "./google-drive.js";
+
+export interface DriveGrant {
+  accessToken: string;
+  refreshToken: string;
+  expiresAt: number;
+  scope: typeof DRIVE_FILE_SCOPE;
+}
+
+export function validDriveGrant(v: unknown): v is DriveGrant {
+  if (!v || typeof v !== "object") return false;
+  const g = v as Record<string, unknown>;
+  return (
+    typeof g.accessToken === "string" &&
+    g.accessToken.length > 0 &&
+    typeof g.refreshToken === "string" &&
+    g.refreshToken.length > 0 &&
+    typeof g.expiresAt === "number" &&
+    Number.isFinite(g.expiresAt) &&
+    g.scope === DRIVE_FILE_SCOPE
+  );
+}
+
+interface PendingState {
+  ownerId: string;
+  sessionId: string;
+  codeVerifier: string;
+  expiresAt: number;
+}
+
+const STATE_TTL_MS = 10 * 60 * 1000;
+const OAUTH_MAX_BYTES = 32 * 1024;
+
+export class GoogleDriveAuthorization {
+  private readonly clientId: string;
+  private readonly clientSecret: string;
+  private readonly redirectUri: string;
+  private readonly request: typeof fetch;
+  private readonly now: () => number;
+  private readonly pending = new Map<string, PendingState>();
+  private readonly inFlightCodes = new Set<string>();
+
+  constructor(options: {
+    clientId: string;
+    clientSecret: string;
+    redirectUri: string;
+    request?: typeof fetch;
+    now?: () => number;
+  }) {
+    if (!options.clientId || !options.clientSecret || !options.redirectUri) {
+      throw new Error("DRIVE_OAUTH_CONFIGURATION_REQUIRED");
+    }
+    this.clientId = options.clientId;
+    this.clientSecret = options.clientSecret;
+    this.redirectUri = options.redirectUri;
+    this.request = options.request ?? fetch;
+    this.now = options.now ?? Date.now;
+  }
+
+  private pruneExpired(): void {
+    const current = this.now();
+    for (const [state, record] of this.pending.entries()) {
+      if (record.expiresAt <= current) {
+        this.pending.delete(state);
+      }
+    }
+  }
+
+  begin(input: { ownerId: string; sessionId: string }): { url: string; state: string } {
+    if (!input.ownerId || !input.sessionId) {
+      throw new Error("DRIVE_AUTH_CONTEXT_REQUIRED");
+    }
+    this.pruneExpired();
+    const state = randomBytes(24).toString("base64url");
+    const codeVerifier = randomBytes(32).toString("base64url");
+    const codeChallenge = createHash("sha256").update(codeVerifier).digest("base64url");
+
+    this.pending.set(state, {
+      ownerId: input.ownerId,
+      sessionId: input.sessionId,
+      codeVerifier,
+      expiresAt: this.now() + STATE_TTL_MS
+    });
+
+    const params = new URLSearchParams({
+      client_id: this.clientId,
+      redirect_uri: this.redirectUri,
+      response_type: "code",
+      scope: DRIVE_FILE_SCOPE,
+      access_type: "offline",
+      prompt: "consent",
+      include_granted_scopes: "false",
+      state,
+      code_challenge: codeChallenge,
+      code_challenge_method: "S256"
+    });
+
+    return {
+      url: `https://accounts.google.com/o/oauth2/v2/auth?${params.toString()}`,
+      state
+    };
+  }
+
+  async finish(input: {
+    ownerId: string;
+    sessionId: string;
+    state: string;
+    code: string;
+  }): Promise<DriveGrant> {
+    this.pruneExpired();
+    const record = this.pending.get(input.state);
+    this.pending.delete(input.state);
+
+    if (!record || record.expiresAt <= this.now()) {
+      throw new Error("DRIVE_OAUTH_STATE_INVALID");
+    }
+    if (record.ownerId !== input.ownerId || record.sessionId !== input.sessionId) {
+      throw new Error("DRIVE_OAUTH_SESSION_MISMATCH");
+    }
+    if (typeof input.code !== "string" || !input.code.trim()) {
+      throw new Error("DRIVE_OAUTH_CODE_REQUIRED");
+    }
+    if (this.inFlightCodes.has(input.code)) {
+      throw new Error("DRIVE_OAUTH_CODE_REPLAYED");
+    }
+
+    this.inFlightCodes.add(input.code);
+    try {
+      const body = new URLSearchParams({
+        client_id: this.clientId,
+        client_secret: this.clientSecret,
+        redirect_uri: this.redirectUri,
+        grant_type: "authorization_code",
+        code: input.code,
+        code_verifier: record.codeVerifier
+      });
+
+      const response = await this.request("https://oauth2.googleapis.com/token", {
+        method: "POST",
+        headers: { "Content-Type": "application/x-www-form-urlencoded" },
+        body: body.toString(),
+        redirect: "error"
+      });
+      if (!response.ok) {
+        throw new Error("DRIVE_OAUTH_EXCHANGE_FAILED");
+      }
+      const raw = await readBoundedDriveBody(response, OAUTH_MAX_BYTES);
+      const parsed = JSON.parse(raw.toString("utf8")) as Record<string, unknown>;
+      const accessToken = parsed.access_token;
+      const refreshToken = parsed.refresh_token;
+      const expiresIn = Number(parsed.expires_in);
+      const scope = String(parsed.scope ?? "");
+      const scopes = scope.split(/\s+/).filter(Boolean);
+
+      if (
+        typeof accessToken !== "string" ||
+        !accessToken ||
+        typeof refreshToken !== "string" ||
+        !refreshToken ||
+        !Number.isFinite(expiresIn) ||
+        expiresIn <= 0 ||
+        !scopes.includes(DRIVE_FILE_SCOPE)
+      ) {
+        throw new Error("DRIVE_OAUTH_INVALID_GRANT");
+      }
+
+      return {
+        accessToken,
+        refreshToken,
+        expiresAt: this.now() + Math.floor(expiresIn * 1000),
+        scope: DRIVE_FILE_SCOPE
+      };
+    } finally {
+      this.inFlightCodes.delete(input.code);
+    }
+  }
+
+  async refresh(grant: DriveGrant): Promise<DriveGrant> {
+    if (!validDriveGrant(grant)) {
+      throw new Error("INVALID_DRIVE_GRANT");
+    }
+    const body = new URLSearchParams({
+      client_id: this.clientId,
+      client_secret: this.clientSecret,
+      grant_type: "refresh_token",
+      refresh_token: grant.refreshToken
+    });
+    const response = await this.request("https://oauth2.googleapis.com/token", {
+      method: "POST",
+      headers: { "Content-Type": "application/x-www-form-urlencoded" },
+      body: body.toString(),
+      redirect: "error"
+    });
+    if (!response.ok) {
+      throw new Error("DRIVE_OAUTH_REFRESH_FAILED");
+    }
+    const raw = await readBoundedDriveBody(response, OAUTH_MAX_BYTES);
+    const parsed = JSON.parse(raw.toString("utf8")) as Record<string, unknown>;
+    const accessToken = parsed.access_token;
+    const refreshToken =
+      typeof parsed.refresh_token === "string" && parsed.refresh_token.length > 0
+        ? parsed.refresh_token
+        : grant.refreshToken;
+    const expiresIn = Number(parsed.expires_in);
+
+    if (typeof accessToken !== "string" || !accessToken || !Number.isFinite(expiresIn) || expiresIn <= 0) {
+      throw new Error("DRIVE_OAUTH_INVALID_GRANT");
+    }
+
+    return {
+      accessToken,
+      refreshToken,
+      expiresAt: this.now() + Math.floor(expiresIn * 1000),
+      scope: DRIVE_FILE_SCOPE
+    };
+  }
+}
diff --git a/apps/api/src/cloud-storage/google-drive-backups.ts b/apps/api/src/cloud-storage/google-drive-backups.ts
new file mode 100644
index 0000000..3bd40db
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-backups.ts
@@ -0,0 +1,249 @@
+import { createHash } from "node:crypto";
+import { DriveStorageError, GoogleDriveArchiveTransport } from "./google-drive.js";
+import type { DriveGrant } from "./google-drive-authorization.js";
+import type { DriveArchive, DriveContext, GoogleDriveStore } from "./google-drive-store.js";
+
+const TOKEN_EXPIRY_SKEW_MS = 60_000;
+const MAX_PARALLEL_TOTAL = 4;
+
+export class GoogleDriveBackups {
+  private readonly pausedOwners = new Set<string>();
+  private readonly ownerInFlight = new Map<string, Promise<unknown>>();
+  private totalInFlight = 0;
+
+  constructor(
+    private readonly store: GoogleDriveStore,
+    private readonly authorization: { refresh(grant: DriveGrant): Promise<DriveGrant> },
+    private readonly request: typeof fetch = fetch,
+    private readonly now = Date.now
+  ) {}
+
+  async quiesce(ownerId: string): Promise<void> {
+    this.pausedOwners.add(ownerId);
+    const active = this.ownerInFlight.get(ownerId);
+    if (active) {
+      await active.catch(() => {});
+    }
+  }
+
+  resume(ownerId: string): void {
+    this.pausedOwners.delete(ownerId);
+  }
+
+  private async runExclusive<T>(ownerId: string, task: () => Promise<T>): Promise<T> {
+    if (this.pausedOwners.has(ownerId)) {
+      throw new Error("OWNER_DATA_FENCED");
+    }
+    if (this.ownerInFlight.has(ownerId) || this.totalInFlight >= MAX_PARALLEL_TOTAL) {
+      throw new Error("DRIVE_ARCHIVE_BUSY");
+    }
+    this.totalInFlight += 1;
+    const promise = (async () => {
+      try {
+        return await task();
+      } finally {
+        this.ownerInFlight.delete(ownerId);
+        this.totalInFlight -= 1;
+      }
+    })();
+    this.ownerInFlight.set(ownerId, promise);
+    return promise;
+  }
+
+  private createTransport(context: DriveContext): GoogleDriveArchiveTransport {
+    return new GoogleDriveArchiveTransport(
+      context.ownerId,
+      async () => {
+        const { grant, version } = this.store.readGrant(context);
+        if (grant.expiresAt - TOKEN_EXPIRY_SKEW_MS > this.now()) {
+          return grant.accessToken;
+        }
+        const refreshed = await this.authorization.refresh(grant);
+        this.store.refreshGrant(context, version, refreshed);
+        return refreshed.accessToken;
+      },
+      this.request
+    );
+  }
+
+  async disconnect(ownerId: string): Promise<void> {
+    const active = this.ownerInFlight.get(ownerId);
+    this.store.disconnect(ownerId);
+    if (active) {
+      await active.catch(() => {});
+    }
+  }
+
+  async initializeFolder(ownerId: string): Promise<void> {
+    await this.runExclusive(ownerId, async () => {
+      const context = this.store.context(ownerId);
+      const { fileId, lease } = this.store.claimFolder(context, false);
+      if (!lease) return;
+      const transport = this.createTransport(context);
+      try {
+        await transport.createFolder(fileId);
+        const inspected = await transport.inspectFolder(fileId);
+        this.store.finishFolder(context, lease, inspected === "verified_metadata");
+        if (inspected !== "verified_metadata") {
+          throw new DriveStorageError("DRIVE_INVALID_RESPONSE", true);
+        }
+      } catch (error) {
+        this.store.finishFolder(context, lease, false);
+        throw error;
+      }
+    });
+  }
+
+  async retryFolder(ownerId: string): Promise<void> {
+    await this.runExclusive(ownerId, async () => {
+      const context = this.store.context(ownerId);
+      const { fileId, lease } = this.store.claimFolderReconciliation(context);
+      if (!lease) return;
+      const transport = this.createTransport(context);
+      try {
+        const check = await transport.inspectFolder(fileId);
+        if (check === "verified_metadata") {
+          this.store.finishFolder(context, lease, true);
+          return;
+        }
+        await transport.createFolder(fileId);
+        const after = await transport.inspectFolder(fileId);
+        this.store.finishFolder(context, lease, after === "verified_metadata");
+        if (after !== "verified_metadata") {
+          throw new DriveStorageError("DRIVE_INVALID_RESPONSE", true);
+        }
+      } catch (error) {
+        this.store.finishFolder(context, lease, false);
+        throw error;
+      }
+    });
+  }
+
+  private async uploadAndVerify(
+    context: DriveContext,
+    archive: DriveArchive,
+    lease: string,
+    bytes: Uint8Array,
+    transport: GoogleDriveArchiveTransport
+  ): Promise<DriveArchive> {
+    try {
+      const receipt = await transport.uploadArchive(
+        {
+          fileId: archive.fileId,
+          folderId: archive.folderId,
+          operationId: archive.operationId,
+          name: `kosmora-archive-${archive.operationId}.zip`
+        },
+        bytes
+      );
+      const downloaded = await transport.downloadArchive(receipt);
+      const downloadedSha = createHash("sha256").update(downloaded).digest("hex");
+      if (downloaded.byteLength !== archive.bytes || downloadedSha !== archive.sha256) {
+        this.store.finishArchive(context, archive.id, lease, "failed");
+        throw new DriveStorageError("DRIVE_ARCHIVE_CHANGED", false);
+      }
+      return this.store.finishArchive(context, archive.id, lease, "verified", receipt);
+    } catch (error) {
+      if (error instanceof DriveStorageError && error.code === "DRIVE_ARCHIVE_CHANGED") {
+        throw error;
+      }
+      const outcome =
+        error instanceof DriveStorageError && error.uncertain ? "uncertain" : "failed";
+      try {
+        this.store.finishArchive(context, archive.id, lease, outcome);
+      } catch {
+        /* lease already invalidated by disconnect/fence */
+      }
+      throw error;
+    }
+  }
+
+  async upload(ownerId: string, operationId: string, bytes: Uint8Array): Promise<DriveArchive> {
+    return this.runExclusive(ownerId, async () => {
+      const context = this.store.context(ownerId);
+      const existing = this.store.findArchive(context, operationId);
+      if (existing) {
+        const sha = createHash("sha256").update(bytes).digest("hex");
+        if (existing.sha256 !== sha || existing.bytes !== bytes.byteLength) {
+          throw new Error("DRIVE_ARCHIVE_EXISTS");
+        }
+        if (existing.state === "verified") return existing;
+        throw new Error("DRIVE_ARCHIVE_EXISTS");
+      }
+      const transport = this.createTransport(context);
+      const fileId = await transport.generateId();
+      const reserved = this.store.reserveArchive(context, operationId, fileId, bytes);
+      const { archive, lease } = this.store.claimArchive(context, reserved.id, "upload");
+      return this.uploadAndVerify(context, archive, lease, bytes, transport);
+    });
+  }
+
+  async retryUpload(ownerId: string, archiveId: string, bytes: Uint8Array): Promise<DriveArchive> {
+    return this.runExclusive(ownerId, async () => {
+      const context = this.store.context(ownerId);
+      const target = this.store.getArchive(context, archiveId);
+      const sha = createHash("sha256").update(bytes).digest("hex");
+      if (target.sha256 !== sha || target.bytes !== bytes.byteLength) {
+        throw new Error("DRIVE_ARCHIVE_CHANGED");
+      }
+      const { archive, lease } = this.store.claimArchive(context, archiveId, "retry");
+      const transport = this.createTransport(context);
+      try {
+        const metaStatus = await transport.inspectArchive(archive);
+        if (metaStatus === "verified_metadata") {
+          const downloaded = await transport.downloadArchive(archive);
+          const dlSha = createHash("sha256").update(downloaded).digest("hex");
+          if (downloaded.byteLength === archive.bytes && dlSha === archive.sha256) {
+            return this.store.finishArchive(context, archive.id, lease, "verified", archive);
+          }
+        }
+      } catch (error) {
+        if (error instanceof DriveStorageError && error.code === "DRIVE_ARCHIVE_CHANGED") {
+          this.store.finishArchive(context, archive.id, lease, "failed");
+          throw error;
+        }
+      }
+      return this.uploadAndVerify(context, archive, lease, bytes, transport);
+    });
+  }
+
+  async reconcile(ownerId: string, archiveId: string): Promise<DriveArchive> {
+    return this.runExclusive(ownerId, async () => {
+      const context = this.store.context(ownerId);
+      const { archive, lease } = this.store.claimArchive(context, archiveId, "reconcile");
+      const transport = this.createTransport(context);
+      try {
+        const status = await transport.inspectArchive(archive);
+        if (status === "unavailable") {
+          return this.store.finishArchive(context, archive.id, lease, "failed");
+        }
+        const downloaded = await transport.downloadArchive(archive);
+        const dlSha = createHash("sha256").update(downloaded).digest("hex");
+        if (downloaded.byteLength !== archive.bytes || dlSha !== archive.sha256) {
+          this.store.finishArchive(context, archive.id, lease, "failed");
+          throw new DriveStorageError("DRIVE_ARCHIVE_CHANGED", false);
+        }
+        return this.store.finishArchive(context, archive.id, lease, "verified", archive);
+      } catch (error) {
+        if (error instanceof DriveStorageError && error.code === "DRIVE_ARCHIVE_CHANGED") {
+          throw error;
+        }
+        try {
+          this.store.finishArchive(context, archive.id, lease, "uncertain");
+        } catch {
+          /* ignore */
+        }
+        throw error;
+      }
+    });
+  }
+
+  async download(ownerId: string, archiveId: string): Promise<Buffer> {
+    return this.runExclusive(ownerId, async () => {
+      const context = this.store.context(ownerId);
+      const archive = this.store.getArchive(context, archiveId);
+      const transport = this.createTransport(context);
+      return transport.downloadArchive(archive);
+    });
+  }
+}
diff --git a/apps/api/src/cloud-storage/google-drive-controller.ts b/apps/api/src/cloud-storage/google-drive-controller.ts
new file mode 100644
index 0000000..3fbaf38
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-controller.ts
@@ -0,0 +1,458 @@
+import type { DatabaseSync } from "node:sqlite";
+import type { OwnerPrivacyCoordinator } from "../account-settings/privacy/coordinator.js";
+import { GoogleDriveArchiveTransport } from "./google-drive.js";
+import type { GoogleDriveAuthorization } from "./google-drive-authorization.js";
+import {
+  buildDriveArchiveSetFromCoordinator,
+  parseBackupSetOperationId,
+  type AssembledDriveBackupSet
+} from "./google-drive-archive-builder.js";
+import type { GoogleDriveBackups } from "./google-drive-backups.js";
+import {
+  executeTransactionalDriveRestore,
+  previewDriveRestore,
+  type DriveRestorePreview,
+  type DriveRestoreResult
+} from "./google-drive-restore.js";
+import type {
+  DriveArchive,
+  DriveConnectTicket,
+  DriveConnectionStatus,
+  GoogleDriveStore
+} from "./google-drive-store.js";
+
+const TICKET_TTL_MS = 10 * 60 * 1000;
+
+interface BoundOAuthTicket {
+  ownerId: string;
+  sessionId: string;
+  ticket: DriveConnectTicket;
+  expiresAt: number;
+}
+
+export type MultipartBackupSetState =
+  | "verified"
+  | "in_progress"
+  | "uncertain"
+  | "failed"
+  | "incomplete";
+
+export interface MultipartBackupSetView {
+  backupSetId: string;
+  connectionId: string;
+  totalParts: number;
+  verifiedParts: number;
+  complete: boolean;
+  state: MultipartBackupSetState;
+  totalBytes: number;
+  createdAt: string;
+  updatedAt: string;
+  parts: {
+    partIndex: number;
+    archiveId: string;
+    operationId: string;
+    fileId: string;
+    bytes: number;
+    sha256: string;
+    state: DriveArchive["state"];
+  }[];
+}
+
+export interface DriveOwnerOverview {
+  configured: boolean;
+  connected: boolean;
+  connection: DriveConnectionStatus | null;
+  queue: {
+    activeCount: number;
+    uncertainCount: number;
+    failedCount: number;
+    verifiedCount: number;
+  };
+  backupSets: MultipartBackupSetView[];
+  archives: DriveArchive[];
+}
+
+export function aggregateMultipartBackupSets(archives: readonly DriveArchive[]): MultipartBackupSetView[] {
+  const groups = new Map<
+    string,
+    {
+      backupSetId: string;
+      connectionId: string;
+      totalParts: number;
+      byPartIndex: Map<number, DriveArchive>;
+      createdAt: string;
+      updatedAt: string;
+    }
+  >();
+
+  for (const arch of archives) {
+    const parsed = parseBackupSetOperationId(arch.operationId);
+    const setKey = parsed ? `${arch.connectionId}:${parsed.backupSetId}` : `${arch.connectionId}:single_${arch.id}`;
+    const backupSetId = parsed ? parsed.backupSetId : arch.operationId;
+    const totalParts = parsed ? parsed.totalParts : 1;
+    const partIndex = parsed ? parsed.partIndex : 1;
+
+    let group = groups.get(setKey);
+    if (!group) {
+      group = {
+        backupSetId,
+        connectionId: arch.connectionId,
+        totalParts,
+        byPartIndex: new Map(),
+        createdAt: arch.createdAt,
+        updatedAt: arch.updatedAt
+      };
+      groups.set(setKey, group);
+    }
+    if (arch.createdAt < group.createdAt) group.createdAt = arch.createdAt;
+    if (arch.updatedAt > group.updatedAt) group.updatedAt = arch.updatedAt;
+    if (!group.byPartIndex.has(partIndex)) {
+      group.byPartIndex.set(partIndex, arch);
+    }
+  }
+
+  const views: MultipartBackupSetView[] = [];
+  for (const group of groups.values()) {
+    const parts: MultipartBackupSetView["parts"] = [];
+    let verifiedParts = 0;
+    let hasFailed = false;
+    let hasUncertain = false;
+    let hasInProgress = false;
+    let totalBytes = 0;
+
+    for (let idx = 1; idx <= group.totalParts; idx += 1) {
+      const item = group.byPartIndex.get(idx);
+      if (!item) continue;
+      totalBytes += item.bytes;
+      if (item.state === "verified") verifiedParts += 1;
+      else if (item.state === "failed") hasFailed = true;
+      else if (item.state === "uncertain") hasUncertain = true;
+      else hasInProgress = true;
+
+      parts.push({
+        partIndex: idx,
+        archiveId: item.id,
+        operationId: item.operationId,
+        fileId: item.fileId,
+        bytes: item.bytes,
+        sha256: item.sha256,
+        state: item.state
+      });
+    }
+
+    const allPartsPresent = parts.length === group.totalParts;
+    const complete = allPartsPresent && verifiedParts === group.totalParts;
+    let state: MultipartBackupSetState;
+    if (complete) {
+      state = "verified";
+    } else if (hasFailed) {
+      state = "failed";
+    } else if (hasUncertain) {
+      state = "uncertain";
+    } else if (hasInProgress) {
+      state = "in_progress";
+    } else {
+      state = "incomplete";
+    }
+
+    views.push({
+      backupSetId: group.backupSetId,
+      connectionId: group.connectionId,
+      totalParts: group.totalParts,
+      verifiedParts,
+      complete,
+      state,
+      totalBytes,
+      createdAt: group.createdAt,
+      updatedAt: group.updatedAt,
+      parts
+    });
+  }
+
+  return views.sort((a, b) => (a.createdAt < b.createdAt ? 1 : a.createdAt > b.createdAt ? -1 : 0));
+}
+
+export class GoogleDriveController {
+  private readonly pendingTickets = new Map<string, BoundOAuthTicket>();
+  private readonly stagedPartPayloads = new Map<string, Buffer>();
+  private readonly now: () => number;
+  private readonly request: typeof fetch;
+
+  constructor(
+    private readonly options: {
+      db: DatabaseSync;
+      store: GoogleDriveStore;
+      backups: GoogleDriveBackups;
+      auth: GoogleDriveAuthorization | null;
+      privacy: Pick<OwnerPrivacyCoordinator, "export" | "binary">;
+      request?: typeof fetch;
+      now?: () => number;
+      onRestoreBinary?: Parameters<typeof executeTransactionalDriveRestore>[3] extends
+        | { onRestoreBinary?: infer F }
+        | undefined
+        ? F
+        : never;
+    }
+  ) {
+    this.now = options.now ?? Date.now;
+    this.request = options.request ?? fetch;
+  }
+
+  private pruneExpiredTickets(): void {
+    const current = this.now();
+    for (const [state, record] of this.pendingTickets.entries()) {
+      if (record.expiresAt <= current) {
+        this.pendingTickets.delete(state);
+      }
+    }
+  }
+
+  private invalidateOwnerTickets(ownerId: string): void {
+    for (const [state, record] of this.pendingTickets.entries()) {
+      if (record.ownerId === ownerId) {
+        this.pendingTickets.delete(state);
+      }
+    }
+  }
+
+  overview(ownerId: string, offset = 0): DriveOwnerOverview {
+    const conn = this.options.store.status(ownerId);
+    const archives = this.options.store.listArchives(ownerId, offset);
+    const currentConnArchives = conn?.connection_id
+      ? archives.filter((a) => a.connectionId === conn.connection_id)
+      : [];
+
+    const queue = {
+      activeCount: currentConnArchives.filter(
+        (a) => a.state === "reserved" || a.state === "uploading" || a.state === "checking"
+      ).length,
+      uncertainCount: currentConnArchives.filter((a) => a.state === "uncertain").length,
+      failedCount: currentConnArchives.filter((a) => a.state === "failed").length,
+      verifiedCount: archives.filter((a) => a.state === "verified").length
+    };
+
+    return {
+      configured: this.options.auth !== null,
+      connected: Boolean(conn && conn.folder_state !== "disconnected"),
+      connection: conn,
+      queue,
+      backupSets: aggregateMultipartBackupSets(archives),
+      archives
+    };
+  }
+
+  startOAuthConnect(identity: { ownerId: string; sessionId: string }): {
+    authorizationUrl: string;
+    state: string;
+  } {
+    if (!this.options.auth) {
+      throw new Error("DRIVE_OAUTH_CONFIGURATION_REQUIRED");
+    }
+    if (!identity.ownerId || !identity.sessionId) {
+      throw new Error("DRIVE_AUTH_CONTEXT_REQUIRED");
+    }
+    this.pruneExpiredTickets();
+    // Capture server-side ticket before redirecting to Google OAuth
+    const ticket = this.options.store.beginConnect(identity.ownerId);
+    const { url, state } = this.options.auth.begin({
+      ownerId: identity.ownerId,
+      sessionId: identity.sessionId
+    });
+    this.pendingTickets.set(state, {
+      ownerId: identity.ownerId,
+      sessionId: identity.sessionId,
+      ticket,
+      expiresAt: this.now() + TICKET_TTL_MS
+    });
+    return {
+      authorizationUrl: url,
+      state
+    };
+  }
+
+  async finishOAuthCallback(
+    identity: { ownerId: string; sessionId: string },
+    input: { state: string; code: string }
+  ): Promise<DriveOwnerOverview> {
+    if (!this.options.auth) {
+      throw new Error("DRIVE_OAUTH_CONFIGURATION_REQUIRED");
+    }
+    if (!identity.ownerId || !identity.sessionId) {
+      throw new Error("DRIVE_AUTH_CONTEXT_REQUIRED");
+    }
+    this.pruneExpiredTickets();
+    const bound = this.pendingTickets.get(input.state);
+    // Single-use state: delete immediately before any async work
+    this.pendingTickets.delete(input.state);
+
+    if (!bound || bound.expiresAt <= this.now()) {
+      throw new Error("DRIVE_OAUTH_STATE_INVALID");
+    }
+    if (bound.ownerId !== identity.ownerId || bound.sessionId !== identity.sessionId) {
+      throw new Error("DRIVE_OAUTH_SESSION_MISMATCH");
+    }
+
+    const grant = await this.options.auth.finish({
+      ownerId: identity.ownerId,
+      sessionId: identity.sessionId,
+      state: input.state,
+      code: input.code
+    });
+
+    const tempTransport = new GoogleDriveArchiveTransport(
+      identity.ownerId,
+      async () => grant.accessToken,
+      this.request
+    );
+    const folderId = await tempTransport.generateId();
+
+    // Commit encrypted grant & pre-allocated folderId using server-captured ticket
+    this.options.store.connect(bound.ticket, grant, folderId);
+
+    try {
+      await this.options.backups.initializeFolder(identity.ownerId);
+    } catch {
+      /* Folder state remains 'uncertain' in journal so owner can retryFolder without losing grant */
+    }
+
+    return this.overview(identity.ownerId);
+  }
+
+  async disconnect(ownerId: string): Promise<DriveOwnerOverview> {
+    this.invalidateOwnerTickets(ownerId);
+    await this.options.backups.disconnect(ownerId);
+    for (const key of this.stagedPartPayloads.keys()) {
+      if (key.startsWith(`${ownerId}:`)) {
+        this.stagedPartPayloads.delete(key);
+      }
+    }
+    return this.overview(ownerId);
+  }
+
+  async retryFolder(ownerId: string): Promise<DriveOwnerOverview> {
+    await this.options.backups.retryFolder(ownerId);
+    return this.overview(ownerId);
+  }
+
+  async createBackupCopy(
+    ownerId: string,
+    options: { backupSetId?: string } = {}
+  ): Promise<{
+    backupSet: MultipartBackupSetView;
+    assembled: Pick<AssembledDriveBackupSet, "backupSetId" | "totalParts" | "totalBytes" | "generatedAt">;
+  }> {
+    const assembled = await buildDriveArchiveSetFromCoordinator(
+      this.options.privacy,
+      ownerId,
+      options.backupSetId ? { backupSetId: options.backupSetId } : {}
+    );
+
+    const uploadedArchives: DriveArchive[] = [];
+    for (const part of assembled.parts) {
+      const stageKey = `${ownerId}:${part.operationId}`;
+      this.stagedPartPayloads.set(stageKey, part.bytes);
+      try {
+        const arch = await this.options.backups.upload(ownerId, part.operationId, part.bytes);
+        uploadedArchives.push(arch);
+        if (arch.state === "verified") {
+          this.stagedPartPayloads.delete(stageKey);
+        }
+      } catch (error) {
+        const context = this.options.store.context(ownerId);
+        const partial = this.options.store.findArchive(context, part.operationId);
+        if (partial) {
+          uploadedArchives.push(partial);
+          break;
+        }
+        throw error;
+      }
+    }
+
+    const overview = this.overview(ownerId);
+    const setView =
+      overview.backupSets.find((s) => s.backupSetId === assembled.backupSetId) ??
+      aggregateMultipartBackupSets(uploadedArchives)[0];
+    if (!setView) {
+      throw new Error("DRIVE_BACKUP_SET_NOT_CREATED");
+    }
+
+    return {
+      backupSet: setView,
+      assembled: {
+        backupSetId: assembled.backupSetId,
+        totalParts: assembled.totalParts,
+        totalBytes: assembled.totalBytes,
+        generatedAt: assembled.generatedAt
+      }
+    };
+  }
+
+  async retryArchiveUpload(
+    ownerId: string,
+    archiveId: string,
+    explicitBytes?: Uint8Array
+  ): Promise<DriveArchive> {
+    const context = this.options.store.context(ownerId);
+    const target = this.options.store.getArchive(context, archiveId);
+    const stageKey = `${ownerId}:${target.operationId}`;
+    const bytes = explicitBytes ?? this.stagedPartPayloads.get(stageKey);
+    if (!bytes) {
+      throw new Error("DRIVE_RETRY_BYTES_REQUIRED");
+    }
+    const updated = await this.options.backups.retryUpload(ownerId, archiveId, bytes);
+    if (updated.state === "verified") {
+      this.stagedPartPayloads.delete(stageKey);
+    }
+    return updated;
+  }
+
+  async reconcileArchive(ownerId: string, archiveId: string): Promise<DriveArchive> {
+    const updated = await this.options.backups.reconcile(ownerId, archiveId);
+    if (updated.state === "verified") {
+      this.stagedPartPayloads.delete(`${ownerId}:${updated.operationId}`);
+    }
+    return updated;
+  }
+
+  private async downloadVerifiedBackupSetParts(
+    ownerId: string,
+    backupSetId: string
+  ): Promise<Buffer[]> {
+    const overview = this.overview(ownerId);
+    const setView = overview.backupSets.find((s) => s.backupSetId === backupSetId);
+    if (!setView) {
+      throw new Error("DRIVE_ARCHIVE_NOT_FOUND");
+    }
+    if (!setView.complete || setView.state !== "verified") {
+      throw new Error("DRIVE_BACKUP_SET_INCOMPLETE");
+    }
+    const ordered = [...setView.parts].sort((a, b) => a.partIndex - b.partIndex);
+    const buffers: Buffer[] = [];
+    for (const part of ordered) {
+      const buf = await this.options.backups.download(ownerId, part.archiveId);
+      buffers.push(buf);
+    }
+    return buffers;
+  }
+
+  async previewRestoreFromDrive(
+    ownerId: string,
+    backupSetId: string
+  ): Promise<DriveRestorePreview> {
+    const parts = await this.downloadVerifiedBackupSetParts(ownerId, backupSetId);
+    return previewDriveRestore(ownerId, parts);
+  }
+
+  async executeRestoreFromDrive(
+    ownerId: string,
+    backupSetId: string
+  ): Promise<DriveRestoreResult> {
+    const parts = await this.downloadVerifiedBackupSetParts(ownerId, backupSetId);
+    return executeTransactionalDriveRestore(
+      this.options.db,
+      ownerId,
+      parts,
+      this.options.onRestoreBinary ? { onRestoreBinary: this.options.onRestoreBinary } : {}
+    );
+  }
+}
diff --git a/apps/api/src/cloud-storage/google-drive-grant-cipher.ts b/apps/api/src/cloud-storage/google-drive-grant-cipher.ts
