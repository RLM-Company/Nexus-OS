+import test from "node:test";
+import assert from "node:assert/strict";
+import { DatabaseSync } from "node:sqlite";
+import {
+  RoaringBitmap32,
+  RoaringPositionalInvertedIndex
+} from "../../../packages/db/src/roaring-positional-inverted-index.js";
