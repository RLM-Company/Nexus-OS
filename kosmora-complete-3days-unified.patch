+"use strict";
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  inspectAndSanitizeClipboard,
+  verifyDragAndDropFiles
+} = require("../ci/clipboard-and-drop-guard.cjs");
+
+test("inspectAndSanitizeClipboard blocks ANSI escapes, PowerShell pastejacking, and multi-line terminal auto-execution", () => {
+  // 1. Clean clipboard text into editor
+  const clean = inspectAndSanitizeClipboard("Project Apollo Q4 budget is $250,000.", {
+    targetContext: "editor"
+  });
+  assert.equal(clean.allowed, true);
+  assert.equal(clean.threats.length, 0);
+
+  // 2. ANSI escape + hidden shell execution pastejacking
+  const pastejack = inspectAndSanitizeClipboard(
+    "git status \u001b[201~\npowershell.exe -enc SQBFAFgA\r\nclear",
+    { targetContext: "terminal" }
+  );
+  assert.equal(pastejack.allowed, false);
+  assert.ok(pastejack.threats.some((t) => t.code === "CLIPBOARD_ANSI_ESCAPE_INJECTION"));
+  assert.ok(pastejack.threats.some((t) => t.code === "CLIPBOARD_SHELL_PASTEJACKING"));
+  assert.ok(pastejack.threats.some((t) => t.code === "CLIPBOARD_TERMINAL_AUTOEXEC_NEWLINE"));
+  assert.ok(!pastejack.sanitizedText.includes("\u001b"));
+});
+
+test("verifyDragAndDropFiles blocks .exe/.ps1/.lnk extensions, NTFS Alternate Data Streams, UNC paths, and out-of-workspace files", () => {
+  const workspaceRoot = "/tmp/koswork-authorized-folder";
+
+  // 1. Safe document inside workspace
+  const safeDrop = verifyDragAndDropFiles(
+    [
+      "/tmp/koswork-authorized-folder/Q4-Report.docx",
+      "/tmp/koswork-authorized-folder/Budget.xlsx"
+    ],
+    { allowedWorkspaceRoot: workspaceRoot }
+  );
+  assert.equal(safeDrop.allowed, true);
+  assert.equal(safeDrop.approvedFiles.length, 2);
+  assert.equal(safeDrop.violations.length, 0);
+
+  // 2. Malicious drop candidates
+  const unsafeDrop = verifyDragAndDropFiles(
+    [
+      "\\\\evil-smb.example.com\\share\\payload.docx",
+      "/tmp/koswork-authorized-folder/invoice.pdf:hidden.exe",
+      "/tmp/koswork-authorized-folder/ dropper.ps1",
+      "/etc/passwd"
+    ],
+    { allowedWorkspaceRoot: workspaceRoot }
+  );
+
+  assert.equal(unsafeDrop.allowed, false);
+  assert.ok(unsafeDrop.violations.some((v) => v.code === "DROP_UNC_OR_DEVICE_PATH_FORBIDDEN"));
+  assert.ok(unsafeDrop.violations.some((v) => v.code === "DROP_NTFS_ADS_FORBIDDEN"));
+  assert.ok(unsafeDrop.violations.some((v) => v.code === "DROP_EXECUTABLE_EXTENSION_FORBIDDEN"));
+  assert.ok(unsafeDrop.violations.some((v) => v.code === "DROP_OUTSIDE_WORKSPACE_ROOT"));
+});
diff --git a/desktop/windows/test/computer-hazard-and-focus-guard.test.cjs b/desktop/windows/test/computer-hazard-and-focus-guard.test.cjs
new file mode 100644
index 0000000..a0aca23
--- /dev/null
+++ b/desktop/windows/test/computer-hazard-and-focus-guard.test.cjs
@@ -0,0 +1,89 @@
+"use strict";
+
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  ComputerTaskRecoveryGuard,
+  classifyComputerActionHazard,
+  verifyForegroundWindowFocus
+} = require("../ci/computer-hazard-and-focus-guard.cjs");
+
+test("classifies system shortcuts, destructive commands, step-up consent actions, and safe actions accurately", () => {
+  const blockedShortcut = classifyComputerActionHazard({
+    kind: "hotkey",
+    keys: ["Alt", "F4"]
+  });
+  assert.equal(blockedShortcut.tier, "strictly_blocked");
+  assert.equal(blockedShortcut.code, "BLOCKED_SYSTEM_SHORTCUT");
+
+  const blockedExe = classifyComputerActionHazard({
+    kind: "click",
+    targetLabel: "setup-installer.exe"
+  });
+  assert.equal(blockedExe.tier, "strictly_blocked");
+
+  const stepUpPayment = classifyComputerActionHazard({
+    kind: "click",
+    targetLabel: "Подтвердить платёж и отправить сообщение"
+  });
+  assert.equal(stepUpPayment.tier, "requires_step_up_consent");
+  assert.equal(stepUpPayment.code, "STEP_UP_CONSENT_REQUIRED");
+
+  const safeAction = classifyComputerActionHazard({
+    kind: "type",
+    targetLabel: "Поле поиска документов",
+    text: "Отчёт по архитектуре Kosmora"
+  });
+  assert.equal(safeAction.tier, "safe");
+});
+
+test("halts immediately on Windows focus loss/steal and requires fresh post-interruption consent to resume", () => {
+  const focusStolen = verifyForegroundWindowFocus(
+    { hwnd: "0x001A2B", processName: "WINWORD.EXE" },
+    { hwnd: "0x0099FF", processName: "explorer.exe", minimized: false }
+  );
+  assert.equal(focusStolen.ok, false);
+  assert.equal(focusStolen.code, "FOCUS_STOLEN_BY_OTHER_WINDOW");
+
+  const focusVerified = verifyForegroundWindowFocus(
+    { hwnd: "0x001A2B", processName: "WINWORD.EXE" },
+    { hwnd: "0x001A2B", processName: "winword.exe", minimized: false }
+  );
+  assert.equal(focusVerified.ok, true);
+
+  const recoveryGuard = new ComputerTaskRecoveryGuard();
+  const checkpoint = recoveryGuard.suspendTaskOnInterruption({
+    taskId: "task-win-42",
+    ownerId: "owner-1",
+    stepIndex: 3,
+    reasonCode: focusStolen.code,
+    interruptedAt: "2026-11-02T01:10:00.000Z",
+    previousConsentId: "consent-initial-1"
+  });
+
+  assert.equal(checkpoint.status, "suspended_awaiting_fresh_consent");
+
+  // Reusing the old consent ID must be rejected
+  assert.throws(
+    () =>
+      recoveryGuard.resumeWithFreshConsent({
+        taskId: "task-win-42",
+        ownerId: "owner-1",
+        expectedStateDigest: checkpoint.stateDigest,
+        freshConsentId: "consent-initial-1",
+        consentedAt: "2026-11-02T01:11:00.000Z"
+      }),
+    /STALE_CONSENT_REJECTED_FRESH_CONSENT_REQUIRED/
+  );
+
+  // Fresh consent with newer timestamp succeeds
+  const resumed = recoveryGuard.resumeWithFreshConsent({
+    taskId: "task-win-42",
+    ownerId: "owner-1",
+    expectedStateDigest: checkpoint.stateDigest,
+    freshConsentId: "consent-fresh-2",
+    consentedAt: "2026-11-02T01:12:00.000Z"
+  });
+  assert.equal(resumed.status, "resumed");
+  assert.equal(resumed.resumedWithConsentId, "consent-fresh-2");
+});
diff --git a/desktop/windows/test/desktop-runtime-watchdog.test.cjs b/desktop/windows/test/desktop-runtime-watchdog.test.cjs
new file mode 100644
index 0000000..30cb612
--- /dev/null
+++ b/desktop/windows/test/desktop-runtime-watchdog.test.cjs
@@ -0,0 +1,57 @@
+"use strict";
+
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { DesktopRuntimeWatchdog } = require("../ci/desktop-runtime-watchdog.cjs");
+const { ComputerTaskRecoveryGuard } = require("../ci/computer-hazard-and-focus-guard.cjs");
+
+test("enforces 512 MB WebContentsView RAM quota with auto-eviction, audits workspace folder integrity, and catches Windows session lock", () => {
+  const workspaceRoot = fs.mkdtempSync(path.join(os.tmpdir(), "koswork-watchdog-test-"));
+  const recoveryGuard = new ComputerTaskRecoveryGuard();
+
+  try {
+    fs.writeFileSync(path.join(workspaceRoot, "notes.txt"), "Текстовый файл рабочей папки", "utf8");
+
+    const watchdog = new DesktopRuntimeWatchdog({
+      workspaceRoot,
+      maxTotalRamMb: 512,
+      recoveryGuard
+    });
+
+    // 1. RAM quota tracking: registering 3 views (total 400 MB) is under quota
+    watchdog.updateViewMetrics("view-1", { ramMb: 150, lastActiveAt: 1000 });
+    watchdog.updateViewMetrics("view-2", { ramMb: 120, lastActiveAt: 2000 });
+    const safeMetrics = watchdog.updateViewMetrics("view-3", { ramMb: 130, lastActiveAt: 3000 });
+    assert.equal(safeMetrics.overQuota, false);
+    assert.equal(safeMetrics.evictedTabIds.length, 0);
+
+    // Adding 4th view (200 MB) brings total to 600 MB (> 512 MB) -> oldest view-1 must be auto-evicted!
+    const overMetrics = watchdog.updateViewMetrics("view-4", { ramMb: 200, lastActiveAt: 4000 });
+    assert.deepEqual(overMetrics.evictedTabIds, ["view-1"]);
+    assert.equal(overMetrics.activeViewsCount, 3);
+
+    // 2. Workspace integrity audit
+    const auditRes = watchdog.auditWorkspaceFolderIntegrity(["notes.txt"]);
+    assert.equal(auditRes.ok, true);
+    assert.equal(auditRes.checkedCount, 1);
+
+    // 3. Windows session lock event (Win+L / screensaver / RDP disconnect)
+    const lockRes = watchdog.handleWindowsSessionLockEvent("task-active-77", "owner-1");
+    assert.equal(lockRes.sessionLocked, true);
+    assert.equal(lockRes.checkpointCreated, true);
+    assert.equal(lockRes.checkpoint.reasonCode, "WINDOWS_SESSION_LOCKED");
+
+    const health = watchdog.getWatchdogHealthStatus();
+    assert.equal(health.status, "healthy");
+    assert.equal(health.sessionLocked, true);
+    assert.equal(health.securityViolationsCount, 0);
+
+    watchdog.handleWindowsSessionUnlockEvent();
+    assert.equal(watchdog.sessionLocked, false);
+  } finally {
+    fs.rmSync(workspaceRoot, { recursive: true, force: true });
+  }
+});
diff --git a/desktop/windows/test/download-verifier.test.cjs b/desktop/windows/test/download-verifier.test.cjs
new file mode 100644
index 0000000..6dcfed7
--- /dev/null
+++ b/desktop/windows/test/download-verifier.test.cjs
@@ -0,0 +1,87 @@
+"use strict";
+
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const EventEmitter = require("node:events");
+const {
+  attachDeterministicDownloadHandler,
+  waitForVerifiedDownload
+} = require("../browser/download-verifier.cjs");
+
+test("waits for .crdownload partial file to finalize into result.txt before reading", async () => {
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "koswork-dl-test-"));
+  const partialPath = path.join(tmpDir, "result.txt.crdownload");
+  const finalPath = path.join(tmpDir, "result.txt");
+
+  fs.writeFileSync(partialPath, "partial-data", "utf8");
+
+  setTimeout(() => {
+    fs.writeFileSync(finalPath, "KOSWORK_UNIFIED_RESULT_OK=1\n", "utf8");
+    fs.unlinkSync(partialPath);
+  }, 90);
+
+  const verified = await waitForVerifiedDownload({
+    filename: "result.txt",
+    primaryDir: tmpDir,
+    expectedSubstring: "KOSWORK_UNIFIED_RESULT_OK=1",
+    timeoutMs: 2000,
+    pollIntervalMs: 25
+  });
+
+  assert.equal(verified.ok, true);
+  assert.equal(verified.reconciledFromFallback, false);
+  assert.match(verified.content, /KOSWORK_UNIFIED_RESULT_OK=1/);
+  fs.rmSync(tmpDir, { recursive: true, force: true });
+});
+
+test("reconciles result.txt from fallback Downloads directory into primary fixture directory", async () => {
+  const primaryDir = fs.mkdtempSync(path.join(os.tmpdir(), "koswork-dl-primary-"));
+  const fallbackDir = fs.mkdtempSync(path.join(os.tmpdir(), "koswork-dl-fallback-"));
+
+  setTimeout(() => {
+    fs.writeFileSync(path.join(fallbackDir, "result.txt"), "FALLBACK_DOWNLOAD_SUCCESS\n", "utf8");
+  }, 60);
+
+  const verified = await waitForVerifiedDownload({
+    filename: "result.txt",
+    primaryDir,
+    fallbackDirs: [fallbackDir],
+    expectedSubstring: "FALLBACK_DOWNLOAD_SUCCESS",
+    timeoutMs: 2000,
+    pollIntervalMs: 25
+  });
+
+  assert.equal(verified.ok, true);
+  assert.equal(verified.reconciledFromFallback, true);
+  assert.equal(fs.existsSync(path.join(primaryDir, "result.txt")), true);
+  assert.equal(fs.readFileSync(path.join(primaryDir, "result.txt"), "utf8"), "FALLBACK_DOWNLOAD_SUCCESS\n");
+
+  fs.rmSync(primaryDir, { recursive: true, force: true });
+  fs.rmSync(fallbackDir, { recursive: true, force: true });
+});
+
+test("attachDeterministicDownloadHandler synchronously sets savePath on will-download", () => {
+  const downloadDir = fs.mkdtempSync(path.join(os.tmpdir(), "koswork-session-dl-"));
+  const fakeSession = new EventEmitter();
+  const handler = attachDeterministicDownloadHandler(fakeSession, { downloadDir });
+
+  let assignedSavePath = null;
+  const fakeItem = new EventEmitter();
+  fakeItem.getFilename = () => "result.txt";
+  fakeItem.setSavePath = (p) => {
+    assignedSavePath = p;
+  };
+
+  fakeSession.emit("will-download", {}, fakeItem);
+  assert.equal(assignedSavePath, path.join(downloadDir, "result.txt"));
+
+  fakeItem.emit("done", {}, "completed");
+  assert.equal(handler.completedDownloads.length, 1);
+  assert.equal(handler.completedDownloads[0].filename, "result.txt");
+
+  handler.detach();
+  fs.rmSync(downloadDir, { recursive: true, force: true });
+});
diff --git a/desktop/windows/test/dpi-coordinate-calibrator.test.cjs b/desktop/windows/test/dpi-coordinate-calibrator.test.cjs
new file mode 100644
index 0000000..fc25148
--- /dev/null
+++ b/desktop/windows/test/dpi-coordinate-calibrator.test.cjs
@@ -0,0 +1,62 @@
+"use strict";
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  mapNormalizedVisionToScreen,
+  SetOfMarkCoordinateCatalog
+} = require("../ci/dpi-coordinate-calibrator.cjs");
+
+test("mapNormalizedVisionToScreen calibrates coordinates across 150% DPI scaling and negative secondary monitor offsets", () => {
+  // Secondary left monitor at negative origin (-1920, 0) with 150% (1.5x) DPI scaling
+  const secondaryDisplay = {
+    id: "display-left-4k",
+    scaleFactor: 1.5,
+    dipBounds: { x: -1920, y: 0, width: 1920, height: 1080 },
+    physicalBounds: { x: -2880, y: 0, width: 2880, height: 1620 }
+  };
+
+  // Center of screen (500, 500)
+  const center = mapNormalizedVisionToScreen(500, 500, secondaryDisplay);
+  assert.equal(center.dip.x, -960);
+  assert.equal(center.dip.y, 540);
+  assert.equal(center.physical.x, -1440);
+  assert.equal(center.physical.y, 810);
+
+  // Out-of-bounds normalized input (-50, 1200) is safely clamped inside viewport inset
+  const clamped = mapNormalizedVisionToScreen(-50, 1200, secondaryDisplay);
+  assert.equal(clamped.dip.x, -1918);
+  assert.equal(clamped.dip.y, 1078);
+});
+
+test("SetOfMarkCoordinateCatalog assigns #1..#N tags and computes DPI-scaled physical click targets", () => {
+  const display = {
+    id: "display-primary-125",
+    scaleFactor: 1.25,
+    dipBounds: { x: 0, y: 0, width: 1920, height: 1080 }
+  };
+
+  const som = new SetOfMarkCoordinateCatalog(display);
+  const catalog = som.buildCatalog([
+    {
+      id: "btn-approve-budget",
+      label: "Approve Budget",
+      role: "button",
+      dipBbox: { x: 400, y: 300, width: 200, height: 40 }
+    },
+    {
+      id: "input-search",
+      label: "Search Vault",
+      role: "textbox",
+      dipBbox: { x: 800, y: 100, width: 400, height: 32 }
+    }
+  ]);
+
+  assert.equal(catalog.length, 2);
+  const target1 = som.resolveMarkTarget("#1");
+  assert.ok(target1);
+  assert.equal(target1.elementId, "btn-approve-budget");
+  // Center DIP: (400 + 100 = 500, 300 + 20 = 320)
+  assert.deepEqual(target1.safeClickDip, { x: 500, y: 320 });
+  // Physical at 1.25x: (500 * 1.25 = 625, 320 * 1.25 = 400)
+  assert.deepEqual(target1.safeClickPhysical, { x: 625, y: 400 });
+});
