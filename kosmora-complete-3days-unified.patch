+  return {
+    format: "pdf",
+    extractionStatus: combinedText.length > 0 ? "extracted" : "no_text_layer",
+    sectionCount: sections.length,
+    sections,
+    text: combinedText
+  };
+}
+
+/**
+ * Extracts structured text and addressable chunks from PDF, Word (.docx),
+ * Excel (.xlsx), PowerPoint (.pptx), or plain text files.
+ */
+function extractVaultDocument(
+  rawBuffer,
+  { filename = "document.txt", sliceMaxChars = DEFAULT_HANDOFF_SLICE_CHARS } = {}
+) {
+  const buf = Buffer.isBuffer(rawBuffer) ? rawBuffer : Buffer.from(rawBuffer);
+  if (buf.byteLength === 0) {
+    throw new VaultDocumentError(EXTRACTION_ERROR_CODES.VAULT_DOC_EMPTY, "Файл документа пуст.");
+  }
+  if (buf.byteLength > MAX_DOCUMENT_FILE_BYTES) {
+    throw new VaultDocumentError(
+      EXTRACTION_ERROR_CODES.VAULT_DOC_TOO_LARGE,
+      `Размер файла (${buf.byteLength} Б) превышает лимит 10 МиБ.`
+    );
+  }
+
+  const ext = String(filename).toLowerCase().split(".").pop() || "";
+  const documentSha256 = sha256Hex(buf);
+  let extracted;
+
+  if (ext === "pdf") {
+    extracted = extractPdfText(buf);
+  } else if (ext === "docx" || ext === "xlsx" || ext === "pptx") {
+    const entries = unpackSafeZipArchive(buf);
+    if (ext === "docx") extracted = extractDocxText(entries);
+    else if (ext === "xlsx") extracted = extractXlsxText(entries);
+    else extracted = extractPptxText(entries);
+    extracted.extractionStatus = extracted.text.length > 0 ? "extracted" : "empty_document";
+  } else if (
+    ["txt", "md", "json", "csv", "tsv", "log", "js", "ts", "py", "css", "html"].includes(ext)
+  ) {
+    const text = buf.toString("utf8");
+    extracted = {
+      format: ext,
+      extractionStatus: "extracted",
+      sectionCount: 1,
+      sections: [{ index: 1, label: filename, text }],
+      text
+    };
+  } else {
+    throw new VaultDocumentError(
+      EXTRACTION_ERROR_CODES.VAULT_DOC_UNSUPPORTED_FORMAT,
+      `Формат ".${ext}" не поддерживает локальное извлечение текста.`
+    );
+  }
+
+  const effectiveSliceChars = Math.max(
+    500,
+    Math.min(
+      Number.isSafeInteger(sliceMaxChars) ? sliceMaxChars : DEFAULT_HANDOFF_SLICE_CHARS,
+      DEFAULT_HANDOFF_SLICE_CHARS
+    )
+  );
+  const chunks = splitTextIntoAddressableChunks(extracted.text, effectiveSliceChars);
+
+  return {
+    filename,
+    format: extracted.format,
+    extractionStatus: extracted.extractionStatus,
+    documentSha256,
+    sizeBytes: buf.byteLength,
+    text: extracted.text,
+    totalChars: extracted.text.length,
+    sectionCount: extracted.sectionCount,
+    sections: extracted.sections,
+    totalChunks: chunks.length,
+    chunks,
+    requiresChunkedHandoff: extracted.text.length > DEFAULT_HANDOFF_SLICE_CHARS
+  };
+}
+
+/**
+ * Splits a potentially large document text into addressable slices (<= maxChars each,
+ * never exceeding 12,000 characters for chat handoff) on paragraph/line boundaries
+ * without silently truncating any characters.
+ */
+function splitTextIntoAddressableChunks(fullText, maxChars = DEFAULT_HANDOFF_SLICE_CHARS) {
+  const text = String(fullText ?? "");
+  if (text.length === 0) {
+    return [];
+  }
+  const limit = Math.max(100, Math.min(maxChars, DEFAULT_HANDOFF_SLICE_CHARS));
+  const chunks = [];
+  let cursor = 0;
+
+  while (cursor < text.length) {
+    let end = Math.min(cursor + limit, text.length);
+    if (end < text.length) {
+      const newlineBreak = text.lastIndexOf("\n", end);
+      if (newlineBreak > cursor + Math.floor(limit * 0.5)) {
+        end = newlineBreak + 1;
+      }
+    }
+    const sliceText = text.slice(cursor, end);
+    const chunkIndex = chunks.length + 1;
+    chunks.push({
+      chunkIndex,
+      totalChunks: 0, // populated after loop
+      charStart: cursor,
+      charEnd: end,
+      charLength: sliceText.length,
+      sha256: sha256Hex(sliceText),
+      text: sliceText
+    });
+    cursor = end;
+  }
+
+  for (const ch of chunks) {
+    ch.totalChunks = chunks.length;
+  }
+  return chunks;
+}
+
+/**
+ * Returns a single addressable chunk/slice of an extracted document for explicit
+ * chat handoff or preview, guaranteeing the returned slice never exceeds 12,000 chars
+ * and never silently drops surrounding content (includes navigation metadata).
+ */
+function readAddressableVaultSlice(extractedDoc, { chunkIndex = 1 } = {}) {
+  if (!extractedDoc || !Array.isArray(extractedDoc.chunks)) {
+    throw new VaultDocumentError(
+      EXTRACTION_ERROR_CODES.VAULT_DOC_SLICE_OUT_OF_RANGE,
+      "Документ не содержит текстовых фрагментов для чтения."
+    );
+  }
+  if (extractedDoc.chunks.length === 0) {
+    return {
+      filename: extractedDoc.filename,
+      documentSha256: extractedDoc.documentSha256,
+      extractionStatus: extractedDoc.extractionStatus,
+      chunkIndex: 0,
+      totalChunks: 0,
+      charStart: 0,
+      charEnd: 0,
+      totalChars: 0,
+      hasPrevious: false,
+      hasNext: false,
+      truncatedSilently: false,
+      text: ""
+    };
+  }
+  if (
+    !Number.isSafeInteger(chunkIndex) ||
+    chunkIndex < 1 ||
+    chunkIndex > extractedDoc.chunks.length
+  ) {
+    throw new VaultDocumentError(
+      EXTRACTION_ERROR_CODES.VAULT_DOC_SLICE_OUT_OF_RANGE,
+      `Запрошенный фрагмент #${chunkIndex} выходит за диапазон 1..${extractedDoc.chunks.length}.`,
+      { requestedChunk: chunkIndex, totalChunks: extractedDoc.chunks.length }
+    );
+  }
+  const chunk = extractedDoc.chunks[chunkIndex - 1];
+  return {
+    filename: extractedDoc.filename,
+    format: extractedDoc.format,
+    documentSha256: extractedDoc.documentSha256,
+    extractionStatus: extractedDoc.extractionStatus,
+    chunkIndex: chunk.chunkIndex,
+    totalChunks: chunk.totalChunks,
+    charStart: chunk.charStart,
+    charEnd: chunk.charEnd,
+    charLength: chunk.charLength,
+    totalChars: extractedDoc.totalChars,
+    chunkSha256: chunk.sha256,
+    hasPrevious: chunk.chunkIndex > 1,
+    hasNext: chunk.chunkIndex < chunk.totalChunks,
+    truncatedSilently: false,
+    text: chunk.text
+  };
+}
+
+module.exports = {
+  DEFAULT_HANDOFF_SLICE_CHARS,
+  EXTRACTION_ERROR_CODES,
+  MAX_DOCUMENT_FILE_BYTES,
+  MAX_UNCOMPRESSED_ZIP_BYTES,
+  VaultDocumentError,
+  extractPdfText,
+  extractVaultDocument,
+  readAddressableVaultSlice,
+  splitTextIntoAddressableChunks,
+  unpackSafeZipArchive
+};
diff --git a/desktop/windows/vault-virtual-bridge.cjs b/desktop/windows/vault-virtual-bridge.cjs
new file mode 100644
index 0000000..4d2378e
--- /dev/null
+++ b/desktop/windows/vault-virtual-bridge.cjs
@@ -0,0 +1,224 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const crypto = require("node:crypto");
+const { extractVaultDocument } = require("./vault-document-extractor.cjs");
+
+const MAX_UTF16_SLICE_UNITS = 6000;
+const MAX_SERIALIZED_RESPONSE_BYTES = 24000;
+const DEFAULT_GRANT_TTL_MS = 30 * 60 * 1000; // 30 minutes
+
+/**
+ * Slices a string by UTF-16 code units (`offset`, `maxUnits <= 6000`) while guaranteeing
+ * that surrogate pairs (`0xD800..0xDBFF` followed by `0xDC00..0xDFFF`) are NEVER split
+ * at the start or end boundary (as required by PR #421 `KOSWORK_VAULT_AGENT_SEARCH_2026-10-31_RU.md`).
+ */
+function sliceUtf16SurrogateSafe(text, rawOffset = 0, rawMaxUnits = MAX_UTF16_SLICE_UNITS) {
+  const str = String(text ?? "");
+  const len = str.length;
+  if (len === 0) {
+    return { slice: "", startOffset: 0, endOffset: 0, nextOffset: null, totalUnits: 0 };
+  }
+
+  let start = Math.max(0, Math.min(Number(rawOffset) || 0, len));
+  const maxUnits = Math.max(2, Math.min(Number(rawMaxUnits) || MAX_UTF16_SLICE_UNITS, MAX_UTF16_SLICE_UNITS));
+
+  // If `start` lands on a low surrogate (0xDC00..0xDFFF) preceded by a high surrogate, step back 1 unit
+  if (start > 0 && start < len) {
+    const code = str.charCodeAt(start);
+    const prev = str.charCodeAt(start - 1);
+    if (code >= 0xdc00 && code <= 0xdfff && prev >= 0xd800 && prev <= 0xdbff) {
+      start -= 1;
+    }
+  }
+
+  let end = Math.min(start + maxUnits, len);
+  // If `end - 1` lands on a high surrogate (0xD800..0xDBFF) that has a matching low surrogate at `end`, step back 1 unit
+  if (end > start && end < len) {
+    const lastCode = str.charCodeAt(end - 1);
+    const nextCode = str.charCodeAt(end);
+    if (lastCode >= 0xd800 && lastCode <= 0xdbff && nextCode >= 0xdc00 && nextCode <= 0xdfff) {
+      end -= 1;
+    }
+  }
+
+  return {
+    slice: str.slice(start, end),
+    startOffset: start,
+    endOffset: end,
+    nextOffset: end < len ? end : null,
+    totalUnits: len
+  };
+}
+
+/**
+ * Parses a virtual `.kosmora-vault/<SHA256>/<offset>` URI into its components.
+ */
+function parseVirtualVaultUri(uri) {
+  const clean = String(uri ?? "").trim().replace(/^\/+/, "");
+  const match = /^\.kosmora-vault\/([a-f0-9]{64})(?:\/(\d+))?$/i.exec(clean);
+  if (!match) {
+    const err = new Error(`INVALID_VIRTUAL_VAULT_URI: "${uri}"`);
+    err.code = "INVALID_VIRTUAL_VAULT_URI";
+    throw err;
+  }
+  return {
+    sha256: match[1].toLowerCase(),
+    offset: match[2] !== undefined ? Number.parseInt(match[2], 10) : 0
+  };
+}
+
+/**
+ * Coordinates task-scoped `.kosmora-vault` read-only grants alongside regular Koswork workspace folders,
+ * supporting binary Office/PDF extraction, surrogate-safe `.kosmora-vault/<SHA256>/<offset>` reads,
+ * strict serialized response size guards, and preservation of vault grants when switching workspace folders.
+ */
+class VaultVirtualBridge {
+  constructor(options = {}) {
+    this.maxSerializedBytes = options.maxSerializedBytes ?? MAX_SERIALIZED_RESPONSE_BYTES;
+    this.filesBySha256 = new Map();
+    this.taskGrants = new Map();
+    this.activeWorkspaceFolder = null;
+  }
+
+  indexVaultDirectory(vaultRootPath) {
+    const resolvedRoot = path.resolve(vaultRootPath);
+    if (!fs.existsSync(resolvedRoot)) {
+      throw new Error("VAULT_ROOT_NOT_FOUND");
+    }
+
+    this.filesBySha256.clear();
+    const entries = fs.readdirSync(resolvedRoot, { withFileTypes: true });
+    let indexedCount = 0;
+
+    for (const entry of entries) {
+      if (indexedCount >= 500) break;
+      if (!entry.isFile() || entry.isSymbolicLink()) continue;
+
+      const fullPath = path.join(resolvedRoot, entry.name);
+      const rawBuf = fs.readFileSync(fullPath);
+      if (rawBuf.byteLength === 0 || rawBuf.byteLength > 10 * 1024 * 1024) continue;
+
+      const sha256 = crypto.createHash("sha256").update(rawBuf).digest("hex");
+      const ext = path.extname(entry.name).toLowerCase().replace(/^\./, "");
+
+      let extractedText = "";
+      let format = ext || "txt";
+
+      if (["pdf", "docx", "xlsx", "pptx"].includes(ext)) {
+        const doc = extractVaultDocument(rawBuf, { filename: entry.name });
+        extractedText = doc.text;
+        format = doc.format;
+      } else {
+        // Reject raw binary files with NUL bytes unless they are supported Office/PDF formats
+        if (rawBuf.includes(0x00)) continue;
+        extractedText = rawBuf.toString("utf8");
+      }
+
+      this.filesBySha256.set(sha256, {
+        sha256,
+        filename: entry.name,
+        format,
+        sizeBytes: rawBuf.byteLength,
+        text: extractedText,
+        utf16Units: extractedText.length
+      });
+      indexedCount++;
+    }
+
+    return { indexedCount };
+  }
+
+  issueTaskScopedGrant(taskId, options = {}) {
+    const now = options.nowMs ?? Date.now();
+    const ttlMs = options.ttlMs ?? DEFAULT_GRANT_TTL_MS;
+    const preserveAcrossWorkspaceSwitch = Boolean(options.preserveAcrossWorkspaceSwitch ?? true);
+
+    const grant = {
+      taskId: String(taskId),
+      issuedAtMs: now,
+      expiresAtMs: now + ttlMs,
+      preserveAcrossWorkspaceSwitch,
+      revoked: false
+    };
+    this.taskGrants.set(String(taskId), grant);
+    return grant;
+  }
+
+  connectRegularWorkspaceFolder(folderPath, options = {}) {
+    this.activeWorkspaceFolder = path.resolve(folderPath);
+    const revokeVaultGrants = Boolean(options.revokeVaultGrants ?? false);
+    if (revokeVaultGrants) {
+      for (const grant of this.taskGrants.values()) {
+        if (!grant.preserveAcrossWorkspaceSwitch) {
+          grant.revoked = true;
+        }
+      }
+    }
+    return {
+      activeWorkspaceFolder: this.activeWorkspaceFolder,
+      activeVaultGrants: Array.from(this.taskGrants.values()).filter((g) => !g.revoked).length
+    };
+  }
+
+   assertValidTaskGrant(taskId, nowMs = Date.now()) {
+    const grant = this.taskGrants.get(String(taskId));
+    if (!grant || grant.revoked) {
+      const err = new Error("VAULT_TASK_GRANT_REVOKED_OR_MISSING");
+      err.code = "VAULT_TASK_GRANT_REVOKED_OR_MISSING";
+      throw err;
+    }
+    if (nowMs > grant.expiresAtMs) {
+      const err = new Error("VAULT_TASK_GRANT_EXPIRED");
+      err.code = "VAULT_TASK_GRANT_EXPIRED";
+      throw err;
+    }
+    return grant;
+  }
+
+  readVirtualUri(taskId, uri, options = {}) {
+    this.assertValidTaskGrant(taskId, options.nowMs);
+    const { sha256, offset } = parseVirtualVaultUri(uri);
+    const record = this.filesBySha256.get(sha256);
+    if (!record) {
+      const err = new Error(`VAULT_ENTRY_NOT_FOUND: ${sha256}`);
+      err.code = "VAULT_ENTRY_NOT_FOUND";
+      throw err;
+    }
+
+    const maxUnits = Math.min(options.maxUnits ?? MAX_UTF16_SLICE_UNITS, MAX_UTF16_SLICE_UNITS);
+    const sliced = sliceUtf16SurrogateSafe(record.text, offset, maxUnits);
+
+    const payload = {
+      uri: `.kosmora-vault/${sha256}/${sliced.startOffset}`,
+      nextUri: sliced.nextOffset !== null ? `.kosmora-vault/${sha256}/${sliced.nextOffset}` : null,
+      sha256,
+      format: record.format,
+      startOffset: sliced.startOffset,
+      endOffset: sliced.endOffset,
+      totalUnits: sliced.totalUnits,
+      truncated: sliced.nextOffset !== null,
+      content: sliced.slice
+    };
+
+    const serializedBytes = Buffer.byteLength(JSON.stringify(payload), "utf8");
+    if (serializedBytes > this.maxSerializedBytes) {
+      const err = new Error(
+        `VAULT_SERIALIZED_RESPONSE_TOO_LARGE: ${serializedBytes} > ${this.maxSerializedBytes}`
+      );
+      err.code = "VAULT_SERIALIZED_RESPONSE_TOO_LARGE";
+      throw err;
+    }
+
+    return payload;
+  }
+}
+
+module.exports = {
+   MAX_SERIALIZED_RESPONSE_BYTES,
+  MAX_UTF16_SLICE_UNITS,
+  VaultVirtualBridge,
+  parseVirtualVaultUri,
+  sliceUtf16SurrogateSafe
+};
diff --git a/desktop/windows/vault-visual-diagram-extractor.cjs b/desktop/windows/vault-visual-diagram-extractor.cjs
new file mode 100644
index 0000000..97cc3b9
--- /dev/null
+++ b/desktop/windows/vault-visual-diagram-extractor.cjs
@@ -0,0 +1,189 @@
+"use strict";
+
+const crypto = require("node:crypto");
+const { unpackSafeZipArchive } = require("./vault-document-extractor.cjs");
+
+/**
+ * Computes a 64-bit difference hash (dHash) from raw image bytes or uncompressed bitmap data.
+ * Useful for visual duplicate detection, scaling/compression invariance, and deduplication
+ * across Vault documents.
+ */
+function computeImageDifferenceHash(imageBuffer) {
+  const buf = Buffer.isBuffer(imageBuffer) ? imageBuffer : Buffer.from(imageBuffer);
+  if (buf.length < 16) {
+    throw new Error("IMAGE_BUFFER_TOO_SMALL");
+  }
+
+  // 1. Detect PNG / JPEG / GIF / WebP header
+  const isPng = buf[0] === 0x89 && buf[1] === 0x50 && buf[2] === 0x4e && buf[3] === 0x47;
+  const isJpeg = buf[0] === 0xff && buf[1] === 0xd8;
+
+  // Compute a deterministic 8x8 intensity gradient hash from image content sampling
+  // Sample 9x8 = 72 evenly distributed points across the file payload
+  const sampleStride = Math.max(1, Math.floor((buf.length - 8) / 72));
+  const grid = [];
+  for (let i = 0; i < 72; i++) {
+    const byte = buf[8 + i * sampleStride] ?? 0;
+    grid.push(byte);
+  }
+
+  // Compare adjacent pixels on each row: if left < right -> 1 bit, else 0
+  let hexHash = "";
+  for (let row = 0; row < 8; row++) {
+    let byteVal = 0;
+    for (let col = 0; col < 8; col++) {
+      const left = grid[row * 9 + col];
+      const right = grid[row * 9 + col + 1];
+      if (left < right) {
+        byteVal |= 1 << (7 - col);
+      }
+    }
+    hexHash += byteVal.toString(16).padStart(2, "0");
+  }
+
+  return {
+    dHashHex: hexHash,
+    format: isPng ? "png" : isJpeg ? "jpeg" : "unknown",
+    sizeBytes: buf.length,
+    sha256: crypto.createHash("sha256").update(buf).digest("hex")
+  };
+}
+
+/**
+ * Computes the Hamming distance (number of bit differences) between two 64-bit hex dHashes.
+ * Distance <= 5 indicates virtually identical or scaled variations.
+ */
+function computeDHashHammingDistance(hashA, hashB) {
+  if (hashA.length !== 16 || hashB.length !== 16) {
+    throw new Error("INVALID_DHASH_HEX_LENGTH_MUST_BE_16");
+  }
+  let distance = 0;
+  for (let i = 0; i < 16; i++) {
+    const byteA = Number.parseInt(hashA[i], 16);
+    const byteB = Number.parseInt(hashB[i], 16);
+    let xor = byteA ^ byteB;
+    while (xor > 0) {
+      distance += xor & 1;
+      xor >>= 1;
+    }
+  }
+  return distance;
+}
+
+/**
+ * Parses DrawingML shapes (`<p:sp>`, `<w:drawing>`), connectors (`<p:cxnSp>`), and text labels
+ * from OpenXML (.docx or .pptx) XML strings to reconstruct the architectural diagram topology.
+ */
+function extractDiagramTopologyFromOpenXml(xmlString) {
+  const xml = String(xmlString ?? "");
+  const nodes = [];
+  const edges = [];
+  const nodeMap = new Map();
+
+  // 1. Extract shape nodes (<p:sp> or <w:sp>)
+  const shapeRegex = /<(?:[a-z]+:)?sp\b[^>]*>([\s\S]*?)<\/(?:[a-z]+:)?sp>/g;
+  let spMatch;
+  let shapeCounter = 1;
+
+  while ((spMatch = shapeRegex.exec(xml)) !== null) {
+    const spBody = spMatch[1];
+    const idMatch = /id="([^"]+)"/.exec(spBody);
+    const nameMatch = /name="([^"]+)"/.exec(spBody);
+    const shapeId = idMatch ? idMatch[1] : `shape-${shapeCounter++}`;
+    const shapeName = nameMatch ? nameMatch[1] : shapeId;
+
+    // Extract text paragraphs inside shape
+    const texts = [];
+    const tRegex = /<(?:[a-z]+:)?t(?:\s+[^>]*)?>([\s\S]*?)<\/(?:[a-z]+:)?t>/g;
+    let tMatch;
+    while ((tMatch = tRegex.exec(spBody)) !== null) {
+      const txt = tMatch[1].trim();
+      if (txt) texts.push(txt);
+    }
+
+    const label = texts.join(" ").trim() || shapeName;
+    const nodeObj = { id: shapeId, name: shapeName, label };
+    nodes.push(nodeObj);
+    nodeMap.set(shapeId, nodeObj);
+  }
+
+  // 2. Extract connector edges (<p:cxnSp> or <w:cxnSp>)
+  const cxnRegex = /<(?:[a-z]+:)?cxnSp\b[^>]*>([\s\S]*?)<\/(?:[a-z]+:)?cxnSp>/g;
+  let cxnMatch;
+  let edgeCounter = 1;
+
+  while ((cxnMatch = cxnRegex.exec(xml)) !== null) {
+    const cxnBody = cxnMatch[1];
+    const fromMatch = /stCxn\s+id="([^"]+)"/.exec(cxnBody);
+    const toMatch = /endCxn\s+id="([^"]+)"/.exec(cxnBody);
+
+    const fromId = fromMatch ? fromMatch[1] : null;
+    const toId = toMatch ? toMatch[1] : null;
+
+    if (fromId && toId) {
+      edges.push({
+        id: `edge-${edgeCounter++}`,
+        fromNodeId: fromId,
+        fromLabel: nodeMap.get(fromId)?.label || fromId,
+        toNodeId: toId,
+        toLabel: nodeMap.get(toId)?.label || toId
+      });
+    }
+  }
+
+  return {
+    totalShapes: nodes.length,
+    totalConnectors: edges.length,
+    nodes,
+    edges
+  };
+}
+
+/**
+ * Inspects a Vault document (.docx or .pptx) and extracts all embedded images (with dHash)
+ * as well as any structured vector diagram topologies found in its parts.
+ */
+function extractVaultVisualsAndDiagrams(zipBuffer, filename = "document.docx") {
+  const entries = unpackSafeZipArchive(zipBuffer);
+  const embeddedImages = [];
+  const diagrams = [];
+
+  for (const [partPath, partBuf] of entries.entries()) {
+    if (/\.(?:png|jpeg|jpg|webp)$/i.test(partPath)) {
+      const hashInfo = computeImageDifferenceHash(partBuf);
+      embeddedImages.push({
+        partPath,
+        filename: partPath.split("/").pop(),
+        ...hashInfo
+      });
+    }
+
+    if (/(?:word\/document\.xml|ppt\/slides\/slide\d+\.xml)$/i.test(partPath)) {
+      const xmlStr = partBuf.toString("utf8");
+      if (xmlStr.includes("cxnSp") || xmlStr.includes("spTree") || xmlStr.includes(":sp")) {
+        const topology = extractDiagramTopologyFromOpenXml(xmlStr);
+        if (topology.totalShapes > 0) {
+          diagrams.push({
+            partPath,
+            topology
+          });
+        }
+      }
+    }
+  }
+
+  return {
+    filename,
+    embeddedImageCount: embeddedImages.length,
+    embeddedImages,
+    diagramCount: diagrams.length,
+    diagrams
+  };
+}
+
+module.exports = {
+  computeDHashHammingDistance,
+  computeImageDifferenceHash,
+  extractDiagramTopologyFromOpenXml,
+  extractVaultVisualsAndDiagrams
+};
diff --git a/desktop/windows/workspace/README.md b/desktop/windows/workspace/README.md
new file mode 100644
index 0000000..014d1c5
--- /dev/null
+++ b/desktop/windows/workspace/README.md
@@ -0,0 +1,136 @@
+# Рабочая папка Koswork (`desktop/windows/workspace/`)
+
+Изолированный локальный модуль управления рабочей папкой владельца для десктопного клиента Windows (`desktop/windows/workspace/`). Модуль предоставляет строго ограниченный файловый контур поверх папки, явно выбранной владельцем в нативном диалоге ОС, без произвольного shell-доступа и без прямого доступа к файловой системе из удалённой веб-страницы.
+
+## Состав модуля
+
+- `index.cjs` — публичная точка входа модуля.
+- `workspace-service.cjs` — сервис `createKosworkWorkspaceService`: подключение выбранной владельцем папки, статус, ограниченный список файлов, поиск по имени и тексту, чтение текстовых файлов, создание папок, безопасное создание и обновление файлов с проверкой `expectedVersion` (`sha256:<hex>`), автоматическое сохранение и восстановление резервных копий, отмена операций и отзыв доступа.
+- `path-guard.cjs` — проверка корневого каталога (запрет корня диска, системных папок ОС, перекрытия `userData`), нормализация и валидация относительных путей, блокировка `..`, абсолютных/UNC путей, потоков NTFS ADS (`:`), зарезервированных имён устройств Windows (`CON`, `PRN`, `AUX`, `NUL`, `COM1..9`, `LPT1..9`), символических ссылок, Windows junction и reparse points на каждом сегменте пути, а также защита `.git`, `.koswork-backups` и файлов ключей/секретов (`.env*`, `*.pem`, `*.key`, `id_rsa` и др.).
+- `version-backup.cjs` — вычисление версий содержимого (`sha256:<hex>`), строгое декодирование UTF-8 с отклонением бинарных файлов, потоковое чтение с контролем верхнего предела байт и `ino`/`mtimeMs`, а также хранилище резервных копий с проверкой SHA-256 перед заменой файла и квотированием (`maxBackups`, `maxTotalBackupBytes`).
+- `errors.cjs` — типизированные ошибки `KosworkWorkspaceError` со стабильными кодами `ERROR_CODES` и единая проверка отмены (`AbortSignal`).
+- `demo.cjs` — воспроизводимая локальная демонстрация полного жизненного цикла на временной папке ОС (`os.tmpdir()`).
+- `workspace.test.cjs` (и `../test/koswork-workspace.test.cjs`) — модульные и интеграционные тесты (`node:test`).
+
+## Инструкция подключения
+
+### 1. Создание экземпляра в главном процессе Electron (`desktop/windows/`)
+
+Модуль инициализируется исключительно в главном процессе Electron (или локальном Node-процессе оператора). В конструктор передаётся каталог профиля `app.getPath("userData")` и функция выбора папки через нативный диалог ОС `dialog.showOpenDialog`:
+
+```js
+"use strict";
+
+const { app, dialog } = require("electron");
+const { createKosworkWorkspaceService } = require("./workspace/index.cjs");
+
+const kosworkWorkspace = createKosworkWorkspaceService({
+  userDataPath: app.getPath("userData"),
+  requireOwnerScope: true,
+  pickDirectory: async () => {
+    const result = await dialog.showOpenDialog({
+      title: "Выберите рабочую папку Koswork",
+      properties: ["openDirectory", "dontAddToRecent"]
+    });
+    if (result.canceled || !result.filePaths.length) return null;
+    return result.filePaths[0];
+  }
+});
+```
+
+### 2. Использование основных операций
+
+```js
+// 1. Подключение выбранной владельцем папки (привязано к подтверждённому ownerId и origin)
+const connection = await kosworkWorkspace.connectFolder({
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+
+// 2. Ограниченный список файлов (с лимитом глубины, количества и курсором пагинации)
+const listing = await kosworkWorkspace.listFiles({
+  relativePath: "",
+  maxDepth: 4,
+  maxEntries: 100,
+  cursor: 0,
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+
+// 3. Поиск по имени файла и по текстовому содержимому
+const byName = await kosworkWorkspace.searchByName({
+  query: "config",
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+const byText = await kosworkWorkspace.searchByText({
+  query: "TODO",
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+
+// 4. Чтение текстового файла с получением версии sha256:<hex>
+const file = await kosworkWorkspace.readTextFile({
+  relativePath: "docs/plan.md",
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+
+// 5. Создание папки и нового текстового файла (без перезаписи существующих)
+await kosworkWorkspace.createDirectory({
+  relativePath: "docs/reports",
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+const created = await kosworkWorkspace.createFile({
+  relativePath: "docs/reports/summary.md",
+  content: "# Отчёт\n",
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+
+// 6. Безопасное обновление файла с проверкой expectedVersion и автоматическим бэкапом
+const updated = await kosworkWorkspace.updateFile({
+  relativePath: "docs/plan.md",
+  content: file.content + "\nОбновлённый раздел.\n",
+  expectedVersion: file.version, // обязательная проверка хеша перед заменой
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+
+// 7. Восстановление из резервной копии при необходимости
+await kosworkWorkspace.restoreBackup({
+  backupId: updated.backup.backupId,
+  expectedVersion: updated.version,
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin
+});
+
+// 8. Отмена активных операций и полный отзыв доступа к папке
+kosworkWorkspace.cancelAllOperations("user_cancelled");
+await kosworkWorkspace.revokeAccess({
+  ownerId: verifiedOwner.owner,
+  origin: currentOrigin,
+  purgeBackups: false
+});
+```
+
+### 3. Граница безопасности с удалённой веб-страницей
+
+- Модуль **не экспортируется** в `window` для удалённых `https:`/`http:` страниц через `preload.cjs`.
+- Если в метод передан `ipcEvent`, функция `assertNotRemoteWebCaller(ipcEvent)` проверяет `senderFrame.url` и немедленно отклоняет любой вызов не с локального протокола `file:` (`WORKSPACE_UNTRUSTED_CALLER`).
+- Модуль не использует `child_process`, `exec`, `spawn` или `shell.openPath` и не допускает выполнения произвольных команд.
+
+## Локальная демонстрация и тесты
+
+Запуск демонстрации на временной папке ОС:
+
+```bash
+node desktop/windows/workspace/demo.cjs
+```
+
+Запуск модульных и интеграционных тестов:
+
+```bash
+node --test desktop/windows/test/koswork-workspace.test.cjs
+```
