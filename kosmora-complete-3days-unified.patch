+          kind: "work_prompt",
+          dependsOn: ["analyze-source"],
+          promptTemplate:
+            "Напиши итоговую аналитическую записку (не более {{maxSections}} разделов) со ссылкой {{referenceUrl}}."
+        },
+        {
