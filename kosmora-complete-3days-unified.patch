index 0000000..14b4e3f
--- /dev/null
+++ b/packages/core/src/causal-counterfactual-attribution.ts
@@ -0,0 +1,206 @@
+export interface CausalNodeSpec {
+  id: string;
+  parents: string[];
+  baselineExogenous: number;
+  /**
+   * Structural equation f_i(parents, u_i): computes node value given parent values and exogenous shock u_i.
+   * Defaults to u_i + sum(weights * parent_values) if weights are provided.
+   */
+  weights?: Record<string, number>;
+}
+
+export interface CounterfactualAttributionEntry {
+  nodeId: string;
+  observedValue: number;
+  baselineValue: number;
+  localExogenousShock: number;
+  counterfactualOutcomeIfBaseline: number;
+  totalCausalEffectOnOutcome: number;
+  normalizedResponsibilityShare: number;
+}
+
+export interface CausalAttributionReport {
+  outcomeNodeId: string;
+  observedOutcome: number;
+  baselineOutcome: number;
+  totalOutcomeDeviation: number;
+  primaryRootCauseNodeId: string | null;
+  attributions: CounterfactualAttributionEntry[];
+}
+
+/**
+ * Structural Causal Model (SCM) Do-Calculus & Counterfactual Root-Cause Attribution Engine.
+ * Evaluates Pearl's do(X = x) interventions and attributes workflow latency/cost/error anomalies
+ * across DAG ancestors via structural abduction-action-prediction.
+ */
+export class CausalCounterfactualEngine {
+  private readonly nodes = new Map<string, CausalNodeSpec>();
+  private readonly topoOrder: string[];
+
+  constructor(specs: CausalNodeSpec[]) {
+    for (const s of specs) {
+      this.nodes.set(s.id, s);
+    }
+    this.topoOrder = this.computeTopologicalOrder();
+  }
+
+  private computeTopologicalOrder(): string[] {
+    const inDegree = new Map<string, number>();
+    const children = new Map<string, string[]>();
+
+    for (const [id, spec] of this.nodes.entries()) {
+      inDegree.set(id, spec.parents.length);
+      for (const p of spec.parents) {
+        if (!this.nodes.has(p)) {
+          throw new Error(`UNKNOWN_CAUSAL_PARENT: node '${id}' references missing parent '${p}'`);
+        }
+        const list = children.get(p) ?? [];
+        list.push(id);
+        children.set(p, list);
+      }
+    }
+
+    const queue: string[] = [];
+    for (const [id, deg] of inDegree.entries()) {
+      if (deg === 0) queue.push(id);
+    }
+
+    const order: string[] = [];
+    while (queue.length > 0) {
+      const cur = queue.shift()!;
+      order.push(cur);
+      for (const child of children.get(cur) ?? []) {
+        const nextDeg = (inDegree.get(child) ?? 1) - 1;
+        inDegree.set(child, nextDeg);
+        if (nextDeg === 0) queue.push(child);
+      }
+    }
+
+    if (order.length !== this.nodes.size) {
+      throw new Error("CAUSAL_GRAPH_CYCLE_DETECTED: SCM must be a Directed Acyclic Graph");
+    }
+    return order;
+  }
+
+  /**
+   * Evaluates structural equations forward in topological order under optional Pearl do(X = x) interventions
+   * and optional custom exogenous variables U.
+   */
+  public evaluateForward(options?: {
+    doInterventions?: Record<string, number>;
+    exogenousOverrides?: Record<string, number>;
+  }): Record<string, number> {
+    const values: Record<string, number> = {};
+    const interventions = options?.doInterventions ?? {};
+    const exogenous = options?.exogenousOverrides ?? {};
+
+    for (const id of this.topoOrder) {
+      if (id in interventions) {
+        // Pearl's do(X = x) operator severs incoming parent edges and fixes X = x
+        values[id] = interventions[id]!;
+        continue;
+      }
+      const spec = this.nodes.get(id)!;
+      const u = id in exogenous ? exogenous[id]! : spec.baselineExogenous;
+      let val = u;
+      for (const parentId of spec.parents) {
+        const w = spec.weights?.[parentId] ?? 1.0;
+        val += w * (values[parentId] ?? 0);
+      }
+      values[id] = Number(val.toFixed(6));
+    }
+
+    return values;
+  }
+
+  /**
+   * Abducts latent exogenous variables U from observed node measurements:
+   * u_i = x_i - \sum_{p \in pa(i)} w_{p,i} x_p.
+   */
+  public abductExogenousVariables(observedValues: Record<string, number>): Record<string, number> {
+    const abductedU: Record<string, number> = {};
+    for (const id of this.topoOrder) {
+      const spec = this.nodes.get(id)!;
+      const obs = observedValues[id];
+      if (obs === undefined) {
+        throw new Error(`MISSING_OBSERVED_NODE: '${id}' is required for abduction`);
+      }
+      let parentContrib = 0;
+      for (const parentId of spec.parents) {
+        const w = spec.weights?.[parentId] ?? 1.0;
+        parentContrib += w * (observedValues[parentId] ?? 0);
+      }
+      abductedU[id] = Number((obs - parentContrib).toFixed(6));
+    }
+    return abductedU;
+  }
+
+  /**
+   * Performs Pearl's 3-step Counterfactual Root-Cause Attribution (Abduction -> Action -> Prediction)
+   * to quantify each node's responsibility for an anomaly in `outcomeNodeId`.
+   */
+  public attributeOutcomeAnomaly(
+    outcomeNodeId: string,
+    observedValues: Record<string, number>
+  ): CausalAttributionReport {
+    if (!this.nodes.has(outcomeNodeId)) {
+      throw new Error(`UNKNOWN_OUTCOME_NODE: '${outcomeNodeId}'`);
+    }
+
+    const baselineValues = this.evaluateForward();
+    const abductedU = this.abductExogenousVariables(observedValues);
+
+    const observedOutcome = observedValues[outcomeNodeId]!;
+    const baselineOutcome = baselineValues[outcomeNodeId]!;
+    const totalOutcomeDeviation = Number((observedOutcome - baselineOutcome).toFixed(6));
+
+    const entries: CounterfactualAttributionEntry[] = [];
+    let sumPositiveEffects = 0;
+
+    for (const id of this.topoOrder) {
+      const spec = this.nodes.get(id)!;
+      const localShock = Number((abductedU[id]! - spec.baselineExogenous).toFixed(6));
+
+      // Counterfactual query: What would the outcome have been if node `id`'s exogenous noise
+      // had remained at its normal baseline while all other nodes kept their abducted shocks?
+      const counterfactualU = { ...abductedU, [id]: spec.baselineExogenous };
+      const cfValues = this.evaluateForward({ exogenousOverrides: counterfactualU });
+      const cfOutcome = cfValues[outcomeNodeId]!;
+      const causalEffect = Number((observedOutcome - cfOutcome).toFixed(6));
+
+      if (Math.abs(causalEffect) > 0) {
+        sumPositiveEffects += Math.abs(causalEffect);
+      }
+
+      entries.push({
+        nodeId: id,
+        observedValue: observedValues[id]!,
+        baselineValue: baselineValues[id]!,
+        localExogenousShock: localShock,
+        counterfactualOutcomeIfBaseline: cfOutcome,
+        totalCausalEffectOnOutcome: causalEffect,
+        normalizedResponsibilityShare: 0
+      });
+    }
+
+    for (const entry of entries) {
+      entry.normalizedResponsibilityShare =
+        sumPositiveEffects > 1e-9
+          ? Number((Math.abs(entry.totalCausalEffectOnOutcome) / sumPositiveEffects).toFixed(4))
+          : 0;
+    }
+
+    entries.sort(
+      (a, b) => Math.abs(b.totalCausalEffectOnOutcome) - Math.abs(a.totalCausalEffectOnOutcome)
+    );
+
+    return {
+      outcomeNodeId,
+      observedOutcome,
+      baselineOutcome,
+      totalOutcomeDeviation,
+      primaryRootCauseNodeId: entries[0]?.nodeId ?? null,
+      attributions: entries
+    };
+  }
+}
diff --git a/packages/core/src/claim-grounding-verifier.ts b/packages/core/src/claim-grounding-verifier.ts
new file mode 100644
index 0000000..b56948f
--- /dev/null
+++ b/packages/core/src/claim-grounding-verifier.ts
@@ -0,0 +1,182 @@
+/**
+ * Kosmora / Nexus-OS Zero-Hallucination Citation & Claim Grounding Verifier (Wave 18)
+ *
+ * Audits generated reports, chat responses, and Word (.docx) deliverables to enforce:
+ * 1. Dedicated Source URLs: Rejects bare domain roots (e.g., https://domain.com/), placeholder links,
+ *    and bracketed footers ([1], [2]).
+ * 2. Claim-Source Fidelity: Verifies that every numeric figure, currency amount, percentage, or date
+ *    in the drafted text is explicitly present in the retrieved primary source corpus.
+ * 3. Actionable Remediation: Generates exact correction instructions when ungrounded claims or generic URLs
+ *    are detected.
+ */
+
+export interface GroundingSourceDocument {
+  id: string;
+  title: string;
+  url?: string;
+  content: string;
+}
+
+export interface GroundingViolation {
+  type: "bare_domain_url" | "bracketed_citation" | "ungrounded_metric" | "ungrounded_date" | "fabricated_url";
+  severity: "critical" | "warning";
+  snippet: string;
+  message: string;
+  remediation: string;
+}
+
+export interface ClaimGroundingAuditReport {
+  passed: boolean;
+  fidelityScore: number; // 0.0 to 1.0
+  totalLinksChecked: number;
+  dedicatedLinksCount: number;
+  totalClaimsChecked: number;
+  groundedClaimsCount: number;
+  violations: GroundingViolation[];
+  remediationSummary: string[];
+}
+
+const BRACKETED_CITATION_REGEX = /\[(\d+|source|источник|ссылка)\]/gi;
+const MARKDOWN_LINK_REGEX = /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/gi;
+const METRIC_CLAIM_REGEX = /(?:\$\s?\d[\d,]*(?:\.\d+)?|\d[\d,]*(?:\.\d+)?\s?(?:%|млн|тыс|руб|USD|EUR|GB|MB|ms|s))/gi;
+const DATE_CLAIM_REGEX = /\b(?:\d{4}-\d{2}-\d{2}|(?:January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{1,2},?\s+\d{4}|\d{1,2}\s+(?:января|февраля|марта|апреля|мая|июня|июля|августа|сентября|октября|ноября|декабря)\s+\d{4})\b/gi;
+
+export function isBareDomainHomepage(rawUrl: string): boolean {
+  try {
+    const parsed = new URL(rawUrl);
+    const cleanPath = parsed.pathname.replace(/\/+$/, "");
+    const hasSearch = parsed.search && parsed.search.length > 1;
+    const hasHash = parsed.hash && parsed.hash.length > 1;
+    return cleanPath === "" && !hasSearch && !hasHash;
+  } catch {
+    return true;
+  }
+}
+
+export class ClaimGroundingVerifier {
+  /**
+   * Audits a drafted response or report against the verified primary source documents.
+   */
+  public verifyDraftGrounding(options: {
+    draftText: string;
+    sources: GroundingSourceDocument[];
+    requireSourceUrlInCorpus?: boolean;
+  }): ClaimGroundingAuditReport {
+    const draft = String(options.draftText ?? "");
+    const violations: GroundingViolation[] = [];
+    const corpusText = options.sources.map((s) => `${s.title}\n${s.content}`).join("\n\n");
+    const corpusLower = corpusText.toLowerCase();
+    const knownUrls = new Set(
+      options.sources.map((s) => s.url?.trim()).filter((u): u is string => Boolean(u))
+    );
+
+    // 1. Check for forbidden bracketed citations like [1], [2]
+    let bracketMatch: RegExpExecArray | null;
+    BRACKETED_CITATION_REGEX.lastIndex = 0;
+    while ((bracketMatch = BRACKETED_CITATION_REGEX.exec(draft)) !== null) {
+      violations.push({
+        type: "bracketed_citation",
+        severity: "critical",
+        snippet: bracketMatch[0],
+        message: `Forbidden bracketed citation '${bracketMatch[0]}' detected instead of inline entity hyperlink.`,
+        remediation: `Replace '${bracketMatch[0]}' with an inline markdown link [Entity Name](Dedicated_URL).`
+      });
+    }
+
+    // 2. Check all markdown hyperlinks for bare domain homepages or unverified URLs
+    let totalLinksChecked = 0;
+    let dedicatedLinksCount = 0;
+    let linkMatch: RegExpExecArray | null;
+    MARKDOWN_LINK_REGEX.lastIndex = 0;
+
+    while ((linkMatch = MARKDOWN_LINK_REGEX.exec(draft)) !== null) {
+      totalLinksChecked++;
+      const anchor = linkMatch[1];
+      const url = linkMatch[2];
+
+      if (isBareDomainHomepage(url)) {
+        violations.push({
+          type: "bare_domain_url",
+          severity: "critical",
+          snippet: linkMatch[0],
+          message: `Link '${anchor}' points to a bare homepage (${url}) instead of a specific entity page.`,
+          remediation: `Update link for '${anchor}' to point to the exact deep path or document viewUrl.`
+        });
+        continue;
+      }
+
+      if (options.requireSourceUrlInCorpus && knownUrls.size > 0 && !knownUrls.has(url)) {
+        violations.push({
+          type: "fabricated_url",
+          severity: "critical",
+          snippet: linkMatch[0],
+          message: `URL '${url}' was not found in the retrieved tool source corpus.`,
+          remediation: `Use only verified URLs from tool outputs: ${Array.from(knownUrls).slice(0, 3).join(", ")}`
+        });
+        continue;
+      }
+
+      dedicatedLinksCount++;
+    }
+
+    // 3. Verify numeric metrics and currency claims against primary source corpus
+    let totalClaimsChecked = 0;
+    let groundedClaimsCount = 0;
+
+    const metrics = draft.match(METRIC_CLAIM_REGEX) ?? [];
+    for (const rawMetric of metrics) {
+      totalClaimsChecked++;
+      const cleanMetric = rawMetric.trim().toLowerCase();
+      // Normalize commas in numbers for matching (e.g. $250,000 vs 250000)
+      const strippedDigits = cleanMetric.replace(/,/g, "");
+      const corpusStripped = corpusLower.replace(/,/g, "");
+
+      if (corpusLower.includes(cleanMetric) || corpusStripped.includes(strippedDigits)) {
+        groundedClaimsCount++;
+      } else {
+        violations.push({
+          type: "ungrounded_metric",
+          severity: "critical",
+          snippet: rawMetric,
+          message: `Numeric claim '${rawMetric}' is not supported by any retrieved source document.`,
+          remediation: `Remove unverified figure '${rawMetric}' or replace with exact figure from primary source.`
+        });
+      }
+    }
+
+    // 4. Verify dates against primary source corpus
+    const dates = draft.match(DATE_CLAIM_REGEX) ?? [];
+    for (const rawDate of dates) {
+      totalClaimsChecked++;
+      const cleanDate = rawDate.trim().toLowerCase();
+      if (corpusLower.includes(cleanDate)) {
+        groundedClaimsCount++;
+      } else {
+        violations.push({
+          type: "ungrounded_date",
+          severity: "warning",
+          snippet: rawDate,
+          message: `Date claim '${rawDate}' does not appear verbatim in the retrieved source text.`,
+          remediation: `Verify date '${rawDate}' against primary source or omit unverified date.`
+        });
+      }
+    }
+
+    const totalChecks = Math.max(1, totalLinksChecked + totalClaimsChecked + violations.length);
+    const criticalCount = violations.filter((v) => v.severity === "critical").length;
+    const fidelityScore = Number(
+      Math.max(0, (totalChecks - violations.length) / totalChecks).toFixed(4)
+    );
+
+    return {
+      passed: criticalCount === 0,
+      fidelityScore,
+      totalLinksChecked,
+      dedicatedLinksCount,
+      totalClaimsChecked,
+      groundedClaimsCount,
+      violations,
+      remediationSummary: violations.map((v) => v.remediation)
+    };
+  }
+}
diff --git a/packages/core/src/constrained-grammar-enforcer.ts b/packages/core/src/constrained-grammar-enforcer.ts
new file mode 100644
index 0000000..c746106
--- /dev/null
+++ b/packages/core/src/constrained-grammar-enforcer.ts
@@ -0,0 +1,255 @@
+/**
+ * Kosmora / Nexus-OS Constrained Grammar & Schema-Guided Structured Output Enforcer (Wave 22)
+ *
+ * Repairs and validates malformed, truncated, or markdown-wrapped LLM structured JSON outputs
+ * in real time and enforces strict schema conformance before tool or workflow execution:
+ * 1. Strips markdown code fences (` ```json ... ``` `), leading/trailing conversational prose,
+ *    and single-line/multi-line comments.
+ * 2. Fixes trailing commas (`{"a": 1,}` -> `{"a": 1}`), unquoted keys, and unclosed brackets/strings
+ *    from interrupted SSE streams via a stack-based grammar automaton.
+ * 3. Validates against a typed declarative schema (`required`, `properties`, `enum`, `min`, `max`)
+ *    and coerces safe scalar representations (e.g. `"250000"` -> `250000` when `type: "number"`).
+ */
+
+export type GrammarFieldType = "string" | "number" | "boolean" | "array" | "object";
+
+export interface GrammarPropertySchema {
+  type: GrammarFieldType;
+  required?: boolean;
+  enum?: Array<string | number>;
+  min?: number;
+  max?: number;
+  default?: any;
+}
+
+export interface GrammarObjectSchema {
+  properties: Record<string, GrammarPropertySchema>;
+  allowAdditionalProperties?: boolean;
+}
+
+export interface GrammarEnforcementResult<T = Record<string, any>> {
+  valid: boolean;
+  repairedJsonString: string;
+  value: T | null;
+  repairsApplied: string[];
+  validationErrors: string[];
+}
+
+/**
+ * Stack-based deterministic JSON grammar repair for truncated or noisy LLM outputs.
+ */
+export function repairMalformedJsonStream(rawInput: string): {
+  repaired: string;
+  repairsApplied: string[];
+} {
+  const repairs: string[] = [];
+  let text = String(rawInput ?? "").trim();
+
+  // 1. Strip markdown ```json ... ``` fences
+  const fenceMatch = text.match(/```(?:json)?\s*([\s\S]*?)(?:```|$)/i);
+  if (fenceMatch && text.startsWith("```")) {
+    text = fenceMatch[1].trim();
+    repairs.push("stripped_markdown_fences");
+  }
+
+  // 2. Locate first '{' or '[' if preceded by conversational preamble
+  const firstBrace = text.indexOf("{");
+  const firstBracket = text.indexOf("[");
+  let startIdx = -1;
+  if (firstBrace !== -1 && (firstBracket === -1 || firstBrace < firstBracket)) {
+    startIdx = firstBrace;
+  } else if (firstBracket !== -1) {
+    startIdx = firstBracket;
+  }
+
+  if (startIdx > 0) {
+    text = text.slice(startIdx);
+    repairs.push("stripped_leading_prose");
+  }
+
+  // 3. Remove trailing commas before '}' or ']'
+  const noTrailingCommas = text.replace(/,\s*([}\]])/g, "$1");
+  if (noTrailingCommas !== text) {
+    text = noTrailingCommas;
+    repairs.push("removed_trailing_commas");
+  }
+
+  // 4. Quote unquoted object keys: `{ key: "val" }` -> `{ "key": "val" }`
+  const quotedKeys = text.replace(/([{,]\s*)([a-zA-Z_][a-zA-Z0-9_]*)\s*:/g, '$1"$2":');
+  if (quotedKeys !== text) {
+    text = quotedKeys;
+    repairs.push("quoted_unquoted_keys");
+  }
+
+  // 5. Stack-based bracket & string closure for truncated streams
+  const stack: string[] = [];
+  let inString = false;
+  let escape = false;
+  let lastValidEnd = text.length;
+
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (escape) {
+      escape = false;
+      continue;
+    }
+    if (ch === "\\") {
+      escape = true;
+      continue;
+    }
+    if (ch === '"') {
+      inString = !inString;
+      continue;
+    }
+    if (!inString) {
+      if (ch === "{") {
+        stack.push("}");
+      } else if (ch === "[") {
+        stack.push("]");
+      } else if (ch === "}" || ch === "]") {
+        if (stack.length > 0 && stack[stack.length - 1] === ch) {
+          stack.pop();
+          if (stack.length === 0) {
+            lastValidEnd = i + 1;
+            break;
+          }
+        }
+      }
+    }
+  }
+
+  if (stack.length === 0 && !inString && lastValidEnd < text.length) {
+    text = text.slice(0, lastValidEnd);
+    repairs.push("stripped_trailing_prose");
+  } else if (inString || stack.length > 0) {
+    if (inString) {
+      text += '"';
+      repairs.push("closed_truncated_string");
+    }
+    // Remove dangling colon or comma at the end before closing brackets
+    text = text.replace(/[,:\s]+$/, "");
+    while (stack.length > 0) {
+      text += stack.pop();
+    }
+    repairs.push("closed_truncated_brackets");
+  }
+
+  return { repaired: text, repairsApplied: repairs };
+}
+
+export class ConstrainedGrammarEnforcer {
+  /**
+   * Repairs a raw LLM string and validates/coerces it against the target `GrammarObjectSchema`.
+   */
+  public enforceSchema<T = Record<string, any>>(
+    rawInput: string,
+    schema: GrammarObjectSchema
+  ): GrammarEnforcementResult<T> {
+    const { repaired, repairsApplied } = repairMalformedJsonStream(rawInput);
+    const validationErrors: string[] = [];
+
+    let parsed: any;
+    try {
+      parsed = JSON.parse(repaired);
+    } catch (err: any) {
+      return {
+        valid: false,
+        repairedJsonString: repaired,
+        value: null,
+        repairsApplied,
+        validationErrors: [`JSON_PARSE_ERROR: ${err?.message || String(err)}`]
+      };
+    }
+
+    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+      return {
+        valid: false,
+        repairedJsonString: repaired,
+        value: null,
+        repairsApplied,
+        validationErrors: ["ROOT_NOT_OBJECT: Expected top-level JSON object"]
+      };
+    }
+
+    const output: Record<string, any> = {};
+
+    for (const [propName, propSchema] of Object.entries(schema.properties)) {
+      let val = parsed[propName];
+
+      if (val === undefined || val === null) {
+        if (propSchema.default !== undefined) {
+          val = structuredClone(propSchema.default);
+          repairsApplied.push(`applied_default:${propName}`);
+        } else if (propSchema.required) {
+          validationErrors.push(`MISSING_REQUIRED_FIELD: '${propName}' is required`);
+          continue;
+        } else {
+          continue;
+        }
+      }
+
+      // Safe type coercion
+      if (propSchema.type === "number" && typeof val === "string") {
+        const cleaned = val.replace(/[$,\s]/g, "");
+        const num = Number(cleaned);
+        if (!Number.isNaN(num)) {
+          val = num;
+          repairsApplied.push(`coerced_number:${propName}`);
+        }
+      } else if (propSchema.type === "boolean" && typeof val === "string") {
+        if (val.toLowerCase() === "true") {
+          val = true;
+          repairsApplied.push(`coerced_boolean:${propName}`);
+        } else if (val.toLowerCase() === "false") {
+          val = false;
+          repairsApplied.push(`coerced_boolean:${propName}`);
+        }
+      }
+
+      // Type check
+      const actualType = Array.isArray(val) ? "array" : typeof val;
+      if (actualType !== propSchema.type) {
+        validationErrors.push(
+          `TYPE_MISMATCH: Field '${propName}' expected ${propSchema.type}, got ${actualType}`
+        );
+        continue;
+      }
+
+      // Enum check
+      if (propSchema.enum && !propSchema.enum.includes(val)) {
+        validationErrors.push(
+          `ENUM_VIOLATION: Field '${propName}' value '${val}' not in [${propSchema.enum.join(", ")}]`
+        );
+        continue;
+      }
+
+      // Numeric bounds check
+      if (propSchema.type === "number") {
+        if (propSchema.min !== undefined && val < propSchema.min) {
+          validationErrors.push(`MIN_VIOLATION: Field '${propName}' (${val}) < min ${propSchema.min}`);
+        }
+        if (propSchema.max !== undefined && val > propSchema.max) {
+          validationErrors.push(`MAX_VIOLATION: Field '${propName}' (${val}) > max ${propSchema.max}`);
+        }
+      }
+
+      output[propName] = val;
+    }
+
+    if (schema.allowAdditionalProperties) {
+      for (const [k, v] of Object.entries(parsed)) {
+        if (!(k in schema.properties)) {
+          output[k] = v;
+        }
+      }
+    }
+
+    return {
+      valid: validationErrors.length === 0,
+      repairedJsonString: JSON.stringify(output),
+      value: validationErrors.length === 0 ? (output as T) : null,
+      repairsApplied,
+      validationErrors
+    };
+  }
+}
diff --git a/packages/core/src/datalog-inference-engine.ts b/packages/core/src/datalog-inference-engine.ts
new file mode 100644
index 0000000..c4e4bed
--- /dev/null
+++ b/packages/core/src/datalog-inference-engine.ts
@@ -0,0 +1,220 @@
+/**
+ * Kosmora / Nexus-OS Deductive Datalog & Forward-Chaining Policy Inference Engine (Wave 23)
+ *
+ * Implements stratified semi-naive bottom-up Datalog evaluation over Extensional Database (EDB)
+ * facts and Intensional Database (IDB) Horn clauses:
+ *   `head( ?X, ?Z ) :- body1( ?X, ?Y ), body2( ?Y, ?Z ), not forbidden( ?X ).`
+ *
+ * Capabilities:
+ * 1. Transitive closure & multi-hop relational reasoning (e.g. `depends_on`, `can_access`, `derived_hazard`).
+ * 2. Stratified negation (`negated: true`) for policy exclusion rules.
+ * 3. Deterministic least-fixed-point convergence with full derivation lineage.
+ */
+
+export interface DatalogAtom {
+  predicate: string;
+  terms: string[]; // Variables start with '?' (e.g. '?X'), constants are plain strings
+  negated?: boolean;
+}
+
+export interface DatalogRule {
+  id: string;
+  head: DatalogAtom;
+  body: DatalogAtom[];
+}
+
+export interface DerivedFactRecord {
+  predicate: string;
+  args: string[];
+  derivedByRuleId: string | "EDB";
+}
+
+function isVariable(term: string): boolean {
+  return term.startsWith("?");
+}
+
+function factKey(predicate: string, args: string[]): string {
+  return `${predicate}(${args.map((a) => JSON.stringify(a)).join(",")})`;
+}
+
+export class DatalogInferenceEngine {
+  private readonly facts = new Map<string, DerivedFactRecord>();
+  private readonly rules: DatalogRule[] = [];
+
+  /**
+   * Adds an extensional ground fact `predicate(arg1, arg2, ...)` to the knowledge base.
+   */
+  public addFact(predicate: string, ...args: string[]): void {
+    const key = factKey(predicate, args);
+    if (!this.facts.has(key)) {
+      this.facts.set(key, {
+        predicate,
+        args,
+        derivedByRuleId: "EDB"
+      });
+    }
+  }
+
+  /**
+   * Registers a Horn clause rule `head :- body1, body2, ...`.
+   */
+  public addRule(rule: DatalogRule): void {
+    this.rules.push(rule);
+  }
+
+  /**
+   * Evaluates all registered rules to a least fixed point (bottom-up forward chaining).
+   * Positive body atoms are unified first, followed by negated guards (`not pred(...)`).
+   */
+  public materializeFixedPoint(maxIterations = 100): {
+    iterations: number;
+    totalFacts: number;
+    newlyDerivedCount: number;
+  } {
+    let iterations = 0;
+    let newlyDerivedCount = 0;
+    let changed = true;
+
+    while (changed && iterations < maxIterations) {
+      changed = false;
+      iterations += 1;
+
+      for (const rule of this.rules) {
+        const positiveBody = rule.body.filter((b) => !b.negated);
+        const negativeBody = rule.body.filter((b) => b.negated);
+
+        const bindingsList = this.matchPositiveConjunction(positiveBody, [new Map()]);
+
+        for (const binding of bindingsList) {
+          // Check negative guards
+          let blockedByNegation = false;
+          for (const negAtom of negativeBody) {
+            const groundArgs = negAtom.terms.map((t) =>
+              isVariable(t) ? (binding.get(t) ?? t) : t
+            );
+            // If all terms are bound and the negated fact exists, guard fails
+            if (!groundArgs.some(isVariable)) {
+              if (this.facts.has(factKey(negAtom.predicate, groundArgs))) {
+                blockedByNegation = true;
+                break;
+              }
+            }
+          }
+
+          if (blockedByNegation) continue;
+
+          // Instantiate head atom
+          const headArgs = rule.head.terms.map((t) =>
+            isVariable(t) ? (binding.get(t) ?? t) : t
+          );
+          if (headArgs.some(isVariable)) {
+            continue; // Unsafe rule head variable
+          }
+
+          const key = factKey(rule.head.predicate, headArgs);
+          if (!this.facts.has(key)) {
+            this.facts.set(key, {
+              predicate: rule.head.predicate,
+              args: headArgs,
+              derivedByRuleId: rule.id
+            });
+            newlyDerivedCount += 1;
+            changed = true;
+          }
+        }
+      }
+    }
+
+    return {
+      iterations,
+      totalFacts: this.facts.size,
+      newlyDerivedCount
+    };
+  }
+
+  /**
+   * Queries ground or pattern-matched facts after materialization.
+   * Pass `"?X"` wildcards or exact constants.
+   */
+  public query(predicate: string, patternTerms?: string[]): DerivedFactRecord[] {
+    const results: DerivedFactRecord[] = [];
+    for (const rec of this.facts.values()) {
+      if (rec.predicate !== predicate) continue;
+      if (!patternTerms) {
+        results.push(rec);
+        continue;
+      }
+      if (rec.args.length !== patternTerms.length) continue;
+
+      const env = new Map<string, string>();
+      let matched = true;
+      for (let i = 0; i < patternTerms.length; i++) {
+        const pat = patternTerms[i];
+        const actual = rec.args[i];
+        if (isVariable(pat)) {
+          const bound = env.get(pat);
+          if (bound !== undefined && bound !== actual) {
+            matched = false;
+            break;
+          }
+          env.set(pat, actual);
+        } else if (pat !== actual) {
+          matched = false;
+          break;
+        }
+      }
+
+      if (matched) {
+        results.push(rec);
+      }
+    }
+    return results;
+  }
+
+  private matchPositiveConjunction(
+    atoms: DatalogAtom[],
+    currentBindings: Array<Map<string, string>>
+  ): Array<Map<string, string>> {
+    let bindings = currentBindings;
+    for (const atom of atoms) {
+      const nextBindings: Array<Map<string, string>> = [];
+      const candidateFacts = Array.from(this.facts.values()).filter(
+        (f) => f.predicate === atom.predicate && f.args.length === atom.terms.length
+      );
+
+      for (const b of bindings) {
+        for (const fact of candidateFacts) {
+          const merged = this.unifyAtomWithFact(atom, fact.args, b);
+          if (merged) {
+            nextBindings.push(merged);
+          }
+        }
+      }
+      bindings = nextBindings;
+      if (bindings.length === 0) break;
+    }
+    return bindings;
+  }
+
+  private unifyAtomWithFact(
+    atom: DatalogAtom,
+    factArgs: string[],
+    env: Map<string, string>
+  ): Map<string, string> | null {
+    const nextEnv = new Map(env);
+    for (let i = 0; i < atom.terms.length; i++) {
+      const term = atom.terms[i];
+      const val = factArgs[i];
+      if (isVariable(term)) {
+        const existing = nextEnv.get(term);
+        if (existing !== undefined && existing !== val) {
+          return null;
+        }
+        nextEnv.set(term, val);
+      } else if (term !== val) {
+        return null;
+      }
+    }
+    return nextEnv;
+  }
+}
diff --git a/packages/core/src/differential-privacy-telemetry.ts b/packages/core/src/differential-privacy-telemetry.ts
new file mode 100644
index 0000000..cf61292
--- /dev/null
+++ b/packages/core/src/differential-privacy-telemetry.ts
@@ -0,0 +1,299 @@
+import { randomBytes } from "node:crypto";
+
+export interface PrivacyBudgetConfig {
+  ownerId: string;
+  maxEpsilon: number;
+  maxDelta: number;
+}
+
+export interface PrivacyLedgerEntry {
+  queryId: string;
+  mechanism: "laplace" | "gaussian" | "randomized_response";
+  metricName: string;
+  epsilonSpent: number;
+  deltaSpent: number;
+  sensitivity: number;
+  rawEstimate?: number;
+  privatizedValue: number | boolean;
+  timestampIso: string;
+}
+
+export interface PrivatizedNumericResult {
+  queryId: string;
+  metricName: string;
+  privatizedValue: number;
+  noiseAdded: number;
+  scaleParameter: number;
+  confidenceInterval95: [number, number];
+  remainingEpsilon: number;
+  remainingDelta: number;
+}
+
+/**
+ * (epsilon, delta)-Differential Privacy Telemetry & Privacy Budget Accountant.
+ * Provides sensitivity clamping, calibrated Laplace and Gaussian mechanisms,
+ * Randomized Response for local boolean telemetry, and hard privacy budget enforcement.
+ */
+export class DifferentialPrivacyTelemetryEngine {
+  private readonly ownerId: string;
+  private readonly maxEpsilon: number;
+  private readonly maxDelta: number;
+  private spentEpsilon = 0;
+  private spentDelta = 0;
+  private readonly ledger: PrivacyLedgerEntry[] = [];
+  private rngState: number | null;
+
+  constructor(config: PrivacyBudgetConfig & { deterministicSeed?: number }) {
+    if (config.maxEpsilon <= 0) {
+      throw new Error("INVALID_PRIVACY_BUDGET: maxEpsilon must be > 0");
+    }
+    if (config.maxDelta < 0 || config.maxDelta >= 1) {
+      throw new Error("INVALID_PRIVACY_BUDGET: maxDelta must be in [0, 1)");
+    }
+    this.ownerId = config.ownerId;
+    this.maxEpsilon = config.maxEpsilon;
+    this.maxDelta = config.maxDelta;
+    this.rngState =
+      config.deterministicSeed !== undefined ? config.deterministicSeed >>> 0 || 1 : null;
+  }
+
+  /**
+   * Returns a uniform random number in (0, 1) using either CSPRNG or xorshift32 (when seeded for tests).
+   */
+  private nextUniformOpen(): number {
+    if (this.rngState !== null) {
+      let x = this.rngState;
+      x ^= x << 13;
+      x ^= x >>> 17;
+      x ^= x << 5;
+      this.rngState = x >>> 0;
+      // Map to (0, 1) strictly avoiding 0 and 1
+      return ((this.rngState >>> 0) + 0.5) / 4294967296;
+    }
+    const buf = randomBytes(4);
+    const uint = buf.readUInt32LE(0);
+    return (uint + 0.5) / 4294967296;
+  }
+
+  /**
+   * Clips an individual contribution to [lowerBound, upperBound] to bound L1/L2 sensitivity.
+   */
+  public static clipContribution(value: number, lowerBound: number, upperBound: number): number {
+    if (lowerBound > upperBound) {
+      throw new Error("INVALID_CLIP_BOUNDS: lowerBound cannot exceed upperBound");
+    }
+    return Math.min(upperBound, Math.max(lowerBound, value));
+  }
+
+  private chargeBudget(epsilon: number, delta: number): void {
+    if (epsilon <= 0) {
+      throw new Error("INVALID_EPSILON: epsilon must be > 0");
+    }
+    if (delta < 0) {
+      throw new Error("INVALID_DELTA: delta must be >= 0");
+    }
+    const nextEps = Number((this.spentEpsilon + epsilon).toFixed(12));
+    const nextDelta = Number((this.spentDelta + delta).toFixed(12));
+    if (nextEps > this.maxEpsilon + 1e-12 || nextDelta > this.maxDelta + 1e-12) {
+      throw new Error(
+        `PRIVACY_BUDGET_EXHAUSTED: requested (eps=${epsilon}, delta=${delta}) exceeds remaining (${this.remainingEpsilon.toFixed(4)}, ${this.remainingDelta.toFixed(6)})`
+      );
+    }
+    this.spentEpsilon = nextEps;
+    this.spentDelta = nextDelta;
+  }
+
+  /**
+   * Executes the Laplace Mechanism: adds Lap(sensitivity / epsilon) noise.
+   * Satisfies pure (epsilon, 0)-Differential Privacy.
+   */
+  public releaseLaplaceMetric(params: {
+    metricName: string;
+    trueValue: number;
+    l1Sensitivity: number;
+    epsilon: number;
+  }): PrivatizedNumericResult {
+    if (params.l1Sensitivity <= 0) {
+      throw new Error("INVALID_SENSITIVITY: l1Sensitivity must be > 0");
+    }
+    this.chargeBudget(params.epsilon, 0);
+
+    const b = params.l1Sensitivity / params.epsilon;
+    const u = this.nextUniformOpen() - 0.5;
+    const sign = u < 0 ? -1 : 1;
+    const noise = -b * sign * Math.log(1 - 2 * Math.abs(u));
+    const privatizedValue = params.trueValue + noise;
+
+    // 95% confidence interval for Laplace(0, b) is +/- b * ln(1 / 0.05) = b * ln(20)
+    const margin95 = b * Math.log(20);
+    const queryId = `dp_lap_${this.ledger.length + 1}`;
+
+    this.ledger.push({
+      queryId,
+      mechanism: "laplace",
+      metricName: params.metricName,
+      epsilonSpent: params.epsilon,
+      deltaSpent: 0,
+      sensitivity: params.l1Sensitivity,
+      privatizedValue,
+      timestampIso: new Date().toISOString()
+    });
+
+    return {
+      queryId,
+      metricName: params.metricName,
+      privatizedValue,
+      noiseAdded: noise,
+      scaleParameter: b,
+      confidenceInterval95: [privatizedValue - margin95, privatizedValue + margin95],
+      remainingEpsilon: this.remainingEpsilon,
+      remainingDelta: this.remainingDelta
+    };
+  }
+
+  /**
+   * Executes the Analytic Gaussian Mechanism: adds N(0, sigma^2) noise where
+   * sigma = l2Sensitivity * sqrt(2 * ln(1.25 / delta)) / epsilon.
+   * Satisfies (epsilon, delta)-Differential Privacy.
+   */
+  public releaseGaussianMetric(params: {
+    metricName: string;
+    trueValue: number;
+    l2Sensitivity: number;
+    epsilon: number;
+    delta: number;
+  }): PrivatizedNumericResult {
+    if (params.l2Sensitivity <= 0) {
+      throw new Error("INVALID_SENSITIVITY: l2Sensitivity must be > 0");
+    }
+    if (params.delta <= 0 || params.delta >= 1) {
+      throw new Error("INVALID_DELTA: Gaussian mechanism requires delta in (0, 1)");
+    }
+    this.chargeBudget(params.epsilon, params.delta);
+
+    const sigma =
+      (params.l2Sensitivity * Math.sqrt(2 * Math.log(1.25 / params.delta))) / params.epsilon;
+
+    // Box-Muller transform
+    const u1 = this.nextUniformOpen();
+    const u2 = this.nextUniformOpen();
+    const z0 = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
+    const noise = z0 * sigma;
+    const privatizedValue = params.trueValue + noise;
+    const margin95 = 1.95996 * sigma;
+    const queryId = `dp_gauss_${this.ledger.length + 1}`;
+
+    this.ledger.push({
+      queryId,
+      mechanism: "gaussian",
+      metricName: params.metricName,
+      epsilonSpent: params.epsilon,
+      deltaSpent: params.delta,
+      sensitivity: params.l2Sensitivity,
+      privatizedValue,
+      timestampIso: new Date().toISOString()
+    });
+
+    return {
+      queryId,
+      metricName: params.metricName,
+      privatizedValue,
+      noiseAdded: noise,
+      scaleParameter: sigma,
+      confidenceInterval95: [privatizedValue - margin95, privatizedValue + margin95],
+      remainingEpsilon: this.remainingEpsilon,
+      remainingDelta: this.remainingDelta
+    };
+  }
+
+  /**
+   * Warner's Randomized Response for Local Differential Privacy (LDP) on boolean flags.
+   * Reports truth with probability p = e^eps / (e^eps + 1).
+   */
+  public releaseRandomizedResponseBoolean(params: {
+    metricName: string;
+    truth: boolean;
+    epsilon: number;
+  }): {
+    queryId: string;
+    privatizedFlag: boolean;
+    truthProbability: number;
+    remainingEpsilon: number;
+  } {
+    this.chargeBudget(params.epsilon, 0);
+    const expEps = Math.exp(params.epsilon);
+    const truthProbability = expEps / (expEps + 1);
+    const u = this.nextUniformOpen();
+    const keepTruth = u <= truthProbability;
+    const privatizedFlag = keepTruth ? params.truth : !params.truth;
+    const queryId = `dp_rr_${this.ledger.length + 1}`;
+
+    this.ledger.push({
+      queryId,
+      mechanism: "randomized_response",
+      metricName: params.metricName,
+      epsilonSpent: params.epsilon,
+      deltaSpent: 0,
+      sensitivity: 1,
+      privatizedValue: privatizedFlag,
+      timestampIso: new Date().toISOString()
+    });
+
+    return {
+      queryId,
+      privatizedFlag,
+      truthProbability,
+      remainingEpsilon: this.remainingEpsilon
+    };
+  }
+
+  /**
+   * Unbiased estimator for true proportion of 'true' flags from N Randomized Response reports.
+   */
+  public static estimateTrueProportionFromRandomizedResponses(
+    responses: boolean[],
+    epsilon: number
+  ): number {
+    if (responses.length === 0) return 0;
+    const expEps = Math.exp(epsilon);
+    const p = expEps / (expEps + 1);
+    if (Math.abs(2 * p - 1) < 1e-9) return 0.5;
+    const observedRate = responses.filter(Boolean).length / responses.length;
+    const unbiased = (observedRate - (1 - p)) / (2 * p - 1);
+    return Math.min(1, Math.max(0, unbiased));
+  }
+
+  public get remainingEpsilon(): number {
+    return Math.max(0, Number((this.maxEpsilon - this.spentEpsilon).toFixed(12)));
+  }
+
+  public get remainingDelta(): number {
+    return Math.max(0, Number((this.maxDelta - this.spentDelta).toFixed(12)));
+  }
+
+  public getAuditLedger(): ReadonlyArray<PrivacyLedgerEntry> {
+    return [...this.ledger];
+  }
+
+  public getBudgetSummary(): {
+    ownerId: string;
+    maxEpsilon: number;
+    spentEpsilon: number;
+    remainingEpsilon: number;
+    maxDelta: number;
+    spentDelta: number;
+    remainingDelta: number;
+    queryCount: number;
+  } {
+    return {
+      ownerId: this.ownerId,
+      maxEpsilon: this.maxEpsilon,
+      spentEpsilon: this.spentEpsilon,
+      remainingEpsilon: this.remainingEpsilon,
+      maxDelta: this.maxDelta,
+      spentDelta: this.spentDelta,
+      remainingDelta: this.remainingDelta,
+      queryCount: this.ledger.length
+    };
+  }
+}
