@@ -0,0 +1,193 @@
+import { createHash } from "node:crypto";
+import {
+  extractMemoryEntities,
+  normalizeStem,
+  type ExtractedEntity
+} from "./context-memory-hybrid-search.ts";
+
+export type ConsensusVerdictType = "consensus_reached" | "revisions_required" | "vetoed";
+
+export interface AgentFlawReport {
+  agent: "proposer" | "critic" | "fact_auditor";
+  severity: "critical" | "warning" | "nitpick";
+  category: "hallucination" | "omission" | "contradiction" | "superlative_fluff" | "unverified_metric";
+  message: string;
+  verbatimSnippet?: string;
+}
+
+export interface MultiAgentConsensusReport {
+  verdict: ConsensusVerdictType;
+  overallConfidenceScore: number;
+  proposerScore: number;
+  criticScore: number;
+  factAuditorScore: number;
+  flaws: AgentFlawReport[];
+  remediationDirectives: string[];
+  consensusDigestSha256: string;
+  evaluatedAt: string;
+}
+
+export interface VerifiedEvidenceItem {
+  id: string;
+  title: string;
+  text: string;
+  sha256?: string;
+}
+
+const UNGROUNDED_SUPERLATIVES = [
+  "flawlessly",
+  "perfectly",
+  "100% correct",
+  "undisputed",
+  "unrivaled",
+  "gold standard",
+  "best in the world",
+  "безупречно",
+  "идеально",
+  "абсолютно лучший",
+  "непревзойдённый"
+];
+
+/**
+ * Autonomous Multi-Agent Consensus & Adversarial Verification Engine for Koswork Scenarios.
+ *
+ * Implements a tri-agent deliberation protocol:
+ * 1. Proposer: verifies task requirements coverage and expected artifact deliverables.
+ * 2. Adversarial Critic: hunts for ungrounded superlatives, internal contradictions, and logical voids.
+ * 3. Fact-Auditor: cross-references all numbers, dates, and claims strictly against verified source documents.
+ */
+export class MultiAgentConsensusEngine {
+  evaluateConsensus(input: {
+    taskGoal: string;
+    expectedRequirements: string[];
+    sourceEvidence: VerifiedEvidenceItem[];
+    draftContent: string;
+  }): MultiAgentConsensusReport {
+    const draft = String(input.draftContent ?? "").normalize("NFKC");
+    const draftLower = draft.toLowerCase();
+    const flaws: AgentFlawReport[] = [];
+    const remediations: string[] = [];
+
+    // --- 1. PROPOSER AGENT: Requirements Coverage ---
+    let matchedRequirements = 0;
+    for (const req of input.expectedRequirements) {
+      const cleanReq = req.trim();
+      if (!cleanReq) continue;
+      const reqWords = cleanReq.toLowerCase().match(/[\p{L}\p{N}]{4,}/gu) ?? [];
+      const hasCoverage = reqWords.some((rw) => draftLower.includes(normalizeStem(rw)));
+      if (hasCoverage) {
+        matchedRequirements++;
+      } else {
+        flaws.push({
+          agent: "proposer",
+          severity: "warning",
+          category: "omission",
+          message: `Требование задачи не раскрыто в черновике: «${cleanReq}»`
+        });
+        remediations.push(`Дополнить раздел с явным раскрытием требования: «${cleanReq}».`);
+      }
+    }
+    const proposerScore =
+      input.expectedRequirements.length > 0
+        ? Number((matchedRequirements / input.expectedRequirements.length).toFixed(4))
+        : 1.0;
+
+    // --- 2. ADVERSARIAL CRITIC AGENT: Fluff, Superlatives & Void Scrutiny ---
+    let criticDeductions = 0;
+    for (const sup of UNGROUNDED_SUPERLATIVES) {
+      if (draftLower.includes(sup)) {
+        flaws.push({
+          agent: "critic",
+          severity: "critical",
+          category: "superlative_fluff",
+          message: `Обнаружен запрещённый маркетинговый суперлатив: «${sup}»`,
+          verbatimSnippet: sup
+        });
+        criticDeductions += 0.25;
+        remediations.push(`Заменить суперлатив «${sup}» на объективные факты и проверяемые данные.`);
+      }
+    }
+
+    if (draft.length < 50) {
+      flaws.push({
+        agent: "critic",
+        severity: "critical",
+        category: "omission",
+        message: "Объём черновика недостаточен для содержательной оценки (менее 50 символов)."
+      });
+      criticDeductions += 0.5;
+    }
+    const criticScore = Math.max(0, Number((1.0 - criticDeductions).toFixed(4)));
+
+    // --- 3. FACT-AUDITOR AGENT: Citation & Metric Groundedness ---
+    const combinedEvidence = input.sourceEvidence
+      .map((e) => `${e.title}\n${e.text}`)
+      .join("\n\n")
+      .normalize("NFKC");
+    const evidenceLower = combinedEvidence.toLowerCase();
+
+    const draftEntities = extractMemoryEntities(draft);
+    const draftNumericAndDates = draftEntities.filter(
+      (e) => e.kind === "money_or_number" || e.kind === "date"
+    );
+
+    let verifiedMetrics = 0;
+    for (const ent of draftNumericAndDates) {
+      if (evidenceLower.includes(ent.normalized) || evidenceLower.includes(ent.raw.toLowerCase())) {
+        verifiedMetrics++;
+      } else {
+        flaws.push({
+          agent: "fact_auditor",
+          severity: "warning",
+          category: "unverified_metric",
+          message: `Численное или датовое значение «${ent.raw}» отсутствует в предоставленных исходных источниках.`,
+          verbatimSnippet: ent.raw
+        });
+        remediations.push(`Подтвердить источник значения «${ent.raw}» либо скорректировать под исходные документы.`);
+      }
+    }
+
+    const factAuditorScore =
+      draftNumericAndDates.length > 0
+        ? Number((verifiedMetrics / draftNumericAndDates.length).toFixed(4))
+        : 1.0;
+
+    // --- Calibrated Consensus Calculation ---
+    const overallConfidenceScore = Number(
+      (proposerScore * 0.35 + criticScore * 0.35 + factAuditorScore * 0.3).toFixed(4)
+    );
+
+    const hasCriticalFlaws = flaws.some((f) => f.severity === "critical");
+    let verdict: ConsensusVerdictType = "consensus_reached";
+    if (hasCriticalFlaws || overallConfidenceScore < 0.6) {
+      verdict = "vetoed";
+    } else if (flaws.length > 0 || overallConfidenceScore < 0.9) {
+      verdict = "revisions_required";
+    }
+
+    const evaluatedAt = new Date().toISOString();
+    const consensusDigestSha256 = createHash("sha256")
+      .update(
+        JSON.stringify({
+          verdict,
+          overallConfidenceScore,
+          flawCount: flaws.length,
+          evaluatedAt
+        }),
+        "utf8"
+      )
+      .digest("hex");
+
+    return {
+      verdict,
+      overallConfidenceScore,
+      proposerScore,
+      criticScore,
+      factAuditorScore,
+      flaws,
+      remediationDirectives: remediations,
+      consensusDigestSha256,
+      evaluatedAt
+    };
+  }
+}
diff --git a/packages/db/src/product-quantization-vector-codec.ts b/packages/db/src/product-quantization-vector-codec.ts
new file mode 100644
index 0000000..2cd5009
--- /dev/null
+++ b/packages/db/src/product-quantization-vector-codec.ts
@@ -0,0 +1,301 @@
+import { DatabaseSync } from "node:sqlite";
+
+export interface PqEncodedEntry {
+  id: string;
+  codes: Uint8Array; // M bytes (1 byte per subspace)
+  metadata?: Record<string, unknown>;
+}
+
+export interface PqSearchMatch {
+  id: string;
+  asymmetricL2DistanceSq: number;
+  approximateSimilarity: number;
+  metadata?: Record<string, unknown>;
+}
+
+/**
+ * Product Quantization (PQ) 8-Subspace Vector Compressor & Asymmetric Distance Computation (ADC) Engine.
+ * Compresses 64-dimensional Float32 vectors (256 bytes) into 8-byte uint8 codes (32x compression ratio)
+ * for high-density in-memory vector search on 1 GB RAM VPS instances.
+ */
+export class ProductQuantizationCodec {
+  public readonly dim: number;
+  public readonly subspaces: number;
+  public readonly subDim: number;
+  public readonly centroidsPerSubspace: number;
+  // centroids[m][k] is a Float32Array of length subDim
+  private centroids: Float32Array[][] = [];
+  private readonly encodedEntries = new Map<string, PqEncodedEntry>();
+
+  constructor(options?: {
+    dim?: number;
+    subspaces?: number;
+    centroidsPerSubspace?: number;
+  }) {
+    this.dim = options?.dim ?? 64;
+    this.subspaces = options?.subspaces ?? 8;
+    if (this.dim % this.subspaces !== 0) {
+      throw new Error("INVALID_PQ_DIMENSIONS: dim must be divisible by subspaces");
+    }
+    this.subDim = this.dim / this.subspaces;
+    this.centroidsPerSubspace = Math.min(256, Math.max(4, options?.centroidsPerSubspace ?? 16));
+  }
+
+  /**
+   * Trains subspace K-means codebooks deterministically from a training sample of vectors.
+   */
+  public trainCodebooks(trainingVectors: number[][], iterations = 8): void {
+    if (trainingVectors.length === 0) {
+      throw new Error("EMPTY_TRAINING_SET: require at least 1 vector to train PQ codebooks");
+    }
+
+    const kCount = Math.min(this.centroidsPerSubspace, trainingVectors.length);
+    this.centroids = [];
+
+    for (let m = 0; m < this.subspaces; m++) {
+      const offset = m * this.subDim;
+      // Initialize K centroids using evenly spaced training samples
+      const subCentroids: Float32Array[] = [];
+      for (let k = 0; k < kCount; k++) {
+        const sampleIdx = Math.floor((k * trainingVectors.length) / kCount);
+        const vec = trainingVectors[sampleIdx]!;
+        const c = new Float32Array(this.subDim);
+        for (let d = 0; d < this.subDim; d++) {
+          c[d] = vec[offset + d] ?? 0;
+        }
+        subCentroids.push(c);
+      }
+
+      // Lloyd's K-means refinement per subspace
+      for (let iter = 0; iter < iterations; iter++) {
+        const sums = Array.from({ length: kCount }, () => new Float64Array(this.subDim));
+        const counts = new Int32Array(kCount);
+
+        for (const vec of trainingVectors) {
+          let bestK = 0;
+          let bestDist = Infinity;
+          for (let k = 0; k < kCount; k++) {
+            const cent = subCentroids[k]!;
+            let dist = 0;
+            for (let d = 0; d < this.subDim; d++) {
+              const diff = (vec[offset + d] ?? 0) - cent[d]!;
+              dist += diff * diff;
+            }
+            if (dist < bestDist) {
+              bestDist = dist;
+              bestK = k;
+            }
+          }
+          counts[bestK]!++;
+          const sumArr = sums[bestK]!;
+          for (let d = 0; d < this.subDim; d++) {
+            sumArr[d] += vec[offset + d] ?? 0;
+          }
+        }
+
+        for (let k = 0; k < kCount; k++) {
+          if (counts[k]! > 0) {
+            const cent = subCentroids[k]!;
+            const sumArr = sums[k]!;
+            for (let d = 0; d < this.subDim; d++) {
+              cent[d] = sumArr[d]! / counts[k]!;
+            }
+          }
+        }
+      }
+
+      this.centroids.push(subCentroids);
+    }
+  }
+
+  public encodeVector(vector: number[]): Uint8Array {
+    if (this.centroids.length !== this.subspaces) {
+      throw new Error("PQ_CODEBOOK_NOT_TRAINED: call trainCodebooks() before encoding");
+    }
+    const codes = new Uint8Array(this.subspaces);
+    for (let m = 0; m < this.subspaces; m++) {
+      const offset = m * this.subDim;
+      const subCentroids = this.centroids[m]!;
+      let bestK = 0;
+      let bestDist = Infinity;
+      for (let k = 0; k < subCentroids.length; k++) {
+        const cent = subCentroids[k]!;
+        let dist = 0;
+        for (let d = 0; d < this.subDim; d++) {
+          const diff = (vector[offset + d] ?? 0) - cent[d]!;
+          dist += diff * diff;
+        }
+        if (dist < bestDist) {
+          bestDist = dist;
+          bestK = k;
+        }
+      }
+      codes[m] = bestK;
+    }
+    return codes;
+  }
+
+  public reconstructVector(codes: Uint8Array): number[] {
+    const out = new Array<number>(this.dim);
+    for (let m = 0; m < this.subspaces; m++) {
+      const offset = m * this.subDim;
+      const code = codes[m]!;
+      const cent = this.centroids[m]![code]!;
+      for (let d = 0; d < this.subDim; d++) {
+        out[offset + d] = cent[d]!;
+      }
+    }
+    return out;
+  }
+
+  public upsertVector(id: string, vector: number[], metadata?: Record<string, unknown>): Uint8Array {
+    const codes = this.encodeVector(vector);
+    this.encodedEntries.set(id, { id, codes, metadata });
+    return codes;
+  }
+
+  /**
+   * Executes Asymmetric Distance Computation (ADC): precomputes an M x K distance lookup table
+   * for the uncompressed query vector and evaluates each candidate in M table lookups!
+   */
+  public searchAsymmetricTopK(queryVector: number[], topK = 5): PqSearchMatch[] {
+    if (this.centroids.length !== this.subspaces) {
+      throw new Error("PQ_CODEBOOK_NOT_TRAINED");
+    }
+
+    // Precompute M x K squared L2 distance lookup table
+    const distanceTable: Float32Array[] = [];
+    for (let m = 0; m < this.subspaces; m++) {
+      const offset = m * this.subDim;
+      const subCentroids = this.centroids[m]!;
+      const tableM = new Float32Array(subCentroids.length);
+      for (let k = 0; k < subCentroids.length; k++) {
+        const cent = subCentroids[k]!;
+        let dist = 0;
+        for (let d = 0; d < this.subDim; d++) {
+          const diff = (queryVector[offset + d] ?? 0) - cent[d]!;
+          dist += diff * diff;
+        }
+        tableM[k] = dist;
+      }
+      distanceTable.push(tableM);
+    }
+
+    const matches: PqSearchMatch[] = [];
+    for (const entry of this.encodedEntries.values()) {
+      let distSq = 0;
+      for (let m = 0; m < this.subspaces; m++) {
+        distSq += distanceTable[m]![entry.codes[m]!]!;
+      }
+      matches.push({
+        id: entry.id,
+        asymmetricL2DistanceSq: Number(distSq.toFixed(6)),
+        // For unit-normalized vectors, cos(theta) = 1 - ||x - y||^2 / 2
+        approximateSimilarity: Number((1 - distSq / 2).toFixed(6)),
+        metadata: entry.metadata
+      });
+    }
+
+    matches.sort((a, b) => a.asymmetricL2DistanceSq - b.asymmetricL2DistanceSq);
+    return matches.slice(0, topK);
+  }
+
+  public get compressionRatio(): number {
+    const rawFloat32Bytes = this.dim * 4;
+    const pqBytes = this.subspaces;
+    return rawFloat32Bytes / pqBytes;
+  }
+
+  public saveToSqlite(sqlite: DatabaseSync, ownerId: string, namespace = "default"): string {
+    sqlite.exec(`
+      CREATE TABLE IF NOT EXISTS kosmora_pq_codebooks (
+        codebook_id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        namespace TEXT NOT NULL,
+        subspaces INTEGER NOT NULL,
+        centroids_per_subspace INTEGER NOT NULL,
+        codebook_json TEXT NOT NULL,
+        codes_json TEXT NOT NULL,
+        updated_at TEXT NOT NULL,
+        UNIQUE(owner_id, namespace)
+      );
+    `);
+
+    const codebookId = `pq_${ownerId}_${namespace}`;
+    const serializedCentroids = this.centroids.map((sub) => sub.map((c) => Array.from(c)));
+    const serializedCodes = Array.from(this.encodedEntries.values()).map((e) => ({
+      id: e.id,
+      codes: Array.from(e.codes),
+      metadata: e.metadata
+    }));
+
+    sqlite
+      .prepare(
+        `INSERT INTO kosmora_pq_codebooks
+          (codebook_id, owner_id, namespace, subspaces, centroids_per_subspace, codebook_json, codes_json, updated_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+         ON CONFLICT(owner_id, namespace) DO UPDATE SET
+          codebook_json = excluded.codebook_json,
+          codes_json = excluded.codes_json,
+          updated_at = excluded.updated_at`
+      )
+      .run(
+        codebookId,
+        ownerId,
+        namespace,
+        this.subspaces,
+        this.centroidsPerSubspace,
+        JSON.stringify({ dim: this.dim, centroids: serializedCentroids }),
+        JSON.stringify(serializedCodes),
+        new Date().toISOString()
+      );
+
+    return codebookId;
+  }
+
+  public static loadFromSqlite(
+    sqlite: DatabaseSync,
+    ownerId: string,
+    namespace = "default"
+  ): ProductQuantizationCodec | null {
+    const row = sqlite
+      .prepare(
+        `SELECT subspaces, centroids_per_subspace, codebook_json, codes_json
+         FROM kosmora_pq_codebooks WHERE owner_id = ? AND namespace = ?`
+      )
+      .get(ownerId, namespace) as
+      | {
+          subspaces: number;
+          centroids_per_subspace: number;
+          codebook_json: string;
+          codes_json: string;
+        }
+      | undefined;
+
+    if (!row) return null;
+
+    const cbData = JSON.parse(row.codebook_json) as { dim: number; centroids: number[][][] };
+    const codesData = JSON.parse(row.codes_json) as Array<{
+      id: string;
+      codes: number[];
+      metadata?: Record<string, unknown>;
+    }>;
+
+    const pq = new ProductQuantizationCodec({
+      dim: cbData.dim,
+      subspaces: row.subspaces,
+      centroidsPerSubspace: row.centroids_per_subspace
+    });
+
+    pq.centroids = cbData.centroids.map((sub) => sub.map((c) => new Float32Array(c)));
+    for (const item of codesData) {
+      pq.encodedEntries.set(item.id, {
+        id: item.id,
+        codes: new Uint8Array(item.codes),
+        metadata: item.metadata
+      });
+    }
+
+    return pq;
+  }
+}
diff --git a/packages/db/src/profile-candidate-reconciler.ts b/packages/db/src/profile-candidate-reconciler.ts
new file mode 100644
index 0000000..a0fd8d6
--- /dev/null
+++ b/packages/db/src/profile-candidate-reconciler.ts
@@ -0,0 +1,590 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import {
+  containsSensitiveSecret,
+  extractMemoryEntities,
+  normalizeStem,
+  type MemoryEntryKind
+} from "./context-memory-hybrid-search.ts";
+
+export interface ExtractedProfileCandidate {
+  candidateId: string;
+  ownerId: string;
+  kind: MemoryEntryKind;
+  title: string;
+  verbatimQuote: string;
+  quoteSha256: string;
+  sourceChatId: string | null;
+  sourceProjectId: string | null;
+  sourceChatMessageId: string | null;
+  sourceProjectMessageId: string | null;
+  createdAt: string;
+  duplicateOfEntryId: string | null;
+  contradictsEntryId: string | null;
+  contradictionReason: string | null;
+  similarCandidateIds: string[];
+}
+
+export interface ProfileCandidateScanReport {
+  method: "semantic-owner-quotes-v2";
+  scannedMessages: number;
+  candidates: ExtractedProfileCandidate[];
+  skippedDismissedCount: number;
+  skippedDuplicateCount: number;
+  skippedSensitiveCount: number;
+  contradictionCount: number;
+}
+
+const MAX_SCAN_MESSAGES = 200;
+const MAX_MESSAGE_CHARS = 16000;
+const MIN_LINE_CHARS = 8;
+const MAX_LINE_CHARS = 1000;
+const MAX_LINES_PER_MESSAGE = 8;
+const MAX_CANDIDATES = 30;
+const MAX_SIMILAR_PAIRS = 5;
+const MAX_DISMISSAL_FINGERPRINTS = 5000;
+
+const CANDIDATE_PATTERNS: Array<{ kind: MemoryEntryKind; titlePrefixRu: string; regex: RegExp }> = [
+  {
+    kind: "constraint",
+    titlePrefixRu: "Ограничение владельца",
+    regex: /(?:^|[^\p{L}\p{N}_])(?:не\s+меняй|не\s+изменяй|строго\s+не|никогда\s+не|запрещено|обязательно\s+сохраняй|лимит\s+не\s+более|потолок\s+расходов|do\s+not\s+modify|never\s+change|strictly\s+prohibited|must\s+not)/iu
+  },
+  {
+    kind: "preference",
+    titlePrefixRu: "Предпочтение владельца",
+    regex: /(?:^|[^\p{L}\p{N}_])(?:меня\s+зовут|я\s+предпочитаю|мне\s+удобнее|отвечай\s+на|пиши\s+кратко|используй\s+по\s+умолчанию|мой\s+рабочий\s+язык|i\s+prefer|always\s+respond\s+in|my\s+name\s+is)/iu
+  },
+  {
+    kind: "decision",
+    titlePrefixRu: "Принятое решение",
+    regex: /(?:^|[^\p{L}\p{N}_])(?:мы\s+решили|наша\s+цель|утвердили\s+архитектуру|переходим\s+на|выбрали\s+вариант|we\s+decided|our\s+goal\s+is|agreed\s+to\s+use)/iu
+  },
+  {
+    kind: "fact",
+    titlePrefixRu: "Факт проекта/профиля",
+    regex: /(?:^|[^\p{L}\p{N}_])(?:мой\s+проект|наш\s+репозиторий|рабочая\s+папка\s+находится|сервер\s+работает\s+на|контекстное\s+окно\s+модели|our\s+repository\s+is|production\s+server\s+runs)/iu
+  }
+];
+
+function computeCandidateFingerprint(ownerId: string, normalizedQuote: string): string {
+  return createHash("sha256")
+    .update(`${ownerId}:candidate:v2:${normalizedQuote}`, "utf8")
+    .digest("hex");
+}
+
+function hasNegation(text: string): boolean {
+  return /(?:^|[^\p{L}\p{N}_])(?:не|нет|нельзя|запрещено|никогда|без|no|not|never|without|disable|off)(?=[^\p{L}\p{N}_]|$)/iu.test(
+    text
+  );
+}
+
+function shareCoreSubjectStems(a: string, b: string): boolean {
+  const wordsA = (a.normalize("NFKC").toLowerCase().match(/[\p{L}]{4,}/gu) ?? []).map(normalizeStem);
+  const wordsB = new Set(
+    (b.normalize("NFKC").toLowerCase().match(/[\p{L}]{4,}/gu) ?? []).map(normalizeStem)
+  );
+  let shared = 0;
+  for (const w of wordsA) {
+    if (wordsB.has(w)) shared++;
+  }
+  return shared >= 2;
+}
+
+export class ProfileCandidateReconciler {
+  constructor(private readonly sqlite: DatabaseSync) {}
+
+  ensureSchema(): void {
+    this.sqlite.exec(`
+      CREATE TABLE IF NOT EXISTS context_memory_entries (
+        id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        scope TEXT NOT NULL CHECK(scope IN ('personal', 'chat', 'project')),
+        chat_id TEXT,
+        project_id TEXT,
+        kind TEXT NOT NULL CHECK(kind IN ('fact', 'preference', 'decision', 'constraint', 'hypothesis')),
+        title TEXT NOT NULL,
+        content TEXT NOT NULL,
+        pinned INTEGER NOT NULL DEFAULT 0,
+        expires_at TEXT,
+        source_chat_message_id TEXT,
+        source_project_message_id TEXT,
+        source_json TEXT NOT NULL DEFAULT '{}',
+        version INTEGER NOT NULL DEFAULT 1,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL,
+        creation_key TEXT,
+        creation_sha256 TEXT
+      );
+      CREATE TABLE IF NOT EXISTS context_memory_versions (
+        entry_id TEXT NOT NULL,
+        version INTEGER NOT NULL,
+        snapshot_json TEXT NOT NULL,
+        PRIMARY KEY (entry_id, version)
+      );
+      CREATE TABLE IF NOT EXISTS profile_candidate_dismissals (
+        owner_id TEXT NOT NULL,
+        candidate_id TEXT NOT NULL,
+        chat_message_id TEXT,
+        project_message_id TEXT,
+        created_at TEXT NOT NULL,
+        PRIMARY KEY(owner_id, candidate_id),
+        CHECK((chat_message_id IS NULL) <> (project_message_id IS NULL))
+      );
+    `);
+  }
+
+  scanAuthorizedChatCandidates(
+    ownerId: string,
+    options?: { permittedChatIds?: string[]; permittedProjectIds?: string[] }
+  ): ProfileCandidateScanReport {
+    this.ensureSchema();
+
+    const dismissedRows = this.sqlite
+      .prepare(
+        "SELECT candidate_id FROM profile_candidate_dismissals WHERE owner_id = ? LIMIT ?"
+      )
+      .all(ownerId, MAX_DISMISSAL_FINGERPRINTS) as Array<{ candidate_id: string }>;
+    const dismissedSet = new Set(dismissedRows.map((r) => r.candidate_id));
+
+    const existingEntries = this.sqlite
+      .prepare(
+        `SELECT id, scope, kind, title, content, pinned
+         FROM context_memory_entries
+         WHERE owner_id = ?
+         ORDER BY pinned DESC, updated_at DESC`
+      )
+      .all(ownerId) as Array<{
+      id: string;
+      scope: string;
+      kind: MemoryEntryKind;
+      title: string;
+      content: string;
+      pinned: number;
+    }>;
+
+    const hasGeneralChats = Boolean(
+      this.sqlite
+        .prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='general_chat_messages'")
+        .get()
+    );
+
+    const rawMessages: Array<{
+      id: string;
+      chatId: string | null;
+      projectId: string | null;
+      content: string;
+      createdAt: string;
+      sourceType: "chat" | "project";
+    }> = [];
+
+    if (hasGeneralChats) {
+      const chatRows = this.sqlite
+        .prepare(
+          `SELECT m.id, m.chat_id, m.content, m.created_at
+           FROM general_chat_messages m
+           JOIN general_chats c ON c.id = m.chat_id AND c.owner_id = m.owner_id
+           WHERE m.owner_id = ? AND m.role = 'user' AND m.status = 'completed'
+           ORDER BY m.created_at DESC
+           LIMIT ?`
+        )
+        .all(ownerId, MAX_SCAN_MESSAGES) as Array<{
+        id: string;
+        chat_id: string;
+        content: string;
+        created_at: string;
+      }>;
+
+      const allowedChatSet =
+        options?.permittedChatIds && options.permittedChatIds.length > 0
+          ? new Set(options.permittedChatIds)
+          : null;
+
+      for (const r of chatRows) {
+        if (allowedChatSet && !allowedChatSet.has(r.chat_id)) continue;
+        rawMessages.push({
+          id: r.id,
+          chatId: r.chat_id,
+          projectId: null,
+          content: r.content.slice(0, MAX_MESSAGE_CHARS),
+          createdAt: r.created_at,
+          sourceType: "chat"
+        });
+      }
+    }
+
+    let skippedDismissedCount = 0;
+    let skippedDuplicateCount = 0;
+    let skippedSensitiveCount = 0;
+    let contradictionCount = 0;
+    const candidates: ExtractedProfileCandidate[] = [];
+    const seenFingerprints = new Set<string>();
+
+    for (const msg of rawMessages) {
+      if (candidates.length >= MAX_CANDIDATES) break;
+
+      const lines = msg.content
+        .normalize("NFKC")
+        .split(/\r?\n|(?<=[.!?])\s+/u)
+        .map((l) => l.trim())
+        .filter((l) => l.length >= MIN_LINE_CHARS && l.length <= MAX_LINE_CHARS)
+        .slice(0, MAX_LINES_PER_MESSAGE);
+
+      for (const line of lines) {
+        if (candidates.length >= MAX_CANDIDATES) break;
+
+        if (containsSensitiveSecret(line)) {
+          skippedSensitiveCount++;
+          continue;
+        }
+
+        const matchedRule = CANDIDATE_PATTERNS.find((p) => p.regex.test(line));
+        if (!matchedRule) continue;
+
+        const normQuote = line.toLowerCase().replace(/\s+/g, " ");
+        const candidateId = computeCandidateFingerprint(ownerId, normQuote);
+
+        if (dismissedSet.has(candidateId) || seenFingerprints.has(candidateId)) {
+          skippedDismissedCount++;
+          continue;
+        }
+        seenFingerprints.add(candidateId);
+
+        let duplicateOfEntryId: string | null = null;
+        let contradictsEntryId: string | null = null;
+        let contradictionReason: string | null = null;
+
+        const candEntities = extractMemoryEntities(line);
+        const candNumbers = candEntities.filter(
+          (e) => e.kind === "money_or_number" || e.kind === "date"
+        );
+
+        for (const existing of existingEntries) {
+          const existingNorm = existing.content.normalize("NFKC").toLowerCase().replace(/\s+/g, " ");
+          if (existingNorm === normQuote || existingNorm.includes(normQuote)) {
+            duplicateOfEntryId = existing.id;
+            break;
+          }
+
+          if (shareCoreSubjectStems(line, existing.content)) {
+            const existingEntities = extractMemoryEntities(existing.content);
+            const existingNumbers = existingEntities.filter(
+              (e) => e.kind === "money_or_number" || e.kind === "date"
+            );
+
+            if (
+              candNumbers.length > 0 &&
+              existingNumbers.length > 0 &&
+              candNumbers[0].normalized !== existingNumbers[0].normalized
+            ) {
+              contradictsEntryId = existing.id;
+              contradictionReason = `Новое значение (${candNumbers[0].raw}) расходится с сохранённой записью «${existing.title}» (${existingNumbers[0].raw})`;
+              break;
+            }
+
+            if (hasNegation(line) !== hasNegation(existing.content)) {
+              contradictsEntryId = existing.id;
+              contradictionReason = `Противоположное условие относительно сохранённой записи «${existing.title}»`;
+              break;
+            }
+          }
+        }
+
+        if (duplicateOfEntryId) {
+          skippedDuplicateCount++;
+          continue;
+        }
+        if (contradictsEntryId) {
+          contradictionCount++;
+        }
+
+        const quoteSha256 = createHash("sha256").update(line, "utf8").digest("hex");
+        const shortSnippet = line.length > 56 ? `${line.slice(0, 53).trim()}...` : line;
+
+        candidates.push({
+          candidateId,
+          ownerId,
+          kind: matchedRule.kind,
+          title: `${matchedRule.titlePrefixRu}: ${shortSnippet}`,
+          verbatimQuote: line,
+          quoteSha256,
+          sourceChatId: msg.chatId,
+          sourceProjectId: msg.projectId,
+          sourceChatMessageId: msg.sourceType === "chat" ? msg.id : null,
+          sourceProjectMessageId: msg.sourceType === "project" ? msg.id : null,
+          createdAt: msg.createdAt,
+          duplicateOfEntryId: null,
+          contradictsEntryId,
+          contradictionReason,
+          similarCandidateIds: []
+        });
+      }
+    }
+
+    for (let i = 0; i < candidates.length; i++) {
+      for (let j = i + 1; j < candidates.length; j++) {
+        if (shareCoreSubjectStems(candidates[i].verbatimQuote, candidates[j].verbatimQuote)) {
+          if (candidates[i].similarCandidateIds.length < MAX_SIMILAR_PAIRS) {
+            candidates[i].similarCandidateIds.push(candidates[j].candidateId);
+          }
+          if (candidates[j].similarCandidateIds.length < MAX_SIMILAR_PAIRS) {
+            candidates[j].similarCandidateIds.push(candidates[i].candidateId);
+          }
+        }
+      }
+    }
+
+    return {
+      method: "semantic-owner-quotes-v2",
+      scannedMessages: rawMessages.length,
+      candidates,
+      skippedDismissedCount,
+      skippedDuplicateCount,
+      skippedSensitiveCount,
+      contradictionCount
+    };
+  }
+
+  promoteCandidateToProfile(options: {
+    ownerId: string;
+    candidate: ExtractedProfileCandidate;
+    resolution?: "replace_existing" | "keep_both";
+    pinned?: boolean;
+  }): { entryId: string; replacedEntryId: string | null; version: number } {
+    this.ensureSchema();
+    const now = new Date().toISOString();
+    const resolution = options.resolution ?? "replace_existing";
+    const pinned = Number(options.pinned ?? options.candidate.kind === "constraint");
+
+    this.sqlite.exec("BEGIN IMMEDIATE");
+    try {
+      const sourcePayload = {
+        kind: "message",
+        reference:
+          options.candidate.sourceChatMessageId ??
+          options.candidate.sourceProjectMessageId ??
+          options.candidate.candidateId,
+        chatId: options.candidate.sourceChatId,
+        projectId: options.candidate.sourceProjectId,
+        quote: options.candidate.verbatimQuote,
+        sha256: options.candidate.quoteSha256,
+        promotedFromCandidateId: options.candidate.candidateId
+      };
+
+      if (
+        options.candidate.contradictsEntryId &&
+        resolution === "replace_existing"
+      ) {
+        const targetId = options.candidate.contradictsEntryId;
+        const existing = this.sqlite
+          .prepare("SELECT version FROM context_memory_entries WHERE id = ? AND owner_id = ?")
+          .get(targetId, options.ownerId) as { version: number } | undefined;
+
+        if (existing) {
+          const nextVer = existing.version + 1;
+          this.sqlite
+            .prepare(
+              `UPDATE context_memory_entries
+               SET scope = 'personal', kind = ?, title = ?, content = ?, pinned = ?,
+                   source_chat_message_id = ?, source_project_message_id = ?, source_json = ?,
+                   version = ?, updated_at = ?
