+import { createHash, randomUUID } from "node:crypto";
+import * as zlib from "node:zlib";
+
+function crc32(buf: Buffer): number {
+  if (typeof (zlib as unknown as { crc32?: (b: Buffer) => number }).crc32 === "function") {
+    return (zlib as unknown as { crc32: (b: Buffer) => number }).crc32(buf) >>> 0;
+  }
+  let c = 0xffffffff;
+  for (let i = 0; i < buf.byteLength; i++) {
+    c ^= buf[i];
+    for (let k = 0; k < 8; k++) {
+      c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
+    }
+  }
+  return (c ^ 0xffffffff) >>> 0;
+}
+import type { DatabaseSync } from "node:sqlite";
+
+export const MAX_SNAPSHOT_TOTAL_BYTES = 32 * 1024 * 1024; // 32 MiB
+export const MAX_SNAPSHOT_PART_BYTES = 2 * 1024 * 1024; // 2 MiB per part
+export const MAX_SNAPSHOT_CHATS = 2000;
+export const MAX_SNAPSHOT_MESSAGES = 50000;
+export const MAX_SNAPSHOT_WORK_FILES = 2000;
+
+export interface CanonicalSnapshotPartMeta {
+  name: string;
+  sizeBytes: number;
+  crc32Hex: string;
+  sha256: string;
+}
+
+export interface CanonicalSnapshotManifest {
+  schemaVersion: "kosmora-drive-snapshot-v1";
+  snapshotId: string;
+  ownerId: string;
+  createdAt: string;
+  chatCount: number;
+  messageCount: number;
+  workFileCount: number;
+  totalPayloadBytes: number;
+  payloadSha256: string;
+  parts: CanonicalSnapshotPartMeta[];
+}
+
+export interface SnapshotPayloadData {
+  ownerId: string;
+  chats: Array<{
+    id: string;
+    title: string;
+    created_at: string;
+    updated_at: string;
+  }>;
+  messages: Array<{
+    id: string;
+    chat_id: string;
+    role: "user" | "assistant";
+    content: string;
+    content_type?: string;
+    status?: string;
+    created_at: string;
+  }>;
+  workFiles?: Array<{
+    id: string;
+    project_id: string;
+    work_id: string;
+    name: string;
+    content: string;
+    sha256: string;
+    bytes: number;
+    created_at: string;
+  }>;
+  memories?: Array<{
+    id: string;
+    scope: "personal" | "chat" | "project";
+    kind: string;
+    title: string;
+    content: string;
+    pinned: boolean;
+    source_json: string;
+  }>;
+}
+
+export interface RemoteDriveFileItem {
+  driveFileId: string;
+  name: string;
+  sizeBytes: number;
+  createdTime: string;
+  downloadZipBytes: () => Promise<Buffer>;
+}
+
+export interface RebuiltJournalEntry {
+  snapshotId: string;
+  driveFileId: string;
+  ownerId: string;
+  chatCount: number;
+  messageCount: number;
+  workFileCount: number;
+  payloadSha256: string;
+  archiveSha256: string;
+  status: "verified";
+  createdAt: string;
+}
+
+export interface ImportedZipRestoreResult {
+  snapshotId: string;
+  ownerId: string;
+  restoredChatIds: Record<string, string>;
+  restoredChatsCount: number;
+  restoredMessagesCount: number;
+  restoredWorkFilesCount: number;
+  restoredMemoriesCount: number;
+  interruptedRunsQuiesced: number;
+  payloadSha256: string;
+}
+
+function toCrc32Hex(buf: Buffer): string {
+  return (crc32(buf) >>> 0).toString(16).padStart(8, "0");
+}
+
+function sha256Hex(buf: Buffer | string): string {
+  return createHash("sha256").update(buf).digest("hex");
+}
+
+/**
+ * Builds a canonical ZIP STORE (compression method 0) buffer containing `manifest.json`
+ * and 2 MiB `snapshot.partNNNN.json` slices matching the PR #425 (`3579bc9`) specification.
+ */
+export function buildCanonicalStoreZipSnapshot(
+  snapshotId: string,
+  payload: SnapshotPayloadData,
+  createdAt = new Date().toISOString()
+): { zipBuffer: Buffer; archiveSha256: string; manifest: CanonicalSnapshotManifest } {
+  if (payload.chats.length > MAX_SNAPSHOT_CHATS) {
+    throw new Error("SNAPSHOT_CHAT_LIMIT_EXCEEDED");
+  }
+  if (payload.messages.length > MAX_SNAPSHOT_MESSAGES) {
+    throw new Error("SNAPSHOT_MESSAGE_LIMIT_EXCEEDED");
+  }
+  const workFiles = payload.workFiles ?? [];
+  if (workFiles.length > MAX_SNAPSHOT_WORK_FILES) {
+    throw new Error("SNAPSHOT_WORK_FILE_LIMIT_EXCEEDED");
+  }
+
+  const fullJsonBuf = Buffer.from(JSON.stringify(payload), "utf8");
+  if (fullJsonBuf.byteLength > MAX_SNAPSHOT_TOTAL_BYTES) {
+    throw new Error("SNAPSHOT_TOTAL_BYTES_EXCEEDED");
+  }
+
+  const partBuffers: Array<{ name: string; data: Buffer }> = [];
+  const partsMeta: CanonicalSnapshotPartMeta[] = [];
+
+  for (let offset = 0, idx = 1; offset < fullJsonBuf.byteLength; offset += MAX_SNAPSHOT_PART_BYTES, idx++) {
+    const slice = fullJsonBuf.subarray(
+      offset,
+      Math.min(offset + MAX_SNAPSHOT_PART_BYTES, fullJsonBuf.byteLength)
+    );
+    const partName = `snapshot.part${String(idx).padStart(4, "0")}.json`;
+    partBuffers.push({ name: partName, data: slice });
+    partsMeta.push({
+      name: partName,
+      sizeBytes: slice.byteLength,
+      crc32Hex: toCrc32Hex(slice),
+      sha256: sha256Hex(slice)
+    });
+  }
+
+  const manifest: CanonicalSnapshotManifest = {
+    schemaVersion: "kosmora-drive-snapshot-v1",
+    snapshotId,
+    ownerId: payload.ownerId,
+    createdAt,
+    chatCount: payload.chats.length,
+    messageCount: payload.messages.length,
+    workFileCount: workFiles.length,
+    totalPayloadBytes: fullJsonBuf.byteLength,
+    payloadSha256: sha256Hex(fullJsonBuf),
+    parts: partsMeta
+  };
+
+  const manifestBuf = Buffer.from(JSON.stringify(manifest, null, 2), "utf8");
+  const allEntries = [{ name: "manifest.json", data: manifestBuf }, ...partBuffers];
+
+  // Assemble canonical ZIP STORE (method = 0)
+  const localParts: Buffer[] = [];
+  const centralParts: Buffer[] = [];
+  let offset = 0;
+
+  for (const entry of allEntries) {
+    const nameBuf = Buffer.from(entry.name, "utf8");
+    const dataBuf = entry.data;
+    const entryCrc = crc32(dataBuf) >>> 0;
+
+    const localHeader = Buffer.alloc(30 + nameBuf.byteLength);
+    localHeader.writeUInt32LE(0x04034b50, 0);
+    localHeader.writeUInt16LE(20, 4);
+    localHeader.writeUInt16LE(0, 6);
+    localHeader.writeUInt16LE(0, 8); // STORE (0)
+    localHeader.writeUInt16LE(0, 10);
+    localHeader.writeUInt16LE(0, 12);
+    localHeader.writeUInt32LE(entryCrc, 14);
+    localHeader.writeUInt32LE(dataBuf.byteLength, 18);
+    localHeader.writeUInt32LE(dataBuf.byteLength, 22);
+    localHeader.writeUInt16LE(nameBuf.byteLength, 26);
+    localHeader.writeUInt16LE(0, 28);
+    nameBuf.copy(localHeader, 30);
+
+    localParts.push(localHeader, dataBuf);
+
+    const centralHeader = Buffer.alloc(46 + nameBuf.byteLength);
+    centralHeader.writeUInt32LE(0x02014b50, 0);
+    centralHeader.writeUInt16LE(20, 4);
+    centralHeader.writeUInt16LE(20, 6);
+    centralHeader.writeUInt16LE(0, 8);
+    centralHeader.writeUInt16LE(0, 10); // STORE (0)
+    centralHeader.writeUInt16LE(0, 12);
+    centralHeader.writeUInt16LE(0, 14);
+    centralHeader.writeUInt32LE(entryCrc, 16);
+    centralHeader.writeUInt32LE(dataBuf.byteLength, 20);
+    centralHeader.writeUInt32LE(dataBuf.byteLength, 24);
+    centralHeader.writeUInt16LE(nameBuf.byteLength, 28);
+    centralHeader.writeUInt16LE(0, 30);
+    centralHeader.writeUInt16LE(0, 32);
+    centralHeader.writeUInt16LE(0, 34);
+    centralHeader.writeUInt16LE(0, 36);
+    centralHeader.writeUInt32LE(0, 38);
+    centralHeader.writeUInt32LE(offset, 42);
+    nameBuf.copy(centralHeader, 46);
+
+    centralParts.push(centralHeader);
+    offset += localHeader.byteLength + dataBuf.byteLength;
+  }
+
+  const centralSize = centralParts.reduce((s, b) => s + b.byteLength, 0);
+  const eocd = Buffer.alloc(22);
+  eocd.writeUInt32LE(0x06054b50, 0);
+  eocd.writeUInt16LE(0, 4);
+  eocd.writeUInt16LE(0, 6);
+  eocd.writeUInt16LE(allEntries.length, 8);
+  eocd.writeUInt16LE(allEntries.length, 10);
+  eocd.writeUInt32LE(centralSize, 12);
+  eocd.writeUInt32LE(offset, 16);
+  eocd.writeUInt16LE(0, 20);
+
+  const zipBuffer = Buffer.concat([...localParts, ...centralParts, eocd]);
+  return {
+    zipBuffer,
+    archiveSha256: sha256Hex(zipBuffer),
+    manifest
+  };
+}
+
+/**
+ * Parses and strictly verifies a canonical ZIP STORE archive (`manifest.json` + `snapshot.part*`),
+ * checking every entry's CRC32, SHA-256, path safety, and payload limits.
+ */
+export function parseAndVerifyCanonicalStoreZip(zipBuffer: Buffer): {
+  manifest: CanonicalSnapshotManifest;
+  payload: SnapshotPayloadData;
+  archiveSha256: string;
+} {
+  if (zipBuffer.byteLength === 0 || zipBuffer.byteLength > MAX_SNAPSHOT_TOTAL_BYTES + 1024 * 1024) {
+    throw new Error("INVALID_ZIP_ARCHIVE_SIZE");
+  }
+
+  // Locate EOCD
+  let eocdOffset = -1;
+  for (let i = zipBuffer.byteLength - 22; i >= Math.max(0, zipBuffer.byteLength - 65557); i--) {
+    if (zipBuffer.readUInt32LE(i) === 0x06054b50) {
+      eocdOffset = i;
+      break;
+    }
+  }
+  if (eocdOffset === -1) {
+    throw new Error("CORRUPT_ZIP_MISSING_EOCD");
+  }
+
+  const totalEntries = zipBuffer.readUInt16LE(eocdOffset + 10);
+  const cdOffset = zipBuffer.readUInt32LE(eocdOffset + 16);
+  if (totalEntries === 0 || totalEntries > 64) {
+    throw new Error("INVALID_ZIP_ENTRY_COUNT");
+  }
+
+  const entries = new Map<string, { data: Buffer; crc32Hex: string }>();
+  let cursor = cdOffset;
+
+  for (let i = 0; i < totalEntries; i++) {
+    if (zipBuffer.readUInt32LE(cursor) !== 0x02014b50) {
+      throw new Error("CORRUPT_CENTRAL_DIRECTORY");
+    }
+    const method = zipBuffer.readUInt16LE(cursor + 10);
+    if (method !== 0) {
+      throw new Error("UNSUPPORTED_ZIP_COMPRESSION_METHOD_STORE_REQUIRED");
+    }
+    const expectedCrc = zipBuffer.readUInt32LE(cursor + 16) >>> 0;
+    const compSize = zipBuffer.readUInt32LE(cursor + 20);
+    const uncompSize = zipBuffer.readUInt32LE(cursor + 24);
+    const nameLen = zipBuffer.readUInt16LE(cursor + 28);
+    const extraLen = zipBuffer.readUInt16LE(cursor + 30);
+    const commentLen = zipBuffer.readUInt16LE(cursor + 32);
+    const localHeaderOffset = zipBuffer.readUInt32LE(cursor + 42);
+
+    const name = zipBuffer.subarray(cursor + 46, cursor + 46 + nameLen).toString("utf8");
+    if (name.includes("..") || name.startsWith("/") || name.includes("\\")) {
+      throw new Error("ZIP_PATH_TRAVERSAL_REJECTED");
+    }
+    if (compSize !== uncompSize || uncompSize > MAX_SNAPSHOT_PART_BYTES + 65536) {
+      throw new Error("ZIP_PART_SIZE_VIOLATION");
+    }
+
+    if (zipBuffer.readUInt32LE(localHeaderOffset) !== 0x04034b50) {
+      throw new Error("CORRUPT_LOCAL_FILE_HEADER");
+    }
+    const localNameLen = zipBuffer.readUInt16LE(localHeaderOffset + 26);
+    const localExtraLen = zipBuffer.readUInt16LE(localHeaderOffset + 28);
+    const dataStart = localHeaderOffset + 30 + localNameLen + localExtraLen;
+    const dataBuf = zipBuffer.subarray(dataStart, dataStart + uncompSize);
+
+    const actualCrc = crc32(dataBuf) >>> 0;
+    if (actualCrc !== expectedCrc) {
+      throw new Error(`ZIP_CRC32_MISMATCH:${name}`);
+    }
+
+    entries.set(name, {
+      data: dataBuf,
+      crc32Hex: actualCrc.toString(16).padStart(8, "0")
+    });
+
+    cursor += 46 + nameLen + extraLen + commentLen;
+  }
+
+  const manifestEntry = entries.get("manifest.json");
+  if (!manifestEntry) {
+    throw new Error("MISSING_SNAPSHOT_MANIFEST");
+  }
+
+  const manifest = JSON.parse(manifestEntry.data.toString("utf8")) as CanonicalSnapshotManifest;
+  if (manifest.schemaVersion !== "kosmora-drive-snapshot-v1") {
+    throw new Error("UNSUPPORTED_SNAPSHOT_SCHEMA");
+  }
+
+  const assembledParts: Buffer[] = [];
+  for (const partMeta of manifest.parts) {
+    const partEntry = entries.get(partMeta.name);
+    if (!partEntry) {
+      throw new Error(`MISSING_SNAPSHOT_PART:${partMeta.name}`);
+    }
+    if (partEntry.data.byteLength !== partMeta.sizeBytes) {
+      throw new Error(`PART_SIZE_MISMATCH:${partMeta.name}`);
+    }
+    if (partEntry.crc32Hex !== partMeta.crc32Hex) {
+      throw new Error(`PART_CRC32_MISMATCH:${partMeta.name}`);
+    }
+    if (sha256Hex(partEntry.data) !== partMeta.sha256) {
+      throw new Error(`PART_SHA256_MISMATCH:${partMeta.name}`);
+    }
+    assembledParts.push(partEntry.data);
+  }
+
+  const fullPayloadBuf = Buffer.concat(assembledParts);
+  if (
+    fullPayloadBuf.byteLength !== manifest.totalPayloadBytes ||
+    sha256Hex(fullPayloadBuf) !== manifest.payloadSha256
+  ) {
+    throw new Error("SNAPSHOT_PAYLOAD_SHA256_MISMATCH");
+  }
+
+  const payload = JSON.parse(fullPayloadBuf.toString("utf8")) as SnapshotPayloadData;
+  if (payload.ownerId !== manifest.ownerId) {
+    throw new Error("SNAPSHOT_OWNER_MISMATCH");
+  }
+  if (
+    payload.chats.length > MAX_SNAPSHOT_CHATS ||
+    payload.messages.length > MAX_SNAPSHOT_MESSAGES ||
+    (payload.workFiles?.length ?? 0) > MAX_SNAPSHOT_WORK_FILES
+  ) {
+    throw new Error("SNAPSHOT_ENTITY_BOUNDS_EXCEEDED");
+  }
+
+  return {
+    manifest,
+    payload,
+    archiveSha256: sha256Hex(zipBuffer)
+  };
+}
+
+/**
+ * Handles the two remaining recovery items listed in `KOSMORA_DRIVE_BACKUP_RESTORE_2026-11-02_RU.md` (PR #425):
+ * 1. Rebuilding the local SQLite backup catalog when the server journal is lost (`discoverAndRebuildDriveJournal`).
+ * 2. Safe import and atomic new-ID restoration of external / Google Picker ZIP archives (`importExternalKosmoraZipSnapshot`).
+ */
+export class GoogleDriveJournalRecoveryAndZipImporter {
+  constructor(private readonly sqlite: DatabaseSync) {
+    this.ensureSchema();
+  }
+
+  ensureSchema(): void {
+    this.sqlite.exec(`
+      CREATE TABLE IF NOT EXISTS kosmora_drive_recovered_catalog (
+        snapshot_id TEXT PRIMARY KEY NOT NULL,
+        drive_file_id TEXT NOT NULL,
+        owner_id TEXT NOT NULL,
+        chat_count INTEGER NOT NULL,
+        message_count INTEGER NOT NULL,
+        work_file_count INTEGER NOT NULL,
+        payload_sha256 TEXT NOT NULL,
+        archive_sha256 TEXT NOT NULL,
+        status TEXT NOT NULL CHECK(status IN ('verified', 'corrupt')),
+        created_at TEXT NOT NULL,
+        recovered_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS general_chats (
+        id TEXT PRIMARY KEY NOT NULL,
+        owner_id TEXT NOT NULL,
+        title TEXT NOT NULL,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS general_chat_messages (
+        id TEXT PRIMARY KEY NOT NULL,
+        chat_id TEXT NOT NULL,
+        owner_id TEXT NOT NULL,
+        role TEXT NOT NULL,
+        content_type TEXT NOT NULL,
+        content TEXT NOT NULL,
+        status TEXT NOT NULL,
+        client_message_id TEXT,
+        run_id TEXT,
+        error_code TEXT,
+        created_at TEXT NOT NULL,
+        updated_at TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS work_artifact_versions (
+        id TEXT PRIMARY KEY NOT NULL,
+        project_id TEXT NOT NULL,
+        work_id TEXT NOT NULL,
+        name TEXT NOT NULL,
+        version INTEGER NOT NULL,
+        content TEXT NOT NULL,
+        sha256 TEXT NOT NULL,
+        bytes INTEGER NOT NULL,
+        published INTEGER NOT NULL DEFAULT 1,
+        created_at TEXT NOT NULL
+      );
+    `);
+  }
+
+  /**
+   * Scans files from a Drive folder after local journal loss, verifies each archive's
+   * canonical ZIP STORE structure + CRC32 + SHA-256, and rebuilds the owner's local catalog.
+   */
+  async discoverAndRebuildDriveJournal(
+    ownerId: string,
+    remoteFiles: RemoteDriveFileItem[]
+  ): Promise<{ rebuilt: RebuiltJournalEntry[]; skippedCorruptOrForeign: string[] }> {
+    const rebuilt: RebuiltJournalEntry[] = [];
+    const skippedCorruptOrForeign: string[] = [];
+    const now = new Date().toISOString();
+
+    for (const item of remoteFiles) {
+      try {
+        const zipBytes = await item.downloadZipBytes();
+        const verified = parseAndVerifyCanonicalStoreZip(zipBytes);
+        if (verified.manifest.ownerId !== ownerId) {
+          skippedCorruptOrForeign.push(item.driveFileId);
+          continue;
+        }
+
+        const entry: RebuiltJournalEntry = {
+          snapshotId: verified.manifest.snapshotId,
+          driveFileId: item.driveFileId,
+          ownerId,
+          chatCount: verified.manifest.chatCount,
+          messageCount: verified.manifest.messageCount,
+          workFileCount: verified.manifest.workFileCount,
+          payloadSha256: verified.manifest.payloadSha256,
+          archiveSha256: verified.archiveSha256,
+          status: "verified",
+          createdAt: verified.manifest.createdAt
+        };
+
+        this.sqlite
+          .prepare(
+            `INSERT INTO kosmora_drive_recovered_catalog (
+              snapshot_id, drive_file_id, owner_id, chat_count, message_count,
+              work_file_count, payload_sha256, archive_sha256, status, created_at, recovered_at
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'verified', ?, ?)
+            ON CONFLICT(snapshot_id) DO UPDATE SET
+              drive_file_id = excluded.drive_file_id,
+              payload_sha256 = excluded.payload_sha256,
+              archive_sha256 = excluded.archive_sha256,
+              status = 'verified',
+              recovered_at = excluded.recovered_at`
+          )
+          .run(
+            entry.snapshotId,
+            entry.driveFileId,
+            entry.ownerId,
+            entry.chatCount,
+            entry.messageCount,
+            entry.workFileCount,
+            entry.payloadSha256,
+            entry.archiveSha256,
+            entry.createdAt,
+            now
+          );
+
+        rebuilt.push(entry);
+      } catch {
+        skippedCorruptOrForeign.push(item.driveFileId);
+      }
+    }
+
+    return { rebuilt, skippedCorruptOrForeign };
+  }
+
+  /**
+   * Imports an external / Picker-selected Kosmora ZIP snapshot, verifies all parts,
+   * and atomically restores chats, messages, and published Work files into brand-new IDs
+   * while quiescing any interrupted/streaming messages so LLM runs never auto-restart.
+   */
+  importExternalKosmoraZipSnapshot(
+    ownerId: string,
+    zipBuffer: Buffer,
+    options?: { allowCrossAccountImportWithExplicitConsent?: boolean }
+  ): ImportedZipRestoreResult {
+    const { manifest, payload } = parseAndVerifyCanonicalStoreZip(zipBuffer);
+
+    if (
+      manifest.ownerId !== ownerId &&
+      !options?.allowCrossAccountImportWithExplicitConsent
+    ) {
+      throw new Error("FOREIGN_ARCHIVE_OWNER_CONSENT_REQUIRED");
+    }
+
+    const restoredChatIds: Record<string, string> = {};
+    let restoredChatsCount = 0;
+    let restoredMessagesCount = 0;
+    let restoredWorkFilesCount = 0;
+    const restoredMemoriesCount = 0;
+    let interruptedRunsQuiesced = 0;
+    const now = new Date().toISOString();
+
+    this.sqlite.exec("BEGIN IMMEDIATE");
+    try {
+      const insertChat = this.sqlite.prepare(
+        `INSERT INTO general_chats (id, owner_id, title, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?)`
+      );
+
+      for (const c of payload.chats) {
+        const newChatId = `chat-imp-${randomUUID()}`;
+        restoredChatIds[c.id] = newChatId;
+        insertChat.run(
+          newChatId,
+          ownerId,
+          `${c.title} (импорт ${manifest.snapshotId.slice(0, 8)})`,
+          c.created_at || now,
+          now
+        );
+        restoredChatsCount++;
+      }
+
+      const insertMsg = this.sqlite.prepare(
+        `INSERT INTO general_chat_messages (
+          id, chat_id, owner_id, role, content_type, content, status,
+          client_message_id, run_id, error_code, created_at, updated_at
+        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NULL, NULL, ?, ?)`
+      );
+
+      for (const m of payload.messages) {
+        const mappedChatId = restoredChatIds[m.chat_id];
+        if (!mappedChatId) continue;
+
+        // Quiesce any pending/streaming status into 'cancelled' so LLM runs never auto-restart
+        let safeStatus = m.status ?? "completed";
+        if (safeStatus === "pending" || safeStatus === "streaming") {
+          safeStatus = "cancelled";
+          interruptedRunsQuiesced++;
+        }
+
+        insertMsg.run(
+          `msg-imp-${randomUUID()}`,
+          mappedChatId,
+          ownerId,
+          m.role,
+          m.content_type ?? "text",
+          m.content,
+          safeStatus,
+          `zip-import:${manifest.snapshotId}:${m.id}`,
+          m.created_at || now,
+          now
+        );
+        restoredMessagesCount++;
+      }
+
+      if (Array.isArray(payload.workFiles) && payload.workFiles.length > 0) {
+        const insertWorkFile = this.sqlite.prepare(
+          `INSERT INTO work_artifact_versions (
+            id, project_id, work_id, name, version, content, sha256, bytes, published, created_at
+          ) VALUES (?, ?, ?, ?, 1, ?, ?, ?, 1, ?)`
+        );
+
+        for (const wf of payload.workFiles) {
+          const actualWfSha = sha256Hex(Buffer.from(wf.content, "utf8"));
+          if (actualWfSha !== wf.sha256) {
+            throw new Error(`WORK_FILE_SHA256_MISMATCH:${wf.name}`);
+          }
+          insertWorkFile.run(
+            `wf-imp-${randomUUID()}`,
+            `proj-imp-${wf.project_id}`,
+            `work-imp-${wf.work_id}`,
+            wf.name,
+            wf.content,
+            wf.sha256,
+            wf.bytes,
+            wf.created_at || now
+          );
+          restoredWorkFilesCount++;
+        }
+      }
+
+      this.sqlite.exec("COMMIT");
+    } catch (err) {
+      try {
+        this.sqlite.exec("ROLLBACK");
+      } catch {
+        // ignore
+      }
+      throw err;
+    }
+
+    return {
+      snapshotId: manifest.snapshotId,
+      ownerId,
+      restoredChatIds,
+      restoredChatsCount,
+      restoredMessagesCount,
+      restoredWorkFilesCount,
+      restoredMemoriesCount,
+      interruptedRunsQuiesced,
+      payloadSha256: manifest.payloadSha256
+    };
+  }
+}
diff --git a/apps/api/src/cloud-storage/google-drive-privacy.ts b/apps/api/src/cloud-storage/google-drive-privacy.ts
new file mode 100644
index 0000000..51c131b
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-privacy.ts
@@ -0,0 +1,59 @@
+/* eslint-disable @typescript-eslint/require-await -- PrivacyAdapter requires Promise returns while SQLite operations run synchronously. */
+import type { DatabaseSync } from "node:sqlite";
+import type { PrivacyAdapter, PrivacySection } from "../account-settings/privacy/coordinator.js";
+
+export function googleDrivePrivacyAdapter(
+  db: DatabaseSync,
+  worker?: { quiesce(ownerId: string): Promise<void>; resume(ownerId: string): void }
+): PrivacyAdapter {
+  return {
+    id: "cloud-storage",
+    async quiesce(owner: string, epoch: number) {
+      await worker?.quiesce(owner);
+      return { drained: true, fence_epoch: epoch };
+    },
+    async resume(owner: string) {
+      worker?.resume(owner);
+    },
+    async export(owner: string): Promise<PrivacySection> {
+      const connections = db
+        .prepare(
+          `SELECT owner_id, revision, connection_id, folder_id, folder_state, updated_at
+           FROM kosmora_drive_connections WHERE owner_id=?`
+        )
+        .all(owner) as Record<string, unknown>[];
+      const archives = db
+        .prepare(
+          `SELECT id, owner_id, connection_id, operation_id, file_id, folder_id,
+                  size_bytes, sha256, state, created_at, updated_at
+           FROM kosmora_drive_archives WHERE owner_id=? ORDER BY created_at DESC, id DESC`
+        )
+        .all(owner) as Record<string, unknown>[];
+      return {
+        records: {
+          connections,
+          archives
+        },
+        originals: [],
+        complete: true
+      };
+    },
+    async delete(owner: string, epoch: number) {
+      const fenced = db
+        .prepare(
+          "SELECT 1 FROM kosmora_owner_data_lifecycle WHERE owner_id=? AND epoch=? AND state='deleting'"
+        )
+        .get(owner, epoch);
+      if (!fenced) {
+        throw new Error("OWNER_DATA_FENCED");
+      }
+      const archCount = Number(
+        db.prepare("DELETE FROM kosmora_drive_archives WHERE owner_id=?").run(owner).changes
+      );
+      const connCount = Number(
+        db.prepare("DELETE FROM kosmora_drive_connections WHERE owner_id=?").run(owner).changes
+      );
+      return { deleted_records: archCount + connCount };
+    }
+  };
+}
diff --git a/apps/api/src/cloud-storage/google-drive-restore.ts b/apps/api/src/cloud-storage/google-drive-restore.ts
new file mode 100644
index 0000000..b6bcd98
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-restore.ts
@@ -0,0 +1,639 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import { DRIVE_ARCHIVE_MAX_BYTES } from "./google-drive.js";
+import {
+  DRIVE_BACKUP_SCHEMA_VERSION,
+  type DriveBackupManifest,
+  type DriveBackupOriginalManifest
+} from "./google-drive-archive-builder.js";
+
+const FORBIDDEN_RESTORE_KEYS = new Set([
+  "sessions",
+  "identity_sessions",
+  "step_up_proofs",
+  "credentials",
+  "owner_credentials",
+  "delete_challenges",
+  "connections",
+  "kosmora_drive_connections",
+  "kosmora_drive_archives",
+  "policies",
+  "point_overrides",
+  "autonomy_profiles",
+  "confirmations",
+  "work_runs",
+  "work_dag_runs",
+  "code_agent_runs",
+  "computer_tasks",
+  "permissions",
+  "commands"
+]);
+
+const crc32 = (bytes: Buffer): number => {
+  let crc = 0xffffffff;
+  for (const value of bytes) {
+    crc ^= value;
+    for (let i = 0; i < 8; i += 1) {
+      crc = (crc >>> 1) ^ (crc & 1 ? 0xedb88320 : 0);
+    }
+  }
+  return (crc ^ 0xffffffff) >>> 0;
+};
+
+export function readStoredZipEntries(zipBytes: Uint8Array): Map<string, Buffer> {
+  const buf = Buffer.from(zipBytes);
+  if (buf.byteLength < 22 || buf.byteLength > DRIVE_ARCHIVE_MAX_BYTES) {
+    throw new Error("DRIVE_RESTORE_INVALID_ZIP");
+  }
+  // Locate End of Central Directory (0x06054b50) at end of buffer
+  const eocdOffset = buf.byteLength - 22;
+  if (buf.readUInt32LE(eocdOffset) !== 0x06054b50) {
+    throw new Error("DRIVE_RESTORE_INVALID_ZIP");
+  }
+  const entryCount = buf.readUInt16LE(eocdOffset + 8);
+  const centralSize = buf.readUInt32LE(eocdOffset + 12);
+  const centralOffset = buf.readUInt32LE(eocdOffset + 16);
+  if (centralOffset + centralSize !== eocdOffset || entryCount > 4000) {
+    throw new Error("DRIVE_RESTORE_INVALID_ZIP");
+  }
+
+  const entries = new Map<string, Buffer>();
+  let ptr = centralOffset;
+
+  for (let i = 0; i < entryCount; i += 1) {
+    if (ptr + 46 > eocdOffset || buf.readUInt32LE(ptr) !== 0x02014b50) {
+      throw new Error("DRIVE_RESTORE_INVALID_ZIP");
+    }
+    const method = buf.readUInt16LE(ptr + 10);
+    if (method !== 0) {
+      throw new Error("DRIVE_RESTORE_UNSUPPORTED_COMPRESSION");
+    }
+    const expectedCrc = buf.readUInt32LE(ptr + 16);
+    const compressedSize = buf.readUInt32LE(ptr + 20);
+    const uncompressedSize = buf.readUInt32LE(ptr + 24);
+    const nameLen = buf.readUInt16LE(ptr + 28);
+    const extraLen = buf.readUInt16LE(ptr + 30);
+    const commentLen = buf.readUInt16LE(ptr + 32);
+    const localHeaderOffset = buf.readUInt32LE(ptr + 42);
+
+    if (
+      compressedSize !== uncompressedSize ||
+      nameLen === 0 ||
+      nameLen > 200 ||
+      ptr + 46 + nameLen + extraLen + commentLen > eocdOffset
+    ) {
+      throw new Error("DRIVE_RESTORE_INVALID_ZIP");
+    }
+
+    const entryPath = buf.subarray(ptr + 46, ptr + 46 + nameLen).toString("utf8");
+    if (
+      !/^[a-z0-9._/-]+$/i.test(entryPath) ||
+      entryPath.startsWith("/") ||
+      entryPath.split("/").some((s) => s === ".." || s === "") ||
+      entries.has(entryPath)
+    ) {
+      throw new Error("DRIVE_RESTORE_UNSAFE_PATH");
+    }
+
+    if (
+      localHeaderOffset + 30 + nameLen + uncompressedSize > centralOffset ||
+      buf.readUInt32LE(localHeaderOffset) !== 0x04034b50
+    ) {
+      throw new Error("DRIVE_RESTORE_INVALID_ZIP");
+    }
+    const localNameLen = buf.readUInt16LE(localHeaderOffset + 26);
+    const localExtraLen = buf.readUInt16LE(localHeaderOffset + 28);
+    const dataStart = localHeaderOffset + 30 + localNameLen + localExtraLen;
+    const dataEnd = dataStart + uncompressedSize;
+    if (dataEnd > centralOffset) {
+      throw new Error("DRIVE_RESTORE_INVALID_ZIP");
+    }
+
+    const content = Buffer.from(buf.subarray(dataStart, dataEnd));
+    if (crc32(content) !== expectedCrc) {
+      throw new Error("DRIVE_RESTORE_CRC_MISMATCH");
+    }
+
+    entries.set(entryPath, content);
+    ptr += 46 + nameLen + extraLen + commentLen;
+  }
+
+  return entries;
+}
+
+export interface ValidatedRestorePackage {
+  backupSetId: string;
+  ownerId: string;
+  generatedAt: string;
+  totalParts: number;
+  sections: Record<string, Record<string, Record<string, unknown>[]>>;
+  originals: {
+    manifest: DriveBackupOriginalManifest;
+    bytes: Buffer;
+  }[];
+  excludedCategories: string[];
+}
+
+export interface DriveRestorePreview {
+  valid: true;
+  schemaVersion: number;
+  backupSetId: string;
+  ownerId: string;
+  generatedAt: string;
+  totalParts: number;
+  counts: {
+    projects: number;
+    generalChats: number;
+    generalMessages: number;
+    projectMessages: number;
+    documents: number;
+    canvasArtifacts: number;
+    researchRuns: number;
+    originals: number;
+  };
+  excludedCategories: string[];
+}
+
+export interface DriveRestoreResult {
+  restored: true;
+  backupSetId: string;
+  ownerId: string;
+  restoredAt: string;
+  counts: DriveRestorePreview["counts"];
+  idMapping: {
+    projects: Record<string, string>;
+    generalChats: Record<string, string>;
+    documents: Record<string, string>;
+    canvasArtifacts: Record<string, string>;
+    researchRuns: Record<string, string>;
+  };
+  restoredOriginals: {
+    store: string;
+    oldId: string;
+    newId: string;
+    filename: string;
+    sizeBytes: number;
+    sha256: string;
+  }[];
+}
+
+export function validateAndUnpackRestoreParts(
+  expectedOwnerId: string,
+  partBuffers: readonly Uint8Array[]
+): ValidatedRestorePackage {
+  if (!Array.isArray(partBuffers) || partBuffers.length === 0) {
+    throw new Error("DRIVE_RESTORE_EMPTY_PARTS");
+  }
+
+  const parsedParts: {
+    manifest: DriveBackupManifest;
+    entries: Map<string, Buffer>;
+  }[] = [];
+
+  for (const rawPart of partBuffers) {
+    const entries = readStoredZipEntries(rawPart);
+    const manifestBuf = entries.get("manifest.json");
+    if (!manifestBuf) {
+      throw new Error("DRIVE_RESTORE_MISSING_MANIFEST");
+    }
+    let manifest: DriveBackupManifest;
+    try {
+      manifest = JSON.parse(manifestBuf.toString("utf8")) as DriveBackupManifest;
+    } catch {
+      throw new Error("DRIVE_RESTORE_INVALID_MANIFEST");
+    }
+    if (
+      manifest.schemaVersion !== DRIVE_BACKUP_SCHEMA_VERSION ||
+      typeof manifest.backupSetId !== "string" ||
+      !manifest.backupSetId ||
+      manifest.ownerId !== expectedOwnerId ||
+      !Number.isSafeInteger(manifest.partIndex) ||
+      !Number.isSafeInteger(manifest.totalParts) ||
+      manifest.partIndex < 1 ||
+      manifest.totalParts < 1 ||
+      manifest.partIndex > manifest.totalParts
+    ) {
+      throw new Error("DRIVE_RESTORE_SCHEMA_MISMATCH");
+    }
+    parsedParts.push({ manifest, entries });
+  }
+
+  parsedParts.sort((a, b) => a.manifest.partIndex - b.manifest.partIndex);
+  const first = parsedParts[0]!.manifest;
+  if (parsedParts.length !== first.totalParts) {
+    throw new Error("DRIVE_RESTORE_INCOMPLETE_MULTIPART_SET");
+  }
+
+  const mergedSections: Record<string, Record<string, Record<string, unknown>[]>> = {};
+
+  for (let i = 0; i < parsedParts.length; i += 1) {
+    const { manifest, entries } = parsedParts[i]!;
+    if (
+      manifest.partIndex !== i + 1 ||
+      manifest.totalParts !== first.totalParts ||
+      manifest.backupSetId !== first.backupSetId ||
+      manifest.ownerId !== expectedOwnerId
+    ) {
+      throw new Error("DRIVE_RESTORE_MULTIPART_MISMATCH");
+    }
+
+    for (const [entryPath, content] of entries.entries()) {
+      if (entryPath.startsWith("records/") && entryPath.endsWith(".json")) {
+        let parsedRecords: Record<string, Record<string, Record<string, unknown>[]>>;
+        try {
+          parsedRecords = JSON.parse(content.toString("utf8")) as Record<
+            string,
+            Record<string, Record<string, unknown>[]>
+          >;
+        } catch {
+          throw new Error("DRIVE_RESTORE_CORRUPT_RECORDS");
+        }
+        for (const [secName, cols] of Object.entries(parsedRecords)) {
+          if (FORBIDDEN_RESTORE_KEYS.has(secName)) {
+            throw new Error(`DRIVE_RESTORE_FORBIDDEN_SECTION:${secName}`);
+          }
+          if (!mergedSections[secName]) mergedSections[secName] = {};
+          for (const [colName, rows] of Object.entries(cols)) {
+            if (FORBIDDEN_RESTORE_KEYS.has(colName) || !Array.isArray(rows)) {
+              throw new Error(`DRIVE_RESTORE_FORBIDDEN_COLLECTION:${colName}`);
+            }
+            mergedSections[secName]![colName] = rows;
+          }
+        }
+      }
+    }
+  }
+
+  // Reassemble and verify all binary originals declared in the manifest
+  const verifiedOriginals: { manifest: DriveBackupOriginalManifest; bytes: Buffer }[] = [];
+  const declaredOriginals = first.originals ?? [];
+
+  for (const origMeta of declaredOriginals) {
+    if (!Array.isArray(origMeta.chunks) || origMeta.chunks.length === 0) {
+      throw new Error("DRIVE_RESTORE_MISSING_ORIGINAL_CHUNKS");
+    }
+    const sortedChunks = [...origMeta.chunks].sort((a, b) => a.chunkIndex - b.chunkIndex);
+    const chunkBuffers: Buffer[] = [];
+    let totalSize = 0;
+
+    for (let idx = 0; idx < sortedChunks.length; idx += 1) {
+      const ch = sortedChunks[idx]!;
+      if (ch.chunkIndex !== idx + 1 || ch.partIndex < 1 || ch.partIndex > parsedParts.length) {
+        throw new Error("DRIVE_RESTORE_MISSING_ORIGINAL_CHUNKS");
+      }
+      const partEntries = parsedParts[ch.partIndex - 1]!.entries;
+      const chunkBytes = partEntries.get(ch.entryPath);
+      if (!chunkBytes || chunkBytes.byteLength !== ch.sizeBytes) {
+        throw new Error("DRIVE_RESTORE_MISSING_ORIGINAL_CHUNKS");
+      }
+      const chunkSha = createHash("sha256").update(chunkBytes).digest("hex");
+      if (chunkSha !== ch.sha256.toLowerCase()) {
+        throw new Error("DRIVE_RESTORE_ORIGINAL_HASH_MISMATCH");
+      }
+      chunkBuffers.push(chunkBytes);
+      totalSize += chunkBytes.byteLength;
+    }
+
+    const fullOriginal = Buffer.concat(chunkBuffers, totalSize);
+    const fullSha = createHash("sha256").update(fullOriginal).digest("hex");
+    if (
+      fullOriginal.byteLength !== origMeta.sizeBytes ||
+      fullSha !== origMeta.sha256.toLowerCase()
+    ) {
+      throw new Error("DRIVE_RESTORE_ORIGINAL_HASH_MISMATCH");
+    }
+    verifiedOriginals.push({ manifest: origMeta, bytes: fullOriginal });
+  }
+
+  return {
+    backupSetId: first.backupSetId,
+    ownerId: first.ownerId,
+    generatedAt: first.generatedAt,
+    totalParts: first.totalParts,
+    sections: mergedSections,
+    originals: verifiedOriginals,
+    excludedCategories: first.excludedCategories ?? []
+  };
+}
+
+function summarizePackageCounts(pkg: ValidatedRestorePackage): DriveRestorePreview["counts"] {
+  const core = pkg.sections["account-core"] ?? {};
+  const docs = pkg.sections["documents"] ?? {};
+  const canvas = pkg.sections["canvas"] ?? {};
+  const research = pkg.sections["research"] ?? {};
+
+  return {
+    projects: (core.projects ?? []).length,
+    generalChats: (core.general_chats ?? []).length,
+    generalMessages: (core.general_chat_messages ?? []).length,
+    projectMessages: (core.project_messages ?? []).length,
+    documents: (docs.files ?? []).length,
+    canvasArtifacts: (canvas.artifacts ?? []).length,
+    researchRuns: (research.runs ?? []).length,
+    originals: pkg.originals.length
+  };
+}
+
+export function previewDriveRestore(
+  expectedOwnerId: string,
+  partBuffers: readonly Uint8Array[]
+): DriveRestorePreview {
+  const pkg = validateAndUnpackRestoreParts(expectedOwnerId, partBuffers);
+  return {
+    valid: true,
+    schemaVersion: DRIVE_BACKUP_SCHEMA_VERSION,
+    backupSetId: pkg.backupSetId,
+    ownerId: pkg.ownerId,
+    generatedAt: pkg.generatedAt,
+    totalParts: pkg.totalParts,
+    counts: summarizePackageCounts(pkg),
+    excludedCategories: pkg.excludedCategories
+  };
+}
+
+function tableExists(db: DatabaseSync, tableName: string): boolean {
+  const row = db
+    .prepare("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?")
+    .get(tableName);
+  return Boolean(row);
+}
+
+export function executeTransactionalDriveRestore(
+  db: DatabaseSync,
+  ownerId: string,
+  partBuffers: readonly Uint8Array[],
+  options: {
+    now?: () => string;
+    onRestoreBinary?: (item: {
+      store: string;
+      oldId: string;
+      newId: string;
+      projectId?: string;
+      filename: string;
+      contentType: string;
+      bytes: Buffer;
+    }) => void;
+  } = {}
+): DriveRestoreResult {
+  const pkg = validateAndUnpackRestoreParts(ownerId, partBuffers);
+  const nowIso = options.now ? options.now() : new Date().toISOString();
+
+  const lifecycle = db
+    .prepare("SELECT state FROM kosmora_owner_data_lifecycle WHERE owner_id=?")
+    .get(ownerId) as { state: string } | undefined;
+  if (lifecycle && lifecycle.state !== "active") {
+    throw new Error("OWNER_DATA_FENCED");
+  }
+
+  const projectMap: Record<string, string> = {};
+  const generalChatMap: Record<string, string> = {};
+  const documentMap: Record<string, string> = {};
+  const canvasMap: Record<string, string> = {};
+  const researchMap: Record<string, string> = {};
+
+  const counts: DriveRestorePreview["counts"] = {
+    projects: 0,
+    generalChats: 0,
+    generalMessages: 0,
+    projectMessages: 0,
+    documents: 0,
+    canvasArtifacts: 0,
+    researchRuns: 0,
+    originals: 0
+  };
+
+  const restoredOriginals: DriveRestoreResult["restoredOriginals"] = [];
+
+  db.exec("BEGIN IMMEDIATE");
+  try {
+    const core = pkg.sections["account-core"] ?? {};
+
+    // 1. Restore projects into new IDs without touching existing projects
+    if (Array.isArray(core.projects) && tableExists(db, "projects")) {
+      const insertProject = db.prepare(
+        `INSERT INTO projects (id, owner_id, name, description, status, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`
+      );
+      for (const proj of core.projects) {
+        const oldId = String(proj.id ?? "");
+        if (!oldId) throw new Error("DRIVE_RESTORE_INVALID_ENTITY_ID");
+        const newId = randomUUID();
+        projectMap[oldId] = newId;
+        const baseName = String(proj.name ?? "Проект");
+        const restoredName = baseName.endsWith(" (из архива)")
+          ? baseName
+          : `${baseName} (из архива)`;
+        insertProject.run(
+          newId,
+          ownerId,
+          restoredName,
+          proj.description ?? null,
+          "active",
+          String(proj.created_at ?? nowIso),
+          nowIso
+        );
+        counts.projects += 1;
+      }
+    }
+
+    // 2. Restore general_chats into new IDs
+    if (Array.isArray(core.general_chats) && tableExists(db, "general_chats")) {
+      const insertChat = db.prepare(
+        `INSERT INTO general_chats (id, owner_id, title, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?)`
+      );
+      for (const chat of core.general_chats) {
+        const oldId = String(chat.id ?? "");
+        if (!oldId) throw new Error("DRIVE_RESTORE_INVALID_ENTITY_ID");
+        const newId = randomUUID();
+        generalChatMap[oldId] = newId;
+        const baseTitle = String(chat.title ?? "Чат");
+        const restoredTitle = baseTitle.endsWith(" (из архива)")
+          ? baseTitle
+          : `${baseTitle} (из архива)`;
+        insertChat.run(newId, ownerId, restoredTitle, String(chat.created_at ?? nowIso), nowIso);
+        counts.generalChats += 1;
+      }
+    }
+
+    // 3. Restore general_chat_messages mapped to the new chat IDs
+    if (Array.isArray(core.general_chat_messages) && tableExists(db, "general_chat_messages")) {
+      const insertMsg = db.prepare(
+        `INSERT INTO general_chat_messages (id, chat_id, owner_id, role, content, created_at)
+         VALUES (?, ?, ?, ?, ?, ?)`
+      );
+      for (const msg of core.general_chat_messages) {
+        const oldChatId = String(msg.chat_id ?? "");
+        const newChatId = generalChatMap[oldChatId];
+        if (!newChatId) {
+          throw new Error("DRIVE_RESTORE_ORPHAN_CHAT_MESSAGE");
+        }
+        insertMsg.run(
+          randomUUID(),
+          newChatId,
+          ownerId,
+          String(msg.role ?? "user"),
+          String(msg.content ?? ""),
+          String(msg.created_at ?? nowIso)
+        );
+        counts.generalMessages += 1;
+      }
+    }
+
+    // 4. Restore project_messages mapped to the new project IDs
+    if (Array.isArray(core.project_messages) && tableExists(db, "project_messages")) {
+      const insertProjMsg = db.prepare(
+        `INSERT INTO project_messages (id, project_id, role, content, created_at)
+         VALUES (?, ?, ?, ?, ?)`
+      );
+      for (const msg of core.project_messages) {
+        const oldProjId = String(msg.project_id ?? "");
+        const newProjId = projectMap[oldProjId];
+        if (!newProjId) {
+          throw new Error("DRIVE_RESTORE_ORPHAN_PROJECT_MESSAGE");
+        }
+        insertProjMsg.run(
+          randomUUID(),
+          newProjId,
+          String(msg.role ?? "user"),
+          String(msg.content ?? ""),
+          String(msg.created_at ?? nowIso)
+        );
+        counts.projectMessages += 1;
+      }
+    }
+
+    // 5. Restore documents metadata if table exists
+    const docs = pkg.sections["documents"] ?? {};
+    if (Array.isArray(docs.files) && tableExists(db, "document_library_files")) {
+      const insertDoc = db.prepare(
+        `INSERT INTO document_library_files
+         (id, project_id, owner_id, name, media_type, bytes, sha256, extracted_text, created_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
+      );
+      for (const doc of docs.files) {
+        const oldId = String(doc.id ?? "");
+        if (!oldId) throw new Error("DRIVE_RESTORE_INVALID_ENTITY_ID");
+        const oldProjId = String(doc.project_id ?? "");
+        const newProjId = projectMap[oldProjId] ?? oldProjId;
+        const newId = randomUUID();
+        documentMap[oldId] = newId;
+        insertDoc.run(
+          newId,
+          newProjId,
+          ownerId,
+          String(doc.name ?? "document.txt"),
+          String(doc.media_type ?? "text/plain"),
+          Number(doc.bytes ?? 0),
+          String(doc.sha256 ?? ""),
+          String(doc.extracted_text ?? ""),
+          String(doc.created_at ?? nowIso)
+        );
+        counts.documents += 1;
+      }
+    }
+
+    // 6. Restore canvas artifacts into new IDs if table exists
+    const canvas = pkg.sections["canvas"] ?? {};
+    if (Array.isArray(canvas.artifacts) && tableExists(db, "canvas_artifacts")) {
+      const insertCanvas = db.prepare(
+        `INSERT INTO canvas_artifacts
+         (id, owner_id, project_id, title, kind, content, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+      );
+      for (const art of canvas.artifacts) {
+        const oldId = String(art.id ?? "");
+        if (!oldId) throw new Error("DRIVE_RESTORE_INVALID_ENTITY_ID");
+        const newId = randomUUID();
+        canvasMap[oldId] = newId;
+        const oldProjId = art.project_id ? String(art.project_id) : null;
+        const mappedProjId = oldProjId ? (projectMap[oldProjId] ?? null) : null;
+        insertCanvas.run(
+          newId,
+          ownerId,
+          mappedProjId,
+          String(art.title ?? "Холст (из архива)"),
+          String(art.kind ?? "markdown"),
+          String(art.content ?? ""),
+          String(art.created_at ?? nowIso),
+          nowIso
+        );
+        counts.canvasArtifacts += 1;
+      }
+    }
+
+    // 7. Restore research runs into new IDs if table exists
+    const research = pkg.sections["research"] ?? {};
+    if (Array.isArray(research.runs) && tableExists(db, "research_runs")) {
+      const insertResearch = db.prepare(
+        `INSERT INTO research_runs
+         (id, owner_id, project_id, query, status, report_markdown, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+      );
+      for (const run of research.runs) {
+        const oldId = String(run.id ?? "");
+        if (!oldId) throw new Error("DRIVE_RESTORE_INVALID_ENTITY_ID");
+        const newId = randomUUID();
+        researchMap[oldId] = newId;
+        const oldProjId = run.project_id ? String(run.project_id) : null;
+        const mappedProjId = oldProjId ? (projectMap[oldProjId] ?? null) : null;
+        insertResearch.run(
+          newId,
+          ownerId,
+          mappedProjId,
+          String(run.query ?? ""),
+          "completed",
+          run.report_markdown ? String(run.report_markdown) : null,
+          String(run.created_at ?? nowIso),
+          nowIso
+        );
+        counts.researchRuns += 1;
+      }
+    }
+
+    // 8. Materialize verified binary originals with fresh IDs
+    for (const orig of pkg.originals) {
+      const newId = documentMap[orig.manifest.id] ?? randomUUID();
+      if (options.onRestoreBinary) {
+        options.onRestoreBinary({
+          store: orig.manifest.store,
+          oldId: orig.manifest.id,
+          newId,
+          filename: orig.manifest.filename,
+          contentType: orig.manifest.contentType,
+          bytes: orig.bytes
+        });
+      }
+      restoredOriginals.push({
+        store: orig.manifest.store,
+        oldId: orig.manifest.id,
+        newId,
+        filename: orig.manifest.filename,
+        sizeBytes: orig.manifest.sizeBytes,
+        sha256: orig.manifest.sha256
+      });
+      counts.originals += 1;
+    }
+
+    db.exec("COMMIT");
+  } catch (error) {
+    db.exec("ROLLBACK");
+    throw error;
+  }
+
+  return {
+    restored: true,
+    backupSetId: pkg.backupSetId,
+    ownerId,
+    restoredAt: nowIso,
+    counts,
+    idMapping: {
+      projects: projectMap,
+      generalChats: generalChatMap,
+      documents: documentMap,
+      canvasArtifacts: canvasMap,
+      researchRuns: researchMap
+    },
+    restoredOriginals
+  };
+}
diff --git a/apps/api/src/cloud-storage/google-drive-routes.ts b/apps/api/src/cloud-storage/google-drive-routes.ts
new file mode 100644
index 0000000..450a195
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-routes.ts
@@ -0,0 +1,334 @@
+import type { FastifyInstance, FastifyRequest } from "fastify";
+import type { IdentityContext } from "@cosmora/contracts";
+import type { GoogleDriveController } from "./google-drive-controller.js";
+
+const callbackBodySchema = {
+  type: "object",
+  required: ["state", "code"],
+  additionalProperties: false,
+  properties: {
+    state: { type: "string", minLength: 8, maxLength: 256 },
+    code: { type: "string", minLength: 4, maxLength: 2048 }
+  }
+} as const;
+
+const callbackQuerySchema = {
+  type: "object",
+  additionalProperties: false,
+  properties: {
+    state: { type: "string", minLength: 8, maxLength: 256 },
+    code: { type: "string", minLength: 4, maxLength: 2048 },
+    error: { type: "string", maxLength: 128 }
+  }
+} as const;
+
+const createBackupBodySchema = {
+  type: "object",
+  additionalProperties: false,
+  properties: {
+    backup_set_id: { type: "string", minLength: 6, maxLength: 64 }
+  }
+} as const;
+
+const archiveParamsSchema = {
+  type: "object",
+  required: ["archiveId"],
+  additionalProperties: false,
+  properties: {
+    archiveId: { type: "string", minLength: 4, maxLength: 128 }
+  }
+} as const;
+
+const restoreBodySchema = {
+  type: "object",
+  required: ["backup_set_id"],
+  additionalProperties: false,
+  properties: {
+    backup_set_id: { type: "string", minLength: 6, maxLength: 64 }
+  }
+} as const;
+
+const noCache = (reply: { header(name: string, value: string): unknown }) => {
+  reply.header("Cache-Control", "private, no-store");
+  reply.header("X-Content-Type-Options", "nosniff");
+  reply.header("Referrer-Policy", "no-referrer");
+};
+
+function requireOwnerSession(
+  request: FastifyRequest,
+  identityFor: (req: FastifyRequest) => IdentityContext
+): { ownerId: string; sessionId: string } {
+  const identity = identityFor(request);
+  if (!identity || identity.actor.kind !== "owner" || !identity.owner_id) {
+    throw new Error("OWNER_AUTH_REQUIRED");
+  }
+  const rec = identity as unknown as Record<string, unknown>;
+  const sessionId =
+    typeof rec.session_id === "string" && rec.session_id.length > 0
+      ? rec.session_id
+      : `owner_session:${identity.owner_id}`;
+  return {
+    ownerId: identity.owner_id,
+    sessionId
+  };
+}
+
+function statusForDriveError(code: string): number {
+  if (
+    code === "OWNER_AUTH_REQUIRED" ||
+    code === "DRIVE_AUTH_CONTEXT_REQUIRED" ||
+    code === "DRIVE_OAUTH_SESSION_MISMATCH"
+  ) {
+    return 403;
+  }
+  if (
+    code === "DRIVE_OAUTH_STATE_INVALID" ||
+    code === "DRIVE_OAUTH_CODE_REQUIRED" ||
+    code === "DRIVE_OAUTH_CODE_REPLAYED" ||
+    code === "INVALID_DRIVE_OFFSET" ||
+    code === "INVALID_BACKUP_SET_ID" ||
+    code.startsWith("DRIVE_RESTORE_")
+  ) {
+    return 400;
+  }
+  if (code === "DRIVE_ARCHIVE_NOT_FOUND") {
+    return 404;
+  }
+  if (
+    code === "DRIVE_ALREADY_CONNECTED" ||
+    code === "DRIVE_NOT_CONNECTED" ||
+    code === "DRIVE_DISCONNECTED" ||
+    code === "DRIVE_CONNECT_EXPIRED" ||
+    code === "DRIVE_FOLDER_BUSY" ||
+    code === "DRIVE_ARCHIVE_BUSY" ||
+    code === "DRIVE_ARCHIVE_EXISTS" ||
+    code === "DRIVE_BACKUP_SET_INCOMPLETE" ||
+    code === "DRIVE_RETRY_BYTES_REQUIRED" ||
+    code === "OWNER_DATA_FENCED"
+  ) {
+    return 409;
+  }
+  return 503;
+}
+
+export function registerGoogleDriveRoutes(
+  app: FastifyInstance,
+  controller: GoogleDriveController,
+  identityFor: (request: FastifyRequest) => IdentityContext
+): void {
+  app.get("/api/v1/personal-settings/google-drive/status", async (request, reply) => {
+    noCache(reply);
+    try {
+      const { ownerId } = requireOwnerSession(request, identityFor);
+      const query = (request.query ?? {}) as { offset?: string };
+      const offset = query.offset !== undefined ? Number(query.offset) : 0;
+      return controller.overview(ownerId, offset);
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "DRIVE_STATUS_FAILED";
+      return reply.status(statusForDriveError(code)).send({
+        error: { code, message: "Не удалось получить статус Google Drive." }
+      });
+    }
+  });
+
+  app.post("/api/v1/personal-settings/google-drive/connect/start", async (request, reply) => {
+    noCache(reply);
+    try {
+      const session = requireOwnerSession(request, identityFor);
+      const { authorizationUrl, state } = controller.startOAuthConnect(session);
+      return {
+        authorization_url: authorizationUrl,
+        state
+      };
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "DRIVE_CONNECT_START_FAILED";
+      return reply.status(statusForDriveError(code)).send({
+        error: { code, message: "Не удалось начать подключение Google Drive." }
+      });
+    }
+  });
+
+  // Never log query parameters containing authorization code or state on callback
+  app.get(
+    "/api/v1/personal-settings/google-drive/connect/callback",
+    {
+      config: { logLevel: "silent" },
+      schema: { querystring: callbackQuerySchema }
+    },
+    async (request, reply) => {
+      noCache(reply);
+      try {
+        const session = requireOwnerSession(request, identityFor);
+        const query = request.query as { state?: string; code?: string; error?: string };
+        if (query.error) {
+          return reply.status(400).send({
+            error: {
+              code: "DRIVE_OAUTH_DENIED",
+              message: "Подключение Google Drive было отклонено пользователем."
+            }
+          });
+        }
+        if (!query.state || !query.code) {
+          return reply.status(400).send({
+            error: {
+              code: "DRIVE_OAUTH_CODE_REQUIRED",
+              message: "Отсутствует код авторизации или параметр state."
+            }
+          });
+        }
+        return await controller.finishOAuthCallback(session, {
+          state: query.state,
+          code: query.code
+        });
+      } catch (error) {
+        const code = error instanceof Error ? error.message : "DRIVE_OAUTH_CALLBACK_FAILED";
+        return reply.status(statusForDriveError(code)).send({
+          error: { code, message: "Не удалось завершить подключение Google Drive." }
+        });
+      }
+    }
+  );
+
+  app.post(
+    "/api/v1/personal-settings/google-drive/connect/callback",
+    {
+      config: { logLevel: "silent" },
+      schema: { body: callbackBodySchema }
+    },
+    async (request, reply) => {
+      noCache(reply);
+      try {
+        const session = requireOwnerSession(request, identityFor);
+        const body = request.body as { state: string; code: string };
+        return await controller.finishOAuthCallback(session, body);
+      } catch (error) {
+        const code = error instanceof Error ? error.message : "DRIVE_OAUTH_CALLBACK_FAILED";
+        return reply.status(statusForDriveError(code)).send({
+          error: { code, message: "Не удалось завершить подключение Google Drive." }
+        });
+      }
+    }
+  );
+
+  app.post("/api/v1/personal-settings/google-drive/disconnect", async (request, reply) => {
+    noCache(reply);
+    try {
+      const { ownerId } = requireOwnerSession(request, identityFor);
+      return await controller.disconnect(ownerId);
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "DRIVE_DISCONNECT_FAILED";
+      return reply.status(statusForDriveError(code)).send({
+        error: { code, message: "Не удалось отключить Google Drive." }
+      });
+    }
+  });
+
+  app.post("/api/v1/personal-settings/google-drive/folder/retry", async (request, reply) => {
+    noCache(reply);
+    try {
+      const { ownerId } = requireOwnerSession(request, identityFor);
+      return await controller.retryFolder(ownerId);
+    } catch (error) {
+      const code = error instanceof Error ? error.message : "DRIVE_FOLDER_RETRY_FAILED";
+      return reply.status(statusForDriveError(code)).send({
+        error: { code, message: "Не удалось проверить или создать папку Kosmora на Google Drive." }
+      });
+    }
+  });
+
+  app.post(
+    "/api/v1/personal-settings/google-drive/backups",
+    { schema: { body: createBackupBodySchema } },
+    async (request, reply) => {
+      noCache(reply);
+      try {
+        const { ownerId } = requireOwnerSession(request, identityFor);
+        const body = (request.body ?? {}) as { backup_set_id?: string };
+        const result = await controller.createBackupCopy(
+          ownerId,
+          body.backup_set_id ? { backupSetId: body.backup_set_id } : {}
+        );
+        return reply.status(result.backupSet.complete ? 200 : 202).send(result);
+      } catch (error) {
+        const code = error instanceof Error ? error.message : "DRIVE_BACKUP_FAILED";
+        return reply.status(statusForDriveError(code)).send({
+          error: { code, message: "Не удалось сохранить архивную копию на Google Drive." }
+        });
+      }
+    }
+  );
+
+  app.post(
+    "/api/v1/personal-settings/google-drive/backups/:archiveId/retry",
+    { schema: { params: archiveParamsSchema } },
+    async (request, reply) => {
+      noCache(reply);
+      try {
+        const { ownerId } = requireOwnerSession(request, identityFor);
+        const { archiveId } = request.params as { archiveId: string };
+        const archive = await controller.retryArchiveUpload(ownerId, archiveId);
+        return { archive, overview: controller.overview(ownerId) };
+      } catch (error) {
+        const code = error instanceof Error ? error.message : "DRIVE_RETRY_FAILED";
+        return reply.status(statusForDriveError(code)).send({
+          error: { code, message: "Не удалось повторить отправку части архива." }
+        });
+      }
+    }
+  );
+
+  app.post(
+    "/api/v1/personal-settings/google-drive/backups/:archiveId/reconcile",
+    { schema: { params: archiveParamsSchema } },
+    async (request, reply) => {
+      noCache(reply);
+      try {
+        const { ownerId } = requireOwnerSession(request, identityFor);
+        const { archiveId } = request.params as { archiveId: string };
+        const archive = await controller.reconcileArchive(ownerId, archiveId);
+        return { archive, overview: controller.overview(ownerId) };
+      } catch (error) {
+        const code = error instanceof Error ? error.message : "DRIVE_RECONCILE_FAILED";
+        return reply.status(statusForDriveError(code)).send({
+          error: { code, message: "Не удалось сверить состояние архива на Google Drive." }
+        });
+      }
+    }
+  );
+
+  app.post(
+    "/api/v1/personal-settings/google-drive/restore/preview",
+    { schema: { body: restoreBodySchema } },
+    async (request, reply) => {
+      noCache(reply);
+      try {
+        const { ownerId } = requireOwnerSession(request, identityFor);
+        const { backup_set_id: backupSetId } = request.body as { backup_set_id: string };
+        return await controller.previewRestoreFromDrive(ownerId, backupSetId);
+      } catch (error) {
+        const code = error instanceof Error ? error.message : "DRIVE_RESTORE_PREVIEW_FAILED";
+        return reply.status(statusForDriveError(code)).send({
+          error: { code, message: "Не удалось подготовить предпросмотр восстановления." }
+        });
+      }
+    }
+  );
+
+  app.post(
+    "/api/v1/personal-settings/google-drive/restore",
+    { schema: { body: restoreBodySchema } },
+    async (request, reply) => {
+      noCache(reply);
+      try {
+        const { ownerId } = requireOwnerSession(request, identityFor);
+        const { backup_set_id: backupSetId } = request.body as { backup_set_id: string };
+        return await controller.executeRestoreFromDrive(ownerId, backupSetId);
+      } catch (error) {
+        const code = error instanceof Error ? error.message : "DRIVE_RESTORE_FAILED";
+        return reply.status(statusForDriveError(code)).send({
+          error: { code, message: "Не удалось выполнить транзакционное восстановление архива." }
+        });
+      }
+    }
+  );
+}
diff --git a/apps/api/src/cloud-storage/google-drive-store.ts b/apps/api/src/cloud-storage/google-drive-store.ts
new file mode 100644
index 0000000..0f54fd2
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive-store.ts
@@ -0,0 +1,464 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import { DRIVE_ARCHIVE_MAX_BYTES, type DriveArchiveReceipt } from "./google-drive.js";
+import type { DriveGrant } from "./google-drive-authorization.js";
+import type { DriveGrantCipher } from "./google-drive-grant-cipher.js";
+
+export interface Connection {
+  owner_id: string;
+  revision: number;
+  connection_id: string | null;
+  grant_ciphertext: string | null;
+  grant_version: number;
+  folder_id: string | null;
+  folder_state: "disconnected" | "reserved" | "creating" | "uncertain" | "ready";
+  folder_lease: string | null;
+  updated_at: string;
+}
+
+export type DriveContext = { ownerId: string; epoch: number; connectionId: string };
+export type DriveConnectTicket = { ownerId: string; epoch: number; revision: number };
+export type DriveConnectionStatus = Omit<
+  Connection,
+  "grant_ciphertext" | "folder_lease" | "grant_version"
+>;
+
+export type DriveArchive = DriveArchiveReceipt & {
+  id: string;
+  connectionId: string;
+  state: "reserved" | "uploading" | "checking" | "uncertain" | "verified" | "failed";
+  createdAt: string;
+  updatedAt: string;
+};
+
+interface ArchiveRow {
+  id: string;
+  owner_id: string;
+  connection_id: string;
+  operation_id: string;
+  file_id: string;
+  folder_id: string;
+  size_bytes: number;
+  sha256: string;
+  state: DriveArchive["state"];
+  lease: string | null;
+  created_at: string;
+  updated_at: string;
+}
+
+const MAX_ACTIVE_QUEUE = 10;
+const MAX_TOTAL_RECEIPTS = 1000;
+const PAGE_LIMIT = 50;
+
+export class GoogleDriveStore {
+  constructor(
+    private readonly db: DatabaseSync,
+    private readonly cipher?: DriveGrantCipher,
+    private readonly now = () => new Date().toISOString()
+  ) {}
+
+  private activeEpoch(ownerId: string): number {
+    const row = this.db
+      .prepare("SELECT epoch, state FROM kosmora_owner_data_lifecycle WHERE owner_id=?")
+      .get(ownerId) as { epoch: number; state: string } | undefined;
+    if (row && row.state !== "active") {
+      throw new Error("OWNER_DATA_FENCED");
+    }
+    return row ? Number(row.epoch) : 0;
+  }
+
+  private mapArchive(row: ArchiveRow): DriveArchive {
+    return {
+      id: row.id,
+      connectionId: row.connection_id,
+      operationId: row.operation_id,
+      fileId: row.file_id,
+      folderId: row.folder_id,
+      bytes: Number(row.size_bytes),
+      sha256: row.sha256,
+      state: row.state,
+      createdAt: row.created_at,
+      updatedAt: row.updated_at
+    };
+  }
+
+  status(ownerId: string): DriveConnectionStatus | null {
+    const row = this.db
+      .prepare(
+        "SELECT owner_id, revision, connection_id, folder_id, folder_state, updated_at FROM kosmora_drive_connections WHERE owner_id=?"
+      )
+      .get(ownerId) as DriveConnectionStatus | undefined;
+    return row ? { ...row, revision: Number(row.revision) } : null;
+  }
+
+  beginConnect(ownerId: string): DriveConnectTicket {
+    const epoch = this.activeEpoch(ownerId);
+    const current = this.status(ownerId);
+    if (current && current.folder_state !== "disconnected") {
+      throw new Error("DRIVE_ALREADY_CONNECTED");
+    }
+    return {
+      ownerId,
+      epoch,
+      revision: current ? current.revision : 0
+    };
+  }
+
+  connect(ticket: DriveConnectTicket, grant: DriveGrant, folderId: string): DriveContext {
+    if (!this.cipher) throw new Error("DRIVE_KEY_CONFIGURATION_REQUIRED");
+    const epoch = this.activeEpoch(ticket.ownerId);
+    if (epoch !== ticket.epoch) {
+      throw new Error("DRIVE_CONNECT_EXPIRED");
+    }
+    const connectionId = `drv_conn_${randomUUID()}`;
+    const ciphertext = this.cipher.seal(ticket.ownerId, grant);
+    const ts = this.now();
+    const nextRevision = ticket.revision + 1;
+
+    const existing = this.status(ticket.ownerId);
+    if (!existing) {
+      if (ticket.revision !== 0) throw new Error("DRIVE_CONNECT_EXPIRED");
+      this.db
+        .prepare(
+          `INSERT INTO kosmora_drive_connections
+           (owner_id, revision, connection_id, grant_ciphertext, grant_version, folder_id, folder_state, folder_lease, updated_at)
+           VALUES (?, ?, ?, ?, 1, ?, 'uncertain', NULL, ?)`
+        )
+        .run(ticket.ownerId, nextRevision, connectionId, ciphertext, folderId, ts);
+    } else {
+      if (existing.revision !== ticket.revision || existing.folder_state !== "disconnected") {
+        throw new Error("DRIVE_CONNECT_EXPIRED");
+      }
+      const res = this.db
+        .prepare(
+          `UPDATE kosmora_drive_connections
+           SET revision=?, connection_id=?, grant_ciphertext=?, grant_version=grant_version+1,
+               folder_id=?, folder_state='uncertain', folder_lease=NULL, updated_at=?
+           WHERE owner_id=? AND revision=? AND folder_state='disconnected'`
+        )
+        .run(nextRevision, connectionId, ciphertext, folderId, ts, ticket.ownerId, ticket.revision);
+      if (Number(res.changes) !== 1) {
+        throw new Error("DRIVE_CONNECT_EXPIRED");
+      }
+    }
+
+    return {
+      ownerId: ticket.ownerId,
+      epoch,
+      connectionId
+    };
+  }
+
+  context(ownerId: string): DriveContext {
+    const epoch = this.activeEpoch(ownerId);
+    const row = this.db
+      .prepare(
+        "SELECT connection_id, folder_state FROM kosmora_drive_connections WHERE owner_id=?"
+      )
+      .get(ownerId) as { connection_id: string | null; folder_state: string } | undefined;
+    if (!row || !row.connection_id || row.folder_state === "disconnected") {
+      throw new Error("DRIVE_NOT_CONNECTED");
+    }
+    return {
+      ownerId,
+      epoch,
+      connectionId: row.connection_id
+    };
+  }
+
+  private assertValidContext(context: DriveContext): Connection {
+    const epoch = this.activeEpoch(context.ownerId);
+    if (epoch !== context.epoch) {
+      throw new Error("DRIVE_DISCONNECTED");
+    }
+    const row = this.db
+      .prepare("SELECT * FROM kosmora_drive_connections WHERE owner_id=?")
+      .get(context.ownerId) as Connection | undefined;
+    if (
+      !row ||
+      row.folder_state === "disconnected" ||
+      row.connection_id !== context.connectionId
+    ) {
+      throw new Error("DRIVE_DISCONNECTED");
+    }
+    return row;
+  }
+
+  readGrant(context: DriveContext): { grant: DriveGrant; version: number } {
+    if (!this.cipher) throw new Error("DRIVE_KEY_CONFIGURATION_REQUIRED");
+    const row = this.assertValidContext(context);
+    if (!row.grant_ciphertext) throw new Error("DRIVE_DISCONNECTED");
+    return {
+      grant: this.cipher.open(context.ownerId, row.grant_ciphertext),
+      version: Number(row.grant_version)
+    };
+  }
+
+  refreshGrant(context: DriveContext, expectedVersion: number, grant: DriveGrant): void {
+    if (!this.cipher) throw new Error("DRIVE_KEY_CONFIGURATION_REQUIRED");
+    this.assertValidContext(context);
+    const ciphertext = this.cipher.seal(context.ownerId, grant);
+    const res = this.db
+      .prepare(
+        `UPDATE kosmora_drive_connections
+         SET grant_ciphertext=?, grant_version=grant_version+1, updated_at=?
+         WHERE owner_id=? AND connection_id=? AND grant_version=?`
+      )
+      .run(ciphertext, this.now(), context.ownerId, context.connectionId, expectedVersion);
+    if (Number(res.changes) !== 1) {
+      throw new Error("DRIVE_LEASE_CHANGED");
+    }
+  }
+
+  disconnect(ownerId: string): void {
+    this.activeEpoch(ownerId);
+    const ts = this.now();
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      const existing = this.status(ownerId);
+      if (existing) {
+        this.db
+          .prepare(
+            `UPDATE kosmora_drive_connections
+             SET revision=revision+1, connection_id=NULL, grant_ciphertext=NULL,
+                 folder_id=NULL, folder_state='disconnected', folder_lease=NULL, updated_at=?
+             WHERE owner_id=?`
+          )
+          .run(ts, ownerId);
+        this.db
+          .prepare(
+            `UPDATE kosmora_drive_archives
+             SET state='uncertain', lease=NULL, updated_at=?
+             WHERE owner_id=? AND state IN ('reserved', 'uploading', 'checking')`
+          )
+          .run(ts, ownerId);
+      }
+      this.db.exec("COMMIT");
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+  }
+
+  claimFolder(context: DriveContext, explicitRetry = false): { fileId: string; lease: string } {
+    const row = this.assertValidContext(context);
+    if (row.folder_state === "ready") {
+      return { fileId: row.folder_id!, lease: "" };
+    }
+    if (row.folder_state === "creating") {
+      throw new Error("DRIVE_FOLDER_BUSY");
+    }
+    if (!explicitRetry && row.folder_state !== "uncertain") {
+      throw new Error("DRIVE_FOLDER_BUSY");
+    }
+    const lease = `flease_${randomUUID()}`;
+    const res = this.db
+      .prepare(
+        `UPDATE kosmora_drive_connections
+         SET folder_state='creating', folder_lease=?, updated_at=?
+         WHERE owner_id=? AND connection_id=? AND folder_state='uncertain'`
+      )
+      .run(lease, this.now(), context.ownerId, context.connectionId);
+    if (Number(res.changes) !== 1) {
+      throw new Error("DRIVE_FOLDER_BUSY");
+    }
+    return { fileId: row.folder_id!, lease };
+  }
+
+  finishFolder(context: DriveContext, lease: string, verified: boolean): void {
+    this.assertValidContext(context);
+    const nextState = verified ? "ready" : "uncertain";
+    const res = this.db
+      .prepare(
+        `UPDATE kosmora_drive_connections
+         SET folder_state=?, folder_lease=NULL, updated_at=?
+         WHERE owner_id=? AND connection_id=? AND folder_state='creating' AND folder_lease=?`
+      )
+      .run(nextState, this.now(), context.ownerId, context.connectionId, lease);
+    if (Number(res.changes) !== 1) {
+      throw new Error("DRIVE_LEASE_CHANGED");
+    }
+  }
+
+  claimFolderReconciliation(context: DriveContext): { fileId: string; lease: string } {
+    return this.claimFolder(context, true);
+  }
+
+  reserveArchive(
+    context: DriveContext,
+    operationId: string,
+    fileId: string,
+    bytes: Uint8Array
+  ): DriveArchive {
+    const conn = this.assertValidContext(context);
+    if (conn.folder_state !== "ready" || !conn.folder_id) {
+      throw new Error("DRIVE_NOT_CONNECTED");
+    }
+    if (bytes.byteLength < 1 || bytes.byteLength > DRIVE_ARCHIVE_MAX_BYTES) {
+      throw new Error("INVALID_DRIVE_RECEIPT");
+    }
+    const sha256 = createHash("sha256").update(bytes).digest("hex");
+    const existing = this.findArchive(context, operationId);
+    if (existing) {
+      if (
+        existing.sha256 !== sha256 ||
+        existing.bytes !== bytes.byteLength ||
+        existing.fileId !== fileId
+      ) {
+        throw new Error("DRIVE_ARCHIVE_EXISTS");
+      }
+      return existing;
+    }
+
+    const activeCount = (
+      this.db
+        .prepare(
+          `SELECT COUNT(*) AS cnt FROM kosmora_drive_archives
+           WHERE owner_id=? AND connection_id=? AND state IN ('reserved','uploading','checking','uncertain')`
+        )
+        .get(context.ownerId, context.connectionId) as { cnt: number }
+    ).cnt;
+    if (Number(activeCount) >= MAX_ACTIVE_QUEUE) {
+      throw new Error("DRIVE_ARCHIVE_BUSY");
+    }
+
+    const totalCount = (
+      this.db
+        .prepare("SELECT COUNT(*) AS cnt FROM kosmora_drive_archives WHERE owner_id=?")
+        .get(context.ownerId) as { cnt: number }
+    ).cnt;
+    if (Number(totalCount) >= MAX_TOTAL_RECEIPTS) {
+      throw new Error("DRIVE_ARCHIVE_BUSY");
+    }
+
+    const id = `drv_arch_${randomUUID()}`;
+    const ts = this.now();
+    this.db
+      .prepare(
+        `INSERT INTO kosmora_drive_archives
+         (id, owner_id, connection_id, operation_id, file_id, folder_id, size_bytes, sha256, state, lease, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'reserved', NULL, ?, ?)`
+      )
+      .run(
+        id,
+        context.ownerId,
+        context.connectionId,
+        operationId,
+        fileId,
+        conn.folder_id,
+        bytes.byteLength,
+        sha256,
+        ts,
+        ts
+      );
+
+    return this.getArchive(context, id);
+  }
+
+  listArchives(ownerId: string, offset = 0): DriveArchive[] {
+    if (!Number.isSafeInteger(offset) || offset < 0) {
+      throw new Error("INVALID_DRIVE_OFFSET");
+    }
+    const rows = this.db
+      .prepare(
+        `SELECT * FROM kosmora_drive_archives
+         WHERE owner_id=?
+         ORDER BY created_at DESC, id DESC
+         LIMIT ? OFFSET ?`
+      )
+      .all(ownerId, PAGE_LIMIT, offset) as unknown as ArchiveRow[];
+    return rows.map((r) => this.mapArchive(r));
+  }
+
+  getArchive(context: DriveContext, id: string): DriveArchive {
+    this.activeEpoch(context.ownerId);
+    const row = this.db
+      .prepare("SELECT * FROM kosmora_drive_archives WHERE owner_id=? AND id=?")
+      .get(context.ownerId, id) as ArchiveRow | undefined;
+    if (!row) throw new Error("DRIVE_ARCHIVE_NOT_FOUND");
+    return this.mapArchive(row);
+  }
+
+  findArchive(context: DriveContext, operationId: string): DriveArchive | null {
+    this.activeEpoch(context.ownerId);
+    const row = this.db
+      .prepare(
+        "SELECT * FROM kosmora_drive_archives WHERE owner_id=? AND connection_id=? AND operation_id=?"
+      )
+      .get(context.ownerId, context.connectionId, operationId) as ArchiveRow | undefined;
+    return row ? this.mapArchive(row) : null;
+  }
+
+  claimArchive(
+    context: DriveContext,
+    id: string,
+    mode: "upload" | "reconcile" | "retry"
+  ): { archive: DriveArchive; lease: string } {
+    this.assertValidContext(context);
+    const row = this.db
+      .prepare(
+        "SELECT * FROM kosmora_drive_archives WHERE owner_id=? AND connection_id=? AND id=?"
+      )
+      .get(context.ownerId, context.connectionId, id) as ArchiveRow | undefined;
+    if (!row) throw new Error("DRIVE_ARCHIVE_NOT_FOUND");
+
+    if (mode === "upload" && row.state !== "reserved") {
+      throw new Error("DRIVE_ARCHIVE_BUSY");
+    }
+    if (mode === "reconcile" && row.state !== "uncertain") {
+      throw new Error("DRIVE_ARCHIVE_BUSY");
+    }
+    if (mode === "retry" && row.state !== "failed" && row.state !== "uncertain") {
+      throw new Error("DRIVE_ARCHIVE_BUSY");
+    }
+
+    const nextState = mode === "reconcile" ? "checking" : "uploading";
+    const lease = `alease_${randomUUID()}`;
+    const res = this.db
+      .prepare(
+        `UPDATE kosmora_drive_archives
+         SET state=?, lease=?, updated_at=?
+         WHERE owner_id=? AND connection_id=? AND id=? AND state=?`
+      )
+      .run(nextState, lease, this.now(), context.ownerId, context.connectionId, id, row.state);
+    if (Number(res.changes) !== 1) {
+      throw new Error("DRIVE_ARCHIVE_BUSY");
+    }
+    return {
+      archive: this.getArchive(context, id),
+      lease
+    };
+  }
+
+  finishArchive(
+    context: DriveContext,
+    id: string,
+    lease: string,
+    outcome: "verified" | "uncertain" | "failed",
+    details?: { fileId?: string; folderId?: string; bytes?: number; sha256?: string }
+  ): DriveArchive {
+    this.assertValidContext(context);
+    const current = this.getArchive(context, id);
+    if (details) {
+      if (
+        (details.fileId && details.fileId !== current.fileId) ||
+        (details.folderId && details.folderId !== current.folderId) ||
+        (details.bytes !== undefined && details.bytes !== current.bytes) ||
+        (details.sha256 && details.sha256.toLowerCase() !== current.sha256.toLowerCase())
+      ) {
+        throw new Error("DRIVE_ARCHIVE_CHANGED");
+      }
+    }
+    const res = this.db
+      .prepare(
+        `UPDATE kosmora_drive_archives
+         SET state=?, lease=NULL, updated_at=?
+         WHERE owner_id=? AND connection_id=? AND id=? AND lease=? AND state IN ('uploading','checking')`
+      )
+      .run(outcome, this.now(), context.ownerId, context.connectionId, id, lease);
+    if (Number(res.changes) !== 1) {
+      throw new Error("DRIVE_LEASE_CHANGED");
+    }
+    return this.getArchive(context, id);
+  }
+}
diff --git a/apps/api/src/cloud-storage/google-drive.ts b/apps/api/src/cloud-storage/google-drive.ts
new file mode 100644
index 0000000..c1edb92
--- /dev/null
+++ b/apps/api/src/cloud-storage/google-drive.ts
@@ -0,0 +1,306 @@
+import { createHash } from "node:crypto";
+
+export const DRIVE_FILE_SCOPE = "https://www.googleapis.com/auth/drive.file";
+export const DRIVE_ARCHIVE_MAX_BYTES = 4 * 1024 * 1024;
+const METADATA_MAX_BYTES = 100 * 1024;
+const FOLDER_MIME = "application/vnd.google-apps.folder";
+const ZIP_MIME = "application/zip";
+
+export class DriveStorageError extends Error {
+  constructor(
+    readonly code: string,
+    readonly uncertain = false
+  ) {
+    super(code);
+    this.name = "DriveStorageError";
+  }
+}
+
+export interface DriveArchiveReceipt {
+  fileId: string;
+  folderId: string;
+  operationId: string;
+  bytes: number;
+  sha256: string;
+}
+
+export async function readBoundedDriveBody(response: Response, limit: number): Promise<Buffer> {
+  if (!response.body) {
+    throw new DriveStorageError("DRIVE_EMPTY_RESPONSE");
+  }
+  const reader = response.body.getReader();
+  const chunks: Buffer[] = [];
+  let total = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      const buf = Buffer.from(value);
+      total += buf.byteLength;
+      if (total > limit) {
+        throw new DriveStorageError("DRIVE_RESPONSE_TOO_LARGE");
+      }
+      chunks.push(buf);
+    }
+  } finally {
+    await reader.cancel().catch(() => {});
+  }
+  if (total === 0) {
+    throw new DriveStorageError("DRIVE_EMPTY_RESPONSE");
+  }
+  return Buffer.concat(chunks, total);
+}
+
+export class GoogleDriveArchiveTransport {
+  constructor(
+    private readonly ownerId: string,
+    private readonly accessToken: () => Promise<string>,
+    private readonly request: typeof fetch = fetch
+  ) {
+    if (typeof ownerId !== "string" || !ownerId.trim()) {
+      throw new DriveStorageError("INVALID_OWNER");
+    }
+  }
+
+  private async authHeaders(extra: Record<string, string> = {}): Promise<Record<string, string>> {
+    const token = await this.accessToken();
+    if (!token) throw new DriveStorageError("DRIVE_AUTH_REQUIRED");
+    return {
+      Authorization: `Bearer ${token}`,
+      ...extra
+    };
+  }
+
+  async generateId(): Promise<string> {
+    let response: Response;
+    try {
+      response = await this.request(
+        "https://www.googleapis.com/drive/v3/files/generateIds?count=1&space=drive",
+        {
+          method: "GET",
+          headers: await this.authHeaders(),
+          redirect: "error"
+        }
+      );
+    } catch {
+      throw new DriveStorageError("DRIVE_TRANSPORT_FAILED");
+    }
+    if (response.status === 401 || response.status === 403) {
+      throw new DriveStorageError("DRIVE_ACCESS_DENIED");
+    }
+    if (!response.ok) {
+      throw new DriveStorageError("DRIVE_REQUEST_FAILED");
+    }
+    const body = await readBoundedDriveBody(response, METADATA_MAX_BYTES);
+    const parsed = JSON.parse(body.toString("utf8")) as { ids?: unknown };
+    const id = Array.isArray(parsed.ids) ? parsed.ids[0] : null;
+    if (typeof id !== "string" || !/^[A-Za-z0-9_-]{8,128}$/.test(id)) {
+      throw new DriveStorageError("DRIVE_INVALID_RESPONSE");
+    }
+    return id;
+  }
+
+  async createFolder(fileId: string): Promise<void> {
+    let response: Response;
+    try {
+      response = await this.request(
+        "https://www.googleapis.com/drive/v3/files?fields=id,mimeType,trashed,appProperties",
+        {
+          method: "POST",
+          headers: await this.authHeaders({ "Content-Type": "application/json; charset=utf-8" }),
+          body: JSON.stringify({
+            id: fileId,
+            name: "Kosmora Archives",
+            mimeType: FOLDER_MIME,
+            appProperties: {
+              kosmora_kind: "archive_folder",
+              owner: this.ownerId
+            }
+          }),
+          redirect: "error"
+        }
+      );
+    } catch {
+      throw new DriveStorageError("DRIVE_TRANSPORT_FAILED", true);
+    }
+    if (response.status === 409) {
+      throw new DriveStorageError("DRIVE_CONFLICT", true);
+    }
+    if (response.status >= 500) {
+      throw new DriveStorageError("DRIVE_REQUEST_FAILED", true);
+    }
+    if (!response.ok) {
+      throw new DriveStorageError("DRIVE_REQUEST_FAILED", false);
+    }
+    const raw = await readBoundedDriveBody(response, METADATA_MAX_BYTES);
+    const meta = JSON.parse(raw.toString("utf8")) as Record<string, unknown>;
+    const props = (meta.appProperties ?? {}) as Record<string, unknown>;
+    if (
+      meta.id !== fileId ||
+      meta.mimeType !== FOLDER_MIME ||
+      meta.trashed === true ||
+      props.owner !== this.ownerId
+    ) {
+      throw new DriveStorageError("DRIVE_INVALID_RESPONSE", false);
+    }
+  }
+
+  async inspectFolder(fileId: string): Promise<"verified_metadata" | "unavailable"> {
+    const response = await this.request(
+      `https://www.googleapis.com/drive/v3/files/${encodeURIComponent(fileId)}?fields=id,mimeType,trashed,appProperties`,
+      {
+        method: "GET",
+        headers: await this.authHeaders(),
+        redirect: "error"
+      }
+    );
+    if (response.status === 404) return "unavailable";
+    if (!response.ok) throw new DriveStorageError("DRIVE_REQUEST_FAILED", true);
+    const raw = await readBoundedDriveBody(response, METADATA_MAX_BYTES);
+    const meta = JSON.parse(raw.toString("utf8")) as Record<string, unknown>;
+    const props = (meta.appProperties ?? {}) as Record<string, unknown>;
+    if (
+      meta.id !== fileId ||
+      meta.mimeType !== FOLDER_MIME ||
+      meta.trashed === true ||
+      props.owner !== this.ownerId
+    ) {
+      return "unavailable";
+    }
+    return "verified_metadata";
+  }
+
+  async uploadArchive(
+    input: { fileId: string; folderId: string; operationId: string; name: string },
+    bytes: Uint8Array
+  ): Promise<DriveArchiveReceipt> {
+    if (bytes.byteLength < 1 || bytes.byteLength > DRIVE_ARCHIVE_MAX_BYTES) {
+      throw new DriveStorageError("INVALID_DRIVE_RECEIPT", false);
+    }
+    const sha256 = createHash("sha256").update(bytes).digest("hex");
+    const boundary = `kosmora_drive_${sha256.slice(0, 24)}`;
+    const metadata = JSON.stringify({
+      id: input.fileId,
+      name: input.name,
+      parents: [input.folderId],
+      mimeType: ZIP_MIME,
+      appProperties: {
+        owner: this.ownerId,
+        operation_id: input.operationId,
+        sha256
+      }
+    });
+    const preamble = Buffer.from(
+      `--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${metadata}\r\n--${boundary}\r\nContent-Type: ${ZIP_MIME}\r\n\r\n`,
+      "utf8"
+    );
+    const epilogue = Buffer.from(`\r\n--${boundary}--\r\n`, "utf8");
+    const multipartBody = Buffer.concat([preamble, Buffer.from(bytes), epilogue]);
+
+    let response: Response;
+    try {
+      response = await this.request(
+        "https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name,parents,mimeType,size,sha256Checksum,trashed,appProperties",
+        {
+          method: "POST",
+          headers: await this.authHeaders({
+            "Content-Type": `multipart/related; boundary=${boundary}`
+          }),
+          body: multipartBody,
+          redirect: "error"
+        }
+      );
+    } catch {
+      throw new DriveStorageError("DRIVE_TRANSPORT_FAILED", true);
+    }
+
+    if (response.status === 409) {
+      throw new DriveStorageError("DRIVE_CONFLICT", true);
+    }
+    if (response.status >= 500) {
+      throw new DriveStorageError("DRIVE_REQUEST_FAILED", true);
+    }
+    if (!response.ok) {
+      throw new DriveStorageError("DRIVE_REQUEST_FAILED", false);
+    }
+
+    const raw = await readBoundedDriveBody(response, METADATA_MAX_BYTES);
+    const meta = JSON.parse(raw.toString("utf8")) as Record<string, unknown>;
+    const props = (meta.appProperties ?? {}) as Record<string, unknown>;
+    if (
+      meta.id !== input.fileId ||
+      meta.trashed === true ||
+      Number(meta.size) !== bytes.byteLength ||
+      String(meta.sha256Checksum ?? "").toLowerCase() !== sha256 ||
+      props.owner !== this.ownerId ||
+      props.operation_id !== input.operationId
+    ) {
+      throw new DriveStorageError("DRIVE_ARCHIVE_CHANGED", false);
+    }
+
+    return {
+      fileId: input.fileId,
+      folderId: input.folderId,
+      operationId: input.operationId,
+      bytes: bytes.byteLength,
+      sha256
+    };
+  }
+
+  async inspectArchive(receipt: DriveArchiveReceipt): Promise<"verified_metadata" | "unavailable"> {
+    const response = await this.request(
+      `https://www.googleapis.com/drive/v3/files/${encodeURIComponent(receipt.fileId)}?fields=id,parents,mimeType,size,sha256Checksum,trashed,appProperties`,
+      {
+        method: "GET",
+        headers: await this.authHeaders(),
+        redirect: "error"
+      }
+    );
+    if (response.status === 404) return "unavailable";
+    if (!response.ok) throw new DriveStorageError("DRIVE_REQUEST_FAILED", true);
+    const raw = await readBoundedDriveBody(response, METADATA_MAX_BYTES);
+    const meta = JSON.parse(raw.toString("utf8")) as Record<string, unknown>;
+    const props = (meta.appProperties ?? {}) as Record<string, unknown>;
+    const parents = Array.isArray(meta.parents) ? meta.parents : [];
+    if (
+      meta.id !== receipt.fileId ||
+      meta.trashed === true ||
+      !parents.includes(receipt.folderId) ||
+      Number(meta.size) !== receipt.bytes ||
+      String(meta.sha256Checksum ?? "").toLowerCase() !== receipt.sha256.toLowerCase() ||
+      props.owner !== this.ownerId ||
+      props.operation_id !== receipt.operationId
+    ) {
+      throw new DriveStorageError("DRIVE_ARCHIVE_CHANGED", false);
+    }
+    return "verified_metadata";
+  }
+
+  async downloadArchive(receipt: DriveArchiveReceipt): Promise<Buffer> {
+    let response: Response;
+    try {
+      response = await this.request(
+        `https://www.googleapis.com/drive/v3/files/${encodeURIComponent(receipt.fileId)}?alt=media`,
+        {
+          method: "GET",
+          headers: await this.authHeaders(),
+          redirect: "error"
+        }
+      );
+    } catch {
+      throw new DriveStorageError("DRIVE_DOWNLOAD_FAILED", true);
+    }
+    if (response.status === 404) {
+      throw new DriveStorageError("DRIVE_ARCHIVE_UNAVAILABLE", false);
+    }
+    if (!response.ok) {
+      throw new DriveStorageError("DRIVE_DOWNLOAD_FAILED", true);
+    }
+    const data = await readBoundedDriveBody(response, receipt.bytes);
+    const digest = createHash("sha256").update(data).digest("hex");
+    if (data.byteLength !== receipt.bytes || digest !== receipt.sha256.toLowerCase()) {
+      throw new DriveStorageError("DRIVE_ARCHIVE_CHANGED", false);
+    }
+    return data;
+  }
+}
