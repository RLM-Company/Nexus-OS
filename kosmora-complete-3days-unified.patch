index 0000000..3c7a9bf
--- /dev/null
+++ b/desktop/windows/ci/archive-quarantine-verifier.cjs
@@ -0,0 +1,187 @@
+"use strict";
+
+/**
+ * Pre-extraction Binary Archive Inspector & Quarantine Guard for Windows Desktop Vault.
+ * Scans ZIP Central Directory headers before extraction to block:
+ * - Zip-Slip path traversal (`../`, `..\\`, absolute paths, Windows drive letters `C:\`)
+ * - Zip-Bomb compression ratios (> maxCompressionRatio, default 100:1) or total uncompressed size overflow
+ * - Symlink / dangerous executable payloads embedded inside archives
+ */
+
+const EOCD_SIGNATURE = 0x06054b50;
+const CDFH_SIGNATURE = 0x02014b50;
+
+function inspectZipArchiveSafety(zipBuffer, options = {}) {
+  const maxTotalUncompressedBytes = options.maxTotalUncompressedBytes ?? 50 * 1024 * 1024; // 50 MB
+  const maxEntryCount = options.maxEntryCount ?? 1000;
+  const maxCompressionRatio = options.maxCompressionRatio ?? 100;
+
+  if (!Buffer.isBuffer(zipBuffer) || zipBuffer.length < 22) {
+    return {
+      safe: false,
+      violations: ["INVALID_ZIP_BUFFER: buffer is too small to contain an End of Central Directory record"],
+      entries: []
+    };
+  }
+
+  // Locate End of Central Directory (EOCD) scanning backwards up to 65KB
+  let eocdOffset = -1;
+  const minSearchOffset = Math.max(0, zipBuffer.length - 65557);
+  for (let i = zipBuffer.length - 22; i >= minSearchOffset; i--) {
+    if (zipBuffer.readUInt32LE(i) === EOCD_SIGNATURE) {
+      eocdOffset = i;
+      break;
+    }
+  }
+
+  if (eocdOffset === -1) {
+    return {
+      safe: false,
+      violations: ["MISSING_EOCD_RECORD: archive is truncated or not a valid ZIP file"],
+      entries: []
+    };
+  }
+
+  const totalEntries = zipBuffer.readUInt16LE(eocdOffset + 10);
+  const centralDirSize = zipBuffer.readUInt32LE(eocdOffset + 12);
+  const centralDirOffset = zipBuffer.readUInt32LE(eocdOffset + 16);
+
+  const violations = [];
+  if (totalEntries > maxEntryCount) {
+    violations.push(`ENTRY_COUNT_EXCEEDED: ${totalEntries} entries > limit ${maxEntryCount}`);
+  }
+  if (centralDirOffset + centralDirSize > eocdOffset) {
+    violations.push("CORRUPT_CENTRAL_DIRECTORY: directory bounds overlap EOCD");
+    return { safe: false, violations, entries: [] };
+  }
+
+  const entries = [];
+  let ptr = centralDirOffset;
+  let cumulativeUncompressed = 0;
+
+  for (let idx = 0; idx < totalEntries && ptr + 46 <= eocdOffset; idx++) {
+    const sig = zipBuffer.readUInt32LE(ptr);
+    if (sig !== CDFH_SIGNATURE) {
+      violations.push(`INVALID_CDFH_SIGNATURE at entry #${idx}`);
+      break;
+    }
+
+    const versionMadeBy = zipBuffer.readUInt16LE(ptr + 4);
+    const compressedSize = zipBuffer.readUInt32LE(ptr + 20);
+    const uncompressedSize = zipBuffer.readUInt32LE(ptr + 24);
+    const fileNameLen = zipBuffer.readUInt16LE(ptr + 28);
+    const extraLen = zipBuffer.readUInt16LE(ptr + 30);
+    const commentLen = zipBuffer.readUInt16LE(ptr + 32);
+    const externalAttrs = zipBuffer.readUInt32LE(ptr + 38);
+
+    const fileName = zipBuffer.toString("utf8", ptr + 46, ptr + 46 + fileNameLen);
+    ptr += 46 + fileNameLen + extraLen + commentLen;
+
+    cumulativeUncompressed += uncompressedSize;
+    const ratio = compressedSize > 0 ? uncompressedSize / compressedSize : uncompressedSize > 0 ? Infinity : 1;
+
+    // Check UNIX symlink mode ((externalAttrs >>> 16) & 0o170000) === 0o120000
+    const unixMode = (externalAttrs >>> 16) & 0o170000;
+    const isSymlink = (versionMadeBy >>> 8) === 3 && unixMode === 0o120000;
+
+    // Check Zip-Slip path traversal
+    const normalized = fileName.replace(/\\/g, "/");
+    const segments = normalized.split("/");
+    const hasDotDot = segments.includes("..");
+    const isAbsolute = normalized.startsWith("/") || /^[a-zA-Z]:/.test(normalized);
+
+    if (hasDotDot || isAbsolute) {
+      violations.push(`ZIP_SLIP_PATH_TRAVERSAL: '${fileName}'`);
+    }
+    if (isSymlink) {
+      violations.push(`SYMLINK_ENTRY_BLOCKED: '${fileName}'`);
+    }
+    if (ratio > maxCompressionRatio && uncompressedSize > 4096) {
+      violations.push(
+        `ZIP_BOMB_RATIO_EXCEEDED: '${fileName}' has compression ratio ${ratio.toFixed(1)}:1 > ${maxCompressionRatio}:1`
+      );
+    }
+    if (/\.(exe|bat|cmd|ps1|vbs|scr|dll|sys|lnk)$/i.test(fileName)) {
+      violations.push(`DANGEROUS_EXECUTABLE_ENTRY: '${fileName}'`);
+    }
+
+    entries.push({
+      fileName,
+      compressedSize,
+      uncompressedSize,
+      compressionRatio: Number(ratio.toFixed(2)),
+      isSymlink
+    });
+  }
+
+  if (cumulativeUncompressed > maxTotalUncompressedBytes) {
+    violations.push(
+      `TOTAL_UNCOMPRESSED_SIZE_EXCEEDED: ${cumulativeUncompressed} bytes > ${maxTotalUncompressedBytes}`
+    );
+  }
+
+  return {
+    safe: violations.length === 0,
+    totalEntries,
+    totalUncompressedBytes: cumulativeUncompressed,
+    violations,
+    entries
+  };
+}
+
+/**
+ * Helper to build a synthetic ZIP buffer in-memory with custom entries for testing quarantine rules.
+ */
+function buildSyntheticZipCentralDirBuffer(entriesSpec = []) {
+  const localChunks = [];
+  const centralChunks = [];
+  let localOffset = 0;
+
+  for (const item of entriesSpec) {
+    const nameBuf = Buffer.from(item.fileName, "utf8");
+    const compSize = item.compressedSize ?? 32;
+    const uncompSize = item.uncompressedSize ?? 32;
+    const isSymlink = Boolean(item.isSymlink);
+    const payload = Buffer.alloc(compSize, 0x41);
+
+    const lfh = Buffer.alloc(30 + nameBuf.length);
+    lfh.writeUInt32LE(0x04034b50, 0);
+    lfh.writeUInt16LE(20, 4);
+    lfh.writeUInt32LE(compSize, 18);
+    lfh.writeUInt32LE(uncompSize, 22);
+    lfh.writeUInt16LE(nameBuf.length, 26);
+    nameBuf.copy(lfh, 30);
+
+    const cdfh = Buffer.alloc(46 + nameBuf.length);
+    cdfh.writeUInt32LE(CDFH_SIGNATURE, 0);
+    cdfh.writeUInt16LE(isSymlink ? (3 << 8) | 20 : 20, 4); // versionMadeBy: UNIX (3) if symlink
+    cdfh.writeUInt16LE(20, 6);
+    cdfh.writeUInt32LE(compSize, 20);
+    cdfh.writeUInt32LE(uncompSize, 24);
+    cdfh.writeUInt16LE(nameBuf.length, 28);
+    if (isSymlink) {
+      cdfh.writeUInt32LE((0o120777 << 16) >>> 0, 38);
+    }
+    cdfh.writeUInt32LE(localOffset, 42);
+    nameBuf.copy(cdfh, 46);
+
+    localChunks.push(lfh, payload);
+    centralChunks.push(cdfh);
+    localOffset += lfh.length + payload.length;
+  }
+
+  const centralDirBuf = Buffer.concat(centralChunks);
+  const eocd = Buffer.alloc(22);
+  eocd.writeUInt32LE(EOCD_SIGNATURE, 0);
+  eocd.writeUInt16LE(entriesSpec.length, 8);
+  eocd.writeUInt16LE(entriesSpec.length, 10);
+  eocd.writeUInt32LE(centralDirBuf.length, 12);
+  eocd.writeUInt32LE(localOffset, 16);
+
+  return Buffer.concat([...localChunks, centralDirBuf, eocd]);
+}
+
+module.exports = {
+  inspectZipArchiveSafety,
+  buildSyntheticZipCentralDirBuffer
+};
diff --git a/desktop/windows/ci/clipboard-and-drop-guard.cjs b/desktop/windows/ci/clipboard-and-drop-guard.cjs
new file mode 100644
index 0000000..3f85e65
--- /dev/null
+++ b/desktop/windows/ci/clipboard-and-drop-guard.cjs
@@ -0,0 +1,175 @@
+"use strict";
+/**
+ * Kosmora / Koswork Windows Clipboard Pastejacking & Drag-and-Drop Sandbox Guard (Wave 23)
+ *
+ * Protects autonomous desktop & browser automation against:
+ * 1. Terminal Pastejacking: ANSI escape sequences (`\x1b[...`), hidden carriage returns (`\r`),
+ *    bracketed paste breakouts (`\x1b[201~`), and background shell execution payloads (`curl ... | sh`,
+ *    `powershell -enc ...`, `cmd /c ...`) hidden in copied web text.
+ * 2. Dangerous Drag-and-Drop / File Upload Payloads:
+ *    - Windows executable/script extensions (`.exe`, `.bat`, `.cmd`, `.ps1`, `.vbs`, `.hta`, `.lnk`, `.scr`, `.msi`, `.dll`)
+ *    - NTFS Alternate Data Streams (`report.docx:zone.identifier` or `invoice.pdf:evil.exe`)
+ *    - UNC network SMB paths (`\\attacker.com\share\file`) and device paths (`\\.\PhysicalDrive0`)
+ */
+
+const path = require("node:path");
+
+const FORBIDDEN_DROP_EXTENSIONS = new Set([
+  ".exe",
+  ".bat",
+  ".cmd",
+  ".ps1",
+  ".vbs",
+  ".vbe",
+  ".js",
+  ".jse",
+  ".wsf",
+  ".wsh",
+  ".hta",
+  ".scr",
+  ".pif",
+  ".msi",
+  ".msp",
+  ".com",
+  ".dll",
+  ".sys",
+  ".lnk",
+  ".reg",
+  ".cpl"
+]);
+
+const ANSI_ESCAPE_REGEX = /[\u001b\u009b][[()#;?]*(?:[0-9]{1,4}(?:;[0-9]{0,4})*)?[0-9A-ORZcf-nqry=><~]/g;
+const SHELL_PASTEJACK_REGEX = /\b(?:powershell(?:\.exe)?\s+-(?:e|enc|encodedcommand|w\s+hidden)|cmd(?:\.exe)?\s+\/c|curl\s+[^\n|]+\|\s*(?:ba)?sh|wget\s+[^\n|]+\|\s*(?:ba)?sh|certutil\s+-urlcache|mshta(?:\.exe)?\b|rundll32(?:\.exe)?\b)/i;
+
+/**
+ * Inspects and sanitizes clipboard text before pasting into a target application.
+ */
+function inspectAndSanitizeClipboard(rawClipboard, options = {}) {
+  const raw = String(rawClipboard ?? "");
+  const targetContext = String(options.targetContext || "editor").toLowerCase();
+  const threats = [];
+
+  // 1. Check ANSI escape sequences / bracketed paste breakouts
+  if (ANSI_ESCAPE_REGEX.test(raw)) {
+    threats.push({
+      code: "CLIPBOARD_ANSI_ESCAPE_INJECTION",
+      severity: "critical",
+      message: "ANSI terminal control sequences detected in clipboard payload."
+    });
+  }
+
+  // 2. Check hidden shell execution pastejacking
+  if (SHELL_PASTEJACK_REGEX.test(raw)) {
+    threats.push({
+      code: "CLIPBOARD_SHELL_PASTEJACKING",
+      severity: "critical",
+      message: "Executable shell/PowerShell command injection detected in clipboard."
+    });
+  }
+
+  // 3. Check multi-line newline auto-execution when pasting into a terminal/shell
+  const hasNewline = /[\r\n]/.test(raw);
+  if (targetContext === "terminal" && hasNewline) {
+    threats.push({
+      code: "CLIPBOARD_TERMINAL_AUTOEXEC_NEWLINE",
+      severity: "high",
+      message: "Multi-line paste into terminal would auto-execute embedded commands before user review."
+    });
+  }
+
+  // Sanitize text: strip ANSI escapes, null bytes, and normalize line endings
+  let sanitized = raw
+    .replace(ANSI_ESCAPE_REGEX, "")
+    .replace(/\0/g, "");
+
+  if (targetContext === "terminal") {
+    sanitized = sanitized.replace(/[\r\n]+/g, " ").trim();
+  }
+
+  const criticalOrHigh = threats.some(
+    (t) => t.severity === "critical" || (targetContext === "terminal" && t.severity === "high")
+  );
+
+  return {
+    allowed: !criticalOrHigh,
+    threats,
+    sanitizedText: sanitized
+  };
+}
+
+/**
+ * Validates a list of file paths before allowing a drag-and-drop or file-chooser upload action.
+ */
+function verifyDragAndDropFiles(filePaths, options = {}) {
+  const list = Array.isArray(filePaths) ? filePaths : [];
+  const allowedWorkspaceRoot = options.allowedWorkspaceRoot
+    ? path.resolve(options.allowedWorkspaceRoot)
+    : null;
+
+  const violations = [];
+  const approvedFiles = [];
+
+  for (const rawPath of list) {
+    const strPath = String(rawPath ?? "").trim();
+
+    // 1. Check UNC / SMB network paths or Win32 device namespaces (`\\server\share`, `\\.\`, `\\?\`)
+    if (/^\\\\/.test(strPath) || /^\/\//.test(strPath)) {
+      violations.push({
+        file: strPath,
+        code: "DROP_UNC_OR_DEVICE_PATH_FORBIDDEN",
+        message: "UNC network shares and Win32 device paths are forbidden in drag-and-drop."
+      });
+      continue;
+    }
+
+    // 2. Check NTFS Alternate Data Streams (colon after drive letter `C:\...`)
+    const withoutDrive = strPath.replace(/^[A-Za-z]:/, "");
+    if (withoutDrive.includes(":")) {
+      violations.push({
+        file: strPath,
+        code: "DROP_NTFS_ADS_FORBIDDEN",
+        message: "NTFS Alternate Data Stream (ADS) syntax detected in file path."
+      });
+      continue;
+    }
+
+    // 3. Check forbidden executable / script extensions
+    const ext = path.extname(strPath).toLowerCase();
+    if (FORBIDDEN_DROP_EXTENSIONS.has(ext)) {
+      violations.push({
+        file: strPath,
+        code: "DROP_EXECUTABLE_EXTENSION_FORBIDDEN",
+        message: `Executable or script extension '${ext}' is blocked from drag-and-drop.`
+      });
+      continue;
+    }
+
+    // 4. Optional workspace boundary check
+    if (allowedWorkspaceRoot) {
+      const resolved = path.resolve(strPath);
+      const rel = path.relative(allowedWorkspaceRoot, resolved);
+      if (rel.startsWith("..") || path.isAbsolute(rel)) {
+        violations.push({
+          file: strPath,
+          code: "DROP_OUTSIDE_WORKSPACE_ROOT",
+          message: "File resides outside the authorized Koswork workspace folder."
+        });
+        continue;
+      }
+    }
+
+    approvedFiles.push(strPath);
+  }
+
+  return {
+    allowed: violations.length === 0 && approvedFiles.length > 0,
+    approvedFiles,
+    violations
+  };
+}
+
+module.exports = {
+  FORBIDDEN_DROP_EXTENSIONS,
+  inspectAndSanitizeClipboard,
+  verifyDragAndDropFiles
+};
diff --git a/desktop/windows/ci/computer-hazard-and-focus-guard.cjs b/desktop/windows/ci/computer-hazard-and-focus-guard.cjs
new file mode 100644
index 0000000..542b5be
--- /dev/null
+++ b/desktop/windows/ci/computer-hazard-and-focus-guard.cjs
@@ -0,0 +1,207 @@
+"use strict";
+
+const crypto = require("node:crypto");
+
+/**
+ * Multi-Layer Dangerous Action Classifier, Foreground Window Focus-Loss Guard,
+ * and Interrupted Task Consent Checkpoint for Koswork Windows Computer Control
+ * (addresses the remaining items in PR #411 `KOSWORK_COMPUTER_CONTROL_2026-10-29_RU.md`
+ * and PR #412 `KOSWORK_COMPUTER_RECOVERY_2026-10-29_RU.md`).
+ */
+
+const BLOCKED_SHORTCUTS = new Set([
+  "alt+f4",
+  "ctrl+alt+delete",
+  "ctrl+alt+del",
+  "win+r",
+  "meta+r",
+  "win+x",
+  "ctrl+shift+escape",
+  "ctrl+shift+esc",
+  "alt+space+c"
+]);
+
+const STRICTLY_BLOCKED_PATTERNS = [
+  /(?:^|[^\p{L}\p{N}_])(?:format-volume|diskpart|cipher\s+\/w|bcdedit|vssadmin\s+delete\s+shadows|reg\s+delete|netsh\s+advfirewall|sc\s+delete|rm\s+-rf|del\s+\/[fqs])/iu,
+  /\.(?:exe|msi|bat|cmd|ps1|vbs|scr|reg|pfx|p12)(?=[^\p{L}\p{N}_]|$)/iu,
+  /(?:^|[^\p{L}\p{N}_])(?:формулировать\s+диск|форматировать|удалить\s+раздел|сбросить\s+windows|отключить\s+брандмауэр)/iu
+];
+
+const STEP_UP_CONSENT_PATTERNS = [
+  /(?:^|[^\p{L}\p{N}_])(?:оплатить|отправить\s+перевод|подтвердить\s+платёж|удалить\s+аккаунт|отправить\s+сообщение|опубликовать|submit\s+payment|checkout|pay\s+now|delete\s+account|send\s+message|wire\s+transfer)/iu
+];
+
+function normalizeShortcut(keys) {
+  if (!Array.isArray(keys)) return String(keys || "").toLowerCase().replace(/\s+/g, "");
+  return keys
+    .map((k) => String(k).trim().toLowerCase())
+    .filter(Boolean)
+    .join("+");
+}
+
+function classifyComputerActionHazard(action) {
+  const kind = String(action?.kind || "unknown").toLowerCase();
+  const targetLabel = String(action?.targetLabel || action?.selector || "");
+  const textPayload = String(action?.text || action?.command || "");
+  const urlPayload = String(action?.url || "");
+  const combined = `${targetLabel} ${textPayload} ${urlPayload}`.normalize("NFKC");
+
+  if (kind === "hotkey" || kind === "shortcut" || action?.keys) {
+    const combo = normalizeShortcut(action.keys || action.shortcut);
+    if (BLOCKED_SHORTCUTS.has(combo)) {
+      return {
+        tier: "strictly_blocked",
+        code: "BLOCKED_SYSTEM_SHORTCUT",
+        reason: `Системная комбинация клавиш "${combo}" заблокирована политикой безопасности Koswork.`
+      };
+    }
+  }
+
+  for (const re of STRICTLY_BLOCKED_PATTERNS) {
+    if (re.test(combined)) {
+      return {
+        tier: "strictly_blocked",
+        code: "BLOCKED_DESTRUCTIVE_OR_EXECUTABLE_ACTION",
+        reason: "Действие затрагивает системные утилиты, исполняемые установщики или разрушающие операции ОС."
+      };
+    }
+  }
+
+  for (const re of STEP_UP_CONSENT_PATTERNS) {
+    if (re.test(combined)) {
+      return {
+        tier: "requires_step_up_consent",
+        code: "STEP_UP_CONSENT_REQUIRED",
+        reason: "Действие связано с отправкой сообщений, публикацией или финансовой операцией и требует явного подтверждения владельца."
+      };
+    }
+  }
+
+  return {
+    tier: "safe",
+    code: "ALLOWED",
+    reason: null
+  };
+}
+
+/**
+ * Verifies that the OS foreground window matches the consented target application/window
+ * before any click or keystroke is dispatched. Immediately halts with `FOCUS_LOST_OR_STOLEN`
+ * if focus shifted away (as required by PR #411 / #412).
+ */
+function verifyForegroundWindowFocus(expectedTarget, actualForeground) {
+  if (!actualForeground || !actualForeground.hwnd || actualForeground.minimized) {
+    return {
+      ok: false,
+      code: "FOCUS_LOST_OR_MINIMIZED",
+      reason: "Целевое окно свернуто или потеряло фокус ввода Windows."
+    };
+  }
+
+  if (
+    expectedTarget.hwnd &&
+    String(expectedTarget.hwnd) !== String(actualForeground.hwnd)
+  ) {
+    return {
+      ok: false,
+      code: "FOCUS_STOLEN_BY_OTHER_WINDOW",
+      reason: `Фокус перехвачен другим окном (ожидался HWND ${expectedTarget.hwnd}, активен ${actualForeground.hwnd}).`
+    };
+  }
+
+  if (
+    expectedTarget.processName &&
+    String(expectedTarget.processName).toLowerCase() !==
+      String(actualForeground.processName || "").toLowerCase()
+  ) {
+    return {
+      ok: false,
+      code: "FOCUS_PROCESS_MISMATCH",
+      reason: `Активный процесс "${actualForeground.processName}" не совпадает с разрешённым "${expectedTarget.processName}".`
+    };
+  }
+
+  return {
+    ok: true,
+    code: "FOCUS_VERIFIED",
+    reason: null
+  };
+}
+
+/**
+ * Creates a tamper-evident recovery checkpoint when a computer control task is interrupted
+ * (by focus loss, step-up consent prompt, or crash) and requires a fresh consent token
+ * with a newer timestamp before resuming (PR #412).
+ */
+class ComputerTaskRecoveryGuard {
+  constructor() {
+    this.checkpoints = new Map();
+  }
+
+  suspendTaskOnInterruption(input) {
+    const taskId = String(input.taskId);
+    const interruptedAt = input.interruptedAt || new Date().toISOString();
+    const stateDigest = crypto
+      .createHash("sha256")
+      .update(
+        JSON.stringify({
+          taskId,
+          stepIndex: input.stepIndex,
+          reasonCode: input.reasonCode,
+          interruptedAt
+        }),
+        "utf8"
+      )
+      .digest("hex");
+
+    const checkpoint = {
+      taskId,
+      ownerId: String(input.ownerId),
+      stepIndex: Number(input.stepIndex ?? 0),
+      reasonCode: String(input.reasonCode || "FOCUS_LOST"),
+      interruptedAt,
+      previousConsentId: String(input.previousConsentId || ""),
+      stateDigest,
+      status: "suspended_awaiting_fresh_consent"
+    };
+
+    this.checkpoints.set(taskId, checkpoint);
+    return checkpoint;
+  }
+
+  resumeWithFreshConsent(input) {
+    const checkpoint = this.checkpoints.get(String(input.taskId));
+    if (!checkpoint) {
+      throw new Error("RECOVERY_CHECKPOINT_NOT_FOUND");
+    }
+    if (checkpoint.ownerId !== String(input.ownerId)) {
+      throw new Error("RECOVERY_OWNER_MISMATCH");
+    }
+    if (checkpoint.stateDigest !== String(input.expectedStateDigest)) {
+      throw new Error("RECOVERY_STATE_DIGEST_MISMATCH");
+    }
+    if (
+      !input.freshConsentId ||
+      String(input.freshConsentId) === checkpoint.previousConsentId
+    ) {
+      throw new Error("STALE_CONSENT_REJECTED_FRESH_CONSENT_REQUIRED");
+    }
+    if (
+      !input.consentedAt ||
+      String(input.consentedAt) <= checkpoint.interruptedAt
+    ) {
+      throw new Error("CONSENT_TIMESTAMP_MUST_FOLLOW_INTERRUPTION");
+    }
+
+    checkpoint.status = "resumed";
+    checkpoint.resumedWithConsentId = String(input.freshConsentId);
+    checkpoint.resumedAt = String(input.consentedAt);
+    return checkpoint;
+  }
+}
+
+module.exports = {
+  ComputerTaskRecoveryGuard,
+  classifyComputerActionHazard,
+  verifyForegroundWindowFocus
+};
diff --git a/desktop/windows/ci/desktop-runtime-watchdog.cjs b/desktop/windows/ci/desktop-runtime-watchdog.cjs
new file mode 100644
index 0000000..84d769f
--- /dev/null
+++ b/desktop/windows/ci/desktop-runtime-watchdog.cjs
@@ -0,0 +1,142 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const { assertNotReparseOrSymlink } = require("../workspace/path-guard.cjs");
+
+const MAX_TOTAL_VIEWS_RAM_MB = 512;
+
+/**
+ * Desktop Runtime Security Watchdog for Koswork Windows client.
+ *
+ * Invariant Guards:
+ * 1. Monitors aggregate RAM across loaded WebContentsViews and auto-evicts tabs if > 512 MB.
+ * 2. Continuously audits connected workspace folders to detect unauthorized symlink or junction swaps.
+ * 3. Intercepts session lock / desktop focus loss and suspends active tasks into recovery checkpoints.
+ */
+class DesktopRuntimeWatchdog {
+  constructor(options = {}) {
+    this.workspaceRoot = options.workspaceRoot ? path.resolve(options.workspaceRoot) : null;
+    this.maxTotalRamMb = options.maxTotalRamMb ?? MAX_TOTAL_VIEWS_RAM_MB;
+    this.sessionLocked = false;
+    this.activeTaskRecoveryGuard = options.recoveryGuard ?? null;
+    this.activeViews = new Map();
+    this.securityViolations = [];
+  }
+
+  updateViewMetrics(tabId, metrics) {
+    this.activeViews.set(String(tabId), {
+      tabId: String(tabId),
+      ramMb: Number(metrics.ramMb ?? 0),
+      lastActiveAt: Number(metrics.lastActiveAt ?? Date.now())
+    });
+
+    let totalRam = 0;
+    for (const v of this.activeViews.values()) {
+      totalRam += v.ramMb;
+    }
+
+    const evictedTabIds = [];
+    if (totalRam > this.maxTotalRamMb && this.activeViews.size > 1) {
+      // Evict oldest view to bring RAM under ceiling
+      let oldestTab = null;
+      let oldestTime = Infinity;
+      for (const [id, v] of this.activeViews.entries()) {
+        if (v.lastActiveAt < oldestTime) {
+          oldestTime = v.lastActiveAt;
+          oldestTab = id;
+        }
+      }
+      if (oldestTab) {
+        this.activeViews.delete(oldestTab);
+        evictedTabIds.push(oldestTab);
+      }
+    }
+
+    return {
+      activeViewsCount: this.activeViews.size,
+      totalRamMb: Number(totalRam.toFixed(2)),
+      overQuota: totalRam > this.maxTotalRamMb,
+      evictedTabIds
+    };
+  }
+
+  /**
+   * Scans workspace root and verified files to guarantee no symlinks, junctions,
+   * or reparse points were substituted while the task was running.
+   */
+  auditWorkspaceFolderIntegrity(filesToCheck = []) {
+    if (!this.workspaceRoot) return { ok: true, checkedCount: 0 };
+    if (!fs.existsSync(this.workspaceRoot)) {
+      const err = new Error("WATCHDOG_WORKSPACE_DISCONNECTED");
+      err.code = "WATCHDOG_WORKSPACE_DISCONNECTED";
+      this.securityViolations.push({ code: err.code, at: new Date().toISOString() });
+      throw err;
+    }
+
+    const rootLstat = fs.lstatSync(this.workspaceRoot);
+    assertNotReparseOrSymlink(this.workspaceRoot, rootLstat);
+
+    let checkedCount = 0;
+    for (const relFile of filesToCheck) {
+      const fullPath = path.join(this.workspaceRoot, relFile);
+      if (fs.existsSync(fullPath)) {
+        const fileLstat = fs.lstatSync(fullPath);
+        assertNotReparseOrSymlink(fullPath, fileLstat);
+        checkedCount++;
+      }
+    }
+
+    return { ok: true, checkedCount };
+  }
+
+  /**
+   * Simulates/intercepts a Windows Session Lock event (e.g., Win+L, screensaver, RDP disconnect).
+   * Automatically suspends any active computer control task into an immutable checkpoint.
+   */
+  handleWindowsSessionLockEvent(activeTaskId, ownerId) {
+    this.sessionLocked = true;
+    let checkpoint = null;
+    if (this.activeTaskRecoveryGuard && activeTaskId) {
+      checkpoint = this.activeTaskRecoveryGuard.suspendTaskOnInterruption({
+        taskId: activeTaskId,
+        ownerId: ownerId || "local-owner",
+        reasonCode: "WINDOWS_SESSION_LOCKED",
+        interruptedAt: new Date().toISOString()
+      });
+    }
+
+    return {
+      sessionLocked: true,
+      checkpointCreated: Boolean(checkpoint),
+      checkpoint
+    };
+  }
+
+  handleWindowsSessionUnlockEvent() {
+    this.sessionLocked = false;
+    return { sessionLocked: false };
+  }
+
+  getWatchdogHealthStatus() {
+    let totalRam = 0;
+    for (const v of this.activeViews.values()) {
+      totalRam += v.ramMb;
+    }
+
+    return {
+      status: this.securityViolations.length === 0 ? "healthy" : "violation_detected",
+      sessionLocked: this.sessionLocked,
+      activeViewsCount: this.activeViews.size,
+      totalRamMb: Number(totalRam.toFixed(2)),
+      maxAllowedRamMb: this.maxTotalRamMb,
+      securityViolationsCount: this.securityViolations.length,
+      violations: this.securityViolations
+    };
+  }
+}
+
+module.exports = {
+  DesktopRuntimeWatchdog,
+  MAX_TOTAL_VIEWS_RAM_MB
+};
diff --git a/desktop/windows/ci/dpi-coordinate-calibrator.cjs b/desktop/windows/ci/dpi-coordinate-calibrator.cjs
new file mode 100644
index 0000000..b5afbd4
--- /dev/null
+++ b/desktop/windows/ci/dpi-coordinate-calibrator.cjs
@@ -0,0 +1,160 @@
+"use strict";
+/**
+ * Kosmora / Koswork Multi-Monitor DPI-Aware Coordinate Calibrator & Set-of-Mark (SoM) Mapper (Wave 22)
+ *
+ * Solves Windows multi-monitor Per-Monitor V2 DPI scaling discrepancies (100%, 125%, 150%, 175%, 200%)
+ * and negative secondary monitor origins during autonomous desktop/browser actuation:
+ * 1. Translates normalized `[0..1000, 0..1000]` LLM vision coordinates into exact physical Win32
+ *    screen pixels (`physicalX`, `physicalY`) and logical DIP coordinates (`dipX`, `dipY`).
+ * 2. Builds Set-of-Mark (SoM) numeric bounding-box registries (`#1`, `#2`, ...) with hit-target
+ *    clamping so clicks never land on window borders or outside the active monitor viewport.
+ */
+
+function clamp(val, min, max) {
+  return Math.max(min, Math.min(max, val));
+}
+
+/**
+ * Normalizes a Windows display descriptor.
+ * @param {object} display
+ */
+function normalizeDisplayDescriptor(display) {
+  const scaleFactor = Number(display?.scaleFactor) > 0 ? Number(display.scaleFactor) : 1.0;
+  const dipBounds = display?.dipBounds || { x: 0, y: 0, width: 1920, height: 1080 };
+  const physicalBounds = display?.physicalBounds || {
+    x: Math.round(dipBounds.x * scaleFactor),
+    y: Math.round(dipBounds.y * scaleFactor),
+    width: Math.round(dipBounds.width * scaleFactor),
+    height: Math.round(dipBounds.height * scaleFactor)
+  };
+
+  return {
+    id: String(display?.id || "display-primary"),
+    scaleFactor,
+    dipBounds,
+    physicalBounds
+  };
+}
+
+/**
+ * Translates normalized `[0..1000]` vision model coordinates into exact logical DIP
+ * and physical screen pixel coordinates on the target monitor.
+ */
+function mapNormalizedVisionToScreen(normX, normY, displayRaw) {
+  const display = normalizeDisplayDescriptor(displayRaw);
+  const clampedNormX = clamp(Number(normX) || 0, 0, 1000);
+  const clampedNormY = clamp(Number(normY) || 0, 0, 1000);
+
+  const ratioX = clampedNormX / 1000;
+  const ratioY = clampedNormY / 1000;
+
+  // Compute safe interior coordinates (inset by 2px from monitor edges)
+  const dipX = Math.round(
+    display.dipBounds.x + clamp(ratioX * display.dipBounds.width, 2, display.dipBounds.width - 2)
+  );
+  const dipY = Math.round(
+    display.dipBounds.y + clamp(ratioY * display.dipBounds.height, 2, display.dipBounds.height - 2)
+  );
+
+  const physicalX = Math.round(
+    display.physicalBounds.x +
+      clamp(ratioX * display.physicalBounds.width, 2, display.physicalBounds.width - 2)
+  );
+  const physicalY = Math.round(
+    display.physicalBounds.y +
+      clamp(ratioY * display.physicalBounds.height, 2, display.physicalBounds.height - 2)
+  );
+
+  return {
+    displayId: display.id,
+    scaleFactor: display.scaleFactor,
+    normalized: { x: clampedNormX, y: clampedNormY },
+    dip: { x: dipX, y: dipY },
+    physical: { x: physicalX, y: physicalY }
+  };
+}
+
+/**
+ * Builds a Set-of-Mark (SoM) visual grounding catalog from interactive UI elements
+ * and resolves safe click coordinates for any mark ID (`#1`, `#2`, ...).
+ */
+class SetOfMarkCoordinateCatalog {
+  constructor(displayRaw) {
+    this.display = normalizeDisplayDescriptor(displayRaw);
+    this.marks = new Map();
+  }
+
+  /**
+   * Registers interactive elements and assigns sequential `[#1..#N]` Set-of-Mark tags.
+   * @param {Array<{ id: string, label?: string, role?: string, dipBbox: { x: number, y: number, width: number, height: number } }>} elements
+   */
+  buildCatalog(elements) {
+    this.marks.clear();
+    const list = Array.isArray(elements) ? elements : [];
+    const catalog = [];
+
+    for (let i = 0; i < list.length; i++) {
+      const el = list[i];
+      if (!el || !el.dipBbox) continue;
+      const markId = i + 1;
+      const b = el.dipBbox;
+
+      const centerDipX = Math.round(b.x + b.width / 2);
+      const centerDipY = Math.round(b.y + b.height / 2);
+
+      // Clamp to display DIP bounds
+      const safeDipX = clamp(
+        centerDipX,
+        this.display.dipBounds.x + 2,
+        this.display.dipBounds.x + this.display.dipBounds.width - 2
+      );
+      const safeDipY = clamp(
+        centerDipY,
+        this.display.dipBounds.y + 2,
+        this.display.dipBounds.y + this.display.dipBounds.height - 2
+      );
+
+      // Convert relative offset from display DIP origin into physical pixels
+      const relDipX = safeDipX - this.display.dipBounds.x;
+      const relDipY = safeDipY - this.display.dipBounds.y;
+
+      const physicalX = Math.round(
+        this.display.physicalBounds.x + relDipX * this.display.scaleFactor
+      );
+      const physicalY = Math.round(
+        this.display.physicalBounds.y + relDipY * this.display.scaleFactor
+      );
+
+      const entry = {
+        markId,
+        tag: `#${markId}`,
+        elementId: String(el.id || `el-${markId}`),
+        label: String(el.label || ""),
+        role: String(el.role || "button"),
+        dipBbox: b,
+        safeClickDip: { x: safeDipX, y: safeDipY },
+        safeClickPhysical: { x: physicalX, y: physicalY }
+      };
+
+      this.marks.set(markId, entry);
+      catalog.push(entry);
+    }
+
+    return catalog;
+  }
+
+  resolveMarkTarget(markIdOrTag) {
+    const num =
+      typeof markIdOrTag === "number"
+        ? markIdOrTag
+        : Number.parseInt(String(markIdOrTag).replace(/^#/, ""), 10);
+
+    return this.marks.get(num) || null;
+  }
+}
+
+module.exports = {
+  normalizeDisplayDescriptor,
+  mapNormalizedVisionToScreen,
+  SetOfMarkCoordinateCatalog
+};
diff --git a/desktop/windows/ci/stage2-desktop-ipc-bridge.cjs b/desktop/windows/ci/stage2-desktop-ipc-bridge.cjs
new file mode 100644
index 0000000..71dbcda
--- /dev/null
+++ b/desktop/windows/ci/stage2-desktop-ipc-bridge.cjs
@@ -0,0 +1,143 @@
+"use strict";
+
+const { extractVaultDocument, readAddressableVaultSlice } = require("../vault-document-extractor.cjs");
+const { VaultVirtualBridge } = require("../vault-virtual-bridge.cjs");
+const { collectPiercedInteractiveSnapshot } = require("../browser/shadow-and-frame-piercer.cjs");
+const { KosworkSearchAndBrowserStore } = require("../browser/search-pagination-and-bookmarks.cjs");
+const {
+  ComputerTaskRecoveryGuard,
+  classifyComputerActionHazard,
+  verifyForegroundWindowFocus
+} = require("./computer-hazard-and-focus-guard.cjs");
+const { KosworkUnifiedTaskCoordinator } = require("./unified-task-coordinator.cjs");
+
+/**
+ * Origin-Checked Electron Main Process IPC Router for all Koswork Stage-2 Desktop Capabilities.
+ *
+ * Security Invariants:
+ * 1. Rejects any IPC invocation from an untrusted remote web page (`http:`/`https:` third-party origin
+ *    inside the agent browser view) with `UNTRUSTED_IPC_SENDER_ORIGIN`.
+ * 2. Requires either the local desktop shell origin (`file://`) or an explicitly allowlisted
+ *    authenticated first-party Kosmora origin with a valid owner session token.
+ */
+class Stage2DesktopIpcBridge {
+  constructor(options = {}) {
+    this.allowedOrigins = new Set([
+      "file://",
+      ...(Array.isArray(options.allowedOrigins) ? options.allowedOrigins : ["http://127.0.0.1:3300"])
+    ]);
+    this.activeOwnerId = options.activeOwnerId || "local-owner";
+    this.vaultBridge = options.vaultBridge || new VaultVirtualBridge();
+    this.browserStore = options.browserStore || new KosworkSearchAndBrowserStore();
+    this.recoveryGuard = options.recoveryGuard || new ComputerTaskRecoveryGuard();
+    this.workspaceRoot = options.workspaceRoot || null;
+    this.handlers = new Map();
+    this.registerDefaultHandlers();
+  }
+
+  verifySenderEvent(event) {
+    const senderUrl = String(event?.senderFrame?.url || event?.sender?.getURL?.() || "");
+    if (!senderUrl) {
+      const err = new Error("UNTRUSTED_IPC_SENDER_ORIGIN: Missing sender URL");
+      err.code = "UNTRUSTED_IPC_SENDER_ORIGIN";
+      throw err;
+    }
+
+    if (senderUrl.startsWith("file://")) {
+      return { trusted: true, origin: "file://" };
+    }
+
+    let parsedOrigin = "";
+    try {
+      parsedOrigin = new URL(senderUrl).origin;
+    } catch {
+      const err = new Error(`UNTRUSTED_IPC_SENDER_ORIGIN: Malformed URL "${senderUrl}"`);
+      err.code = "UNTRUSTED_IPC_SENDER_ORIGIN";
+      throw err;
+    }
+
+    if (!this.allowedOrigins.has(parsedOrigin)) {
+      const err = new Error(
+        `UNTRUSTED_IPC_SENDER_ORIGIN: Origin "${parsedOrigin}" is not permitted to invoke Koswork native IPC`
+      );
+      err.code = "UNTRUSTED_IPC_SENDER_ORIGIN";
+      throw err;
+    }
+
+    if (event?.ownerId && String(event.ownerId) !== this.activeOwnerId) {
+      const err = new Error("IPC_OWNER_SESSION_MISMATCH");
+      err.code = "IPC_OWNER_SESSION_MISMATCH";
+      throw err;
+    }
+
+    return { trusted: true, origin: parsedOrigin };
+  }
+
+  registerHandler(channel, fn) {
+    this.handlers.set(channel, async (event, payload) => {
+      this.verifySenderEvent(event);
+      return await fn(payload || {}, event);
+    });
+  }
+
+  registerDefaultHandlers() {
+    this.registerHandler("koswork:vault:extract-doc", (payload) => {
+      const doc = extractVaultDocument(payload.buffer, {
+        filename: payload.filename,
+        sliceMaxChars: payload.sliceMaxChars
+      });
+      if (payload.chunkIndex !== undefined) {
+        return readAddressableVaultSlice(doc, { chunkIndex: payload.chunkIndex });
+      }
+      return doc;
+    });
+
+    this.registerHandler("koswork:vault:read-virtual-uri", (payload) => {
+      return this.vaultBridge.readVirtualUri(payload.taskId, payload.uri, {
+        maxUnits: payload.maxUnits,
+        nowMs: payload.nowMs
+      });
+    });
+
+    this.registerHandler("koswork:browser:pierce-dom", (payload) => {
+      return collectPiercedInteractiveSnapshot(payload.rootNode, {
+        baseOrigin: payload.baseOrigin,
+        maxDepth: payload.maxDepth
+      });
+    });
+
+    this.registerHandler("koswork:browser:search-paginate", (payload) => {
+      return this.browserStore.recordAndPaginateSearch(payload);
+    });
+
+    this.registerHandler("koswork:computer:check-hazard", (payload) => {
+      return classifyComputerActionHazard(payload.action);
+    });
+
+    this.registerHandler("koswork:computer:verify-focus", (payload) => {
+      return verifyForegroundWindowFocus(payload.expectedTarget, payload.actualForeground);
+    });
+
+    this.registerHandler("koswork:unified:run-task", (payload) => {
+      const coordinator = new KosworkUnifiedTaskCoordinator({
+        workspaceRoot: payload.workspaceRoot || this.workspaceRoot,
+        browserStore: this.browserStore
+      });
+      return coordinator.executeUnifiedResearchAndReportTask(payload.plan);
+    });
+  }
+
+  async invoke(channel, event, payload) {
+    const handler = this.handlers.get(channel);
+    if (!handler) {
+      const err = new Error(`UNKNOWN_IPC_CHANNEL: ${channel}`);
+      err.code = "UNKNOWN_IPC_CHANNEL";
+      throw err;
+    }
+    return await handler(event, payload);
+  }
+}
+
+module.exports = {
+  Stage2DesktopIpcBridge
+};
diff --git a/desktop/windows/ci/unified-task-coordinator.cjs b/desktop/windows/ci/unified-task-coordinator.cjs
new file mode 100644
index 0000000..6ee71a2
--- /dev/null
+++ b/desktop/windows/ci/unified-task-coordinator.cjs
@@ -0,0 +1,179 @@
+"use strict";
+
+const crypto = require("node:crypto");
+const {
+  KosworkSearchAndBrowserStore
+} = require("../browser/search-pagination-and-bookmarks.cjs");
+const {
+  classifyComputerActionHazard,
+  verifyForegroundWindowFocus
+} = require("./computer-hazard-and-focus-guard.cjs");
+const { saveWordReportToWorkspace } = require("../workspace/word-report-builder.cjs");
+const { extractVaultDocument } = require("../vault-document-extractor.cjs");
+
+/**
+ * Unified Multi-Domain Task Coordinator across Browser, Workspace/Vault Files, and Desktop Apps
+ * (completes the end-to-end acceptance pipeline of PR #416 `KOSWORK_UNIFIED_TASK_2026-10-29_RU.md`:
+ * "поиск источников -> проверка безопасности и фокуса -> создание отчёта Word (.docx) -> сохранение в рабочую папку"
+ * with a tamper-evident hash-chained action history).
+ */
+class KosworkUnifiedTaskCoordinator {
+  constructor(options = {}) {
+    this.workspaceRoot = options.workspaceRoot;
+    this.browserStore = options.browserStore || new KosworkSearchAndBrowserStore();
+    this.actionHistory = [];
+  }
+
+  appendHistoryEntry(step) {
+    const prevHash =
+      this.actionHistory.length > 0
+        ? this.actionHistory[this.actionHistory.length - 1].entryHash
+        : "0".repeat(64);
+
+    const payload = {
+      index: this.actionHistory.length + 1,
+      domain: step.domain,
+      action: step.action,
+      status: step.status,
+      detailHash: crypto
+        .createHash("sha256")
+        .update(JSON.stringify(step.details || {}), "utf8")
+        .digest("hex"),
+      prevHash,
+      recordedAt: new Date().toISOString()
+    };
+
+    const entryHash = crypto
+      .createHash("sha256")
+      .update(JSON.stringify(payload), "utf8")
+      .digest("hex");
+
+    const record = { ...payload, entryHash };
+    this.actionHistory.push(record);
+    return record;
+  }
+
+  /**
+   * Executes a planned multi-domain task across:
+   * 1. Browser search (`browser_search`)
+   * 2. Optional desktop window verification (`app_focus_check`)
+   * 3. Word `.docx` report creation (`workspace_write_docx`) and extraction verification
+   */
+  executeUnifiedResearchAndReportTask(plan) {
+    if (!this.workspaceRoot) {
+      throw new Error("UNIFIED_TASK_WORKSPACE_NOT_CONNECTED");
+    }
+
+    // 1. Browser domain: execute first-party search and paginate top sources
+    const searchPage = this.browserStore.recordAndPaginateSearch({
+      query: plan.searchQuery,
+      results: plan.mockOrLiveSearchResults || [],
+      page: 1,
+      pageSize: 5
+    });
+
+    this.appendHistoryEntry({
+      domain: "browser",
+      action: "browser_search",
+      status: "completed",
+      details: {
+        searchId: searchPage.searchId,
+        navigationUrl: searchPage.navigationUrl,
+        resultCount: searchPage.items.length
+      }
+    });
+
+    // 2. Desktop App domain: verify hazard classification and window focus if app interaction is requested
+    if (plan.desktopAction) {
+      const hazard = classifyComputerActionHazard(plan.desktopAction);
+      if (hazard.tier !== "safe") {
+        this.appendHistoryEntry({
+          domain: "desktop_app",
+          action: plan.desktopAction.kind || "app_action",
+          status: "blocked",
+          details: { code: hazard.code }
+        });
+        const err = new Error(`UNIFIED_TASK_DESKTOP_BLOCKED:${hazard.code}`);
+        err.code = hazard.code;
+        throw err;
+      }
+
+      if (plan.expectedWindow && plan.actualForegroundWindow) {
+        const focusCheck = verifyForegroundWindowFocus(
+          plan.expectedWindow,
+          plan.actualForegroundWindow
+        );
+        if (!focusCheck.ok) {
+          this.appendHistoryEntry({
+            domain: "desktop_app",
+            action: "verify_focus",
+            status: "halted",
+            details: { code: focusCheck.code }
+          });
+          const err = new Error(`UNIFIED_TASK_FOCUS_LOST:${focusCheck.code}`);
+          err.code = focusCheck.code;
+          throw err;
+        }
+      }
+
+      this.appendHistoryEntry({
+        domain: "desktop_app",
+        action: plan.desktopAction.kind || "app_action",
+        status: "completed",
+        details: { targetLabel: plan.desktopAction.targetLabel }
+      });
+    }
+
+    // 3. Files / Workspace domain: build and save verified .docx report into bounded workspace folder
+    const sourcesForDocx = searchPage.items.map((item) => ({
+      title: item.title,
+      url: item.url,
+      quote: item.snippet
+    }));
+
+    const savedReport = saveWordReportToWorkspace({
+      workspaceRoot: this.workspaceRoot,
+      relativePath: plan.outputRelativePath || "reports/Unified-Task-Report.docx",
+      reportSpec: {
+        title: plan.reportTitle || `Отчёт по теме: ${plan.searchQuery}`,
+        subtitle: `Источников проверено: ${sourcesForDocx.length}`,
+        sections: plan.reportSections || [
+          {
+            heading: "1. Результаты исследования",
+            paragraphs: sourcesForDocx.map((s) => `${s.title}: ${s.quote}`)
+          }
+        ],
+        sources: sourcesForDocx
+      }
+    });
+
+    const fs = require("node:fs");
+    const verifiedExtract = extractVaultDocument(fs.readFileSync(savedReport.absolutePath), {
+      filename: savedReport.relativePath
+    });
+
+    this.appendHistoryEntry({
+      domain: "workspace_files",
+      action: "save_word_report_docx",
+      status: "completed",
+      details: {
+        relativePath: savedReport.relativePath,
+        sha256: savedReport.sha256,
+        extractedChars: verifiedExtract.totalChars
+      }
+    });
+
+    return {
+      status: "completed",
+      searchPage,
+      savedReport,
+      verifiedExtract,
+      historyChainLength: this.actionHistory.length,
+      headHistoryHash: this.actionHistory[this.actionHistory.length - 1].entryHash
+    };
+  }
+}
+
+module.exports = {
+  KosworkUnifiedTaskCoordinator
+};
diff --git a/desktop/windows/ci/wav-pcm-audio-verifier.cjs b/desktop/windows/ci/wav-pcm-audio-verifier.cjs
new file mode 100644
index 0000000..24182f0
--- /dev/null
+++ b/desktop/windows/ci/wav-pcm-audio-verifier.cjs
@@ -0,0 +1,260 @@
+"use strict";
+
+/**
+ * Zero-dependency RIFF/WAVE PCM 16-bit Audio Synthesizer, Header Parser,
+ * and Acoustic DSP / Voice Activity Verifier for offline desktop STT/TTS pipelines.
+ */
+
+const WAV_HEADER_BYTES = 44;
+
+/**
+ * Synthesizes a valid RIFF/WAVE 16-bit Little-Endian PCM audio buffer.
+ * Supports multi-segment tone/silence programming for testing voice activity detection.
+ *
+ * @param {object} options
+ * @param {number} [options.sampleRate=16000]
+ * @param {number} [options.channels=1]
+ * @param {number} [options.durationMs=500]
+ * @param {number} [options.frequencyHz=440]
+ * @param {number} [options.amplitude=0.7] - Normalized [0.0, 1.0]
+ * @param {Array<{ startMs: number, endMs: number, frequencyHz: number, amplitude: number }>} [options.segments]
+ * @returns {Buffer}
+ */
+function synthesizeWavPcmBuffer(options = {}) {
+  const sampleRate = options.sampleRate || 16000;
+  const channels = options.channels || 1;
+  const durationMs = options.durationMs || 500;
+  const defaultFreq = options.frequencyHz ?? 440;
+  const defaultAmp = options.amplitude ?? 0.7;
+  const segments = Array.isArray(options.segments) ? options.segments : null;
+
+  const bitsPerSample = 16;
+  const bytesPerSample = bitsPerSample / 8;
+  const blockAlign = channels * bytesPerSample;
+  const byteRate = sampleRate * blockAlign;
+  const totalSamplesPerChannel = Math.floor((sampleRate * durationMs) / 1000);
+  const dataByteLength = totalSamplesPerChannel * blockAlign;
+  const buffer = Buffer.alloc(WAV_HEADER_BYTES + dataByteLength);
+
+  // RIFF Chunk Descriptor
+  buffer.write("RIFF", 0, 4, "ascii");
+  buffer.writeUInt32LE(36 + dataByteLength, 4);
+  buffer.write("WAVE", 8, 4, "ascii");
+
+  // fmt Sub-chunk
+  buffer.write("fmt ", 12, 4, "ascii");
+  buffer.writeUInt32LE(16, 16); // Subchunk1Size (16 for PCM)
+  buffer.writeUInt16LE(1, 20); // AudioFormat (1 = Linear PCM)
+  buffer.writeUInt16LE(channels, 22);
+  buffer.writeUInt32LE(sampleRate, 24);
+  buffer.writeUInt32LE(byteRate, 28);
+  buffer.writeUInt16LE(blockAlign, 32);
+  buffer.writeUInt16LE(bitsPerSample, 34);
+
+  // data Sub-chunk
+  buffer.write("data", 36, 4, "ascii");
+  buffer.writeUInt32LE(dataByteLength, 40);
+
+  let offset = WAV_HEADER_BYTES;
+  for (let i = 0; i < totalSamplesPerChannel; i++) {
+    const timeSec = i / sampleRate;
+    const timeMs = timeSec * 1000;
+
+    let freq = defaultFreq;
+    let amp = defaultAmp;
+
+    if (segments) {
+      freq = 0;
+      amp = 0;
+      for (const seg of segments) {
+        if (timeMs >= seg.startMs && timeMs < seg.endMs) {
+          freq = seg.frequencyHz;
+          amp = seg.amplitude;
+          break;
+        }
+      }
+    }
+
+    const rawSample = amp > 0 && freq > 0 ? Math.sin(2 * Math.PI * freq * timeSec) * amp : 0;
+    const clamped = Math.max(-1, Math.min(1, rawSample));
+    const int16Sample = Math.round(clamped * 32767);
+
+    for (let ch = 0; ch < channels; ch++) {
+      buffer.writeInt16LE(int16Sample, offset);
+      offset += 2;
+    }
+  }
+
+  return buffer;
+}
+
+/**
+ * Parses and validates a RIFF/WAVE PCM 16-bit audio buffer and extracts acoustic metrics
+ * and Voice Activity Detection (VAD) active segments.
+ *
+ * @param {Buffer} wavBuffer
+ * @param {object} [options]
+ * @param {number} [options.frameDurationMs=20]
+ * @param {number} [options.vadThresholdDbFs=-40]
+ */
+function analyzeAndVerifyWavPcm(wavBuffer, options = {}) {
+  const errors = [];
+  if (!Buffer.isBuffer(wavBuffer) || wavBuffer.length < WAV_HEADER_BYTES) {
+    return {
+      valid: false,
+      errors: ["WAV_BUFFER_TOO_SHORT: Buffer must be at least 44 bytes"]
+    };
+  }
+
+  const riffMagic = wavBuffer.toString("ascii", 0, 4);
+  const waveMagic = wavBuffer.toString("ascii", 8, 12);
+  const fmtMagic = wavBuffer.toString("ascii", 12, 16);
+  const dataMagic = wavBuffer.toString("ascii", 36, 40);
+
+  if (riffMagic !== "RIFF" || waveMagic !== "WAVE") {
+    errors.push(`INVALID_RIFF_WAVE_SIGNATURE: got ${riffMagic}/${waveMagic}`);
+  }
+  if (fmtMagic !== "fmt ") {
+    errors.push(`INVALID_FMT_CHUNK: got ${fmtMagic}`);
+  }
+  if (dataMagic !== "data") {
+    errors.push(`INVALID_DATA_CHUNK: got ${dataMagic}`);
+  }
+
+  const audioFormat = wavBuffer.readUInt16LE(20);
+  const channels = wavBuffer.readUInt16LE(22);
+  const sampleRate = wavBuffer.readUInt32LE(24);
+  const byteRate = wavBuffer.readUInt32LE(28);
+  const blockAlign = wavBuffer.readUInt16LE(32);
+  const bitsPerSample = wavBuffer.readUInt16LE(34);
+  const declaredDataBytes = wavBuffer.readUInt32LE(40);
+  const actualDataBytes = wavBuffer.length - WAV_HEADER_BYTES;
+
+  if (audioFormat !== 1) {
+    errors.push(`UNSUPPORTED_AUDIO_FORMAT: expected PCM (1), got ${audioFormat}`);
+  }
+  if (bitsPerSample !== 16) {
+    errors.push(`UNSUPPORTED_BITS_PER_SAMPLE: expected 16, got ${bitsPerSample}`);
+  }
+  const expectedBlockAlign = channels * (bitsPerSample / 8);
+  if (blockAlign !== expectedBlockAlign) {
+    errors.push(`BLOCK_ALIGN_MISMATCH: expected ${expectedBlockAlign}, got ${blockAlign}`);
+  }
+  const expectedByteRate = sampleRate * expectedBlockAlign;
+  if (byteRate !== expectedByteRate) {
+    errors.push(`BYTE_RATE_MISMATCH: expected ${expectedByteRate}, got ${byteRate}`);
+  }
+  if (declaredDataBytes > actualDataBytes) {
+    errors.push(
+      `TRUNCATED_PCM_DATA: header declared ${declaredDataBytes} bytes, buffer has ${actualDataBytes}`
+    );
+  }
+
+  if (errors.length > 0) {
+    return {
+      valid: false,
+      errors
+    };
+  }
+
+  const totalFrames = Math.floor(declaredDataBytes / blockAlign);
+  const durationMs = Math.round((totalFrames / sampleRate) * 1000);
+
+  let sumSquares = 0;
+  let sumSamples = 0;
+  let peakAbs = 0;
+  let clippedSamples = 0;
+  let zeroCrossings = 0;
+  let prevSign = 0;
+
+  const monoSamples = new Float64Array(totalFrames);
+
+  for (let f = 0; f < totalFrames; f++) {
+    const sampleOffset = WAV_HEADER_BYTES + f * blockAlign;
+    const rawInt16 = wavBuffer.readInt16LE(sampleOffset);
+    const normalized = rawInt16 / 32768.0;
+    monoSamples[f] = normalized;
+
+    sumSamples += normalized;
+    sumSquares += normalized * normalized;
+    const absVal = Math.abs(normalized);
+    if (absVal > peakAbs) peakAbs = absVal;
+    if (Math.abs(rawInt16) >= 32766) clippedSamples++;
+
+    const sign = normalized > 1e-4 ? 1 : normalized < -1e-4 ? -1 : 0;
+    if (sign !== 0 && prevSign !== 0 && sign !== prevSign) {
+      zeroCrossings++;
+    }
+    if (sign !== 0) prevSign = sign;
+  }
+
+  const rmsLinear = totalFrames > 0 ? Math.sqrt(sumSquares / totalFrames) : 0;
+  const rmsDbFs = rmsLinear > 1e-9 ? Number((20 * Math.log10(rmsLinear)).toFixed(2)) : -100;
+  const dcOffset = totalFrames > 0 ? Number((sumSamples / totalFrames).toFixed(6)) : 0;
+  const estimatedFreqHz =
+    durationMs > 0 ? Math.round((zeroCrossings / 2 / (durationMs / 1000))) : 0;
+
+  // Frame-level Voice Activity Detection (VAD)
+  const frameDurationMs = options.frameDurationMs || 20;
+  const vadThresholdDbFs = options.vadThresholdDbFs ?? -40;
+  const samplesPerVadFrame = Math.max(1, Math.floor((sampleRate * frameDurationMs) / 1000));
+  const activeSegments = [];
+  let currentSegment = null;
+
+  for (let startSample = 0; startSample < totalFrames; startSample += samplesPerVadFrame) {
+    const endSample = Math.min(totalFrames, startSample + samplesPerVadFrame);
+    let frameSumSq = 0;
+    for (let s = startSample; s < endSample; s++) {
+      frameSumSq += monoSamples[s] * monoSamples[s];
+    }
+    const frameRms = Math.sqrt(frameSumSq / (endSample - startSample));
+    const frameDb = frameRms > 1e-9 ? 20 * Math.log10(frameRms) : -100;
+    const isActive = frameDb >= vadThresholdDbFs;
+
+    const frameStartMs = Math.round((startSample / sampleRate) * 1000);
+    const frameEndMs = Math.round((endSample / sampleRate) * 1000);
+
+    if (isActive) {
+      if (!currentSegment) {
+        currentSegment = { startMs: frameStartMs, endMs: frameEndMs };
+      } else {
+        currentSegment.endMs = frameEndMs;
+      }
+    } else if (currentSegment) {
+      activeSegments.push(currentSegment);
+      currentSegment = null;
+    }
+  }
+  if (currentSegment) {
+    activeSegments.push(currentSegment);
+  }
+
+  return {
+    valid: true,
+    errors: [],
+    header: {
+      audioFormat,
+      channels,
+      sampleRate,
+      byteRate,
+      blockAlign,
+      bitsPerSample,
+      dataBytes: declaredDataBytes,
+      durationMs
+    },
+    acoustics: {
+      rmsDbFs,
+      peakNormalized: Number(peakAbs.toFixed(4)),
+      dcOffset,
+      clippedSamples,
+      isSilent: rmsDbFs < vadThresholdDbFs,
+      estimatedDominantFrequencyHz: estimatedFreqHz,
+      voiceActivitySegments: activeSegments
+    }
+  };
+}
+
+module.exports = {
+  synthesizeWavPcmBuffer,
+  analyzeAndVerifyWavPcm
+};
diff --git a/desktop/windows/test/archive-quarantine-verifier.test.cjs b/desktop/windows/test/archive-quarantine-verifier.test.cjs
