+// HTML is an escaped, readable transcript, not a Markdown renderer. Message
+// content stays verbatim inside <pre> so model output cannot inject markup.
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
