+import {
+  MediaProviderError,
+  isMp3Bytes,
+  sanitizeMediaMessage,
+  type MediaBinary
+} from "./openai-media-adapter.js";
+
+const ELEVENLABS_ORIGIN = "https://api.elevenlabs.io";
+const MAX_AUDIO_BYTES = 16 * 1024 * 1024;
+
+export interface SoundEffectAdapterOptions {
+  readonly duration_seconds?: number | null;
+  readonly prompt_influence?: number | null;
+}
+
+export interface MusicAdapterOptions {
+  readonly music_length_ms?: number | null;
+  readonly force_instrumental?: boolean | null;
+}
+
+function sanitizeElevenLabsMessage(input: string): string {
+  return sanitizeMediaMessage(input).replace(/\bxi-api-key:\s*\S+/gi, "xi-api-key: [REDACTED]");
+}
+
+async function readBoundedAudio(
+  response: Response,
+  maxBytes: number,
+  signal: AbortSignal
+): Promise<Uint8Array> {
+  const lengthHeader = response.headers.get("content-length");
+  if (lengthHeader) {
+    const declared = Number(lengthHeader);
+    if (Number.isFinite(declared) && declared > maxBytes) {
+      throw new MediaProviderError("INVALID_ASSET", "Audio response exceeds maximum size", {
+        normalizedCode: "corrupt_response"
+      });
+    }
+  }
+  const reader = response.body?.getReader();
+  if (!reader) {
+    const buf = new Uint8Array(await response.arrayBuffer());
+    if (buf.byteLength > maxBytes) {
+      throw new MediaProviderError("INVALID_ASSET", "Audio response exceeds maximum size", {
+        normalizedCode: "corrupt_response"
+      });
+    }
+    return buf;
+  }
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  try {
+    while (true) {
+      if (signal.aborted) {
+        throw new MediaProviderError("ABORTED", "Audio request aborted", {
+          normalizedCode: "aborted"
+        });
+      }
+      const { done, value } = await reader.read();
+      if (done) break;
+      total += value.byteLength;
+      if (total > maxBytes) {
+        throw new MediaProviderError("INVALID_ASSET", "Audio response exceeds maximum size", {
+          normalizedCode: "corrupt_response"
+        });
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const out = new Uint8Array(total);
+  let offset = 0;
+  for (const chunk of chunks) {
+    out.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return out;
+}
+
+function normalizeHttpError(status: number, bodyText: string): MediaProviderError {
+  const detail = sanitizeElevenLabsMessage(bodyText || `HTTP ${status}`);
+  if (status === 401 || status === 403) {
+    return new MediaProviderError("invalid_key", detail, { normalizedCode: "invalid_key", status });
+  }
+  if (status === 402) {
+    return new MediaProviderError("insufficient_funds", detail, {
+      normalizedCode: "insufficient_funds",
+      status
+    });
+  }
+  if (status === 429) {
+    return new MediaProviderError("rate_limit", detail, { normalizedCode: "rate_limit", status });
+  }
+  if (status === 408 || status === 504) {
+    return new MediaProviderError("timeout", detail, { normalizedCode: "timeout", status });
+  }
+  return new MediaProviderError("PROVIDER_ERROR", detail, {
+    normalizedCode: "provider_error",
+    status
+  });
+}
+
+/**
+ * ElevenLabs Sound Effects & Music adapter.
+ * Enforces fixed official origin (`https://api.elevenlabs.io`), `redirect: "error"`,
+ * bounded response reading, and real MP3 binary signature verification.
+ */
+export class ElevenLabsMediaAdapter {
+  readonly #apiKey: string;
+  readonly #fetcher: typeof fetch;
+
+  constructor(apiKey: string, fetcher: typeof fetch = fetch) {
+    if (!apiKey || !apiKey.trim()) {
+      throw new MediaProviderError("invalid_key", "ElevenLabs API key required", {
+        normalizedCode: "invalid_key"
+      });
+    }
+    this.#apiKey = apiKey.trim();
+    this.#fetcher = fetcher;
+  }
+
+  private async postAudio(
+    path: "v1/sound-generation" | "v1/music",
+    payload: Record<string, unknown>,
+    signal: AbortSignal
+  ): Promise<MediaBinary> {
+    const url = `${ELEVENLABS_ORIGIN}/${path}`;
+    let response: Response;
+    try {
+      response = await this.#fetcher(url, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          accept: "audio/mpeg",
+          "xi-api-key": this.#apiKey
+        },
+        body: JSON.stringify(payload),
+        redirect: "error",
+        signal
+      });
+    } catch (error) {
+      if (signal.aborted) {
+        throw new MediaProviderError("ABORTED", "Audio request aborted", {
+          normalizedCode: "aborted"
+        });
+      }
+      const message = error instanceof Error ? error.message : "Network error";
+      throw new MediaProviderError("PROVIDER_ERROR", sanitizeElevenLabsMessage(message), {
+        normalizedCode: "provider_error"
+      });
+    }
+
+    if (response.status >= 300 && response.status < 400) {
+      throw new MediaProviderError("PROVIDER_ERROR", "Provider redirect rejected", {
+        normalizedCode: "provider_error",
+        status: response.status
+      });
+    }
+    if (!response.ok) {
+      const text = await response.text().catch(() => "");
+      throw normalizeHttpError(response.status, text);
+    }
+
+    const contentType = response.headers.get("content-type")?.split(";")[0]?.trim().toLowerCase();
+    if (
+      contentType &&
+      contentType !== "application/octet-stream" &&
+      !contentType.startsWith("audio/")
+    ) {
+      throw new MediaProviderError("INVALID_ASSET", `Unexpected audio MIME ${contentType}`, {
+        normalizedCode: "invalid_mime"
+      });
+    }
+
+    const bytes = await readBoundedAudio(response, MAX_AUDIO_BYTES, signal);
+    if (!isMp3Bytes(bytes)) {
+      throw new MediaProviderError("INVALID_ASSET", "No valid MP3 audio signature returned", {
+        normalizedCode: "corrupt_response"
+      });
+    }
+    return {
+      bytes,
+      mime: "audio/mpeg",
+      extension: "mp3"
+    };
+  }
+
+  async generateSoundEffect(
+    text: string,
+    signal: AbortSignal,
+    options: SoundEffectAdapterOptions = {}
+  ): Promise<MediaBinary> {
+    return this.postAudio(
+      "v1/sound-generation",
+      {
+        text,
+        ...(options.duration_seconds !== undefined && options.duration_seconds !== null
+          ? { duration_seconds: options.duration_seconds }
+          : {}),
+        ...(options.prompt_influence !== undefined && options.prompt_influence !== null
+          ? { prompt_influence: options.prompt_influence }
+          : {})
+      },
+      signal
+    );
+  }
+
+  async generateMusic(
+    prompt: string,
+    signal: AbortSignal,
+    options: MusicAdapterOptions = {}
+  ): Promise<MediaBinary> {
+    return this.postAudio(
+      "v1/music",
+      {
+        prompt,
+        ...(options.music_length_ms !== undefined && options.music_length_ms !== null
+          ? { music_length_ms: options.music_length_ms }
+          : {}),
+        ...(options.force_instrumental !== undefined && options.force_instrumental !== null
+          ? { force_instrumental: options.force_instrumental }
+          : {})
+      },
+      signal
+    );
+  }
+}
+
+export const ELEVENLABS_MEDIA_ENDPOINTS = {
+  sound_effects: `${ELEVENLABS_ORIGIN}/v1/sound-generation`,
+  music_generation: `${ELEVENLABS_ORIGIN}/v1/music`
+} as const;
