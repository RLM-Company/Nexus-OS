{
  "suite": "A0-A6 monotonicity and safety vectors",
  "version": "1.0.0",
  "invariant": "For the same capability, scope, mandate and risk, a higher pure level must not produce a more restrictive outcome than a lower level. Law, immutable core and explicit owner constraints remain hard limits.",
  "outcome_order": [
    "deny",
    "pause",
    "require_confirmation",
    "allow_with_controls",
    "allow"
  ],
  "transitions": [
    [
      "A0",
      "A1"
    ],
    [
      "A1",
      "A2"
    ],
    [
      "A2",
      "A3"
    ],
    [
      "A3",
      "A4"
    ],
    [
      "A4",
      "A5"
    ],
    [
      "A5",
      "A6"
    ]
  ],
  "cases": [
    {
      "id": "M-001",
      "capability": "web_read",
      "expected_min_level": "A1",
      "pure_levels": {
        "A0": "deny",
        "A1": "allow",
        "A2": "allow",
        "A3": "allow",
        "A4": "allow",
        "A5": "allow",
        "A6": "allow"
      }
    },
    {
      "id": "M-002",
      "capability": "integrations",
      "scenario": "write to an already connected project integration",
      "expected_min_level": "A2",
      "pure_levels": {
        "A0": "deny",
        "A1": "require_confirmation",
        "A2": "allow_with_controls",
        "A3": "allow_with_controls",
        "A4": "allow_with_controls",
        "A5": "allow_with_controls",
        "A6": "allow"
      }
    },
    {
      "id": "M-003",
      "capability": "external_communications",
      "scenario": "send within an approved campaign",
      "expected_min_level": "A3",
      "pure_levels": {
        "A0": "deny",
        "A1": "deny",
        "A2": "require_confirmation",
        "A3": "allow_with_controls",
        "A4": "allow_with_controls",
        "A5": "allow_with_controls",
        "A6": "allow"
      }
    },
    {
      "id": "M-004",
      "capability": "finance",
      "scenario": "pay existing recipient within reserved budget",
      "expected_min_level": "A4",
      "pure_levels": {
        "A0": "deny",
        "A1": "deny",
        "A2": "require_confirmation",
        "A3": "require_confirmation",
        "A4": "allow_with_controls",
        "A5": "allow_with_controls",
        "A6": "allow"
      }
    },
    {
      "id": "M-005",
      "capability": "recipient_discovery",
      "scenario": "new recipient matches project-passport audience",
      "expected_min_level": "A5",
      "pure_levels": {
        "A0": "deny",
        "A1": "deny",
        "A2": "require_confirmation",
        "A3": "require_confirmation",
        "A4": "require_confirmation",
        "A5": "allow_with_controls",
        "A6": "allow"
      }
    },
    {
      "id": "M-006",
      "capability": "strategy",
      "scenario": "change strategy inside an A5 project",
      "pure_levels": {
        "A0": "require_confirmation",
        "A1": "require_confirmation",
        "A2": "require_confirmation",
        "A3": "require_confirmation",
        "A4": "require_confirmation",
        "A5": "require_confirmation",
        "A6": "allow"
      }
    },
    {
      "id": "S-001",
      "capability": "finance",
      "scenario": "parallel charges compete for one budget",
      "all_levels_rule": "atomic_budget_reservation_required"
    },
    {
      "id": "S-002",
      "capability": "external_communications",
      "scenario": "retry after timeout",
      "all_levels_rule": "idempotency_check_required"
    },
    {
      "id": "S-003",
      "capability": "emergency_control",
      "scenario": "owner emergency stop",
      "all_levels_rule": "pause_and_revoke_delegated_permissions"
    },
    {
      "id": "S-004",
      "capability": "training_data",
      "scenario": "unclear right to use third-party data",
      "all_levels_rule": "deny_until_data_rights_verified"
    },
    {
      "id": "S-005",
      "capability": "production_release",
      "scenario": "local defect isolated to one subsystem",
      "a5_rule": "pause_minimum_affected_scope"
    },
    {
      "id": "S-006",
      "capability": "production_release",
      "scenario": "systemic non-isolatable threat",
      "a5_rule": "pause_entire_project"
    }
  ]
}
