{
  "name": "cosmora-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @cosmora/api exec node --env-file-if-exists=../../.env --require ../../scripts/windows-node-user.cjs --import tsx --conditions=development ../../packages/db/src/migrate.ts",
    "demo": "turbo run demo",
    "demo:lan": "turbo run demo:lan",
    "demo:preflight": "node scripts/demo-preflight.mjs",
    "manager:demo-smoke": "node scripts/manager-demo-smoke.mjs",
    "manager:preflight": "node --env-file-if-exists=.env scripts/manager-live-preflight.mjs",
    "manager:smoke": "node --env-file-if-exists=.env scripts/manager-live-smoke.mjs",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @cosmora/web test:e2e",
    "test:deploy": "node --test deploy/alpha/test/*.test.mjs",
    "test:connection": "node --test scripts/test/provider-connection-check.test.mjs",
    "test:secrets": "node --test scripts/test/check-secrets.test.mjs",
    "test:profile": "node scripts/manager-compatible-fixture-smoke.mjs",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm check:secrets && pnpm lint && pnpm typecheck && pnpm test && pnpm test:deploy && pnpm test:connection && pnpm test:secrets && pnpm build && pnpm test:profile && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
