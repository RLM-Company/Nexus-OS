diff --git a/desktop/windows/browser/downloaded-archive-and-doc-ingestor.cjs b/desktop/windows/browser/downloaded-archive-and-doc-ingestor.cjs
new file mode 100644
index 0000000..f0c47ff
--- /dev/null
+++ b/desktop/windows/browser/downloaded-archive-and-doc-ingestor.cjs
@@ -0,0 +1,78 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const crypto = require("node:crypto");
+const { extractVaultDocument } = require("../vault-document-extractor.cjs");
+const { buildVersionedPageSnapshot, extractVerifiableExcerpt } = require("./document.cjs");
+
+/**
+ * Koswork Multi-Format Downloaded Document Ingestor
+ * (`desktop/windows/browser/downloaded-archive-and-doc-ingestor.cjs`).
+ *
+ * Deepens Requirement #4 & #5:
+ * - Ingests binary and structured files downloaded into the allowed workspace download folder
+ *   (`.docx`, `.xlsx`, `.pdf`, `.pptx`, `.csv`, `.json`, `.html`, `.md`, `.txt`) using
+ *   `extractVaultDocument` (`desktop/windows/vault-document-extractor.cjs`).
+ * - Enforces that the downloaded file resides strictly inside `allowedDownloadDir` or
+ *   `allowedWorkspaceRoot`.
+ * - Converts the extracted document text into a versioned research snapshot with exact
+ *   UTF-16 code unit offsets (`startUtf16`, `endUtf16`) and SHA-256 binary file digest provenance.
+ */
+function ingestMultiFormatDownloadedDocument(downloadResult = {}, metadata = {}) {
+  const filePath = downloadResult.savedPath || downloadResult.filePath;
+  if (!filePath || !fs.existsSync(filePath)) {
+    const err = new Error("DOWNLOADED_DOCUMENT_FILE_MISSING");
+    err.code = "DOWNLOADED_DOCUMENT_FILE_MISSING";
+    throw err;
+  }
+
+  const resolvedFile = path.resolve(filePath);
+  if (metadata.allowedWorkspaceRoot) {
+    const resolvedRoot = path.resolve(metadata.allowedWorkspaceRoot);
+    if (!resolvedFile.startsWith(resolvedRoot + path.sep) && resolvedFile !== resolvedRoot) {
+      const err = new Error("DOWNLOADED_DOCUMENT_OUTSIDE_ALLOWED_WORKSPACE");
+      err.code = "DOWNLOADED_DOCUMENT_OUTSIDE_ALLOWED_WORKSPACE";
+      throw err;
+    }
+  }
+
+  const rawBuffer = fs.readFileSync(resolvedFile);
+  const fileSha256 = crypto.createHash("sha256").update(rawBuffer).digest("hex");
+  const filename = downloadResult.filename || path.basename(resolvedFile);
+
+  const extracted = extractVaultDocument(rawBuffer, { filename });
+  const extractedText = String(extracted.text || "").trim();
+
+  const syntheticUrl =
+    downloadResult.sourceUrl ||
+    metadata.sourceUrl ||
+    `https://downloaded.koswork.local/${encodeURIComponent(filename)}`;
+
+  const snapshot = buildVersionedPageSnapshot({
+    tabId: downloadResult.tabId || "tab-downloaded-doc",
+    pageVersion: 1,
+    url: syntheticUrl,
+    canonicalUrl: syntheticUrl,
+    httpStatus: 200,
+    title: `${filename} (Скачанный документ ${extracted.format || path.extname(filename)})`,
+    pageDate: metadata.pageDate || null,
+    eventDate: metadata.eventDate || null,
+    fetchedAt: downloadResult.completedAt || new Date().toISOString(),
+    text: extractedText
+  });
+
+  return {
+    filename,
+    detectedFormat: extracted.format || path.extname(filename).replace(/^\./, ""),
+    filePath: resolvedFile,
+    byteSize: rawBuffer.length,
+    fileSha256,
+    snapshot,
+    extractExcerpt: (querySpec) => extractVerifiableExcerpt(snapshot, querySpec)
+  };
+}
+
+module.exports = {
+  ingestMultiFormatDownloadedDocument
+};
diff --git a/desktop/windows/browser/research-pinboard-bookmarks.cjs b/desktop/windows/browser/research-pinboard-bookmarks.cjs
new file mode 100644
index 0000000..e0eb91d
--- /dev/null
+++ b/desktop/windows/browser/research-pinboard-bookmarks.cjs
@@ -0,0 +1,123 @@
+"use strict";
+
+/**
+ * Koswork Bookmark & Reading-List Research Pinboard Bridge
+ * (`desktop/windows/browser/research-pinboard-bookmarks.cjs`).
+ *
+ * Connects the browser's persistent bookmark store (`KosworkSearchAndBrowserStore` in
+ * `search-pagination-and-bookmarks.cjs`) directly to the multi-site Browser Research Cycle:
+ * 1. Allows users or agents to pin an open tab along with a verified UTF-16 excerpt,
+ *    distinct `pageDate` / `eventDate` / `fetchedAt`, and research criterion tags.
+ * 2. Filters pinned bookmarks by category or tag (`listPinnedResearchSources`).
+ * 3. Builds a ready-to-execute multi-site research plan (`buildResearchPlanFromPinnedBookmarks`)
+ *    from the user's pinned bookmarks so manual browsing discoveries feed directly into
+ *    automated comparison reports.
+ */
+class KosworkResearchPinboardBridge {
+  constructor(options = {}) {
+    if (!options.engine) {
+      throw new Error("PINBOARD_BRIDGE_REQUIRES_ENGINE");
+    }
+    this.engine = options.engine;
+    this.store = this.engine.searchService.store;
+    this.pinnedMetadataByUrl = new Map(); // normalizedUrl -> { tags, optionName, criterion, excerpt, pageDate, eventDate, fetchedAt }
+  }
+
+  pinTabToResearchBookmarks({
+    tabId,
+    category = "research",
+    tags = [],
+    optionName = null,
+    criterion = null,
+    searchTerm = null
+  } = {}) {
+    const obs = this.engine.observePage(tabId);
+    const snap = obs.snapshot;
+
+    let excerpt = null;
+    if (searchTerm) {
+      excerpt = this.engine.extractExcerpt(tabId, { searchTerm });
+    }
+
+    const bookmark = this.store.addBookmark({
+      url: snap.url,
+      title: snap.title,
+      category,
+      tags
+    });
+
+    const richPin = {
+      bookmarkId: bookmark.bookmarkId || bookmark.id || `bm-${Date.now()}`,
+      url: bookmark.url,
+      title: bookmark.title,
+      category: bookmark.category,
+      tags: bookmark.tags,
+      optionName,
+      criterion,
+      pageDate: snap.pageDate,
+      eventDate: snap.eventDate,
+      fetchedAt: snap.fetchedAt,
+      tabReceipt: snap.tabReceipt,
+      excerpt
+    };
+
+    this.pinnedMetadataByUrl.set(bookmark.url, richPin);
+    return richPin;
+  }
+
+  listPinnedResearchSources({ category = null, tag = null } = {}) {
+    const bookmarks = this.store.listBookmarks({ category, tag });
+    return bookmarks.map((b) => {
+      const meta = this.pinnedMetadataByUrl.get(b.url) || {};
+      return {
+        ...b,
+        optionName: meta.optionName || null,
+        criterion: meta.criterion || null,
+        pageDate: meta.pageDate || null,
+        eventDate: meta.eventDate || null,
+        fetchedAt: meta.fetchedAt || b.createdAt,
+        excerpt: meta.excerpt || null
+      };
+    });
+  }
+
+  buildResearchPlanFromPinnedBookmarks({
+    question = "Сравнение по закладкам исследования",
+    category = "research",
+    tag = null,
+    defaultCriteria = ["Спецификация"]
+  } = {}) {
+    const pinned = this.listPinnedResearchSources({ category, tag });
+    const criteriaSet = new Set(defaultCriteria);
+    for (const p of pinned) {
+      if (p.criterion) criteriaSet.add(p.criterion);
+    }
+
+    return {
+      question,
+      criteria: Array.from(criteriaSet),
+      seedUrls: pinned.map((p) => p.url),
+      preverifiedClaims: pinned
+        .filter((p) => p.excerpt && p.optionName && p.criterion)
+        .map((p, idx) => ({
+          claimId: `pin-claim-${idx + 1}`,
+          optionName: p.optionName,
+          criterion: p.criterion,
+          value: p.excerpt.quote,
+          claim: `${p.optionName} (${p.criterion}): ${p.excerpt.quote}`,
+          excerpt: p.excerpt,
+          source: {
+            url: p.url,
+            title: p.title,
+            pageDate: p.pageDate,
+            eventDate: p.eventDate,
+            fetchedAt: p.fetchedAt
+          }
+        }))
+    };
+  }
+}
+
+module.exports = {
+  KosworkResearchPinboardBridge
+};
diff --git a/desktop/windows/browser/research-replay-auditor.cjs b/desktop/windows/browser/research-replay-auditor.cjs
new file mode 100644
index 0000000..20ddacf
