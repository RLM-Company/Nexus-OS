diff --git a/desktop/windows/browser/co-browsing-handback.cjs b/desktop/windows/browser/co-browsing-handback.cjs
new file mode 100644
index 0000000..13abc5a
--- /dev/null
+++ b/desktop/windows/browser/co-browsing-handback.cjs
@@ -0,0 +1,120 @@
+"use strict";
+
+const { extractVerifiableExcerpt } = require("./document.cjs");
+
+/**
+ * Koswork Interactive User-Agent Co-Browsing & Handback Coordinator
+ * (`desktop/windows/browser/co-browsing-handback.cjs`).
+ *
+ * Deepens Requirement #7:
+ * "Сохранить возможность обычного просмотра пользователем и перехвата управления.
+ *  Ручное действие делает старое наблюдение непригодным для дальнейшего ввода."
+ *
+ * Capabilities:
+ * 1. Tracks manual user takeover actions (`user_edit`, `user_scroll`, `user_navigate`, `user_highlight`),
+ *    immediately incrementing `userEpoch` so any stale agent `observedSnapshot` fails with
+ *    `OBSERVATION_INVALIDATED_BY_USER` if used for subsequent agent input.
+ * 2. Allows the user to highlight/select text on an open tab (`captureUserHighlightedExcerpt`)
+ *    and attach it as a first-class UTF-16 verified excerpt with `actor: "user"`.
+ * 3. Provides `reobserveAfterUserHandback(tabId)` so the agent cleanly acquires a fresh
+ *    versioned snapshot aligned to the new `userEpoch` before resuming automated actions.
+ */
+class KosworkCoBrowsingCoordinator {
+  constructor(options = {}) {
+    if (!options.engine) {
+      throw new Error("CO_BROWSING_COORDINATOR_REQUIRES_ENGINE");
+    }
+    this.engine = options.engine;
+    this.userHighlights = [];
+    this.handbackLog = [];
+  }
+
+  /**
+   * Simulates or records a manual user interaction in the tab (e.g. typing into a field,
+   * toggling a filter, or scrolling manually), invalidating prior agent observations.
+   */
+  recordManualUserAction({ tabId, actionType = "user_manual_input", fieldChanges = null } = {}) {
+    const takeoverRecord = typeof this.engine.recordUserAction === "function" ? this.engine.recordUserAction(tabId, actionType) : this.engine.userTakeover.recordManualUserAction(tabId, actionType);
+
+    if (fieldChanges && typeof fieldChanges === "object") {
+      const tab = this.engine.tabs.get(String(tabId));
+      if (tab) {
+        for (const [k, v] of Object.entries(fieldChanges)) {
+          tab.formValues.set(String(k), v);
+        }
+      }
+    }
+
+    return {
+      tabId: String(tabId),
+      actionType,
+      invalidatedPriorObservations: true,
+      newUserEpoch: takeoverRecord.userEpoch,
+      recordedAt: new Date().toISOString()
+    };
+  }
+
+  /**
+   * Captures a passage highlighted by the user during manual browsing as a verified
+   * UTF-16 excerpt (`startUtf16`, `endUtf16`, `quote`, `actor: "user"`) linked to the tab's source.
+   */
+  captureUserHighlightedExcerpt({ tabId, selectedText } = {}) {
+    if (!selectedText || !String(selectedText).trim()) {
+      throw new Error("USER_HIGHLIGHT_TEXT_REQUIRED");
+    }
+
+    const obs = this.engine.observePage(tabId, { reuseSnapshot: false });
+    const excerpt = extractVerifiableExcerpt(obs.snapshot, {
+      searchTerm: String(selectedText).trim()
+    });
+
+    if (!excerpt) {
+      const err = new Error("USER_HIGHLIGHT_NOT_FOUND_IN_SNAPSHOT");
+      err.code = "USER_HIGHLIGHT_NOT_FOUND_IN_SNAPSHOT";
+      throw err;
+    }
+
+    const enriched = {
+      ...excerpt,
+      actor: "user",
+      tabId: String(tabId),
+      url: obs.snapshot.url,
+      title: obs.snapshot.title,
+      pageDate: obs.snapshot.pageDate,
+      eventDate: obs.snapshot.eventDate,
+      fetchedAt: obs.snapshot.fetchedAt,
+      userEpoch: obs.snapshot.userEpoch
+    };
+
+    this.userHighlights.push(enriched);
+    return enriched;
+  }
+
+  /**
+   * Performs a clean handback from manual user control back to the agent by forcing
+   * a fresh observation at the current `userEpoch` and returning the updated snapshot
+   * and tabReceipt for subsequent agent input.
+   */
+  reobserveAfterUserHandback(tabId) {
+    const freshObs = this.engine.observePage(tabId, { reuseSnapshot: false });
+    const entry = {
+      tabId: String(tabId),
+      url: freshObs.snapshot.url,
+      pageVersion: freshObs.snapshot.pageVersion,
+      userEpoch: freshObs.snapshot.userEpoch,
+      snapshotId: freshObs.snapshot.snapshotId,
+      handbackAt: new Date().toISOString()
+    };
+    this.handbackLog.push(entry);
+    return {
+      handbackCompleted: true,
+      ...entry,
+      snapshot: freshObs.snapshot,
+      tabReceipt: freshObs.tabReceipt
+    };
+  }
+}
+
+module.exports = {
+  KosworkCoBrowsingCoordinator
+};
diff --git a/desktop/windows/browser/report-reverifier.cjs b/desktop/windows/browser/report-reverifier.cjs
new file mode 100644
index 0000000..c9741f5
--- /dev/null
+++ b/desktop/windows/browser/report-reverifier.cjs
@@ -0,0 +1,210 @@
+"use strict";
+
+const { saveResearchReportsViaWorkspace } = require("./research-report-builder.cjs");
+
+/**
+ * Koswork Live Report Re-Verifier & Delta Updater
+ * (`desktop/windows/browser/report-reverifier.cjs`).
+ *
+ * Deepens Requirement #5:
+ * "Создавать отчёт MD/HTML/таблицу сравнения через существующие file APIs: цитата,
+ *  источник, что подтверждено, что неизвестно. Ссылка сама по себе не доказательство
+ *  утверждения; отметь конфликтующие/устаревшие данные и недоступные источники."
+ *
+ * Re-verifies an existing research report against current browser sources:
+ * 1. Re-visits previously unavailable (`503` / offline) sources; if a source is now
+ *    available (`200 OK`) and contains a verifiable UTF-16 excerpt for an `"unknown"`
+ *    criterion, promotes that claim to `"confirmed"`.
+ * 2. Re-checks existing confirmed claims against fresh page snapshots to detect whether
+ *    any source has updated its figures (`updatedSourceClaims`) or become unavailable.
+ * 3. Writes an updated revision of the MD/HTML/CSV/JSON/DOCX/XLSX/PDF/PPTX/PROV/BibTeX
+ *    reports via `workspace-service.cjs`.
+ */
+async function reverifyAndRefreshResearchReport({
+  engine,
+  workspaceRoot,
+  reportSlug = "reverified-research-report",
+  previousReportData,
+  recoveryProbes = [],
+  signal = null
+} = {}) {
+  if (!engine) {
+    throw new Error("REVERIFIER_REQUIRES_ENGINE");
+  }
+  if (!previousReportData || typeof previousReportData !== "object") {
+    throw new Error("REVERIFIER_REQUIRES_PREVIOUS_REPORT_DATA");
+  }
+
+  const updatedSourcesMap = new Map();
+  for (const s of previousReportData.sources || []) {
+    updatedSourcesMap.set(s.url, { ...s });
+  }
+
+  const updatedClaims = [...(previousReportData.claims || [])];
+  const updatedComparisonRows = JSON.parse(
+    JSON.stringify(previousReportData.comparisonRows || [])
+  );
+  const stillUnavailable = [];
+  const recoveredSources = [];
+  const newlyConfirmedClaims = [];
+  const driftedClaims = [];
+
+  // 1. Re-verify existing confirmed claims against live sources
+  for (let i = 0; i < updatedClaims.length; i += 1) {
+    const claim = updatedClaims[i];
+    if (!claim?.source?.url || !claim?.excerpt?.quote) continue;
+
+    const nav = await engine.navigate({
+      tabId: `reverify-tab-${(i % 3) + 1}`,
+      url: claim.source.url,
+      actor: "agent",
+      signal
+    });
+
+    updatedSourcesMap.set(nav.url, {
+      url: nav.url,
+      title: nav.snapshot.title,
+      httpStatus: nav.httpStatus,
+      available: nav.available,
+      pageDate: nav.pageDate,
+      eventDate: nav.eventDate,
+      fetchedAt: nav.fetchedAt,
+      tabReceipt: nav.tabReceipt
+    });
+
+    if (!nav.available) {
+      driftedClaims.push({
+        claimId: claim.claimId,
+        reason: "SOURCE_BECAME_UNAVAILABLE",
+        url: nav.url,
+        httpStatus: nav.httpStatus
+      });
+      continue;
+    }
+
+    const freshExcerpt = engine.extractExcerpt(nav.tabId, {
+      searchTerm: claim.excerpt.quote
+    });
+
+    if (!freshExcerpt) {
+      driftedClaims.push({
+        claimId: claim.claimId,
+        reason: "QUOTE_NO_LONGER_PRESENT_IN_SOURCE",
+        url: nav.url,
+        expectedQuote: claim.excerpt.quote
+      });
+    } else {
+      updatedClaims[i] = {
+        ...claim,
+        excerpt: freshExcerpt,
+        source: {
+          ...claim.source,
+          title: nav.snapshot.title,
+          pageDate: nav.pageDate,
+          eventDate: nav.eventDate,
+          fetchedAt: nav.fetchedAt
+        }
+      };
+    }
+  }
+
+  // 2. Probe previously unavailable sources or recovery probes for unknown criteria
+  for (let j = 0; j < recoveryProbes.length; j += 1) {
+    const probe = recoveryProbes[j];
+    const nav = await engine.navigate({
+      tabId: `probe-tab-${(j % 3) + 1}`,
+      url: probe.url,
+      actor: "agent",
+      signal
+    });
+
+    updatedSourcesMap.set(nav.url, {
+      url: nav.url,
+      title: nav.snapshot.title,
+      httpStatus: nav.httpStatus,
+      available: nav.available,
+      pageDate: nav.pageDate,
+      eventDate: nav.eventDate,
+      fetchedAt: nav.fetchedAt,
+      tabReceipt: nav.tabReceipt
+    });
+
+    if (!nav.available) {
+      stillUnavailable.push({
+        url: nav.url,
+        httpStatus: nav.httpStatus,
+        reason: `HTTP ${nav.httpStatus}`
+      });
+      continue;
+    }
+
+    recoveredSources.push(nav.url);
+
+    if (probe.searchTerm) {
+      const exc = engine.extractExcerpt(nav.tabId, {
+        searchTerm: probe.searchTerm
+      });
+      if (exc) {
+        const newClaim = {
+          claimId: probe.claimId || `recovered-claim-${updatedClaims.length + 1}`,
+          optionName: probe.optionName,
+          criterion: probe.criterion,
+          value: probe.value || exc.quote,
+          claim: probe.claimText || `${probe.optionName}: ${probe.criterion} = ${probe.value || exc.quote}`,
+          excerpt: exc,
+          source: {
+            url: nav.url,
+            title: nav.snapshot.title,
+            pageDate: nav.pageDate,
+            eventDate: nav.eventDate,
+            fetchedAt: nav.fetchedAt
+          }
+        };
+        updatedClaims.push(newClaim);
+        newlyConfirmedClaims.push(newClaim);
+
+        let row = updatedComparisonRows.find((r) => r.optionName === probe.optionName);
+        if (!row) {
+          row = { optionName: probe.optionName, values: {} };
+          updatedComparisonRows.push(row);
+        }
+        row.values = row.values || {};
+        row.values[probe.criterion] = {
+          displayValue: probe.value || exc.quote,
+          sourceUrl: nav.url,
+          startUtf16: exc.startUtf16,
+          endUtf16: exc.endUtf16
+        };
+      }
+    }
+  }
+
+  const nextReportData = {
+    ...previousReportData,
+    generatedAt: new Date().toISOString(),
+    sources: Array.from(updatedSourcesMap.values()),
+    claims: updatedClaims,
+    comparisonRows: updatedComparisonRows,
+    unavailableSources: stillUnavailable
+  };
+
+  const savedReports = await saveResearchReportsViaWorkspace({
+    workspaceRoot,
+    reportSlug,
+    reportData: nextReportData,
+    signal
+  });
+
+  return {
+    status: "reverified",
+    recoveredSources,
+    newlyConfirmedClaims,
+    driftedClaims,
+    stillUnavailable,
+    savedReports
+  };
+}
+
+module.exports = {
+  reverifyAndRefreshResearchReport
+};
