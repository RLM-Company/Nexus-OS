diff --git a/desktop/windows/browser/cookie-storage-and-origin-isolation-guard.cjs b/desktop/windows/browser/cookie-storage-and-origin-isolation-guard.cjs
new file mode 100644
index 0000000..45844c4
--- /dev/null
+++ b/desktop/windows/browser/cookie-storage-and-origin-isolation-guard.cjs
@@ -0,0 +1,166 @@
+"use strict";
+
+/**
+ * Koswork Per-Origin Cookie & Storage Partition Isolation Guard
+ * (`desktop/windows/browser/cookie-storage-and-origin-isolation-guard.cjs`).
+ *
+ * Deepens Requirements #4, #6 & #7:
+ * - Isolates browser storage and cookies across two strict partitions:
+ *   1. `"user_browsing"` (normal user browsing state, preserved across research tasks)
+ *   2. `"agent_research_ephemeral"` (ephemeral agent research storage, purgeable without
+ *      touching the user's normal session).
+ * - Enforces per-origin boundaries (`CROSS_ORIGIN_STORAGE_READ_BLOCKED`), blocks script
+ *   access to `HttpOnly` cookies (`COOKIE_HTTPONLY_SCRIPT_ACCESS_DENIED`), and rejects
+ *   insecure `SameSite=None` cookies on non-HTTPS origins (`COOKIE_SAMESITE_NONE_REQUIRES_SECURE`).
+ */
+
+function normalizeOrigin(rawUrl = "") {
+  const u = new URL(String(rawUrl || ""));
+  return u.origin.toLowerCase();
+}
+
+class KosworkOriginStorageIsolationGuard {
+  constructor() {
+    // key: `${partition}||${origin}` -> { cookies: Map, localStorage: Map }
+    this.buckets = new Map();
+  }
+
+  _getBucket(partition = "agent_research_ephemeral", originUrl = "https://corpus.local") {
+    const part =
+      partition === "user_browsing" ? "user_browsing" : "agent_research_ephemeral";
+    const origin = normalizeOrigin(originUrl);
+    const key = `${part}||${origin}`;
+    if (!this.buckets.has(key)) {
+      this.buckets.set(key, {
+        partition: part,
+        origin,
+        cookies: new Map(),
+        localStorage: new Map()
+      });
+    }
+    return this.buckets.get(key);
+  }
+
+  setCookie({
+    partition = "agent_research_ephemeral",
+    originUrl,
+    name,
+    value,
+    httpOnly = false,
+    secure = true,
+    sameSite = "Lax"
+  } = {}) {
+    const origin = normalizeOrigin(originUrl);
+    const isHttps = origin.startsWith("https:");
+    if (String(sameSite).toLowerCase() === "none" && (!secure || !isHttps)) {
+      const err = new Error(
+        `Cookie "${name}" with SameSite=None requires Secure on an https: origin`
+      );
+      err.code = "COOKIE_SAMESITE_NONE_REQUIRES_SECURE";
+      throw err;
+    }
+
+    const bucket = this._getBucket(partition, originUrl);
+    const entry = {
+      name: String(name),
+      value: String(value ?? ""),
+      httpOnly: Boolean(httpOnly),
+      secure: Boolean(secure),
+      sameSite: String(sameSite || "Lax"),
+      updatedAt: new Date().toISOString()
+    };
+    bucket.cookies.set(entry.name, entry);
+    return { status: "ok", partition: bucket.partition, origin: bucket.origin, cookie: entry };
+  }
+
+  readCookie({
+    partition = "agent_research_ephemeral",
+    requesterOriginUrl,
+    targetOriginUrl,
+    name,
+    viaDocumentCookieScript = false
+  } = {}) {
+    const reqOrigin = normalizeOrigin(requesterOriginUrl);
+    const tgtOrigin = normalizeOrigin(targetOriginUrl || requesterOriginUrl);
+    if (reqOrigin !== tgtOrigin) {
+      const err = new Error(
+        `Cross-origin cookie read blocked: ${reqOrigin} cannot read ${tgtOrigin}`
+      );
+      err.code = "CROSS_ORIGIN_STORAGE_READ_BLOCKED";
+      throw err;
+    }
+
+    const bucket = this._getBucket(partition, tgtOrigin);
+    const cookie = bucket.cookies.get(String(name));
+    if (!cookie) return null;
+
+    if (viaDocumentCookieScript && cookie.httpOnly) {
+      const err = new Error(
+        `Script access to HttpOnly cookie "${name}" on ${tgtOrigin} is denied`
+      );
+      err.code = "COOKIE_HTTPONLY_SCRIPT_ACCESS_DENIED";
+      throw err;
+    }
+
+    return cookie;
+  }
+
+  setLocalStorageItem({
+    partition = "agent_research_ephemeral",
+    originUrl,
+    key,
+    value
+  } = {}) {
+    const bucket = this._getBucket(partition, originUrl);
+    bucket.localStorage.set(String(key), String(value ?? ""));
+    return {
+      status: "ok",
+      partition: bucket.partition,
+      origin: bucket.origin,
+      key: String(key)
+    };
+  }
+
+  getLocalStorageItem({
+    partition = "agent_research_ephemeral",
+    requesterOriginUrl,
+    targetOriginUrl,
+    key
+  } = {}) {
+    const reqOrigin = normalizeOrigin(requesterOriginUrl);
+    const tgtOrigin = normalizeOrigin(targetOriginUrl || requesterOriginUrl);
+    if (reqOrigin !== tgtOrigin) {
+      const err = new Error(
+        `Cross-origin localStorage read blocked: ${reqOrigin} cannot read ${tgtOrigin}`
+      );
+      err.code = "CROSS_ORIGIN_STORAGE_READ_BLOCKED";
+      throw err;
+    }
+    const bucket = this._getBucket(partition, tgtOrigin);
+    return bucket.localStorage.has(String(key))
+      ? bucket.localStorage.get(String(key))
+      : null;
+  }
+
+  purgeEphemeralResearchPartition() {
+    let purgedOrigins = 0;
+    for (const [k, bucket] of this.buckets.entries()) {
+      if (bucket.partition === "agent_research_ephemeral") {
+        this.buckets.delete(k);
+        purgedOrigins += 1;
+      }
+    }
+    const remainingUserBuckets = Array.from(this.buckets.values()).filter(
+      (b) => b.partition === "user_browsing"
+    ).length;
+
+    return {
+      purgedOrigins,
+      remainingUserBuckets
+    };
+  }
+}
+
+module.exports = {
+  KosworkOriginStorageIsolationGuard
+};
diff --git a/desktop/windows/browser/mermaid-knowledge-graph-exporter.cjs b/desktop/windows/browser/mermaid-knowledge-graph-exporter.cjs
new file mode 100644
index 0000000..015b7ca
--- /dev/null
+++ b/desktop/windows/browser/mermaid-knowledge-graph-exporter.cjs
@@ -0,0 +1,205 @@
+"use strict";
+
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork Research Knowledge Graph & Mermaid Visual Timeline Exporter
+ * (`desktop/windows/browser/mermaid-knowledge-graph-exporter.cjs`).
+ *
+ * Deepens Requirements #2, #3 & #5:
+ * - Synthesizes a multi-site research report into a directed Provenance Knowledge Graph
+ *   (`nodes`, `edges`) and renders embedded Mermaid `flowchart LR` + chronological
+ *   `timeline` diagrams (`eventDate` vs `pageDate` vs `fetchedAt`) saved via
+ *   `workspace-service.cjs` (`reports/<slug>-knowledge-graph.md` and `.json`).
+ */
+
+function sanitizeMermaidLabel(str = "") {
+  return String(str ?? "")
+    .replace(/["[\]{}()<>|#]/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function buildResearchKnowledgeGraphAndMermaidReport(report = {}) {
+  const question = report.question || "Многосайтовое исследование Koswork";
+  const nodes = [];
+  const edges = [];
+  const timelineEvents = [];
+
+  const qNodeId = "Q0";
+  nodes.push({ id: qNodeId, kind: "question", label: question });
+
+  let srcIndex = 1;
+  let claimIndex = 1;
+  const sourceNodeByUrl = new Map();
+
+  function ensureSourceNode(url, title, pageDate, eventDate, fetchedAt, status = "200") {
+    const cleanUrl = String(url || "https://corpus.local/unknown");
+    if (sourceNodeByUrl.has(cleanUrl)) {
+      return sourceNodeByUrl.get(cleanUrl);
+    }
+    const id = `S${srcIndex}`;
+    srcIndex += 1;
+    const node = {
+      id,
+      kind: "source",
+      url: cleanUrl,
+      title: title || cleanUrl,
+      pageDate: pageDate || null,
+      eventDate: eventDate || null,
+      fetchedAt: fetchedAt || null,
+      httpStatus: status
+    };
+    sourceNodeByUrl.set(cleanUrl, node);
+    nodes.push(node);
+    edges.push({ from: qNodeId, to: id, relation: "opened_source" });
+
+    if (eventDate || pageDate) {
+      timelineEvents.push({
+        date: eventDate || pageDate,
+        dateKind: eventDate ? "eventDate" : "pageDate",
+        sourceId: id,
+        url: cleanUrl,
+        title: title || cleanUrl
+      });
+    }
+    return node;
+  }
+
+  for (const row of report.comparisonRows || []) {
+    const optionName = row.optionName || "Option";
+    for (const [criterion, cell] of Object.entries(row.cells || {})) {
+      if (!cell || !cell.quote || !Number.isInteger(cell.startUtf16) || cell.startUtf16 < 0) {
+        continue;
+      }
+      const srcNode = ensureSourceNode(
+        cell.sourceUrl,
+        cell.sourceTitle,
+        cell.pageDate,
+        cell.pageDate && cell.eventDate ? cell.eventDate : cell.eventDate,
+        cell.fetchedAt,
+        "200"
+      );
+      const claimId = `C${claimIndex}`;
+      claimIndex += 1;
+
+      nodes.push({
+        id: claimId,
+        kind: "verified_claim",
+        optionName,
+        criterion,
+        value: cell.displayValue || cell.value || "",
+        quote: cell.quote,
+        startUtf16: cell.startUtf16,
+        endUtf16: cell.endUtf16,
+        sourceUrl: cell.sourceUrl
+      });
+
+      edges.push({
+        from: srcNode.id,
+        to: claimId,
+        relation: `utf16_[${cell.startUtf16}..${cell.endUtf16}]`
+      });
+    }
+  }
+
+  for (const unav of report.unavailableSources || []) {
+    ensureSourceNode(
+      unav.url,
+      `HTTP ${unav.statusCode || 503} Недоступен`,
+      null,
+      null,
+      null,
+      String(unav.statusCode || 503)
+    );
+  }
+
+  timelineEvents.sort((a, b) => String(a.date).localeCompare(String(b.date)));
+
+  const mermaidLines = [
+    "# Граф знаний происхождения данных и хронология источников (Mermaid)",
+    "",
+    `**Исследовательский вопрос:** ${question}`,
+    "",
+    "## 1. Направленный граф происхождения утверждений (`flowchart LR`)",
+    "```mermaid",
+    "flowchart LR",
+    `  ${qNodeId}["${sanitizeMermaidLabel(question)}"]`
+  ];
+
+  for (const node of nodes) {
+    if (node.kind === "source") {
+      mermaidLines.push(
+        `  ${node.id}["${sanitizeMermaidLabel(node.title)} (HTTP ${node.httpStatus}, eventDate: ${node.eventDate || "n/a"}, pageDate: ${node.pageDate || "n/a"})"]`
+      );
+    } else if (node.kind === "verified_claim") {
+      mermaidLines.push(
+        `  ${node.id}["${sanitizeMermaidLabel(node.optionName)} / ${sanitizeMermaidLabel(node.criterion)}: ${sanitizeMermaidLabel(node.value)} [${node.startUtf16}..${node.endUtf16}]"]`
+      );
+    }
+  }
+
+  for (const edge of edges) {
+    mermaidLines.push(`  ${edge.from} -->|${sanitizeMermaidLabel(edge.relation)}| ${edge.to}`);
+  }
+  mermaidLines.push("```", "");
+
+  mermaidLines.push(
+    "## 2. Хронологическая шкала дат источников (`timeline`)",
+    "```mermaid",
+    "timeline",
+    `  title Хронология источников (eventDate / pageDate)`
+  );
+  for (const ev of timelineEvents) {
+    mermaidLines.push(
+      `  ${ev.date} : ${sanitizeMermaidLabel(ev.title)} (${ev.dateKind})`
+    );
+  }
+  mermaidLines.push("```", "");
+
+  return {
+    question,
+    nodesCount: nodes.length,
+    edgesCount: edges.length,
+    timelineEventsCount: timelineEvents.length,
+    nodes,
+    edges,
+    timelineEvents,
+    markdownContent: mermaidLines.join("\n")
+  };
+}
+
+async function saveMermaidKnowledgeGraphViaWorkspace({
+  workspaceRoot,
+  slug = "research-knowledge-graph",
+  report = {},
+  signal = null
+} = {}) {
+  const graphBundle = buildResearchKnowledgeGraphAndMermaidReport(report);
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const markdownFile = await svc.createFile({
+    relativePath: `reports/${slug}.md`,
+    content: graphBundle.markdownContent,
+    createParents: true,
+    signal
+  });
+  const jsonFile = await svc.createFile({
+    relativePath: `reports/${slug}.json`,
+    content: JSON.stringify(graphBundle, null, 2) + "\n",
+    createParents: true,
+    signal
+  });
+
+  return {
+    graphBundle,
+    markdownFile,
+    jsonFile
+  };
+}
+
+module.exports = {
+  buildResearchKnowledgeGraphAndMermaidReport,
+  saveMermaidKnowledgeGraphViaWorkspace
+};
