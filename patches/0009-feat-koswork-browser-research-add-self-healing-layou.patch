diff --git a/desktop/windows/browser/self-healing-navigation.cjs b/desktop/windows/browser/self-healing-navigation.cjs
new file mode 100644
index 0000000..48cb79d
--- /dev/null
+++ b/desktop/windows/browser/self-healing-navigation.cjs
@@ -0,0 +1,133 @@
+"use strict";
+
+const { extractVerifiableExcerpt } = require("./document.cjs");
+const {
+  KosworkBrowserRecoveryError,
+  findRecoveryCandidates,
+  verifyObservationIntegrity
+} = require("./recovery.cjs");
+
+/**
+ * Koswork Self-Healing Layout Shift & Recovery Candidate Resolver
+ * (`desktop/windows/browser/self-healing-navigation.cjs`).
+ *
+ * Handles the common dynamic-page scenario where a harmless top banner, cookie notice, or
+ * lazy header insertion increments `pageVersion` and shifts UTF-16 offsets (`+N` code units)
+ * without mutating the target quote or interactive control's semantic identity:
+ * - Re-anchors the excerpt to its new exact UTF-16 offsets (`newStartUtf16`, `newEndUtf16`)
+ *   and issues a `recoveryReceipt`.
+ * - If the target text was actually substituted/altered (`OBSERVATION_TEXT_SUBSTITUTED`),
+ *   refuses to self-heal and propagates the error with ranked recovery candidates.
+ */
+
+function reanchorExcerptAfterHarmlessLayoutShift({
+  observedSnapshot,
+  currentSnapshot,
+  originalExcerpt,
+  userTakeoverTracker = null
+} = {}) {
+  if (!originalExcerpt || typeof originalExcerpt.quote !== "string") {
+    throw new Error("INVALID_ORIGINAL_EXCERPT_FOR_REANCHOR");
+  }
+
+  const integrity = verifyObservationIntegrity({
+    observedSnapshot,
+    currentSnapshot,
+    targetSpec: {
+      blockId: originalExcerpt.blockId,
+      startUtf16: originalExcerpt.startUtf16,
+      endUtf16: originalExcerpt.endUtf16,
+      expectedQuote: originalExcerpt.quote
+    },
+    userTakeoverTracker
+  });
+
+  const targetStart = integrity.recoveredShift
+    ? integrity.newStartUtf16
+    : originalExcerpt.startUtf16;
+  const targetEnd = integrity.recoveredShift
+    ? integrity.newEndUtf16
+    : originalExcerpt.endUtf16;
+
+  const updatedExcerpt = extractVerifiableExcerpt(currentSnapshot, {
+    startUtf16: targetStart,
+    endUtf16: targetEnd
+  });
+
+  return {
+    recoveredShift: Boolean(integrity.recoveredShift),
+    deltaUtf16: targetStart - originalExcerpt.startUtf16,
+    previousPageVersion: observedSnapshot.pageVersion,
+    currentPageVersion: currentSnapshot.pageVersion,
+    excerpt: updatedExcerpt
+  };
+}
+
+/**
+ * Resolves a control across page version updates using `findRecoveryCandidates`.
+ * Only accepts a recovery candidate if its confidence >= `minConfidence` (default 0.75)
+ * and its label was not semantically substituted.
+ */
+function resolveControlWithRecoveryCandidates({
+  observedSnapshot,
+  currentSnapshot,
+  targetControlSpec = {},
+  minConfidence = 0.75,
+  userTakeoverTracker = null
+} = {}) {
+  if (userTakeoverTracker && observedSnapshot) {
+    userTakeoverTracker.assertObservationValid(
+      observedSnapshot.tabId,
+      observedSnapshot.userEpoch
+    );
+  }
+
+  const candidates = findRecoveryCandidates(
+    {
+      kind: "control",
+      id: targetControlSpec.id,
+      name: targetControlSpec.name,
+      role: targetControlSpec.role,
+      label: targetControlSpec.label,
+      expectedText: targetControlSpec.label,
+      deepSelector: targetControlSpec.deepSelector
+    },
+    currentSnapshot
+  );
+
+  if (candidates.length === 0 || candidates[0].confidence < minConfidence) {
+    throw new KosworkBrowserRecoveryError(
+      "RECOVERY_CANDIDATE_BELOW_THRESHOLD",
+      `Не удалось однозначно восстановить привязку к элементу "${
+        targetControlSpec.id || targetControlSpec.label
+      }" после изменения страницы.`,
+      {
+        targetControlSpec,
+        candidates
+      }
+    );
+  }
+
+  const best = candidates[0];
+  if (targetControlSpec.label && best.textSimilarity < 0.65) {
+    throw new KosworkBrowserRecoveryError(
+      "OBSERVATION_TEXT_SUBSTITUTED",
+      `Подпись элемента "${best.candidateId}" была изменена с "${targetControlSpec.label}" на "${best.actualText}".`,
+      {
+        targetControlSpec,
+        bestCandidate: best
+      }
+    );
+  }
+
+  return {
+    recovered: true,
+    selectedCandidate: best,
+    alternates: candidates.slice(1)
+  };
+}
+
+module.exports = {
+  reanchorExcerptAfterHarmlessLayoutShift,
+  resolveControlWithRecoveryCandidates
+};
diff --git a/desktop/windows/browser/synthetic-filter-workflow.cjs b/desktop/windows/browser/synthetic-filter-workflow.cjs
new file mode 100644
index 0000000..f66cfa4
--- /dev/null
+++ b/desktop/windows/browser/synthetic-filter-workflow.cjs
@@ -0,0 +1,118 @@
+"use strict";
+
+const {
+  ingestDownloadedSourceIntoResearchSnapshot
+} = require("./downloaded-source-ingestor.cjs");
+
+/**
+ * Koswork Interactive Synthetic Form Filter, Post-Submit Verification & Download Ingestor Workflow
+ * (`desktop/windows/browser/synthetic-filter-workflow.cjs`).
+ *
+ * Implements the full interactive form research procedure on synthetic/local sites:
+ * 1. Navigates to the form/catalog page (`engine.navigate`).
+ * 2. Pauses immediately (`status: "paused_for_user"`) if CAPTCHA or login gate is detected.
+ * 3. Fills filter/form fields (`engine.fillForm`) and optionally attaches allowed workspace files (`engine.selectFiles`).
+ * 4. Submits the form (`engine.submitForm`) and verifies the post-submit DOM mutation effect (`effectVerified === true`).
+ * 5. Extracts UTF-16 excerpts from the post-submit DOM snapshot (`engine.extractExcerpt`).
+ * 6. Optionally downloads the resulting specification file into the allowed workspace folder (`engine.downloadFromPage`)
+ *    and ingests it into a versioned UTF-16 snapshot (`ingestDownloadedSourceIntoResearchSnapshot`).
+ */
+async function executeInteractiveFormFilterAndExtractWorkflow({
+  engine,
+  tabId = null,
+  url,
+  fields = {},
+  fileAttachments = null, // { controlId, filePaths }
+  submitControlId = null,
+  extractTerms = [],
+  downloadSpec = null, // { downloadControlId, filename, extractTerm }
+  signal = null
+} = {}) {
+  if (!engine) {
+    throw new Error("BROWSER_ENGINE_REQUIRED_FOR_FILTER_WORKFLOW");
+  }
+
+  const navResult = await engine.navigate({
+    tabId,
+    url,
+    actor: "agent",
+    signal
+  });
+
+  if (navResult.status === "paused_for_user") {
+    return {
+      status: "paused_for_user",
+      tabId: navResult.tabId,
+      url: navResult.url,
+      authGate: navResult.authGate
+    };
+  }
+
+  const activeTabId = navResult.tabId;
+
+  let attachedFilesResult = null;
+  if (fileAttachments && fileAttachments.controlId && Array.isArray(fileAttachments.filePaths)) {
+    attachedFilesResult = engine.selectFiles({
+      tabId: activeTabId,
+      controlId: fileAttachments.controlId,
+      filePaths: fileAttachments.filePaths
+    });
+  }
+
+  const fillResult = engine.fillForm({
+    tabId: activeTabId,
+    fields
+  });
+
+  const submitResult = await engine.submitForm({
+    tabId: activeTabId,
+    submitControlId
+  });
+
+  const postSubmitExcerpts = [];
+  for (const term of extractTerms) {
+    const exc = engine.extractExcerpt(activeTabId, { searchTerm: term });
+    if (exc) {
+      postSubmitExcerpts.push(exc);
+    }
+  }
+
+  let downloadedSource = null;
+  if (downloadSpec) {
+    const dlRecord = await engine.downloadFromPage({
+      tabId: activeTabId,
+      downloadControlId: downloadSpec.downloadControlId || null,
+      filename: downloadSpec.filename || "filtered-export.txt"
+    });
+    const ingested = ingestDownloadedSourceIntoResearchSnapshot(dlRecord, {
+      pageDate: submitResult.snapshot.pageDate,
+      eventDate: submitResult.snapshot.eventDate
+    });
+    const downloadedExcerpt = downloadSpec.extractTerm
+      ? ingested.extractExcerpt({ searchTerm: downloadSpec.extractTerm })
+      : null;
+
+    downloadedSource = {
+      downloadRecord: dlRecord,
+      snapshot: ingested.snapshot,
+      excerpt: downloadedExcerpt
+    };
+  }
+
+  return {
+    status: submitResult.effectVerified ? "completed" : "no_effect_detected",
+    tabId: activeTabId,
+    url: navResult.url,
+    effectVerified: submitResult.effectVerified,
+    domVerification: submitResult.effectVerification,
+    attachedFiles: attachedFilesResult ? attachedFilesResult.attachedFiles : [],
+    fillResult,
+    submitResult,
+    postSubmitExcerpts,
+    downloadedSource
+  };
+}
+
+module.exports = {
+  executeInteractiveFormFilterAndExtractWorkflow
+};
