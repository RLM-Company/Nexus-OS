diff --git a/desktop/windows/browser/structured-matrix-extractor.cjs b/desktop/windows/browser/structured-matrix-extractor.cjs
new file mode 100644
index 0000000..8b929aa
--- /dev/null
+++ b/desktop/windows/browser/structured-matrix-extractor.cjs
@@ -0,0 +1,211 @@
+"use strict";
+
+const { extractVerifiableExcerpt } = require("./document.cjs");
+
+/**
+ * Koswork Structured HTML Matrix (`<table>`) & Definition-List (`<dl>/<dt>/<dd>`) Specification Extractor
+ * (`desktop/windows/browser/structured-matrix-extractor.cjs`).
+ *
+ * Deepens Requirement #2 & #3:
+ * - Extracts structured `(optionName, criterion, value)` cells directly from HTML comparison
+ *   tables (`<table>` in either row-per-option or column-per-option orientation) and `<dl>/<dt>/<dd>`
+ *   specification blocks on an open page snapshot.
+ * - Binds every extracted cell to a verifiable UTF-16 excerpt (`startUtf16`, `endUtf16`, `quote`)
+ *   inside `snapshot.fullTextUtf16` and preserves distinct `pageDate`, `eventDate`, and `fetchedAt`.
+ */
+
+function parseDefinitionListPairsFromHtml(html = "") {
+  const pairs = [];
+  const dlRegex = /<dl\b[^>]*>([\s\S]*?)<\/dl>/gi;
+  let dlMatch;
+  while ((dlMatch = dlRegex.exec(String(html || ""))) !== null) {
+    const inner = dlMatch[1];
+    const itemRegex = /<dt\b[^>]*>([\s\S]*?)<\/dt>\s*<dd\b[^>]*>([\s\S]*?)<\/dd>/gi;
+    let m;
+    while ((m = itemRegex.exec(inner)) !== null) {
+      const term = m[1].replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
+      const def = m[2].replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
+      if (term && def) {
+        pairs.push({ criterion: term, value: def });
+      }
+    }
+  }
+  return pairs;
+}
+
+function extractStructuredSpecsFromSnapshot({
+  snapshot,
+  rawHtml = "",
+  defaultOptionName = "Option",
+  targetOptions = [],
+  targetCriteria = []
+} = {}) {
+  if (!snapshot || !snapshot.fullTextUtf16) {
+    throw new Error("STRUCTURED_MATRIX_EXTRACTOR_REQUIRES_SNAPSHOT");
+  }
+
+  const extractedClaims = [];
+  const optionFilter = new Set(
+    (Array.isArray(targetOptions) ? targetOptions : []).map((o) => String(o).toLowerCase())
+  );
+  const criteriaFilter = new Set(
+    (Array.isArray(targetCriteria) ? targetCriteria : []).map((c) => String(c).toLowerCase())
+  );
+
+  const matchesOption = (cand) =>
+    optionFilter.size === 0 || optionFilter.has(String(cand || "").toLowerCase());
+  const matchesCriterion = (cand) =>
+    criteriaFilter.size === 0 || criteriaFilter.has(String(cand || "").toLowerCase());
+
+  // 1. Inspect `snapshot.tables` (already parsed with UTF-16 cell offsets by `document.cjs`)
+  for (const tbl of snapshot.tables || []) {
+    const headers = (tbl.headers || []).map((h) => String(h || "").trim());
+    const rows = tbl.rows || [];
+    if (headers.length < 2 || rows.length === 0) continue;
+
+    // Detect orientation:
+    // Case A (Row-per-option): headers = ["Вариант", "Цена", "SLA", ...], row[0] = Option Alpha
+    // Case B (Column-per-option): headers = ["Критерий", "Option Alpha", "Option Beta"], row[0] = "Цена"
+    const headerHasOptionNames =
+      optionFilter.size > 0 &&
+      headers.slice(1).some((h) => optionFilter.has(h.toLowerCase()));
+
+    if (headerHasOptionNames) {
+      // Column-per-option matrix
+      for (const row of rows) {
+        const cells = Array.isArray(row.cells) ? row.cells : [];
+        if (cells.length < 2) continue;
+        const criterionName = String(cells[0].text || "").trim();
+        if (!criterionName || !matchesCriterion(criterionName)) continue;
+
+        for (let colIdx = 1; colIdx < Math.min(headers.length, cells.length); colIdx += 1) {
+          const optionName = headers[colIdx];
+          if (!matchesOption(optionName)) continue;
+          const cell = cells[colIdx];
+          const valText = String(cell.text || "").trim();
+          if (!valText) continue;
+
+          const excerpt =
+            extractVerifiableExcerpt(snapshot, {
+              startUtf16: cell.startUtf16,
+              endUtf16: cell.endUtf16
+            }) ||
+            extractVerifiableExcerpt(snapshot, {
+              searchTerm: valText
+            });
+
+          if (excerpt) {
+            extractedClaims.push({
+              claimId: `tbl-col-${extractedClaims.length + 1}`,
+              optionName,
+              criterion: criterionName,
+              value: valText,
+              claim: `${optionName}: ${criterionName} = ${valText}`,
+              extractionKind: "html_table_column_matrix",
+              excerpt,
+              source: {
+                url: snapshot.url,
+                title: snapshot.title,
+                pageDate: snapshot.pageDate,
+                eventDate: snapshot.eventDate,
+                fetchedAt: snapshot.fetchedAt
+              }
+            });
+          }
+        }
+      }
+    } else {
+      // Row-per-option matrix
+      for (const row of rows) {
+        const cells = Array.isArray(row.cells) ? row.cells : [];
+        if (cells.length < 2) continue;
+        const optionName = String(cells[0].text || "").trim();
+        if (!optionName || !matchesOption(optionName)) continue;
+
+        for (let colIdx = 1; colIdx < Math.min(headers.length, cells.length); colIdx += 1) {
+          const criterionName = headers[colIdx];
+          if (!criterionName || !matchesCriterion(criterionName)) continue;
+          const cell = cells[colIdx];
+          const valText = String(cell.text || "").trim();
+          if (!valText) continue;
+
+          const excerpt =
+            extractVerifiableExcerpt(snapshot, {
+              startUtf16: cell.startUtf16,
+              endUtf16: cell.endUtf16
+            }) ||
+            extractVerifiableExcerpt(snapshot, {
+              searchTerm: valText
+            });
+
+          if (excerpt) {
+            extractedClaims.push({
+              claimId: `tbl-row-${extractedClaims.length + 1}`,
+              optionName,
+              criterion: criterionName,
+              value: valText,
+              claim: `${optionName}: ${criterionName} = ${valText}`,
+              extractionKind: "html_table_row_matrix",
+              excerpt,
+              source: {
+                url: snapshot.url,
+                title: snapshot.title,
+                pageDate: snapshot.pageDate,
+                eventDate: snapshot.eventDate,
+                fetchedAt: snapshot.fetchedAt
+              }
+            });
+          }
+        }
+      }
+    }
+  }
+
+  // 2. Inspect `<dl><dt>...</dt><dd>...</dd></dl>` specification blocks if `rawHtml` is provided
+  if (rawHtml) {
+    const dlPairs = parseDefinitionListPairsFromHtml(rawHtml);
+    for (const pair of dlPairs) {
+      if (!matchesCriterion(pair.criterion)) continue;
+      if (!matchesOption(defaultOptionName)) continue;
+
+      const excerpt =
+        extractVerifiableExcerpt(snapshot, {
+          searchTerm: `${pair.criterion} | ${pair.value}`
+        }) ||
+        extractVerifiableExcerpt(snapshot, {
+          searchTerm: pair.value
+        });
+
+      if (excerpt) {
+        extractedClaims.push({
+          claimId: `dl-spec-${extractedClaims.length + 1}`,
+          optionName: defaultOptionName,
+          criterion: pair.criterion,
+          value: pair.value,
+          claim: `${defaultOptionName}: ${pair.criterion} = ${pair.value}`,
+          extractionKind: "html_dl_definition_list",
+          excerpt,
+          source: {
+            url: snapshot.url,
+            title: snapshot.title,
+            pageDate: snapshot.pageDate,
+            eventDate: snapshot.eventDate,
+            fetchedAt: snapshot.fetchedAt
+          }
+        });
+      }
+    }
+  }
+
+  return {
+    url: snapshot.url,
+    pageVersion: snapshot.pageVersion,
+    extractedCount: extractedClaims.length,
+    claims: extractedClaims
+  };
+}
+
+module.exports = {
+  parseDefinitionListPairsFromHtml,
+  extractStructuredSpecsFromSnapshot
+};
diff --git a/desktop/windows/browser/work-executor-sqlite-bridge.cjs b/desktop/windows/browser/work-executor-sqlite-bridge.cjs
new file mode 100644
index 0000000..088e0a4
--- /dev/null
+++ b/desktop/windows/browser/work-executor-sqlite-bridge.cjs
@@ -0,0 +1,153 @@
+"use strict";
+
+/**
+ * Koswork Work Executor <-> SQLite / API Session Sync Bridge
+ * (`desktop/windows/browser/work-executor-sqlite-bridge.cjs`).
+ *
+ * Bridges the desktop Browser Research Cycle (`executeMultiSiteResearchWorkflow` /
+ * `KosworkUnifiedTaskCoordinator`) with the backend SQLite schema `0064_koswork_browser_research.sql`
+ * and Fastify API routes (`/api/koswork/browser-research/sessions`):
+ * 1. Serializes a completed or paused desktop research cycle into the exact payload
+ *    contract expected by `KosworkBrowserResearchSessionStore` (`packages/db/src/browser-research-session-store.ts`)
+ *    and `packages/contracts/src/koswork-browser-research.ts`.
+ * 2. Enforces the contract invariant that every `"confirmed"` claim carries a non-empty
+ *    `excerpt` (`startUtf16`, `endUtf16`, `quote`) and distinct `pageDate`, `eventDate`, and `fetchedAt`.
+ */
+
+function buildApiSyncBundleFromDesktopCycle(cycleResult = {}, options = {}) {
+  if (!cycleResult || typeof cycleResult !== "object") {
+    throw new Error("API_SYNC_BRIDGE_REQUIRES_CYCLE_RESULT");
+  }
+
+  const sessionId =
+    options.sessionId ||
+    cycleResult.sessionId ||
+    `brs-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
+
+  const searchRecords = (cycleResult.searchHistory || []).map((s, idx) => ({
+    searchId: s.searchId || `srch-${idx + 1}`,
+    query: s.query || cycleResult.question || "",
+    actor: s.actor === "user" ? "user" : "agent",
+    providerId: s.providerId || "duckduckgo-html",
+    providerEndpoint: s.providerEndpoint || "https://html.duckduckgo.com/html/",
+    totalResults: Number(s.totalResults ?? (s.results || s.items || []).length),
+    searchedAt: s.searchedAt || new Date().toISOString()
+  }));
+
+  const sources = (cycleResult.sources || []).map((src, idx) => ({
+    sourceId: src.sourceVisitId || src.sourceId || `src-${idx + 1}`,
+    searchId: src.searchId || (searchRecords[0] ? searchRecords[0].searchId : null),
+    serpRank: src.serpRank ?? idx + 1,
+    url: src.url,
+    canonicalUrl: src.canonicalUrl || src.url,
+    title: src.title || src.url,
+    httpStatus: Number(src.httpStatus ?? 200),
+    available: Boolean(src.available),
+    pageVersion: Number(src.pageVersion ?? 1),
+    snapshotId: src.snapshotId || `snap-${idx + 1}`,
+    contentSha256: src.contentSha256 || null,
+    tabReceiptId: src.tabReceipt?.receiptId || src.tabReceiptId || null,
+    pageDate: src.pageDate || null,
+    eventDate: src.eventDate || null,
+    fetchedAt: src.fetchedAt || new Date().toISOString()
+  }));
+
+  const confirmedClaims =
+    cycleResult.savedReports?.confirmedClaims || cycleResult.confirmedClaims || [];
+  const unconfirmedClaims =
+    cycleResult.savedReports?.unconfirmedClaims || cycleResult.unconfirmedClaims || [];
+
+  const excerpts = [];
+  const claims = [];
+
+  for (let i = 0; i < confirmedClaims.length; i += 1) {
+    const c = confirmedClaims[i];
+    const exc = c.excerpt;
+    const src = c.source || {};
+    const matchedSource =
+      sources.find((s) => s.url === src.url || s.canonicalUrl === src.url) || sources[0];
+
+    const excerptId = exc?.excerptId || `exc-${i + 1}`;
+    if (exc && exc.quote) {
+      excerpts.push({
+        excerptId,
+        sourceId: matchedSource ? matchedSource.sourceId : `src-ext-${i + 1}`,
+        url: src.url || matchedSource?.url || "",
+        pageVersion: Number(exc.pageVersion ?? matchedSource?.pageVersion ?? 1),
+        snapshotId: exc.snapshotId || matchedSource?.snapshotId || `snap-${i + 1}`,
+        startUtf16: Number(exc.startUtf16 ?? 0),
+        endUtf16: Number(exc.endUtf16 ?? exc.quote.length),
+        lengthUtf16: Number(exc.lengthUtf16 ?? exc.quote.length),
+        quote: exc.quote,
+        pageDate: src.pageDate ?? matchedSource?.pageDate ?? null,
+        eventDate: src.eventDate ?? matchedSource?.eventDate ?? null,
+        fetchedAt: src.fetchedAt ?? matchedSource?.fetchedAt ?? new Date().toISOString()
+      });
+    }
+
+    claims.push({
+      claimId: c.claimId || `claim-${i + 1}`,
+      optionName: c.optionName || null,
+      criterion: c.criterion || null,
+      valueText: String(c.value ?? ""),
+      claimText: c.claim,
+      verificationStatus: "confirmed",
+      excerptId,
+      sourceId: matchedSource ? matchedSource.sourceId : null,
+      sourceUrl: src.url || matchedSource?.url || null,
+      conflictNote: c.conflictNote || null
+    });
+  }
+
+  for (let j = 0; j < unconfirmedClaims.length; j += 1) {
+    const u = unconfirmedClaims[j];
+    claims.push({
+      claimId: u.claimId || `unconf-claim-${j + 1}`,
+      optionName: u.optionName || null,
+      criterion: u.criterion || null,
+      valueText: String(u.value ?? ""),
+      claimText: u.claim || "Неподтверждённое утверждение",
+      verificationStatus: "unconfirmed_bare_link_rejected",
+      excerptId: null,
+      sourceId: null,
+      sourceUrl: u.source?.url || u.sourceUrl || null,
+      conflictNote: u.rejectionReason || "Ссылка без верифицированной UTF-16 выдержки"
+    });
+  }
+
+  return {
+    schemaVersion: "koswork.browser-research.api-sync.v1",
+    sessionId,
+    question: cycleResult.question || options.question || "",
+    status: cycleResult.status || "completed",
+    criteria: cycleResult.criteria || options.criteria || [],
+    searches: searchRecords,
+    sources,
+    excerpts,
+    claims,
+    contradictions: cycleResult.contradictions || [],
+    outdatedFindings: cycleResult.outdatedFindings || [],
+    unavailableSources: cycleResult.unavailableSources || [],
+    substitutionIncidents: cycleResult.substitutionIncidents || [],
+    reportPaths: cycleResult.savedReports
+      ? {
+          markdownPath: cycleResult.savedReports.markdownFile?.path || null,
+          htmlPath: cycleResult.savedReports.htmlFile?.path || null,
+          csvPath: cycleResult.savedReports.csvFile?.path || null,
+          jsonPath: cycleResult.savedReports.comparisonTableFile?.path || null,
+          provPath: cycleResult.savedReports.provFile?.path || null,
+          bibPath: cycleResult.savedReports.bibFile?.path || null,
+          docxPath: cycleResult.savedReports.docxFile?.relativePath || null,
+          xlsxPath: cycleResult.savedReports.xlsxFile?.relativePath || null,
+          pdfPath: cycleResult.savedReports.pdfFile?.relativePath || null,
+          pptxPath: cycleResult.savedReports.pptxFile?.relativePath || null
+        }
+      : null,
+    resourceMetrics: cycleResult.resourceMetrics || null,
+    exportedAt: new Date().toISOString()
+  };
+}
+
+module.exports = {
+  buildApiSyncBundleFromDesktopCycle
+};
