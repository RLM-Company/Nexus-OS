diff --git a/desktop/windows/browser/changelog-semver-timeline-analyzer.cjs b/desktop/windows/browser/changelog-semver-timeline-analyzer.cjs
new file mode 100644
index 0000000..fe23364
--- /dev/null
+++ b/desktop/windows/browser/changelog-semver-timeline-analyzer.cjs
@@ -0,0 +1,130 @@
+"use strict";
+
+/**
+ * Koswork SemVer Release Changelog & Breaking-Change Timeline Analyzer
+ * (`desktop/windows/browser/changelog-semver-timeline-analyzer.cjs`).
+ *
+ * Deepens Requirements #2, #3 & #5:
+ * - Extracts semantic version release blocks (`v1.0.0` .. `v4.2.0 (2026-11-01)`) from
+ *   changelog pages with per-release `eventDate` (distinct from `pageDate` and `fetchedAt`),
+ *   exact UTF-16 `[startUtf16..endUtf16]` offsets, CVE security identifiers, and
+ *   breaking-change / deprecation markers.
+ * - Compares feature/API claims across SemVer releases to detect when an older release's
+ *   claim (`v3.x`) has been superseded or removed by a newer release (`v4.x`).
+ */
+
+function parseSemverTuple(verStr = "") {
+  const m = String(verStr || "")
+    .trim()
+    .replace(/^v/i, "")
+    .match(/^(\d+)\.(\d+)\.(\d+)/);
+  if (!m) return [0, 0, 0];
+  return [Number(m[1]), Number(m[2]), Number(m[3])];
+}
+
+function compareSemverStrings(a = "", b = "") {
+  const [aMaj, aMin, aPat] = parseSemverTuple(a);
+  const [bMaj, bMin, bPat] = parseSemverTuple(b);
+  if (aMaj !== bMaj) return aMaj - bMaj;
+  if (aMin !== bMin) return aMin - bMin;
+  return aPat - bPat;
+}
+
+function extractSemverReleaseChangelog(snapshot = {}) {
+  const fullText = String(snapshot.fullTextUtf16 || snapshot.text || "");
+  const headerRe =
+    /(?:^|\n|\s)(v?\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?)\s*(?:\(|—|-|от)?\s*(\d{4}-\d{2}-\d{2})?\s*\)?/g;
+
+  const headers = [];
+  let m;
+  while ((m = headerRe.exec(fullText)) !== null) {
+    const version = m[1].startsWith("v") ? m[1] : `v${m[1]}`;
+    const releaseEventDate = m[2] || snapshot.eventDate || null;
+    const matchText = m[0].trim();
+    const startIdx = fullText.indexOf(matchText, m.index);
+    headers.push({
+      version,
+      releaseEventDate,
+      headerStartUtf16: startIdx >= 0 ? startIdx : m.index
+    });
+  }
+
+  const releases = [];
+  for (let i = 0; i < headers.length; i += 1) {
+    const cur = headers[i];
+    const nextStart =
+      i + 1 < headers.length ? headers[i + 1].headerStartUtf16 : fullText.length;
+    const blockQuote = fullText.slice(cur.headerStartUtf16, nextStart).trim();
+    const startUtf16 = cur.headerStartUtf16;
+    const endUtf16 = startUtf16 + blockQuote.length;
+
+    const hasBreakingChange =
+      /BREAKING\s+CHANGE|несовместим|удален|deprecated|устарел/iu.test(blockQuote);
+    const cveMatches = blockQuote.match(/\bCVE-\d{4}-\d{4,7}\b/gi) || [];
+
+    releases.push({
+      version: cur.version,
+      eventDate: cur.releaseEventDate,
+      pageDate: snapshot.pageDate || null,
+      fetchedAt: snapshot.fetchedAt || null,
+      url: snapshot.url || "",
+      quote: blockQuote,
+      startUtf16,
+      endUtf16,
+      hasBreakingChange,
+      cves: Array.from(new Set(cveMatches.map((c) => c.toUpperCase())))
+    });
+  }
+
+  releases.sort((a, b) => compareSemverStrings(b.version, a.version));
+
+  return {
+    url: snapshot.url || "",
+    title: snapshot.title || "",
+    pageDate: snapshot.pageDate || null,
+    fetchedAt: snapshot.fetchedAt || null,
+    latestVersion: releases[0] ? releases[0].version : null,
+    releasesCount: releases.length,
+    releases
+  };
+}
+
+function verifyBreakingChangesAndDeprecationsAcrossVersions({
+  snapshot = {},
+  featureKeyword = ""
+} = {}) {
+  const parsed = extractSemverReleaseChangelog(snapshot);
+  const kwLower = String(featureKeyword || "").trim().toLowerCase();
+
+  const matchingReleases = parsed.releases.filter((r) =>
+    !kwLower ? true : r.quote.toLowerCase().includes(kwLower)
+  );
+
+  if (matchingReleases.length === 0) {
+    return {
+      found: false,
+      status: "feature_not_mentioned_in_changelog",
+      latestRelease: null,
+      supersededReleases: []
+    };
+  }
+
+  const newest = matchingReleases[0];
+  const older = matchingReleases.slice(1);
+
+  return {
+    found: true,
+    status:
+      older.length > 0 && newest.hasBreakingChange
+        ? "SUPERSEDED_BY_NEWER_SEMVER_RELEASE"
+        : "ACTIVE_IN_LATEST_SEMVER_RELEASE",
+    latestRelease: newest,
+    supersededReleases: older
+  };
+}
+
+module.exports = {
+  compareSemverStrings,
+  extractSemverReleaseChangelog,
+  verifyBreakingChangesAndDeprecationsAcrossVersions
+};
diff --git a/desktop/windows/browser/content-disposition-and-mime-sniff-guard.cjs b/desktop/windows/browser/content-disposition-and-mime-sniff-guard.cjs
new file mode 100644
index 0000000..b5314b8
--- /dev/null
+++ b/desktop/windows/browser/content-disposition-and-mime-sniff-guard.cjs
@@ -0,0 +1,138 @@
+"use strict";
+
+const path = require("node:path");
+const crypto = require("node:crypto");
+const {
+  KosworkBrowserPolicyError,
+  resolveAllowedDownloadTarget
+} = require("./policy.cjs");
+
+/**
+ * Koswork Content-Disposition Parser & Magic-Byte MIME Sniffing Guard
+ * (`desktop/windows/browser/content-disposition-and-mime-sniff-guard.cjs`).
+ *
+ * Deepens Requirement #4:
+ * - Parses RFC 6266 / RFC 5987 `Content-Disposition` headers (`filename*=UTF-8''...` and
+ *   `filename="..."`) to determine the safe download filename inside the allowed workspace folder.
+ * - Inspects the first bytes (magic numbers) of downloaded content buffers to block disguised
+ *   Windows PE executables (`0x4D 0x5A` "MZ"), ELF binaries (`0x7F 'E' 'L' 'F'`), and shell/script
+ *   shebangs (`#!`) masquerading under safe `.txt`, `.csv`, or `.pdf` filenames
+ *   (`BROWSER_DISGUISED_EXECUTABLE_PAYLOAD`).
+ */
+
+function parseContentDispositionFilename(headerValue = "", fallbackName = "download.txt") {
+  const raw = String(headerValue || "").trim();
+  if (!raw) return fallbackName;
+
+  // 1. Check RFC 5987 filename*=UTF-8''...
+  const starMatch = raw.match(/filename\*\s*=\s*UTF-8''([^;\r\n]+)/i);
+  if (starMatch && starMatch[1]) {
+    try {
+      return path.basename(decodeURIComponent(starMatch[1].trim()));
+    } catch (_) {
+      return path.basename(starMatch[1].trim());
+    }
+  }
+
+  // 2. Check quoted or unquoted filename="..."
+  const fnMatch = raw.match(/filename\s*=\s*(?:"([^"]+)"|'([^']+)'|([^;\s\r\n]+))/i);
+  if (fnMatch) {
+    const candidate = fnMatch[1] || fnMatch[2] || fnMatch[3] || fallbackName;
+    return path.basename(candidate.trim());
+  }
+
+  return fallbackName;
+}
+
+function sniffBinaryMagicSignature(buffer) {
+  const buf = Buffer.isBuffer(buffer)
+    ? buffer
+    : Buffer.from(String(buffer ?? ""), "utf8");
+
+  if (buf.length >= 2 && buf[0] === 0x4d && buf[1] === 0x5a) {
+    return { kind: "windows_pe_mz", executable: true };
+  }
+  if (
+    buf.length >= 4 &&
+    buf[0] === 0x7f &&
+    buf[1] === 0x45 &&
+    buf[2] === 0x4c &&
+    buf[3] === 0x46
+  ) {
+    return { kind: "linux_elf_binary", executable: true };
+  }
+  if (buf.length >= 2 && buf[0] === 0x23 && buf[1] === 0x21) {
+    return { kind: "script_shebang", executable: true };
+  }
+  if (
+    buf.length >= 5 &&
+    buf.slice(0, 5).toString("ascii") === "%PDF-"
+  ) {
+    return { kind: "pdf_document", executable: false };
+  }
+  if (
+    buf.length >= 4 &&
+    buf[0] === 0x50 &&
+    buf[1] === 0x4b &&
+    buf[2] === 0x03 &&
+    buf[3] === 0x04
+  ) {
+    return { kind: "zip_or_ooxml_container", executable: false };
+  }
+  return { kind: "plain_text_or_data", executable: false };
+}
+
+function verifyDownloadContentDispositionAndMagicBytes({
+  workspaceRoot,
+  subDir = "downloads",
+  contentDispositionHeader = "",
+  fallbackFilename = "download.txt",
+  declaredMimeType = "text/plain",
+  contentBuffer = Buffer.alloc(0)
+} = {}) {
+  const extractedFilename = parseContentDispositionFilename(
+    contentDispositionHeader,
+    fallbackFilename
+  );
+
+  const allowedDownloadDir = path.join(String(workspaceRoot || ""), subDir);
+  const target = resolveAllowedDownloadTarget(extractedFilename, {
+    allowedDownloadDir,
+    allowedWorkspaceRoot: workspaceRoot
+  });
+
+  const buf = Buffer.isBuffer(contentBuffer)
+    ? contentBuffer
+    : Buffer.from(String(contentBuffer ?? ""), "utf8");
+
+  const sniffed = sniffBinaryMagicSignature(buf);
+  if (sniffed.executable) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_DISGUISED_EXECUTABLE_PAYLOAD",
+      `Загружаемый файл "${target.filename}" содержит сигнатуру исполняемого кода (${sniffed.kind}), замаскированную под документ.`,
+      {
+        filename: target.filename,
+        declaredMimeType,
+        sniffedKind: sniffed.kind
+      }
+    );
+  }
+
+  const sha256 = crypto.createHash("sha256").update(buf).digest("hex");
+
+  return {
+    allowed: true,
+    filename: target.filename,
+    targetPath: target.targetPath,
+    declaredMimeType,
+    sniffedKind: sniffed.kind,
+    byteLength: buf.byteLength,
+    sha256
+  };
+}
+
+module.exports = {
+  parseContentDispositionFilename,
+  sniffBinaryMagicSignature,
+  verifyDownloadContentDispositionAndMagicBytes
+};
diff --git a/desktop/windows/browser/ro-crate-research-object-exporter.cjs b/desktop/windows/browser/ro-crate-research-object-exporter.cjs
new file mode 100644
index 0000000..3062b0c
--- /dev/null
+++ b/desktop/windows/browser/ro-crate-research-object-exporter.cjs
@@ -0,0 +1,155 @@
+"use strict";
+
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork W3C / ResearchObject.org RO-Crate 1.1 JSON-LD Exporter
+ * (`desktop/windows/browser/ro-crate-research-object-exporter.cjs`).
+ *
+ * Deepens Requirements #1, #3 & #5:
+ * - Packages a multi-site research session into a standard RO-Crate 1.1 JSON-LD
+ *   Metadata Descriptor (`reports/<slug>-ro-crate-metadata.json`) via `workspace-service.cjs`.
+ * - Preserves:
+ *   1. Explicit search adapter provenance (`CreateAction` -> `instrument` with `providerId`).
+ *   2. Opened `WebPage` entities with distinct `datePublished` (`pageDate`),
+ *      `temporalCoverage` (`eventDate`), and `sdDatePublished` (`fetchedAt`).
+ *   3. Verifiable `Quotation` entities with verbatim `text` (`quote`) and exact
+ *      UTF-16 range (`position: "UTF-16 [startUtf16..endUtf16]"`).
+ */
+
+function buildRoCrateMetadataDescriptor({
+  report = {},
+  searchAdapterId = "koswork-configured-search",
+  searchAdapterName = "Configured Search Engine Adapter"
+} = {}) {
+  const question = report.question || "Многосайтовое исследование Koswork Browser";
+  const graph = [
+    {
+      "@id": "ro-crate-metadata.json",
+      "@type": "CreativeWork",
+      conformsTo: { "@id": "https://w3id.org/ro/crate/1.1" },
+      about: { "@id": "./" }
+    },
+    {
+      "@id": "./",
+      "@type": "Dataset",
+      name: question,
+      description:
+        "Верифицированный исследовательский пакет Koswork Browser с UTF-16 выдержками и триадой дат (pageDate, eventDate, fetchedAt).",
+      datePublished: new Date().toISOString(),
+      hasPart: [],
+      mentions: []
+    },
+    {
+      "@id": `#instrument-${searchAdapterId}`,
+      "@type": "SoftwareApplication",
+      identifier: searchAdapterId,
+      name: searchAdapterName
+    },
+    {
+      "@id": "#research-execution-action",
+      "@type": "CreateAction",
+      name: `Выполнение исследовательского цикла: ${question}`,
+      instrument: { "@id": `#instrument-${searchAdapterId}` },
+      result: { "@id": "./" }
+    }
+  ];
+
+  const rootDataset = graph[1];
+  const seenSources = new Set();
+  let quoteCounter = 1;
+
+  for (const row of report.comparisonRows || []) {
+    const optionName = row.optionName || "Option";
+    for (const [criterion, cell] of Object.entries(row.cells || {})) {
+      if (!cell || !cell.quote || !Number.isInteger(cell.startUtf16) || cell.startUtf16 < 0) {
+        continue;
+      }
+      const sourceUrl = String(cell.sourceUrl || "https://corpus.local/unknown");
+      if (!seenSources.has(sourceUrl)) {
+        seenSources.add(sourceUrl);
+        rootDataset.hasPart.push({ "@id": sourceUrl });
+        graph.push({
+          "@id": sourceUrl,
+          "@type": "WebPage",
+          name: cell.sourceTitle || sourceUrl,
+          url: sourceUrl,
+          datePublished: cell.pageDate || null,
+          temporalCoverage: cell.eventDate || null,
+          sdDatePublished: cell.fetchedAt || null
+        });
+      }
+
+      const quoteId = `#quotation-${quoteCounter}`;
+      quoteCounter += 1;
+      rootDataset.mentions.push({ "@id": quoteId });
+      graph.push({
+        "@id": quoteId,
+        "@type": "Quotation",
+        name: `${optionName} — ${criterion}: ${cell.displayValue || cell.value || ""}`,
+        text: cell.quote,
+        position: `UTF-16 [${cell.startUtf16}..${cell.endUtf16}]`,
+        startUtf16: cell.startUtf16,
+        endUtf16: cell.endUtf16,
+        isBasedOn: { "@id": sourceUrl },
+        pageDate: cell.pageDate || null,
+        eventDate: cell.eventDate || null,
+        fetchedAt: cell.fetchedAt || null
+      });
+    }
+  }
+
+  for (const unav of report.unavailableSources || []) {
+    const uUrl = String(unav.url || "https://corpus.local/503");
+    if (!seenSources.has(uUrl)) {
+      seenSources.add(uUrl);
+      graph.push({
+        "@id": uUrl,
+        "@type": "WebPage",
+        name: `Недоступный источник (HTTP ${unav.statusCode || 503})`,
+        url: uUrl,
+        creativeWorkStatus: `Unavailable HTTP ${unav.statusCode || 503}`
+      });
+    }
+  }
+
+  return {
+    "@context": "https://w3id.org/ro/crate/1.1/context",
+    "@graph": graph
+  };
+}
+
+async function saveRoCrateResearchPackageViaWorkspace({
+  workspaceRoot,
+  slug = "research-ro-crate",
+  report = {},
+  searchAdapterId = "koswork-configured-search",
+  searchAdapterName = "Configured Search Engine Adapter",
+  signal = null
+} = {}) {
+  const crate = buildRoCrateMetadataDescriptor({
+    report,
+    searchAdapterId,
+    searchAdapterName
+  });
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const jsonLdFile = await svc.createFile({
+    relativePath: `reports/${slug}-ro-crate-metadata.json`,
+    content: JSON.stringify(crate, null, 2) + "\n",
+    createParents: true,
+    signal
+  });
+
+  return {
+    crate,
+    graphEntitiesCount: crate["@graph"].length,
+    jsonLdFile
+  };
+}
+
+module.exports = {
+  buildRoCrateMetadataDescriptor,
+  saveRoCrateResearchPackageViaWorkspace
+};
