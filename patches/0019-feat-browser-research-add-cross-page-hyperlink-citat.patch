diff --git a/desktop/windows/browser/hyperlink-citation-graph.cjs b/desktop/windows/browser/hyperlink-citation-graph.cjs
new file mode 100644
index 0000000..8ca98e9
--- /dev/null
+++ b/desktop/windows/browser/hyperlink-citation-graph.cjs
@@ -0,0 +1,178 @@
+"use strict";
+
+const { evaluateNavigationPolicy } = require("./policy.cjs");
+
+/**
+ * Koswork Cross-Page Hyperlink Citation Graph & Primary Source Verifier
+ * (`desktop/windows/browser/hyperlink-citation-graph.cjs`).
+ *
+ * Deepens Requirement #1, #2 & #3:
+ * - Extracts outbound `<a href="...">` citation links from an open page's HTML along
+ *   with each anchor's exact `[anchorStartUtf16, anchorEndUtf16]` code unit offsets
+ *   in `snapshot.fullTextUtf16`.
+ * - Resolves relative URLs against the page's base URL and filters out unsafe schemes.
+ * - Follows an inline citation link from a secondary/review article to its cited primary
+ *   source (`followAndVerifyPrimaryCitation`), verifying whether the primary source
+ *   actually substantiates the claimed phrase with a verifiable UTF-16 excerpt!
+ */
+
+function extractOutboundCitationLinks(snapshot, rawHtml = "") {
+  if (!snapshot || typeof snapshot.fullTextUtf16 !== "string") {
+    throw new Error("CITATION_GRAPH_REQUIRES_SNAPSHOT");
+  }
+
+  const fullText = snapshot.fullTextUtf16;
+  const baseUrl = snapshot.url || "https://corpus.local/";
+  const links = [];
+
+  const aRegex = /<a\b([^>]*)>([\s\S]*?)<\/a>/gi;
+  let match;
+  let searchFrom = 0;
+
+  while ((match = aRegex.exec(String(rawHtml || ""))) !== null) {
+    const attrs = match[1] || "";
+    const anchorText = match[2]
+      .replace(/<[^>]+>/g, " ")
+      .replace(/\s+/g, " ")
+      .trim();
+    const hrefMatch = attrs.match(/\bhref=["']([^"']+)["']/i);
+    if (!hrefMatch || !anchorText) continue;
+
+    let resolvedUrl = null;
+    try {
+      const candidate = new URL(hrefMatch[1].trim(), baseUrl).toString();
+      const policy = evaluateNavigationPolicy(candidate, { allowLocalLoopback: true });
+      if (policy.allowed) {
+        resolvedUrl = policy.normalizedUrl;
+      }
+    } catch {
+      resolvedUrl = null;
+    }
+
+    if (!resolvedUrl) continue;
+
+    const idx = fullText.indexOf(anchorText, searchFrom);
+    const anchorStartUtf16 = idx >= 0 ? idx : fullText.indexOf(anchorText);
+    const anchorEndUtf16 =
+      anchorStartUtf16 >= 0 ? anchorStartUtf16 + anchorText.length : null;
+    if (idx >= 0) {
+      searchFrom = idx + anchorText.length;
+    }
+
+    links.push({
+      linkIndex: links.length + 1,
+      anchorText,
+      targetUrl: resolvedUrl,
+      sameOrigin:
+        new URL(resolvedUrl).origin.toLowerCase() === new URL(baseUrl).origin.toLowerCase(),
+      anchorStartUtf16: anchorStartUtf16 >= 0 ? anchorStartUtf16 : null,
+      anchorEndUtf16
+    });
+  }
+
+  return {
+    sourceUrl: snapshot.url,
+    pageVersion: snapshot.pageVersion,
+    linksCount: links.length,
+    links
+  };
+}
+
+async function followAndVerifyPrimaryCitation({
+  engine,
+  sourceTabId,
+  rawHtml = "",
+  anchorOrUrlQuery,
+  expectedPrimaryPhrase,
+  primaryTabId = "tab-primary-citation",
+  signal = null
+} = {}) {
+  if (!engine) {
+    throw new Error("PRIMARY_CITATION_VERIFIER_REQUIRES_ENGINE");
+  }
+
+  const sourceObs = engine.observePage(sourceTabId);
+  const tab = engine.tabs.get(String(sourceTabId));
+  const graph = extractOutboundCitationLinks(
+    sourceObs.snapshot,
+    rawHtml || tab?.rawSiteDef?.html || ""
+  );
+
+  const needle = String(anchorOrUrlQuery || "").trim().toLowerCase();
+  const matchedLink = graph.links.find(
+    (l) =>
+      l.anchorText.toLowerCase().includes(needle) ||
+      l.targetUrl.toLowerCase().includes(needle)
+  );
+
+  if (!matchedLink) {
+    const err = new Error(`CITATION_LINK_NOT_FOUND_ON_PAGE: ${anchorOrUrlQuery}`);
+    err.code = "CITATION_LINK_NOT_FOUND_ON_PAGE";
+    throw err;
+  }
+
+  const secondaryExcerpt =
+    matchedLink.anchorStartUtf16 !== null
+      ? engine.extractExcerpt(sourceTabId, {
+          searchTerm: matchedLink.anchorText
+        })
+      : null;
+
+  const primaryNav = await engine.navigate({
+    tabId: primaryTabId,
+    url: matchedLink.targetUrl,
+    actor: "agent",
+    signal
+  });
+
+  if (!primaryNav.available) {
+    return {
+      status: "primary_source_unavailable",
+      primarySourceSubstantiated: false,
+      citationLink: matchedLink,
+      secondarySource: {
+        url: sourceObs.snapshot.url,
+        title: sourceObs.snapshot.title,
+        excerpt: secondaryExcerpt
+      },
+      primarySource: {
+        url: primaryNav.url,
+        httpStatus: primaryNav.httpStatus,
+        available: false
+      }
+    };
+  }
+
+  const primaryExcerpt = expectedPrimaryPhrase
+    ? engine.extractExcerpt(primaryTabId, { searchTerm: expectedPrimaryPhrase })
+    : null;
+
+  return {
+    status: primaryExcerpt ? "primary_source_verified" : "primary_phrase_not_found",
+    primarySourceSubstantiated: Boolean(primaryExcerpt),
+    citationLink: matchedLink,
+    secondarySource: {
+      url: sourceObs.snapshot.url,
+      title: sourceObs.snapshot.title,
+      pageDate: sourceObs.snapshot.pageDate,
+      eventDate: sourceObs.snapshot.eventDate,
+      fetchedAt: sourceObs.snapshot.fetchedAt,
+      excerpt: secondaryExcerpt
+    },
+    primarySource: {
+      url: primaryNav.url,
+      title: primaryNav.snapshot.title,
+      httpStatus: primaryNav.httpStatus,
+      available: primaryNav.available,
+      pageDate: primaryNav.pageDate,
+      eventDate: primaryNav.eventDate,
+      fetchedAt: primaryNav.fetchedAt,
+      excerpt: primaryExcerpt
+    }
+  };
+}
+
+module.exports = {
+  extractOutboundCitationLinks,
+  followAndVerifyPrimaryCitation
+};
diff --git a/desktop/windows/browser/multi-criteria-decision-matrix.cjs b/desktop/windows/browser/multi-criteria-decision-matrix.cjs
new file mode 100644
index 0000000..061ac3b
--- /dev/null
+++ b/desktop/windows/browser/multi-criteria-decision-matrix.cjs
@@ -0,0 +1,200 @@
+"use strict";
+
+const { normalizeComparableValue } = require("./claim-comparator.cjs");
+
+/**
+ * Koswork Multi-Criteria Decision Matrix & Pareto Trade-Off Analyzer
+ * (`desktop/windows/browser/multi-criteria-decision-matrix.cjs`).
+ *
+ * Deepens Requirement #2 & #5:
+ * - Evaluates compared options across weighted criteria (`direction: "lower_better" | "higher_better"`
+ *   and hard constraints `maxNumeric` / `minNumeric`).
+ * - Strictly requires a verified UTF-16 excerpt (`startUtf16`, `endUtf16`, `quote`) for any
+ *   confirmed criterion score; missing or bare-link criteria are marked `"unknown"` and
+ *   never fabricated or interpolated.
+ * - Identifies Pareto-optimal options (`paretoOptimal: true`) and ranks eligible options
+ *   with full citation provenance per cell.
+ */
+
+function evaluateMultiCriteriaDecisionMatrix({
+  options = [],
+  criteriaSpecs = [],
+  confirmedClaims = []
+} = {}) {
+  const optionNames = Array.from(
+    new Set([
+      ...options,
+      ...confirmedClaims.map((c) => c.optionName).filter(Boolean)
+    ])
+  );
+
+  // Index verified claims by `${optionName}||${criterion}`
+  const claimMap = new Map();
+  for (const c of confirmedClaims) {
+    if (!c || !c.optionName || !c.criterion || !c.excerpt || !c.excerpt.quote) continue;
+    const key = `${String(c.optionName).trim()}||${String(c.criterion).trim()}`;
+    if (!claimMap.has(key)) {
+      claimMap.set(key, c);
+    }
+  }
+
+  // Collect min/max numeric values per criterion across options for min-max normalization
+  const numericBounds = new Map();
+  for (const spec of criteriaSpecs) {
+    const crit = spec.name || spec.criterion;
+    const nums = [];
+    for (const opt of optionNames) {
+      const claim = claimMap.get(`${opt}||${crit}`);
+      if (!claim) continue;
+      const norm = normalizeComparableValue(claim.value || claim.excerpt.quote);
+      if (typeof norm.numericValue === "number" && Number.isFinite(norm.numericValue)) {
+        nums.push(norm.numericValue);
+      }
+    }
+    if (nums.length > 0) {
+      numericBounds.set(crit, {
+        min: Math.min(...nums),
+        max: Math.max(...nums)
+      });
+    }
+  }
+
+  const evaluatedOptions = optionNames.map((optionName) => {
+    let weightedSum = 0;
+    let totalWeight = 0;
+    let confirmedCriteriaCount = 0;
+    let unknownCriteriaCount = 0;
+    const hardConstraintViolations = [];
+    const criterionCells = {};
+    const numericVector = {};
+
+    for (const spec of criteriaSpecs) {
+      const crit = spec.name || spec.criterion;
+      const weight = Math.max(0, Number(spec.weight ?? 1));
+      const direction = spec.direction || "higher_better";
+      totalWeight += weight;
+
+      const claim = claimMap.get(`${optionName}||${crit}`);
+      if (!claim) {
+        unknownCriteriaCount += 1;
+        if (spec.required) {
+          hardConstraintViolations.push({
+            criterion: crit,
+            reason: "MISSING_VERIFIED_EXCERPT_FOR_REQUIRED_CRITERION"
+          });
+        }
+        criterionCells[crit] = {
+          status: "unknown",
+          displayValue: "Неизвестно (нет выдержки)",
+          normalizedScore: 0,
+          sourceUrl: null
+        };
+        continue;
+      }
+
+      confirmedCriteriaCount += 1;
+      const norm = normalizeComparableValue(claim.value || claim.excerpt.quote);
+      const numVal = norm.numericValue;
+
+      if (typeof numVal === "number" && Number.isFinite(numVal)) {
+        if (typeof spec.maxNumeric === "number" && numVal > spec.maxNumeric) {
+          hardConstraintViolations.push({
+            criterion: crit,
+            reason: `VALUE_${numVal}_EXCEEDS_MAX_${spec.maxNumeric}`
+          });
+        }
+        if (typeof spec.minNumeric === "number" && numVal < spec.minNumeric) {
+          hardConstraintViolations.push({
+            criterion: crit,
+            reason: `VALUE_${numVal}_BELOW_MIN_${spec.minNumeric}`
+          });
+        }
+      }
+
+      let cellScore = 1;
+      const bounds = numericBounds.get(crit);
+      if (bounds && typeof numVal === "number" && bounds.max > bounds.min) {
+        const ratio = (numVal - bounds.min) / (bounds.max - bounds.min);
+        cellScore = direction === "lower_better" ? 1 - ratio : ratio;
+      }
+
+      numericVector[crit] =
+        typeof numVal === "number"
+          ? direction === "lower_better"
+            ? -numVal
+            : numVal
+          : cellScore;
+
+      weightedSum += cellScore * weight;
+      criterionCells[crit] = {
+        status: "confirmed",
+        displayValue: claim.value || claim.excerpt.quote,
+        numericValue: numVal,
+        normalizedScore: Number(cellScore.toFixed(4)),
+        quote: claim.excerpt.quote,
+        startUtf16: claim.excerpt.startUtf16,
+        endUtf16: claim.excerpt.endUtf16,
+        sourceUrl: claim.source?.url || null
+      };
+    }
+
+    const overallScore =
+      totalWeight > 0 ? Number((weightedSum / totalWeight).toFixed(4)) : 0;
+
+    return {
+      optionName,
+      eligible: hardConstraintViolations.length === 0,
+      hardConstraintViolations,
+      confirmedCriteriaCount,
+      unknownCriteriaCount,
+      overallScore,
+      criterionCells,
+      _numericVector: numericVector
+    };
+  });
+
+  // Compute Pareto optimality among eligible options
+  for (const cand of evaluatedOptions) {
+    if (!cand.eligible) {
+      cand.paretoOptimal = false;
+      continue;
+    }
+    let dominated = false;
+    for (const other of evaluatedOptions) {
+      if (other.optionName === cand.optionName || !other.eligible) continue;
+      const critNames = criteriaSpecs.map((s) => s.name || s.criterion);
+      const allGreaterOrEqual = critNames.every(
+        (c) => (other._numericVector[c] ?? -Infinity) >= (cand._numericVector[c] ?? -Infinity)
+      );
+      const strictlyGreaterOne = critNames.some(
+        (c) => (other._numericVector[c] ?? -Infinity) > (cand._numericVector[c] ?? -Infinity)
+      );
+      if (allGreaterOrEqual && strictlyGreaterOne) {
+        dominated = true;
+        break;
+      }
+    }
+    cand.paretoOptimal = !dominated;
+  }
+  for (const cand of evaluatedOptions) {
+    delete cand._numericVector;
+  }
+
+  evaluatedOptions.sort((a, b) => {
+    if (a.eligible !== b.eligible) return a.eligible ? -1 : 1;
+    return b.overallScore - a.overallScore;
+  });
+
+  return {
+    optionsCount: evaluatedOptions.length,
+    paretoFrontierOptions: evaluatedOptions
+      .filter((o) => o.paretoOptimal)
+      .map((o) => o.optionName),
+    recommendedOption: evaluatedOptions.find((o) => o.eligible)?.optionName || null,
+    rankings: evaluatedOptions
+  };
+}
+
+module.exports = {
+  evaluateMultiCriteriaDecisionMatrix
+};
diff --git a/desktop/windows/browser/offline-evidence-bundle-archiver.cjs b/desktop/windows/browser/offline-evidence-bundle-archiver.cjs
new file mode 100644
index 0000000..a3b7edc
--- /dev/null
+++ b/desktop/windows/browser/offline-evidence-bundle-archiver.cjs
@@ -0,0 +1,154 @@
+"use strict";
+
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork RFC 2557 MHTML & Offline Self-Contained Evidence Bundle Archiver
+ * (`desktop/windows/browser/offline-evidence-bundle-archiver.cjs`).
+ *
+ * Deepens Requirement #1, #3 & #5:
+ * - Packages all visited versioned snapshots (`url`, `title`, `pageVersion`, `snapshotId`,
+ *   `contentSha256`, `pageDate`, `eventDate`, `fetchedAt`, `fullTextUtf16`, `tabReceipt`)
+ *   and verified excerpts into:
+ *   1. An RFC 2557 Multipart MHTML web archive (`reports/<slug>-evidence.mhtml`) that
+ *      can be inspected offline even if external web pages later change or go offline.
+ *   2. A deterministic JSON Evidence Bundle (`reports/<slug>-evidence-bundle.json`) that
+ *      can be reloaded offline via `restoreSnapshotsFromEvidenceBundle`.
+ */
+
+function buildMultipartMhtmlArchive({
+  title = "Koswork Browser Research Evidence Archive",
+  generatedAt = new Date().toISOString(),
+  snapshots = []
+} = {}) {
+  const boundary = "----=_NextPart_Koswork_Browser_Research_MHTML";
+  const rootUrl = snapshots[0]?.url || "https://koswork.local/research-archive";
+
+  const lines = [
+    `From: <Saved by Koswork Browser Research Engine>`,
+    `Subject: ${title}`,
+    `Date: ${new Date(generatedAt).toUTCString()}`,
+    `MIME-Version: 1.0`,
+    `Content-Type: multipart/related; type="text/html"; boundary="${boundary}"`,
+    ``,
+    `This is a multi-part message in MIME format (RFC 2557 MHTML Evidence Archive).`,
+    ``
+  ];
+
+  for (const snap of snapshots) {
+    if (!snap || !snap.url) continue;
+    const escapedText = String(snap.fullTextUtf16 || "")
+      .replace(/&/g, "&amp;")
+      .replace(/</g, "&lt;")
+      .replace(/>/g, "&gt;");
+
+    lines.push(
+      `--${boundary}`,
+      `Content-Type: text/html; charset="utf-8"`,
+      `Content-Transfer-Encoding: 8bit`,
+      `Content-Location: ${snap.url}`,
+      `X-Koswork-Snapshot-Id: ${snap.snapshotId || ""}`,
+      `X-Koswork-Page-Version: ${snap.pageVersion ?? 1}`,
+      `X-Koswork-Content-Sha256: ${snap.contentSha256 || ""}`,
+      `X-Koswork-Page-Date: ${snap.pageDate || ""}`,
+      `X-Koswork-Event-Date: ${snap.eventDate || ""}`,
+      `X-Koswork-Fetched-At: ${snap.fetchedAt || generatedAt}`,
+      ``,
+      `<!doctype html>`,
+      `<html lang="ru">`,
+      `<head><meta charset="utf-8" /><title>${snap.title || snap.url}</title></head>`,
+      `<body><pre data-utf16-length="${(snap.fullTextUtf16 || "").length}">${escapedText}</pre></body>`,
+      `</html>`,
+      ``
+    );
+  }
+
+  lines.push(`--${boundary}--`, ``);
+  return {
+    rootUrl,
+    partCount: snapshots.length,
+    mhtmlText: lines.join("\r\n")
+  };
+}
+
+async function saveOfflineEvidenceBundleToWorkspace({
+  workspaceRoot,
+  bundleSlug = "research-evidence",
+  question = "",
+  snapshots = [],
+  confirmedClaims = [],
+  signal = null
+} = {}) {
+  if (!workspaceRoot) {
+    throw new Error("OFFLINE_BUNDLE_REQUIRES_WORKSPACE_ROOT");
+  }
+
+  const generatedAt = new Date().toISOString();
+  const mhtml = buildMultipartMhtmlArchive({
+    title: `Koswork Evidence Archive: ${question || bundleSlug}`,
+    generatedAt,
+    snapshots
+  });
+
+  const bundleJsonObj = {
+    schemaVersion: "koswork.browser-research.offline-bundle.v1",
+    question,
+    generatedAt,
+    snapshots: snapshots.map((s) => ({
+      tabId: s.tabId,
+      url: s.url,
+      canonicalUrl: s.canonicalUrl || s.url,
+      title: s.title,
+      httpStatus: s.httpStatus ?? 200,
+      pageVersion: s.pageVersion ?? 1,
+      snapshotId: s.snapshotId,
+      contentSha256: s.contentSha256,
+      pageDate: s.pageDate || null,
+      eventDate: s.eventDate || null,
+      fetchedAt: s.fetchedAt || generatedAt,
+      totalLengthUtf16: (s.fullTextUtf16 || "").length,
+      fullTextUtf16: s.fullTextUtf16 || "",
+      tabReceipt: s.tabReceipt || null
+    })),
+    confirmedClaims
+  };
+
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const mhtmlFile = await svc.createFile({
+    relativePath: `reports/${bundleSlug}-evidence.mhtml`,
+    content: mhtml.mhtmlText,
+    createParents: true,
+    signal
+  });
+
+  const jsonFile = await svc.createFile({
+    relativePath: `reports/${bundleSlug}-evidence-bundle.json`,
+    content: JSON.stringify(bundleJsonObj, null, 2) + "\n",
+    createParents: true,
+    signal
+  });
+
+  return {
+    partCount: mhtml.partCount,
+    mhtmlFile,
+    jsonFile,
+    bundle: bundleJsonObj
+  };
+}
+
+function restoreSnapshotsFromEvidenceBundle(bundleObj = {}) {
+  const snapshotsByUrl = {};
+  for (const s of bundleObj.snapshots || []) {
+    if (!s || !s.url) continue;
+    snapshotsByUrl[s.url] = { ...s };
+  }
+  return snapshotsByUrl;
+}
+
+module.exports = {
+  buildMultipartMhtmlArchive,
+  saveOfflineEvidenceBundleToWorkspace,
+  restoreSnapshotsFromEvidenceBundle
+};
