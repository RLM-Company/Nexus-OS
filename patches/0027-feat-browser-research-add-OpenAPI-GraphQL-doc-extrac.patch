diff --git a/desktop/windows/browser/json-schema-and-sarif-audit-exporter.cjs b/desktop/windows/browser/json-schema-and-sarif-audit-exporter.cjs
new file mode 100644
index 0000000..7f31315
--- /dev/null
+++ b/desktop/windows/browser/json-schema-and-sarif-audit-exporter.cjs
@@ -0,0 +1,238 @@
+"use strict";
+
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork OASIS SARIF 2.1.0 Epistemic Audit & JSON Schema Validator Exporter
+ * (`desktop/windows/browser/json-schema-and-sarif-audit-exporter.cjs`).
+ *
+ * Deepens Requirement #5:
+ * - Exports a standard OASIS SARIF 2.1.0 (`Static Analysis Results Interchange Format`)
+ *   epistemic audit report (`reports/<slug>.sarif.json`) and a companion JSON Schema
+ *   validation report (`reports/<slug>-schema-validation.json`) via `workspace-service.cjs`.
+ * - Encodes inter-site contradictions (`KOSWORK001_CONTRADICTION`), outdated/superseded
+ *   sources (`KOSWORK002_OUTDATED_SOURCE`), unavailable HTTP 503 sources (`KOSWORK003_UNAVAILABLE_503`),
+ *   post-observation text substitutions (`KOSWORK004_POST_OBS_SUBSTITUTION`), and rejected
+ *   bare links (`KOSWORK005_BARE_LINK_REJECTED`) with exact UTF-16 `charOffset` and `charLength`.
+ */
+
+const SARIF_RULES = Object.freeze([
+  {
+    id: "KOSWORK001_CONTRADICTION",
+    name: "InterSiteClaimContradiction",
+    shortDescription: {
+      text: "Обнаружено межсайтовое противоречие значений для одного критерия."
+    }
+  },
+  {
+    id: "KOSWORK002_OUTDATED_SOURCE",
+    name: "SupersededOutdatedSource",
+    shortDescription: {
+      text: "Источник содержит устаревшие данные, перекрытые более свежей датой (eventDate/pageDate)."
+    }
+  },
+  {
+    id: "KOSWORK003_UNAVAILABLE_503",
+    name: "UnavailableHttpSource",
+    shortDescription: {
+      text: "Целевой источник оказался временно недоступен (HTTP 503 или сетевой сбой)."
+    }
+  },
+  {
+    id: "KOSWORK004_POST_OBS_SUBSTITUTION",
+    name: "PostObservationTextSubstitution",
+    shortDescription: {
+      text: "Обнаружена пост-наблюдательная подмена текста после первичной фиксации снимка."
+    }
+  },
+  {
+    id: "KOSWORK005_BARE_LINK_REJECTED",
+    name: "BareLinkWithoutExcerptRejected",
+    shortDescription: {
+      text: "Голая ссылка без дословной UTF-16 выдержки отклонена как доказательство утверждения."
+    }
+  }
+]);
+
+function buildSarif210ResearchAuditReport(report = {}) {
+  const results = [];
+
+  for (const c of report.contradictions || []) {
+    const sideA = c.sideA || {};
+    const startUtf16 = Number.isInteger(sideA.startUtf16) ? sideA.startUtf16 : 0;
+    const endUtf16 = Number.isInteger(sideA.endUtf16) ? sideA.endUtf16 : startUtf16;
+    results.push({
+      ruleId: "KOSWORK001_CONTRADICTION",
+      level: "warning",
+      message: {
+        text: `${c.optionName || "Option"} / ${c.criterion || "Spec"}: ${c.summary || "Расхождение между источниками"}`
+      },
+      locations: [
+        {
+          physicalLocation: {
+            artifactLocation: {
+              uri: sideA.url || "https://corpus.local/unknown"
+            },
+            region: {
+              charOffset: startUtf16,
+              charLength: Math.max(0, endUtf16 - startUtf16),
+              snippet: {
+                text: sideA.quote || ""
+              }
+            }
+          }
+        }
+      ]
+    });
+  }
+
+  for (const out of report.outdatedSources || []) {
+    results.push({
+      ruleId: "KOSWORK002_OUTDATED_SOURCE",
+      level: "note",
+      message: {
+        text: `Устаревший источник для ${out.optionName || "Option"} / ${out.criterion || "Spec"} (pageDate: ${out.pageDate || "н/д"}, eventDate: ${out.eventDate || "н/д"})`
+      },
+      locations: [
+        {
+          physicalLocation: {
+            artifactLocation: {
+              uri: out.url || "https://corpus.local/outdated"
+            }
+          }
+        }
+      ]
+    });
+  }
+
+  for (const unav of report.unavailableSources || []) {
+    results.push({
+      ruleId: "KOSWORK003_UNAVAILABLE_503",
+      level: "warning",
+      message: {
+        text: `Источник недоступен (HTTP ${unav.statusCode || 503}): ${unav.url}`
+      },
+      locations: [
+        {
+          physicalLocation: {
+            artifactLocation: {
+              uri: unav.url || "https://corpus.local/503"
+            }
+          }
+        }
+      ]
+    });
+  }
+
+  for (const sub of report.postObservationSubstitutions || []) {
+    results.push({
+      ruleId: "KOSWORK004_POST_OBS_SUBSTITUTION",
+      level: "error",
+      message: {
+        text: `Пост-наблюдательная подмена текста на ${sub.url || "вкладке"}`
+      },
+      locations: [
+        {
+          physicalLocation: {
+            artifactLocation: {
+              uri: sub.url || "https://corpus.local/substituted"
+            }
+          }
+        }
+      ]
+    });
+  }
+
+  for (const bare of report.rejectedBareLinks || []) {
+    results.push({
+      ruleId: "KOSWORK005_BARE_LINK_REJECTED",
+      level: "error",
+      message: {
+        text: `Отклонена голая ссылка без UTF-16 выдержки: ${bare.url || bare.sourceUrl || ""}`
+      },
+      locations: [
+        {
+          physicalLocation: {
+            artifactLocation: {
+              uri: bare.url || bare.sourceUrl || "https://corpus.local/bare"
+            }
+          }
+        }
+      ]
+    });
+  }
+
+  const sarifLog = {
+    $schema: "https://json.schemastore.org/sarif-2.1.0.json",
+    version: "2.1.0",
+    runs: [
+      {
+        tool: {
+          driver: {
+            name: "KosworkBrowserEpistemicAuditor",
+            version: "1.0.0",
+            rules: SARIF_RULES
+          }
+        },
+        results
+      }
+    ]
+  };
+
+  const schemaValidation = {
+    schemaId: "https://kosmora.local/schemas/koswork-browser-research-report-v1.json",
+    valid: Boolean(
+      typeof report.question === "string" &&
+        Array.isArray(report.comparisonRows) &&
+        Array.isArray(report.contradictions) &&
+        Array.isArray(report.unavailableSources)
+    ),
+    totalSarifFindings: results.length,
+    findingsByRule: SARIF_RULES.reduce((acc, r) => {
+      acc[r.id] = results.filter((res) => res.ruleId === r.id).length;
+      return acc;
+    }, {})
+  };
+
+  return {
+    sarifLog,
+    schemaValidation
+  };
+}
+
+async function saveSarifAndJsonSchemaAuditViaWorkspace({
+  workspaceRoot,
+  slug = "research-epistemic-audit",
+  report = {},
+  signal = null
+} = {}) {
+  const { sarifLog, schemaValidation } = buildSarif210ResearchAuditReport(report);
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const sarifFile = await svc.createFile({
+    relativePath: `reports/${slug}.sarif.json`,
+    content: JSON.stringify(sarifLog, null, 2) + "\n",
+    createParents: true,
+    signal
+  });
+  const schemaFile = await svc.createFile({
+    relativePath: `reports/${slug}-schema-validation.json`,
+    content: JSON.stringify(schemaValidation, null, 2) + "\n",
+    createParents: true,
+    signal
+  });
+
+  return {
+    sarifLog,
+    schemaValidation,
+    sarifFile,
+    schemaFile
+  };
+}
+
+module.exports = {
+  SARIF_RULES,
+  buildSarif210ResearchAuditReport,
+  saveSarifAndJsonSchemaAuditViaWorkspace
+};
diff --git a/desktop/windows/browser/openapi-graphql-doc-extractor.cjs b/desktop/windows/browser/openapi-graphql-doc-extractor.cjs
new file mode 100644
index 0000000..62dce3b
--- /dev/null
+++ b/desktop/windows/browser/openapi-graphql-doc-extractor.cjs
@@ -0,0 +1,150 @@
+"use strict";
+
+/**
+ * Koswork OpenAPI / REST Endpoint & GraphQL Schema Technical Documentation Extractor
+ * (`desktop/windows/browser/openapi-graphql-doc-extractor.cjs`).
+ *
+ * Deepens Requirements #2 & #3:
+ * - Extracts REST API endpoints (`GET /v1/...`, `POST /api/...`, `DELETE`, `PUT`, `PATCH`),
+ *   rate limits (`1200 req/min`, `X-RateLimit-Limit`), authentication schemes (`Bearer`, `OAuth2`, `API-Key`),
+ *   and GraphQL SDL type/query blocks from technical documentation snapshots with exact
+ *   UTF-16 `[startUtf16..endUtf16]` offsets and distinct `pageDate`, `eventDate`, and `fetchedAt`.
+ * - Verifies API capability claims against extracted UTF-16 endpoint excerpts while rejecting
+ *   bare documentation links (`BARE_API_DOC_LINK_REJECTED`).
+ */
+
+function extractApiEndpointsAndGraphqlSchemas(snapshot = {}) {
+  const fullText = String(snapshot.fullTextUtf16 || snapshot.text || "");
+  const endpoints = [];
+  const graphqlTypes = [];
+  const rateLimits = [];
+
+  // 1. REST Endpoints: e.g. "GET /v1/models", "POST /api/v2/research/sessions"
+  const endpointRe = /\b(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(\/[a-zA-Z0-9_.\-/{}:?&=]+)/g;
+  let m;
+  while ((m = endpointRe.exec(fullText)) !== null) {
+    const method = m[1].toUpperCase();
+    const route = m[2];
+    const quote = m[0];
+    const startUtf16 = m.index;
+    const endUtf16 = m.index + quote.length;
+
+    endpoints.push({
+      method,
+      route,
+      quote,
+      startUtf16,
+      endUtf16,
+      url: snapshot.url || "",
+      title: snapshot.title || "",
+      pageDate: snapshot.pageDate || null,
+      eventDate: snapshot.eventDate || null,
+      fetchedAt: snapshot.fetchedAt || null
+    });
+  }
+
+  // 2. GraphQL SDL blocks: e.g. "type Query { ... }", "type Mutation { ... }"
+  const gqlRe = /\b(type|input|interface|enum)\s+([A-Za-z_][A-Za-z0-9_]*)\s*\{([^}]*)\}/g;
+  while ((m = gqlRe.exec(fullText)) !== null) {
+    const kind = m[1];
+    const typeName = m[2];
+    const body = m[3].trim();
+    const quote = m[0];
+    const startUtf16 = m.index;
+    const endUtf16 = m.index + quote.length;
+
+    graphqlTypes.push({
+      kind,
+      typeName,
+      fieldsPreview: body.replace(/\s+/g, " "),
+      quote,
+      startUtf16,
+      endUtf16,
+      url: snapshot.url || "",
+      pageDate: snapshot.pageDate || null,
+      eventDate: snapshot.eventDate || null,
+      fetchedAt: snapshot.fetchedAt || null
+    });
+  }
+
+  // 3. Rate-limit specifications: e.g. "1200 req/min", "600 запросов/мин", "100 rps"
+  const rlRe = /(\d+)\s*(req\/min|requests\/min|запросов\/мин|rps|req\/sec|запросов\/сек)/gi;
+  while ((m = rlRe.exec(fullText)) !== null) {
+    const limitValue = Number(m[1]);
+    const unit = m[2];
+    const quote = m[0];
+    const startUtf16 = m.index;
+    const endUtf16 = m.index + quote.length;
+
+    rateLimits.push({
+      limitValue,
+      unit,
+      quote,
+      startUtf16,
+      endUtf16,
+      url: snapshot.url || "",
+      pageDate: snapshot.pageDate || null,
+      eventDate: snapshot.eventDate || null,
+      fetchedAt: snapshot.fetchedAt || null
+    });
+  }
+
+  return {
+    url: snapshot.url || "",
+    title: snapshot.title || "",
+    pageVersion: snapshot.pageVersion ?? 1,
+    pageDate: snapshot.pageDate || null,
+    eventDate: snapshot.eventDate || null,
+    fetchedAt: snapshot.fetchedAt || null,
+    endpointsCount: endpoints.length,
+    graphqlTypesCount: graphqlTypes.length,
+    rateLimitsCount: rateLimits.length,
+    endpoints,
+    graphqlTypes,
+    rateLimits
+  };
+}
+
+function verifyApiSpecClaimAgainstEndpointTable({
+  snapshot = {},
+  requiredMethod = "POST",
+  requiredRouteSubstring = "",
+  bareLinkOnly = false
+} = {}) {
+  if (bareLinkOnly) {
+    return {
+      verified: false,
+      code: "BARE_API_DOC_LINK_REJECTED",
+      reason: "Голая ссылка на документацию API без UTF-16 выдержки не является доказательством наличия эндпоинта."
+    };
+  }
+
+  const extracted = extractApiEndpointsAndGraphqlSchemas(snapshot);
+  const methodUpper = String(requiredMethod || "GET").toUpperCase();
+  const routeSub = String(requiredRouteSubstring || "").trim();
+
+  const matched = extracted.endpoints.find(
+    (e) => e.method === methodUpper && (!routeSub || e.route.includes(routeSub))
+  );
+
+  if (!matched) {
+    return {
+      verified: false,
+      code: "API_ENDPOINT_NOT_FOUND_IN_SNAPSHOT",
+      reason: `Эндпоинт ${methodUpper} ${routeSub} не найден в тексте страницы документации.`
+    };
+  }
+
+  return {
+    verified: true,
+    code: "API_ENDPOINT_VERIFIED_WITH_UTF16_EXCERPT",
+    endpoint: matched,
+    rateLimits: extracted.rateLimits,
+    graphqlTypes: extracted.graphqlTypes
+  };
+}
+
+module.exports = {
+  extractApiEndpointsAndGraphqlSchemas,
+  verifyApiSpecClaimAgainstEndpointTable
+};
