diff --git a/desktop/windows/browser/chart-and-figure-caption-extractor.cjs b/desktop/windows/browser/chart-and-figure-caption-extractor.cjs
new file mode 100644
index 0000000..6ce3e3f
--- /dev/null
+++ b/desktop/windows/browser/chart-and-figure-caption-extractor.cjs
@@ -0,0 +1,76 @@
+"use strict";
+
+const { extractVerifiableExcerpt } = require("./document.cjs");
+
+/**
+ * Koswork Accessible SVG / `<figure>` / `<figcaption>` & Chart Data Extractor
+ * (`desktop/windows/browser/chart-and-figure-caption-extractor.cjs`).
+ *
+ * Deepens Requirement #3:
+ * - Extracts structured benchmark captions and series labels from `<figure>` / `<figcaption>`,
+ *   inline `<svg>` (`<title>`, `<desc>`, `<text>`), and `<img alt="..." aria-label="...">`
+ *   chart blocks on technical pages.
+ * - Binds every extracted figure/chart caption to its exact UTF-16 code unit span
+ *   `[startUtf16, endUtf16]` in `snapshot.fullTextUtf16` when rendered in visible text.
+ */
+function extractFiguresAndSvgCharts(snapshot, rawHtml = "") {
+  if (!snapshot || typeof snapshot.fullTextUtf16 !== "string") {
+    throw new Error("FIGURE_EXTRACTOR_REQUIRES_SNAPSHOT");
+  }
+
+  const figures = [];
+  const html = String(rawHtml || "");
+
+  // 1. Extract `<figure> ... <figcaption>...</figcaption> ... </figure>` blocks
+  const figRegex = /<figure\b[^>]*>([\s\S]*?)<\/figure>/gi;
+  let m;
+  while ((m = figRegex.exec(html)) !== null) {
+    const inner = m[1];
+    const capMatch = inner.match(/<figcaption\b[^>]*>([\s\S]*?)<\/figcaption>/i);
+    const captionText = capMatch
+      ? capMatch[1].replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim()
+      : "";
+
+    const svgTitleMatch = inner.match(/<title\b[^>]*>([\s\S]*?)<\/title>/i);
+    const svgDescMatch = inner.match(/<desc\b[^>]*>([\s\S]*?)<\/desc>/i);
+    const imgAltMatch = inner.match(/\balt=["']([^"']+)["']/i);
+
+    const svgTexts = [];
+    const textRegex = /<text\b[^>]*>([\s\S]*?)<\/text>/gi;
+    let tm;
+    while ((tm = textRegex.exec(inner)) !== null) {
+      const t = tm[1].replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
+      if (t) svgTexts.push(t);
+    }
+
+    const searchPhrase =
+      captionText ||
+      (svgDescMatch ? svgDescMatch[1].trim() : "") ||
+      (svgTitleMatch ? svgTitleMatch[1].trim() : "");
+    const excerpt = searchPhrase
+      ? extractVerifiableExcerpt(snapshot, { searchTerm: searchPhrase })
+      : null;
+
+    figures.push({
+      figureIndex: figures.length + 1,
+      kind: inner.toLowerCase().includes("<svg") ? "svg_chart_figure" : "html_figure",
+      captionText: captionText || null,
+      svgTitle: svgTitleMatch ? svgTitleMatch[1].trim() : null,
+      svgDescription: svgDescMatch ? svgDescMatch[1].trim() : null,
+      imageAlt: imgAltMatch ? imgAltMatch[1].trim() : null,
+      svgDataLabels: svgTexts,
+      excerpt
+    });
+  }
+
+  return {
+    url: snapshot.url,
+    pageVersion: snapshot.pageVersion,
+    figuresCount: figures.length,
+    figures
+  };
+}
+
+module.exports = {
+  extractFiguresAndSvgCharts
+};
diff --git a/desktop/windows/browser/iterative-gap-closer.cjs b/desktop/windows/browser/iterative-gap-closer.cjs
new file mode 100644
index 0000000..35fee83
--- /dev/null
+++ b/desktop/windows/browser/iterative-gap-closer.cjs
@@ -0,0 +1,182 @@
+"use strict";
+
+const {
+  analyzeResearchCoverageAndBuildFollowUps
+} = require("./research-coverage-gap-analyzer.cjs");
+const { saveResearchReportsViaWorkspace } = require("./research-report-builder.cjs");
+
+/**
+ * Koswork Iterative Closed-Loop Gap-Filling Research Orchestrator
+ * (`desktop/windows/browser/iterative-gap-closer.cjs`).
+ *
+ * Deepens Requirement #2 & #5:
+ * - Inspects an initial research dataset across `(options × criteria)` using
+ *   `analyzeResearchCoverageAndBuildFollowUps`.
+ * - For each `"unknown"` cell, executes the generated follow-up search query via
+ *   `engine.searchService.search` and opens top candidate results (`openSearchResult`)
+ *   to extract a verifiable UTF-16 excerpt (`[startUtf16, endUtf16]`).
+ * - Updates the comparison table and saves the refreshed report via `workspace-service.cjs`
+ *   without spawning a second agent loop.
+ */
+async function executeIterativeGapClosingResearch({
+  engine,
+  workspaceRoot,
+  reportSlug = "gap-closed-report",
+  question = "",
+  options = [],
+  criteria = [],
+  initialSources = [],
+  initialClaims = [],
+  gapExtractionHints = [],
+  maxFollowUpQueries = 4,
+  signal = null
+} = {}) {
+  if (!engine) {
+    throw new Error("ITERATIVE_GAP_CLOSER_REQUIRES_ENGINE");
+  }
+
+  const initialCoverage = analyzeResearchCoverageAndBuildFollowUps({
+    question,
+    options,
+    criteria,
+    confirmedClaims: initialClaims
+  });
+
+  const allSources = [...initialSources];
+  const allClaims = [...initialClaims];
+  const executedFollowUps = [];
+
+  const hintsByCell = new Map();
+  for (const h of gapExtractionHints) {
+    if (h && h.optionName && h.criterion) {
+      hintsByCell.set(`${h.optionName}||${h.criterion}`, h);
+    }
+  }
+
+  const queriesToRun = initialCoverage.followUpQueries.slice(0, maxFollowUpQueries);
+
+  for (let i = 0; i < queriesToRun.length; i += 1) {
+    if (signal?.aborted) break;
+    const fq = queriesToRun[i];
+    const cellKey = `${fq.optionName}||${fq.criterion}`;
+    const hint = hintsByCell.get(cellKey) || {};
+
+    const searchQuery = hint.query || fq.query;
+    const searchRes = await engine.searchService.search({
+      query: searchQuery,
+      actor: "agent",
+      signal
+    });
+
+    const items = searchRes.items || searchRes.results || [];
+    if (items.length === 0) continue;
+
+    const opened = await engine.searchService.openSearchResult({
+      searchId: searchRes.searchId,
+      rank: 1,
+      tabId: `gap-tab-${(i % 3) + 1}`,
+      actor: "agent",
+      extractQuery: hint.searchTerm || fq.criterion,
+      signal
+    });
+
+    allSources.push({
+      url: opened.url,
+      title: opened.title,
+      httpStatus: opened.httpStatus,
+      available: opened.available,
+      pageDate: opened.pageDate,
+      eventDate: opened.eventDate,
+      fetchedAt: opened.fetchedAt,
+      tabReceipt: opened.tabReceipt
+    });
+
+    const excerpt =
+      opened.linkedExcerpts?.[0] ||
+      (hint.searchTerm
+        ? engine.extractExcerpt(opened.tabId, { searchTerm: hint.searchTerm })
+        : null);
+
+    if (excerpt) {
+      const newClaim = {
+        claimId: `gap-filled-${allClaims.length + 1}`,
+        optionName: fq.optionName,
+        criterion: fq.criterion,
+        value: hint.value || excerpt.quote,
+        claim:
+          hint.claimText ||
+          `${fq.optionName} (${fq.criterion}): ${hint.value || excerpt.quote}`,
+        excerpt,
+        source: {
+          url: opened.url,
+          title: opened.title,
+          pageDate: opened.pageDate,
+          eventDate: opened.eventDate,
+          fetchedAt: opened.fetchedAt
+        }
+      };
+      allClaims.push(newClaim);
+      executedFollowUps.push({
+        optionName: fq.optionName,
+        criterion: fq.criterion,
+        query: searchQuery,
+        resolvedUrl: opened.url,
+        filledClaim: newClaim
+      });
+    }
+  }
+
+  const finalCoverage = analyzeResearchCoverageAndBuildFollowUps({
+    question,
+    options,
+    criteria,
+    confirmedClaims: allClaims
+  });
+
+  // Build comparisonRows for saveResearchReportsViaWorkspace
+  const comparisonRows = options.map((opt) => {
+    const values = {};
+    for (const crit of criteria) {
+      const matched = allClaims.find(
+        (c) => c.optionName === opt && c.criterion === crit && c.excerpt
+      );
+      if (matched) {
+        values[crit] = {
+          displayValue: matched.value || matched.excerpt.quote,
+          sourceUrl: matched.source?.url,
+          startUtf16: matched.excerpt.startUtf16,
+          endUtf16: matched.excerpt.endUtf16
+        };
+      }
+    }
+    return { optionName: opt, values };
+  });
+
+  let savedReports = null;
+  if (workspaceRoot) {
+    savedReports = await saveResearchReportsViaWorkspace({
+      workspaceRoot,
+      reportSlug,
+      reportData: {
+        question,
+        criteria,
+        sources: allSources,
+        claims: allClaims,
+        comparisonRows
+      },
+      signal
+    });
+  }
+
+  return {
+    initialCoverage,
+    finalCoverage,
+    executedFollowUpsCount: executedFollowUps.length,
+    executedFollowUps,
+    savedReports
+  };
+}
+
+module.exports = {
+  executeIterativeGapClosingResearch
+};
diff --git a/desktop/windows/browser/privacy-redaction-guard.cjs b/desktop/windows/browser/privacy-redaction-guard.cjs
new file mode 100644
index 0000000..912bf79
--- /dev/null
+++ b/desktop/windows/browser/privacy-redaction-guard.cjs
@@ -0,0 +1,106 @@
+"use strict";
+
+/**
+ * Koswork Owner Privacy & Sensitive-Data Redaction Guard
+ * (`desktop/windows/browser/privacy-redaction-guard.cjs`).
+ *
+ * Enforces the strict security rule from the specification:
+ * "Не используй реальные .env, пароли, токены, базу и личные файлы владельца
+ *  как тестовые данные или вложения другим сервисам."
+ *
+ * Capabilities:
+ * 1. Scrubs sensitive query parameters (`token`, `access_token`, `api_key`, `password`,
+ *    `secret`, `session_key`, `auth`) from URLs before persisting them in HAR traces,
+ *    MHTML bundles, or shared reports (`redactSensitiveUrlParams`).
+ * 2. Scrubs inline bearer tokens (`Bearer ...`, `sk-...`, `ghp_...`, `AIza...`,
+ *    `SECRET_TOKEN=...`) from text and headers (`redactSensitiveTextAndHeaders`).
+ * 3. Audits any serialized report/HAR/MHTML payload to prove zero unredacted secrets
+ *    remain (`auditPayloadForZeroSecretLeaks`).
+ */
+
+const SENSITIVE_QUERY_KEYS = new Set([
+  "token",
+  "access_token",
+  "refresh_token",
+  "id_token",
+  "api_key",
+  "apikey",
+  "password",
+  "passwd",
+  "secret",
+  "client_secret",
+  "session_key",
+  "auth",
+  "signature",
+  "sig"
+]);
+
+function redactSensitiveUrlParams(rawUrl = "") {
+  try {
+    const parsed = new URL(String(rawUrl));
+    let redactedCount = 0;
+    for (const key of Array.from(parsed.searchParams.keys())) {
+      if (SENSITIVE_QUERY_KEYS.has(key.toLowerCase())) {
+        parsed.searchParams.set(key, "[REDACTED]");
+        redactedCount += 1;
+      }
+    }
+    return {
+      sanitizedUrl: parsed.toString(),
+      redactedParamsCount: redactedCount
+    };
+  } catch {
+    return {
+      sanitizedUrl: String(rawUrl || ""),
+      redactedParamsCount: 0
+    };
+  }
+}
+
+function redactSensitiveText(rawText = "") {
+  let text = String(rawText || "");
+  let redactionsCount = 0;
+
+  const patterns = [
+    {
+      regex: /\bBearer\s+[A-Za-z0-9._~+/=-]{8,}/g,
+      replacement: "Bearer [REDACTED_TOKEN]"
+    },
+    {
+      regex: /\b(?:sk-[A-Za-z0-9]{16,}|ghp_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z-_]{20,})\b/g,
+      replacement: "[REDACTED_API_KEY]"
+    },
+    {
+      regex: /\b(?:PASSWORD|PASSWD|SECRET_TOKEN|API_KEY|PRIVATE_KEY|ACCESS_TOKEN)\s*=\s*[^\s"'&]+/gi,
+      replacement: "[REDACTED_ENV_SECRET]"
+    }
+  ];
+
+  for (const pat of patterns) {
+    text = text.replace(pat.regex, () => {
+      redactionsCount += 1;
+      return pat.replacement;
+    });
+  }
+
+  return {
+    sanitizedText: text,
+    redactionsCount
+  };
+}
+
+function auditPayloadForZeroSecretLeaks(payload) {
+  const serialized =
+    typeof payload === "string" ? payload : JSON.stringify(payload || {});
+  const leakCheck = redactSensitiveText(serialized);
+  return {
+    clean: leakCheck.redactionsCount === 0,
+    detectedLeaksCount: leakCheck.redactionsCount
+  };
+}
+
+module.exports = {
+  redactSensitiveUrlParams,
+  redactSensitiveText,
+  auditPayloadForZeroSecretLeaks
+};
