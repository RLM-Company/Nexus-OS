+  });
+  const excAlpha = engine.extractExcerpt("tab-gap-init", {
+    searchTerm: "Для Option Alpha базовая цена составляет $49/мес"
+  });
+
+  const gapClosed = await shell.dispatchToolCall(
+    "browser.close_coverage_gaps",
+    {
