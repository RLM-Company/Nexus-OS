diff --git a/desktop/windows/browser/csl-json-and-ris-bibliography-exporter.cjs b/desktop/windows/browser/csl-json-and-ris-bibliography-exporter.cjs
new file mode 100644
index 0000000..81e3dfe
--- /dev/null
+++ b/desktop/windows/browser/csl-json-and-ris-bibliography-exporter.cjs
@@ -0,0 +1,142 @@
+"use strict";
+
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork CSL-JSON (Citation Style Language) & RIS Bibliography Exporter
+ * (`desktop/windows/browser/csl-json-and-ris-bibliography-exporter.cjs`).
+ *
+ * Deepens Requirements #1, #3 & #5:
+ * - Exports verified research sources and their UTF-16 `[startUtf16..endUtf16]` quotes
+ *   into standard reference-manager formats:
+ *   1. CSL-JSON (`reports/<slug>-csl.json`, compatible with Zotero, Mendeley, Pandoc citeproc)
+ *   2. RIS (`reports/<slug>.ris`, Research Information Systems `TY  - ELEC`)
+ *   via `workspace-service.cjs`.
+ * - Preserves distinct `issued` (`pageDate`), `event-date` (`eventDate`), and `accessed`
+ *   (`fetchedAt`) fields on every bibliographic record.
+ */
+
+function parseDateParts(isoStr = "") {
+  const m = String(isoStr || "")
+    .trim()
+    .match(/^(\d{4})-(\d{2})-(\d{2})/);
+  if (!m) return null;
+  return {
+    "date-parts": [[Number(m[1]), Number(m[2]), Number(m[3])]]
+  };
+}
+
+function buildCslJsonAndRisBibliography(report = {}) {
+  const byUrl = new Map();
+
+  for (const row of report.comparisonRows || []) {
+    const optionName = row.optionName || "Option";
+    for (const [criterion, cell] of Object.entries(row.cells || {})) {
+      if (!cell || !cell.quote || !Number.isInteger(cell.startUtf16) || cell.startUtf16 < 0) {
+        continue;
+      }
+      const url = String(cell.sourceUrl || "https://corpus.local/unknown");
+      if (!byUrl.has(url)) {
+        byUrl.set(url, {
+          url,
+          title: cell.sourceTitle || url,
+          pageDate: cell.pageDate || null,
+          eventDate: cell.eventDate || null,
+          fetchedAt: cell.fetchedAt || null,
+          excerpts: []
+        });
+      }
+      byUrl.get(url).excerpts.push({
+        optionName,
+        criterion,
+        value: cell.displayValue || cell.value || "",
+        quote: cell.quote,
+        startUtf16: cell.startUtf16,
+        endUtf16: cell.endUtf16
+      });
+    }
+  }
+
+  const cslItems = [];
+  const risBlocks = [];
+  let idx = 1;
+
+  for (const src of byUrl.values()) {
+    const id = `koswork-ref-${idx}`;
+    idx += 1;
+
+    const noteSummary = src.excerpts
+      .map(
+        (e) =>
+          `${e.optionName} / ${e.criterion} = ${e.value}: «${e.quote}» [UTF-16 ${e.startUtf16}..${e.endUtf16}]`
+      )
+      .join(" | ");
+
+    const cslEntry = {
+      id,
+      type: "webpage",
+      title: src.title,
+      URL: src.url,
+      issued: parseDateParts(src.pageDate),
+      "event-date": parseDateParts(src.eventDate),
+      accessed: parseDateParts(src.fetchedAt),
+      note: noteSummary
+    };
+    cslItems.push(cslEntry);
+
+    const year = String(src.eventDate || src.pageDate || "2026").slice(0, 4);
+    const risLines = [
+      "TY  - ELEC",
+      `ID  - ${id}`,
+      `TI  - ${src.title}`,
+      `UR  - ${src.url}`,
+      `PY  - ${year}`,
+      `DA  - ${src.pageDate || ""}`,
+      `Y2  - ${src.fetchedAt || ""}`,
+      `N1  - eventDate: ${src.eventDate || "n/a"} | ${noteSummary}`,
+      "ER  - "
+    ];
+    risBlocks.push(risLines.join("\n"));
+  }
+
+  return {
+    itemsCount: cslItems.length,
+    cslJson: cslItems,
+    risText: risBlocks.join("\n\n") + "\n"
+  };
+}
+
+async function saveCslJsonAndRisBibliographyViaWorkspace({
+  workspaceRoot,
+  slug = "research-bibliography",
+  report = {},
+  signal = null
+} = {}) {
+  const built = buildCslJsonAndRisBibliography(report);
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const cslFile = await svc.createFile({
+    relativePath: `reports/${slug}-csl.json`,
+    content: JSON.stringify(built.cslJson, null, 2) + "\n",
+    createParents: true,
+    signal
+  });
+  const risFile = await svc.createFile({
+    relativePath: `reports/${slug}.ris`,
+    content: built.risText,
+    createParents: true,
+    signal
+  });
+
+  return {
+    ...built,
+    cslFile,
+    risFile
+  };
+}
+
+module.exports = {
+  buildCslJsonAndRisBibliography,
+  saveCslJsonAndRisBibliographyViaWorkspace
+};
diff --git a/desktop/windows/browser/hardware-and-benchmark-spec-extractor.cjs b/desktop/windows/browser/hardware-and-benchmark-spec-extractor.cjs
new file mode 100644
index 0000000..5c3ca35
--- /dev/null
+++ b/desktop/windows/browser/hardware-and-benchmark-spec-extractor.cjs
@@ -0,0 +1,167 @@
+"use strict";
+
+/**
+ * Koswork Hardware & Performance Benchmark Throughput Extractor
+ * (`desktop/windows/browser/hardware-and-benchmark-spec-extractor.cjs`).
+ *
+ * Deepens Requirements #2, #3 & #5:
+ * - Extracts throughput metrics (`45 000 RPS`, `120k req/sec`), tail latency percentiles
+ *   (`p50 = 4 мс`, `p95 < 12 мс`, `p99 = 28 ms`), and hardware resource footprints
+ *   (`16 vCPU`, `64 ГБ ОЗУ`) with exact UTF-16 `[startUtf16..endUtf16]` offsets and
+ *   distinct `pageDate`, `eventDate`, and `fetchedAt`.
+ * - Normalizes throughput values to canonical requests-per-second (`normalizedRps`) and
+ *   compares options side-by-side while rejecting bare-link claims (`BARE_BENCHMARK_CLAIM_REJECTED`).
+ */
+
+function extractHardwareAndPerformanceBenchmarks(snapshot = {}) {
+  const fullText = String(snapshot.fullTextUtf16 || snapshot.text || "");
+  const throughputMetrics = [];
+  const latencyMetrics = [];
+  const hardwareSpecs = [];
+
+  // 1. Throughput: e.g. "45000 RPS", "120k req/sec", "85 тыс. запросов/сек"
+  const rpsRe = /(\d+(?:\.\d+)?)\s*(k|тыс\.?)?\s*(RPS|req\/sec|req\/s|запросов\/сек)/giu;
+  let m;
+  while ((m = rpsRe.exec(fullText)) !== null) {
+    const baseNum = Number(m[1]);
+    const mult = m[2] ? 1000 : 1;
+    const normalizedRps = Math.round(baseNum * mult);
+    const quote = m[0].trim();
+    const startUtf16 = fullText.indexOf(quote, m.index);
+    const endUtf16 = startUtf16 + quote.length;
+
+    throughputMetrics.push({
+      normalizedRps,
+      quote,
+      startUtf16,
+      endUtf16,
+      url: snapshot.url || "",
+      pageDate: snapshot.pageDate || null,
+      eventDate: snapshot.eventDate || null,
+      fetchedAt: snapshot.fetchedAt || null
+    });
+  }
+
+  // 2. Latency percentiles: e.g. "p95 < 12 мс", "p99 = 28 ms"
+  const latRe = /\b(p50|p90|p95|p99)\s*(?:<|<=|=|:|составляет)?\s*(\d+(?:\.\d+)?)\s*(мс|ms|сек|sec)/giu;
+  while ((m = latRe.exec(fullText)) !== null) {
+    const percentile = m[1].toLowerCase();
+    const rawVal = Number(m[2]);
+    const unit = m[3].toLowerCase();
+    const latencyMs =
+      unit === "сек" || unit === "sec" ? Number((rawVal * 1000).toFixed(2)) : rawVal;
+    const quote = m[0].trim();
+    const startUtf16 = fullText.indexOf(quote, m.index);
+    const endUtf16 = startUtf16 + quote.length;
+
+    latencyMetrics.push({
+      percentile,
+      latencyMs,
+      quote,
+      startUtf16,
+      endUtf16,
+      url: snapshot.url || "",
+      pageDate: snapshot.pageDate || null,
+      eventDate: snapshot.eventDate || null,
+      fetchedAt: snapshot.fetchedAt || null
+    });
+  }
+
+  // 3. Hardware specs: e.g. "16 vCPU", "64 ГБ ОЗУ", "64 GB RAM"
+  const hwRe = /(\d+)\s*(vCPU|ядер|cores|ГБ\s+ОЗУ|GB\s+RAM)/giu;
+  while ((m = hwRe.exec(fullText)) !== null) {
+    const amount = Number(m[1]);
+    const unit = m[2].trim();
+    const quote = m[0].trim();
+    const startUtf16 = fullText.indexOf(quote, m.index);
+    const endUtf16 = startUtf16 + quote.length;
+
+    hardwareSpecs.push({
+      amount,
+      unit,
+      quote,
+      startUtf16,
+      endUtf16,
+      url: snapshot.url || "",
+      pageDate: snapshot.pageDate || null,
+      eventDate: snapshot.eventDate || null,
+      fetchedAt: snapshot.fetchedAt || null
+    });
+  }
+
+  return {
+    url: snapshot.url || "",
+    title: snapshot.title || "",
+    pageDate: snapshot.pageDate || null,
+    eventDate: snapshot.eventDate || null,
+    fetchedAt: snapshot.fetchedAt || null,
+    throughputMetrics,
+    latencyMetrics,
+    hardwareSpecs
+  };
+}
+
+function compareBenchmarkThroughputAcrossOptions(submissions = []) {
+  const evaluated = [];
+  const rejected = [];
+
+  for (const sub of submissions || []) {
+    const optionName = String(sub?.optionName || "Option").trim();
+    if (sub?.bareLinkOnly || !sub?.snapshot) {
+      rejected.push({
+        optionName,
+        sourceUrl: sub?.sourceUrl || "",
+        code: "BARE_BENCHMARK_CLAIM_REJECTED",
+        reason: "Голая ссылка на бенчмарк без UTF-16 выдержки не принимается."
+      });
+      continue;
+    }
+
+    const extracted = extractHardwareAndPerformanceBenchmarks(sub.snapshot);
+    const topRps =
+      extracted.throughputMetrics.length > 0
+        ? extracted.throughputMetrics.reduce((best, cur) =>
+            cur.normalizedRps > best.normalizedRps ? cur : best
+          )
+        : null;
+
+    if (!topRps) {
+      rejected.push({
+        optionName,
+        sourceUrl: sub.snapshot.url || "",
+        code: "BENCHMARK_RPS_NOT_FOUND",
+        reason: "На странице не найдена подтверждённая метрика пропускной способности (RPS)."
+      });
+      continue;
+    }
+
+    const p95 = extracted.latencyMetrics.find((l) => l.percentile === "p95") || null;
+
+    evaluated.push({
+      optionName,
+      normalizedRps: topRps.normalizedRps,
+      rpsExcerpt: topRps,
+      p95LatencyMs: p95 ? p95.latencyMs : null,
+      p95Excerpt: p95,
+      hardwareSpecs: extracted.hardwareSpecs,
+      pageDate: sub.snapshot.pageDate || null,
+      eventDate: sub.snapshot.eventDate || null,
+      fetchedAt: sub.snapshot.fetchedAt || null
+    });
+  }
+
+  evaluated.sort((a, b) => b.normalizedRps - a.normalizedRps);
+
+  return {
+    evaluatedCount: evaluated.length,
+    rejectedCount: rejected.length,
+    fastestOptionName: evaluated[0] ? evaluated[0].optionName : null,
+    evaluated,
+    rejected
+  };
+}
+
+module.exports = {
+  extractHardwareAndPerformanceBenchmarks,
+  compareBenchmarkThroughputAcrossOptions
+};
