diff --git a/desktop/windows/browser/bilingual-terminology-mapper.cjs b/desktop/windows/browser/bilingual-terminology-mapper.cjs
new file mode 100644
index 0000000..85aedab
--- /dev/null
+++ b/desktop/windows/browser/bilingual-terminology-mapper.cjs
@@ -0,0 +1,176 @@
+"use strict";
+
+const { normalizeComparableValue } = require("./claim-comparator.cjs");
+
+/**
+ * Koswork Bilingual (RU <-> EN) Technical Terminology & Criterion Mapper
+ * (`desktop/windows/browser/bilingual-terminology-mapper.cjs`).
+ *
+ * Deepens Requirement #2 & #5:
+ * - Aligns Russian and English technical criterion names (`"Цена"` <-> `"Price"` / `"Monthly Cost"`,
+ *   `"Поддержка SLA"` <-> `"Availability SLA"` / `"Uptime SLA"`, `"Автономный режим"` <-> `"Offline Mode"`,
+ *   `"Пропускная способность"` <-> `"Throughput"` / `"RPS"`, `"Задержка"` <-> `"Latency"`,
+ *   `"Шифрование"` <-> `"Encryption"`) so English primary documentation and Russian
+ *   analytical sources can be compared in a single unified comparison table while
+ *   strictly preserving each source's verbatim original-language UTF-16 quote!
+ */
+
+const BILINGUAL_CRITERION_DICTIONARY = Object.freeze([
+  {
+    canonicalId: "price",
+    labelRu: "Цена",
+    labelEn: "Price",
+    synonyms: [
+      "цена",
+      "стоимость",
+      "базовая цена",
+      "тариф",
+      "price",
+      "pricing",
+      "monthly cost",
+      "subscription fee"
+    ]
+  },
+  {
+    canonicalId: "sla",
+    labelRu: "Поддержка SLA",
+    labelEn: "Availability SLA",
+    synonyms: [
+      "поддержка sla",
+      "sla",
+      "уровень sla",
+      "доступность",
+      "availability sla",
+      "uptime sla",
+      "service level agreement"
+    ]
+  },
+  {
+    canonicalId: "offline_mode",
+    labelRu: "Автономный режим",
+    labelEn: "Offline Mode",
+    synonyms: [
+      "автономный режим",
+      "офлайн режим",
+      "локальный режим",
+      "offline mode",
+      "air-gapped mode",
+      "local-first mode"
+    ]
+  },
+  {
+    canonicalId: "throughput",
+    labelRu: "Пропускная способность",
+    labelEn: "Throughput",
+    synonyms: [
+      "пропускная способность",
+      "rps",
+      "запросов в секунду",
+      "throughput",
+      "requests per second"
+    ]
+  },
+  {
+    canonicalId: "latency",
+    labelRu: "Задержка",
+    labelEn: "Latency",
+    synonyms: [
+      "задержка",
+      "задержка p99",
+      "латентность",
+      "время отклика",
+      "latency",
+      "p99 latency",
+      "response time"
+    ]
+  },
+  {
+    canonicalId: "encryption",
+    labelRu: "Шифрование",
+    labelEn: "Encryption",
+    synonyms: [
+      "шифрование",
+      "криптография",
+      "алгоритм шифрования",
+      "encryption",
+      "cipher suite",
+      "at-rest encryption"
+    ]
+  }
+]);
+
+function resolveCanonicalCriterion(rawCriterionName = "") {
+  const clean = String(rawCriterionName || "").trim();
+  const lower = clean.toLowerCase();
+
+  for (const entry of BILINGUAL_CRITERION_DICTIONARY) {
+    if (
+      entry.canonicalId === lower ||
+      entry.labelRu.toLowerCase() === lower ||
+      entry.labelEn.toLowerCase() === lower ||
+      entry.synonyms.includes(lower)
+    ) {
+      return {
+        canonicalId: entry.canonicalId,
+        labelRu: entry.labelRu,
+        labelEn: entry.labelEn,
+        matchedDictionary: true
+      };
+    }
+  }
+
+  return {
+    canonicalId: lower || "custom",
+    labelRu: clean || "Критерий",
+    labelEn: clean || "Criterion",
+    matchedDictionary: false
+  };
+}
+
+function alignBilingualClaimsForOption(claims = []) {
+  const alignedByCanonicalCriterion = new Map();
+
+  for (const c of claims) {
+    if (!c || !c.excerpt || !c.excerpt.quote) continue;
+    const resolved = resolveCanonicalCriterion(c.criterion);
+    const normVal = normalizeComparableValue(c.value || c.excerpt.quote);
+    const key = `${String(c.optionName || "Option").trim()}||${resolved.canonicalId}`;
+
+    if (!alignedByCanonicalCriterion.has(key)) {
+      alignedByCanonicalCriterion.set(key, {
+        optionName: c.optionName || "Option",
+        canonicalCriterionId: resolved.canonicalId,
+        criterionLabelRu: resolved.labelRu,
+        criterionLabelEn: resolved.labelEn,
+        claims: []
+      });
+    }
+
+    alignedByCanonicalCriterion.get(key).claims.push({
+      ...c,
+      canonicalCriterionId: resolved.canonicalId,
+      criterionLabelRu: resolved.labelRu,
+      normalizedValue: normVal
+    });
+  }
+
+  const groups = Array.from(alignedByCanonicalCriterion.values()).map((grp) => {
+    const canonicalKeys = new Set(grp.claims.map((item) => item.normalizedValue.canonicalKey));
+    return {
+      ...grp,
+      crossLanguageCorroborated: grp.claims.length >= 2 && canonicalKeys.size === 1,
+      hasCrossLanguageConflict: canonicalKeys.size > 1
+    };
+  });
+
+  return {
+    alignedGroupsCount: groups.length,
+    groups
+  };
+}
+
+module.exports = {
+  BILINGUAL_CRITERION_DICTIONARY,
+  resolveCanonicalCriterion,
+  alignBilingualClaimsForOption
+};
diff --git a/desktop/windows/browser/contradiction-resolution-matrix.cjs b/desktop/windows/browser/contradiction-resolution-matrix.cjs
new file mode 100644
index 0000000..c97e81b
--- /dev/null
+++ b/desktop/windows/browser/contradiction-resolution-matrix.cjs
@@ -0,0 +1,156 @@
+"use strict";
+
+const { compareFactsForCriterion } = require("./claim-comparator.cjs");
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork Contradiction Resolution Audit Matrix Builder
+ * (`desktop/windows/browser/contradiction-resolution-matrix.cjs`).
+ *
+ * Deepens Requirement #2 & #5:
+ * - Takes competing claims across multiple sources for each `(optionName, criterion)`.
+ * - Uses `compareFactsForCriterion` (`eventDate > pageDate > fetchedAt`) to determine:
+ *   1. Whether the claims actually corroborate each other after unit/currency normalization, or
+ *   2. Which claim is the current authoritative record (`authoritativeFact`) and which
+ *      claims are superseded/outdated (`outdatedFacts`) or contemporaneously conflicting.
+ * - Produces a dedicated Markdown and JSON Contradiction Resolution Matrix saved via
+ *   `workspace-service.cjs` with side-by-side UTF-16 `[startUtf16..endUtf16]` citations.
+ */
+
+function buildContradictionResolutionMatrix(claims = []) {
+  const byCell = new Map();
+
+  for (const c of claims) {
+    if (!c || !c.excerpt || !c.excerpt.quote) continue;
+    const key = `${String(c.optionName || "Option").trim()}||${String(
+      c.criterion || "Spec"
+    ).trim()}`;
+    if (!byCell.has(key)) {
+      byCell.set(key, []);
+    }
+    byCell.get(key).push({
+      optionName: c.optionName || "Option",
+      criterion: c.criterion || "Spec",
+      value: c.value || c.excerpt.quote,
+      displayValue: c.displayValue || c.value || c.excerpt.quote,
+      quote: c.excerpt.quote,
+      startUtf16: c.excerpt.startUtf16,
+      endUtf16: c.excerpt.endUtf16,
+      sourceUrl: c.source?.url || "",
+      sourceTitle: c.source?.title || c.source?.url || "",
+      pageDate: c.source?.pageDate || null,
+      eventDate: c.source?.eventDate || null,
+      fetchedAt: c.source?.fetchedAt || null,
+      excerpt: {
+        quote: c.excerpt.quote,
+        startUtf16: c.excerpt.startUtf16,
+        endUtf16: c.excerpt.endUtf16
+      },
+      source: {
+        url: c.source?.url || "",
+        title: c.source?.title || c.source?.url || "",
+        pageDate: c.source?.pageDate || null,
+        eventDate: c.source?.eventDate || null,
+        fetchedAt: c.source?.fetchedAt || null
+      }
+    });
+  }
+
+  const cells = [];
+  for (const [key, cellFacts] of byCell.entries()) {
+    const [optionName, criterion] = key.split("||");
+    const cmp = compareFactsForCriterion(cellFacts);
+    const outdatedFacts = cellFacts.filter((f) => f.isOutdated);
+
+    cells.push({
+      optionName,
+      criterion,
+      status: cmp.hasConflict ? "contradiction" : cmp.status,
+      corroboratedByMultipleSources: Number(cmp.corroboratingSourcesCount || 0) >= 2,
+      authoritativeFact: cmp.primaryFact || null,
+      outdatedFacts,
+      contradiction: cmp.contradiction || null,
+      outdatedFinding: cmp.outdatedFinding || null,
+      totalFactsCompared: cellFacts.length
+    });
+  }
+
+  return {
+    generatedAt: new Date().toISOString(),
+    totalCells: cells.length,
+    contradictionCellsCount: cells.filter((c) => c.status === "contradiction").length,
+    corroboratedCellsCount: cells.filter((c) => c.corroboratedByMultipleSources).length,
+    cells
+  };
+}
+
+function renderContradictionMatrixMarkdown(matrix) {
+  const lines = [
+    "# Матрица разрешения противоречий и сверки дат источников",
+    "",
+    `| Вариант | Критерий | Статус | Актуальное значение (UTF-16 выдержка) | Устаревшие / конфликтующие данные |`,
+    `| --- | --- | --- | --- | --- |`
+  ];
+
+  for (const cell of matrix.cells || []) {
+    const auth = cell.authoritativeFact;
+    const authCell = auth
+      ? `**${auth.displayValue}** — «${auth.quote}» [${auth.startUtf16}..${auth.endUtf16}] (${auth.sourceUrl}, eventDate: ${auth.eventDate || "н/д"}, pageDate: ${auth.pageDate || "н/д"})`
+      : "Неизвестно";
+
+    const outdatedCell =
+      (cell.outdatedFacts || []).length > 0
+        ? cell.outdatedFacts
+            .map(
+              (o) =>
+                `Устарело: \`${o.displayValue}\` — «${o.quote}» [${o.startUtf16}..${o.endUtf16}] (${o.sourceUrl}, eventDate: ${o.eventDate || "н/д"})`
+            )
+            .join("; ")
+        : "Нет расхождений";
+
+    lines.push(
+      `| ${cell.optionName} | ${cell.criterion} | ${cell.status} | ${authCell} | ${outdatedCell} |`
+    );
+  }
+
+  return lines.join("\n") + "\n";
+}
+
+async function saveContradictionResolutionMatrixViaWorkspace({
+  workspaceRoot,
+  slug = "contradiction-resolution-matrix",
+  claims = [],
+  signal = null
+} = {}) {
+  const matrix = buildContradictionResolutionMatrix(claims);
+  const md = renderContradictionMatrixMarkdown(matrix);
+  const json = JSON.stringify(matrix, null, 2) + "\n";
+
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const mdFile = await svc.createFile({
+    relativePath: `reports/${slug}.md`,
+    content: md,
+    createParents: true,
+    signal
+  });
+  const jsonFile = await svc.createFile({
+    relativePath: `reports/${slug}.json`,
+    content: json,
+    createParents: true,
+    signal
+  });
+
+  return {
+    matrix,
+    markdownFile: mdFile,
+    jsonFile
+  };
+}
+
+module.exports = {
+  buildContradictionResolutionMatrix,
+  renderContradictionMatrixMarkdown,
+  saveContradictionResolutionMatrixViaWorkspace
+};
diff --git a/desktop/windows/browser/page-security-posture-inspector.cjs b/desktop/windows/browser/page-security-posture-inspector.cjs
new file mode 100644
index 0000000..f606b92
--- /dev/null
+++ b/desktop/windows/browser/page-security-posture-inspector.cjs
@@ -0,0 +1,82 @@
+"use strict";
+
+/**
+ * Koswork Page Security Posture, CSP & Mixed-Content Form Inspector
+ * (`desktop/windows/browser/page-security-posture-inspector.cjs`).
+ *
+ * Deepens Requirement #4:
+ * - Inspects an open page's transport security (`https:` vs `http:`), `<meta http-equiv="Content-Security-Policy">`,
+ *   Subresource Integrity (`integrity="sha256-..."` / `sha384-...`) on downloadable links/scripts,
+ *   and `<form action="http://...">` mixed-content form submission downgrades on HTTPS pages.
+ * - Blocks form submission on an HTTPS page if the form's `action` downgrades transport
+ *   to plaintext `http://` on a non-loopback host (`MIXED_CONTENT_FORM_ACTION_BLOCKED`).
+ */
+
+function inspectPageSecurityPosture({ pageUrl = "", rawHtml = "" } = {}) {
+  let parsedPageUrl = null;
+  try {
+    parsedPageUrl = new URL(String(pageUrl));
+  } catch {
+    parsedPageUrl = null;
+  }
+
+  const isHttpsPage = parsedPageUrl ? parsedPageUrl.protocol === "https:" : false;
+  const html = String(rawHtml || "");
+
+  // 1. Extract CSP meta directives if present
+  const cspMatch = html.match(
+    /<meta\b[^>]+http-equiv=["']Content-Security-Policy["'][^>]+content=["']([^"']+)["']/i
+  );
+  const cspPolicy = cspMatch ? cspMatch[1].trim() : null;
+
+  // 2. Check `<form action="...">` for HTTPS -> HTTP mixed-content downgrade
+  const mixedContentFormActions = [];
+  const formRegex = /<form\b([^>]*)>/gi;
+  let fm;
+  while ((fm = formRegex.exec(html)) !== null) {
+    const attrs = fm[1] || "";
+    const actMatch = attrs.match(/\baction=["']([^"']+)["']/i);
+    if (!actMatch) continue;
+    try {
+      const resolvedAction = new URL(actMatch[1].trim(), pageUrl);
+      const isLoopback =
+        resolvedAction.hostname === "127.0.0.1" || resolvedAction.hostname === "localhost";
+      if (isHttpsPage && resolvedAction.protocol === "http:" && !isLoopback) {
+        mixedContentFormActions.push(resolvedAction.toString());
+      }
+    } catch {
+      // ignore invalid URLs
+    }
+  }
+
+  // 3. Extract Subresource Integrity (SRI) attributes (`integrity="sha256-..."`)
+  const sriProtectedResources = [];
+  const sriRegex = /<(a|script|link)\b([^>]*\bintegrity=["']([^"']+)["'][^>]*)>/gi;
+  let sm;
+  while ((sm = sriRegex.exec(html)) !== null) {
+    const tag = sm[1].toLowerCase();
+    const attrs = sm[2] || "";
+    const integrity = sm[3].trim();
+    const refMatch = attrs.match(/\b(?:href|src)=["']([^"']+)["']/i);
+    sriProtectedResources.push({
+      tag,
+      resourceUrl: refMatch ? refMatch[1].trim() : null,
+      integrity
+    });
+  }
+
+  return {
+    pageUrl,
+    isHttpsPage,
+    hasCspMeta: Boolean(cspPolicy),
+    cspPolicy,
+    safeForFormSubmit: mixedContentFormActions.length === 0,
+    mixedContentFormActions,
+    sriProtectedCount: sriProtectedResources.length,
+    sriProtectedResources
+  };
+}
+
+module.exports = {
+  inspectPageSecurityPosture
+};
