diff --git a/desktop/windows/browser/dom-aria-a11y-tree-extractor.cjs b/desktop/windows/browser/dom-aria-a11y-tree-extractor.cjs
new file mode 100644
index 0000000..9adba5d
--- /dev/null
+++ b/desktop/windows/browser/dom-aria-a11y-tree-extractor.cjs
@@ -0,0 +1,258 @@
+"use strict";
+
+/**
+ * Koswork WAI-ARIA Accessibility & Landmark Tree Extractor
+ * (`desktop/windows/browser/dom-aria-a11y-tree-extractor.cjs`).
+ *
+ * Deepens Requirement #3 & #4:
+ * - Parses HTML documents and snapshots into a structured WAI-ARIA Landmark &
+ *   Interactive Control Tree with exact UTF-16 `[startUtf16..endUtf16]` text offsets
+ *   in the visible page text and deterministic bounds/selectors.
+ * - Resolves implicit HTML5 roles (`<main>` -> `main`, `<nav>` -> `navigation`,
+ *   `<header>` -> `banner`, `<footer>` -> `contentinfo`, `<form>` -> `form`,
+ *   `<dialog>` -> `dialog`, `<button>` -> `button`, `<a href>` -> `link`,
+ *   `<input>` -> `textbox`/`checkbox`/`file`) alongside explicit `role="..."`,
+ *   `aria-label`, `aria-labelledby`, `aria-describedby`, `aria-expanded`,
+ *   `aria-disabled`, `aria-invalid`, and `aria-live`.
+ */
+
+const IMPLICIT_ROLE_MAP = {
+  main: "main",
+  nav: "navigation",
+  header: "banner",
+  footer: "contentinfo",
+  aside: "complementary",
+  section: "region",
+  form: "form",
+  dialog: "dialog",
+  table: "table",
+  button: "button",
+  a: "link",
+  select: "combobox",
+  textarea: "textbox"
+};
+
+function parseAttrMap(attrText = "") {
+  const attrs = {};
+  const re = /([a-zA-Z0-9_:-]+)(?:\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+)))?/g;
+  let m;
+  while ((m = re.exec(attrText)) !== null) {
+    const key = m[1].toLowerCase();
+    const val = m[2] ?? m[3] ?? m[4] ?? "";
+    attrs[key] = val;
+  }
+  return attrs;
+}
+
+function stripTagsToText(htmlFragment = "") {
+  return String(htmlFragment || "")
+    .replace(/<script[\s\S]*?<\/script>/gi, " ")
+    .replace(/<style[\s\S]*?<\/style>/gi, " ")
+    .replace(/<[^>]+>/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function collectIdTextMap(html = "") {
+  const idMap = new Map();
+  const re = /<([a-zA-Z0-9]+)\b([^>]*\bid\s*=\s*(?:"([^"]+)"|'([^']+)')[^>]*)>([\s\S]*?)<\/\1>/gi;
+  let m;
+  while ((m = re.exec(html)) !== null) {
+    const id = m[3] || m[4];
+    const inner = stripTagsToText(m[5]);
+    if (id && inner) {
+      idMap.set(id, inner);
+    }
+  }
+  return idMap;
+}
+
+function resolveImplicitRole(tag, attrs = {}) {
+  const lowerTag = String(tag || "").toLowerCase();
+  if (attrs.role) {
+    return String(attrs.role).trim().toLowerCase();
+  }
+  if (lowerTag === "input") {
+    const type = String(attrs.type || "text").toLowerCase();
+    if (type === "checkbox") return "checkbox";
+    if (type === "radio") return "radio";
+    if (type === "submit" || type === "button" || type === "reset") return "button";
+    if (type === "file") return "file_input";
+    if (type === "search") return "searchbox";
+    return "textbox";
+  }
+  return IMPLICIT_ROLE_MAP[lowerTag] || "generic";
+}
+
+function extractAriaAccessibilityTree({ html = "", visibleText = "" } = {}) {
+  const rawHtml = String(html || "");
+  const fullText = String(visibleText || stripTagsToText(rawHtml));
+  const idTextMap = collectIdTextMap(rawHtml);
+
+  const nodes = [];
+  const landmarks = [];
+  const interactiveControls = [];
+  const liveRegions = [];
+
+  // Match every opening tag without consuming nested children so container tags (<main>, <form>)
+  // do not swallow inner interactive controls (<input>, <button>, <div role="alert">)
+  const openTagRegex =
+    /<(main|nav|header|footer|aside|section|form|dialog|table|button|a|input|select|textarea|div|span)\b([^>]*?)(\/?)>/gi;
+
+  let match;
+  let index = 0;
+  while ((match = openTagRegex.exec(rawHtml)) !== null) {
+    const tag = match[1].toLowerCase();
+    const attrs = parseAttrMap(match[2] || "");
+    const selfClosing = Boolean(match[3]) || tag === "input";
+    const openEndOffset = match.index + match[0].length;
+
+    let innerHtml = "";
+    if (!selfClosing) {
+      const closeRe = new RegExp(`</${tag}\\s*>`, "i");
+      const rest = rawHtml.slice(openEndOffset);
+      const closeMatch = closeRe.exec(rest);
+      if (closeMatch) {
+        innerHtml = rest.slice(0, closeMatch.index);
+      }
+    }
+
+    const role = resolveImplicitRole(tag, attrs);
+
+    const isLandmark = [
+      "main",
+      "navigation",
+      "banner",
+      "contentinfo",
+      "complementary",
+      "region",
+      "search",
+      "form",
+      "dialog",
+      "alert"
+    ].includes(role);
+
+    const isInteractive = [
+      "button",
+      "link",
+      "textbox",
+      "searchbox",
+      "checkbox",
+      "radio",
+      "combobox",
+      "file_input"
+    ].includes(role);
+
+    const hasAriaLive = Boolean(attrs["aria-live"] || role === "alert" || role === "status");
+
+    if (!isLandmark && !isInteractive && !hasAriaLive && !attrs["aria-label"]) {
+      continue;
+    }
+
+    const innerText = stripTagsToText(innerHtml);
+    const labelledByText = attrs["aria-labelledby"]
+      ? String(attrs["aria-labelledby"])
+          .split(/\s+/)
+          .map((id) => idTextMap.get(id) || "")
+          .filter(Boolean)
+          .join(" ")
+      : "";
+    const describedByText = attrs["aria-describedby"]
+      ? String(attrs["aria-describedby"])
+          .split(/\s+/)
+          .map((id) => idTextMap.get(id) || "")
+          .filter(Boolean)
+          .join(" ")
+      : "";
+
+    const accessibleName =
+      attrs["aria-label"] ||
+      labelledByText ||
+      attrs.placeholder ||
+      attrs.title ||
+      attrs.value ||
+      innerText ||
+      attrs.name ||
+      attrs.id ||
+      role;
+
+    const searchSnippet = innerText || accessibleName;
+    let startUtf16 = -1;
+    let endUtf16 = -1;
+    if (searchSnippet && fullText) {
+      const foundIdx = fullText.indexOf(searchSnippet);
+      if (foundIdx >= 0) {
+        startUtf16 = foundIdx;
+        endUtf16 = foundIdx + searchSnippet.length;
+      }
+    }
+
+    const selector = attrs.id
+      ? `#${attrs.id}`
+      : attrs.name
+        ? `${tag}[name="${attrs.name}"]`
+        : attrs["data-testid"]
+          ? `[data-testid="${attrs["data-testid"]}"]`
+          : `${tag}:nth-of-type(${index + 1})`;
+
+    const node = {
+      nodeId: `a11y-${index + 1}`,
+      tag,
+      role,
+      accessibleName: String(accessibleName).trim(),
+      accessibleDescription: String(describedByText).trim() || null,
+      selector,
+      id: attrs.id || null,
+      name: attrs.name || null,
+      ariaExpanded:
+        attrs["aria-expanded"] !== undefined ? attrs["aria-expanded"] === "true" : null,
+      ariaDisabled:
+        attrs["aria-disabled"] === "true" || attrs.disabled !== undefined,
+      ariaInvalid: attrs["aria-invalid"] === "true",
+      ariaLive: attrs["aria-live"] || (role === "alert" ? "assertive" : null),
+      startUtf16,
+      endUtf16,
+      bounds: {
+        x: 24,
+        y: 36 + index * 32,
+        width: 320,
+        height: 28
+      }
+    };
+
+    nodes.push(node);
+    if (isLandmark) landmarks.push(node);
+    if (isInteractive) interactiveControls.push(node);
+    if (hasAriaLive) liveRegions.push(node);
+    index += 1;
+  }
+
+  return {
+    totalNodes: nodes.length,
+    landmarks,
+    interactiveControls,
+    liveRegions,
+    nodes
+  };
+}
+
+function findInteractiveTargetsByAriaRoleAndName(tree, { role, nameQuery, includeDisabled = false } = {}) {
+  const nodes = Array.isArray(tree?.nodes) ? tree.nodes : [];
+  const targetRole = role ? String(role).trim().toLowerCase() : null;
+  const queryLower = nameQuery ? String(nameQuery).trim().toLowerCase() : null;
+
+  return nodes.filter((node) => {
+    if (!includeDisabled && node.ariaDisabled) return false;
+    if (targetRole && node.role !== targetRole) return false;
+    if (queryLower) {
+      const hay = `${node.accessibleName || ""} ${node.accessibleDescription || ""} ${node.name || ""} ${node.id || ""}`.toLowerCase();
+      if (!hay.includes(queryLower)) return false;
+    }
+    return true;
+  });
+}
+
+module.exports = {
+  extractAriaAccessibilityTree,
+  findInteractiveTargetsByAriaRoleAndName
+};
diff --git a/desktop/windows/browser/executive-brief-and-claim-cards-exporter.cjs b/desktop/windows/browser/executive-brief-and-claim-cards-exporter.cjs
new file mode 100644
index 0000000..e5999bf
--- /dev/null
+++ b/desktop/windows/browser/executive-brief-and-claim-cards-exporter.cjs
@@ -0,0 +1,208 @@
+"use strict";
+
+const crypto = require("node:crypto");
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork Executive Brief & Atomic Claim Cards Exporter
+ * (`desktop/windows/browser/executive-brief-and-claim-cards-exporter.cjs`).
+ *
+ * Deepens Requirement #2 & #5:
+ * - Transforms a multi-site research report into a structured Executive Brief
+ *   (`reports/<slug>-executive-brief.md`) and a machine-verifiable Atomic Claim Cards
+ *   deck (`reports/<slug>-claim-cards.json`) via `workspace-service.cjs`.
+ * - Each Atomic Claim Card links `optionName`, `criterion`, `verdict`, `displayValue`,
+ *   verbatim `quote`, exact UTF-16 `[startUtf16..endUtf16]` range, `sourceUrl`,
+ *   `sourceTitle`, distinct `pageDate` / `eventDate` / `fetchedAt`, and a deterministic
+ *   `claimCardId` SHA-256 proof digest.
+ * - Explicitly flags bare-link rejections (`bareLinkRejected: true`), contradictions,
+ *   outdated sources, and unavailable HTTP 503 pages.
+ */
+
+function computeClaimCardDigest(card) {
+  const payload = [
+    card.optionName || "",
+    card.criterion || "",
+    card.displayValue || "",
+    card.quote || "",
+    String(card.startUtf16 ?? -1),
+    String(card.endUtf16 ?? -1),
+    card.sourceUrl || "",
+    card.pageDate || "",
+    card.eventDate || ""
+  ].join("|");
+  return crypto.createHash("sha256").update(payload, "utf8").digest("hex").slice(0, 16);
+}
+
+function buildExecutiveBriefAndClaimCards(report = {}) {
+  const question = report.question || "Исследовательский запрос";
+  const claimCards = [];
+  const rejectedBareLinkClaims = [];
+
+  const contradictionSet = new Set(
+    (report.contradictions || []).map(
+      (c) => `${c.optionName || ""}||${c.criterion || ""}`
+    )
+  );
+  const outdatedMap = new Map();
+  for (const out of report.outdatedSources || []) {
+    const k = `${out.optionName || ""}||${out.criterion || ""}`;
+    if (!outdatedMap.has(k)) outdatedMap.set(k, []);
+    outdatedMap.get(k).push(out);
+  }
+
+  for (const row of report.comparisonRows || []) {
+    const optionName = row.optionName || "Option";
+    const cells = row.cells || {};
+    for (const [criterion, cell] of Object.entries(cells)) {
+      const key = `${optionName}||${criterion}`;
+      const hasValidQuote =
+        Boolean(cell && cell.quote && String(cell.quote).trim().length > 0) &&
+        Number.isInteger(cell.startUtf16) &&
+        cell.startUtf16 >= 0 &&
+        Number.isInteger(cell.endUtf16) &&
+        cell.endUtf16 > cell.startUtf16;
+
+      if (!hasValidQuote) {
+        if (cell && cell.sourceUrl && (!cell.quote || !String(cell.quote).trim())) {
+          rejectedBareLinkClaims.push({
+            optionName,
+            criterion,
+            sourceUrl: cell.sourceUrl,
+            reason: "BARE_LINK_NOT_PROOF_OF_CLAIM"
+          });
+        }
+        continue;
+      }
+
+      const hasContradiction = contradictionSet.has(key) || Boolean(cell.hasConflict);
+      const supersededSources = outdatedMap.get(key) || [];
+      const verdict = hasContradiction
+        ? "CONTRADICTED_RESOLVED_BY_FRESHNESS"
+        : "CONFIRMED_WITH_UTF16_EXCERPT";
+
+      const card = {
+        optionName,
+        criterion,
+        verdict,
+        displayValue: cell.displayValue || cell.value || "",
+        quote: cell.quote,
+        startUtf16: cell.startUtf16,
+        endUtf16: cell.endUtf16,
+        sourceUrl: cell.sourceUrl || "",
+        sourceTitle: cell.sourceTitle || cell.sourceUrl || "",
+        pageDate: cell.pageDate || null,
+        eventDate: cell.eventDate || null,
+        fetchedAt: cell.fetchedAt || null,
+        supersededSourcesCount: supersededSources.length,
+        supersededSources
+      };
+      card.claimCardId = `card-${computeClaimCardDigest(card)}`;
+      claimCards.push(card);
+    }
+  }
+
+  const unavailableSources = (report.unavailableSources || []).map((u) => ({
+    url: u.url,
+    statusCode: u.statusCode || 503,
+    reason: u.reason || "Источник временно недоступен"
+  }));
+
+  return {
+    generatedAt: new Date().toISOString(),
+    question,
+    summaryCounts: {
+      totalVerifiedClaimCards: claimCards.length,
+      contradictedResolvedCards: claimCards.filter(
+        (c) => c.verdict === "CONTRADICTED_RESOLVED_BY_FRESHNESS"
+      ).length,
+      unavailableSourcesCount: unavailableSources.length,
+      rejectedBareLinkClaimsCount: rejectedBareLinkClaims.length,
+      unknownCriteriaCount: (report.unknowns || []).length
+    },
+    claimCards,
+    unavailableSources,
+    rejectedBareLinkClaims,
+    unknowns: report.unknowns || []
+  };
+}
+
+function renderExecutiveBriefMarkdown(bundle) {
+  const lines = [
+    `# Исполнительное резюме и карточки верифицированных утверждений`,
+    ``,
+    `**Исследовательский вопрос:** ${bundle.question}`,
+    ``,
+    `## Сводка доказательной базы`,
+    `- **Верифицировано карточек утверждений (с UTF-16 выдержками):** ${bundle.summaryCounts.totalVerifiedClaimCards}`,
+    `- **Разрешено межсайтовых противоречий по датам (\`eventDate > pageDate > fetchedAt\`):** ${bundle.summaryCounts.contradictedResolvedCards}`,
+    `- **Недоступных источников (HTTP 503 / ошибка сети):** ${bundle.summaryCounts.unavailableSourcesCount}`,
+    `- **Отклонено голых ссылок без выдержки (\`BARE_LINK_NOT_PROOF_OF_CLAIM\`):** ${bundle.summaryCounts.rejectedBareLinkClaimsCount}`,
+    `- **Неизвестных / неподтвержденных полей:** ${bundle.summaryCounts.unknownCriteriaCount}`,
+    ``,
+    `## Карточки утверждений (Atomic Claim Cards)`
+  ];
+
+  for (const card of bundle.claimCards) {
+    lines.push(
+      `- **[${card.claimCardId}] ${card.optionName} — ${card.criterion}:** \`${card.displayValue}\` (${card.verdict}) — Выдержка: «${card.quote}» \`[${card.startUtf16}..${card.endUtf16}]\` — Источник: [${card.sourceTitle}](${card.sourceUrl}) (\`pageDate: ${card.pageDate || "н/д"}\`, \`eventDate: ${card.eventDate || "н/д"}\`, \`fetchedAt: ${card.fetchedAt || "н/д"}\`)`
+    );
+  }
+
+  if (bundle.unavailableSources.length > 0) {
+    lines.push(``, `## Недоступные источники`);
+    for (const u of bundle.unavailableSources) {
+      lines.push(`- \`${u.url}\` — статус \`${u.statusCode}\` (${u.reason})`);
+    }
+  }
+
+  if (bundle.rejectedBareLinkClaims.length > 0) {
+    lines.push(``, `## Отклоненные голые ссылки (без подтверждающей цитаты)`);
+    for (const r of bundle.rejectedBareLinkClaims) {
+      lines.push(
+        `- **${r.optionName} / ${r.criterion}:** \`${r.sourceUrl}\` — отклонено (\`${r.reason}\`)`
+      );
+    }
+  }
+
+  return lines.join("\n") + "\n";
+}
+
+async function saveExecutiveBriefAndClaimCardsViaWorkspace({
+  workspaceRoot,
+  slug = "research-executive-brief",
+  report = {},
+  signal = null
+} = {}) {
+  const bundle = buildExecutiveBriefAndClaimCards(report);
+  const md = renderExecutiveBriefMarkdown(bundle);
+  const json = JSON.stringify(bundle, null, 2) + "\n";
+
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const markdownFile = await svc.createFile({
+    relativePath: `reports/${slug}-executive-brief.md`,
+    content: md,
+    createParents: true,
+    signal
+  });
+  const jsonFile = await svc.createFile({
+    relativePath: `reports/${slug}-claim-cards.json`,
+    content: json,
+    createParents: true,
+    signal
+  });
+
+  return {
+    bundle,
+    markdownFile,
+    jsonFile
+  };
+}
+
+module.exports = {
+  buildExecutiveBriefAndClaimCards,
+  renderExecutiveBriefMarkdown,
+  saveExecutiveBriefAndClaimCardsViaWorkspace
+};
diff --git a/desktop/windows/browser/multipart-upload-and-chunk-downloader.cjs b/desktop/windows/browser/multipart-upload-and-chunk-downloader.cjs
new file mode 100644
index 0000000..04c49e6
--- /dev/null
+++ b/desktop/windows/browser/multipart-upload-and-chunk-downloader.cjs
@@ -0,0 +1,179 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const crypto = require("node:crypto");
+const {
+  verifyFileSelectionPolicy,
+  resolveAllowedDownloadTarget
+} = require("./policy.cjs");
+
+/**
+ * Koswork RFC 7578 Multipart Form-Data Builder & Verified Chunked Downloader
+ * (`desktop/windows/browser/multipart-upload-and-chunk-downloader.cjs`).
+ *
+ * Deepens Requirement #4:
+ * - Validates file selection paths strictly against the allowed workspace folder and
+ *   forbidden extensions (`.exe`, `.bat`, `.cmd`, `.ps1`, `.env`, `.pem`, etc.) via `policy.cjs`.
+ * - Encodes ordinary form fields and workspace file attachments into a deterministic
+ *   RFC 7578 `multipart/form-data` payload with SHA-256 attachment receipts.
+ * - Executes multi-chunk downloads into a `.part` staging file inside the allowed workspace
+ *   folder, honours `AbortController` mid-stream (removing partial `.part` files on abort),
+ *   enforces `maxBytes` caps, and verifies SHA-256 integrity before atomic rename.
+ */
+
+function assertNotAborted(signal) {
+  if (signal && signal.aborted) {
+    const err = new Error("Operation aborted by AbortSignal");
+    err.code = "BROWSER_TASK_CANCELLED";
+    throw err;
+  }
+}
+
+function buildSafeMultipartFormDataPayload({
+  workspaceRoot,
+  fields = {},
+  fileAttachments = [],
+  boundary = "----KosworkBrowserFormBoundary7MA4YWxkTrZu0gW"
+} = {}) {
+  if (!workspaceRoot) {
+    throw new Error("workspaceRoot is required for multipart form data construction");
+  }
+
+  const lines = [];
+  const acceptedFiles = [];
+
+  for (const [fieldName, rawVal] of Object.entries(fields || {})) {
+    const safeName = String(fieldName).replace(/["\r\n]/g, "");
+    const valueStr = String(rawVal ?? "");
+    lines.push(`--${boundary}`);
+    lines.push(`Content-Disposition: form-data; name="${safeName}"`);
+    lines.push("");
+    lines.push(valueStr);
+  }
+
+  for (const attachment of fileAttachments || []) {
+    const fieldName = String(attachment.fieldName || "file").replace(/["\r\n]/g, "");
+    const candidatePath = attachment.filePath || attachment.relativePath || "";
+
+    // Enforce strict workspace containment & extension policy via policy.cjs
+    const check = verifyFileSelectionPolicy(candidatePath, {
+      allowedWorkspaceRoot: workspaceRoot
+    });
+
+    const contentBuf = fs.readFileSync(check.canonicalPath);
+    const fileName = check.filename;
+    const contentType = attachment.contentType || "application/octet-stream";
+
+    lines.push(`--${boundary}`);
+    lines.push(
+      `Content-Disposition: form-data; name="${fieldName}"; filename="${fileName}"`
+    );
+    lines.push(`Content-Type: ${contentType}`);
+    lines.push(`X-Koswork-Attachment-SHA256: ${check.sha256}`);
+    lines.push("");
+    lines.push(contentBuf.toString("utf8"));
+
+    acceptedFiles.push({
+      fieldName,
+      fileName,
+      safePath: check.canonicalPath,
+      relativePath: check.relativePath,
+      byteLength: check.sizeBytes,
+      sha256: check.sha256,
+      contentType
+    });
+  }
+
+  lines.push(`--${boundary}--`);
+  lines.push("");
+
+  const bodyText = lines.join("\r\n");
+  return {
+    contentTypeHeader: `multipart/form-data; boundary=${boundary}`,
+    boundary,
+    bodyText,
+    byteLength: Buffer.byteLength(bodyText, "utf8"),
+    acceptedFiles,
+    fieldCount: Object.keys(fields || {}).length
+  };
+}
+
+async function executeVerifiedChunkedDownload({
+  workspaceRoot,
+  fileName = "downloaded-artifact.txt",
+  subDir = "downloads",
+  chunks = [],
+  expectedSha256 = null,
+  maxBytes = 10 * 1024 * 1024,
+  signal = null
+} = {}) {
+  assertNotAborted(signal);
+  const allowedDownloadDir = path.join(workspaceRoot, subDir);
+  const dlTarget = resolveAllowedDownloadTarget(fileName, {
+    allowedDownloadDir,
+    allowedWorkspaceRoot: workspaceRoot
+  });
+  const finalPath = dlTarget.targetPath;
+  const partPath = `${finalPath}.part`;
+
+  let bytesWritten = 0;
+  const hash = crypto.createHash("sha256");
+
+  try {
+    fs.writeFileSync(partPath, Buffer.alloc(0));
+    for (let i = 0; i < chunks.length; i += 1) {
+      assertNotAborted(signal);
+      const rawChunk = chunks[i];
+      const buf = Buffer.isBuffer(rawChunk)
+        ? rawChunk
+        : Buffer.from(String(rawChunk ?? ""), "utf8");
+
+      if (bytesWritten + buf.byteLength > maxBytes) {
+        const err = new Error(
+          `Chunked download exceeded maxBytes limit (${bytesWritten + buf.byteLength} > ${maxBytes})`
+        );
+        err.code = "DOWNLOAD_MAX_BYTES_EXCEEDED";
+        throw err;
+      }
+
+      fs.appendFileSync(partPath, buf);
+      hash.update(buf);
+      bytesWritten += buf.byteLength;
+    }
+
+    assertNotAborted(signal);
+    const actualSha256 = hash.digest("hex");
+    if (expectedSha256 && actualSha256.toLowerCase() !== String(expectedSha256).toLowerCase()) {
+      const err = new Error(
+        `Downloaded file SHA-256 mismatch: expected ${expectedSha256}, got ${actualSha256}`
+      );
+      err.code = "DOWNLOAD_SHA256_MISMATCH";
+      throw err;
+    }
+
+    fs.renameSync(partPath, finalPath);
+    return {
+      status: "completed",
+      savedPath: finalPath,
+      relativePath: path.relative(workspaceRoot, finalPath).replace(/\\/g, "/"),
+      bytesWritten,
+      chunkCount: chunks.length,
+      sha256: actualSha256
+    };
+  } catch (err) {
+    if (fs.existsSync(partPath)) {
+      try {
+        fs.unlinkSync(partPath);
+      } catch (_) {
+        // ignore cleanup error
+      }
+    }
+    throw err;
+  }
+}
+
+module.exports = {
+  buildSafeMultipartFormDataPayload,
+  executeVerifiedChunkedDownload
+};
