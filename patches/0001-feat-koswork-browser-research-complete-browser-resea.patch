+  assert.equal(submitRes.status, "ok");
+  assert.equal(submitRes.effectVerified, true);
+  assert.ok(submitRes.snapshot.fullTextUtf16.includes('Принято для "Koswork Researcher"'));
+
+  const dlRes = await engine.downloadFromPage({
+    tabId: "tab-form",
+    downloadControlId: "download-link"
+  });
+  assert.equal(dlRes.status, "ok");
+  assert.ok(dlRes.resolvedPath.startsWith(path.join(workspaceRoot, "downloads")));
+  assert.ok(fs.readFileSync(dlRes.resolvedPath, "utf8").includes("Koswork Researcher"));
+
+  // 2d. Manual user action invalidates stale agent observation (`OBSERVATION_INVALIDATED_BY_USER`)
+  const staleObservation = engine.observePage("tab-form").snapshot;
+  engine.recordUserAction("tab-form", {
+    type: "user_manual_scroll_and_edit",
+    detail: { scrollY: 420 }
+  });
+
+  assert.throws(
+    () =>
+      engine.fillForm({
+        tabId: "tab-form",
+        observedSnapshot: staleObservation,
+        fields: { "applicant-name": "Stale Agent Input" }
+      }),
+    (err) =>
+      err instanceof KosworkBrowserRecoveryError &&
+      err.code === "OBSERVATION_INVALIDATED_BY_USER"
+  );
+
+  // Re-observing after manual user action restores valid observation epoch
+  const freshObservation = engine.observePage("tab-form", { reuseSnapshot: false }).snapshot;
+  const freshFill = engine.fillForm({
+    tabId: "tab-form",
+    observedSnapshot: freshObservation,
+    fields: { "applicant-name": "Updated After Re-Observe" }
+  });
+  assert.equal(freshFill.status, "ok");
+
+  // 2e. CAPTCHA and Login pages pause for the user (`status: "paused_for_user"`)
+  engine.registerSyntheticSite("https://corpus.local/protected-captcha", {
