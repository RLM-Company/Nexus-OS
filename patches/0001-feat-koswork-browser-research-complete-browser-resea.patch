+        tabId: "tab-form",
+        controlId: "attachment-file",
+        filePaths: [forbiddenExePath]
+      }),
+    (err) => err instanceof KosworkBrowserPolicyError && err.code === "BROWSER_FORBIDDEN_ATTACHMENT"
+  );
+
+  assert.throws(
+    () =>
+      engine.selectFiles({
+        tabId: "tab-form",
+        controlId: "attachment-file",
+        filePaths: [forbiddenEnvPath]
+      }),
+    (err) => err instanceof KosworkBrowserPolicyError && err.code === "BROWSER_FORBIDDEN_ATTACHMENT"
+  );
+
+  assert.throws(
+    () =>
+      engine.selectFiles({
+        tabId: "tab-form",
+        controlId: "attachment-file",
