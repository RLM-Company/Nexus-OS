+
+    this.userTakeover = options.userTakeover || new UserTakeoverTracker();
+    this.tabs = new Map(); // tabId -> tabState
+    this.syntheticSites = new Map(); // normalizedUrl -> siteDefinition
+    this.nextTabCounter = 1;
+
+    this.searchService =
