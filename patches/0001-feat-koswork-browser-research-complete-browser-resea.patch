+
+  engine.closeTab("tab-form");
+  assert.throws(
+    () => engine.observePage("tab-form"),
+    (err) => err instanceof KosworkBrowserRecoveryError && err.code === "TAB_LOST_OR_CLOSED"
+  );
+});
