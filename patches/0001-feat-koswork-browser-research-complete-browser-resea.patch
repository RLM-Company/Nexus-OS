+      nextControls = mutation.controls;
+    } else if (mutation.replaceControlLabel) {
+      const { controlId, newLabel } = mutation.replaceControlLabel;
+      nextControls = nextControls.map((c) =>
+        c.id === controlId ? { ...c, label: newLabel } : c
+      );
+    }
