+  ".p12",
+  ".kdbx",
+  ".sqlite",
+  ".sqlite3",
+  ".db",
+  ".db-wal"
+]);
+
+const SENSITIVE_FILENAME_PATTERNS = [
+  /^\.env(\..+)?$/i,
+  /^id_(rsa|dsa|ecdsa|ed25519)(\.pub)?$/i,
+  /^(credentials|secrets|tokens|passwords|auth)(\..+)?$/i,
+  /^\.npmrc$/i,
+  /^\.netrc$/i,
+  /^\.git-credentials$/i,
+  /^koswork-workspace-state\.json$/i
+];
+
+const FORBIDDEN_DOWNLOAD_EXTENSIONS = new Set([
+  ".exe",
+  ".dll",
+  ".ps1",
+  ".bat",
+  ".cmd",
+  ".com",
+  ".msi",
+  ".lnk",
+  ".scr",
+  ".hta",
+  ".vbs",
+  ".reg"
+]);
+
+const CAPTCHA_PATTERNS = [
+  /\bcaptcha\b/i,
+  /\bg-recaptcha\b/i,
+  /\bhcaptcha\b/i,
+  /\bcf-turnstile\b/i,
+  /verify you are human/i,
+  /are you a robot/i,
+  /подтвердите,\s*что вы не робот/i,
+  /проверка безопасности:\s*капча/i
+];
+
+const LOGIN_WALL_PATTERNS = [
+  /войдите в аккаунт/i,
+  /требуется вход/i,
+  /sign in to continue/i,
+  /log in to continue/i,
+  /authentication required/i,
+  /двухфакторная аутентификация/i,
+  /two-factor authentication/i
+];
+
+class KosworkBrowserPolicyError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.name = "KosworkBrowserPolicyError";
+    this.code = code;
+    this.details = details;
+  }
+}
+
+/**
+ * Evaluates whether a target URL is permitted for navigation inside the Koswork Browser.
+ */
+function evaluateNavigationPolicy(rawUrl, options = {}) {
+  const allowLocalLoopback = options.allowLocalLoopback !== false;
+  const urlText = String(rawUrl || "").trim();
+  if (!urlText) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_INVALID_URL",
+      "URL перехода не может быть пустым.",
+      { rawUrl }
+    );
+  }
+
+  if (/^koswork:\/\/search\/srch-[a-f0-9]{16}$/i.test(urlText)) {
+    return {
+      allowed: true,
+      normalizedUrl: urlText,
+      protocol: "koswork:",
+      hostname: "search",
+      isInternalReceipt: true
+    };
+  }
+
+  let parsed;
+  try {
+    parsed = new URL(urlText);
+  } catch {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_INVALID_URL",
+      `Некорректный формат URL: "${urlText}".`,
+      { rawUrl: urlText }
+    );
+  }
+
+  const protocol = parsed.protocol.toLowerCase();
+  if (protocol !== "http:" && protocol !== "https:") {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_NAVIGATION_PROTOCOL_FORBIDDEN",
+      `Протокол "${protocol}" запрещён в браузере Koswork. Разрешены только http: и https:.`,
+      { url: urlText, protocol }
+    );
+  }
+
+  const hostname = parsed.hostname.toLowerCase();
+  if (
+    hostname === "169.254.169.254" ||
+    hostname === "metadata.google.internal" ||
+    hostname === "100.100.100.200"
+  ) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_SSRF_METADATA_BLOCKED",
+      `Доступ к облачному сервису метаданных (${hostname}) заблокирован политикой безопасности.`,
+      { url: urlText, hostname }
+    );
+  }
+
+  const isLoopback =
+    hostname === "localhost" ||
+    hostname === "127.0.0.1" ||
+    hostname === "[::1]" ||
+    hostname.endsWith(".localhost");
+
+  if (isLoopback && !allowLocalLoopback) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_LOOPBACK_DISABLED",
+      `Доступ к локальному адресу (${hostname}) отключён в текущем режиме.`,
+      { url: urlText, hostname }
+    );
+  }
+
+  return {
+    allowed: true,
+    normalizedUrl: parsed.toString(),
+    protocol,
+    hostname,
+    isLoopback,
+    isInternalReceipt: false
+  };
+}
+
+/**
+ * Inspects a page snapshot or DOM state for CAPTCHA challenges, login walls, or HTTP 401/403 gates.
+ * When detected, the browser engine MUST pause for the user rather than attempting to bypass access restrictions.
+ */
+function detectAuthOrCaptchaGate(pageSnapshot = {}) {
+  const status = Number(pageSnapshot.httpStatus ?? pageSnapshot.status ?? 200);
+  const title = String(pageSnapshot.title || "");
+  const bodyText = String(pageSnapshot.fullTextUtf16 || pageSnapshot.text || "");
+  const html = String(pageSnapshot.html || "");
+  const controls = Array.isArray(pageSnapshot.controls) ? pageSnapshot.controls : [];
+
+  const combinedText = `${title}\n${bodyText}`;
+
+  for (const pattern of CAPTCHA_PATTERNS) {
+    if (pattern.test(combinedText) || pattern.test(html)) {
+      return {
+        gated: true,
+        gateType: "captcha",
+        status: "paused_for_user",
+        code: "BROWSER_PAUSED_FOR_CAPTCHA",
+        reason: "На странице обнаружена проверка CAPTCHA. Автоматический обход запрещён; ожидание ручного прохождения пользователем.",
+        url: pageSnapshot.url || null
+      };
+    }
+  }
+
+  const hasPasswordControl = controls.some(
+    (c) =>
+      String(c.type || "").toLowerCase() === "password" ||
+      String(c.name || "").toLowerCase().includes("password") ||
+      String(c.id || "").toLowerCase().includes("password")
+  );
+  const hasCaptchaControl = controls.some(
+    (c) =>
+      String(c.id || "").toLowerCase().includes("captcha") ||
+      String(c.name || "").toLowerCase().includes("captcha") ||
+      String(c.role || "").toLowerCase() === "captcha"
+  );
+
+  if (hasCaptchaControl) {
+    return {
+      gated: true,
+      gateType: "captcha",
+      status: "paused_for_user",
+      code: "BROWSER_PAUSED_FOR_CAPTCHA",
+      reason: "Обнаружен интерактивный элемент CAPTCHA. Требуется действие пользователя.",
+      url: pageSnapshot.url || null
+    };
+  }
+
+  const matchesLoginPrompt = LOGIN_WALL_PATTERNS.some((p) => p.test(combinedText));
+  if (hasPasswordControl || (status === 401 && matchesLoginPrompt) || (matchesLoginPrompt && pageSnapshot.requiresLogin === true)) {
+    return {
+      gated: true,
+      gateType: "login_required",
+      status: "paused_for_user",
+      code: "BROWSER_PAUSED_FOR_LOGIN",
+      reason: "Страница требует входа в учётную запись (логин/пароль или 2FA). Агент поставлен на паузу для ручного ввода пользователем.",
+      url: pageSnapshot.url || null
+    };
+  }
+
+  if (status === 401 || status === 403) {
+    return {
+      gated: true,
+      gateType: "access_restricted",
+      status: "paused_for_user",
+      code: "BROWSER_ACCESS_RESTRICTED",
+      reason: `Доступ к ресурсу ограничен сервером (HTTP ${status}). Обход ограничений доступа запрещён.`,
+      httpStatus: status,
+      url: pageSnapshot.url || null
+    };
+  }
+
+  return {
+    gated: false,
+    gateType: null,
+    status: "ok",
+    code: null,
+    reason: null
+  };
+}
+
+/**
+ * Verifies whether a local file may be attached to a browser `<input type="file">` control.
+ * Never widens file permissions outside `allowedWorkspaceRoot` and blocks sensitive or executable files.
+ */
+function verifyFileSelectionPolicy(candidateFilePath, options = {}) {
+  const allowedWorkspaceRoot = options.allowedWorkspaceRoot
+    ? path.resolve(String(options.allowedWorkspaceRoot))
+    : null;
+  const maxUploadBytes = Number(options.maxUploadBytes ?? 10 * 1024 * 1024);
+
+  if (!allowedWorkspaceRoot) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_WORKSPACE_NOT_CONNECTED",
+      "Выбор файлов для загрузки невозможен: не подключена разрешённая рабочая папка Koswork."
+    );
+  }
+
+  const rawPath = String(candidateFilePath || "").trim();
+  if (!rawPath) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      "Не указан путь к прикрепляемому файлу."
+    );
+  }
+
+  if (rawPath.includes("\0") || rawPath.startsWith("\\\\")) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      "Сетевые пути UNC и нулевые байты в имени вложения запрещены.",
+      { candidateFilePath: rawPath }
+    );
+  }
+
+  const resolvedCandidate = path.isAbsolute(rawPath)
+    ? path.resolve(rawPath)
+    : path.resolve(allowedWorkspaceRoot, rawPath);
+
+  let canonicalRoot;
+  try {
+    canonicalRoot = fs.realpathSync(allowedWorkspaceRoot);
+  } catch {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_WORKSPACE_NOT_CONNECTED",
+      "Разрешённая рабочая папка недоступна на диске."
+    );
+  }
+
+  const relativeCheck = path.relative(canonicalRoot, resolvedCandidate);
+  if (
+    relativeCheck === "" ||
+    relativeCheck.startsWith("..") ||
+    path.isAbsolute(relativeCheck)
+  ) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Запрещено прикреплять файлы за пределами разрешённой рабочей папки: "${rawPath}".`,
+      { candidateFilePath: rawPath, allowedWorkspaceRoot: canonicalRoot }
+    );
+  }
+
+  const baseName = path.basename(resolvedCandidate);
+  if (baseName.includes(":")) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Обнаружен альтернативный поток NTFS (ADS) в имени файла "${baseName}".`,
+      { filename: baseName }
+    );
+  }
+
+  for (const pattern of SENSITIVE_FILENAME_PATTERNS) {
+    if (pattern.test(baseName)) {
+      throw new KosworkBrowserPolicyError(
+        "BROWSER_FORBIDDEN_ATTACHMENT",
+        `Файл "${baseName}" относится к защищённым учётным данным или конфигурации (.env/ключи/токены) и не может быть отправлен на внешний сайт.`,
+        { filename: baseName, reason: "sensitive_filename" }
+      );
+    }
+  }
+
+  const ext = path.extname(baseName).toLowerCase();
+  if (FORBIDDEN_ATTACHMENT_EXTENSIONS.has(ext)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Расширение "${ext}" файла "${baseName}" запрещено для загрузки в браузер.`,
+      { filename: baseName, extension: ext, reason: "forbidden_extension" }
+    );
+  }
+
+  let lstat;
+  try {
+    lstat = fs.lstatSync(resolvedCandidate);
+  } catch {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_ATTACHMENT_NOT_FOUND",
+      `Файл вложения не найден: "${baseName}".`,
+      { candidateFilePath: rawPath }
+    );
+  }
+
+  if (lstat.isSymbolicLink() || !lstat.isFile()) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Символические ссылки и директории ("${baseName}") не могут быть прикреплены в форму.`,
+      { filename: baseName, reason: "symlink_or_directory" }
+    );
+  }
+
+  const canonicalFile = fs.realpathSync(resolvedCandidate);
+  const canonicalRel = path.relative(canonicalRoot, canonicalFile);
+  if (canonicalRel.startsWith("..") || path.isAbsolute(canonicalRel)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_ATTACHMENT",
+      `Канонический путь файла "${baseName}" выходит за пределы разрешённой рабочей папки.`,
+      { filename: baseName }
+    );
+  }
+
+  if (lstat.size > maxUploadBytes) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_ATTACHMENT_TOO_LARGE",
+      `Размер файла "${baseName}" (${lstat.size} байт) превышает лимит загрузки (${maxUploadBytes} байт).`,
+      { filename: baseName, sizeBytes: lstat.size, maxUploadBytes }
+    );
+  }
+
+  const buffer = fs.readFileSync(canonicalFile);
+  const sha256 = crypto.createHash("sha256").update(buffer).digest("hex");
+
+  return {
+    allowed: true,
+    filename: baseName,
+    canonicalPath: canonicalFile,
+    relativePath: canonicalRel.replace(/\\/g, "/"),
+    sizeBytes: buffer.length,
+    sha256
+  };
+}
+
+/**
+ * Validates and resolves a safe download target strictly inside the allowed workspace download folder.
+ */
+function resolveAllowedDownloadTarget(rawFilename, options = {}) {
+  const allowedDownloadDir = options.allowedDownloadDir
+    ? path.resolve(String(options.allowedDownloadDir))
+    : null;
+  const allowedWorkspaceRoot = options.allowedWorkspaceRoot
+    ? path.resolve(String(options.allowedWorkspaceRoot))
+    : null;
+
+  if (!allowedDownloadDir) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_DOWNLOAD_DIR_NOT_CONFIGURED",
+      "Не задана разрешённая папка для скачивания файлов."
+    );
+  }
+
+  if (allowedWorkspaceRoot) {
+    const relDir = path.relative(allowedWorkspaceRoot, allowedDownloadDir);
+    if (relDir.startsWith("..") || path.isAbsolute(relDir)) {
+      throw new KosworkBrowserPolicyError(
+        "BROWSER_DOWNLOAD_DIR_OUTSIDE_WORKSPACE",
+        "Папка загрузок должна находиться внутри подключённой рабочей папки Koswork.",
+        { allowedDownloadDir, allowedWorkspaceRoot }
+      );
+    }
+  }
+
+  const base = path.basename(String(rawFilename || "download.txt").trim());
+  const sanitized = base.replace(/[<>:"/\\|?*\x00-\x1F]/g, "_").replace(/^\.+/, "") || "download.txt";
+  const ext = path.extname(sanitized).toLowerCase();
+
+  if (FORBIDDEN_DOWNLOAD_EXTENSIONS.has(ext)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_FORBIDDEN_DOWNLOAD_TYPE",
+      `Скачивание исполняемого файла "${sanitized}" (${ext}) заблокировано политикой безопасности.`,
+      { filename: sanitized, extension: ext }
+    );
+  }
+
+  fs.mkdirSync(allowedDownloadDir, { recursive: true });
+  const targetPath = path.join(allowedDownloadDir, sanitized);
+  const verifyRel = path.relative(allowedDownloadDir, targetPath);
+  if (verifyRel.startsWith("..") || path.isAbsolute(verifyRel)) {
+    throw new KosworkBrowserPolicyError(
+      "BROWSER_DOWNLOAD_PATH_TRAVERSAL",
+      "Обнаружена попытка выхода за пределы разрешённой папки скачивания."
+    );
+  }
+
+  return {
+    allowed: true,
+    filename: sanitized,
+    downloadDir: allowedDownloadDir,
+    targetPath
+  };
+}
+
+module.exports = {
+  FORBIDDEN_ATTACHMENT_EXTENSIONS,
+  FORBIDDEN_DOWNLOAD_EXTENSIONS,
+  KosworkBrowserPolicyError,
+  detectAuthOrCaptchaGate,
+  evaluateNavigationPolicy,
+  resolveAllowedDownloadTarget,
+  verifyFileSelectionPolicy
+};
diff --git a/desktop/windows/browser/recovery.cjs b/desktop/windows/browser/recovery.cjs
new file mode 100644
index 0000000..d9926aa
--- /dev/null
+++ b/desktop/windows/browser/recovery.cjs
@@ -0,0 +1,444 @@
+"use strict";
+
+/**
+ * Koswork Browser Observation Integrity, Recovery Candidates & Manual Takeover Guard
+ * (`desktop/windows/browser/recovery.cjs`).
+ *
+ * Guarantees:
+ * 1. Detects tab closure/loss (`TAB_LOST_OR_CLOSED`) and unexpected URL transitions (`TAB_URL_CHANGED`).
+ * 2. Detects post-observation text substitution (`OBSERVATION_TEXT_SUBSTITUTED`): if page content
+ *    under an observed UTF-16 span or interactive element changed between observation and execution,
+ *    refuses to act on the substituted text and returns a structured conflict diagnostic.
+ * 3. Computes ranked recovery candidates (`findRecoveryCandidates`) when harmless layout shifts move
+ *    an element while preserving its semantic identity.
+ * 4. Tracks manual user actions (`UserTakeoverTracker`) so any manual user interaction immediately
+ *    invalidates prior agent observations (`OBSERVATION_INVALIDATED_BY_USER`).
+ */
+
+class KosworkBrowserRecoveryError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.name = "KosworkBrowserRecoveryError";
+    this.code = code;
+    this.details = details;
+  }
+}
+
+function tokenizeNormalized(text) {
+  return String(text || "")
+    .toLowerCase()
+    .replace(/[^\p{L}\p{N}\s]+/gu, " ")
+    .split(/\s+/)
+    .filter(Boolean);
+}
+
+function computeJaccardTokenSimilarity(a, b) {
+  const tokensA = new Set(tokenizeNormalized(a));
+  const tokensB = new Set(tokenizeNormalized(b));
+  if (tokensA.size === 0 && tokensB.size === 0) return 1;
+  if (tokensA.size === 0 || tokensB.size === 0) return 0;
+
+  let intersection = 0;
+  for (const t of tokensA) {
+    if (tokensB.has(t)) intersection += 1;
+  }
+  const union = tokensA.size + tokensB.size - intersection;
+  return union === 0 ? 0 : intersection / union;
+}
+
+/**
+ * Verifies that a tab receipt is still backed by a live tab and has not been lost or navigated away.
+ */
+function verifyTabReceipt(tabReceipt, liveTabState) {
+  if (!tabReceipt || !tabReceipt.tabId) {
+    throw new KosworkBrowserRecoveryError(
+      "INVALID_TAB_RECEIPT",
+      "Отсутствует корректная квитанция вкладки (tabReceipt)."
+    );
+  }
+
+  if (!liveTabState || liveTabState.closed === true) {
+    throw new KosworkBrowserRecoveryError(
+      "TAB_LOST_OR_CLOSED",
+      `Вкладка "${tabReceipt.tabId}" была закрыта или потеряна во время выполнения операции.`,
+      {
+        tabId: tabReceipt.tabId,
+        expectedReceiptId: tabReceipt.receiptId,
+        expectedUrl: tabReceipt.url
+      }
+    );
+  }
+
+  if (liveTabState.url && tabReceipt.url && liveTabState.url !== tabReceipt.url) {
+    throw new KosworkBrowserRecoveryError(
+      "TAB_URL_CHANGED",
+      `URL вкладки "${tabReceipt.tabId}" изменился с "${tabReceipt.url}" на "${liveTabState.url}". Старое наблюдение больше недействительно.`,
+      {
+        tabId: tabReceipt.tabId,
+        expectedUrl: tabReceipt.url,
+        actualUrl: liveTabState.url
+      }
+    );
+  }
+
+  return {
+    valid: true,
+    tabId: tabReceipt.tabId,
+    receiptId: tabReceipt.receiptId,
+    versionAdvanced:
+      liveTabState.snapshot &&
+      Number(liveTabState.snapshot.pageVersion) !== Number(tabReceipt.pageVersion)
+  };
+}
+
+/**
+ * Ranks recovery candidates across blocks or controls when a page version advances due to dynamic layout changes.
+ */
+function findRecoveryCandidates(targetSpec = {}, currentSnapshot = {}) {
+  const kind = targetSpec.kind === "block" ? "block" : "control";
+  const pool =
+    kind === "block"
+      ? Array.isArray(currentSnapshot.blocks)
+        ? currentSnapshot.blocks
+        : []
+      : Array.isArray(currentSnapshot.controls)
+        ? currentSnapshot.controls
+        : [];
+
+  const candidates = [];
+
+  for (const item of pool) {
+    let score = 0;
+    const reasons = [];
+
+    const itemId = item.id || item.blockId || null;
+    if (targetSpec.id && itemId === targetSpec.id) {
+      score += 0.45;
+      reasons.push("exact_id");
+    }
+    if (targetSpec.name && item.name && item.name === targetSpec.name) {
+      score += 0.25;
+      reasons.push("exact_name");
+    }
+    if (
+      targetSpec.deepSelector &&
+      item.deepSelector &&
+      item.deepSelector === targetSpec.deepSelector
+    ) {
+      score += 0.25;
+      reasons.push("exact_deep_selector");
+    }
+    if (targetSpec.role && item.role && item.role === targetSpec.role) {
+      score += 0.1;
+      reasons.push("matching_role");
+    }
+
+    const expectedText = String(targetSpec.expectedText || targetSpec.label || "").trim();
+    const actualText = String(item.text || item.label || "").trim();
+    let textSimilarity = 1;
+    if (expectedText) {
+      textSimilarity = computeJaccardTokenSimilarity(expectedText, actualText);
+      score += textSimilarity * 0.35;
+      if (actualText === expectedText) {
+        reasons.push("exact_text");
+      } else if (textSimilarity >= 0.7) {
+        reasons.push("high_text_similarity");
+      }
+    }
+
+    if (score > 0.2) {
+      candidates.push({
+        candidateId: itemId,
+        deepSelector: item.deepSelector || item.recoveryAnchors?.deepSelector || null,
+        role: item.role || null,
+        actualText,
+        textSimilarity: Number(textSimilarity.toFixed(3)),
+        confidence: Number(Math.min(1, score).toFixed(3)),
+        reasons,
+        bounds: item.bounds || null,
+        startUtf16: item.startUtf16 ?? null,
+        endUtf16: item.endUtf16 ?? null
+      });
+    }
+  }
+
+  candidates.sort((a, b) => b.confidence - a.confidence);
+  return candidates.slice(0, 5);
+}
+
+/**
+ * Verifies that an observation captured at `observedSnapshot` is still safe to use on `currentSnapshot`.
+ * Specifically detects:
+ * 1. Manual user action since observation (`OBSERVATION_INVALIDATED_BY_USER`)
+ * 2. Post-observation text substitution (`OBSERVATION_TEXT_SUBSTITUTED`) at target UTF-16 offsets,
+ *    block IDs, or control labels.
+ */
+function verifyObservationIntegrity({
+  observedSnapshot,
+  currentSnapshot,
+  targetSpec = {},
+  userTakeoverTracker = null
+} = {}) {
+  if (!observedSnapshot || !currentSnapshot) {
+    throw new KosworkBrowserRecoveryError(
+      "MISSING_OBSERVATION_SNAPSHOT",
+      "Невозможно выполнить действие без актуального наблюдения страницы."
+    );
+  }
+
+  if (userTakeoverTracker) {
+    userTakeoverTracker.assertObservationValid(observedSnapshot.tabId, observedSnapshot.userEpoch);
+  }
+
+  if (observedSnapshot.url !== currentSnapshot.url) {
+    throw new KosworkBrowserRecoveryError(
+      "TAB_URL_CHANGED",
+      `URL страницы изменился после наблюдения ("${observedSnapshot.url}" -> "${currentSnapshot.url}").`,
+      {
+        observedUrl: observedSnapshot.url,
+        currentUrl: currentSnapshot.url
+      }
+    );
+  }
+
+  // 1. Check UTF-16 span integrity if the target specifies `startUtf16` / `endUtf16` or `expectedQuote`
+  if (
+    Number.isInteger(targetSpec.startUtf16) &&
+    Number.isInteger(targetSpec.endUtf16) &&
+    targetSpec.endUtf16 > targetSpec.startUtf16
+  ) {
+    const fullCurrent = String(currentSnapshot.fullTextUtf16 || "");
+    const observedSpanText = String(observedSnapshot.fullTextUtf16 || "").slice(
+      targetSpec.startUtf16,
+      targetSpec.endUtf16
+    );
+    const currentSpanText = fullCurrent.slice(
+      targetSpec.startUtf16,
+      targetSpec.endUtf16
+    );
+    const expectedQuote =
+      typeof targetSpec.expectedQuote === "string" ? targetSpec.expectedQuote : observedSpanText;
+
+    if (currentSpanText !== expectedQuote) {
+      // Check if the exact quote merely shifted offsets due to a harmless header/banner insertion
+      const shiftedIdx = fullCurrent.indexOf(expectedQuote);
+      if (shiftedIdx === -1) {
+        const containingBlock = (currentSnapshot.blocks || []).find(
+          (b) => targetSpec.startUtf16 >= b.startUtf16 && targetSpec.startUtf16 < b.endUtf16
+        );
+        const nextNewlineIdx = fullCurrent.indexOf("\n", targetSpec.startUtf16);
+        const expandedEnd =
+          containingBlock
+            ? containingBlock.endUtf16
+            : nextNewlineIdx !== -1
+              ? Math.max(targetSpec.endUtf16, nextNewlineIdx)
+              : Math.min(fullCurrent.length, targetSpec.endUtf16 + 120);
+        const actualExpandedText = fullCurrent.slice(targetSpec.startUtf16, expandedEnd);
+
+        const recoveryCandidates = findRecoveryCandidates(
+          {
+            kind: "block",
+            id: targetSpec.blockId,
+            expectedText: expectedQuote
+          },
+          currentSnapshot
+        );
+        throw new KosworkBrowserRecoveryError(
+          "OBSERVATION_TEXT_SUBSTITUTED",
+          `Обнаружена подмена текста после наблюдения на вкладке "${currentSnapshot.tabId}" (v${observedSnapshot.pageVersion} -> v${currentSnapshot.pageVersion}).`,
+          {
+            tabId: currentSnapshot.tabId,
+            observedPageVersion: observedSnapshot.pageVersion,
+            currentPageVersion: currentSnapshot.pageVersion,
+            startUtf16: targetSpec.startUtf16,
+            endUtf16: targetSpec.endUtf16,
+            expectedText: expectedQuote,
+            actualTextAtOffsets: actualExpandedText,
+            recoveryCandidates
+          }
+        );
+      }
+
+      return {
+        valid: true,
+        recoveredShift: true,
+        newStartUtf16: shiftedIdx,
+        newEndUtf16: shiftedIdx + expectedQuote.length,
+        pageVersion: currentSnapshot.pageVersion
+      };
+    }
+  }
+
+  // 2. Check interactive control label/text substitution if targeting a control
+  if (targetSpec.controlId || targetSpec.deepSelector) {
+    const obsCtrl = (observedSnapshot.controls || []).find(
+      (c) =>
+        (targetSpec.controlId && c.id === targetSpec.controlId) ||
+        (targetSpec.deepSelector && c.deepSelector === targetSpec.deepSelector)
+    );
+    const curCtrl = (currentSnapshot.controls || []).find(
+      (c) =>
+        (targetSpec.controlId && c.id === targetSpec.controlId) ||
+        (targetSpec.deepSelector && c.deepSelector === targetSpec.deepSelector)
+    );
+
+    if (obsCtrl && !curCtrl) {
+      const recoveryCandidates = findRecoveryCandidates(
+        {
+          kind: "control",
+          id: obsCtrl.id,
+          name: obsCtrl.name,
+          role: obsCtrl.role,
+          label: obsCtrl.label,
+          deepSelector: obsCtrl.deepSelector
+        },
+        currentSnapshot
+      );
+      throw new KosworkBrowserRecoveryError(
+        "TARGET_CONTROL_MISSING_AFTER_MUTATION",
+        `Целевой элемент "${obsCtrl.id}" исчез после динамического обновления страницы.`,
+        {
+          controlId: obsCtrl.id,
+          observedPageVersion: observedSnapshot.pageVersion,
+          currentPageVersion: currentSnapshot.pageVersion,
+          recoveryCandidates
+        }
+      );
+    }
+
+    if (obsCtrl && curCtrl) {
+      const expectedLabel = String(targetSpec.expectedLabel || obsCtrl.label || "").trim();
+      const currentLabel = String(curCtrl.label || "").trim();
+      if (expectedLabel && currentLabel && expectedLabel !== currentLabel) {
+        const similarity = computeJaccardTokenSimilarity(expectedLabel, currentLabel);
+        if (similarity < 0.65) {
+          throw new KosworkBrowserRecoveryError(
+            "OBSERVATION_TEXT_SUBSTITUTED",
+            `Текст интерактивного элемента "${curCtrl.id}" был подменён после наблюдения ("${expectedLabel}" -> "${currentLabel}"). Ввод/нажатие заблокировано.`,
+            {
+              controlId: curCtrl.id,
+              observedLabel: expectedLabel,
+              currentLabel,
+              similarity: Number(similarity.toFixed(3)),
+              observedPageVersion: observedSnapshot.pageVersion,
+              currentPageVersion: currentSnapshot.pageVersion
+            }
+          );
+        }
+      }
+    }
+  }
+
+  return {
+    valid: true,
+    recoveredShift: false,
+    pageVersion: currentSnapshot.pageVersion
+  };
+}
+
+/**
+ * Tracks manual user interactions and takeover state per tab.
+ * Any manual action by the user invalidates observations taken prior to that action.
+ */
+class UserTakeoverTracker {
+  constructor() {
+    this.tabStates = new Map();
+  }
+
+  ensureTab(tabId) {
+    const key = String(tabId || "tab-1");
+    if (!this.tabStates.has(key)) {
+      this.tabStates.set(key, {
+        tabId: key,
+        userEpoch: 0,
+        manualTakeoverActive: false,
+        lastUserAction: null,
+        lastUserActionAt: null,
+        history: []
+      });
+    }
+    return this.tabStates.get(key);
+  }
+
+  getCurrentEpoch(tabId) {
+    return this.ensureTab(tabId).userEpoch;
+  }
+
+  recordUserAction(tabId, action = {}) {
+    const state = this.ensureTab(tabId);
+    state.userEpoch += 1;
+    if (action.takeover !== undefined) {
+      state.manualTakeoverActive = Boolean(action.takeover);
+    }
+    const entry = {
+      epoch: state.userEpoch,
+      type: String(action.type || "user_manual_action"),
+      detail: action.detail || null,
+      recordedAt: action.recordedAt || new Date().toISOString()
+    };
+    state.lastUserAction = entry.type;
+    state.lastUserActionAt = entry.recordedAt;
+    state.history.push(entry);
+    return {
+      tabId: state.tabId,
+      userEpoch: state.userEpoch,
+      manualTakeoverActive: state.manualTakeoverActive,
+      previousObservationsInvalidated: true,
+      lastUserAction: entry
+    };
+  }
+
+  releaseTakeover(tabId) {
+    const state = this.ensureTab(tabId);
+    state.manualTakeoverActive = false;
+    return {
+      tabId: state.tabId,
+      userEpoch: state.userEpoch,
+      manualTakeoverActive: false
+    };
+  }
+
+  assertObservationValid(tabId, observedUserEpoch) {
+    const state = this.ensureTab(tabId);
+    if (state.manualTakeoverActive) {
+      throw new KosworkBrowserRecoveryError(
+        "USER_TAKEOVER_ACTIVE",
+        `Пользователь перехватил управление вкладкой "${state.tabId}". Автоматические действия приостановлены до возврата управления.`,
+        {
+          tabId: state.tabId,
+          userEpoch: state.userEpoch,
+          lastUserAction: state.lastUserAction
+        }
+      );
+    }
+
+    if (
+      observedUserEpoch !== undefined &&
+      observedUserEpoch !== null &&
+      Number(observedUserEpoch) !== state.userEpoch
+    ) {
+      throw new KosworkBrowserRecoveryError(
+        "OBSERVATION_INVALIDATED_BY_USER",
+        `Ручное действие пользователя (${state.lastUserAction || "user_input"}) на вкладке "${state.tabId}" сделало старое наблюдение (epoch ${observedUserEpoch}) непригодным для дальнейшего ввода (текущий epoch ${state.userEpoch}). Требуется повторное наблюдение страницы.`,
+        {
+          tabId: state.tabId,
+          observedUserEpoch: Number(observedUserEpoch),
+          currentUserEpoch: state.userEpoch,
+          lastUserAction: state.lastUserAction,
+          lastUserActionAt: state.lastUserActionAt
+        }
+      );
+    }
+
+    return true;
+  }
+}
+
+module.exports = {
+  KosworkBrowserRecoveryError,
+  UserTakeoverTracker,
+  computeJaccardTokenSimilarity,
+  findRecoveryCandidates,
+  verifyObservationIntegrity,
+  verifyTabReceipt
+};
diff --git a/desktop/windows/browser/research-adapter.cjs b/desktop/windows/browser/research-adapter.cjs
new file mode 100644
index 0000000..b55893b
--- /dev/null
+++ b/desktop/windows/browser/research-adapter.cjs
@@ -0,0 +1,252 @@
+"use strict";
+
+const http = require("node:http");
+const https = require("node:https");
+const { stripHtmlTagsPreservingBlocks } = require("./document.cjs");
+
+/**
+ * Isolated Search / HTTP Provider Adapter (`desktop/windows/browser/research-adapter.cjs`).
+ *
+ * Rules:
+ * - Never masks the origin of search results behind a fabricated "proprietary internet index".
+ * - Explicitly records `providerId` (`"duckduckgo-html"`, `"local-http-search"`, `"synthetic-corpus-index"`)
+ *   and `providerEndpoint` on every search response.
+ * - Supports both live HTTP/HTTPS search endpoints and deterministic synthetic/local HTTP corpora.
+ */
+
+function parseDuckDuckGoHtmlSerp(html, baseOrigin = "https://html.duckduckgo.com") {
+  const raw = String(html || "");
+  const results = [];
+  const blockRegex = /<div[^>]+class=["'][^"']*result\b[^"']*["'][^>]*>([\s\S]*?)<\/div>\s*<\/div>/gi;
+  const linkRegex = /<a[^>]+class=["'][^"']*result__a[^"']*["'][^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/i;
+  const snippetRegex = /<(?:a|div)[^>]+class=["'][^"']*result__snippet[^"']*["'][^>]*>([\s\S]*?)<\/(?:a|div)>/i;
+
+  let match;
+  while ((match = blockRegex.exec(raw)) !== null) {
+    const chunk = match[1];
+    const linkMatch = chunk.match(linkRegex);
+    if (!linkMatch) continue;
+    let href = linkMatch[1];
+    try {
+      const parsedHref = new URL(href, baseOrigin);
+      const uddg = parsedHref.searchParams.get("uddg");
+      if (uddg) href = uddg;
+      else href = parsedHref.toString();
+    } catch {
+      /* keep raw href */
+    }
+    const title = stripHtmlTagsPreservingBlocks(linkMatch[2]);
+    const snippetMatch = chunk.match(snippetRegex);
+    const snippet = snippetMatch ? stripHtmlTagsPreservingBlocks(snippetMatch[1]) : "";
+    if (href && title) {
+      results.push({
+        title,
+        url: href,
+        snippet
+      });
+    }
+  }
+
+  // Fallback generic `<a data-search-result="true" href="...">` parser for local HTTP SERP fixtures
+  if (results.length === 0) {
+    const genericRegex = /<article[^>]+data-serp-item=["']true["'][^>]*>([\s\S]*?)<\/article>/gi;
+    let gMatch;
+    while ((gMatch = genericRegex.exec(raw)) !== null) {
+      const itemHtml = gMatch[1];
+      const aMatch = itemHtml.match(/<a[^>]+href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/i);
+      const pMatch = itemHtml.match(/<p[^>]*>([\s\S]*?)<\/p>/i);
+      if (aMatch) {
+        results.push({
+          url: aMatch[1],
+          title: stripHtmlTagsPreservingBlocks(aMatch[2]),
+          snippet: pMatch ? stripHtmlTagsPreservingBlocks(pMatch[1]) : ""
+        });
+      }
+    }
+  }
+
+  return results;
+}
+
+function fetchHttpRaw(targetUrl, options = {}) {
+  const timeoutMs = Number(options.timeoutMs ?? 6000);
+  const signal = options.signal || null;
+
+  return new Promise((resolve, reject) => {
+    if (signal?.aborted) {
+      const err = new Error("SEARCH_REQUEST_CANCELLED");
+      err.code = "SEARCH_REQUEST_CANCELLED";
+      return reject(err);
+    }
+
+    let parsed;
+    try {
+      parsed = new URL(targetUrl);
+    } catch (e) {
+      return reject(e);
+    }
+
+    const client = parsed.protocol === "https:" ? https : http;
+    const req = client.request(
+      parsed,
+      {
+        method: "GET",
+        headers: {
+          "User-Agent": "KosworkBrowserResearch/1.0",
+          Accept: "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8"
+        },
+        timeout: timeoutMs
+      },
+      (res) => {
+        const chunks = [];
+        res.on("data", (chunk) => chunks.push(chunk));
+        res.on("end", () => {
+          const body = Buffer.concat(chunks).toString("utf8");
+          resolve({
+            status: res.statusCode || 200,
+            headers: res.headers || {},
+            url: targetUrl,
+            body
+          });
+        });
+      }
+    );
+
+    const onAbort = () => {
+      req.destroy();
+      const err = new Error("SEARCH_REQUEST_CANCELLED");
+      err.code = "SEARCH_REQUEST_CANCELLED";
+      reject(err);
+    };
+
+    if (signal) {
+      signal.addEventListener("abort", onAbort, { once: true });
+    }
+
+    req.on("timeout", () => {
+      req.destroy();
+      const err = new Error(`HTTP_TIMEOUT: Request to ${targetUrl} timed out after ${timeoutMs}ms`);
+      err.code = "HTTP_TIMEOUT";
+      reject(err);
+    });
+
+    req.on("error", (err) => {
+      if (signal) signal.removeEventListener("abort", onAbort);
+      reject(err);
+    });
+
+    req.end();
+  });
+}
+
+function createSearchProviderAdapter(options = {}) {
+  const providerId = String(options.providerId || "duckduckgo-html");
+  const searchEndpoint = String(options.searchEndpoint || "https://html.duckduckgo.com/html/");
+  const customSearchFn = typeof options.searchFn === "function" ? options.searchFn : null;
+  const syntheticCatalog = Array.isArray(options.syntheticCatalog) ? options.syntheticCatalog : null;
+
+  async function executeQuery(query, execOptions = {}) {
+    const signal = execOptions.signal || null;
+    if (signal?.aborted) {
+      const err = new Error("SEARCH_REQUEST_CANCELLED");
+      err.code = "SEARCH_REQUEST_CANCELLED";
+      throw err;
+    }
+
+    const trimmedQuery = String(query || "").trim();
+    if (!trimmedQuery) {
+      const err = new Error("INVALID_SEARCH_QUERY_LENGTH");
+      err.code = "INVALID_SEARCH_QUERY_LENGTH";
+      throw err;
+    }
+
+    const searchedAt = execOptions.nowIso || new Date().toISOString();
+
+    if (customSearchFn) {
+      const rawResults = await customSearchFn(trimmedQuery, { signal, searchedAt });
+      return {
+        providerId,
+        providerEndpoint: searchEndpoint,
+        searchedAt,
+        query: trimmedQuery,
+        results: Array.isArray(rawResults) ? rawResults : []
+      };
+    }
+
+    if (syntheticCatalog) {
+      const queryTokens = trimmedQuery
+        .toLowerCase()
+        .replace(/[^\p{L}\p{N}\s]+/gu, " ")
+        .split(/\s+/)
+        .filter((t) => t.length >= 2);
+
+      const scored = syntheticCatalog
+        .map((entry) => {
+          const haystack = `${entry.title || ""} ${entry.snippet || ""} ${(entry.keywords || []).join(" ")}`.toLowerCase();
+          let hits = 0;
+          for (const tok of queryTokens) {
+            if (haystack.includes(tok)) hits += 1;
+          }
+          return {
+            entry,
+            hits: queryTokens.length === 0 ? 1 : hits
+          };
+        })
+        .filter((item) => item.hits > 0 || syntheticCatalog.length <= 6)
+        .sort((a, b) => b.hits - a.hits);
+
+      return {
+        providerId: options.providerId || "synthetic-corpus-adapter",
+        providerEndpoint: "local://synthetic-corpus",
+        searchedAt,
+        query: trimmedQuery,
+        results: scored.map((s) => ({
+          title: s.entry.title,
+          url: s.entry.url,
+          snippet: s.entry.snippet || ""
+        }))
+      };
+    }
+
+    const urlObj = new URL(searchEndpoint);
+    urlObj.searchParams.set("q", trimmedQuery);
+    const httpRes = await fetchHttpRaw(urlObj.toString(), {
+      timeoutMs: execOptions.timeoutMs ?? 6000,
+      signal
+    });
+
+    let parsedResults = [];
+    const contentType = String(httpRes.headers["content-type"] || "").toLowerCase();
+    if (contentType.includes("application/json")) {
+      const json = JSON.parse(httpRes.body);
+      parsedResults = Array.isArray(json.results) ? json.results : [];
+    } else {
+      parsedResults = parseDuckDuckGoHtmlHtmlOrSerp(httpRes.body, urlObj.origin);
+    }
+
+    return {
+      providerId,
+      providerEndpoint: urlObj.origin + urlObj.pathname,
+      searchedAt,
+      query: trimmedQuery,
+      results: parsedResults
+    };
+  }
+
+  return {
+    providerId,
+    searchEndpoint,
+    executeQuery,
+    fetchHttpRaw
+  };
+}
+
+function parseDuckDuckGoHtmlHtmlOrSerp(body, origin) {
+  return parseDuckDuckGoHtmlSerp(body, origin);
+}
+
+module.exports = {
+  createSearchProviderAdapter,
+  fetchHttpRaw,
+  parseDuckDuckGoHtmlSerp
+};
diff --git a/desktop/windows/browser/research-report-builder.cjs b/desktop/windows/browser/research-report-builder.cjs
new file mode 100644
index 0000000..ee8ff3e
--- /dev/null
+++ b/desktop/windows/browser/research-report-builder.cjs
@@ -0,0 +1,440 @@
+"use strict";
+
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork Verifiable Browser Research Report Builder (`desktop/windows/browser/research-report-builder.cjs`).
+ *
+ * Saves Markdown (`.md`), HTML (`.html`), and structured comparison table (`.json`) artifacts
+ * through the existing `createKosworkWorkspaceService` (`desktop/windows/workspace/workspace-service.cjs`).
+ *
+ * Strict Epistemic Invariants:
+ * 1. Every confirmed claim MUST map `claim -> excerpt (verbatim quote + UTF-16 offsets) -> source (url, title, pageDate, eventDate, fetchedAt)`.
+ * 2. A bare URL link without a matching verbatim quote from an available page is NEVER treated as proof of a claim;
+ *    such items are explicitly placed in "Что неизвестно / не подтверждено выдержкой".
+ * 3. Explicitly surfaces conflicting/contradictory figures across sources, outdated sources (comparing `pageDate` / `eventDate`),
+ *    unavailable sources (HTTP 404/503 or network error), and post-observation text substitution incidents.
+ */
+
+function escapeHtml(text) {
+  return String(text ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+function validateAndClassifyClaims(rawClaims = [], sourcesByUrl = new Map()) {
+  const confirmedClaims = [];
+  const unconfirmedClaims = [];
+
+  for (const item of rawClaims) {
+    const claimText = String(item.claim || "").trim();
+    if (!claimText) continue;
+
+    const excerpt = item.excerpt || null;
+    const sourceUrl = excerpt?.url || item.sourceUrl || null;
+    const sourceRecord = sourceUrl ? sourcesByUrl.get(sourceUrl) : null;
+
+    const hasValidExcerpt =
+      excerpt &&
+      typeof excerpt.quote === "string" &&
+      excerpt.quote.trim().length > 0 &&
+      Number.isInteger(excerpt.startUtf16) &&
+      Number.isInteger(excerpt.endUtf16) &&
+      excerpt.endUtf16 > excerpt.startUtf16;
+
+    const sourceAvailable = sourceRecord ? sourceRecord.available !== false : Boolean(hasValidExcerpt);
+
+    // A bare link without a verified excerpt is NEVER accepted as proof of a claim
+    if (!hasValidExcerpt || !sourceAvailable) {
+      unconfirmedClaims.push({
+        claimId: item.claimId || `unconf-${unconfirmedClaims.length + 1}`,
+        claim: claimText,
+        criterion: item.criterion || null,
+        optionName: item.optionName || null,
+        candidateUrl: sourceUrl,
+        reason: !sourceAvailable
+          ? "Источник недоступен (HTTP 503/404 или сбой сети); голая ссылка не является доказательством."
+          : "Отсутствует подтверждающая выдержка (цитата с UTF-16 смещениями); сама по себе ссылка не доказывает утверждение."
+      });
+      continue;
+    }
+
+    confirmedClaims.push({
+      claimId: item.claimId || `claim-${confirmedClaims.length + 1}`,
+      claim: claimText,
+      optionName: item.optionName || null,
+      criterion: item.criterion || null,
+      value: item.value ?? null,
+      isOutdated: Boolean(item.isOutdated),
+      outdatedNote: item.outdatedNote || null,
+      excerpt: {
+        excerptId: excerpt.excerptId,
+        quote: excerpt.quote,
+        startUtf16: excerpt.startUtf16,
+        endUtf16: excerpt.endUtf16,
+        pageVersion: excerpt.pageVersion ?? 1
+      },
+      source: {
+        url: excerpt.url,
+        title: excerpt.title || sourceRecord?.title || excerpt.url,
+        pageDate: excerpt.pageDate || sourceRecord?.pageDate || null,
+        eventDate: excerpt.eventDate || sourceRecord?.eventDate || null,
+        fetchedAt: excerpt.fetchedAt || sourceRecord?.fetchedAt || null
+      }
+    });
+  }
+
+  return { confirmedClaims, unconfirmedClaims };
+}
+
+function renderResearchReportMarkdown(spec) {
+  const {
+    question,
+    generatedAt,
+    criteria = [],
+    comparisonRows = [],
+    confirmedClaims = [],
+    unconfirmedClaims = [],
+    contradictions = [],
+    outdatedFindings = [],
+    unavailableSources = [],
+    substitutionIncidents = [],
+    sources = [],
+    resourceMetrics = null
+  } = spec;
+
+  const lines = [];
+  lines.push(`# Исследовательский отчёт Koswork: ${question}`);
+  lines.push("");
+  lines.push(`- **Дата формирования отчёта:** ${generatedAt}`);
+  lines.push(`- **Проверено источников:** ${sources.length} (недоступных: ${unavailableSources.length})`);
+  lines.push(`- **Подтверждённых утверждений (с цитатой и UTF-16 смещениями):** ${confirmedClaims.length}`);
+  lines.push(`- **Неподтверждённых / неизвестных пунктов:** ${unconfirmedClaims.length}`);
+  lines.push(`- **Выявленных противоречий между источниками:** ${contradictions.length}`);
+  lines.push("");
+
+  // 1. Comparison Table
+  lines.push("## 1. Таблица сравнения вариантов по критериям");
+  lines.push("");
+  const headerCols = ["Вариант", ...criteria, "Статус проверки и источники"];
+  lines.push(`| ${headerCols.join(" | ")} |`);
+  lines.push(`| ${headerCols.map(() => "---").join(" | ")} |`);
+  for (const row of comparisonRows) {
+    const critCells = criteria.map((c) => {
+      const cell = row.values?.[c];
+      if (!cell) return "Неизвестно (нет выдержки)";
+      if (typeof cell === "object") {
+        const badge = cell.conflict ? "⚠️ ПРОТИВОРЕЧИЕ: " : cell.outdated ? "⏳ УСТАРЕЛО: " : "";
+        return `${badge}${cell.displayValue} ([${cell.sourceTitle || "Источник"}](${cell.sourceUrl}) [${cell.startUtf16}..${cell.endUtf16}])`;
+      }
+      return String(cell);
+    });
+    lines.push(`| **${row.optionName}** | ${critCells.join(" | ")} | ${row.verificationSummary || "Проверено"} |`);
+  }
+  lines.push("");
+
+  // 2. Confirmed Claims (Claim -> Excerpt -> Source)
+  lines.push("## 2. Что подтверждено (Утверждение → Выдержка → Источник)");
+  lines.push("");
+  if (confirmedClaims.length === 0) {
+    lines.push("_Нет подтверждённых выдержками утверждений._");
+  } else {
+    for (const c of confirmedClaims) {
+      const outdatedTag = c.isOutdated ? ` *(⚠️ Устаревшие данные: ${c.outdatedNote || "есть более свежий источник"})*` : "";
+      lines.push(`- **Утверждение [${c.claimId}]:** ${c.claim}${outdatedTag}`);
+      lines.push(`  - **Выдержка (UTF-16 \`${c.excerpt.startUtf16}..${c.excerpt.endUtf16}\`, v${c.excerpt.pageVersion}):** «${c.excerpt.quote}»`);
+      lines.push(
+        `  - **Источник:** [${c.source.title}](${c.source.url}) | Дата на странице: \`${c.source.pageDate || "не указана"}\` | Дата события: \`${c.source.eventDate || "не указана"}\` | Дата получения: \`${c.source.fetchedAt}\``
+      );
+    }
+  }
+  lines.push("");
+
+  // 3. Contradictions & Outdated Data
+  lines.push("## 3. Конфликтующие и устаревшие данные");
+  lines.push("");
+  if (contradictions.length === 0 && outdatedFindings.length === 0 && substitutionIncidents.length === 0) {
+    lines.push("_Конфликтующих или устаревших данных не обнаружено._");
+  } else {
+    for (const conflict of contradictions) {
+      lines.push(
+        `- **Противоречие по критерию «${conflict.criterion}» (${conflict.optionName || "общий параметр"}):** ${conflict.summary}`
+      );
+      lines.push(
+        `  - *Позиция А:* «${conflict.sideA.quote}» ([${conflict.sideA.title}](${conflict.sideA.url}), UTF-16 \`${conflict.sideA.startUtf16}..${conflict.sideA.endUtf16}\`, дата на странице: \`${conflict.sideA.pageDate || "н/д"}\`, дата события: \`${conflict.sideA.eventDate || "н/д"}\`)`
+      );
+      lines.push(
+        `  - *Позиция Б:* «${conflict.sideB.quote}» ([${conflict.sideB.title}](${conflict.sideB.url}), UTF-16 \`${conflict.sideB.startUtf16}..${conflict.sideB.endUtf16}\`, дата на странице: \`${conflict.sideB.pageDate || "н/д"}\`, дата события: \`${conflict.sideB.eventDate || "н/д"}\`)`
+      );
+    }
+    for (const out of outdatedFindings) {
+      lines.push(
+        `- **Устаревшие сведения (${out.optionName || "источник"}):** [${out.title}](${out.url}) содержит данные от \`${out.pageDate || out.eventDate}\`, которые перекрыты более свежим источником от \`${out.supersededByDate}\` (${out.note}).`
+      );
+    }
+    for (const sub of substitutionIncidents) {
+      lines.push(
+        `- **Подмена текста после наблюдения (блокировка действия):** На странице [${sub.url}](${sub.url}) между версиями \`v${sub.observedPageVersion}\` и \`v${sub.currentPageVersion}\` текст на смещении UTF-16 \`${sub.startUtf16}..${sub.endUtf16}\` был изменён с «${sub.expectedText}» на «${sub.actualTextAtOffsets}».`
+      );
+    }
+  }
+  lines.push("");
+
+  // 4. What is Unknown / Unconfirmed & Unavailable Sources
+  lines.push("## 4. Что неизвестно и недоступные источники");
+  lines.push("");
+  lines.push("> Примечание: ссылка сама по себе не является доказательством утверждения без подтверждающей выдержки из открытого документа.");
+  lines.push("");
+  for (const u of unconfirmedClaims) {
+    lines.push(
+      `- **Не подтверждено [${u.claimId}]:** ${u.claim} — *${u.reason}*${u.candidateUrl ? ` (кандидат: ${u.candidateUrl})` : ""}`
+    );
+  }
+  for (const unavail of unavailableSources) {
+    lines.push(
+      `- **Недоступный источник:** \`${unavail.url}\` — HTTP \`${unavail.httpStatus || "ERR"}\` (${unavail.reason || "страница недоступна"}), время попытки: \`${unavail.fetchedAt}\`.`
+    );
+  }
+  lines.push("");
+
+  // 5. Resource & Latency Telemetry
+  if (resourceMetrics) {
+    lines.push("## 5. Фактические метрики ресурсов (RAM и задержка)");
+    lines.push("");
+    lines.push(
+      `- **Лимит живых вкладок:** ${resourceMetrics.liveTabCount} / ${resourceMetrics.maxLiveTabs} (выгружено фоновых вкладок: ${resourceMetrics.hibernationEventsCount}, переиспользовано снимков: ${resourceMetrics.snapshotReuseCount})`
+    );
+    lines.push(
+      `- **Фактическая память процесса (RAM):** RSS \`${resourceMetrics.ramTelemetry.currentRssMb} МБ\` (пик \`${resourceMetrics.ramTelemetry.peakRssMb} МБ\`), Heap Used \`${resourceMetrics.ramTelemetry.currentHeapUsedMb} МБ\``
+    );
+    lines.push(
+      `- **Задержка операций (Latency):** медиана (p50) \`${resourceMetrics.latencyTelemetry.p50Ms} мс\`, p95 \`${resourceMetrics.latencyTelemetry.p95Ms} мс\`, макс \`${resourceMetrics.latencyTelemetry.maxMs} мс\``
+    );
+    lines.push("");
+  }
+
+  return lines.join("\n");
+}
+
+function renderResearchReportHtml(spec) {
+  const {
+    question,
+    generatedAt,
+    criteria = [],
+    comparisonRows = [],
+    confirmedClaims = [],
+    unconfirmedClaims = [],
+    contradictions = [],
+    unavailableSources = [],
+    substitutionIncidents = [],
+    resourceMetrics = null
+  } = spec;
+
+  const thCells = ["Вариант", ...criteria, "Статус проверки"]
+    .map((c) => `<th>${escapeHtml(c)}</th>`)
+    .join("");
+
+  const trRows = comparisonRows
+    .map((row) => {
+      const tds = criteria
+        .map((c) => {
+          const cell = row.values?.[c];
+          if (!cell) return `<td class="unverified">Неизвестно (нет выдержки)</td>`;
+          if (typeof cell === "object") {
+            const cls = cell.conflict ? "conflict" : cell.outdated ? "outdated" : "confirmed";
+            return `<td class="${cls}">${escapeHtml(cell.displayValue)} <a href="${escapeHtml(cell.sourceUrl)}">[${escapeHtml(cell.sourceTitle || "Источник")} ${cell.startUtf16}..${cell.endUtf16}]</a></td>`;
+          }
+          return `<td>${escapeHtml(cell)}</td>`;
+        })
+        .join("");
+      return `<tr><td><strong>${escapeHtml(row.optionName)}</strong></td>${tds}<td>${escapeHtml(row.verificationSummary || "Проверено")}</td></tr>`;
+    })
+    .join("\n");
+
+  const claimsHtml = confirmedClaims
+    .map(
+      (c) =>
+        `<li data-claim-id="${escapeHtml(c.claimId)}">
+          <strong>${escapeHtml(c.claim)}</strong>
+          ${c.isOutdated ? `<span class="badge-outdated">Устаревшие данные: ${escapeHtml(c.outdatedNote || "")}</span>` : ""}
+          <blockquote>«${escapeHtml(c.excerpt.quote)}» <code>[UTF-16 ${c.excerpt.startUtf16}..${c.excerpt.endUtf16}, v${c.excerpt.pageVersion}]</code></blockquote>
+          <div class="source-meta">
+            Источник: <a href="${escapeHtml(c.source.url)}">${escapeHtml(c.source.title)}</a> |
+            Дата на странице: <code>${escapeHtml(c.source.pageDate || "не указана")}</code> |
+            Дата события: <code>${escapeHtml(c.source.eventDate || "не указана")}</code> |
+            Получено: <code>${escapeHtml(c.source.fetchedAt)}</code>
+          </div>
+        </li>`
+    )
+    .join("\n");
+
+  const conflictsHtml = contradictions
+    .map(
+      (cf) =>
+        `<li class="conflict-item">
+          <strong>${escapeHtml(cf.criterion)} (${escapeHtml(cf.optionName || "")}):</strong> ${escapeHtml(cf.summary)}
+          <ul>
+            <li>Позиция А: «${escapeHtml(cf.sideA.quote)}» (<a href="${escapeHtml(cf.sideA.url)}">${escapeHtml(cf.sideA.title)}</a>, UTF-16 ${cf.sideA.startUtf16}..${cf.sideA.endUtf16})</li>
+            <li>Позиция Б: «${escapeHtml(cf.sideB.quote)}» (<a href="${escapeHtml(cf.sideB.url)}">${escapeHtml(cf.sideB.title)}</a>, UTF-16 ${cf.sideB.startUtf16}..${cf.sideB.endUtf16})</li>
+          </ul>
+        </li>`
+    )
+    .join("\n");
+
+  const unknownHtml = [
+    ...unconfirmedClaims.map(
+      (u) =>
+        `<li><strong>Не подтверждено (${escapeHtml(u.claimId)}):</strong> ${escapeHtml(u.claim)} — <em>${escapeHtml(u.reason)}</em></li>`
+    ),
+    ...unavailableSources.map(
+      (s) =>
+        `<li><strong>Недоступный источник:</strong> <code>${escapeHtml(s.url)}</code> (HTTP ${escapeHtml(s.httpStatus)}, ${escapeHtml(s.reason || "недоступен")})</li>`
+    ),
+    ...substitutionIncidents.map(
+      (sub) =>
+        `<li><strong>Подмена текста после наблюдения:</strong> <code>${escapeHtml(sub.url)}</code> (v${sub.observedPageVersion} → v${sub.currentPageVersion}, UTF-16 ${sub.startUtf16}..${sub.endUtf16}: «${escapeHtml(sub.expectedText)}» → «${escapeHtml(sub.actualTextAtOffsets)}»)</li>`
+    )
+  ].join("\n");
+
+  return `<!doctype html>
+<html lang="ru">
+<head>
+  <meta charset="utf-8" />
+  <title>Исследовательский отчёт Koswork: ${escapeHtml(question)}</title>
+  <style>
+    body { font-family: system-ui, -apple-system, sans-serif; margin: 24px; color: #111827; line-height: 1.5; }
+    table { border-collapse: collapse; width: 100%; margin: 16px 0; }
+    th, td { border: 1px solid #d1d5db; padding: 8px 10px; text-align: left; vertical-align: top; }
+    th { background: #f3f4f6; }
+    .conflict { background: #fef2f2; }
+    .outdated { background: #fffbeb; }
+    .unverified { color: #6b7280; font-style: italic; }
+    blockquote { margin: 6px 0; padding: 6px 12px; border-left: 3px solid #2563eb; background: #f8fafc; }
+    .source-meta { font-size: 0.875rem; color: #4b5563; }
+  </style>
+</head>
+<body>
+  <h1>Исследовательский отчёт Koswork: ${escapeHtml(question)}</h1>
+  <p>Сформировано: <code>${escapeHtml(generatedAt)}</code></p>
+  <h2>1. Таблица сравнения вариантов</h2>
+  <table>
+    <thead><tr>${thCells}</tr></thead>
+    <tbody>${trRows}</tbody>
+  </table>
+  <h2>2. Подтверждённые утверждения (Утверждение → Выдержка → Источник)</h2>
+  <ul>${claimsHtml}</ul>
+  <h2>3. Противоречия и устаревшие данные</h2>
+  <ul>${conflictsHtml}</ul>
+  <h2>4. Что неизвестно и недоступные источники</h2>
+  <ul>${unknownHtml}</ul>
+  ${
+    resourceMetrics
+      ? `<h2>5. Фактические метрики ресурсов</h2>
+         <p>RAM RSS: <code>${resourceMetrics.ramTelemetry.currentRssMb} МБ</code> (пик <code>${resourceMetrics.ramTelemetry.peakRssMb} МБ</code>) | Задержка p50: <code>${resourceMetrics.latencyTelemetry.p50Ms} мс</code>, p95: <code>${resourceMetrics.latencyTelemetry.p95Ms} мс</code></p>`
+      : ""
+  }
+</body>
+</html>`;
+}
+
+/**
+ * Saves the Markdown report, HTML report, and JSON comparison matrix via the existing
+ * `createKosworkWorkspaceService` (`desktop/windows/workspace/workspace-service.cjs`).
+ */
+async function saveResearchReportsViaWorkspace({
+  workspaceRoot,
+  workspaceService = null,
+  reportSlug = "browser-research-report",
+  reportData,
+  signal = null
+} = {}) {
+  let svc = workspaceService;
+  if (!svc) {
+    svc = createKosworkWorkspaceService();
+    await svc.connectFolder({ folderPath: workspaceRoot, signal });
+  } else if (!svc.getStatus().connected && workspaceRoot) {
+    await svc.connectFolder({ folderPath: workspaceRoot, signal });
+  }
+
+  const sourcesByUrl = new Map();
+  for (const s of reportData.sources || []) {
+    sourcesByUrl.set(s.url, s);
+  }
+
+  const { confirmedClaims, unconfirmedClaims } = validateAndClassifyClaims(
+    reportData.claims || [],
+    sourcesByUrl
+  );
+
+  const enrichedSpec = {
+    ...reportData,
+    generatedAt: reportData.generatedAt || new Date().toISOString(),
+    confirmedClaims,
+    unconfirmedClaims
+  };
+
+  const markdownContent = renderResearchReportMarkdown(enrichedSpec);
+  const htmlContent = renderResearchReportHtml(enrichedSpec);
+  const comparisonTableJson = JSON.stringify(
+    {
+      question: enrichedSpec.question,
+      generatedAt: enrichedSpec.generatedAt,
+      criteria: enrichedSpec.criteria || [],
+      comparisonRows: enrichedSpec.comparisonRows || [],
+      confirmedClaims,
+      unconfirmedClaims,
+      contradictions: enrichedSpec.contradictions || [],
+      outdatedFindings: enrichedSpec.outdatedFindings || [],
+      unavailableSources: enrichedSpec.unavailableSources || [],
+      substitutionIncidents: enrichedSpec.substitutionIncidents || [],
+      resourceMetrics: enrichedSpec.resourceMetrics || null
+    },
+    null,
+    2
+  );
+
+  const writeOrUpdate = async (relativePath, content) => {
+    try {
+      return await svc.createFile({
+        relativePath,
+        content,
+        createParents: true,
+        signal
+      });
+    } catch (err) {
+      if (err && err.code === "WORKSPACE_ALREADY_EXISTS") {
+        const existing = await svc.readTextFile({ relativePath, signal });
+        return await svc.updateFile({
+          relativePath,
+          content,
+          expectedVersion: existing.version,
+          signal
+        });
+      }
+      throw err;
+    }
+  };
+
+  const mdFile = await writeOrUpdate(`reports/${reportSlug}.md`, markdownContent);
+  const htmlFile = await writeOrUpdate(`reports/${reportSlug}.html`, htmlContent);
+  const tableFile = await writeOrUpdate(`reports/${reportSlug}-comparison.json`, comparisonTableJson);
+
+  return {
+    markdownFile: mdFile,
+    htmlFile,
+    comparisonTableFile: tableFile,
+    confirmedClaims,
+    unconfirmedClaims,
+    markdownContent,
+    htmlContent
+  };
+}
+
+module.exports = {
+  renderResearchReportHtml,
+  renderResearchReportMarkdown,
+  saveResearchReportsViaWorkspace,
+  validateAndClassifyClaims
+};
