+"use strict";
+
+const { KosworkBrowserEngine } = require("./engine.cjs");
+const { saveResearchReportsViaWorkspace } = require("./research-report-builder.cjs");
+
+/**
+ * Koswork Multi-Site Browser Research Procedure (`desktop/windows/browser/research-workflow.cjs`).
+ *
+ * Implements the end-to-end research cycle inside the existing Work executor:
+ * 1. Question formulation & criteria decomposition (`formulateResearchQuestion`)
+ * 2. Search execution via `engine.searchService`
+ * 3. Opening candidate sources in the browser, reading long & dynamic pages, and extracting
+ *    UTF-16 anchored excerpts (`claim -> excerpt -> source`)
+ * 4. Cross-source comparison by criteria, detecting contradictions, outdated `pageDate`/`eventDate`,
+ *    unavailable pages, and post-observation text substitutions
+ * 5. Saving verifiable MD / HTML / comparison table reports via existing workspace file APIs
+ */
+
+function formulateResearchQuestion(input = {}) {
+  const rawQuestion = String(input.question || input.searchQuery || "").trim();
+  if (!rawQuestion) {
+    throw new Error("RESEARCH_QUESTION_REQUIRED");
+  }
+  const criteria =
+    Array.isArray(input.criteria) && input.criteria.length > 0
+      ? input.criteria.map((c) => String(c).trim()).filter(Boolean)
+      : ["Цена", "Автономный режим", "Поддержка SLA"];
+
+  const options =
+    Array.isArray(input.options) && input.options.length > 0
+      ? input.options.map((o) => String(o).trim()).filter(Boolean)
+      : [];
+
+  return {
+    question: rawQuestion,
+    searchQuery: String(input.searchQuery || rawQuestion).trim(),
+    criteria,
+    options,
+    formulatedAt: new Date().toISOString()
+  };
+}
+
+/**
+ * Executes a complete multi-site browser research workflow using an existing `KosworkBrowserEngine`
+ * and optional `workExecutor` (`KosworkUnifiedTaskCoordinator`), recording steps into the unified
+ * Work executor history without creating a second agent loop.
+ */
+async function executeMultiSiteResearchWorkflow({
+  engine,
+  workspaceRoot,
+  workspaceService = null,
+  workExecutor = null,
+  plan = {},
+  signal = null
+} = {}) {
+  const browserEngine =
+    engine ||
+    new KosworkBrowserEngine({
+      allowedWorkspaceRoot: workspaceRoot
+    });
+
+  const recordStep = (action, status, details) => {
+    if (workExecutor && typeof workExecutor.appendHistoryEntry === "function") {
+      workExecutor.appendHistoryEntry({
+        domain: "browser_research",
+        action,
+        status,
+        details
+      });
+    }
+  };
+
+  // Step 1: Question formulation
+  const formulation = formulateResearchQuestion(plan);
+  recordStep("formulate_question", "completed", {
+    question: formulation.question,
+    criteria: formulation.criteria,
+    options: formulation.options
+  });
+
+  // Step 2: Execute search query
+  const searchResponse = await browserEngine.searchService.search({
+    query: formulation.searchQuery,
+    actor: plan.actor || "agent",
+    page: 1,
+    pageSize: 10,
+    signal,
+    mockOrAdapterResults: plan.searchResults || null
+  });
+
+  recordStep("search_sources", "completed", {
+    searchId: searchResponse.searchId,
+    providerId: searchResponse.providerId,
+    totalResults: searchResponse.totalResults
+  });
+
+  const openedSources = [];
+  const unavailableSources = [];
+  const extractedFacts = []; // { optionName, criterion, value, displayValue, excerpt, source, pageDate, eventDate }
+  const substitutionIncidents = [];
+  const authPausedSources = [];
+
+  // Step 3: Open each result in the browser engine, read long/dynamic content, and extract UTF-16 excerpts
+  for (const item of searchResponse.items) {
+    if (signal?.aborted) {
+      const err = new Error("RESEARCH_WORKFLOW_CANCELLED");
+      err.code = "RESEARCH_WORKFLOW_CANCELLED";
+      throw err;
+    }
+
+    const sourceVisit = await browserEngine.searchService.openSearchResult({
+      searchId: searchResponse.searchId,
+      rank: item.rank,
+      url: item.url,
+      actor: plan.actor || "agent",
+      signal
+    });
+
+    const tabState = browserEngine.tabs.get(sourceVisit.tabId);
+    if (!sourceVisit.available || sourceVisit.httpStatus >= 400) {
+      unavailableSources.push({
+        url: sourceVisit.url,
+        title: sourceVisit.title,
+        httpStatus: sourceVisit.httpStatus,
+        reason: tabState?.networkError || `HTTP ${sourceVisit.httpStatus}`,
+        fetchedAt: sourceVisit.fetchedAt
+      });
+      openedSources.push(sourceVisit);
+      recordStep("open_source_unavailable", "degraded", {
+        url: sourceVisit.url,
+        httpStatus: sourceVisit.httpStatus
+      });
+      continue;
+    }
+
+    if (tabState?.authGate?.gated) {
+      authPausedSources.push({
+        url: sourceVisit.url,
+        gateType: tabState.authGate.gateType,
+        code: tabState.authGate.code,
+        reason: tabState.authGate.reason
+      });
+      openedSources.push(sourceVisit);
+      recordStep("open_source_paused_for_user", "paused_for_user", {
+        url: sourceVisit.url,
+        gateType: tabState.authGate.gateType
+      });
+      continue;
+    }
+
+    // Trigger dynamic content loading if page has lazy-loaded blocks
+    if (tabState?.rawSiteDef?.onDynamicScroll) {
+      await browserEngine.readLongPage({
+        tabId: sourceVisit.tabId,
+        cursorUtf16: 0,
+        windowChars: 4000,
+        triggerDynamicScroll: true,
+        signal
+      });
+    }
+
+    // Read progressive windows if the page is a very long article (> 4000 UTF-16 code units)
+    const initialObservation = browserEngine.observePage(sourceVisit.tabId, { reuseSnapshot: true }).snapshot;
+    let cursor = 0;
+    let windowsRead = 0;
+    while (cursor !== null && cursor < initialObservation.totalUtf16CodeUnits) {
+      const win = await browserEngine.readLongPage({
+        tabId: sourceVisit.tabId,
+        cursorUtf16: cursor,
+        windowChars: 4000,
+        overlapChars: 100,
+        signal
+      });
+      windowsRead += 1;
+      cursor = win.hasMore ? win.nextCursorUtf16 : null;
+    }
+
+    // Check if the site simulates a post-observation text substitution before claim verification
+    if (tabState?.rawSiteDef?.simulatePostObservationSubstitution) {
+      const subSpec = tabState.rawSiteDef.simulatePostObservationSubstitution;
+      const preSubExcerpt = browserEngine.extractExcerpt(sourceVisit.tabId, {
+        searchTerm: subSpec.targetPhrase
+      });
+      browserEngine.mutatePageContent(sourceVisit.tabId, {
+        replaceText: {
+          from: subSpec.targetPhrase,
+          to: subSpec.substitutedPhrase
+        }
+      });
+      if (preSubExcerpt) {
+        try {
+          browserEngine.extractExcerpt(
+            sourceVisit.tabId,
+            {
+              startUtf16: preSubExcerpt.startUtf16,
+              endUtf16: preSubExcerpt.endUtf16,
+              expectedQuote: preSubExcerpt.quote
+            },
+            initialObservation
+          );
+        } catch (subErr) {
+          if (subErr && subErr.code === "OBSERVATION_TEXT_SUBSTITUTED") {
+            substitutionIncidents.push({
+              url: sourceVisit.url,
+              title: sourceVisit.title,
+              ...subErr.details
+            });
+          } else {
+            throw subErr;
+          }
+        }
+      }
+    }
+
+    // Extract structured claims/facts from the current verified snapshot
+    const currentObs = browserEngine.observePage(sourceVisit.tabId, { reuseSnapshot: true }).snapshot;
+    const siteAssertions = Array.isArray(tabState?.rawSiteDef?.assertions)
+      ? tabState.rawSiteDef.assertions
+      : extractHeuristicAssertionsFromSnapshot(currentObs, formulation);
+
+    for (const assertion of siteAssertions) {
+      const excerpt = browserEngine.extractExcerpt(
+        sourceVisit.tabId,
+        {
+          exactQuote: assertion.quote,
+          searchTerm: assertion.searchTerm || assertion.quote
+        },
+        currentObs
+      );
+      if (excerpt) {
+        browserEngine.searchService.linkExcerptToSource(sourceVisit.sourceVisitId, excerpt);
+        extractedFacts.push({
+          optionName: assertion.optionName || "Общий вариант",
+          criterion: assertion.criterion,
+          value: assertion.value,
+          displayValue: String(assertion.displayValue ?? assertion.value),
+          claimText:
+            assertion.claimText ||
+            `${assertion.optionName}: ${assertion.criterion} = ${assertion.displayValue ?? assertion.value}`,
+          excerpt,
+          source: {
+            url: sourceVisit.url,
+            title: currentObs.title,
+            pageDate: currentObs.pageDate,
+            eventDate: currentObs.eventDate,
+            fetchedAt: currentObs.fetchedAt
+          }
+        });
+      }
+    }
+
+    openedSources.push({
+      ...sourceVisit,
+      pageDate: currentObs.pageDate,
+      eventDate: currentObs.eventDate,
+      windowsRead,
+      totalUtf16CodeUnits: currentObs.totalUtf16CodeUnits
+    });
+  }
+
+  // Step 4: Compare across sources, detect contradictions and outdated data
+  const contradictions = [];
+  const outdatedFindings = [];
+  const factsByOptionAndCriterion = new Map();
+
+  for (const fact of extractedFacts) {
+    const key = `${fact.optionName}||${fact.criterion}`;
+    if (!factsByOptionAndCriterion.has(key)) {
+      factsByOptionAndCriterion.set(key, []);
+    }
+    factsByOptionAndCriterion.get(key).push(fact);
+  }
+
+  const allOptions =
+    formulation.options.length > 0
+      ? formulation.options
+      : Array.from(new Set(extractedFacts.map((f) => f.optionName)));
+
+  const comparisonRows = [];
+  const claimsForReport = [];
+
+  for (const optionName of allOptions) {
+    const rowValues = {};
+    let hasConflictInRow = false;
+
+    for (const criterion of formulation.criteria) {
+      const key = `${optionName}||${criterion}`;
+      const group = factsByOptionAndCriterion.get(key) || [];
+      if (group.length === 0) {
+        rowValues[criterion] = null;
+        claimsForReport.push({
+          optionName,
+          criterion,
+          claim: `${optionName} — значение по критерию «${criterion}»`,
+          excerpt: null,
+          sourceUrl: null
+        });
+        continue;
+      }
+
+      // Sort by effective date (`eventDate` || `pageDate`) descending if dates exist
+      const distinctValues = Array.from(new Set(group.map((g) => String(g.value))));
+      if (distinctValues.length > 1) {
+        const first = group[0];
+        const second = group.find((g) => String(g.value) !== String(first.value));
+        const dateA = first.source.eventDate || first.source.pageDate || null;
+        const dateB = second.source.eventDate || second.source.pageDate || null;
+
+        hasConflictInRow = true;
+        contradictions.push({
+          optionName,
+          criterion,
+          summary: `Расхождение значений между источниками: «${first.displayValue}» против «${second.displayValue}».`,
+          sideA: {
+            value: first.value,
+            quote: first.excerpt.quote,
+            startUtf16: first.excerpt.startUtf16,
+            endUtf16: first.excerpt.endUtf16,
+            url: first.source.url,
+            title: first.source.title,
+            pageDate: first.source.pageDate,
+            eventDate: first.source.eventDate
+          },
+          sideB: {
+            value: second.value,
+            quote: second.excerpt.quote,
+            startUtf16: second.excerpt.startUtf16,
+            endUtf16: second.excerpt.endUtf16,
+            url: second.source.url,
+            title: second.source.title,
+            pageDate: second.source.pageDate,
+            eventDate: second.source.eventDate
+          }
+        });
+
+        // Also check if one of the conflicting sources is older by `pageDate` / `eventDate`
+        if (dateA && dateB && dateA !== dateB) {
+          const older = dateA < dateB ? first : second;
+          const newer = dateA < dateB ? second : first;
+          older.isOutdated = true;
+          older.outdatedNote = `Более свежий источник (${newer.source.title}) от ${newer.source.eventDate || newer.source.pageDate} указывает: ${newer.displayValue}`;
+          outdatedFindings.push({
+            optionName,
+            criterion,
+            url: older.source.url,
+            title: older.source.title,
+            pageDate: older.source.pageDate,
+            eventDate: older.source.eventDate,
+            supersededByDate: newer.source.eventDate || newer.source.pageDate,
+            note: older.outdatedNote
+          });
+        }
+
+        rowValues[criterion] = {
+          displayValue: `${first.displayValue} vs ${second.displayValue}`,
+          conflict: true,
+          outdated: Boolean(first.isOutdated || second.isOutdated),
+          sourceUrl: first.source.url,
+          sourceTitle: first.source.title,
+          startUtf16: first.excerpt.startUtf16,
+          endUtf16: first.excerpt.endUtf16
+        };
+      } else {
+        const chosen = group[0];
+        rowValues[criterion] = {
+          displayValue: chosen.displayValue,
+          conflict: false,
+          outdated: Boolean(chosen.isOutdated),
+          sourceUrl: chosen.source.url,
+          sourceTitle: chosen.source.title,
+          startUtf16: chosen.excerpt.startUtf16,
+          endUtf16: chosen.excerpt.endUtf16
+        };
+      }
+
+      for (const f of group) {
+        claimsForReport.push({
+          optionName: f.optionName,
+          criterion: f.criterion,
+          value: f.value,
+          claim: f.claimText,
+          isOutdated: Boolean(f.isOutdated),
+          outdatedNote: f.outdatedNote || null,
+          excerpt: f.excerpt,
+          sourceUrl: f.source.url
+        });
+      }
+    }
+
+    comparisonRows.push({
+      optionName,
+      values: rowValues,
+      verificationSummary: hasConflictInRow
+        ? "Обнаружено противоречие между источниками"
+        : "Подтверждено выдержками"
+    });
+  }
+
+  // Include any explicit unbacked claims passed in plan.unbackedClaims to verify epistemic rejection
+  if (Array.isArray(plan.unbackedClaims)) {
+    for (const rawUnbacked of plan.unbackedClaims) {
+      claimsForReport.push({
+        claim: rawUnbacked.claim,
+        sourceUrl: rawUnbacked.sourceUrl || null,
+        excerpt: null
+      });
+    }
+  }
+
+  const resourceMetrics = browserEngine.resourceGovernor.getResourceReport();
+
+  // Step 5: Save reports via workspace service
+  const savedReports = await saveResearchReportsViaWorkspace({
+    workspaceRoot,
+    workspaceService,
+    reportSlug: plan.reportSlug || "koswork-browser-research-report",
+    reportData: {
+      question: formulation.question,
+      criteria: formulation.criteria,
+      comparisonRows,
+      claims: claimsForReport,
+      contradictions,
+      outdatedFindings,
+      unavailableSources,
+      substitutionIncidents,
+      sources: openedSources,
+      resourceMetrics
+    },
+    signal
+  });
+
+  recordStep("save_research_reports", "completed", {
+    markdownPath: savedReports.markdownFile.path,
+    htmlPath: savedReports.htmlFile.path,
+    comparisonTablePath: savedReports.comparisonTableFile.path,
+    confirmedClaimsCount: savedReports.confirmedClaims.length,
+    contradictionsCount: contradictions.length
+  });
+
+  return {
+    status: "completed",
+    formulation,
+    searchResponse,
+    openedSources,
+    unavailableSources,
+    authPausedSources,
+    contradictions,
+    outdatedFindings,
+    substitutionIncidents,
+    confirmedClaims: savedReports.confirmedClaims,
+    unconfirmedClaims: savedReports.unconfirmedClaims,
+    comparisonRows,
+    resourceMetrics,
+    savedReports
+  };
+}
+
+function extractHeuristicAssertionsFromSnapshot(snapshot, formulation) {
+  const results = [];
+  for (const block of snapshot.blocks || []) {
+    for (const crit of formulation.criteria || []) {
+      if (block.text.toLowerCase().includes(crit.toLowerCase())) {
+        results.push({
+          optionName: formulation.options[0] || snapshot.title || "Источник",
+          criterion: crit,
+          value: block.text.slice(0, 120),
+          displayValue: block.text.slice(0, 120),
+          quote: block.text.slice(0, Math.min(block.text.length, 160)),
+          claimText: `${snapshot.title}: ${block.text.slice(0, 120)}`
+        });
+      }
+    }
+  }
+  return results;
+}
+
+module.exports = {
+  executeMultiSiteResearchWorkflow,
+  formulateResearchQuestion
+};
diff --git a/desktop/windows/browser/resource-governor.cjs b/desktop/windows/browser/resource-governor.cjs
new file mode 100644
index 0000000..258b214
--- /dev/null
+++ b/desktop/windows/browser/resource-governor.cjs
@@ -0,0 +1,290 @@
+"use strict";
+
+const { MAX_ACTIVE_WEB_VIEWS } = require("./search-pagination-and-bookmarks.cjs");
+
+/**
+ * Koswork Browser Resource Governor & Telemetry Collector (`desktop/windows/browser/resource-governor.cjs`).
+ *
+ * Implements measurement-driven resource management:
+ * 1. Enforces a live tab limit (`maxLiveTabs`, default 3), automatically hibernating/unloading
+ *    least-recently-used background tabs while preserving their lightweight `tabReceipt` and
+ *    snapshot metadata for seamless restoration.
+ * 2. Reuses valid snapshots (`snapshotTtlMs`) when `url` and `pageVersion` match, avoiding
+ *    redundant DOM serialization.
+ * 3. Provides cooperative cancellation (`AbortController`) for in-flight page reads and searches.
+ * 4. Measures actual process RAM (`rssBytes`, `heapUsedBytes`, `externalBytes`) and per-page
+ *    navigation/read latency (`p50Ms`, `p95Ms`, `totalMs`) on a benchmark page set without promising "zero load".
+ */
+
+class KosworkBrowserResourceGovernor {
+  constructor(options = {}) {
+    this.maxLiveTabs = Math.max(1, Number(options.maxLiveTabs ?? MAX_ACTIVE_WEB_VIEWS));
+    this.snapshotTtlMs = Math.max(0, Number(options.snapshotTtlMs ?? 30000));
+    this.now = typeof options.now === "function" ? options.now : () => Date.now();
+
+    this.liveTabs = new Map(); // tabId -> { tabId, url, lastActiveAt, estimatedDomBytes, status: 'live' }
+    this.hibernatedTabs = new Map(); // tabId -> { tabId, url, tabReceipt, hibernatedAt, snapshotSummary }
+    this.snapshotCache = new Map(); // cacheKey -> { snapshot, cachedAtMs }
+    this.activeControllers = new Map(); // taskId -> { taskId, kind, controller, startedAtMs }
+    this.latencySamples = [];
+    this.memorySamples = [];
+    this.hibernationEvents = [];
+    this.snapshotReuseCount = 0;
+    this.snapshotMissCount = 0;
+  }
+
+  sampleProcessMemory(label = "sample") {
+    const usage = process.memoryUsage();
+    const entry = {
+      label,
+      sampledAtMs: this.now(),
+      rssMb: Number((usage.rss / (1024 * 1024)).toFixed(2)),
+      heapUsedMb: Number((usage.heapUsed / (1024 * 1024)).toFixed(2)),
+      heapTotalMb: Number((usage.heapTotal / (1024 * 1024)).toFixed(2)),
+      externalMb: Number((usage.external / (1024 * 1024)).toFixed(2)),
+      liveTabCount: this.liveTabs.size,
+      hibernatedTabCount: this.hibernatedTabs.size
+    };
+    this.memorySamples.push(entry);
+    return entry;
+  }
+
+  /**
+   * Registers or touches a live tab and unloads/hibernates the oldest background tab(s)
+   * if `liveTabs.size > maxLiveTabs`.
+   */
+  touchLiveTab(tabId, tabState = {}, onHibernateCallback = null) {
+    const key = String(tabId);
+    const nowMs = this.now();
+
+    if (this.hibernatedTabs.has(key)) {
+      this.hibernatedTabs.delete(key);
+    }
+
+    const domChars = Number(tabState.snapshot?.totalUtf16CodeUnits || 0);
+    this.liveTabs.set(key, {
+      tabId: key,
+      url: String(tabState.url || "about:blank"),
+      lastActiveAt: nowMs,
+      estimatedDomBytes: domChars * 2,
+      tabReceipt: tabState.snapshot?.tabReceipt || tabState.tabReceipt || null,
+      status: "live"
+    });
+
+    const newlyHibernated = [];
+    while (this.liveTabs.size > this.maxLiveTabs) {
+      let oldestId = null;
+      let oldestTime = Infinity;
+      for (const [id, info] of this.liveTabs.entries()) {
+        if (id === key) continue;
+        if (info.lastActiveAt < oldestTime) {
+          oldestTime = info.lastActiveAt;
+          oldestId = id;
+        }
+      }
+      if (!oldestId) break;
+
+      const evicted = this.liveTabs.get(oldestId);
+      this.liveTabs.delete(oldestId);
+
+      const hibRecord = {
+        tabId: oldestId,
+        url: evicted.url,
+        tabReceipt: evicted.tabReceipt,
+        hibernatedAtMs: nowMs,
+        freedDomBytes: evicted.estimatedDomBytes,
+        status: "hibernated"
+      };
+      this.hibernatedTabs.set(oldestId, hibRecord);
+      this.hibernationEvents.push(hibRecord);
+      newlyHibernated.push(oldestId);
+
+      if (typeof onHibernateCallback === "function") {
+        onHibernateCallback(oldestId, hibRecord);
+      }
+    }
+
+    return {
+      liveTabCount: this.liveTabs.size,
+      maxLiveTabs: this.maxLiveTabs,
+      hibernatedTabCount: this.hibernatedTabs.size,
+      newlyHibernatedTabIds: newlyHibernated
+    };
+  }
+
+  removeTab(tabId) {
+    const key = String(tabId);
+    this.liveTabs.delete(key);
+    this.hibernatedTabs.delete(key);
+    for (const cacheKey of this.snapshotCache.keys()) {
+      if (cacheKey.startsWith(`${key}|`)) {
+        this.snapshotCache.delete(cacheKey);
+      }
+    }
+  }
+
+  /**
+   * Stores a versioned snapshot for reuse within `snapshotTtlMs`.
+   */
+  cacheSnapshot(snapshot) {
+    if (!snapshot || !snapshot.tabId) return;
+    const key = `${snapshot.tabId}|${snapshot.url}|v${snapshot.pageVersion}`;
+    this.snapshotCache.set(key, {
+      snapshot,
+      cachedAtMs: this.now()
+    });
+  }
+
+  /**
+   * Returns a cached snapshot if it matches `tabId`, `url`, and `pageVersion` and is within `snapshotTtlMs`.
+   */
+  getReusableSnapshot(tabId, url, pageVersion) {
+    const key = `${tabId}|${url}|v${pageVersion}`;
+    const entry = this.snapshotCache.get(key);
+    if (!entry) {
+      this.snapshotMissCount += 1;
+      return null;
+    }
+    const ageMs = this.now() - entry.cachedAtMs;
+    if (ageMs > this.snapshotTtlMs) {
+      this.snapshotCache.delete(key);
+      this.snapshotMissCount += 1;
+      return null;
+    }
+    this.snapshotReuseCount += 1;
+    return entry.snapshot;
+  }
+
+  invalidateSnapshotsForTab(tabId) {
+    const prefix = `${tabId}|`;
+    for (const key of this.snapshotCache.keys()) {
+      if (key.startsWith(prefix)) {
+        this.snapshotCache.delete(key);
+      }
+    }
+  }
+
+  /**
+   * Begins a cancellable read or search operation and links any external AbortSignal.
+   */
+  beginTask(taskId, kind = "read", externalSignal = null) {
+    const id = String(taskId || `task-${this.now()}-${Math.random().toString(36).slice(2, 7)}`);
+    const controller = new AbortController();
+    const startedAtMs = this.now();
+
+    const onExternalAbort = () => {
+      controller.abort(externalSignal?.reason || "cancelled_by_caller");
+    };
+
+    if (externalSignal) {
+      if (externalSignal.aborted) {
+        onExternalAbort();
+      } else {
+        externalSignal.addEventListener("abort", onExternalAbort, { once: true });
+      }
+    }
+
+    const record = {
+      taskId: id,
+      kind,
+      controller,
+      startedAtMs,
+      finish: (meta = {}) => {
+        const durationMs = Math.max(0, this.now() - startedAtMs);
+        this.activeControllers.delete(id);
+        if (externalSignal) {
+          externalSignal.removeEventListener("abort", onExternalAbort);
+        }
+        this.latencySamples.push({
+          taskId: id,
+          kind,
+          durationMs,
+          url: meta.url || null,
+          aborted: controller.signal.aborted,
+          recordedAtMs: this.now()
+        });
+        return durationMs;
+      }
+    };
+
+    this.activeControllers.set(id, record);
+    return record;
+  }
+
+  cancelTask(taskId, reason = "cancelled_by_user") {
+    const record = this.activeControllers.get(String(taskId));
+    if (!record) return { cancelled: false, taskId };
+    if (!record.controller.signal.aborted) {
+      record.controller.abort(reason);
+    }
+    this.activeControllers.delete(String(taskId));
+    return { cancelled: true, taskId, reason };
+  }
+
+  cancelAllTasks(reason = "cancelled_all") {
+    const cancelledIds = [];
+    for (const [id, rec] of this.activeControllers.entries()) {
+      if (!rec.controller.signal.aborted) {
+        rec.controller.abort(reason);
+        cancelledIds.push(id);
+      }
+    }
+    this.activeControllers.clear();
+    return {
+      cancelledCount: cancelledIds.length,
+      cancelledTaskIds: cancelledIds,
+      reason
+    };
+  }
+
+  getResourceReport() {
+    const mem = this.sampleProcessMemory("report");
+    const completedLatencies = this.latencySamples
+      .filter((s) => !s.aborted)
+      .map((s) => s.durationMs)
+      .sort((a, b) => a - b);
+
+    const percentile = (sorted, p) => {
+      if (sorted.length === 0) return 0;
+      const idx = Math.min(sorted.length - 1, Math.floor((p / 100) * sorted.length));
+      return Number(sorted[idx].toFixed(2));
+    };
+
+    let peakRssMb = mem.rssMb;
+    let peakHeapUsedMb = mem.heapUsedMb;
+    for (const s of this.memorySamples) {
+      if (s.rssMb > peakRssMb) peakRssMb = s.rssMb;
+      if (s.heapUsedMb > peakHeapUsedMb) peakHeapUsedMb = s.heapUsedMb;
+    }
+
+    return {
+      maxLiveTabs: this.maxLiveTabs,
+      liveTabCount: this.liveTabs.size,
+      liveTabIds: Array.from(this.liveTabs.keys()),
+      hibernatedTabCount: this.hibernatedTabs.size,
+      hibernatedTabIds: Array.from(this.hibernatedTabs.keys()),
+      hibernationEventsCount: this.hibernationEvents.length,
+      snapshotReuseCount: this.snapshotReuseCount,
+      snapshotMissCount: this.snapshotMissCount,
+      activeTasksCount: this.activeControllers.size,
+      ramTelemetry: {
+        currentRssMb: mem.rssMb,
+        currentHeapUsedMb: mem.heapUsedMb,
+        peakRssMb,
+        peakHeapUsedMb,
+        externalMb: mem.externalMb
+      },
+      latencyTelemetry: {
+        totalCompletedOps: completedLatencies.length,
+        p50Ms: percentile(completedLatencies, 50),
+        p95Ms: percentile(completedLatencies, 95),
+        maxMs: completedLatencies.length ? Number(completedLatencies[completedLatencies.length - 1].toFixed(2)) : 0,
+        samples: this.latencySamples.slice(-20)
+      }
+    };
+  }
+}
+
+module.exports = {
+  KosworkBrowserResourceGovernor
+};
diff --git a/desktop/windows/browser/search.cjs b/desktop/windows/browser/search.cjs
new file mode 100644
index 0000000..8b4f06a
--- /dev/null
+++ b/desktop/windows/browser/search.cjs
@@ -0,0 +1,201 @@
+"use strict";
+
+const { KosworkSearchAndBrowserStore } = require("./search-pagination-and-bookmarks.cjs");
+const { createSearchProviderAdapter } = require("./research-adapter.cjs");
+const { extractVerifiableExcerpt } = require("./document.cjs");
+
+/**
+ * Koswork Browser Search & Result Navigation Controller (`desktop/windows/browser/search.cjs`).
+ *
+ * Connects user and agent search queries directly to the existing Koswork browser engine:
+ * 1. Executes search via the isolated search adapter (`research-adapter.cjs`), preserving explicit
+ *    provider provenance (`providerId`, `providerEndpoint`) — never claiming a fake "proprietary internet index".
+ * 2. Stores and paginates SERP entries in `KosworkSearchAndBrowserStore`.
+ * 3. `openSearchResult` actually opens the target URL in the browser engine, records `url`, `title`,
+ *    `fetchedAt`, `pageDate`, `eventDate`, and links any extracted excerpt (`excerptId`, `startUtf16`, `endUtf16`)
+ *    back to the originating search and source receipt.
+ */
+class KosworkBrowserSearchService {
+  constructor(options = {}) {
+    this.store = options.store || new KosworkSearchAndBrowserStore();
+    this.adapter = options.adapter || createSearchProviderAdapter(options.adapterOptions || {});
+    this.engine = options.engine || null;
+    this.openedSources = new Map(); // sourceVisitId -> provenance & excerpt linkages
+  }
+
+  attachEngine(engine) {
+    this.engine = engine;
+  }
+
+  async search({
+    query,
+    actor = "agent",
+    page = 1,
+    pageSize = 5,
+    signal = null,
+    mockOrAdapterResults = null
+  } = {}) {
+    if (signal?.aborted) {
+      const err = new Error("SEARCH_OPERATION_CANCELLED");
+      err.code = "SEARCH_OPERATION_CANCELLED";
+      throw err;
+    }
+
+    const normalizedActor = actor === "user" ? "user" : "agent";
+    let providerResponse;
+    if (Array.isArray(mockOrAdapterResults)) {
+      providerResponse = {
+        providerId: this.adapter.providerId || "explicit-results",
+        providerEndpoint: this.adapter.searchEndpoint || "local://explicit",
+        searchedAt: new Date().toISOString(),
+        query: String(query || "").trim(),
+        results: mockOrAdapterResults
+      };
+    } else {
+      providerResponse = await this.adapter.executeQuery(query, { signal });
+    }
+
+    const paginated = this.store.recordAndPaginateSearch({
+      query: providerResponse.query,
+      results: providerResponse.results,
+      page,
+      pageSize,
+      recordedAt: providerResponse.searchedAt
+    });
+
+    // Attach explicit provider origin metadata to the journal entry (never hiding behind a fake index)
+    const journalEntry = this.store.searchJournal.find((s) => s.searchId === paginated.searchId);
+    if (journalEntry) {
+      journalEntry.providerId = providerResponse.providerId;
+      journalEntry.providerEndpoint = providerResponse.providerEndpoint;
+      journalEntry.actor = normalizedActor;
+    }
+
+    return {
+      ...paginated,
+      actor: normalizedActor,
+      providerId: providerResponse.providerId,
+      providerEndpoint: providerResponse.providerEndpoint,
+      searchedAt: providerResponse.searchedAt
+    };
+  }
+
+  /**
+   * Opens a search result in the attached browser engine (for both user clicks and agent navigation),
+   * recording `url`, `title`, `fetchedAt`, `pageDate`, `eventDate`, and optional initial excerpt linkage.
+   */
+  async openSearchResult({
+    searchId,
+    rank = 1,
+    url = null,
+    tabId = null,
+    actor = "agent",
+    extractQuery = null,
+    signal = null
+  } = {}) {
+    if (!this.engine) {
+      throw new Error("BROWSER_ENGINE_NOT_ATTACHED_TO_SEARCH");
+    }
+    if (signal?.aborted) {
+      const err = new Error("SEARCH_RESULT_OPEN_CANCELLED");
+      err.code = "SEARCH_RESULT_OPEN_CANCELLED";
+      throw err;
+    }
+
+    let selectedItem = null;
+    let journalEntry = null;
+    if (searchId) {
+      journalEntry = this.store.searchJournal.find((s) => s.searchId === String(searchId));
+      if (!journalEntry) {
+        const err = new Error("SEARCH_JOURNAL_ENTRY_NOT_FOUND");
+        err.code = "SEARCH_JOURNAL_ENTRY_NOT_FOUND";
+        throw err;
+      }
+      selectedItem =
+        journalEntry.results.find((r) => Number(r.rank) === Number(rank)) ||
+        (url ? journalEntry.results.find((r) => r.url === url) : null);
+      if (!selectedItem && !url) {
+        const err = new Error(`SEARCH_RESULT_RANK_NOT_FOUND: rank ${rank} in ${searchId}`);
+        err.code = "SEARCH_RESULT_RANK_NOT_FOUND";
+        throw err;
+      }
+    }
+
+    const targetUrl = url || selectedItem?.url;
+    if (!targetUrl) {
+      throw new Error("SEARCH_RESULT_URL_MISSING");
+    }
+
+    const navResult = await this.engine.navigate({
+      tabId,
+      url: targetUrl,
+      actor,
+      signal,
+      initiatedBySearchId: searchId || null,
+      initiatedByRank: selectedItem ? selectedItem.rank : rank
+    });
+
+    const sourceVisitId = `src-${navResult.tabId}-v${navResult.snapshot?.pageVersion || 1}-${Date.now()}`;
+    const linkedExcerpts = [];
+
+    if (extractQuery && navResult.snapshot && navResult.httpStatus < 400) {
+      const excerpt = extractVerifiableExcerpt(navResult.snapshot, {
+        searchTerm: extractQuery
+      });
+      if (excerpt) {
+        linkedExcerpts.push(excerpt);
+      }
+    }
+
+    const sourceRecord = {
+      sourceVisitId,
+      searchId: searchId || null,
+      searchQuery: journalEntry ? journalEntry.queryPreview : null,
+      providerId: journalEntry ? journalEntry.providerId || journalEntry.engine : this.adapter.providerId,
+      serpRank: selectedItem ? selectedItem.rank : rank,
+      serpTitle: selectedItem ? selectedItem.title : null,
+      serpSnippet: selectedItem ? selectedItem.snippet : null,
+      actor: actor === "user" ? "user" : "agent",
+      tabId: navResult.tabId,
+      tabReceipt: navResult.tabReceipt,
+      url: navResult.url,
+      canonicalUrl: navResult.snapshot?.canonicalUrl || navResult.url,
+      title: navResult.snapshot?.title || selectedItem?.title || navResult.url,
+      httpStatus: navResult.httpStatus,
+      available: navResult.available,
+      pageDate: navResult.snapshot?.pageDate || null,
+      eventDate: navResult.snapshot?.eventDate || null,
+      fetchedAt: navResult.fetchedAt,
+      linkedExcerpts
+    };
+
+    this.openedSources.set(sourceVisitId, sourceRecord);
+    return sourceRecord;
+  }
+
+  /**
+   * Links a newly extracted excerpt from an open page to its source provenance record.
+   */
+  linkExcerptToSource(sourceVisitId, excerpt) {
+    const record = this.openedSources.get(String(sourceVisitId));
+    if (!record) {
+      throw new Error(`SOURCE_VISIT_NOT_FOUND: ${sourceVisitId}`);
+    }
+    if (excerpt && !record.linkedExcerpts.some((e) => e.excerptId === excerpt.excerptId)) {
+      record.linkedExcerpts.push(excerpt);
+    }
+    return record;
+  }
+
+  getSourceRecord(sourceVisitId) {
+    return this.openedSources.get(String(sourceVisitId)) || null;
+  }
+
+  listOpenedSources() {
+    return Array.from(this.openedSources.values());
+  }
+}
+
+module.exports = {
+  KosworkBrowserSearchService
+};
diff --git a/desktop/windows/connection-policy.cjs b/desktop/windows/connection-policy.cjs
