+    const postDom = {
+      url: updatedSnapshot.url,
+      title: updatedSnapshot.title,
+      nodes: [
+        ...updatedSnapshot.controls.map((c) => ({
+          id: c.id,
+          tag: c.tag,
+          role: c.role,
+          text: c.label,
+          value: c.value,
+          visible: true,
+          disabled: c.disabled
+        })),
+        ...updatedSnapshot.blocks.map((b) => ({
+          id: b.blockId,
+          tag: b.tag,
+          role: b.role,
+          text: b.text,
+          value: "",
+          visible: true,
+          disabled: false
