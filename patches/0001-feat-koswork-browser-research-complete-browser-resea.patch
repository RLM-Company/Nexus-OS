+    text: "Подтвердите, что вы не робот (g-recaptcha)."
+  });
+  const captchaNav = await engine.navigate({
+    tabId: "tab-captcha",
+    url: "https://corpus.local/protected-captcha"
+  });
+  assert.equal(captchaNav.status, "paused_for_user");
+  assert.equal(captchaNav.authGate.gateType, "captcha");
+
+  // 2f. Cancellation of slow navigation & tab loss (`TAB_LOST_OR_CLOSED`)
+  engine.registerSyntheticSite("https://corpus.local/slow-page", {
+    title: "Медленная страница",
+    simulatedDelayMs: 2000,
+    text: "Долгая загрузка"
+  });
