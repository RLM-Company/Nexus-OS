+            url: normalizedUrl,
+            canonicalUrl: normalizedUrl,
+            httpStatus: httpRes.status,
+            html: httpRes.body,
+            fetchedAt
+          };
+        } catch (fetchErr) {
+          if (fetchErr && (fetchErr.code === "SEARCH_REQUEST_CANCELLED" || task.controller.signal.aborted)) {
+            const err = new Error("BROWSER_NAVIGATION_CANCELLED");
+            err.code = "BROWSER_NAVIGATION_CANCELLED";
+            throw err;
+          }
+          rawPageData = {
+            url: normalizedUrl,
+            canonicalUrl: normalizedUrl,
+            httpStatus: 503,
+            title: "Источник временно недоступен",
+            text: `Ошибка соединения при получении ${normalizedUrl}: ${fetchErr.message || String(fetchErr)}`,
+            networkError: fetchErr.code || fetchErr.message || "NETWORK_UNAVAILABLE",
+            fetchedAt
+          };
+        }
