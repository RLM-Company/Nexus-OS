+      url: tab.url,
+      title: tab.snapshot.title,
+      nodes: [
+        ...tab.snapshot.controls.map((c) => ({
+          id: c.id,
+          tag: c.tag,
+          role: c.role,
+          text: c.label,
+          value: c.value,
+          visible: true,
+          disabled: c.disabled
