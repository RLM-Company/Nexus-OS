diff --git a/desktop/windows/browser/find-in-page-highlighter.cjs b/desktop/windows/browser/find-in-page-highlighter.cjs
new file mode 100644
index 0000000..73216b2
--- /dev/null
+++ b/desktop/windows/browser/find-in-page-highlighter.cjs
@@ -0,0 +1,111 @@
+"use strict";
+
+const { extractVerifiableExcerpt } = require("./document.cjs");
+
+/**
+ * Koswork In-Page All-Occurrences UTF-16 Find & Highlighter
+ * (`desktop/windows/browser/find-in-page-highlighter.cjs`).
+ *
+ * Deepens Requirement #3 & #7:
+ * - Provides deterministic `Ctrl+F`-style search across `snapshot.fullTextUtf16`,
+ *   returning every occurrence with exact `[startUtf16, endUtf16]` code unit offsets,
+ *   surrounding context snippets (`contextBefore`, `matchedText`, `contextAfter`),
+ *   and owning block metadata (`blockId`, `bounds`).
+ * - Allows promoting any occurrence index (`occurrenceIndex`) directly into a
+ *   cryptographically verified citation excerpt (`extractExcerptForOccurrence`).
+ */
+function findAllOccurrencesInSnapshot(
+  snapshot,
+  { query, contextWindowChars = 60, maxMatches = 100 } = {}
+) {
+  if (!snapshot || typeof snapshot.fullTextUtf16 !== "string") {
+    throw new Error("FIND_IN_PAGE_REQUIRES_SNAPSHOT");
+  }
+  const needle = String(query || "").trim();
+  if (!needle) {
+    throw new Error("FIND_IN_PAGE_QUERY_REQUIRED");
+  }
+
+  const fullText = snapshot.fullTextUtf16;
+  const lowerFull = fullText.toLowerCase();
+  const lowerNeedle = needle.toLowerCase();
+
+  const matches = [];
+  let cursor = 0;
+
+  while (cursor < fullText.length && matches.length < maxMatches) {
+    const idx = lowerFull.indexOf(lowerNeedle, cursor);
+    if (idx < 0) break;
+
+    const startUtf16 = idx;
+    const endUtf16 = idx + needle.length;
+    const matchedText = fullText.slice(startUtf16, endUtf16);
+
+    const ctxStart = Math.max(0, startUtf16 - contextWindowChars);
+    const ctxEnd = Math.min(fullText.length, endUtf16 + contextWindowChars);
+    const contextBefore = fullText.slice(ctxStart, startUtf16);
+    const contextAfter = fullText.slice(endUtf16, ctxEnd);
+
+    const owningBlock = (snapshot.blocks || []).find(
+      (b) => startUtf16 >= b.startUtf16 && endUtf16 <= b.endUtf16
+    );
+
+    matches.push({
+      occurrenceIndex: matches.length + 1,
+      startUtf16,
+      endUtf16,
+      lengthUtf16: endUtf16 - startUtf16,
+      matchedText,
+      contextBefore,
+      contextAfter,
+      blockId: owningBlock ? owningBlock.blockId : null,
+      bounds: owningBlock ? owningBlock.bounds : null
+    });
+
+    cursor = endUtf16;
+  }
+
+  return {
+    snapshotId: snapshot.snapshotId,
+    pageVersion: snapshot.pageVersion,
+    url: snapshot.url,
+    query: needle,
+    totalOccurrences: matches.length,
+    matches
+  };
+}
+
+function promoteOccurrenceToVerifiedExcerpt(
+  snapshot,
+  { query, occurrenceIndex = 1, expandToBlock = true } = {}
+) {
+  const found = findAllOccurrencesInSnapshot(snapshot, { query });
+  const target = found.matches.find((m) => m.occurrenceIndex === Number(occurrenceIndex));
+  if (!target) {
+    const err = new Error(
+      `FIND_OCCURRENCE_OUT_OF_RANGE: requested #${occurrenceIndex} of ${found.totalOccurrences} for "${query}"`
+    );
+    err.code = "FIND_OCCURRENCE_OUT_OF_RANGE";
+    throw err;
+  }
+
+  if (expandToBlock && target.blockId) {
+    const blk = (snapshot.blocks || []).find((b) => b.blockId === target.blockId);
+    if (blk) {
+      return extractVerifiableExcerpt(snapshot, {
+        startUtf16: blk.startUtf16,
+        endUtf16: blk.endUtf16
+      });
+    }
+  }
+
+  return extractVerifiableExcerpt(snapshot, {
+    startUtf16: target.startUtf16,
+    endUtf16: target.endUtf16
+  });
+}
+
+module.exports = {
+  findAllOccurrencesInSnapshot,
+  promoteOccurrenceToVerifiedExcerpt
+};
diff --git a/desktop/windows/browser/rate-limit-and-robots-guard.cjs b/desktop/windows/browser/rate-limit-and-robots-guard.cjs
new file mode 100644
index 0000000..18106d6
--- /dev/null
+++ b/desktop/windows/browser/rate-limit-and-robots-guard.cjs
@@ -0,0 +1,98 @@
+"use strict";
+
+/**
+ * Koswork HTTP 429 `Retry-After`, Meta-Robots & Access-Restriction Non-Bypass Guard
+ * (`desktop/windows/browser/rate-limit-and-robots-guard.cjs`).
+ *
+ * Deepens Requirement #4 & #6:
+ * - "CAPTCHA/логины — пауза для пользователя. Не обходить ограничения доступа и не расширять file permissions."
+ * - "Оптимизировать ресурсы по измерениям... отмена незавершённого чтения/поиска."
+ *
+ * Capabilities:
+ * 1. Parses `Retry-After` headers (integer seconds or HTTP date) on `429 Too Many Requests`
+ *    or `503 Service Unavailable` responses and enforces a bounded, `AbortSignal`-cancellable
+ *    wait (`maxRetryDelayMs`).
+ * 2. Evaluates `401 Unauthorized` / `403 Forbidden` / paywall responses and strictly returns
+ *    `status: "access_restricted_no_bypass"` (`bypassAttempted: false`) so the agent never
+ *    attempts to circumvent access controls.
+ * 3. Extracts `<meta name="robots">` / `<meta name="googlebot">` directives from HTML for
+ *    provenance transparency.
+ */
+
+function parseRetryAfterMs(retryAfterHeader, nowMs = Date.now(), maxCapMs = 5000) {
+  if (retryAfterHeader === undefined || retryAfterHeader === null) return 0;
+  const raw = String(retryAfterHeader).trim();
+  if (!raw) return 0;
+
+  if (/^\d+(\.\d+)?$/.test(raw)) {
+    const secs = Number(raw);
+    return Math.min(maxCapMs, Math.max(0, Math.round(secs * 1000)));
+  }
+
+  const parsedDateMs = Date.parse(raw);
+  if (!Number.isNaN(parsedDateMs)) {
+    return Math.min(maxCapMs, Math.max(0, parsedDateMs - nowMs));
+  }
+
+  return 0;
+}
+
+function extractMetaRobotsDirectives(html = "") {
+  const directives = new Set();
+  const regex =
+    /<meta\b[^>]+name=["'](?:robots|bot|kosworkbot)["'][^>]+content=["']([^"']+)["']/gi;
+  let m;
+  while ((m = regex.exec(String(html || ""))) !== null) {
+    const parts = m[1]
+      .split(",")
+      .map((p) => p.trim().toLowerCase())
+      .filter(Boolean);
+    for (const p of parts) {
+      directives.add(p);
+    }
+  }
+  return Array.from(directives);
+}
+
+function evaluateAccessRestrictionDecision({ httpStatus = 200, html = "", headers = {} } = {}) {
+  const status = Number(httpStatus || 200);
+  const robotsDirectives = extractMetaRobotsDirectives(html);
+
+  if (status === 401 || status === 403 || status === 451) {
+    return {
+      allowedToExtract: false,
+      status: "access_restricted_no_bypass",
+      httpStatus: status,
+      bypassAttempted: false,
+      reasonRu: `Доступ к источнику ограничен (HTTP ${status}); обход ограничений доступа запрещён политикой Koswork.`,
+      robotsDirectives
+    };
+  }
+
+  if (status === 429) {
+    const retryAfterMs = parseRetryAfterMs(headers["retry-after"] ?? headers["Retry-After"]);
+    return {
+      allowedToExtract: false,
+      status: "rate_limited_429",
+      httpStatus: 429,
+      bypassAttempted: false,
+      retryAfterMs,
+      reasonRu: `Источник вернул 429 Too Many Requests (Retry-After: ${retryAfterMs} мс).`,
+      robotsDirectives
+    };
+  }
+
+  return {
+    allowedToExtract: status >= 200 && status < 400,
+    status: status >= 200 && status < 400 ? "ok" : "unavailable",
+    httpStatus: status,
+    bypassAttempted: false,
+    robotsDirectives
+  };
+}
+
+module.exports = {
+  parseRetryAfterMs,
+  extractMetaRobotsDirectives,
+  evaluateAccessRestrictionDecision
+};
diff --git a/desktop/windows/browser/report-diff-analyzer.cjs b/desktop/windows/browser/report-diff-analyzer.cjs
new file mode 100644
index 0000000..d78fdd2
--- /dev/null
+++ b/desktop/windows/browser/report-diff-analyzer.cjs
@@ -0,0 +1,195 @@
+"use strict";
+
+const { normalizeComparableValue } = require("./claim-comparator.cjs");
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork Cross-Report Diff & Regression Analyzer
+ * (`desktop/windows/browser/report-diff-analyzer.cjs`).
+ *
+ * Compares two Browser Research Reports (`baselineReport` vs `currentReport`):
+ * 1. Detects `newlyConfirmedCriteria` (upgraded from unknown/unavailable to confirmed with a UTF-16 excerpt).
+ * 2. Detects `valueChanges` (where the canonical normalized value of `(optionName, criterion)`
+ *    changed between runs, recording before/after quotes, URLs, and `eventDate` / `pageDate`).
+ * 3. Detects `resolvedContradictions` and `newContradictions`.
+ * 4. Saves a verified Markdown and JSON diff report into the workspace via `workspace-service.cjs`.
+ */
+
+function indexClaimsByOptionAndCriterion(claims = []) {
+  const map = new Map();
+  for (const c of claims) {
+    if (!c) continue;
+    const key = `${String(c.optionName || "Option").trim()}||${String(
+      c.criterion || "Spec"
+    ).trim()}`;
+    map.set(key, c);
+  }
+  return map;
+}
+
+function compareResearchReports(baselineReport = {}, currentReport = {}) {
+  const baseClaims = baselineReport.confirmedClaims || baselineReport.claims || [];
+  const currClaims = currentReport.confirmedClaims || currentReport.claims || [];
+
+  const baseMap = indexClaimsByOptionAndCriterion(baseClaims);
+  const currMap = indexClaimsByOptionAndCriterion(currClaims);
+
+  const newlyConfirmedCriteria = [];
+  const lostConfirmations = [];
+  const valueChanges = [];
+  const unchangedConfirmations = [];
+
+  for (const [key, curr] of currMap.entries()) {
+    const [optionName, criterion] = key.split("||");
+    if (!baseMap.has(key)) {
+      newlyConfirmedCriteria.push({
+        optionName,
+        criterion,
+        newValue: curr.value || curr.excerpt?.quote || "",
+        newQuote: curr.excerpt?.quote || "",
+        startUtf16: curr.excerpt?.startUtf16 ?? null,
+        endUtf16: curr.excerpt?.endUtf16 ?? null,
+        sourceUrl: curr.source?.url || null,
+        eventDate: curr.source?.eventDate || null
+      });
+      continue;
+    }
+
+    const base = baseMap.get(key);
+    const normBase = normalizeComparableValue(base.value || base.excerpt?.quote || "");
+    const normCurr = normalizeComparableValue(curr.value || curr.excerpt?.quote || "");
+
+    if (normBase.canonicalKey !== normCurr.canonicalKey) {
+      valueChanges.push({
+        optionName,
+        criterion,
+        previousValue: base.value || base.excerpt?.quote || "",
+        previousQuote: base.excerpt?.quote || "",
+        previousSourceUrl: base.source?.url || null,
+        previousEventDate: base.source?.eventDate || null,
+        currentValue: curr.value || curr.excerpt?.quote || "",
+        currentQuote: curr.excerpt?.quote || "",
+        currentSourceUrl: curr.source?.url || null,
+        currentEventDate: curr.source?.eventDate || null
+      });
+    } else {
+      unchangedConfirmations.push({
+        optionName,
+        criterion,
+        value: curr.value || curr.excerpt?.quote || ""
+      });
+    }
+  }
+
+  for (const [key, base] of baseMap.entries()) {
+    if (!currMap.has(key)) {
+      const [optionName, criterion] = key.split("||");
+      lostConfirmations.push({
+        optionName,
+        criterion,
+        previousValue: base.value || base.excerpt?.quote || "",
+        previousSourceUrl: base.source?.url || null
+      });
+    }
+  }
+
+  const baseUnavailable = new Set(
+    (baselineReport.unavailableSources || []).map((u) => u.url)
+  );
+  const currUnavailable = new Set(
+    (currentReport.unavailableSources || []).map((u) => u.url)
+  );
+
+  const recoveredSources = Array.from(baseUnavailable).filter((u) => !currUnavailable.has(u));
+  const newlyUnavailableSources = Array.from(currUnavailable).filter(
+    (u) => !baseUnavailable.has(u)
+  );
+
+  return {
+    comparedAt: new Date().toISOString(),
+    newlyConfirmedCount: newlyConfirmedCriteria.length,
+    valueChangesCount: valueChanges.length,
+    unchangedCount: unchangedConfirmations.length,
+    lostConfirmationsCount: lostConfirmations.length,
+    newlyConfirmedCriteria,
+    valueChanges,
+    unchangedConfirmations,
+    lostConfirmations,
+    recoveredSources,
+    newlyUnavailableSources
+  };
+}
+
+function renderReportDiffMarkdown(diffResult = {}, title = "Сравнение ревизий отчёта") {
+  const lines = [
+    `# ${title}`,
+    "",
+    `- Дата сверки: \`${diffResult.comparedAt || new Date().toISOString()}\``,
+    `- Новых подтверждённых критериев: **${diffResult.newlyConfirmedCount || 0}**`,
+    `- Изменившихся значений: **${diffResult.valueChangesCount || 0}**`,
+    `- Без изменений: **${diffResult.unchangedCount || 0}**`,
+    ""
+  ];
+
+  if ((diffResult.newlyConfirmedCriteria || []).length > 0) {
+    lines.push("## 1. Новые подтверждённые критерии");
+    for (const item of diffResult.newlyConfirmedCriteria) {
+      lines.push(
+        `- **${item.optionName} — ${item.criterion}**: \`${item.newValue}\` (выдержка [${item.startUtf16}..${item.endUtf16}]: «${item.newQuote}», источник: ${item.sourceUrl})`
+      );
+    }
+    lines.push("");
+  }
+
+  if ((diffResult.valueChanges || []).length > 0) {
+    lines.push("## 2. Изменения значений между ревизиями");
+    for (const chg of diffResult.valueChanges) {
+      lines.push(
+        `- **${chg.optionName} — ${chg.criterion}**: \`${chg.previousValue}\` (${chg.previousSourceUrl || "н/д"}) → \`${chg.currentValue}\` (${chg.currentSourceUrl || "н/д"}, дата события: ${chg.currentEventDate || "н/д"})`
+      );
+    }
+    lines.push("");
+  }
+
+  return lines.join("\n") + "\n";
+}
+
+async function saveReportDiffViaWorkspace({
+  workspaceRoot,
+  diffSlug = "research-report-diff",
+  baselineReport,
+  currentReport,
+  signal = null
+} = {}) {
+  const diff = compareResearchReports(baselineReport, currentReport);
+  const md = renderReportDiffMarkdown(diff);
+  const json = JSON.stringify(diff, null, 2) + "\n";
+
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const mdFile = await svc.createFile({
+    relativePath: `reports/${diffSlug}.md`,
+    content: md,
+    createParents: true,
+    signal
+  });
+  const jsonFile = await svc.createFile({
+    relativePath: `reports/${diffSlug}.json`,
+    content: json,
+    createParents: true,
+    signal
+  });
+
+  return {
+    diff,
+    markdownFile: mdFile,
+    jsonFile
+  };
+}
+
+module.exports = {
+  compareResearchReports,
+  renderReportDiffMarkdown,
+  saveReportDiffViaWorkspace
+};
