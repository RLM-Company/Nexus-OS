diff --git a/desktop/windows/browser/hibernated-tab-revalidator.cjs b/desktop/windows/browser/hibernated-tab-revalidator.cjs
new file mode 100644
index 0000000..8ffbede
--- /dev/null
+++ b/desktop/windows/browser/hibernated-tab-revalidator.cjs
@@ -0,0 +1,133 @@
+"use strict";
+
+/**
+ * Koswork Conditional HTTP Revalidator (`ETag` / `304 Not Modified`) & Hibernated Tab Restorer
+ * (`desktop/windows/browser/hibernated-tab-revalidator.cjs`).
+ *
+ * Deepens Requirement #6:
+ * "Оптимизировать ресурсы по измерениям: лимит живых вкладок, выгрузка фоновых,
+ *  отмена незавершённого чтения/поиска, повторное использование допустимого снимка.
+ *  Не обещать нулевую нагрузку; выдать фактические RAM/latency на одном наборе страниц."
+ *
+ * Capabilities:
+ * 1. Restores a background tab that was unloaded/hibernated by `KosworkBrowserResourceGovernor`
+ *    when `liveTabCount` exceeded `maxLiveTabs`.
+ * 2. Performs a conditional freshness check (`If-None-Match: <contentSha256>`):
+ *    - If the source content has not changed (`304 Not Modified`), rehydrates the cached
+ *      versioned snapshot without re-parsing HTML or shifting UTF-16 offsets (`revalidated304: true`).
+ *    - If the source content changed (`200 OK` with new payload), rebuilds the snapshot at
+ *      `pageVersion + 1` and invalidates stale snapshots (`revalidated304: false`).
+ */
+class KosworkHibernatedTabRevalidator {
+  constructor(options = {}) {
+    if (!options.engine) {
+      throw new Error("HIBERNATED_REVALIDATOR_REQUIRES_ENGINE");
+    }
+    this.engine = options.engine;
+    this.revalidationStats = {
+      notModified304Count: 0,
+      reloaded200Count: 0,
+      savedBytesEstimate: 0
+    };
+  }
+
+  /**
+   * Wakes a hibernated tab and conditionally revalidates its snapshot against the current source.
+   */
+  async wakeAndRevalidateTab(tabId, { forceUpstreamCheck = true } = {}) {
+    const key = String(tabId);
+    const tab = this.engine.tabs.get(key);
+    if (!tab || tab.closed) {
+      const err = new Error(`TAB_LOST_OR_CLOSED: ${key}`);
+      err.code = "TAB_LOST_OR_CLOSED";
+      throw err;
+    }
+
+    const wasHibernated =
+      Boolean(tab.hibernated) || this.engine.resourceGovernor.hibernatedTabs.has(key);
+    const priorSnapshot = tab.snapshot;
+    const priorEtag = `"sha256-${priorSnapshot.contentSha256}"`;
+
+    let upstreamChanged = false;
+    let newSitePayload = null;
+
+    if (forceUpstreamCheck && this.engine.syntheticSites.has(tab.url)) {
+      const siteDef = this.engine.syntheticSites.get(tab.url);
+      const candidateText = String(siteDef.text || siteDef.html || "");
+      // Check if synthetic site definition changed its underlying text since priorSnapshot
+      if (
+        siteDef.text &&
+        priorSnapshot.fullTextUtf16 &&
+        siteDef.text.trim() !== priorSnapshot.fullTextUtf16.trim()
+      ) {
+        upstreamChanged = true;
+        newSitePayload = siteDef;
+      }
+    }
+
+    if (!upstreamChanged) {
+      // 304 Not Modified path: restore live status and reuse existing verified snapshot
+      tab.hibernated = false;
+      this.engine.resourceGovernor.touchLiveTab(key, tab, (hibernatedId) => {
+        const bgTab = this.engine.tabs.get(hibernatedId);
+        if (bgTab && !bgTab.closed) {
+          bgTab.hibernated = true;
+        }
+      });
+      this.engine.resourceGovernor.cacheSnapshot(priorSnapshot);
+
+      this.revalidationStats.notModified304Count += 1;
+      this.revalidationStats.savedBytesEstimate += Buffer.byteLength(
+        priorSnapshot.fullTextUtf16 || "",
+        "utf8"
+      );
+
+      return {
+        tabId: key,
+        url: tab.url,
+        wasHibernated,
+        httpStatus: 304,
+        revalidated304: true,
+        etagSent: priorEtag,
+        pageVersion: priorSnapshot.pageVersion,
+        snapshotReused: true,
+        snapshot: priorSnapshot,
+        revalidationStats: { ...this.revalidationStats }
+      };
+    }
+
+    // 200 OK modified path: update snapshot and increment pageVersion
+    tab.hibernated = false;
+    const updatedSnapshot = this.engine.mutatePageContent(key, {
+      fullText: newSitePayload.text,
+      pageDate: newSitePayload.pageDate ?? priorSnapshot.pageDate,
+      eventDate: newSitePayload.eventDate ?? priorSnapshot.eventDate
+    });
+
+    this.engine.resourceGovernor.touchLiveTab(key, tab, (hibernatedId) => {
+      const bgTab = this.engine.tabs.get(hibernatedId);
+      if (bgTab && !bgTab.closed) {
+        bgTab.hibernated = true;
+      }
+    });
+
+    this.revalidationStats.reloaded200Count += 1;
+
+    return {
+      tabId: key,
+      url: tab.url,
+      wasHibernated,
+      httpStatus: 200,
+      revalidated304: false,
+      etagSent: priorEtag,
+      pageVersion: updatedSnapshot.pageVersion,
+      snapshotReused: false,
+      snapshot: updatedSnapshot,
+      revalidationStats: { ...this.revalidationStats }
+    };
+  }
+}
+
+module.exports = {
+  KosworkHibernatedTabRevalidator
+};
diff --git a/desktop/windows/browser/multi-step-form-wizard.cjs b/desktop/windows/browser/multi-step-form-wizard.cjs
new file mode 100644
index 0000000..61aa0c6
--- /dev/null
+++ b/desktop/windows/browser/multi-step-form-wizard.cjs
@@ -0,0 +1,188 @@
+"use strict";
+
+const { ingestDownloadedSourceIntoResearchSnapshot } = require("./downloaded-source-ingestor.cjs");
+
+/**
+ * Koswork Multi-Step Wizard Form & Validation-Aware Submission Runner
+ * (`desktop/windows/browser/multi-step-form-wizard.cjs`).
+ *
+ * Deepens Requirement #4:
+ * "Довести ввод в обычные формы, выбор файлов и скачивание в разрешённую папку
+ *  на синтетических сайтах. После отправки сверять эффект. CAPTCHA/логины — пауза
+ *  для пользователя. Не обходить ограничения доступа и не расширять file permissions."
+ */
+
+function detectFormValidationErrors(snapshot) {
+  const text = String(snapshot?.fullTextUtf16 || "");
+  const errorPatterns = [
+    /(?:ошибка валидации|поле обязательно|некорректное значение|validation error|invalid input|required field missing)\s*[:—-]?\s*([^\n.]+)/i
+  ];
+  const matchedMessages = [];
+  for (const pat of errorPatterns) {
+    const m = text.match(pat);
+    if (m) {
+      matchedMessages.push(m[0].trim());
+    }
+  }
+  return {
+    hasValidationErrors: matchedMessages.length > 0,
+    messages: matchedMessages
+  };
+}
+
+async function executeMultiStepFormWizard({
+  engine,
+  tabId = "wizard-tab-1",
+  url,
+  steps = [],
+  finalDownload = null,
+  signal = null
+} = {}) {
+  if (!engine) {
+    throw new Error("FORM_WIZARD_REQUIRES_ENGINE");
+  }
+
+  const nav = await engine.navigate({
+    tabId,
+    url,
+    actor: "agent",
+    signal
+  });
+
+  if (nav.status === "paused_for_user") {
+    return {
+      status: "paused_for_user",
+      pausedAtStep: 0,
+      tabId: nav.tabId,
+      url: nav.url,
+      stepResults: []
+    };
+  }
+
+  const stepResults = [];
+  let currentObservation = nav.snapshot;
+
+  for (let i = 0; i < steps.length; i += 1) {
+    if (signal?.aborted) {
+      const err = new Error("FORM_WIZARD_CANCELLED");
+      err.code = "FORM_WIZARD_CANCELLED";
+      throw err;
+    }
+
+    const step = steps[i];
+    const stepId = step.stepId || `step-${i + 1}`;
+
+    if (step.fields && Object.keys(step.fields).length > 0) {
+      const fillRes = engine.fillForm({
+        tabId: nav.tabId,
+        observedSnapshot: currentObservation,
+        fields: step.fields
+      });
+      if (fillRes.status === "paused_for_user") {
+        return {
+          status: "paused_for_user",
+          pausedAtStep: i + 1,
+          stepId,
+          reason: fillRes.reason,
+          stepResults
+        };
+      }
+      currentObservation = fillRes.snapshot;
+    }
+
+    let attachedFiles = null;
+    if (step.fileAttachment && Array.isArray(step.fileAttachment.filePaths)) {
+      attachedFiles = engine.selectFiles({
+        tabId: nav.tabId,
+        controlId: step.fileAttachment.controlId,
+        filePaths: step.fileAttachment.filePaths,
+        observedSnapshot: currentObservation
+      });
+      currentObservation = attachedFiles.snapshot;
+    }
+
+    const submitRes = await engine.submitForm({
+      tabId: nav.tabId,
+      submitControlId: step.submitControlId || null,
+      observedSnapshot: currentObservation
+    });
+
+    if (submitRes.status === "paused_for_user") {
+      return {
+        status: "paused_for_user",
+        pausedAtStep: i + 1,
+        stepId,
+        reason: submitRes.reason,
+        stepResults
+      };
+    }
+
+    currentObservation = submitRes.snapshot;
+    const validationCheck = detectFormValidationErrors(currentObservation);
+
+    if (validationCheck.hasValidationErrors) {
+      return {
+        status: "validation_failed",
+        failedAtStep: i + 1,
+        stepId,
+        validationErrors: validationCheck.messages,
+        snapshot: currentObservation,
+        stepResults
+      };
+    }
+
+    let stepExcerpt = null;
+    if (step.expectedTextAfterSubmit) {
+      stepExcerpt = engine.extractExcerpt(nav.tabId, {
+        searchTerm: step.expectedTextAfterSubmit
+      });
+    }
+
+    stepResults.push({
+      stepIndex: i + 1,
+      stepId,
+      effectVerified: submitRes.effectVerified,
+      pageVersion: currentObservation.pageVersion,
+      attachedFilesCount: attachedFiles ? attachedFiles.attachedFiles.length : 0,
+      stepExcerpt
+    });
+  }
+
+  let downloadedArtifact = null;
+  if (finalDownload) {
+    const dl = await engine.downloadFromPage({
+      tabId: nav.tabId,
+      downloadControlId: finalDownload.downloadControlId || null,
+      filename: finalDownload.filename || "wizard-export.txt",
+      content: finalDownload.content
+    });
+    const ingested = ingestDownloadedSourceIntoResearchSnapshot(dl, {
+      pageDate: currentObservation.pageDate,
+      eventDate: currentObservation.eventDate
+    });
+    const excerpt = finalDownload.extractTerm
+      ? ingested.extractExcerpt({ searchTerm: finalDownload.extractTerm })
+      : null;
+
+    downloadedArtifact = {
+      downloadResult: dl,
+      snapshot: ingested.snapshot,
+      excerpt
+    };
+  }
+
+  return {
+    status: "completed",
+    tabId: nav.tabId,
+    url: nav.url,
+    totalStepsCompleted: stepResults.length,
+    stepResults,
+    downloadedArtifact,
+    finalSnapshot: currentObservation
+  };
+}
+
+module.exports = {
+  detectFormValidationErrors,
+  executeMultiStepFormWizard
+};
