+++ b/desktop/windows/test/browser-research-acceptance.test.cjs
@@ -4452,3 +4452,115 @@ test("51. CSL-JSON (Citation Style Language) & RIS Bibliography Exporter (`csl-j
   assert.ok(fs.existsSync(path.join(workspaceRoot, bibRes.cslFile.path)));
