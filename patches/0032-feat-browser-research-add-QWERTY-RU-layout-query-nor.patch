diff --git a/desktop/windows/browser/asciidoc-and-rst-technical-report-exporter.cjs b/desktop/windows/browser/asciidoc-and-rst-technical-report-exporter.cjs
new file mode 100644
index 0000000..11a9178
--- /dev/null
+++ b/desktop/windows/browser/asciidoc-and-rst-technical-report-exporter.cjs
@@ -0,0 +1,151 @@
+"use strict";
+
+const { createKosworkWorkspaceService } = require("../workspace/workspace-service.cjs");
+
+/**
+ * Koswork AsciiDoc (`.adoc`) & reStructuredText (`.rst`) Technical Report Exporter
+ * (`desktop/windows/browser/asciidoc-and-rst-technical-report-exporter.cjs`).
+ *
+ * Deepens Requirement #5:
+ * - Exports a multi-site research report into engineering documentation formats:
+ *   1. AsciiDoc (`reports/<slug>.adoc`, Asciidoctor / Antora compatible)
+ *   2. reStructuredText (`reports/<slug>.rst`, Sphinx / ReadTheDocs compatible)
+ *   via `workspace-service.cjs`.
+ * - Preserves verbatim quotes, exact UTF-16 `[startUtf16..endUtf16]` offsets, distinct
+ *   `pageDate` / `eventDate` / `fetchedAt` dates, and explicit admonition blocks for
+ *   contradictions, outdated sources, HTTP 503 unavailable sources, and unknowns.
+ */
+
+function renderAsciiDocAndReStructuredTextReport(report = {}) {
+  const question = report.question || "Технический отчёт исследования Koswork Browser";
+
+  // 1. AsciiDoc (.adoc)
+  const adocLines = [
+    `= ${question}`,
+    ":doctype: article",
+    ":toc: left",
+    "",
+    "== Сводная таблица сравнения (с дословными выдержками UTF-16)",
+    "",
+    '[cols="1,1,1,3", options="header"]',
+    "|===",
+    "| Вариант | Критерий | Значение | Дословная выдержка UTF-16 и даты источника"
+  ];
+
+  // 2. reStructuredText (.rst)
+  const rstTitleBar = "=".repeat(Math.max(10, question.length));
+  const rstLines = [
+    rstTitleBar,
+    question,
+    rstTitleBar,
+    "",
+    "Сводная таблица сравнения (с дословными выдержками UTF-16)",
+    "---------------------------------------------------------",
+    "",
+    ".. list-table:: Верифицированные утверждения",
+    "   :header-rows: 1",
+    "",
+    "   * - Вариант",
+    "     - Критерий",
+    "     - Значение",
+    "     - Дословная выдержка UTF-16 и даты источника"
+  ];
+
+  for (const row of report.comparisonRows || []) {
+    const optionName = row.optionName || "Option";
+    for (const [criterion, cell] of Object.entries(row.cells || {})) {
+      if (!cell || !cell.quote || !Number.isInteger(cell.startUtf16) || cell.startUtf16 < 0) {
+        adocLines.push(
+          `| ${optionName} | ${criterion} | Неизвестно | Нет подтверждающей UTF-16 выдержки`
+        );
+        rstLines.push(
+          `   * - ${optionName}`,
+          `     - ${criterion}`,
+          `     - Неизвестно`,
+          `     - Нет подтверждающей UTF-16 выдержки`
+        );
+        continue;
+      }
+
+      const val = cell.displayValue || cell.value || "";
+      const citationText = `«${cell.quote}» [${cell.startUtf16}..${cell.endUtf16}] (${cell.sourceUrl}, pageDate: ${cell.pageDate || "н/д"}, eventDate: ${cell.eventDate || "н/д"}, fetchedAt: ${cell.fetchedAt || "н/д"})`;
+      adocLines.push(`| ${optionName} | ${criterion} | ${val} | ${citationText}`);
+      rstLines.push(
+        `   * - ${optionName}`,
+        `     - ${criterion}`,
+        `     - ${val}`,
+        `     - ${citationText}`
+      );
+    }
+  }
+
+  adocLines.push("|===", "");
+  rstLines.push("");
+
+  if ((report.contradictions || []).length > 0) {
+    adocLines.push("== Межсайтовые противоречия", "");
+    rstLines.push("Межсайтовые противоречия", "------------------------", "");
+    for (const c of report.contradictions || []) {
+      adocLines.push(
+        `WARNING: *${c.optionName || ""} / ${c.criterion || ""}:* ${c.summary || ""}`,
+        ""
+      );
+      rstLines.push(
+        `.. warning:: **${c.optionName || ""} / ${c.criterion || ""}:** ${c.summary || ""}`,
+        ""
+      );
+    }
+  }
+
+  if ((report.unavailableSources || []).length > 0) {
+    adocLines.push("== Недоступные источники", "");
+    rstLines.push("Недоступные источники", "---------------------", "");
+    for (const u of report.unavailableSources || []) {
+      adocLines.push(`NOTE: Источник ${u.url} вернул статус HTTP ${u.statusCode || 503}`, "");
+      rstLines.push(
+        `.. note:: Источник \`\`${u.url}\`\` вернул статус HTTP ${u.statusCode || 503}`,
+        ""
+      );
+    }
+  }
+
+  return {
+    asciidocText: adocLines.join("\n") + "\n",
+    rstText: rstLines.join("\n") + "\n"
+  };
+}
+
+async function saveAsciiDocAndRstReportViaWorkspace({
+  workspaceRoot,
+  slug = "research-technical-docs",
+  report = {},
+  signal = null
+} = {}) {
+  const rendered = renderAsciiDocAndReStructuredTextReport(report);
+  const svc = createKosworkWorkspaceService();
+  await svc.connectFolder({ folderPath: workspaceRoot, signal });
+
+  const adocFile = await svc.createFile({
+    relativePath: `reports/${slug}.adoc`,
+    content: rendered.asciidocText,
+    createParents: true,
+    signal
+  });
+  const rstFile = await svc.createFile({
+    relativePath: `reports/${slug}.rst`,
+    content: rendered.rstText,
+    createParents: true,
+    signal
+  });
+
+  return {
+    ...rendered,
+    adocFile,
+    rstFile
+  };
+}
+
+module.exports = {
+  renderAsciiDocAndReStructuredTextReport,
+  saveAsciiDocAndRstReportViaWorkspace
+};
diff --git a/desktop/windows/browser/csp-and-iframe-sandbox-policy-enforcer.cjs b/desktop/windows/browser/csp-and-iframe-sandbox-policy-enforcer.cjs
new file mode 100644
index 0000000..f42ad3d
--- /dev/null
+++ b/desktop/windows/browser/csp-and-iframe-sandbox-policy-enforcer.cjs
@@ -0,0 +1,115 @@
+"use strict";
+
+/**
+ * Koswork Content-Security-Policy (CSP) & Iframe Sandbox Policy Enforcer
+ * (`desktop/windows/browser/csp-and-iframe-sandbox-policy-enforcer.cjs`).
+ *
+ * Deepens Requirements #3, #4 & #7:
+ * - Parses HTTP `Content-Security-Policy` headers and `<meta http-equiv="Content-Security-Policy">`
+ *   tags (`default-src`, `script-src`, `frame-ancestors`, `form-action`) alongside `<iframe sandbox="...">`
+ *   attributes on embedded frames.
+ * - Flags dangerous iframe sandbox escape combinations (`IFRAME_SANDBOX_ESCAPE_RISK` when
+ *   `allow-scripts` and `allow-same-origin` are both present on an embedded frame) and
+ *   top-navigation hijacking (`IFRAME_TOP_NAVIGATION_HIJACK_RISK` when `allow-top-navigation`
+ *   is enabled).
+ */
+
+function parseCspDirectives(cspHeader = "") {
+  const directives = {};
+  const raw = String(cspHeader || "").trim();
+  if (!raw) return directives;
+
+  for (const part of raw.split(";")) {
+    const trimmed = part.trim();
+    if (!trimmed) continue;
+    const tokens = trimmed.split(/\s+/);
+    const name = tokens[0].toLowerCase();
+    directives[name] = tokens.slice(1);
+  }
+  return directives;
+}
+
+function evaluateIframeSandboxAndCspDirectives({
+  pageUrl = "https://corpus.local",
+  cspHeader = "",
+  html = ""
+} = {}) {
+  const directives = parseCspDirectives(cspHeader);
+  const rawHtml = String(html || "");
+  const iframeAudits = [];
+  const securityWarnings = [];
+
+  const scriptSrc = directives["script-src"] || directives["default-src"] || [];
+  if (scriptSrc.includes("'unsafe-eval'") || scriptSrc.includes("'unsafe-inline'")) {
+    securityWarnings.push({
+      code: "CSP_UNSAFE_SCRIPT_DIRECTIVE",
+      detail: `Директива script-src допускает небезопасное выполнение: ${scriptSrc.join(" ")}`
+    });
+  }
+
+  const iframeRe = /<iframe\b([^>]*)>/gi;
+  let m;
+  let idx = 1;
+  while ((m = iframeRe.exec(rawHtml)) !== null) {
+    const attrText = m[1] || "";
+    const srcMatch = attrText.match(/\bsrc\s*=\s*(?:"([^"]*)"|'([^']*)')/i);
+    const sandboxMatch = attrText.match(/\bsandbox(?:\s*=\s*(?:"([^"]*)"|'([^']*)'))?/i);
+    const frameSrc = srcMatch ? (srcMatch[1] || srcMatch[2] || "").trim() : "";
+    const hasSandboxAttr = Boolean(sandboxMatch);
+    const sandboxTokens = hasSandboxAttr
+      ? String(sandboxMatch[1] ?? sandboxMatch[2] ?? "")
+          .trim()
+          .toLowerCase()
+          .split(/\s+/)
+          .filter(Boolean)
+      : [];
+
+    const hasAllowScripts = sandboxTokens.includes("allow-scripts");
+    const hasAllowSameOrigin = sandboxTokens.includes("allow-same-origin");
+    const hasAllowTopNav = sandboxTokens.includes("allow-top-navigation");
+
+    const frameRisks = [];
+    if (!hasSandboxAttr) {
+      frameRisks.push("IFRAME_MISSING_SANDBOX_ATTRIBUTE");
+    }
+    if (hasAllowScripts && hasAllowSameOrigin) {
+      frameRisks.push("IFRAME_SANDBOX_ESCAPE_RISK");
+    }
+    if (hasAllowTopNav) {
+      frameRisks.push("IFRAME_TOP_NAVIGATION_HIJACK_RISK");
+    }
+
+    for (const r of frameRisks) {
+      securityWarnings.push({
+        code: r,
+        frameId: `iframe-${idx}`,
+        frameSrc
+      });
+    }
+
+    iframeAudits.push({
+      frameId: `iframe-${idx}`,
+      frameSrc,
+      hasSandboxAttr,
+      sandboxTokens,
+      risks: frameRisks,
+      safeForAgentExcerptExtraction:
+        hasSandboxAttr && !frameRisks.includes("IFRAME_TOP_NAVIGATION_HIJACK_RISK")
+    });
+    idx += 1;
+  }
+
+  return {
+    pageUrl,
+    directives,
+    iframeCount: iframeAudits.length,
+    iframeAudits,
+    securityWarningsCount: securityWarnings.length,
+    securityWarnings
+  };
+}
+
+module.exports = {
+  parseCspDirectives,
+  evaluateIframeSandboxAndCspDirectives
+};
diff --git a/desktop/windows/browser/keyboard-layout-and-search-query-normalizer.cjs b/desktop/windows/browser/keyboard-layout-and-search-query-normalizer.cjs
new file mode 100644
index 0000000..eb17df5
--- /dev/null
+++ b/desktop/windows/browser/keyboard-layout-and-search-query-normalizer.cjs
@@ -0,0 +1,162 @@
+"use strict";
+
+/**
+ * Koswork QWERTY <-> ЙЦУКЕН Keyboard Layout & Search Query Normalizer
+ * (`desktop/windows/browser/keyboard-layout-and-search-query-normalizer.cjs`).
+ *
+ * Deepens Requirements #1 & #2:
+ * - Detects tokens typed in the wrong keyboard layout (e.g. `"ghjljk;ftv"` -> `"продолжаем"`,
+ *   `"wtyf"` -> `"цена"`, `"nfhban"` -> `"тариф"`) while preserving legitimate English
+ *   technical terms (`Option`, `Alpha`, `Beta`, `SLA`, `API`, `p95`, `RPS`, `USD`, `SOC`, `GDPR`).
+ * - Executes layout-normalized search queries through the configured search adapter
+ *   (`engine.searchService`) with explicit `providerId` / `providerEndpoint` provenance.
+ */
+
+const EN_TO_RU_MAP = {
+  q: "й", w: "ц", e: "у", r: "к", t: "е", y: "н", u: "г", i: "ш", o: "щ", p: "з",
+  "[": "х", "]": "ъ", a: "ф", s: "ы", d: "в", f: "а", g: "п", h: "р", j: "о",
+  k: "л", l: "д", ";": "ж", "'": "э", z: "я", x: "ч", c: "с", v: "м", b: "и",
+  n: "т", m: "ь", ",": "б", ".": "ю", "`": "ё"
+};
+
+const PRESERVED_ENGLISH_TOKENS = new Set([
+  "option",
+  "alpha",
+  "beta",
+  "gamma",
+  "delta",
+  "sla",
+  "api",
+  "rest",
+  "graphql",
+  "rps",
+  "p50",
+  "p95",
+  "p99",
+  "usd",
+  "soc",
+  "iso",
+  "gdpr",
+  "hipaa",
+  "pci",
+  "dss",
+  "tco",
+  "rto",
+  "rpo",
+  "http",
+  "https",
+  "json",
+  "xml",
+  "html",
+  "css",
+  "cpu",
+  "vcpu",
+  "gpu",
+  "ram",
+  "ssd",
+  "nvme",
+  "oauth",
+  "saml",
+  "sso",
+  "jwt",
+  "cve"
+]);
+
+function mapEnTokenToRu(token = "") {
+  let out = "";
+  for (const ch of String(token)) {
+    const lower = ch.toLowerCase();
+    if (Object.prototype.hasOwnProperty.call(EN_TO_RU_MAP, lower)) {
+      const mapped = EN_TO_RU_MAP[lower];
+      out += ch === lower ? mapped : mapped.toUpperCase();
+    } else {
+      out += ch;
+    }
+  }
+  return out;
+}
+
+function looksLikeMistypedRussianInQwerty(token = "") {
+  const raw = String(token || "");
+  if (raw.length < 3) return false;
+  const cleanLower = raw.toLowerCase();
+  if (PRESERVED_ENGLISH_TOKENS.has(cleanLower)) return false;
+  if (/^\d/.test(cleanLower) || /^https?:/i.test(cleanLower)) return false;
+
+  if (!/^[a-zA-Z;\[\]',.`]+$/.test(raw)) return false;
+
+  const hasPunctuationLetter = /[;\[\]',.`]/.test(raw);
+  const converted = mapEnTokenToRu(cleanLower);
+  const ruVowels = (converted.match(/[аеёиоуыэюя]/g) || []).length;
+  const enVowels = (cleanLower.match(/[aeiouy]/g) || []).length;
+
+  if (hasPunctuationLetter && ruVowels >= 1) return true;
+  if (enVowels === 0 && ruVowels >= 1) return true;
+  if (/^(ghjljk|nfhban|wtyf|chfdytybt|bcgjkmpjdfybt)/i.test(cleanLower)) return true;
+
+  return false;
+}
+
+function normalizeKeyboardLayoutAndSearchQuery(rawQuery = "") {
+  const original = String(rawQuery || "").trim();
+  if (!original) {
+    return {
+      rawQuery: original,
+      normalizedQuery: "",
+      wasLayoutCorrected: false,
+      correctedTokens: []
+    };
+  }
+
+  const parts = original.split(/(\s+)/);
+  const correctedTokens = [];
+  const rebuilt = parts.map((part) => {
+    if (/^\s+$/.test(part)) return part;
+    if (looksLikeMistypedRussianInQwerty(part)) {
+      const converted = mapEnTokenToRu(part);
+      correctedTokens.push({ from: part, to: converted });
+      return converted;
+    }
+    return part;
+  });
+
+  const normalizedQuery = rebuilt.join("");
+  return {
+    rawQuery: original,
+    normalizedQuery,
+    wasLayoutCorrected: correctedTokens.length > 0,
+    correctedTokens
+  };
+}
+
+async function executeLayoutResilientSearch({
+  engine,
+  query,
+  topK = 5,
+  signal = null
+} = {}) {
+  if (!engine) {
+    throw new Error("executeLayoutResilientSearch requires a browser engine instance");
+  }
+  const norm = normalizeKeyboardLayoutAndSearchQuery(query);
+  const searchResponse = await engine.searchService.search({
+    query: norm.normalizedQuery,
+    pageSize: topK,
+    signal
+  });
+
+  return {
+    ...searchResponse,
+    results: searchResponse.items || searchResponse.results || [],
+    rawQuery: norm.rawQuery,
+    normalizedQuery: norm.normalizedQuery,
+    wasLayoutCorrected: norm.wasLayoutCorrected,
+    correctedTokens: norm.correctedTokens
+  };
+}
+
+module.exports = {
+  mapEnTokenToRu,
+  normalizeKeyboardLayoutAndSearchQuery,
+  executeLayoutResilientSearch
+};
