index 0000000..8aade0b
--- /dev/null
+++ b/desktop/windows/browser/corroboration-scorer.cjs
@@ -0,0 +1,136 @@
+"use strict";
+
+const { normalizeComparableValue } = require("./claim-comparator.cjs");
+
+/**
+ * Koswork Multi-Source Claim Corroboration & Confidence Scorer
+ * (`desktop/windows/browser/corroboration-scorer.cjs`).
+ *
+ * Deepens Requirement #2 & #5:
+ * - Evaluates claims across multiple independent sources/domains.
+ * - Uses `normalizeComparableValue` so equivalent values phrased in different units or
+ *   currencies (e.g., `"$49/мес"` vs `"49 USD/month"`, `"12 мс"` vs `"0.012 с"`) are
+ *   recognized as corroborating the same canonical value.
+ * - Rejects bare links without a valid UTF-16 excerpt (`verdict: "unverified_bare_link"`).
+ * - Distinguishes:
+ *   - `"multi_source_corroborated"` (>= 2 distinct sources agree on the canonical value),
+ *   - `"single_source_verified"` (1 verified source with UTF-16 excerpt, no contradiction),
+ *   - `"conflicting_sources"` (sources provide incompatible canonical values),
+ *   - `"unverified_bare_link"` (no valid UTF-16 excerpt).
+ */
+
+function extractSourceHostname(rawUrl = "") {
+  try {
+    return new URL(String(rawUrl)).hostname.toLowerCase();
+  } catch {
+    return String(rawUrl || "unknown").toLowerCase();
+  }
+}
+
+function scoreMultiSourceCorroboration(claims = []) {
+  const groups = new Map(); // `${optionName}||${criterion}` -> claims[]
+  const rejectedBareLinkClaims = [];
+
+  for (const c of claims) {
+    if (!c) continue;
+    const hasValidExcerpt =
+      c.excerpt &&
+      typeof c.excerpt.quote === "string" &&
+      c.excerpt.quote.trim().length > 0 &&
+      Number.isInteger(c.excerpt.startUtf16) &&
+      Number.isInteger(c.excerpt.endUtf16) &&
+      c.excerpt.endUtf16 - c.excerpt.startUtf16 === c.excerpt.quote.length;
+
+    if (!hasValidExcerpt) {
+      rejectedBareLinkClaims.push({
+        claimId: c.claimId || null,
+        optionName: c.optionName || "Option",
+        criterion: c.criterion || "Spec",
+        verdict: "unverified_bare_link",
+        confidenceScore: 0,
+        reason: "Ссылка без верифицированной UTF-16 выдержки не является доказательством утверждения."
+      });
+      continue;
+    }
+
+    const key = `${String(c.optionName || "Option").trim()}||${String(
+      c.criterion || "Spec"
+    ).trim()}`;
+    if (!groups.has(key)) {
+      groups.set(key, []);
+    }
+    groups.get(key).push(c);
+  }
+
+  const groupEvaluations = [];
+
+  for (const [key, items] of groups.entries()) {
+    const [optionName, criterion] = key.split("||");
+    const byCanonicalVal = new Map(); // canonicalKey -> items[]
+
+    for (const item of items) {
+      const norm = normalizeComparableValue(item.value || item.excerpt.quote);
+      const valKey = norm.canonicalKey;
+      if (!byCanonicalVal.has(valKey)) {
+        byCanonicalVal.set(valKey, []);
+      }
+      byCanonicalVal.get(valKey).push({
+        ...item,
+        normalizedValue: norm,
+        sourceHostname: extractSourceHostname(item.source?.url),
+        sourceKey: item.source?.url || "unknown"
+      });
+    }
+
+    const distinctValueClusters = Array.from(byCanonicalVal.entries()).map(
+      ([canonicalKey, clusterItems]) => {
+        const distinctUrls = new Set(clusterItems.map((i) => i.sourceKey));
+        const distinctHosts = new Set(clusterItems.map((i) => i.sourceHostname));
+        return {
+          canonicalKey,
+          displayValue: clusterItems[0].value || clusterItems[0].excerpt.quote,
+          distinctSourcesCount: distinctUrls.size,
+          distinctDomainsCount: distinctHosts.size,
+          supportingClaims: clusterItems
+        };
+      }
+    );
+
+    distinctValueClusters.sort((a, b) => b.distinctSourcesCount - a.distinctSourcesCount);
+
+    let verdict = "single_source_verified";
+    let confidenceScore = 0.72;
+
+    if (distinctValueClusters.length > 1) {
+      verdict = "conflicting_sources";
+      confidenceScore = 0.35;
+    } else if (distinctValueClusters[0].distinctSourcesCount >= 2) {
+      verdict = "multi_source_corroborated";
+      confidenceScore = Math.min(
+        0.99,
+        Number((0.8 + 0.08 * (distinctValueClusters[0].distinctSourcesCount - 1)).toFixed(2))
+      );
+    }
+
+    groupEvaluations.push({
+      optionName,
+      criterion,
+      verdict,
+      confidenceScore,
+      distinctValueClustersCount: distinctValueClusters.length,
+      primaryCluster: distinctValueClusters[0],
+      allClusters: distinctValueClusters
+    });
+  }
+
+  return {
+    evaluatedGroupsCount: groupEvaluations.length,
+    rejectedBareLinkCount: rejectedBareLinkClaims.length,
+    groupEvaluations,
+    rejectedBareLinkClaims
+  };
+}
+
+module.exports = {
+  scoreMultiSourceCorroboration
+};
diff --git a/desktop/windows/browser/heading-outline-navigator.cjs b/desktop/windows/browser/heading-outline-navigator.cjs
new file mode 100644
index 0000000..e853e15
--- /dev/null
+++ b/desktop/windows/browser/heading-outline-navigator.cjs
@@ -0,0 +1,180 @@
+"use strict";
+
+const { extractVerifiableExcerpt } = require("./document.cjs");
+
+/**
+ * Koswork Heading-Outline (`<h1>..<h6>`) & Section-Scoped Long-Page Navigator
+ * (`desktop/windows/browser/heading-outline-navigator.cjs`).
+ *
+ * Deepens Requirement #3:
+ * "Довести чтение долгих/динамических страниц и навигацию по источникам. Уже есть
+ *  versioned pages, UTF-16 offsets, bounds, recovery candidates, frames/shadow scope
+ *  и устойчивые tab receipts. Сохрани эти свойства; добавляй только реальные пробелы."
+ *
+ * Capabilities:
+ * 1. Builds a structured Table of Contents / Section Outline from HTML `<h1..h6>` tags
+ *    or numbered/titled paragraphs in `snapshot.fullTextUtf16`, computing exact
+ *    `[sectionStartUtf16, sectionEndUtf16]` UTF-16 code unit spans for every section.
+ * 2. Allows direct navigation (`jumpToSectionByHeading`) to a target section on a long
+ *    article without scanning irrelevant preceding text.
+ * 3. Extracts UTF-16 excerpts strictly scoped to a matched section (`extractSectionScopedExcerpt`)
+ *    so identical phrases appearing in different sections are never confused.
+ */
+
+function buildDocumentHeadingOutline(snapshot, rawHtml = "") {
+  if (!snapshot || typeof snapshot.fullTextUtf16 !== "string") {
+    throw new Error("HEADING_OUTLINE_REQUIRES_SNAPSHOT");
+  }
+
+  const fullText = snapshot.fullTextUtf16;
+  const discoveredHeadings = [];
+
+  // 1. Parse explicit `<h1..h6>` headings from rawHtml if available and locate their UTF-16 offsets
+  if (rawHtml && rawHtml.includes("<h")) {
+    const hRegex = /<h([1-6])\b[^>]*>([\s\S]*?)<\/h\1>/gi;
+    let m;
+    let searchFrom = 0;
+    while ((m = hRegex.exec(String(rawHtml))) !== null) {
+      const level = Number(m[1]);
+      const titleText = m[2]
+        .replace(/<[^>]+>/g, " ")
+        .replace(/\s+/g, " ")
+        .trim();
+      if (!titleText) continue;
+
+      const idx = fullText.indexOf(titleText, searchFrom);
+      if (idx >= 0) {
+        discoveredHeadings.push({
+          level,
+          title: titleText,
+          headingStartUtf16: idx,
+          headingEndUtf16: idx + titleText.length
+        });
+        searchFrom = idx + titleText.length;
+      }
+    }
+  }
+
+  // 2. Fallback / supplement: detect numbered section headers in `snapshot.blocks` (e.g., "Раздел 12...", "Глава 3...", "## ...")
+  if (discoveredHeadings.length === 0 && Array.isArray(snapshot.blocks)) {
+    for (const blk of snapshot.blocks) {
+      const text = String(blk.text || "").trim();
+      const secMatch = text.match(
+        /^(?:(?:#{1,6})\s+([^\n]+)|((?:Раздел|Глава|Секция|Section|Chapter)\s+\d+[^:\n]*[:]?))/i
+      );
+      if (secMatch) {
+        const title = (secMatch[1] || secMatch[2] || text.slice(0, 80)).trim();
+        discoveredHeadings.push({
+          level: 2,
+          title,
+          headingStartUtf16: blk.startUtf16,
+          headingEndUtf16: blk.startUtf16 + title.length
+        });
+      }
+    }
+  }
+
+  discoveredHeadings.sort((a, b) => a.headingStartUtf16 - b.headingStartUtf16);
+
+  const sections = discoveredHeadings.map((h, idx) => {
+    // A section extends until the next heading of equal or higher importance (`level <= h.level`) or end of document
+    let sectionEndUtf16 = fullText.length;
+    for (let nextIdx = idx + 1; nextIdx < discoveredHeadings.length; nextIdx += 1) {
+      if (discoveredHeadings[nextIdx].level <= h.level) {
+        sectionEndUtf16 = discoveredHeadings[nextIdx].headingStartUtf16;
+        break;
+      }
+    }
+    return {
+      sectionIndex: idx + 1,
+      level: h.level,
+      title: h.title,
+      headingStartUtf16: h.headingStartUtf16,
+      headingEndUtf16: h.headingEndUtf16,
+      sectionStartUtf16: h.headingStartUtf16,
+      sectionEndUtf16,
+      sectionLengthUtf16: sectionEndUtf16 - h.headingStartUtf16
+    };
+  });
+
+  return {
+    snapshotId: snapshot.snapshotId,
+    pageVersion: snapshot.pageVersion,
+    url: snapshot.url,
+    totalLengthUtf16: fullText.length,
+    sectionCount: sections.length,
+    sections
+  };
+}
+
+function jumpToSectionByHeading({ snapshot, rawHtml = "", headingQuery } = {}) {
+  const outline = buildDocumentHeadingOutline(snapshot, rawHtml);
+  const needle = String(headingQuery || "").trim().toLowerCase();
+  if (!needle) {
+    throw new Error("HEADING_QUERY_REQUIRED");
+  }
+
+  const matched = outline.sections.find((s) => s.title.toLowerCase().includes(needle));
+  if (!matched) {
+    const err = new Error(`SECTION_HEADING_NOT_FOUND: ${headingQuery}`);
+    err.code = "SECTION_HEADING_NOT_FOUND";
+    throw err;
+  }
+
+  const sectionText = snapshot.fullTextUtf16.slice(
+    matched.sectionStartUtf16,
+    matched.sectionEndUtf16
+  );
+
+  return {
+    snapshotId: snapshot.snapshotId,
+    pageVersion: snapshot.pageVersion,
+    url: snapshot.url,
+    tabReceipt: snapshot.tabReceipt,
+    pageDate: snapshot.pageDate,
+    eventDate: snapshot.eventDate,
+    fetchedAt: snapshot.fetchedAt,
+    section: matched,
+    sectionText
+  };
+}
+
+function extractSectionScopedExcerpt({
+  snapshot,
+  rawHtml = "",
+  headingQuery,
+  searchTerm
+} = {}) {
+  const jumped = jumpToSectionByHeading({ snapshot, rawHtml, headingQuery });
+  const needle = String(searchTerm || "").trim();
+  if (!needle) {
+    throw new Error("SECTION_EXCERPT_SEARCH_TERM_REQUIRED");
+  }
+
+  const relIdx = jumped.sectionText.toLowerCase().indexOf(needle.toLowerCase());
+  if (relIdx < 0) {
+    return null;
+  }
+
+  const absStartUtf16 = jumped.section.sectionStartUtf16 + relIdx;
+  const absEndUtf16 = absStartUtf16 + needle.length;
+
+  const excerpt = extractVerifiableExcerpt(snapshot, {
+    startUtf16: absStartUtf16,
+    endUtf16: absEndUtf16
+  });
+
+  return {
+    ...excerpt,
+    sectionTitle: jumped.section.title,
+    sectionLevel: jumped.section.level,
+    sectionStartUtf16: jumped.section.sectionStartUtf16,
+    sectionEndUtf16: jumped.section.sectionEndUtf16
+  };
+}
+
+module.exports = {
+  buildDocumentHeadingOutline,
+  jumpToSectionByHeading,
+  extractSectionScopedExcerpt
+};
